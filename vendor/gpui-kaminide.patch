-#[derive(Debug, Clone)]
-pub enum TabStopOperation {
-    Insert(FocusHandle),
-    Group(TabIndex),
-    GroupEnd,
-}
-
-impl TabStopOperation {
-    fn focus_handle(&self) -> Option<&FocusHandle> {
