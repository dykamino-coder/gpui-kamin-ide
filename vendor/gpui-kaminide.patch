+//! Один исходный prepaint выпускает hitboxes в тех же размещениях, что и paint.
+
+use super::*;
+
+struct HitRecording;
+
+impl Window {
+    /// Исходный prepaint сохраняет родные идентичности hitbox и их обработчики.
+    /// Размещения выбираются теми же with_paint_segment_slices, что при paint.
+    pub fn with_prepaint_segments<R>(
+        &mut self, source_clip: Bounds<Pixels>, routes: Rc<[PaintSegment]>, cx: &mut App,
+        prepaint: impl FnOnce(&mut Self, &mut App) -> R,
+    ) -> Result<R, PaintRecordError> {
+        paint_scope::Identity::capture(self).check_pass(self)?;
+        if self.invalidator.inner.borrow().draw_phase != DrawPhase::Prepaint {
+            return Err(PaintRecordError::InvalidSegment);
+        }
+        if !valid(&routes, self.scale_factor())
+            || !validation::scaled_bounds_valid(source_clip, self.scale_factor())
+            || routes.iter().any(|route| !validation::scaled_bounds_valid(
+                Bounds::new(source_clip.origin + route.destination - route.source, source_clip.size),
+                self.scale_factor(),
+            )) { return Err(PaintRecordError::InvalidGeometry); }
+        let _recording = self.render_contexts.enter(Some(Rc::new(Recording)));
+        let _hits = self.render_contexts.enter(Some(Rc::new(HitRecording)));
+        let _segments = self.render_contexts.enter(Some(Rc::new(SegmentSet(routes.clone(), source_clip))));
+        let _selection = self.render_contexts.enter(Some(Rc::new(Selection(routes))));
+        let _clips = self.render_contexts.enter::<crate::scene::segments::Clip>(None);
+        let _slices = self.render_contexts.enter::<admission::Slices>(None);
+        let result = prepaint(self, cx);
+        paint_scope::Identity::capture(self).check_pass(self)?;
+        Ok(result)
+    }
+
+    pub(in crate::window) fn insert_segment_hitbox(&mut self, hitbox: &Hitbox) -> bool {
+        if self.render_contexts.get::<HitRecording>().is_none() { return false; }
+        let Some(segments) = self.render_contexts.get::<SegmentSet>() else { return false; };
+        let tag = crate::scene::segments::Tag {
+            routes: self.render_contexts.get::<Selection>().map_or_else(|| Rc::from([]), |value| value.0.clone()),
+            scopes: Rc::from([]), clips: self.render_contexts.get(),
+            slices: self.render_contexts.get::<admission::Slices>().map_or_else(|| Rc::from([]), |value| value.0.clone()),
+        };
+        for route in tag.routes.iter().copied() {
+            let delta = route.destination - route.source;
+            let extent = Bounds::new(segments.1.origin + delta, segments.1.size).scale(1.0);
+            let clip = crate::scene::segments::Tag::clip_chain(tag.clips.as_ref(), None, route, 1.0, extent);
+            let clip = tag.admission(route, 1.0, clip).map(|value| px(value.0));
+            let mut placed = hitbox.clone();
+            placed.bounds.origin += delta;
+            placed.content_mask = ContentMask { bounds: clip };
+            if !placed.bounds.intersect(&clip).is_empty() {
+                self.note_segment_hit_scope(route);
+                self.next_frame.hitboxes.push(placed);
+            }
+        }
+        true
+    }
+
+    /// Фактический выбор курсора тем же hit test, который использует платформа.
+    #[cfg(any(test, feature = "test-support"))]
+    pub fn hit_test_cursor_style(&self) -> CursorStyle {
+        self.rendered_frame.cursor_style(self).unwrap_or(CursorStyle::Arrow)
+    }
+}
diff --git a/vendor/gpui/src/window/paint_record/validation.rs b/vendor/gpui/src/window/paint_record/validation.rs
new file mode 100644
index 0000000000000000000000000000000000000000..034695032ea9996211c1dca22dbdc9d26f450d4d
--- /dev/null
+++ b/vendor/gpui/src/window/paint_record/validation.rs
@@ -0,0 +1,55 @@
+//! Проверка явной геометрии до записи или изменения сцены назначения.
+
+use super::*;
+
+pub(super) fn point_valid(point: Point<Pixels>) -> bool {
+    point.x.0.is_finite() && point.y.0.is_finite()
+}
+
+pub(super) fn bounds_valid(bounds: Bounds<Pixels>) -> bool {
+    point_valid(bounds.origin)
+        && bounds.size.width.0.is_finite() && bounds.size.height.0.is_finite()
+        && bounds.size.width.0 >= 0.0 && bounds.size.height.0 >= 0.0
+        && (bounds.origin.x.0 + bounds.size.width.0).is_finite()
+        && (bounds.origin.y.0 + bounds.size.height.0).is_finite()
+}
+
+impl PaintScopeDescriptor {
+    pub(super) fn validate(&self, scale: f32) -> Result<Bounds<Pixels>, PaintRecordError> {
+        let bounds = match self {
+            Self::Clip(bounds) => *bounds,
+            Self::Group(group) => {
+                let corners = group.corner_radii;
+                let valid = [corners.top_left, corners.top_right, corners.bottom_right,
+                    corners.bottom_left].iter().all(|v| v.0.is_finite() && v.0 >= 0.0)
+                    && group.blur_radius.is_finite() && group.blur_radius >= 0.0
+                    && group.opacity.is_finite() && (0.0..=1.0).contains(&group.opacity)
+                    && (group.blur_radius * scale).is_finite()
+                    && [corners.top_left, corners.top_right, corners.bottom_right, corners.bottom_left]
+                        .iter().all(|v| (v.0 * scale).is_finite())
+                    && group.polygon.len() <= 8
+                    && group.polygon.iter().copied().all(|p| point_valid(p)
+                        && (p.x.0 * scale).is_finite() && (p.y.0 * scale).is_finite())
+                    && group.mask.as_ref().is_none_or(|(_, bounds, _)| scaled_bounds_valid(*bounds, scale))
+                    && group.mask_clip.is_none_or(|clip| clip.iter().all(|v| v.is_finite())
+                        && clip[2] >= 0.0 && clip[3] >= 0.0
+                        && (clip[0] + clip[2]).is_finite() && (clip[1] + clip[3]).is_finite())
+                    && group.projection.is_none_or(|map| map.iter().all(|v| v.is_finite()))
+                    && group.fragments.iter().all(|fragment| fragment.len() <= 8
+                        && fragment.iter().copied().all(|p| point_valid(p)
+                            && (p.x.0 * scale).is_finite() && (p.y.0 * scale).is_finite()));
+                if !valid { return Err(PaintRecordError::InvalidGeometry); }
+                group.bounds
+            }
+        };
+        if !scaled_bounds_valid(bounds, scale) { return Err(PaintRecordError::InvalidGeometry); }
+        Ok(bounds)
+    }
+}
+
+// Conversion must stay finite in the actual device coordinate space too.
+pub(super) fn scaled_bounds_valid(bounds: Bounds<Pixels>, scale: f32) -> bool {
+    bounds_valid(bounds) && [bounds.left().0, bounds.top().0, bounds.right().0,
+        bounds.bottom().0, bounds.size.width.0, bounds.size.height.0]
+        .iter().all(|v| (v * scale).is_finite())
+}
diff --git a/vendor/gpui/src/window/paint_scope.rs b/vendor/gpui/src/window/paint_scope.rs
new file mode 100644
index 0000000000000000000000000000000000000000..1e64a6d51644b77f4aba37b3cb40890df4f43266
--- /dev/null
+++ b/vendor/gpui/src/window/paint_scope.rs
@@ -0,0 +1,178 @@
+//! Живая идентичность прохода и композиционных областей одного окна.
+
+use super::*;
+
+/// Identity of one window draw, shared by prepaint and paint.
+#[derive(Clone, Default)]
+pub struct PaintPassId(Rc<Cell<bool>>);
+
+/// Identity of a live composition scope, independent of host paint policy.
+#[derive(Clone, Default)]
+pub struct PaintScopeId(Rc<Cell<bool>>);
+
+/// A snapshot cannot be replayed outside its original live scope.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, thiserror::Error)]
+pub enum PaintError {
+    /// The snapshot was captured by another window.
+    #[error("paint snapshot belongs to another window")]
+    WrongWindow,
+    /// The captured draw completed or was aborted.
+    #[error("paint snapshot pass has ended")]
+    ExpiredPass,
+    /// Another draw is currently active in this window.
+    #[error("paint snapshot belongs to another pass")]
+    WrongPass,
+    /// The captured composition scope has closed.
+    #[error("paint snapshot composition scope has closed")]
+    ExpiredScope,
+    /// Another composition scope is currently active.
+    #[error("paint snapshot belongs to another composition scope")]
+    WrongScope,
+}
+
+#[derive(Clone)]
+pub(super) struct Identity {
+    window: Rc<()>,
+    pass: PaintPassId,
+    scope: PaintScopeId,
+}
+
+impl Identity {
+    pub(super) fn capture(window: &Window) -> Self {
+        Self {
+            window: window.paint_window.clone(),
+            pass: window.paint_pass.clone(),
+            scope: window.paint_scope.clone(),
+        }
+    }
+
+    pub(super) fn check(&self, window: &Window) -> Result<(), PaintError> {
+        self.check_pass(window)?;
+        if !self.scope.0.get() {
+            return Err(PaintError::ExpiredScope);
+        }
+        if !Rc::ptr_eq(&self.scope.0, &window.paint_scope.0) {
+            return Err(PaintError::WrongScope);
+        }
+        Ok(())
+    }
+
+    /// KaminIDE patch: captured in the window's current pass and scope.
+    pub(super) fn is_current(&self, window: &Window) -> bool {
+        Rc::ptr_eq(&self.window, &window.paint_window)
+            && Rc::ptr_eq(&self.pass.0, &window.paint_pass.0)
+            && Rc::ptr_eq(&self.scope.0, &window.paint_scope.0)
+    }
+
+    // Commands retain draw resources, not permission to restore an old scope.
+    pub(super) fn check_pass(&self, window: &Window) -> Result<(), PaintError> {
+        if !Rc::ptr_eq(&self.window, &window.paint_window) {
+            return Err(PaintError::WrongWindow);
+        }
+        if !self.pass.0.get() {
+            return Err(PaintError::ExpiredPass);
+        }
+        if !Rc::ptr_eq(&self.pass.0, &window.paint_pass.0) {
+            return Err(PaintError::WrongPass);
+        }
+        Ok(())
+    }
+}
+
+impl PartialEq for PaintPassId {
+    fn eq(&self, other: &Self) -> bool { Rc::ptr_eq(&self.0, &other.0) }
+}
+impl Eq for PaintPassId {}
+
+impl PaintPassId {
+    /// Whether the original draw is still open and has not unwound.
+    pub fn is_live(&self) -> bool { self.0.get() }
+    pub(super) fn invalidate(&self) { self.0.set(false); }
+}
+
+impl PartialEq for PaintScopeId {
+    fn eq(&self, other: &Self) -> bool { Rc::ptr_eq(&self.0, &other.0) }
+}
+impl Eq for PaintScopeId {}
+
+impl PaintScopeId {
+    /// Whether the original composition scope remains open.
+    pub fn is_live(&self) -> bool { self.0.get() }
+}
+
+impl Window {
+    /// Identify the current draw without extending its validity.
+    pub fn paint_pass_id(&self) -> PaintPassId { self.paint_pass.clone() }
+
+    /// Identify the current composition scope without extending its validity.
+    pub fn paint_scope_id(&self) -> PaintScopeId { self.paint_scope.clone() }
+
+    pub(crate) fn with_paint_pass<R>(&mut self, f: impl FnOnce(&mut Self) -> R) -> R {
+        let pass = mem::replace(&mut self.paint_pass, PaintPassId(Rc::new(Cell::new(true))));
+        let scope = mem::replace(&mut self.paint_scope, PaintScopeId(Rc::new(Cell::new(true))));
+        let state = Box::new(self.snapshot_paint_state());
+        let inputs = (self.layout_retry, self.layout_inputs.clone());
+        self.with_restore((pass, scope, state, self.refreshing, inputs), |window, previous| {
+            if std::thread::panicking() || !window.paint_pass.is_live() {
+                previous.2.restore(window);
+                window.next_frame.clear();
+                if let Some(layout) = window.layout_engine.as_mut() { layout.discard(); }
+                window.text_system().finish_frame();
+                window.refreshing = previous.3;
+                window.layout_retry = previous.4.0;
+                mem::swap(&mut window.layout_inputs, &mut previous.4.1);
+                window.invalidator.set_phase(DrawPhase::None);
+            }
+            window.paint_pass.0.set(false);
+            window.paint_scope.0.set(false);
+            mem::swap(&mut window.paint_pass, &mut previous.0);
+            mem::swap(&mut window.paint_scope, &mut previous.1);
+        }, f).0
+    }
+
+    pub(super) fn with_paint_scope<R>(&mut self, f: impl FnOnce(&mut Self) -> R) -> R {
+        let scope = mem::replace(&mut self.paint_scope, PaintScopeId(Rc::new(Cell::new(true))));
+        self.with_restore(scope, |window, previous| {
+            window.paint_scope.0.set(false);
+            mem::swap(&mut window.paint_scope, previous);
+        }, f).0
+    }
+
+    pub(super) fn with_isolated_scene<R>(
+        &mut self,
+        f: impl FnOnce(&mut Self) -> R,
+    ) -> (R, Scene) {
+        self.with_isolated_scene_runs(false, f)
+    }
+
+    /// `with_isolated_scene` for a composition group (`paint_group`): `runs`
+    /// keeps the box runs painted inside when the group is painted into a
+    /// layer's scene, a paint record that keeps runs (its copy carries them,
+    /// `placed_groups`) or such a group (`grouped_layer`).
+    pub(super) fn with_isolated_scene_runs<R>(
+        &mut self,
+        runs: bool,
+        f: impl FnOnce(&mut Self) -> R,
+    ) -> (R, Scene) {
+        let mut scene = Scene::default();
+        scene.in_group = true;
+        let outer = &self.next_frame.scene;
+        if runs
+            && self.layer_recording.is_some()
+            && (!outer.in_group || outer.book.record_runs.is_some() || outer.book.group_runs.is_some())
+        {
+            scene.book.group_runs = Some(Vec::new());
+        }
+        if self.segment_capture_mask().is_some() { scene.inherit_segments(&self.next_frame.scene); }
+        mem::swap(&mut self.next_frame.scene, &mut scene);
+        self.with_restore(scene, |window, scene| {
+            mem::swap(&mut window.next_frame.scene, scene);
+            // Listeners and state reads go to the window, not the scene: the
+            // effects the isolated paint allowed (`Window::offscreen_inert`)
+            // stay allowed for the ink probes of the paint around it.
+            let inner = scene.ink_allowed;
+            let outer = &mut window.next_frame.scene.ink_allowed;
+            *outer = (outer.0 + inner.0, outer.1 + inner.1);
+        }, |window| window.with_paint_scope(f))
+    }
+}
diff --git a/vendor/gpui/src/window/paint_snapshot.rs b/vendor/gpui/src/window/paint_snapshot.rs
new file mode 100644
index 0000000000000000000000000000000000000000..e356d532ec1dfc8a106653dac99e4cb80e492ddf
--- /dev/null
+++ b/vendor/gpui/src/window/paint_snapshot.rs
@@ -0,0 +1,197 @@
+//! Снимок окружения и единый проверяемый replay с восстановлением через guard.
+
+use super::*;
+
+mod raster_env;
+pub use raster_env::{RasterCaptures, RasterPaintCtx};
+
+/// General element environment; raster placement is inherited from the caller.
+#[doc = include_str!("paint_contract.md")]
+#[derive(Clone)]
+pub struct PaintCtx {
+    identity: paint_scope::Identity,
+    layout_owner: RetainedLayout,
+    element_id_stack: SmallVec<[ElementId; 32]>,
+    text_style_stack: TextStyleScope,
+    render_contexts: render_context::Snapshot,
+    rendered_entity_stack: Vec<EntityId>,
+    element_offset_stack: Vec<Point<Pixels>>,
+    exact_element_offset_depth: u32,
+    transformation_stack: Vec<TransformationMatrix>,
+    mask_scale: Option<(Point<Pixels>, f32)>,
+    mask_map: Option<TransformationMatrix>,
+    element_opacity: f32,
+    content_mask_stack: Vec<ContentMask<Pixels>>,
+    image_cache_stack: Vec<AnyImageCache>,
+    /// KaminIDE patch: ink sinks open at capture keep measuring deferred paint.
+    ink: InkSinks,
+    /// The ink scope at capture; its top bit (`LAYOUTS_RELEASED`) holds the
+    /// line-layout release scope, which deferred paint keeps too
+    /// (`Window::with_line_layouts_released`), so the snapshot keeps its size.
+    ink_scope: u32,
+    /// KaminIDE patch: the scroll node painting at capture and the content
+    /// mask depth under it: deferred paint runs under it again
+    /// (`Window::reenter_scroll_node`).
+    scroll_node: Option<(u32, usize)>,
+    /// While replayed: where the replay began painting, and in which scene.
+    scroll_reentry: Option<(usize, crate::scene::scroll_marks::SceneSpace)>,
+    scroll_swapped: bool,
+}
+
+/// KaminIDE patch: the release-scope bit of `PaintCtx::ink_scope`.
+const LAYOUTS_RELEASED: u32 = 1 << 31;
+
+/// The capture word of the open ink scope and the release scope.
+pub(super) fn capture_scope(window: &Window) -> u32 {
+    let released = crate::text_system::layouts_released();
+    window.next_frame.scene.ink_scope | if released { LAYOUTS_RELEASED } else { 0 }
+}
+
+/// Full paint environment, including device scale and exact raster placement.
+/// Cloning retains values and host Rc identities, but does not keep scopes alive.
+#[derive(Clone)]
+pub struct PaintState {
+    base: PaintCtx,
+    raster: RasterFrame,
+    scale_factor: f32,
+    rem_size_overrides: SmallVec<[Pixels; 8]>,
+}
+
+
+impl PaintState {
+    pub(super) fn restore(&mut self, window: &mut Window) {
+        self.base.swap(window);
+        mem::swap(&mut self.raster, &mut window.raster_frame);
+        mem::swap(&mut window.scale_factor, &mut self.scale_factor);
+        mem::swap(&mut window.rem_size_override_stack, &mut self.rem_size_overrides);
+    }
+}
+
+impl PaintCtx {
+    fn swap(&mut self, window: &mut Window) {
+        mem::swap(&mut window.element_id_stack, &mut self.element_id_stack);
+        mem::swap(&mut window.text_style_stack, &mut self.text_style_stack);
+        mem::swap(&mut window.rendered_entity_stack, &mut self.rendered_entity_stack);
+        mem::swap(&mut window.element_offset_stack, &mut self.element_offset_stack);
+        mem::swap(&mut window.exact_element_offset_depth, &mut self.exact_element_offset_depth);
+        mem::swap(&mut window.transformation_stack, &mut self.transformation_stack);
+        mem::swap(&mut window.mask_scale, &mut self.mask_scale);
+        mem::swap(&mut window.mask_map, &mut self.mask_map);
+        mem::swap(&mut window.element_opacity, &mut self.element_opacity);
+        mem::swap(&mut window.content_mask_stack, &mut self.content_mask_stack);
+        mem::swap(&mut window.image_cache_stack, &mut self.image_cache_stack);
+        mem::swap(&mut window.next_frame.scene.ink, &mut self.ink);
+        let mut released = self.ink_scope & LAYOUTS_RELEASED != 0;
+        crate::text_system::swap_layouts_released(&mut released);
+        let mut scope = self.ink_scope & !LAYOUTS_RELEASED;
+        mem::swap(&mut window.next_frame.scene.ink_scope, &mut scope);
+        self.ink_scope = scope | if released { LAYOUTS_RELEASED } else { 0 };
+        window.reenter_scroll_node(self.scroll_node, &mut self.scroll_reentry, &mut self.scroll_swapped);
+    }
+}
+
+impl Window {
+    /// Capture the general environment used by positioned/prepaint consumers.
+    pub fn paint_ctx(&self) -> PaintCtx {
+        PaintCtx {
+            identity: paint_scope::Identity::capture(self),
+            layout_owner: self.retained_layout(),
+            element_id_stack: self.element_id_stack.clone(),
+            text_style_stack: self.text_style_stack.clone(),
+            render_contexts: self.render_contexts.snapshot(),
+            rendered_entity_stack: self.rendered_entity_stack.clone(),
+            element_offset_stack: self.element_offset_stack.clone(),
+            exact_element_offset_depth: self.exact_element_offset_depth,
+            transformation_stack: self.transformation_stack.clone(),
+            mask_scale: self.mask_scale,
+            mask_map: self.mask_map,
+            element_opacity: self.element_opacity,
+            content_mask_stack: self.content_mask_stack.clone(),
+            image_cache_stack: self.image_cache_stack.clone(),
+            ink: self.next_frame.scene.ink.clone(),
+            ink_scope: capture_scope(self),
+            scroll_node: self.next_frame.scroll_paint.open.last().copied(),
+            scroll_reentry: None,
+            scroll_swapped: false,
+        }
+    }
+
+    /// Capture all paint and raster state in the current live composition scope.
+    pub fn snapshot_paint_state(&self) -> PaintState {
+        self.paint_state(self.paint_ctx(), self.raster_frame().clone())
+    }
+
+    fn paint_state(&self, base: PaintCtx, raster: RasterFrame) -> PaintState {
+        PaintState {
+            base,
+            raster,
+            scale_factor: self.scale_factor,
+            rem_size_overrides: self.rem_size_override_stack.clone(),
+        }
+    }
+
+    /// Replay a full snapshot. Invalid identity never invokes the callback.
+    pub fn with_paint_state<R>(
+        &mut self,
+        state: PaintState,
+        f: impl FnOnce(&mut Self) -> R,
+    ) -> Result<R, PaintError> {
+        self.replay_paint(state, f)
+    }
+
+    /// Replay the general environment, inheriting the caller's raster placement.
+    pub fn with_paint_ctx<R>(
+        &mut self,
+        ctx: PaintCtx,
+        f: impl FnOnce(&mut Self) -> R,
+    ) -> Result<R, PaintError> {
+        self.replay_paint(self.paint_state(ctx, self.raster_frame().clone()), f)
+    }
+
+
+    fn replay_paint<R>(
+        &mut self,
+        state: PaintState,
+        f: impl FnOnce(&mut Self) -> R,
+    ) -> Result<R, PaintError> {
+        state.base.identity.check(self)?;
+        let mut layout_owner = state.base.layout_owner.clone();
+        // Keep retained vectors outside recursive paint frames.
+        let mut state = Box::new(state);
+        let _contexts = self.render_contexts.enter_snapshot(mem::take(&mut state.base.render_contexts));
+        state.restore(self);
+        // KaminIDE patch: effects of deferred paint taint the sinks it feeds.
+        let f = |window: &mut Self| {
+            let probe = super::retained::InkProbe::open(window);
+            let result = f(window);
+            if let Some(probe) = probe {
+                probe.close(window);
+            }
+            result
+        };
+        Ok(self.with_retained_layout(&mut layout_owner, |window| {
+            window.with_restore(state, |window, state| state.restore(window), f).0
+        }))
+    }
+
+    /// KaminIDE patch: `replay_paint` of a checked state kept by the caller (on the heap,
+    /// outside recursive paint frames); the state holds the captured buffers again afterwards.
+    fn replay_in<R>(&mut self, state: &mut PaintState, f: impl FnOnce(&mut Self) -> R) -> R {
+        let mut layout_owner = state.base.layout_owner.clone();
+        let contexts = self.render_contexts.enter_snapshot(mem::take(&mut state.base.render_contexts));
+        state.restore(self);
+        let f = |window: &mut Self| {
+            let probe = super::retained::InkProbe::open(window);
+            let result = f(window);
+            if let Some(probe) = probe {
+                probe.close(window);
+            }
+            result
+        };
+        let result = self.with_retained_layout(&mut layout_owner, |window| {
+            window.with_restore(&mut *state, |window, state| state.restore(window), f).0
+        });
+        state.base.render_contexts = contexts.finish();
+        result
+    }
+}
diff --git a/vendor/gpui/src/window/paint_snapshot/raster_env.rs b/vendor/gpui/src/window/paint_snapshot/raster_env.rs
new file mode 100644
index 0000000000000000000000000000000000000000..d5b60cb6936ed95c837d990896502ddcf872be06
--- /dev/null
+++ b/vendor/gpui/src/window/paint_snapshot/raster_env.rs
@@ -0,0 +1,243 @@
+//! KaminIDE patch: raster captures of sibling elements share one environment.
+//!
+//! A deferred inline job used to carry a full copy of the paint environment (~1.5 KB, the
+//! element id stack inline, a clone of every stack and of both context tables): thousands
+//! of jobs per frame cost several allocations each and a queue of megabytes. As Blink's
+//! paint chunks point at shared property tree nodes instead of copying transforms and clips
+//! (`PropertyTreeState`), a capture here keeps a reference to the environment of its parent
+//! (the caller's pass remembers the last one and reuses it while it still matches) plus what
+//! differs per element: its own element id, glyph offset, fill transform and exact bounds.
+//! Replay fills the window from the shared environment into reused buffers, so neither capture
+//! nor replay allocates while the environment holds. That scratch belongs to the caller's
+//! paint pass (`RasterCaptures`), as Blink's paint scratch belongs to the `PaintController` of
+//! one paint, not to the window: it lives no longer than the pass.
+
+use super::*;
+
+/// KaminIDE patch: scratch of the raster captures and replays of one paint pass: the last
+/// shared environment and the buffers of a finished replay of a shared environment. Owned by
+/// the caller's pass and cleared when the pass ends, so nothing of it outlives the paint.
+#[derive(Default)]
+pub struct RasterCaptures {
+    env: Cell<Option<Rc<RasterEnv>>>,
+    buffers: Cell<Option<Box<ReplayBuffers>>>,
+}
+
+impl RasterCaptures {
+    /// Forget the shared environment and the replay buffers.
+    pub fn clear(&self) {
+        self.env.take();
+        self.buffers.take();
+    }
+
+    /// `env` without the reference this scratch keeps for later siblings, when no one else
+    /// holds it: its replay then takes the captured stacks over instead of copying them.
+    fn release(&self, env: Rc<RasterEnv>) -> Result<RasterEnv, Rc<RasterEnv>> {
+        if Rc::strong_count(&env) == 2 {
+            match self.env.take() {
+                Some(kept) if Rc::ptr_eq(&kept, &env) => drop(kept),
+                kept => self.env.set(kept),
+            }
+        }
+        Rc::try_unwrap(env)
+    }
+}
+
+/// The environment a raster capture shares with its siblings. Its element id stack is the
+/// prefix common to them (the parent's ids).
+pub(in crate::window) struct RasterEnv {
+    base: PaintCtx,
+    contexts: render_context::Snapshot,
+}
+
+/// Paint environment retaining raster placement at the current device scale.
+pub struct RasterPaintCtx {
+    env: Rc<RasterEnv>,
+    /// Element ids below the shared prefix (the capturing element's own).
+    ids: SmallVec<[ElementId; 1]>,
+    glyph_offset: Point<Pixels>,
+    fill_transform: Option<(TransformationMatrix, TransformationMatrix)>,
+    exact_bounds: Option<(Bounds<Pixels>, Bounds<Pixels>)>,
+}
+
+impl RasterPaintCtx {
+    /// Select fill placement independently of the retained glyph placement.
+    pub fn set_fill_transform(&mut self, transform: Option<(TransformationMatrix, TransformationMatrix)>) {
+        self.fill_transform = transform;
+    }
+
+    /// Whether `self` and `other` share one captured environment (no copy of their own).
+    pub fn shares_environment(&self, other: &Self) -> bool {
+        Rc::ptr_eq(&self.env, &other.env)
+    }
+}
+
+impl RasterEnv {
+    fn capture(window: &Window, prefix: usize) -> Self {
+        let mut base = window.paint_ctx();
+        base.element_id_stack.truncate(prefix);
+        Self { base, contexts: window.raster_frame.contexts.clone() }
+    }
+
+    /// Everything but the capturing element's own id and placement equals the window's.
+    fn matches(&self, window: &Window) -> bool {
+        let b = &self.base;
+        let prefix = b.element_id_stack.len();
+        let depth = window.element_id_stack.len();
+        (depth == prefix || depth == prefix + 1)
+            && b.identity.is_current(window)
+            && b.layout_owner.same(&window.layout_owner)
+            && window.element_id_stack[..prefix] == b.element_id_stack[..]
+            && b.text_style_stack.same(&window.text_style_stack)
+            && window.render_contexts.matches(&b.render_contexts)
+            && b.rendered_entity_stack == window.rendered_entity_stack
+            && b.element_offset_stack == window.element_offset_stack
+            && b.exact_element_offset_depth == window.exact_element_offset_depth
+            && b.transformation_stack == window.transformation_stack
+            && b.mask_scale == window.mask_scale
+            && b.mask_map == window.mask_map
+            && b.element_opacity.to_bits() == window.element_opacity.to_bits()
+            && b.content_mask_stack == window.content_mask_stack
+            && b.image_cache_stack.len() == window.image_cache_stack.len()
+            && b.image_cache_stack.iter().zip(&window.image_cache_stack).all(|(a, b)| a.same(b))
+            && b.ink.len() == window.next_frame.scene.ink.len()
+            && b.ink.iter().zip(&window.next_frame.scene.ink).all(|(a, b)| Rc::ptr_eq(&a.0, &b.0) && a.1 == b.1)
+            && b.ink_scope == super::capture_scope(window)
+            && b.scroll_node == window.next_frame.scroll_paint.open.last().copied()
+            && self.contexts == window.raster_frame.contexts
+    }
+}
+
+/// Buffers of a finished replay of a shared environment, empty, with their capacity: the
+/// next replay of a shared environment fills them instead of allocating.
+#[derive(Default)]
+struct ReplayBuffers {
+    ids: SmallVec<[ElementId; 32]>,
+    contexts: render_context::Snapshot,
+    rendered: Vec<EntityId>,
+    offsets: Vec<Point<Pixels>>,
+    transforms: Vec<TransformationMatrix>,
+    masks: Vec<ContentMask<Pixels>>,
+    images: Vec<AnyImageCache>,
+    ink: InkSinks,
+    raster_contexts: render_context::Snapshot,
+}
+
+impl ReplayBuffers {
+    /// The stacks of `env` copied into these buffers.
+    fn fill(&mut self, env: &RasterEnv, own: &[ElementId]) -> PaintCtx {
+        let b = &env.base;
+        self.ids.extend(b.element_id_stack.iter().chain(own).cloned());
+        b.render_contexts.clone_into(&mut self.contexts);
+        self.rendered.extend_from_slice(&b.rendered_entity_stack);
+        self.offsets.extend_from_slice(&b.element_offset_stack);
+        self.transforms.extend_from_slice(&b.transformation_stack);
+        self.masks.extend_from_slice(&b.content_mask_stack);
+        self.images.extend(b.image_cache_stack.iter().cloned());
+        self.ink.extend(b.ink.iter().cloned());
+        env.contexts.clone_into(&mut self.raster_contexts);
+        PaintCtx {
+            identity: b.identity.clone(),
+            layout_owner: b.layout_owner.clone(),
+            element_id_stack: mem::take(&mut self.ids),
+            text_style_stack: b.text_style_stack.clone(),
+            render_contexts: mem::take(&mut self.contexts),
+            rendered_entity_stack: mem::take(&mut self.rendered),
+            element_offset_stack: mem::take(&mut self.offsets),
+            exact_element_offset_depth: b.exact_element_offset_depth,
+            transformation_stack: mem::take(&mut self.transforms),
+            mask_scale: b.mask_scale,
+            mask_map: b.mask_map,
+            element_opacity: b.element_opacity,
+            content_mask_stack: mem::take(&mut self.masks),
+            image_cache_stack: mem::take(&mut self.images),
+            ink: mem::take(&mut self.ink),
+            ink_scope: b.ink_scope,
+            scroll_node: b.scroll_node,
+            scroll_reentry: None,
+            scroll_swapped: false,
+        }
+    }
+
+    /// Take the buffers back from a finished replay, empty, keeping their capacity.
+    fn reclaim(&mut self, state: PaintState) {
+        let PaintState { base, raster, .. } = state;
+        self.ids = base.element_id_stack;
+        self.contexts = base.render_contexts;
+        self.rendered = base.rendered_entity_stack;
+        self.offsets = base.element_offset_stack;
+        self.transforms = base.transformation_stack;
+        self.masks = base.content_mask_stack;
+        self.images = base.image_cache_stack;
+        self.ink = base.ink;
+        self.raster_contexts = raster.contexts;
+        self.ids.clear();
+        self.contexts.clear();
+        self.rendered.clear();
+        self.offsets.clear();
+        self.transforms.clear();
+        self.masks.clear();
+        self.images.clear();
+        self.ink.clear();
+        self.raster_contexts.clear();
+    }
+}
+
+impl Window {
+    /// Capture environment and raster placement without a scale override; siblings captured
+    /// with the same `captures` share one environment.
+    pub fn raster_paint_ctx(&self, captures: &RasterCaptures) -> RasterPaintCtx {
+        let env = match captures.env.take() {
+            Some(env) if env.matches(self) => env,
+            _ => Rc::new(RasterEnv::capture(self, self.element_id_stack.len().saturating_sub(1))),
+        };
+        captures.env.set(Some(env.clone()));
+        let prefix = env.base.element_id_stack.len();
+        RasterPaintCtx {
+            ids: self.element_id_stack[prefix..].iter().cloned().collect(),
+            glyph_offset: self.raster_frame.glyph_offset,
+            fill_transform: self.raster_frame.fill_transform,
+            exact_bounds: self.raster_frame.exact_bounds,
+            env,
+        }
+    }
+
+    /// Replay captured raster placement in the original live scope. The last replay of an
+    /// environment takes its stacks over (no copy, as a replay of a full snapshot does); a
+    /// replay of a shared one copies them into buffers kept by `captures`.
+    pub fn with_raster_paint_ctx<R>(
+        &mut self,
+        ctx: RasterPaintCtx,
+        captures: &RasterCaptures,
+        f: impl FnOnce(&mut Self) -> R,
+    ) -> Result<R, PaintError> {
+        let RasterPaintCtx { env, ids, glyph_offset, fill_transform, exact_bounds } = ctx;
+        env.base.identity.check(self)?;
+        let (base, contexts, mut buffers) = match captures.release(env) {
+            Ok(RasterEnv { mut base, contexts }) => {
+                base.element_id_stack.extend(ids);
+                (base, contexts, None)
+            }
+            Err(env) => {
+                let mut buffers = captures.buffers.take().unwrap_or_default();
+                let base = buffers.fill(&env, &ids);
+                let contexts = mem::take(&mut buffers.raster_contexts);
+                (base, contexts, Some(buffers))
+            }
+        };
+        let mut state = PaintState {
+            base,
+            raster: RasterFrame { glyph_offset, fill_transform, exact_bounds, contexts },
+            scale_factor: self.scale_factor,
+            rem_size_overrides: self.rem_size_override_stack.clone(),
+        };
+        let result = self.replay_in(&mut state, f);
+        if let Some(buffers) = buffers.as_mut() {
+            buffers.reclaim(state);
+        }
+        if let Some(buffers) = buffers {
+            captures.buffers.set(Some(buffers));
+        }
+        Ok(result)
+    }
+}
