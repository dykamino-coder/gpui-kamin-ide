+#![cfg_attr(target_family = "wasm", no_main)]
+
+#[path = "example_support/fonts.rs"]
+mod example_support;
+
+use gpui::{
+    App, Bounds, ColorSpace, Context, Half, Render, Window, WindowOptions, canvas, div,
