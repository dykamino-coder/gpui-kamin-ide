diff --git a/vendor/gpui/examples/toggle_headless.rs b/vendor/gpui/examples/toggle_headless.rs
new file mode 100644
index 0000000000000000000000000000000000000000..136e31f7e0185bb828ecb56309b185b1e0b26c7c
