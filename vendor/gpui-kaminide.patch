diff --git a/vendor/gpui/src/window/retained_layout.rs b/vendor/gpui/src/window/retained_layout.rs
new file mode 100644
index 0000000000000000000000000000000000000000..acb6311084a1fa2aa73a360b52bd034ea0e532ea
--- /dev/null
+++ b/vendor/gpui/src/window/retained_layout.rs
@@ -0,0 +1,172 @@
+//! Сохранённое дерево независимой раскладки в пределах текущего кадра.
+
+use super::{TaffyLayoutEngine, Window};
+use std::{cell::RefCell, rc::Rc};
+
+/// Цепочка идентификаторов независимо измеренного поддерева в текущем кадре.
+/// Геометрией, клипами, стилем текста и rendered view владеет вызывающий код.
+/// Снимок хранит только живых предков; копии разделяют неизменяемый срез.
+#[derive(Clone, PartialEq, Debug, Default)]
+pub struct ElementIdContext(pub(super) Rc<[crate::ElementId]>);
+
+/// Inputs inherited by an element constructed during deferred measurement.
+/// Paint geometry, clips and effects remain owned by the current traversal.
+#[derive(Clone)]
+pub struct ElementLayoutContext {
+    identity: ElementIdContext,
+    /// Inherited text style and rem size: the scope every measure callback
+    /// already runs in (`Window::measure_scope`).
+    scope: super::text_style_scope::MeasureScope,
+}
+
+/// KaminIDE patch: a measured subtree keeps its layout IDs through paint.
+/// The owner must drop it before the frame arena is reset.
+#[derive(Clone)]
+pub struct RetainedLayout(Rc<RefCell<Option<TaffyLayoutEngine>>>);
+
+thread_local! {
+    /// KaminIDE patch: the engines of the layouts made during the current
+    /// frame (`release_frame_layouts`).
+    static FRAME_LAYOUTS: RefCell<Vec<std::rc::Weak<RefCell<Option<TaffyLayoutEngine>>>>> =
+        const { RefCell::new(Vec::new()) };
+}
+
+impl Default for RetainedLayout {
+    fn default() -> Self {
+        let engine = Rc::new(RefCell::new(Some(TaffyLayoutEngine::new_for_subtree())));
+        FRAME_LAYOUTS.with(|layouts| layouts.borrow_mut().push(Rc::downgrade(&engine)));
+        Self(engine)
+    }
+}
+
+/// KaminIDE patch: drop the engine of every layout made during the frame
+/// that is still alive when the frame ends. A retained layout is frame
+/// scoped (see `RetainedLayout`), yet its owner can be reachable from the
+/// engine itself: a measure function in its nodes captures state that holds
+/// the layout (a prepared float child and the plans that keep it), a cycle
+/// of `Rc`s that would keep the engine, its nodes and the elements behind
+/// them for the life of the process. Dropping the engines at the frame
+/// boundary ends every such cycle, as an arena reset does.
+pub(super) fn release_frame_layouts() {
+    let layouts = FRAME_LAYOUTS.with(|layouts| std::mem::take(&mut *layouts.borrow_mut()));
+    for layout in layouts {
+        let Some(engine) = layout.upgrade() else {
+            continue;
+        };
+        // Taken out first: dropping it runs the destructors of its measure
+        // functions, which may drop other layouts.
+        let taken = engine
+            .try_borrow_mut()
+            .ok()
+            .and_then(|mut slot| slot.take());
+        drop(taken);
+    }
+}
+impl RetainedLayout {
+    /// KaminIDE patch: the same layout owner.
+    pub(super) fn same(&self, other: &Self) -> bool {
+        Rc::ptr_eq(&self.0, &other.0)
+    }
+
+    pub(super) fn active() -> Self {
+        Self(Rc::new(RefCell::new(None)))
+    }
+}
+
+impl Window {
+    /// Retain the arena owning the current traversal's layout IDs.
+    /// Deferred prepaint and paint must reactivate it before using those IDs.
+    pub fn retained_layout(&self) -> RetainedLayout {
+        self.layout_owner.clone()
+    }
+
+    /// Сохраняет цепочку до выхода отложенного измерения из своего view.
+    pub fn element_id_context(&self) -> ElementIdContext {
+        ElementIdContext(Rc::from(self.element_id_stack.as_slice()))
+    }
+
+    /// Preserve inherited layout inputs before a measured callback leaves its ancestors.
+    pub fn element_layout_context(&self) -> ElementLayoutContext {
+        ElementLayoutContext {
+            identity: self.element_id_context(),
+            scope: self.measure_scope(),
+        }
+    }
+
+    /// Construct a measured subtree with the inputs of its original ancestors.
+    pub fn with_element_layout_context<R>(
+        &mut self,
+        context: &ElementLayoutContext,
+        f: impl FnOnce(&mut Window) -> R,
+    ) -> R {
+        context
+            .scope
+            .enter(self, |window| window.with_element_id_context(&context.identity, f))
+    }
+
+    /// Входит в цепочку подготовленного поддерева без повтора paint-состояния.
+    pub fn with_element_id_context<R>(
+        &mut self,
+        context: &ElementIdContext,
+        f: impl FnOnce(&mut Window) -> R,
+    ) -> R {
+        let outer = std::mem::replace(&mut self.element_id_stack, context.0.iter().cloned().collect());
+        self.with_restore(
+            outer,
+            |window, outer| std::mem::swap(&mut window.element_id_stack, outer),
+            f,
+        )
+        .0
+    }
+
+    /// Query a registered subtree's intrinsic axis without replacing its final layout.
+    pub fn measure_layout_size(
+        &mut self,
+        id: crate::LayoutId,
+        available: crate::Size<crate::AvailableSpace>,
+        axis: crate::Axis,
+        cx: &mut crate::App,
+    ) -> crate::Size<crate::Pixels> {
+        let mut engine = self
+            .layout_engine
+            .take()
+            .expect("layout engine during measurement");
+        let size = engine.measure_size(id, available, axis, self, cx);
+        self.layout_engine = Some(engine);
+        size
+    }
+
+    /// KaminIDE patch: temporary independent layout for intrinsic queries.
+    /// Use `with_retained_layout` when the element must survive until paint.
+    pub fn with_nested_layout<R>(&mut self, f: impl FnOnce(&mut Window) -> R) -> R {
+        self.with_retained_layout(&mut RetainedLayout::default(), f)
+    }
+
+    /// Activate a prepared subtree, restoring both engines even on unwind.
+    /// Nested measurement may enter while the surrounding engine is absent.
+    pub fn with_retained_layout<R>(
+        &mut self,
+        retained: &mut RetainedLayout,
+        f: impl FnOnce(&mut Window) -> R,
+    ) -> R {
+        if Rc::ptr_eq(&retained.0, &self.layout_owner.0) {
+            return f(self);
+        }
+        struct Restore<'a> {
+            window: &'a mut Window,
+            outer: RetainedLayout,
+        }
+        impl Drop for Restore<'_> {
+            fn drop(&mut self) {
+                *self.window.layout_owner.0.borrow_mut() = self.window.layout_engine.take();
+                self.window.layout_engine = self.outer.0.borrow_mut().take();
+                self.window.layout_owner = self.outer.clone();
+            }
+        }
+        let outer = std::mem::replace(&mut self.layout_owner, retained.clone());
+        *outer.0.borrow_mut() = self.layout_engine.take();
+        self.layout_engine = retained.0.borrow_mut().take();
+        let restore = Restore { window: self, outer };
+        f(restore.window)
+    }
+}
diff --git a/vendor/gpui/src/window/retained_layout_inputs.rs b/vendor/gpui/src/window/retained_layout_inputs.rs
new file mode 100644
index 0000000000000000000000000000000000000000..1f3eba8201e5f8ac5b602f605b4968340d822651
--- /dev/null
+++ b/vendor/gpui/src/window/retained_layout_inputs.rs
@@ -0,0 +1,112 @@
+//! Keyed state used during request_layout belongs to the recorded subtree even
+//! when layout precedes its prepaint range. Scroll positions can change between
+//! frames without dispatching an input event.
+
+use super::Window;
+use crate::{Pixels, Point, ScrollHandle};
+use std::{
+    cell::{Cell, RefCell},
+    rc::Rc,
+};
+
+#[derive(Clone)]
+pub(super) struct ScrollInput {
+    offset: Rc<RefCell<Point<Pixels>>>,
+    position: Point<Pixels>,
+    handle: Option<ScrollHandle>,
+}
+
+/// Inputs of the layout that produced a retained subtree in this window.
+#[derive(Default)]
+pub struct RetainedLayoutInputs {
+    states: Cell<(usize, usize)>,
+    scroll: Vec<ScrollInput>,
+}
+
+impl RetainedLayoutInputs {
+    /// Each native scroller still has the position the recorded layout saw.
+    pub fn scroll_unchanged(&self) -> bool {
+        self.scroll.iter().all(|input| {
+            *input.offset.borrow() == input.position
+                && !input
+                    .handle
+                    .as_ref()
+                    .is_some_and(ScrollHandle::has_pending_scroll)
+        })
+    }
+}
+
+impl Window {
+    /// A changed layout offset can replay only if the same native scroll handle
+    /// belongs to this recorded range. Its node then supplies the clip and shift.
+    /// A pending scroll-to-item still needs layout to resolve its destination.
+    pub fn layout_scroll_replayable(&self, inputs: &RetainedLayoutInputs, record: &super::RetainedPrepaint) -> bool {
+        let range = record.range();
+        inputs.scroll.iter().all(|input| {
+            let handle = input.handle.as_ref();
+            if handle.is_some_and(ScrollHandle::has_pending_scroll) {
+                return false;
+            }
+            *input.offset.borrow() == input.position || handle.is_some_and(|handle| {
+                let id = super::ScrollNodeId::of(handle);
+                self.rendered_frame.scroll_nodes[range.start.scroll_nodes_index..range.end.scroll_nodes_index]
+                    .iter()
+                    .any(|node| node.id == id)
+            })
+        })
+    }
+
+    /// Capture the keyed state reads and native scroll inputs of this layout.
+    pub fn record_layout_inputs<R>(
+        &mut self,
+        layout: impl FnOnce(&mut Self) -> R,
+    ) -> (R, RetainedLayoutInputs) {
+        let start = self.next_frame.accessed_element_states.len();
+        let outer = self.layout_scroll_inputs.replace(Vec::new());
+        let (result, captured) = self.with_restore(
+            outer,
+            |window, outer| {
+                std::mem::swap(&mut window.layout_scroll_inputs, outer);
+            },
+            layout,
+        );
+        let scroll = captured.unwrap_or_default();
+        if let Some(outer) = &mut self.layout_scroll_inputs {
+            outer.extend_from_slice(&scroll);
+        }
+        (
+            result,
+            RetainedLayoutInputs {
+                states: Cell::new((start, self.next_frame.accessed_element_states.len())),
+                scroll,
+            },
+        )
+    }
+
+    pub(crate) fn record_scroll_input(
+        &mut self,
+        offset: &Rc<RefCell<Point<Pixels>>>,
+        handle: Option<&ScrollHandle>,
+    ) {
+        if let Some(inputs) = &mut self.layout_scroll_inputs {
+            inputs.push(ScrollInput {
+                position: *offset.borrow(),
+                offset: offset.clone(),
+                handle: handle.cloned(),
+            });
+        }
+    }
+
+    /// Keep only this laid-out subtree's keyed states on replay. Advance the
+    /// range to its new location so consecutive replays retain the same states.
+    pub fn replay_layout_inputs(&mut self, inputs: &RetainedLayoutInputs) {
+        let (start, end) = inputs.states.get();
+        let states = &mut self.next_frame.accessed_element_states;
+        let next = states.len();
+        states.extend_from_slice(&self.rendered_frame.accessed_element_states[start..end]);
+        inputs.states.set((next, states.len()));
+        if let Some(outer) = &mut self.layout_scroll_inputs {
+            outer.extend_from_slice(&inputs.scroll);
+        }
+    }
+}
