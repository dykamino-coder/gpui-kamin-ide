diff --git a/vendor/gpui/src/window/grouped_layer.rs b/vendor/gpui/src/window/grouped_layer.rs
new file mode 100644
index 0000000000000000000000000000000000000000..ffd31d257ada20570340aea62601d8d8f5070b5b
--- /dev/null
+++ b/vendor/gpui/src/window/grouped_layer.rs
@@ -0,0 +1,151 @@
+//! KaminIDE patch: scene layers drawn by a copy of their commands.
+//!
+//! A layer whose content made groups (filters, opacity, masks, blend modes)
+//! keeps them in its scene with layer-local ids, as a frame keeps its own:
+//! nested groups first, each a shared handle (`PaintGroup::scene`). The
+//! renderer draws groups only from the frame's list, so a frame draws such a
+//! layer by copying its top commands relabelled past the frame's groups and
+//! appending the layer's groups as handles: no group content is copied, and
+//! the ranges the host recorded inside the layer keep indexing the layer
+//! (box runs, `rerecord_layer_box`). A frame after a write to the layer
+//! copies it again from the layer (`paint_scene_layer`), never an old copy.
+//!
+//! A layer whose groups name the frame's scroll nodes or 3D planes, or that
+//! hoisted backdrops (`SceneLayer::framed`), is drawn the same way and the
+//! copy also takes what needs the frame: its backdrops paint first, its
+//! scroll marks follow its commands, and the scroll nodes painted inside the
+//! layer take the copy's ranges, so the frame scrolls it as its own paint.
+//! Such a layer is still the one target of value writes and box runs: an
+//! edit inside it repaints only the written runs, and the next frame copies
+//! the layer again, as Blink's `PaintController` copies cached subsequences
+//! around the repainted display items instead of painting the chunk anew.
+
+use super::*;
+use crate::scene::{BoxRange, LayerHandle, PaintOperation, SceneLayer};
+
+impl SceneLayer {
+    /// Whether a frame draws the layer by a copy of its commands rather than
+    /// by one command: it kept composition groups or hoisted backdrops.
+    pub fn copied(&self) -> bool {
+        !self.scene().groups.is_empty() || !self.scene().hoisted_backdrops.is_empty()
+    }
+
+    /// Whether the copy needs the frame's scene: hoisted backdrops, a plane
+    /// of a 3D context, or scroll marks or reservoirs with groups, which name
+    /// the frame's scroll nodes by the indices they were painted at. A frame
+    /// scrolls such a copy as its own paint (`Window::paint_grouped_layer`),
+    /// so a scrolled replay of the frame moves the copy, not the layer.
+    pub fn framed(&self) -> bool {
+        let scene = self.scene();
+        let unscrolled = |scene: &Scene| {
+            scene.scroll.marks.is_empty()
+                && !scene.paint_operations.iter().any(|op| matches!(op, PaintOperation::Reservoir(_)))
+        };
+        !scene.hoisted_backdrops.is_empty()
+            || (!scene.groups.is_empty()
+                && !(unscrolled(scene)
+                    && scene.groups.iter().all(|group| {
+                        group.projection.is_none() && group.fragments.is_empty() && unscrolled(&group.scene)
+                    })))
+    }
+}
+
+impl Window {
+    /// `replay_retained_paint` of a record that drew `layer` and nothing else
+    /// in the scene (the document's layer, `record_scene_layer`): when the
+    /// layer is copied into frames, its listeners and states replay from the
+    /// rendered frame and its commands are copied from the layer as it is
+    /// now, which box runs may have been written into since that frame. The
+    /// scroll nodes the record's prepaint copied land on the new copy when it
+    /// has the rendered copy's commands one for one (`land_scroll_paint`).
+    pub fn replay_retained_paint_with_layer(&mut self, record: &RetainedPaint, layer: &LayerHandle) -> RetainedPaint {
+        let content = layer.content();
+        if !content.copied() || self.replay_source().is_some() {
+            return self.replay_retained_paint(record);
+        }
+        debug_assert!(record.replayable_with_groups(), "non-replayable paint record");
+        let (start, base) = (self.paint_index(), self.next_frame.scene.groups.len());
+        let range = record.range();
+        self.reuse_paint_state(&range);
+        let landed = self.next_frame.scene.paint_operations.len();
+        self.paint_grouped_layer(layer, &content, false);
+        if content.framed() {
+            let space = self.rendered_frame.scene.scroll.space;
+            self.land_scroll_paint(range.start.scene_index..range.end.scene_index, landed, space);
+        }
+        self.allow_replayed(record);
+        let made = base..self.next_frame.scene.groups.len();
+        RetainedPaint::of(start..self.paint_index(), true, record.allowed).grouped(made)
+    }
+
+    /// Hand the box runs painted in group `index` (nested groups' runs
+    /// naming their local ids, now moved by `base`) to the scene around:
+    /// its own group's runs, else the layer being recorded.
+    pub(super) fn adopt_group_runs(&mut self, runs: Option<Vec<BoxRange>>, index: u32, base: u32) {
+        let Some(mut runs) = runs else { return };
+        for run in &mut runs {
+            run.group = Some(run.group.map_or(index, |nested| nested + base));
+        }
+        let book = &mut self.next_frame.scene.book;
+        if let Some(outer) = book.group_runs.as_mut() {
+            outer.extend(runs);
+        } else if let Some(record) = book.record_runs.as_mut() {
+            // A paint record's copy carries them (`placed_groups`).
+            record.boxes.extend(runs);
+        } else if let Some(recording) = self.layer_recording.as_mut() {
+            recording.boxes.extend(runs);
+        }
+    }
+
+    /// Draw a layer copied into frames (`SceneLayer::copied`): its backdrops
+    /// paint first, its groups join the frame's list, its top commands are
+    /// copied with their labels renumbered and their scroll marks. `fresh`:
+    /// the layer was just recorded (all of it is new paint), and the scroll
+    /// nodes painted inside a framed layer take the copy's ranges, or are
+    /// torn when the copy is not one command per command; else the frame
+    /// differs from its last copy only where the layer was written since
+    /// (the cell's damage), and the caller lands the nodes the replay copied.
+    pub(super) fn paint_grouped_layer(&mut self, layer: &LayerHandle, content: &SceneLayer, fresh: bool) {
+        let frame = &mut self.next_frame;
+        let written = layer.0.damage.take();
+        if fresh {
+            frame.scene.book.fresh += 1;
+        } else if let Some(rect) = written {
+            frame.scene.book.layer_damage = Some(frame.scene.book.layer_damage.map_or(rect, |d| d.union(&rect)));
+        }
+        let source = content.scene();
+        if !source.hoisted_backdrops.is_empty() {
+            let backdrops = source.hoisted_backdrops.iter().map(|surface| (surface.clone(), None)).collect();
+            frame.scene.adopt_backdrops(backdrops);
+        }
+        let base = frame.scene.groups.len() as i32;
+        let still = |_: crate::ScrollNodeId| (Point::default(), Bounds::default());
+        let groups = source.groups.iter().map(|group| Scene::replayed_group(group, base, None, &still));
+        frame.scene.groups.extend(groups.collect::<Vec<_>>());
+        let landed = frame.scene.paint_operations.len();
+        frame.scene.scroll.raise = 0;
+        frame.scene.relabel = base;
+        frame.scene.replay_record(source);
+        frame.scene.relabel = 0;
+        let count = source.paint_operations.len();
+        frame.scene.copy_scroll_marks(source, 0..count, landed);
+        if !fresh || !content.framed() {
+            return;
+        }
+        let exact = frame.scene.paint_operations.len() - landed == count;
+        let (from, here) = (source.scroll.space, frame.scene.scroll.space);
+        let map = |range: &Range<usize>| landed + range.start..landed + range.end;
+        for node in frame.scroll_nodes.iter_mut().filter(|node| node.painted_in == Some(from)) {
+            if exact {
+                node.paint = node.paint.as_ref().map(map);
+                node.more = node.more.iter().map(map).collect();
+                node.painted_in = Some(here);
+            } else {
+                node.torn = true;
+            }
+        }
+        for dependent in frame.scroll_dependents.iter_mut().filter(|dependent| exact && dependent.2 == from) {
+            (dependent.1, dependent.2) = (landed + dependent.1, here);
+        }
+    }
+}
diff --git a/vendor/gpui/src/window/hit_transform.rs b/vendor/gpui/src/window/hit_transform.rs
new file mode 100644
index 0000000000000000000000000000000000000000..4dd6f006fee72a8210e087a6c2b1d36ce5382818
--- /dev/null
+++ b/vendor/gpui/src/window/hit_transform.rs
@@ -0,0 +1,155 @@
+//! KaminIDE patch: hit testing of a transformed subtree through its inverse matrix.
+//! The host prepaints the subtree once in its untransformed (local) coordinates;
+//! hitboxes keep the scope chain and the frame maps the pointer back before testing.
+
+use super::*;
+
+/// Inverse mapping of one transformed subtree, recorded at prepaint.
+#[derive(Debug)]
+pub(crate) struct HitScope {
+    parent: Option<Rc<HitScope>>,
+    /// Parent-space logical pixels to local logical pixels; `None` is a singular matrix.
+    inverse: Option<TransformationMatrix>,
+    /// The parent's clip at scope entry, in parent space.
+    clip: Bounds<Pixels>,
+}
+
+impl HitScope {
+    /// The pointer in the scope's local coordinates, or `None` when an enclosing
+    /// clip excludes it or a matrix in the chain is singular.
+    pub(crate) fn local(scope: &HitScope, position: Point<Pixels>) -> Option<Point<Pixels>> {
+        let mut chain: SmallVec<[&HitScope; 8]> = SmallVec::new();
+        let mut next = Some(scope);
+        while let Some(scope) = next {
+            chain.push(scope);
+            next = scope.parent.as_deref();
+        }
+        let mut point = position;
+        for scope in chain.iter().rev() {
+            if !scope.clip.contains(&point) {
+                return None;
+            }
+            point = scope.inverse?.apply(point);
+            if !point.x.0.is_finite() || !point.y.0.is_finite() {
+                return None;
+            }
+        }
+        Some(point)
+    }
+}
+
+impl TransformationMatrix {
+    /// The inverse affine map, or `None` for a singular or non-finite matrix.
+    pub fn inverse(&self) -> Option<Self> {
+        let [[a, b], [c, d]] = self.rotation_scale;
+        let det = a * d - b * c;
+        if det == 0.0 || !det.is_finite() {
+            return None;
+        }
+        let rotation_scale = [[d / det, -b / det], [-c / det, a / det]];
+        let [x, y] = self.translation;
+        let translation = [
+            -(rotation_scale[0][0] * x + rotation_scale[0][1] * y),
+            -(rotation_scale[1][0] * x + rotation_scale[1][1] * y),
+        ];
+        let inverse = Self { rotation_scale, translation };
+        (rotation_scale.iter().flatten().chain(&translation).all(|v| v.is_finite())).then_some(inverse)
+    }
+}
+
+impl Window {
+    /// Prepaint a subtree that is painted under `matrix` (logical pixels, local to
+    /// parent). Hitboxes inserted inside are tested at the pointer mapped through
+    /// the inverse matrix; content masks inside are local to the subtree, and the
+    /// parent's clip still applies in parent space. A singular matrix makes the
+    /// subtree's hitboxes unreachable.
+    pub fn with_hitbox_transform<R>(
+        &mut self,
+        matrix: TransformationMatrix,
+        prepaint: impl FnOnce(&mut Self) -> R,
+    ) -> R {
+        self.invalidator.debug_assert_prepaint();
+        let scope = Rc::new(HitScope {
+            parent: self.hit_scope.clone(),
+            inverse: matrix.inverse(),
+            clip: self.content_mask().bounds,
+        });
+        let saved = Box::new((
+            self.hit_scope.replace(scope),
+            std::mem::take(&mut self.content_mask_stack),
+        ));
+        let radius = f32::MAX / 64.0;
+        self.content_mask_stack.push(ContentMask {
+            bounds: Bounds::new(point(px(-radius), px(-radius)), size(px(radius * 2.0), px(radius * 2.0))),
+        });
+        self.with_restore(
+            saved,
+            |window, saved| {
+                window.hit_scope = saved.0.take();
+                window.content_mask_stack = std::mem::take(&mut saved.1);
+            },
+            prepaint,
+        )
+        .0
+    }
+}
+
+/// The hit scope active at a prepaint point (e.g. inside a transformed copy that
+/// replays a segment record); segment placements can be tested through it.
+#[derive(Clone, Default)]
+pub struct PaintHitScope(Option<Rc<HitScope>>);
+
+struct SegmentHitScopes(Rc<[(crate::PaintSegmentId, u32, PaintHitScope)]>);
+
+impl Window {
+    /// The hit scope of the current prepaint position.
+    pub fn paint_hit_scope(&self) -> PaintHitScope {
+        PaintHitScope(self.hit_scope.clone())
+    }
+
+    /// `base` followed by content presented under `matrix` (logical pixels, in
+    /// base space): placements replayed under a presentation are hit through it.
+    pub fn paint_hit_scope_under(&self, base: &PaintHitScope, matrix: TransformationMatrix) -> PaintHitScope {
+        let radius = f32::MAX / 64.0;
+        PaintHitScope(Some(Rc::new(HitScope {
+            parent: base.0.clone(),
+            inverse: matrix.inverse(),
+            clip: Bounds::new(point(px(-radius), px(-radius)), size(px(radius * 2.0), px(radius * 2.0))),
+        })))
+    }
+
+    /// Inside `with_prepaint_segments`, test the listed placements (segment,
+    /// ordinal) through the given scopes instead of the current one: a placement
+    /// replayed under a transformed copy is hit through that copy's matrix.
+    pub fn with_prepaint_segment_hit_scopes<R>(
+        &mut self,
+        scopes: Rc<[(crate::PaintSegmentId, u32, PaintHitScope)]>,
+        prepaint: impl FnOnce(&mut Self) -> R,
+    ) -> R {
+        let _scopes = self.render_contexts.enter(Some(Rc::new(SegmentHitScopes(scopes))));
+        prepaint(self)
+    }
+
+    /// Record the scope of the placement `route` about to be pushed.
+    pub(crate) fn note_segment_hit_scope(&mut self, route: crate::PaintSegment) {
+        let Some(scopes) = self.render_contexts.get::<SegmentHitScopes>() else { return };
+        if let Some((_, _, scope)) = scopes.0.iter().find(|(id, ordinal, _)| *id == route.id && *ordinal == route.ordinal) {
+            let entry = self.next_frame.hitboxes.len();
+            self.next_frame.hitbox_entry_scopes.insert(entry, scope.0.clone());
+        }
+    }
+}
+
+impl HitScope {
+    /// Whether `hitbox`, inserted under `scope`, covers the window point `position`.
+    pub(crate) fn hitbox_contains(scope: Option<&Rc<HitScope>>, hitbox: &Hitbox, position: Point<Pixels>) -> bool {
+        let position = match scope {
+            Some(scope) => match HitScope::local(scope, position) {
+                Some(local) => local,
+                None => return false,
+            },
+            None => position,
+        };
+        hitbox.bounds.intersect(&hitbox.content_mask.bounds).contains(&position)
+    }
+}
diff --git a/vendor/gpui/src/window/hover_view.rs b/vendor/gpui/src/window/hover_view.rs
new file mode 100644
index 0000000000000000000000000000000000000000..dcb6da3d238f3ad862c6a3c2111f5211864ad555
--- /dev/null
+++ b/vendor/gpui/src/window/hover_view.rs
@@ -0,0 +1,69 @@
+//! KaminIDE patch: the hover a retained record painted, and the hover a
+//! later frame would paint over the same hitboxes.
+//!
+//! A box with a hover style decides its paint from its hitbox
+//! (`Interactivity::compute_style`), so a record of its paint holds while the
+//! hover each such hitbox shows is the one it showed then. A host notes the
+//! hitboxes of hover styles a record holds (`Window::retained_hovers`) and,
+//! before it builds the next frame, compares them with the hover the window
+//! shows now (`HoverView`): only a record over a hitbox the pointer entered or
+//! left is built again, as Blink restyles only the elements whose hover state
+//! changed and that have a style affected by it (`ComputedStyle::AffectedByHover`).
+
+use super::*;
+use smallvec::SmallVec;
+
+/// The hover the window shows now, without the window: the hitboxes under
+/// the pointer and what suppresses their hover (`Window::hover_shown`).
+#[derive(Clone, Debug, Default)]
+pub struct HoverView {
+    /// The hover hitboxes of the last hit test, front to back.
+    hovered: SmallVec<[HitboxId; 8]>,
+    captured: Option<HitboxId>,
+    /// An active drag or touch input: no hover shows.
+    suppressed: bool,
+    /// A keyboard input: only a captured hitbox shows its hover.
+    keyboard: bool,
+}
+
+impl HoverView {
+    /// Whether a box over hitbox `id` shows its hover style, as
+    /// `Window::hover_shown` decides it.
+    pub fn shown(&self, id: HitboxId) -> bool {
+        !self.suppressed && (self.captured == Some(id) || (!self.keyboard && self.hovered.contains(&id)))
+    }
+
+    /// Every hover in `hovers` (from `Window::retained_hovers`) is shown now as then.
+    pub fn holds(&self, hovers: &[(HitboxId, bool)]) -> bool {
+        hovers.iter().all(|&(id, shown)| self.shown(id) == shown)
+    }
+}
+
+impl Window {
+    /// The hover the window shows now (`HoverView`).
+    pub fn hover_view(&self, cx: &App) -> HoverView {
+        let hit = &self.mouse_hit_test;
+        HoverView {
+            hovered: hit.ids.iter().take(hit.hover_hitbox_count).copied().collect(),
+            captured: self.captured_hitbox,
+            suppressed: cx.has_active_drag() || self.last_input_was_touch(),
+            keyboard: self.last_input_was_keyboard(),
+        }
+    }
+
+    /// The hitboxes of hover styles (`Frame::hover_hitboxes`) that `prepaint`,
+    /// a range of this frame, inserted, each with whether its box shows its
+    /// hover in this frame. Empty, without allocating, for a range without one.
+    pub fn retained_hovers(&self, prepaint: &RetainedPrepaint, cx: &App) -> Box<[(HitboxId, bool)]> {
+        let range = prepaint.range();
+        let hitboxes = self.next_frame.hitboxes.get(range.start.hitboxes_index..range.end.hitboxes_index);
+        let mut hovers: Vec<(HitboxId, bool)> = Vec::new();
+        for hitbox in hitboxes.into_iter().flatten().filter(|hitbox| self.next_frame.hover_hitboxes.contains(&hitbox.id)) {
+            // A hitbox placed in several segments is one box.
+            if hovers.last().is_none_or(|(id, _)| *id != hitbox.id) {
+                hovers.push((hitbox.id, self.hover_shown(hitbox.id, cx)));
+            }
+        }
+        hovers.into_boxed_slice()
+    }
+}
diff --git a/vendor/gpui/src/window/image_resources.rs b/vendor/gpui/src/window/image_resources.rs
new file mode 100644
index 0000000000000000000000000000000000000000..c91eba2421bcf8d87d79f53c9988e476f260320d
--- /dev/null
+++ b/vendor/gpui/src/window/image_resources.rs
@@ -0,0 +1,152 @@
+//! Raster uploads live until both CPU caches and retained scenes release them.
+
+use crate::scene::image_resources::ImageLease;
+use crate::{PlatformAtlas, RenderImage, RenderImageParams};
+use collections::FxHashMap;
+use std::{
+    rc::Rc,
+    sync::{Arc, Weak},
+};
+
+#[derive(Default)]
+pub(super) struct ImageUploads(FxHashMap<RenderImageParams, Upload>);
+
+struct Upload {
+    image: Weak<RenderImage>,
+    lease: Rc<ImageLease>,
+}
+
+impl ImageUploads {
+    pub(super) fn lease(
+        &mut self,
+        atlas: &Arc<dyn PlatformAtlas>,
+        image: &Arc<RenderImage>,
+        frame_index: usize,
+    ) -> Rc<ImageLease> {
+        let key = RenderImageParams {
+            image_id: image.id,
+            frame_index,
+        };
+        let upload = self.0.entry(key.clone()).or_insert_with(|| Upload {
+            image: Arc::downgrade(image),
+            lease: ImageLease::new(atlas, key.into()),
+        });
+        upload.lease.clone()
+    }
+
+    pub(super) fn release_unused(&mut self) {
+        // Weak ownership lets CPU caches evict pixels. Retained and replayed
+        // scenes keep their own leases until their last painted frame is gone.
+        self.0.retain(|_, upload| upload.image.strong_count() > 0);
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::{AtlasKey, HeadlessAtlas, Scene};
+    use std::borrow::Cow;
+
+    fn upload(
+        uploads: &mut ImageUploads,
+        atlas: &Arc<dyn PlatformAtlas>,
+        image: &Arc<RenderImage>,
+        scene: &mut Scene,
+    ) -> AtlasKey {
+        let key: AtlasKey = RenderImageParams {
+            image_id: image.id,
+            frame_index: 0,
+        }
+        .into();
+        let tile = atlas
+            .get_or_insert_with(key.clone(), &mut || {
+                Ok(Some((
+                    image.size(0),
+                    Cow::Borrowed(image.as_bytes(0).unwrap()),
+                )))
+            })
+            .unwrap()
+            .unwrap();
+        scene.keep_image(tile, uploads.lease(atlas, image, 0));
+        key
+    }
+
+    #[test]
+    fn cpu_cache_and_scene_share_one_upload_owner() {
+        let atlas: Arc<dyn PlatformAtlas> = Arc::new(HeadlessAtlas::default());
+        let mut uploads = ImageUploads::default();
+        let image = crate::bgra_bytes_to_image(2, 2, vec![255; 16]).unwrap();
+        let mut old = Scene::default();
+        let key = upload(&mut uploads, &atlas, &image, &mut old);
+        let mut next = Scene::default();
+        upload(&mut uploads, &atlas, &image, &mut next);
+        assert_eq!(uploads.0.len(), 1);
+        old.clear();
+        uploads.release_unused();
+        assert!(atlas.contains(&key));
+        drop(image);
+        uploads.release_unused();
+        assert!(atlas.contains(&key));
+        next.clear();
+        assert!(!atlas.contains(&key));
+    }
+
+    #[test]
+    fn raster_churn_is_bounded_by_live_frames_and_cpu_images() {
+        let atlas: Arc<dyn PlatformAtlas> = Arc::new(HeadlessAtlas::default());
+        let mut uploads = ImageUploads::default();
+        let mut previous = Scene::default();
+        let mut expired = Vec::new();
+        for _ in 0..12 {
+            let mut next = Scene::default();
+            let mut keys = Vec::new();
+            for _ in 0..80 {
+                let image = crate::bgra_bytes_to_image(2, 2, vec![255; 16]).unwrap();
+                keys.push(upload(&mut uploads, &atlas, &image, &mut next));
+            }
+            uploads.release_unused();
+            assert!(uploads.0.is_empty());
+            previous.clear();
+            assert!(expired.iter().all(|key| !atlas.contains(key)));
+            assert!(keys.iter().all(|key| atlas.contains(key)));
+            expired = keys;
+            previous = next;
+        }
+        previous.clear();
+        assert!(expired.iter().all(|key| !atlas.contains(key)));
+    }
+
+    #[test]
+    fn separate_atlases_release_their_own_uploads() {
+        let a: Arc<dyn PlatformAtlas> = Arc::new(HeadlessAtlas::default());
+        let b: Arc<dyn PlatformAtlas> = Arc::new(HeadlessAtlas::default());
+        let (mut ac, mut bc) = (ImageUploads::default(), ImageUploads::default());
+        let image = crate::bgra_bytes_to_image(2, 2, vec![255; 16]).unwrap();
+        let (mut sa, mut sb) = (Scene::default(), Scene::default());
+        let key = upload(&mut ac, &a, &image, &mut sa);
+        upload(&mut bc, &b, &image, &mut sb);
+        drop(image);
+        ac.release_unused();
+        bc.release_unused();
+        sa.clear();
+        assert!(!a.contains(&key));
+        assert!(b.contains(&key));
+        sb.clear();
+        assert!(!b.contains(&key));
+    }
+
+    #[test]
+    fn clipped_upload_without_scene_owner_is_collected() {
+        let atlas: Arc<dyn PlatformAtlas> = Arc::new(HeadlessAtlas::default());
+        let mut uploads = ImageUploads::default();
+        let image = crate::bgra_bytes_to_image(2, 2, vec![255; 16]).unwrap();
+        let mut scene = Scene::default();
+        let key = upload(&mut uploads, &atlas, &image, &mut scene);
+        scene.clear();
+        uploads.release_unused();
+        assert!(atlas.contains(&key), "the CPU cache still owns the image");
+        drop(image);
+        uploads.release_unused();
+        assert!(!atlas.contains(&key));
+    }
+}
diff --git a/vendor/gpui/src/window/image_sampling.rs b/vendor/gpui/src/window/image_sampling.rs
new file mode 100644
index 0000000000000000000000000000000000000000..51215514851eeb6ac1d00c77fea14116dace369c
--- /dev/null
+++ b/vendor/gpui/src/window/image_sampling.rs
@@ -0,0 +1,158 @@
+//! Image sampling selected by the caller without changing the native UI default.
+
+use super::*;
+
+/// How a raster image is sampled between its source pixels.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum ImageSampling {
+    /// Interpolate neighboring pixels when resizing an image.
+    Linear,
+    /// Interpolate while preserving fractional destination geometry.
+    LinearSubpixel,
+    /// Preserve source pixel boundaries without interpolation.
+    Nearest,
+    /// Interpolate with untransformed destination edges snapped to device pixels.
+    LinearSnapped,
+    /// Preserve source pixels with untransformed edges snapped to device pixels.
+    NearestSnapped,
+}
+
+/// A repeated image requested around one cell's paint (`with_sprite_pattern`).
+#[derive(Clone, Copy, Debug)]
+pub(crate) struct PatternRequest {
+    cells: (u32, u32),
+    corner_radii: Corners<Pixels>,
+}
+
+impl Window {
+    /// KaminIDE patch: paint the first cell of a grid of `cells` (columns,
+    /// rows) equal, abutting cells of one image as ONE sprite over the grid.
+    ///
+    /// The image sprite `f` paints (`paint_image_with_sampling`) for the
+    /// first cell is widened over the whole grid with that cell's snapped
+    /// size as its pattern and `corner_radii` (the grid's) as its corners;
+    /// each cell then samples exactly what its own sprite would (the shader
+    /// addresses the cell's texels the same way). A background of a thousand
+    /// tiles was a thousand instances. The caller guarantees that the cells
+    /// step by the snapped cell size exactly (a whole number of device
+    /// pixels). Returns whether a sprite took the request; when not (nothing
+    /// drew, or `f` drew no image sprite), only the first cell is painted.
+    pub fn with_sprite_pattern<R>(
+        &mut self,
+        cells: (u32, u32),
+        corner_radii: Corners<Pixels>,
+        f: impl FnOnce(&mut Self) -> R,
+    ) -> (R, bool) {
+        self.sprite_pattern = Some(PatternRequest {
+            cells,
+            corner_radii,
+        });
+        let result = f(self);
+        (result, self.sprite_pattern.take().is_none())
+    }
+
+    /// Paint an image with an explicit sampling mode during the paint phase.
+    /// Panics if `frame_index` is invalid, like `paint_image`.
+    pub fn paint_image_with_sampling(
+        &mut self,
+        bounds: Bounds<Pixels>,
+        corner_radii: Corners<Pixels>,
+        data: Arc<RenderImage>,
+        frame_index: usize,
+        grayscale: bool,
+        sampling: ImageSampling,
+    ) -> Result<()> {
+        self.paint_image_with_sampling_tile(
+            bounds,
+            corner_radii,
+            data,
+            frame_index,
+            grayscale,
+            sampling,
+        )
+        .map(|_| ())
+    }
+
+    pub(super) fn paint_image_with_sampling_tile(
+        &mut self,
+        bounds: Bounds<Pixels>,
+        corner_radii: Corners<Pixels>,
+        data: Arc<RenderImage>,
+        frame_index: usize,
+        grayscale: bool,
+        sampling: ImageSampling,
+    ) -> Result<Option<AtlasTile>> {
+        self.invalidator.debug_assert_paint();
+        let scale_factor = self.scale_factor();
+        let bounds = bounds.scale(scale_factor);
+        let params = RenderImageParams {
+            image_id: data.id,
+            frame_index,
+        };
+        let tile = self
+            .sprite_atlas
+            .get_or_insert_with(params.into(), &mut || {
+                Ok(Some((
+                    data.size(frame_index),
+                    data.upload_bytes(frame_index).ok_or_else(|| anyhow::anyhow!("image pixels unavailable"))?,
+                )))
+            })?
+            .expect("Callback above only returns Some");
+        let lease = self.image_uploads.lease(&self.sprite_atlas, &data, frame_index);
+        let content_mask = self.content_mask().scale(scale_factor);
+        // Unsnapped cells keep fractional edges, which only their own
+        // sprites draw exactly: such a request is left untaken.
+        let pattern = match sampling {
+            ImageSampling::LinearSubpixel => None,
+            _ => self.sprite_pattern.take(),
+        };
+        let corner_radii = pattern
+            .map_or(corner_radii, |p| p.corner_radii)
+            .scale(scale_factor);
+        let opacity = self.element_opacity();
+        let transformation = self.current_transformation();
+        let before = self.next_frame.scene.len();
+        let cell = match sampling {
+                ImageSampling::LinearSubpixel => bounds,
+                ImageSampling::LinearSnapped | ImageSampling::NearestSnapped => {
+                    Bounds::from_corners(
+                        point(bounds.left().round(), bounds.top().round()),
+                        point(bounds.right().round(), bounds.bottom().round()),
+                    )
+                }
+                _ => bounds
+                    .map_origin(|origin| origin.floor())
+                    .map_size(|size| size.ceil()),
+        };
+        // A pattern spans the grid of cells from the first cell's place.
+        let (bounds, pattern) = match pattern {
+            Some(PatternRequest { cells: (nx, ny), .. }) => (
+                Bounds::new(cell.origin, size(cell.size.width * nx as f32, cell.size.height * ny as f32)),
+                cell.size,
+            ),
+            None => (cell, Size::default()),
+        };
+        // Under the open scroll node like every primitive (`insert_scene_primitive`).
+        self.insert_scene_primitive(PolychromeSprite {
+            transformation,
+            order: 0,
+            pad: u32::from(matches!(
+                sampling,
+                ImageSampling::Nearest | ImageSampling::NearestSnapped
+            )),
+            grayscale: grayscale.into(),
+            bounds,
+            pattern,
+            content_mask,
+            corner_radii,
+            tile,
+            opacity,
+        });
+        if self.next_frame.scene.len() > before {
+            self.next_frame.scene.keep_image(tile, lease);
+            Ok(Some(tile))
+        } else {
+            Ok(None)
+        }
+    }
+}
diff --git a/vendor/gpui/src/window/isolated.rs b/vendor/gpui/src/window/isolated.rs
new file mode 100644
index 0000000000000000000000000000000000000000..93f2f0bbacaa0657963ad078248a1a785e5c1941
--- /dev/null
+++ b/vendor/gpui/src/window/isolated.rs
@@ -0,0 +1,91 @@
+//! KaminIDE patch: frames that keep the root and redraw only isolated views.
+//!
+//! An isolated view (`elements/isolated.rs`) is drawn as a deferred draw in a
+//! box its parent laid out. Notifying it marks only the view itself dirty
+//! (`mark_view_dirty`). If every dirty view lies inside an isolated view, the
+//! frame replays the previous root tree as a whole (`reuse_prepaint` and
+//! `reuse_paint` over the root's recorded ranges) and redraws the dirty
+//! isolated draws in their recorded boxes; the root is neither rendered nor
+//! laid out. Upstream GPUI always renders the root and every view on the path
+//! to a notified view; this is the relayout boundary that path lacks.
+
+use super::*;
+
+/// What an isolated deferred draw needs to draw its view again alone.
+#[derive(Clone)]
+pub(crate) struct IsolatedDraw {
+    pub(crate) view: AnyView,
+    pub(crate) size: Size<Pixels>,
+}
+
+/// Where the root tree of the drawn frame sits in its prepaint and paint records.
+#[derive(Clone, Default)]
+pub(crate) struct RootRanges {
+    pub(crate) prepaint: Range<PrepaintStateIndex>,
+    pub(crate) paint: Range<PaintIndex>,
+}
+
+impl Window {
+    /// Lay `view` out alone in `bounds` and draw it after the parent tree,
+    /// clipped to the current content mask.
+    pub(crate) fn defer_isolated(&mut self, view: AnyView, bounds: Bounds<Pixels>, cx: &mut App) {
+        let mut element = view.clone().into_any_element();
+        element.layout_as_root(bounds.size.into(), self, cx);
+        let content_mask = Some(self.content_mask());
+        self.defer_draw(element, bounds.origin, 0, content_mask);
+        self.next_frame.isolated_views.insert(view.entity_id());
+        if let Some(draw) = self.next_frame.deferred_draws.last_mut() {
+            draw.isolated = Some(IsolatedDraw {
+                view,
+                size: bounds.size,
+            });
+        }
+    }
+
+    /// The previous root tree may be kept: only isolated views changed and
+    /// nothing else of the frame is drawn from scratch.
+    pub(super) fn kept_root(&self, cx: &App) -> Option<RootRanges> {
+        #[cfg(any(feature = "inspector", debug_assertions))]
+        if self.inspector.is_some() {
+            return None;
+        }
+        let keep = !self.refreshing
+            && !self.dirty_outside_isolated
+            && !self.dirty_views.is_empty()
+            && self.prompt.is_none()
+            && cx.active_drag.is_none()
+            && !self.a11y.is_active();
+        if keep { self.root_ranges.clone() } else { None }
+    }
+
+    /// Replay the kept root tree into the next frame (prepaint half).
+    pub(super) fn reuse_root_prepaint(&mut self, kept: &RootRanges, cx: &mut App) {
+        cx.entities.extend_accessed(&self.last_accessed_entities);
+        self.next_frame.window_control_hitboxes =
+            self.rendered_frame.window_control_hitboxes.clone();
+        self.reuse_prepaint(kept.prepaint.clone());
+    }
+
+    /// A reused isolated draw whose view is dirty gets its element built
+    /// again in the recorded box; other draws keep their recorded ranges.
+    pub(super) fn rebuild_isolated(&mut self, ix: usize, cx: &mut App) {
+        let draw = &self.next_frame.deferred_draws[ix];
+        let Some(isolated) = draw.isolated.clone() else {
+            return;
+        };
+        if draw.element.is_some() || !self.dirty_views.contains(&isolated.view.entity_id()) {
+            return;
+        }
+        let rem_size = draw.rem_size;
+        self.element_id_stack.clone_from(&draw.element_id_stack);
+        self.text_style_stack = draw.text_style_stack.clone();
+        let mut element = isolated.view.into_any_element();
+        self.with_rem_size(Some(rem_size), |window| {
+            element.layout_as_root(isolated.size.into(), window, cx);
+        });
+        let layout_owner = self.retained_layout();
+        let draw = &mut self.next_frame.deferred_draws[ix];
+        draw.element = Some(element);
+        draw.layout_owner = layout_owner;
+    }
+}
diff --git a/vendor/gpui/src/window/layer_band.rs b/vendor/gpui/src/window/layer_band.rs
new file mode 100644
index 0000000000000000000000000000000000000000..31fcbe97cbf96ff191bdb811cc663bd57eba5d0c
--- /dev/null
+++ b/vendor/gpui/src/window/layer_band.rs
@@ -0,0 +1,58 @@
+//! KaminIDE patch: the pieces of inline boxes' bands in a scene layer
+//! (`text_system::band_piece`): their recording, and their recording again
+//! from a new band style.
+
+use super::*;
+use crate::scene::{LayerHandle, LayerPainter, RunPainter};
+use crate::text_system::band_piece::{BandEdges, paint_piece_style};
+use crate::BandStyle;
+
+impl Window {
+    /// Whether a scene layer records the paint now.
+    pub(crate) fn records_layer(&self) -> bool {
+        self.layer_recording.is_some()
+    }
+
+    /// The paint `f` of a piece of the band of inline box `owner` on a line,
+    /// segment `bounds`: in a layer recording the box's run, a recordable
+    /// piece when `edges` are given.
+    pub(crate) fn with_band_piece<R>(
+        &mut self,
+        owner: u32,
+        bounds: Bounds<Pixels>,
+        edges: Option<BandEdges>,
+        f: impl FnOnce(&mut Self) -> R,
+    ) -> R {
+        self.with_run(owner, bounds, RunPainter::Band(edges), f)
+    }
+
+    /// Box `owner` has paint in this recording outside its runs: the layer
+    /// holds none of its runs and bindings (`SceneLayer::finish`).
+    pub(crate) fn unhold_owner(&mut self, owner: u32) {
+        crate::scene::no_run::note(owner, "its paint left its runs (a split or unshown band piece, paint placed apart)");
+        if let Some(runs) = self.next_frame.scene.book.record_runs.as_mut() {
+            runs.unheld.push(owner);
+        } else if let Some(recording) = self.layer_recording.as_mut() {
+            recording.unheld.push(owner);
+        }
+    }
+
+    /// Paint every piece of the band of inline box `owner` in `layer` again
+    /// with `style` and replace its runs with them, in the order of their
+    /// lines' stacking layers (`Window::rerecord_layer_box`). `None`, the
+    /// layer as it was for the runs not yet replaced, when a run of the box
+    /// is no recordable piece (`LayerHandle::holds_band`).
+    pub fn rerecord_layer_band(
+        &mut self,
+        layer: &LayerHandle,
+        owner: u32,
+        cx: &mut App,
+        style: BandStyle,
+    ) -> Option<bool> {
+        self.rerecord_runs(layer, owner, cx, LayerPainter::Band, |window, _, env| {
+            if let RunPainter::Band(Some(edges)) = env.painter {
+                paint_piece_style(env.bounds, edges, style, window);
+            }
+        })
+    }
+}
diff --git a/vendor/gpui/src/window/layer_box.rs b/vendor/gpui/src/window/layer_box.rs
new file mode 100644
index 0000000000000000000000000000000000000000..5bd3bc685ba8fbcaa5cf27db7c39ef819767c9ae
--- /dev/null
+++ b/vendor/gpui/src/window/layer_box.rs
@@ -0,0 +1,262 @@
+//! KaminIDE patch: the own paint of a box in a scene layer, and its later
+//! recording into the box's run (`scene::layer::boxes`).
+//!
+//! A host repaints a box whose painted values changed and whose layout did
+//! not by painting only the box's own commands again, in the paint state the
+//! first recording saved; the layer replaces the box's
+//! run with them (`SceneLayer::replace_box`). Neither the box's descendants
+//! nor its neighbours paint again, and the frame that shows the layer copies
+//! none of its primitives.
+
+use super::scene_layer::LayerRecording;
+use super::*;
+use crate::scene::{BoxEnv, LayerHandle, LayerPainter, Primitive, RunPainter};
+use crate::{PaintTraversal, Style};
+
+impl Window {
+    /// Record the painter that produced the run alongside its geometry and commands.
+    pub(crate) fn with_run<R>(
+        &mut self,
+        owner: u32,
+        bounds: Bounds<Pixels>,
+        painter: RunPainter,
+        f: impl FnOnce(&mut Self) -> R,
+    ) -> R {
+        let hover = self.run_hover.take();
+        if owner == 0 || self.layer_recording.is_none() {
+            return self.with_paint_owner(owner, f);
+        }
+        let env = BoxEnv {
+            bounds,
+            mask: self.content_mask(),
+            transformation: self.current_transformation(),
+            opacity: self.element_opacity(),
+            rem_size: self.rem_size(),
+            exact: self.raster_frame.exact_bounds.filter(|(snapped, _)| *snapped == bounds).map(|(_, exact)| exact),
+            fill: None,
+            layer: None,
+            painter,
+            hover,
+        };
+        let area = self.box_area(&env);
+        if !self.next_frame.scene.open_box(owner, area, env) {
+            if let Some(why) = self.next_frame.scene.run_refusal() {
+                crate::scene::no_run::note(owner, why);
+            }
+            // A partial set of runs cannot represent all paint for this owner.
+            self.unhold_owner(owner);
+            return self.with_paint_owner(owner, f);
+        }
+        let result = self.with_paint_owner(owner, f);
+        let range = self.next_frame.scene.close_box();
+        // A paint record keeps the run for its placements (`scene::layer::placed`).
+        if let (Some(range), Some(runs)) = (&range, self.next_frame.scene.book.record_runs.as_mut()) {
+            runs.boxes.push(range.clone());
+        } else if let (Some(range), Some(runs)) = (&range, self.next_frame.scene.book.group_runs.as_mut()) {
+            runs.push(range.clone());
+        } else if let (Some(range), Some(recording)) = (range, self.layer_recording.as_mut()) {
+            recording.boxes.push(range);
+        }
+        result
+    }
+
+    /// Where the host places the fill of `style` in `bounds`; a box recorded
+    /// again takes the bounds its first recording placed, the host's raster
+    /// frame of that paint being gone.
+    /// A first recording places every fill on its own bounds: a box painted
+    /// per fragment (`BoxPainter`) has one fill per fragment.
+    pub(crate) fn box_fill_bounds(&self, style: &Style, bounds: Bounds<Pixels>) -> Bounds<Pixels> {
+        if let Some(fill) = self.box_fill {
+            return fill;
+        }
+        self.render_context::<PaintTraversal>()
+            .map_or(bounds, |host| (host.fill_bounds)(style, bounds, self))
+    }
+
+    /// Keep the fill bounds of the box whose own paint is open, painted or
+    /// not. A second fill (the box painted per fragment) is no one fill a
+    /// later recording could restore: the run is then not replaceable.
+    pub(crate) fn note_box_fill(&mut self, style: &Style, bounds: Bounds<Pixels>) {
+        if self.box_fill.is_none() && self.next_frame.scene.box_open() {
+            let fill = self.box_fill_bounds(style, bounds);
+            self.next_frame.scene.note_open_box_fill(fill);
+        }
+    }
+
+    /// The border box of `env` placed on the screen, in device pixels.
+    fn box_area(&self, env: &BoxEnv) -> Bounds<ScaledPixels> {
+        let scale = self.scale_factor();
+        let quad = Quad {
+            transformation: env.transformation,
+            bounds: env.bounds.scale(scale),
+            content_mask: env.mask.scale(scale),
+            ..Default::default()
+        };
+        crate::scene::ink_of(&Primitive::Quad(quad))
+    }
+
+    /// Paint the own commands of box `owner` in `layer` again with `paint`
+    /// (given the border box), in the paint state of its recording, and
+    /// replace its runs with them, ordered as a paint from scratch orders them. `None`, with the layer as it
+    /// was for the box's runs not yet replaced, when the box has no
+    /// replaceable run or the new commands would need another order; then
+    /// the host paints the layer again. `Some(moved)`: whether paint
+    /// commands after a run moved (ranges recorded in the layer are void).
+    pub fn rerecord_layer_box(
+        &mut self,
+        layer: &LayerHandle,
+        owner: u32,
+        cx: &mut App,
+        mut paint: impl FnMut(&mut Self, &mut App, Bounds<Pixels>),
+    ) -> Option<bool> {
+        self.rerecord_runs(layer, owner, cx, LayerPainter::Box, |w, cx, env| paint(w, cx, env.bounds))
+    }
+
+    /// Record the runs of box `owner` again, each with `paint` in the paint
+    /// state of its recording: the box's own painter's runs (`band` false,
+    /// outside stacking layers) or the pieces of its band (`band`, in the
+    /// stacking layer of their line).
+    pub(crate) fn rerecord_runs(
+        &mut self,
+        layer: &LayerHandle,
+        owner: u32,
+        cx: &mut App,
+        painter: LayerPainter,
+        mut paint: impl FnMut(&mut Self, &mut App, &BoxEnv),
+    ) -> Option<bool> {
+        if self.layer_recording.is_some() || !layer.accepts(owner, painter) {
+            return None;
+        }
+        let runs: Vec<usize> = {
+            let content = layer.0.content.borrow();
+            content.runs_of(owner).collect()
+        };
+        let mut moved = false;
+        for at in runs {
+            let (area, mut env, placed) = {
+                let content = layer.0.content.borrow();
+                let b = &content.boxes[at];
+                (b.area, b.env, b.placed)
+            };
+            // The run now records the hover the box shows now.
+            env.hover = env.hover.map(|(id, _)| (id, self.hover_shown(id, cx)));
+            // A run in a stacking layer keeps the layer's order
+            // (`SceneLayer::plan_layer_run`): only band pieces are there.
+            let (scene, bindings) = self.paint_box_run(owner, area, env, cx, &mut paint);
+            // A run placed from a paint record: the new commands are placed the same way.
+            let (scene, bindings) = match placed {
+                Some(placed) => crate::scene::place_run(scene, bindings, placed)?,
+                None => (scene, bindings),
+            };
+            let mut current = layer.0.content.borrow_mut();
+            let (damage, shifted) = if current.boxes[at].group.is_some() {
+                // The layer is held by no frame (a grouped layer is copied
+                // into frames), so this takes no copy of its top commands.
+                Rc::make_mut(&mut *current).replace_group_run(at, scene, bindings)?
+            } else {
+                let plan = current.check_box(at, &scene)?;
+                Rc::make_mut(&mut *current).replace_box(at, scene, bindings, plan)
+            };
+            moved |= shifted;
+            // The run shows the hover it was painted with now.
+            if current.boxes[at].env.hover != env.hover {
+                Rc::make_mut(&mut *current).boxes[at].env.hover = env.hover;
+            }
+            drop(current);
+            if let Some(rect) = damage {
+                let old = layer.0.damage.get();
+                layer
+                    .0
+                    .damage
+                    .set(Some(old.map_or(rect, |d| d.union(&rect))));
+            }
+            crate::scene::layer_counters::BOXES_RERECORDED
+                .fetch_add(1, std::sync::atomic::Ordering::Relaxed);
+        }
+        Some(moved)
+    }
+
+    /// Whether a box shows its hover style over hitbox `id`, as its paint
+    /// decides it (`Interactivity::compute_style`).
+    pub(crate) fn hover_shown(&self, id: crate::HitboxId, cx: &App) -> bool {
+        !cx.has_active_drag() && !self.last_input_was_touch() && id.is_hovered(self)
+    }
+
+    /// Whether box `owner`, recorded in `layer` with a hover style, shows it
+    /// now: `None` when no run of the box was painted with one. A host that
+    /// records the box again paints the style this names
+    /// (`rerecord_layer_box`); a run whose answer differs from the one it was
+    /// painted with shows another hover than the screen (`hover_changed`).
+    pub fn layer_box_hover(&self, layer: &LayerHandle, owner: u32, cx: &App) -> Option<bool> {
+        let content = layer.0.content.borrow();
+        let id = content.runs_of(owner).find_map(|at| content.boxes[at].env.hover)?.0;
+        Some(self.hover_shown(id, cx))
+    }
+
+    /// The boxes of `layer` whose runs show another hover than they would
+    /// paint now, in paint order, each once: the pointer entered or left them
+    /// since (`Interactivity` notifies on that transition). A host records
+    /// them again before the frame replays the layer (`rerecord_layer_box`),
+    /// as Blink restyles the element whose hover state changed
+    /// (`Element::SetHovered`) and repaints only its display items.
+    pub fn layer_hover_changes(&self, layer: &LayerHandle, cx: &App) -> Vec<u32> {
+        let content = layer.0.content.borrow();
+        let mut owners: Vec<u32> = Vec::new();
+        for &at in content.hover_runs() {
+            let run = &content.boxes[at as usize];
+            if let Some((id, shown)) = run.env.hover
+                && self.hover_shown(id, cx) != shown
+                && owners.last() != Some(&run.owner)
+            {
+                owners.push(run.owner);
+            }
+        }
+        owners
+    }
+
+    /// Paint one run of box `owner` into a scratch scene, in `env`.
+    pub(super) fn paint_box_run(
+        &mut self,
+        owner: u32,
+        area: Bounds<ScaledPixels>,
+        env: BoxEnv,
+        cx: &mut App,
+        paint: &mut impl FnMut(&mut Self, &mut App, &BoxEnv),
+    ) -> (Scene, Vec<crate::scene::Binding>) {
+        let recording = Box::new(LayerRecording {
+            bindings: Vec::new(),
+            boxes: Vec::new(),
+            unheld: Vec::new(),
+            source: None,
+        });
+        let mut state = (Scene::default(), Some(recording));
+        mem::swap(&mut self.next_frame.scene, &mut state.0);
+        mem::swap(&mut self.layer_recording, &mut state.1);
+        let phase = self.invalidator.phase();
+        self.invalidator.set_phase(DrawPhase::Paint);
+        self.content_mask_stack.push(env.mask);
+        let opacity = mem::replace(&mut self.element_opacity, env.opacity);
+        // A run painted under a transformation paints again under it.
+        let unit = env.transformation == TransformationMatrix::unit();
+        let restored = if unit { Vec::new() } else { vec![env.transformation] };
+        let transforms = mem::replace(&mut self.transformation_stack, restored);
+        self.box_fill = env.fill;
+        // The unrounded box its border snapping read when it was recorded.
+        let exact = mem::replace(&mut self.raster_frame.exact_bounds, env.exact.map(|exact| (env.bounds, exact)));
+        self.next_frame.scene.open_box(owner, area, env);
+        self.with_rem_size(Some(env.rem_size), |window| {
+            window.with_paint_owner(owner, |window| paint(window, cx, &env))
+        });
+        self.next_frame.scene.close_box();
+        self.raster_frame.exact_bounds = exact;
+        self.box_fill = None;
+        self.transformation_stack = transforms;
+        self.element_opacity = opacity;
+        self.content_mask_stack.pop();
+        self.invalidator.set_phase(phase);
+        mem::swap(&mut self.next_frame.scene, &mut state.0);
+        mem::swap(&mut self.layer_recording, &mut state.1);
+        let bindings = state.1.map_or_else(Vec::new, |r| r.bindings);
+        (state.0, bindings)
+    }
+}
diff --git a/vendor/gpui/src/window/layout_inputs.rs b/vendor/gpui/src/window/layout_inputs.rs
new file mode 100644
index 0000000000000000000000000000000000000000..446320ca49ecf83009dd1c98c261f726030bf45a
--- /dev/null
+++ b/vendor/gpui/src/window/layout_inputs.rs
@@ -0,0 +1,160 @@
+//! KaminIDE patch: завершение входов стиля из layout до фиксации кадра.
+use super::*;
+
+/// Идентичность постоянного источника layout-dependent style input.
+/// Копии одной коробки используют тот же идентификатор.
+#[derive(Clone, Copy, Debug, Eq, Hash, PartialEq)]
+pub struct LayoutInputId(u64);
+
+impl Default for LayoutInputId {
+    fn default() -> Self {
+        use std::sync::atomic::{AtomicU64, Ordering};
+        static NEXT: AtomicU64 = AtomicU64::new(0);
+        Self(NEXT.fetch_add(1, Ordering::Relaxed))
+    }
+}
+
+pub(super) struct PrepaintRoots {
+    /// `None` when the previous root tree is kept (`kept_root`).
+    pub(super) root_element: Option<AnyElement>,
+    pub(super) root_prepaint: Range<PrepaintStateIndex>,
+    pub(super) kept_root: Option<RootRanges>,
+    #[cfg(any(feature = "inspector", debug_assertions))]
+    pub(super) inspector_element: Option<AnyElement>,
+    pub(super) prompt_element: Option<AnyElement>,
+    pub(super) active_drag_element: Option<AnyElement>,
+    pub(super) tooltip_element: Option<AnyElement>,
+}
+
+impl Window {
+    /// Опубликовать вход один раз за кадр, после layout его источника.
+    /// Предок обязан отложить prepaint потомков, если вход изменился:
+    /// тогда они будут обработаны только с окончательным стилем предка.
+    /// Изолированный prepaint вне сборки кадра входы не публикует.
+    #[track_caller]
+    pub fn update_layout_input(
+        &mut self,
+        id: LayoutInputId,
+        update: impl FnOnce() -> bool,
+    ) -> bool {
+        self.invalidator.debug_assert_prepaint();
+        let Some(inputs) = self.layout_inputs.as_mut() else {
+            return false;
+        };
+        if !inputs.insert(id) {
+            return false;
+        }
+        let changed = update();
+        if changed {
+            // KaminIDE patch (DevTools `why`): this input lays the roots out
+            // and renders them again in the same draw.
+            crate::dirty_sources::trace::push_with("layout_retry", core::panic::Location::caller(), || {
+                format!("layout input {} changed ({} inputs published in this draw)", id.0, inputs.len())
+            });
+        }
+        self.layout_retry |= changed;
+        changed
+    }
+
+    /// Test support: drop the frames asked for since the last call
+    /// (`on_next_frame`, for example to settle what a layout measured) and
+    /// count them; a test that draws directly runs none of them.
+    #[cfg(any(test, feature = "test-support"))]
+    pub fn take_frame_requests(&self) -> usize {
+        self.next_frame_callbacks.take().len()
+    }
+
+    pub(super) fn prepaint_roots_with_layout_inputs(
+        &mut self,
+        root_size: Size<Pixels>,
+        _inspector_width: Pixels,
+        cx: &mut App,
+    ) -> PrepaintRoots {
+        let text_index = self.text_system.layout_index();
+        self.layout_inputs = Some(FxHashSet::default());
+        let kept_root = self.kept_root(cx);
+        loop {
+            self.layout_retry = false;
+            if self.a11y.is_active() {
+                self.a11y.begin_frame();
+            }
+            let scale_factor = self.scale_factor();
+            // KaminIDE patch: when only isolated views changed, the previous
+            // root tree is replayed instead of rendered (`window/isolated.rs`).
+            let kept_root = kept_root.clone().filter(|_| !self.refreshing);
+            let root_prepaint_start = self.prepaint_index();
+            let root = if let Some(kept) = &kept_root {
+                self.reuse_root_prepaint(kept, cx);
+                None
+            } else {
+                let mut root = self.root.as_ref().unwrap().clone().into_any_element();
+                let id = root.request_layout(self, cx);
+                self.layout_engine
+                    .as_mut()
+                    .unwrap()
+                    .stretch_auto_size_to_fill(id, root_size, scale_factor);
+                root.prepaint_as_root(Point::default(), root_size.into(), self, cx);
+                Some(root)
+            };
+            let root_prepaint = root_prepaint_start..self.prepaint_index();
+            #[cfg(any(feature = "inspector", debug_assertions))]
+            let inspector_element = self.prepaint_inspector(_inspector_width, cx);
+
+            self.prepaint_deferred_draws(cx);
+
+            let mut prompt_element = None;
+            let mut active_drag_element = None;
+            let mut tooltip_element = None;
+            if let Some(prompt) = self.prompt.take() {
+                let mut element = prompt.view.any_view().into_any_element();
+                let prompt_layout_id = element.request_layout(self, cx);
+                self.layout_engine
+                    .as_mut()
+                    .unwrap()
+                    .stretch_auto_size_to_fill(prompt_layout_id, root_size, scale_factor);
+                element.prepaint_as_root(Point::default(), root_size.into(), self, cx);
+                prompt_element = Some(element);
+                self.prompt = Some(prompt);
+            } else if let Some(active_drag) = cx.active_drag.take() {
+                let mut element = active_drag.view.clone().into_any_element();
+                let offset = self.mouse_position() - active_drag.cursor_offset;
+                element.prepaint_as_root(offset, AvailableSpace::min_size(), self, cx);
+                active_drag_element = Some(element);
+                cx.active_drag = Some(active_drag);
+            } else {
+                tooltip_element = self.prepaint_tooltip(cx);
+            }
+            if !self.layout_retry {
+                self.layout_inputs = None;
+                let counter = if root.is_some() {
+                    &crate::frame_perf::ROOT_LAYOUTS
+                } else {
+                    &crate::frame_perf::ISOLATED_FRAMES
+                };
+                counter.fetch_add(1, std::sync::atomic::Ordering::Relaxed);
+                return PrepaintRoots {
+                    root_element: root,
+                    root_prepaint,
+                    kept_root,
+                    #[cfg(any(feature = "inspector", debug_assertions))]
+                    inspector_element,
+                    prompt_element,
+                    active_drag_element,
+                    tooltip_element,
+                };
+            }
+
+            // Регистрации отброшенной попытки не попадают в кадр; состояние
+            // элементов (scroll/focus/view caches) сохраняется. Refresh не
+            // позволяет повторно использовать диапазоны отброшенного prepaint.
+            let states = mem::take(&mut self.next_frame.element_states);
+            self.next_frame.clear();
+            self.next_frame.element_states = states;
+            self.text_system.truncate_layouts(text_index.clone());
+            self.requested_autoscroll = None;
+            self.tooltip_bounds = None;
+            self.layout_engine.as_mut().unwrap().clear();
+            self.refreshing = true;
+        }
+    }
+}
