-#[derive(Clone, Debug, Default, Eq, PartialEq)]
-struct TabStopNode {
-    /// Path to access the node in the tree
-    /// The final node in the list is a leaf node corresponding to an actual focus handle,
-    /// all other nodes are group nodes
-    path: TabStopPath,
