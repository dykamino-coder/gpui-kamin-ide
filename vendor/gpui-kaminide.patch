+            draw_start: at(350),
+            draw_end: at(380),
+        };
+        let snapshot = FrameSnapshot {
+            interval_start: at(150),
+            boundary: IntervalBoundary::Presented(PresentedFrame {
+                frame,
+                presentation,
+            }),
