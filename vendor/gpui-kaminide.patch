+        impl Render for Wrapped {
+            fn render(&mut self, _: &mut Window, _: &mut Context<Self>) -> impl IntoElement {
+                let node = self.0;
+                div().children((0..100).map(move |_| Wrapper(div().into_any_element(), node)))
+            }
