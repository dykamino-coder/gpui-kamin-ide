+++ b/vendor/gpui/src/scene/damage/shift.rs
@@ -0,0 +1,289 @@
+//! KaminIDE patch: a scroll step as a move of the frame drawn last.
+//!
+//! A wheel step moves most of the frame by a whole number of device pixels
+//! `d`. A renderer that keeps its target can copy the kept pixels by `d` and
+//! raster only where the new frame differs from that copy. The copy is the
+//! last frame translated: a virtual scene `T` with every primitive of the last
+//! frame moved by `d`. Its pixels inside `W` (the window ∩ the window moved by
+//! `d`) are the copied ones, since rasterization does not depend on where a
+//! primitive lies when it moves by whole pixels (masks clip at pixel centres,
+//! edges antialias by distance). So the frame redraws exactly where `S`, the
+//! new frame, differs from `T` within `W`, plus all outside `W` (the strip the
+//! step uncovered). Cells are compared as in the frame damage, by their
+//! primitive sequences, with retained layers expanded in their paint order
+//! and both masks cut by `W` (pixels outside `W` are redrawn anyway).
+//!
+//! What does not move with the content is found, not declared: a fixed box
+//! or a scroll bar differs between `S` and `T` and damages its own cells; a
+//! plain fill (no border, radius, transform or gradient) covering a cell in
+//! both is equal there, so the page background under a scroller costs nothing.
+//! Cell for cell this is the comparison WebRender runs per picture tile
+//! (`update_dirty_rects`), with the frame itself as the retained surface: no
+//! slice per scroll root, no tile left half invalid, and the copied pixels are
+//! the frame's own (text over its real backdrop), so the result equals a
+//! whole redraw bit for bit.
+
+use super::{Area, DAMAGE_TILE, KIND_SHIFT, entry_area};
+use crate::scene::Scene;
+use collections::FxHashMap;
+use items::{Item, bin, each_primitive, items, unchanged_layers};
+
+mod compare;
+#[cfg(test)]
+mod group_tests;
+mod items;
+#[cfg(test)]
+mod layer_tests;
+mod rects;
+mod stats;
+#[cfg(test)]
+mod tests;
+pub use stats::{SHIFT_KIND_NAMES, SHIFT_KINDS, ShiftStats};
+
+/// Most rectangles a moved frame rasters after the copy.
+pub const SHIFT_RECTS: usize = 4;
+
+/// A frame drawn as the last one moved, then redrawn within rectangles.
+#[derive(Clone, Debug, Default, PartialEq, Eq)]
+pub struct FrameShift {
+    /// Device pixels the last frame's pixels move by.
+    pub delta: (i32, i32),
+    /// Where the moved pixels land: x, y, width, height (device px).
+    pub copy: [u32; 4],
+    /// Rectangles rasterized after the move (x, y, width, height, device px),
+    /// at most `SHIFT_RECTS`, disjoint from none in particular.
+    pub redraw: Vec<[u32; 4]>,
+}
+
+impl FrameShift {
+    /// Pixels the redraw rectangles cover (counted per rectangle).
+    pub fn redraw_area(&self) -> u64 {
+        self.redraw.iter().map(|r| r[2] as u64 * r[3] as u64).sum()
+    }
+
+    /// Whether the pixels stay where they are (a frame compared in place).
+    pub fn in_place(&self) -> bool {
+        self.delta == (0, 0)
+    }
+
+    /// The bounding rectangle of the pixels that change (x, y, w, h): the
+    /// copy and every redraw, or only the redraws of a frame in place.
+    pub fn bounds(&self) -> [u32; 4] {
+        let copy = (!self.in_place()).then_some(self.copy);
+        let all = copy.into_iter().chain(self.redraw.iter().copied());
+        let (mut x0, mut y0, mut x1, mut y1) = (u32::MAX, u32::MAX, 0, 0);
+        for r in all.filter(|r| r[2] > 0 && r[3] > 0) {
+            (x0, y0) = (x0.min(r[0]), y0.min(r[1]));
+            (x1, y1) = (x1.max(r[0] + r[2]), y1.max(r[1] + r[3]));
+        }
+        if x1 <= x0 {
+            [0; 4]
+        } else {
+            [x0, y0, x1 - x0, y1 - y0]
+        }
+    }
+}
+
+/// `W`: the part of a `w`×`h` window that the frame moved by `d` covers.
+fn moved_window(w: u32, h: u32, d: (i32, i32)) -> Option<[u32; 4]> {
+    let span = |n: u32, d: i32| {
+        let (lo, hi) = (d.max(0), (n as i32 + d).min(n as i32));
+        (hi > lo).then_some((lo as u32, (hi - lo) as u32))
+    };
+    let ((x, width), (y, height)) = (span(w, d.0)?, span(h, d.1)?);
+    Some([x, y, width, height])
+}
+
+impl Scene {
+    /// The primitives that may write device pixel (`x`, `y`), in paint order:
+    /// kind, index and area (the renderer's damage audit names them).
+    #[doc(hidden)]
+    pub fn primitives_at(&self, x: f32, y: f32) -> Vec<String> {
+        let mut out = Vec::new();
+        let mask = (1 << KIND_SHIFT) - 1;
+        each_primitive(self, &|slot| self.layer(slot), &mut |s, entry| {
+            if let Some(a) = entry_area(s, entry)
+                && a[0] <= x + 1.0
+                && a[1] <= y + 1.0
+                && a[2] >= x
+                && a[3] >= y
+            {
+                out.push(format!("k{}#{} {a:?}", entry >> KIND_SHIFT, entry & mask));
+            }
+        });
+        out
+    }
+
+    /// `plan_shift` within the comparison budget (`shift_budget_us`), with its
+    /// CPU time in `stats.us`; `groups` matches this frame's groups to the
+    /// last frame's (`Scene::group_base`, plus one; 0: none).
+    pub(super) fn timed_plan_shift(
+        &self,
+        previous: &Scene,
+        size: (u32, u32),
+        d: (i32, i32),
+        groups: &[u32],
+        stats: &mut ShiftStats,
+    ) -> Result<FrameShift, &'static str> {
+        let started = std::time::Instant::now();
+        let budget = super::shift_budget_us();
+        let deadline =
+            (budget != u32::MAX).then(|| started + std::time::Duration::from_micros(budget as u64));
+        let plan = self.plan_shift_within(previous, size, d, groups, stats, deadline);
+        stats.us = started.elapsed().as_micros().min(u32::MAX as u128) as u32;
+        plan
+    }
+
+    /// The frame drawn as `previous` moved by `d` device pixels, with what
+    /// then needs a raster; `Err` names why not: the comparison cannot run,
+    /// or the redraw would cover about the whole window anyway.
+    /// `stats` counts what the comparison found different.
+    pub(super) fn plan_shift(
+        &self,
+        previous: &Scene,
+        size: (u32, u32),
+        d: (i32, i32),
+        stats: &mut ShiftStats,
+    ) -> Result<FrameShift, &'static str> {
+        self.plan_shift_within(previous, size, d, &[], stats, None)
+    }
+
+    /// `plan_shift` that gives up (`over_budget`) once `deadline` passes: the
+    /// comparison then costs more than the raster it could save.
+    fn plan_shift_within(
+        &self,
+        previous: &Scene,
+        size: (u32, u32),
+        d: (i32, i32),
+        groups: &[u32],
+        stats: &mut ShiftStats,
+        deadline: Option<std::time::Instant>,
+    ) -> Result<FrameShift, &'static str> {
+        let late = || deadline.is_some_and(|t| std::time::Instant::now() >= t);
+        let (w, h) = size;
+        // `d == (0, 0)` compares the frame with the last one in place: the
+        // frame damage when the retained layers' bookkeeping cannot tell it.
+        if w == 0 || h == 0 {
+            return Err("no_step");
+        }
+        let copy = moved_window(w, h, d).ok_or("step_beyond_window")?;
+        let wa: Area = [
+            copy[0] as f32,
+            copy[1] as f32,
+            (copy[0] + copy[2]) as f32,
+            (copy[1] + copy[3]) as f32,
+        ];
+        // In place, layers the engine recorded again unchanged are equal as a whole.
+        let unchanged = if d == (0, 0) {
+            unchanged_layers(self, previous)
+        } else {
+            Vec::new()
+        };
+        let new = items(self, &|slot| self.layer(slot), &unchanged, (0.0, 0.0), wa)?;
+        let old = items(
+            previous,
+            &|slot| self.drawn_layer(previous, slot),
+            &unchanged,
+            (d.0 as f32, d.1 as f32),
+            wa,
+        )
+        .map_err(|why| {
+            if why == "layer_unknown" {
+                "last_layer_unknown"
+            } else {
+                why
+            }
+        })?;
+        let (cols, rows) = (w.div_ceil(DAMAGE_TILE), h.div_ceil(DAMAGE_TILE));
+        let (sa, ea) = bin(&new, cols, rows);
+        let (sb, eb) = bin(&old, cols, rows);
+        if late() {
+            return Err("over_budget");
+        }
+        let mut cmp = compare::Moved {
+            d: (d.0 as f32, d.1 as f32),
+            w: wa,
+            groups,
+            exact: FxHashMap::default(),
+        };
+        let mut damage = rects::Damage::new(w, h);
+        damage.uncovered(copy);
+        // The redraw only grows from here: stop once it is about the whole window.
+        let whole = |damage: &rects::Damage| damage.area() * 20 >= w as u64 * h as u64 * 17;
+        for t in 0..(cols * rows) as usize {
+            let (c, r) = (t as u32 % cols, t as u32 / cols);
+            let cell = [
+                c * DAMAGE_TILE,
+                r * DAMAGE_TILE,
+                ((c + 1) * DAMAGE_TILE).min(w),
+                ((r + 1) * DAMAGE_TILE).min(h),
+            ];
+            let p = [
+                cell[0].max(copy[0]),
+                cell[1].max(copy[1]),
+                cell[2].min(copy[0] + copy[2]),
+                cell[3].min(copy[1] + copy[3]),
+            ];
+            if p[0] >= p[2] || p[1] >= p[3] {
+                continue;
+            }
+            stats.cells += 1;
+            if late() {
+                return Err("over_budget");
+            }
+            let (a, b) = (
+                &ea[sa[t] as usize..sa[t + 1] as usize],
+                &eb[sb[t] as usize..sb[t + 1] as usize],
+            );
+            if a.len() != b.len() {
+                stats.count_cells += 1;
+                damage.add(p);
+                if whole(&damage) {
+                    return Err("redraw_whole");
+                }
+                continue;
+            }
+            for (&x, &y) in a.iter().zip(b) {
+                let (x, y) = ((x, new[x as usize]), (y, old[y as usize]));
+                let differs = match x.1.same_marker(&y.1) {
+                    Some(same) => !same,
+                    None => {
+                        x.1.entry >> KIND_SHIFT != y.1.entry >> KIND_SHIFT || !cmp.same(x, y, p)
+                    }
+                };
+                if differs {
+                    let u = [
+                        x.1.area[0].min(y.1.area[0]),
+                        x.1.area[1].min(y.1.area[1]),
+                        x.1.area[2].max(y.1.area[2]),
+                        x.1.area[3].max(y.1.area[3]),
+                    ];
+                    stats.differ(&x.1, &y.1, u);
+                    let q = [
+                        (u[0].floor().max(p[0] as f32)) as u32,
+                        (u[1].floor().max(p[1] as f32)) as u32,
+                        (u[2].ceil().min(p[2] as f32)) as u32,
+                        (u[3].ceil().min(p[3] as f32)) as u32,
+                    ];
+                    if q[0] < q[2] && q[1] < q[3] {
+                        damage.add(q);
+                        if whole(&damage) {
+                            return Err("redraw_whole");
+                        }
+                    }
+                }
+            }
+        }
+        let redraw = damage.finish(SHIFT_RECTS);
+        let shift = FrameShift {
+            delta: d,
+            copy,
+            redraw,
+        };
+        // Copy and raster cost more than a whole raster only when the raster
+        // is about the whole window.
+        (shift.redraw_area() * 20 < w as u64 * h as u64 * 17)
+            .then_some(shift)
+            .ok_or("redraw_whole")
+    }
+}
diff --git a/vendor/gpui/src/scene/damage/shift/compare.rs b/vendor/gpui/src/scene/damage/shift/compare.rs
new file mode 100644
index 0000000000000000000000000000000000000000..badedfdcf4b3ea1f98e6d92eda940cc162cc065e
--- /dev/null
+++ b/vendor/gpui/src/scene/damage/shift/compare.rs
@@ -0,0 +1,292 @@
+//! KaminIDE patch: a primitive of the new frame against one of the last frame
+//! moved by `d` (`plan_shift`), both cut by the moved window `W`.
+//!
+//! A mask clips at pixel centres, so within a cell only the mask's part in
+//! the cell decides pixels. A pair is compared once: a pair equal but for its
+//! masks (the clip of a scroller moved against its stationary clip) keeps
+//! both cut masks and is equal in each cell where the masks cut by the cell
+//! are equal, so only the cells where the clips really part differ.
+
+use super::super::{Area, KIND_SHIFT, clipped, same_path, same_surface_values};
+use super::Item;
+use crate::color::BackgroundTag;
+use crate::scene::{Quad, Scene};
+use crate::{Bounds, ContentMask, Point, ScaledPixels, TransformationMatrix, point, size};
+use collections::FxHashMap;
+
+/// What a pair of primitives paints, compared once for all cells.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub(super) enum Pair {
+    Same,
+    Differ,
+    /// Equal but for the masks: the new one and the moved old one, cut by `W`.
+    Masks(Bounds<ScaledPixels>, Bounds<ScaledPixels>),
+    /// Plain fills whose edges differ: compared again per cell, where an edge
+    /// beyond the cell's part of both masks paints nothing.
+    Quads,
+}
+
+/// The comparison of one plan: the move, `W`, the match of this frame's
+/// groups to the last frame's (`Scene::group_base`) and the results by item pair.
+pub(super) struct Moved<'g> {
+    pub(super) d: (f32, f32),
+    pub(super) w: Area,
+    pub(super) groups: &'g [u32],
+    pub(super) exact: FxHashMap<(u32, u32), Pair>,
+}
+
+fn at(b: Bounds<ScaledPixels>, d: (f32, f32)) -> Bounds<ScaledPixels> {
+    Bounds {
+        origin: b.origin + point(ScaledPixels(d.0), ScaledPixels(d.1)),
+        size: b.size,
+    }
+}
+
+/// Move a primitive's place: its bounds, or with a transformation the
+/// translation the transformation applies after them.
+fn place(b: &mut Bounds<ScaledPixels>, m: &mut TransformationMatrix, d: (f32, f32)) {
+    if *m == TransformationMatrix::unit() {
+        *b = at(*b, d);
+    } else {
+        m.translation[0] += d.0;
+        m.translation[1] += d.1;
+    }
+}
+
+/// A fill whose pixels follow its bounds: the shader reads the position
+/// relative to them (solid, gradients, their dither), not to the window.
+fn movable(q: &Quad) -> bool {
+    matches!(
+        q.background.tag,
+        BackgroundTag::Solid
+            | BackgroundTag::LinearGradient
+            | BackgroundTag::RadialGradient
+            | BackgroundTag::AnalyticGradient
+    )
+}
+
+/// `b ⊇ p` for the integer rectangle `p` (x0, y0, x1, y1): every pixel centre
+/// of `p` lies inside `b` at least half a pixel from its edges, so an edge
+/// of `b` antialiases none of them.
+fn covers(b: Bounds<ScaledPixels>, p: [u32; 4]) -> bool {
+    let (o, s) = (b.origin, b.size);
+    o.x.0 <= p[0] as f32
+        && o.y.0 <= p[1] as f32
+        && o.x.0 + s.width.0 >= p[2] as f32
+        && o.y.0 + s.height.0 >= p[3] as f32
+}
+
+/// The integer rectangle `p` (x0, y0, x1, y1) as bounds.
+fn rect(p: [u32; 4]) -> Bounds<ScaledPixels> {
+    let [x0, y0, x1, y1] = p.map(|v| v as f32);
+    Bounds {
+        origin: point(ScaledPixels(x0), ScaledPixels(y0)),
+        size: size(ScaledPixels(x1 - x0), ScaledPixels(y1 - y0)),
+    }
+}
+
+/// `b` cut by `w`; a mask that lets no pixel through is equal whatever its place.
+fn within(b: Bounds<ScaledPixels>, w: Bounds<ScaledPixels>) -> Bounds<ScaledPixels> {
+    let b = b.intersect(&w);
+    if b.size.width.0 <= 0.0 || b.size.height.0 <= 0.0 {
+        Bounds::default()
+    } else {
+        b
+    }
+}
+
+/// `a == b` once `b` has `a`'s mask: equal but for the masks, or different.
+fn masks<T: PartialEq>(
+    a: &T,
+    mut b: T,
+    mask: fn(&mut T) -> &mut ContentMask<ScaledPixels>,
+    ma: Bounds<ScaledPixels>,
+) -> Pair {
+    let mb = std::mem::replace(&mut mask(&mut b).bounds, ma);
+    if *a == b {
+        Pair::Masks(ma, mb)
+    } else {
+        Pair::Differ
+    }
+}
+
+impl Moved<'_> {
+    fn window(&self) -> Bounds<ScaledPixels> {
+        let w = self.w;
+        Bounds {
+            origin: point(ScaledPixels(w[0]), ScaledPixels(w[1])),
+            size: size(ScaledPixels(w[2] - w[0]), ScaledPixels(w[3] - w[1])),
+        }
+    }
+
+    fn cut(&self, m: &mut ContentMask<ScaledPixels>) {
+        m.bounds = within(m.bounds, self.window());
+    }
+
+    fn shift(&self, m: &mut ContentMask<ScaledPixels>) {
+        m.bounds = at(m.bounds, self.d);
+        self.cut(m);
+    }
+
+    /// Item `x` (new frame) paints within cell part `p` what item `y` (last
+    /// frame) paints there once moved.
+    pub(super) fn same(&mut self, x: (u32, Item), y: (u32, Item), p: [u32; 4]) -> bool {
+        let pair = match self.exact.get(&(x.0, y.0)) {
+            Some(&known) => known,
+            None => {
+                let known = self.exact_pair(x.1, y.1);
+                self.exact.insert((x.0, y.0), known);
+                known
+            }
+        };
+        let equal = match pair {
+            Pair::Same => true,
+            Pair::Differ => false,
+            Pair::Masks(a, b) => within(a, rect(p)) == within(b, rect(p)),
+            Pair::Quads => self.quads_within(x.1, y.1, p),
+        };
+        equal || (x.1.entry >> KIND_SHIFT == 1 && self.same_fill(x.1, y.1, p))
+    }
+
+    /// Two plain fills within cell part `p`: an edge beyond the cell's part
+    /// of both masks paints nothing there.
+    fn quads_within(&self, x: Item, y: Item, p: [u32; 4]) -> bool {
+        let mask = (1 << KIND_SHIFT) - 1;
+        let (mut a, mut b) = (
+            x.scene.quads[(x.entry & mask) as usize],
+            y.scene.quads[(y.entry & mask) as usize],
+        );
+        place(&mut b.bounds, &mut b.transformation, self.d);
+        self.cut(&mut a.content_mask);
+        self.shift(&mut b.content_mask);
+        a.content_mask.bounds = within(a.content_mask.bounds, rect(p));
+        b.content_mask.bounds = within(b.content_mask.bounds, rect(p));
+        b.order = a.order;
+        a == b || clipped::same_visible(&a, &b)
+    }
+
+    /// Two plain fills of one paint, each covering `p` (a stationary page
+    /// background under a scroller: equal wherever both cover the cell).
+    fn same_fill(&self, x: Item, y: Item, p: [u32; 4]) -> bool {
+        let mask = (1 << KIND_SHIFT) - 1;
+        let (mut a, mut b) = (
+            x.scene.quads[(x.entry & mask) as usize],
+            y.scene.quads[(y.entry & mask) as usize],
+        );
+        if !clipped::plain(&a) || !clipped::plain(&b) {
+            return false;
+        }
+        b.bounds = at(b.bounds, self.d);
+        self.cut(&mut a.content_mask);
+        self.shift(&mut b.content_mask);
+        let visible = |q: &Quad| q.bounds.intersect(&q.content_mask.bounds);
+        if !covers(visible(&a), p) || !covers(visible(&b), p) {
+            return false;
+        }
+        let mut same = b;
+        (same.bounds, same.content_mask, same.order) = (a.bounds, a.content_mask, a.order);
+        same == a
+    }
+
+    /// The pair's result for every cell; a moved clip that parts the pair's
+    /// masks leaves it `Masks`, decided per cell.
+    fn exact_pair(&self, x: Item, y: Item) -> Pair {
+        let verdict = |same: bool| if same { Pair::Same } else { Pair::Differ };
+        let mask = (1 << KIND_SHIFT) - 1;
+        let (i, j) = ((x.entry & mask) as usize, (y.entry & mask) as usize);
+        let (sa, sb): (&Scene, &Scene) = (x.scene, y.scene);
+        let d = self.d;
+        macro_rules! pair {
+            ($a:ident, $b:ident) => {{
+                $b.order = $a.order;
+                if $a == $b {
+                    Pair::Same
+                } else {
+                    masks(&$a, $b, |p| &mut p.content_mask, $a.content_mask.bounds)
+                }
+            }};
+        }
+        macro_rules! sprite {
+            ($list:ident) => {{
+                let (mut a, mut b) = (sa.$list[i], sb.$list[j]);
+                place(&mut b.bounds, &mut b.transformation, d);
+                self.cut(&mut a.content_mask);
+                self.shift(&mut b.content_mask);
+                pair!(a, b)
+            }};
+        }
+        match x.entry >> KIND_SHIFT {
+            0 => {
+                let (mut a, mut b) = (sa.shadows[i], sb.shadows[j]);
+                b.bounds = at(b.bounds, d);
+                b.element_bounds = at(b.element_bounds, d);
+                self.cut(&mut a.content_mask);
+                self.shift(&mut b.content_mask);
+                pair!(a, b)
+            }
+            1 => {
+                let (mut a, mut b) = (sa.quads[i], sb.quads[j]);
+                if !movable(&a) || !movable(&b) {
+                    return Pair::Differ;
+                }
+                place(&mut b.bounds, &mut b.transformation, d);
+                self.cut(&mut a.content_mask);
+                self.shift(&mut b.content_mask);
+                if a.is_analytic_gradient() || b.is_analytic_gradient() {
+                    return verdict(sa.same_gradient_quad(&a, sb, &b));
+                }
+                b.order = a.order;
+                if a == b || clipped::same_visible(&a, &b) {
+                    return Pair::Same;
+                }
+                match pair!(a, b) {
+                    // Plain fills whose edges differ may still match per cell.
+                    Pair::Differ if clipped::plain(&a) && clipped::plain(&b) => Pair::Quads,
+                    other => other,
+                }
+            }
+            2 => {
+                let (a, b) = (&sa.paths[i], &sb.paths[j]);
+                if a.color_mapping.is_some() || b.color_mapping.is_some() {
+                    return Pair::Differ;
+                }
+                let (mut a, mut b) = (a.clone(), b.clone());
+                b.bounds = at(b.bounds, d);
+                self.cut(&mut a.content_mask);
+                self.shift(&mut b.content_mask);
+                for v in &mut a.vertices {
+                    self.cut(&mut v.content_mask);
+                }
+                for v in &mut b.vertices {
+                    v.xy_position = v.xy_position
+                        + Point {
+                            x: ScaledPixels(d.0),
+                            y: ScaledPixels(d.1),
+                        };
+                    self.shift(&mut v.content_mask);
+                }
+                // A mask per vertex: compared exactly, not per cell.
+                verdict(same_path(&a, &b))
+            }
+            3 => {
+                let (mut a, mut b) = (sa.underlines[i], sb.underlines[j]);
+                b.bounds = at(b.bounds, d);
+                self.cut(&mut a.content_mask);
+                self.shift(&mut b.content_mask);
+                pair!(a, b)
+            }
+            4 => sprite!(monochrome_sprites),
+            5 => sprite!(subpixel_sprites),
+            6 => sprite!(polychrome_sprites),
+            // In place, a group's mark is equal when the group paints the
+            // image of the group it matched (the renderer keeps that image)
+            // under equal values. Moved, its own scene would have to move.
+            _ if self.d == (0.0, 0.0) => {
+                let (a, b) = (&sa.surfaces[i], &sb.surfaces[j]);
+                let matched = a.group > 0 && self.groups.get(a.group as usize - 1) == Some(&b.group);
+                verdict(matched && same_surface_values(a, b))
+            }
+            _ => Pair::Differ,
+        }
+    }
+}
