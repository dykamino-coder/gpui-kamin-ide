+#[derive(Clone)]
+pub(crate) enum PaintOperation {
+    Primitive(Primitive),
+    /// KaminIDE patch: with the layer's order, so a copy can shift it.
+    StartLayer(Bounds<ScaledPixels>, DrawOrder),
+    /// KaminIDE patch: начало нижнего слоя (см. `push_bottom_layer`).
+    StartBottomLayer,
+    EndLayer,
+    StartDepthContext,
+    EndDepthContext,
+    StartDepthPlane(f32),
+    EndDepthPlane,
+}
