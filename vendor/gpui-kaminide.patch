-            let mut x_max = 1f32;
-            let (x, coefficient) = loop {
-                let x = x_min + (x_max - x_min) / 2.;
-                let coefficient = 3. * x * (1. - x);
-                let time = coefficient * ((1. - x) * P1 + x * P2) + x * x * x;
-                if (time - alpha).abs() < 1e-5 {
