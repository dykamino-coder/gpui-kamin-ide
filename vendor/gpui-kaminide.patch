index 0000000000000000000000000000000000000000..ba4a997ad94474a16ba9dcec4e9d84886b50ab83
--- /dev/null
+++ b/vendor/gpui/src/scene/damage/trace.rs
@@ -0,0 +1,90 @@
+//! KaminIDE patch: журнал повреждения кадра (`gpui::frame`, уровень debug) —
+//! какие клетки повреждены и какая первая пара записей в них различается.
+//! Нужен, чтобы причину перерисовки неизменного по пикселям кадра доказывать
+//! записями сцены, а не догадкой.
+
+use super::{Compare, DamageIndex, KIND_SHIFT, Scene, entry_area};
+use collections::FxHashMap;
+
+/// Сколько повреждённых клеток описать за кадр.
+const TILES: usize = 6;
+
+/// Записать в журнал повреждение кадра `scene` против `previous`.
+pub(super) fn log_damage(scene: &Scene, index: &DamageIndex, previous: &Scene) {
+    if !log::log_enabled!(target: "gpui::frame", log::Level::Debug) {
+        return;
+    }
+    let old = &previous.book.index;
+    log::debug!(
+        target: "gpui::frame",
+        "damage {:?} frame {} base {} size {:?} backdrop {}/{}",
+        index.damage,
+        index.id,
+        index.base,
+        index.size,
+        index.backdrop,
+        old.backdrop
+    );
+    if old.size != index.size || index.size.is_none() {
+        return;
+    }
+    let mut cmp = Compare {
+        new: scene,
+        old: previous,
+        groups: FxHashMap::default(),
+    };
+    let cols = index.cols as usize;
+    let mut shown = 0;
+    let mut damaged = 0;
+    for t in 0..index.starts.len() - 1 {
+        let (a, b) = (index.tile(t), old.tile(t));
+        let first = (0..a.len().max(b.len())).find(|&k| match (a.get(k), b.get(k)) {
+            (Some(&x), Some(&y)) => !cmp.same(scene, x, previous, y),
+            _ => true,
+        });
+        let Some(k) = first else { continue };
+        damaged += 1;
+        if shown == TILES {
+            continue;
+        }
+        shown += 1;
+        log::debug!(
+            target: "gpui::frame",
+            "damage tile ({}, {}) entries {}/{} first differs at {}: new {} old {}",
+            t % cols,
+            t / cols,
+            a.len(),
+            b.len(),
+            k,
+            describe(scene, a.get(k).copied()),
+            describe(previous, b.get(k).copied())
+        );
+    }
+    log::debug!(target: "gpui::frame", "damage tiles {damaged}");
+}
+
+fn describe(scene: &Scene, entry: Option<u32>) -> String {
+    let Some(e) = entry else {
+        return "none".into();
+    };
+    let (kind, i) = (e >> KIND_SHIFT, (e & ((1 << KIND_SHIFT) - 1)) as usize);
+    let area = entry_area(scene, e);
+    let extra = match kind {
+        1 => format!("{:?}", scene.quads[i].bounds),
+        #[cfg(not(target_os = "macos"))]
+        7 => {
+            let s = &scene.surfaces[i];
+            let g = (s.group as usize)
+                .checked_sub(1)
+                .and_then(|g| scene.groups.get(g));
+            format!(
+                "group {} bounds {:?} projection {}",
+                s.group,
+                g.map(|g| g.bounds),
+                g.is_some_and(|g| g.projection.is_some())
+            )
+        }
+        _ => String::new(),
+    };
+    format!("kind {kind} #{i} area {area:?} {extra}")
+}
diff --git a/vendor/gpui/src/scene/group_replay.rs b/vendor/gpui/src/scene/group_replay.rs
new file mode 100644
index 0000000000000000000000000000000000000000..b8f2cef0c012ee1a60b08c06ba4cacf4e9bbe563
--- /dev/null
+++ b/vendor/gpui/src/scene/group_replay.rs
@@ -0,0 +1,250 @@
+//! KaminIDE patch: composition groups carried by a replayed command range.
+//!
+//! A group paints into a scene of its own (`Window::paint_group`), kept in
+//! `Scene::groups` outside the command list; the list holds only its label, a
+//! surface naming the group by `group` (index + 1). A replay of a range that
+//! made groups copies them to the end of this scene's list and renumbers
+//! every label it copies (in the range and in the copied groups, dormant ones
+//! and those a reservoir holds) by the distance between the two list
+//! positions (`Scene::relabel`). A scrolled replay moves a group with the node
+//! its label is painted under, the group's own commands with their nodes:
+//! as WebRender's picture cache keeps a picture with the primitives of its
+//! tiles and cc moves an effect node's layer with its scroll node, the
+//! composited surface moves with what it composites instead of the frame
+//! being built again.
+
+use super::scroll_marks::{Piece, Run};
+use super::*;
+use crate::ScrollNodeId;
+
+/// Where a group's label lies in the commands that composite it.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum GroupLabel {
+    /// Under a scroll node, drawn, dormant or held by its reservoir.
+    Under(ScrollNodeId),
+    /// Drawn under no node, or in no command for an unknown reason.
+    Unmarked,
+    /// Dropped under its node (`PaintGroup::label_dropped`) or in a hidden
+    /// group's scene: no replay a plan accepts composites the group.
+    Hidden,
+}
+
+impl GroupLabel {
+    pub(crate) fn node(&self) -> Option<ScrollNodeId> {
+        if let GroupLabel::Under(node) = self { Some(*node) } else { None }
+    }
+}
+
+fn shifted(group: u32, delta: i32) -> u32 {
+    (group as i64 + delta as i64).max(1) as u32
+}
+
+impl Scene {
+    /// `operation` with its labels renumbered by `self.relabel`.
+    pub(super) fn relabeled(&self, operation: &PaintOperation) -> PaintOperation {
+        self.relabel_owned(operation.clone())
+    }
+
+    /// `relabeled` of an owned command (`replay_image_operation`).
+    pub(super) fn relabel_owned(&self, mut operation: PaintOperation) -> PaintOperation {
+        let delta = self.relabel;
+        if delta == 0 {
+            return operation;
+        }
+        match &mut operation {
+            PaintOperation::Primitive(Primitive::Surface(surface)) if surface.group > 0 => {
+                surface.group = shifted(surface.group, delta);
+            }
+            // A dormant command is shared with the frame it came from.
+            PaintOperation::Dormant(primitive) => {
+                if let Primitive::Surface(surface) = &**primitive
+                    && surface.group > 0
+                {
+                    let mut surface = surface.clone();
+                    surface.group = shifted(surface.group, delta);
+                    *primitive = std::rc::Rc::new(Primitive::Surface(surface));
+                }
+            }
+            // So is a reservoir's run: one holding labels is copied once.
+            PaintOperation::Reservoir(reservoir) => {
+                if let Some(run) = reservoir.run.relabeled(delta) {
+                    reservoir.run = std::rc::Rc::new(run);
+                }
+            }
+            _ => {}
+        }
+        operation
+    }
+
+    /// Where each group of `groups` (an index range of this scene's list) has its label:
+    /// in `ops`, which made the groups (`Window::paint_group` labels a group next to its
+    /// scene), or in the scene of a group whose own label is there (nested groups).
+    pub(crate) fn group_labels(&self, ops: Range<usize>, groups: Range<usize>) -> Vec<GroupLabel> {
+        let (first, mut labels) = (groups.start, vec![None; groups.len()]);
+        let Some(all) = self.groups.get(groups).filter(|_| ops.end <= self.paint_operations.len()) else {
+            return vec![GroupLabel::Unmarked; labels.len()];
+        };
+        self.note_labels(ops, first, &mut labels, false);
+        let mut scanned = vec![false; labels.len()];
+        loop {
+            // The labels in the scene of each group whose own label was found.
+            if let Some(at) = (0..labels.len()).find(|&at| !scanned[at] && labels[at].is_some()) {
+                scanned[at] = true;
+                let (scene, hidden) = (&all[at].scene, labels[at] == Some(GroupLabel::Hidden));
+                scene.note_labels(0..scene.paint_operations.len(), first, &mut labels, hidden);
+                continue;
+            }
+            match (0..labels.len()).find(|&at| labels[at].is_none() && all[at].label_dropped) {
+                Some(at) => labels[at] = Some(GroupLabel::Hidden),
+                None => break,
+            }
+        }
+        labels.into_iter().map(|label| label.unwrap_or(GroupLabel::Unmarked)).collect()
+    }
+
+    /// Note the labels in `ops` (`hidden`: of a hidden group's scene).
+    fn note_labels(&self, ops: Range<usize>, first: usize, labels: &mut [Option<GroupLabel>], hidden: bool) {
+        let mut note = |group: u32, label: GroupLabel| {
+            if let Some(slot) = (group as usize).checked_sub(first + 1).and_then(|at| labels.get_mut(at))
+                && !matches!(slot, Some(GroupLabel::Under(_)))
+            {
+                *slot = Some(if hidden { GroupLabel::Hidden } else { label });
+            }
+        };
+        let surface = |operation: &PaintOperation| match operation {
+            PaintOperation::Primitive(Primitive::Surface(surface)) => Some(surface.group),
+            PaintOperation::Dormant(primitive) => match &**primitive {
+                Primitive::Surface(surface) => Some(surface.group),
+                _ => None,
+            },
+            _ => None,
+        };
+        for mark in self.scroll.within(&ops) {
+            if let Some(group) = surface(&self.paint_operations[mark.op as usize]) {
+                note(group, GroupLabel::Under(mark.node));
+            }
+        }
+        for operation in &self.paint_operations[ops] {
+            if let PaintOperation::Reservoir(reservoir) = operation {
+                for item in &reservoir.run.items {
+                    if let Piece::Primitive(Primitive::Surface(surface)) = &item.piece {
+                        note(surface.group, GroupLabel::Under(reservoir.run.node));
+                    }
+                }
+            } else if let Some(group) = surface(operation) {
+                note(group, GroupLabel::Unmarked);
+            }
+        }
+    }
+    /// Whether the groups `groups` of this finished scene can be copied by a
+    /// scrolled replay whose plan knows the nodes `known` accepts: a group
+    /// whose label is under a node (`labels`, `group_labels`) holds only
+    /// commands such a replay moves (`scrollable`) under known nodes; one
+    /// whose label is under none holds no command of a node; a hidden one
+    /// is never seen, wherever the copy puts what it holds.
+    pub(crate) fn groups_scrollable(
+        &self,
+        groups: Range<usize>,
+        labels: &[GroupLabel],
+        known: impl Fn(ScrollNodeId) -> bool,
+    ) -> bool {
+        let Some(groups) = self.groups.get(groups) else { return false };
+        groups.iter().zip(labels).all(|(group, label)| {
+            let scene = &group.scene;
+            let all = 0..scene.paint_operations.len();
+            let reservoirs = scene.paint_operations.iter().filter_map(|operation| match operation {
+                PaintOperation::Reservoir(reservoir) => Some(reservoir.run.node),
+                _ => None,
+            });
+            match label {
+                GroupLabel::Hidden => true,
+                GroupLabel::Under(_) => {
+                    scene.scroll.marks.iter().all(|mark| known(mark.node))
+                        && reservoirs.into_iter().all(&known)
+                        && scene.scrollable(&all, std::iter::once(all.clone()))
+                }
+                GroupLabel::Unmarked => scene.scroll.marks.is_empty() && reservoirs.count() == 0,
+            }
+        })
+    }
+
+    /// A copy of `group` for a replay renumbering labels by `delta`: its
+    /// commands replayed (scrolled with the plan's `node` shifts and clips
+    /// when its label lies under `label`), its bounds moved with the label.
+    pub(crate) fn replayed_group(
+        group: &PaintGroup,
+        delta: i32,
+        label: Option<ScrollNodeId>,
+        node: &impl Fn(ScrollNodeId) -> (Point<ScaledPixels>, Bounds<ScaledPixels>),
+    ) -> PaintGroup {
+        Self::replayed_group_landing(group, delta, label, node, &mut [])
+    }
+
+    /// `replayed_group` that also tells where the commands at `edges` (old
+    /// indices in the group's scene, sorted) land in the copy's scene, as
+    /// `replay_scrolled` tells it: the scroll nodes painted in the group take
+    /// their ranges in the copy (`Window::replay_groups`). A copy that is
+    /// not one command per command (an unscrolled replay that dropped one)
+    /// marks them `usize::MAX`.
+    pub(crate) fn replayed_group_landing(
+        group: &PaintGroup,
+        delta: i32,
+        label: Option<ScrollNodeId>,
+        node: &impl Fn(ScrollNodeId) -> (Point<ScaledPixels>, Bounds<ScaledPixels>),
+        edges: &mut [(usize, usize)],
+    ) -> PaintGroup {
+        let same = |edges: &mut [(usize, usize)], exact: bool| {
+            for edge in edges.iter_mut() {
+                edge.1 = if exact { edge.0 } else { usize::MAX };
+            }
+        };
+        // Unmoved and with no labels to renumber, the replay would be an
+        // exact copy: share the content instead (one copy across frames).
+        let labels = || group.scene.surfaces.iter().any(|surface| surface.group > 0);
+        if label.is_none() && (delta == 0 || !labels()) {
+            same(edges, true);
+            return group.clone();
+        }
+        let mut scene = Scene { in_group: true, relabel: delta, ..Scene::default() };
+        let all = 0..group.scene.paint_operations.len();
+        let shift = match label {
+            Some(id) => {
+                scene.replay_scrolled(all, &group.scene, node, edges);
+                node(id).0
+            }
+            None => {
+                scene.replay(all.clone(), &group.scene);
+                same(edges, scene.paint_operations.len() == all.len());
+                Point::default()
+            }
+        };
+        scene.relabel = 0;
+        scene.finish();
+        Scene::copy_group(group, scene, shift)
+    }
+}
+
+impl Run {
+    /// This run with its labels renumbered by `delta`; `None` without labels.
+    fn relabeled(&self, delta: i32) -> Option<Run> {
+        let labels = |item: &super::scroll_marks::Item| {
+            matches!(&item.piece, Piece::Primitive(Primitive::Surface(surface)) if surface.group > 0)
+        };
+        if !self.items.iter().any(labels) {
+            return None;
+        }
+        let mut run = self.clone();
+        for item in &mut run.items {
+            if let Piece::Primitive(Primitive::Surface(surface)) = &mut item.piece
+                && surface.group > 0
+            {
+                surface.group = shifted(surface.group, delta);
+            }
+        }
+        Some(run)
+    }
+}
+
+#[cfg(test)]
+#[path = "group_replay_tests.rs"]
+mod tests;
diff --git a/vendor/gpui/src/scene/group_replay_tests.rs b/vendor/gpui/src/scene/group_replay_tests.rs
new file mode 100644
index 0000000000000000000000000000000000000000..7e3be2cebdd65cafcafff0111b0e98336b5a43f2
--- /dev/null
+++ b/vendor/gpui/src/scene/group_replay_tests.rs
@@ -0,0 +1,193 @@
+//! KaminIDE patch: a replay carries the groups of its range and renumbers labels.
+
+use super::*;
+
+fn rect(x: f32, y: f32, w: f32, h: f32) -> Bounds<ScaledPixels> {
+    Bounds { origin: point(ScaledPixels(x), ScaledPixels(y)), size: Size { width: ScaledPixels(w), height: ScaledPixels(h) } }
+}
+
+fn quad(x: f32, y: f32) -> Quad {
+    let bounds = rect(x, y, 10., 10.);
+    Quad { bounds, content_mask: ContentMask { bounds }, transformation: TransformationMatrix::unit(), ..Default::default() }
+}
+
+fn label(group: u32, x: f32) -> PaintSurface {
+    let bounds = rect(x, 0., 10., 10.);
+    PaintSurface {
+        order: 0,
+        bounds,
+        content_mask: ContentMask { bounds },
+        corner_radii: Default::default(),
+        blur_radius: 0.,
+        group,
+        opacity: 0.5,
+        color_matrix: None,
+        fragment: 0,
+    }
+}
+
+fn group(scene: Scene, x: f32) -> PaintGroup {
+    PaintGroup { scene: std::rc::Rc::new(scene), bounds: rect(x, 0., 10., 10.), mask_bounds: rect(x, 0., 10., 10.), ..Default::default() }
+}
+
+fn finished(mut scene: Scene) -> Scene {
+    scene.finish();
+    scene
+}
+
+/// A frame whose range (from command 1) made group 1 (nested, labelled in
+/// group 2's scene) and group 2 (labelled in the frame), after one earlier
+/// group of another owner.
+fn frame() -> Scene {
+    let mut frame = Scene::default();
+    frame.groups.push(group(Scene::default(), 500.));
+    frame.insert_primitive(quad(500., 0.));
+    let mut nested = Scene { in_group: true, ..Scene::default() };
+    nested.insert_primitive(quad(20., 0.));
+    frame.groups.push(group(finished(nested), 20.));
+    let mut outer = Scene { in_group: true, ..Scene::default() };
+    outer.insert_primitive(quad(0., 0.));
+    outer.insert_primitive(label(2, 20.));
+    frame.groups.push(group(finished(outer), 0.));
+    frame.insert_primitive(label(3, 0.));
+    frame.insert_primitive(quad(40., 0.));
+    finished(frame)
+}
+
+fn labels(scene: &Scene) -> Vec<u32> {
+    scene.surfaces.iter().map(|surface| surface.group).collect()
+}
+
+/// Replay commands `1..` and groups `1..3` of `prev` the way
+/// `Window::replay_groups` does, into a frame that made `before` groups.
+fn replay(prev: &Scene, before: usize) -> Scene {
+    let mut next = Scene::default();
+    for _ in 0..before {
+        next.groups.push(group(Scene::default(), 900.));
+    }
+    let delta = before as i32 - 1;
+    let still = |_| (Point::default(), Bounds::default());
+    let copies: Vec<_> = prev.groups[1..3].iter().map(|g| Scene::replayed_group(g, delta, None, &still)).collect();
+    next.groups.extend(copies);
+    next.relabel = delta;
+    next.replay(1..prev.paint_operations.len(), prev);
+    next.relabel = 0;
+    finished(next)
+}
+
+#[test]
+fn a_replay_lands_its_groups_after_the_frames_and_renumbers_every_label() {
+    let prev = frame();
+    for before in [0, 1, 3] {
+        let next = replay(&prev, before);
+        assert_eq!(next.groups.len(), before + 2);
+        // The frame's label names the outer copy; the outer copy's label the nested one.
+        assert_eq!(labels(&next), vec![before as u32 + 2]);
+        let outer = &next.groups[before + 1];
+        assert_eq!(labels(&outer.scene), vec![before as u32 + 1]);
+        assert_eq!(outer.scene.quads.len(), 1);
+        assert_eq!(next.groups[before].scene.quads[0].bounds, rect(20., 0., 10., 10.));
+        assert_eq!(outer.bounds, prev.groups[2].bounds);
+    }
+}
+
+#[test]
+fn a_replay_at_the_recorded_place_copies_labels_unchanged() {
+    let prev = frame();
+    let next = replay(&prev, 1);
+    assert_eq!(labels(&next), labels(&prev));
+    assert_eq!(next.quads.len(), 1);
+}
+
+#[test]
+fn renumbering_reaches_dormant_labels_without_touching_the_shared_command() {
+    let shared = std::rc::Rc::new(Primitive::Surface(label(3, 0.)));
+    let scene = Scene { relabel: -2, ..Scene::default() };
+    let copied = scene.relabeled(&PaintOperation::Dormant(shared.clone()));
+    let PaintOperation::Dormant(copy) = copied else { panic!("not dormant") };
+    assert!(matches!(&*copy, Primitive::Surface(s) if s.group == 1));
+    assert!(matches!(&*shared, Primitive::Surface(s) if s.group == 3));
+    // A command that is no label is the same command.
+    let plain = scene.relabeled(&PaintOperation::Primitive(Primitive::Quad(quad(0., 0.))));
+    assert!(matches!(plain, PaintOperation::Primitive(Primitive::Quad(_))));
+}
+
+/// Groups 1 (nested, labelled in group 2's scene) and 2 (labelled in the
+/// frame with mask `mask`, under the node when `marked`), each holding a
+/// command under a scroll node.
+fn labelled(mask: Bounds<ScaledPixels>, marked: bool) -> Scene {
+    let (node, chain) = (crate::ScrollNodeId(7), rect(0., 0., 1000., 1000.));
+    let mut frame = Scene::default();
+    let mut nested = Scene { in_group: true, ..Scene::default() };
+    nested.scroll.open = Some((node, chain));
+    nested.insert_primitive(quad(20., 0.));
+    nested.scroll.open = None;
+    frame.groups.push(group(finished(nested), 20.));
+    let mut outer = Scene { in_group: true, ..Scene::default() };
+    outer.scroll.open = Some((node, chain));
+    outer.insert_primitive(quad(0., 0.));
+    outer.scroll.open = None;
+    outer.insert_primitive(label(1, 20.));
+    frame.groups.push(group(finished(outer), 0.));
+    frame.scroll.open = marked.then_some((node, chain));
+    frame.insert_group_surface(PaintSurface { content_mask: ContentMask { bounds: mask }, ..label(2, 0.) }, false);
+    frame.scroll.open = None;
+    frame.insert_primitive(quad(40., 0.));
+    finished(frame)
+}
+
+#[test]
+fn a_group_whose_label_its_node_dropped_is_hidden_and_copied_by_any_replay() {
+    // Outside its own mask under its node, the label shows at no offset: the
+    // group it labels is composited by no replay, nor is the group nested in it.
+    let frame = labelled(rect(300., 300., 10., 10.), true);
+    assert!(labels(&frame).is_empty());
+    let found = frame.group_labels(0..frame.paint_operations.len(), 0..2);
+    assert_eq!(found, vec![GroupLabel::Hidden; 2]);
+    assert!(frame.groups_scrollable(0..2, &found, |_| false));
+    // Dropped under no node (a record's, marked where its copy lands), a
+    // later offset may show it: its commands under a node must not be copied.
+    let frame = labelled(rect(300., 300., 10., 10.), false);
+    let found = frame.group_labels(0..frame.paint_operations.len(), 0..2);
+    assert_eq!(found, vec![GroupLabel::Unmarked; 2]);
+    assert!(!frame.groups_scrollable(0..2, &found, |_| true));
+    // Drawn under its node, the group moves with it.
+    let frame = labelled(rect(0., 0., 10., 10.), true);
+    let found = frame.group_labels(0..frame.paint_operations.len(), 0..2);
+    assert_eq!(found, vec![GroupLabel::Unmarked, GroupLabel::Under(crate::ScrollNodeId(7))]);
+}
+#[test]
+fn moving_nested_groups_into_the_frame_renumbers_their_dormant_labels() {
+    // A nested group's label kept dormant under a node in the enclosing
+    // group's scene names the nested group after the frame's list grew,
+    // as a drawn label does (`shift_group_ids`): the enclosing group then
+    // finds it under its node, and a scrolled replay moves both.
+    let (node, chain) = (crate::ScrollNodeId(7), rect(0., 0., 100., 100.));
+    let mut nested = Scene { in_group: true, ..Scene::default() };
+    nested.scroll.open = Some((node, chain));
+    nested.insert_primitive(quad(200., 0.));
+    nested.scroll.open = None;
+    let mut outer = Scene { in_group: true, ..Scene::default() };
+    outer.scroll.open = Some((node, chain));
+    outer.insert_primitive(label(1, 200.));
+    outer.scroll.open = None;
+    assert!(matches!(outer.paint_operations[..], [PaintOperation::Dormant(_)]), "below the chain: kept dormant");
+    let base = 4;
+    outer.shift_group_ids(base);
+    let PaintOperation::Dormant(kept) = &outer.paint_operations[0] else { panic!("not dormant") };
+    assert!(matches!(&**kept, Primitive::Surface(s) if s.group == base + 1));
+    let mut frame = Scene::default();
+    for _ in 0..base {
+        frame.groups.push(group(Scene::default(), 900.));
+    }
+    frame.groups.push(group(finished(nested), 200.));
+    frame.groups.push(group(finished(outer), 0.));
+    frame.scroll.open = Some((node, chain));
+    frame.insert_group_surface(label(base + 2, 0.), false);
+    frame.scroll.open = None;
+    let frame = finished(frame);
+    let base = base as usize;
+    let found = frame.group_labels(0..frame.paint_operations.len(), base..base + 2);
+    assert_eq!(found, vec![GroupLabel::Under(node); 2]);
+    assert!(frame.groups_scrollable(base..base + 2, &found, |id| id == node));
+}
