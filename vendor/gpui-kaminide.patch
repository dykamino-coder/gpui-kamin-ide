-fn previous_boundary(content: &str, offset: usize) -> usize {
-    content
-        .grapheme_indices(true)
-        .rev()
-        .find_map(|(idx, _)| (idx < offset).then_some(idx))
-        .unwrap_or(0)
-}
-
-fn next_boundary(content: &str, offset: usize) -> usize {
-    content
-        .grapheme_indices(true)
-        .find_map(|(idx, _)| (idx > offset).then_some(idx))
-        .unwrap_or(content.len())
-}
