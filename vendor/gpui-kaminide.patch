+    /// KaminIDE patch: принять ЧУЖУЮ текстуру D3D11 (готовый кадр браузера) и
+    /// получить её описатель для отрисовки. Указатель должен быть с AddRef.
+    pub fn register_external_texture(
+        &self,
+        texture: *mut std::ffi::c_void,
+        width: i32,
+        height: i32,
+    ) -> Option<ExternalTexture> {
+        let size = size(DevicePixels(width), DevicePixels(height));
+        self.platform_window
+            .register_external_texture(texture, size)
+            .map(ExternalTexture)
+    }
+
+    /// KaminIDE patch: подменить кадр в УЖЕ выданном описателе: запись
+    /// атласа та же, меняется только её содержимое. `size` — новый размер
+    /// кадра в физических px.
+    pub fn update_external_texture(
+        &self,
+        texture: &ExternalTexture,
+        raw: *mut std::ffi::c_void,
+        width: i32,
+        height: i32,
+    ) -> Option<ExternalTexture> {
+        if !self
+            .platform_window
+            .update_external_texture(texture.0.texture_id, raw)
+        {
+            return None;
+        }
+        Some(texture.with_size(width, height))
+    }
+
+    /// KaminIDE patch: the producer repainted the rectangle (`x, y, w, h`,
+    /// physical texture pixels) of an external texture. From the first call a
+    /// window frame redraws only such rectangles of its sprites, not the whole
+    /// window, so EVERY change of its pixels must be reported.
+    pub fn damage_external_texture(&self, texture: &ExternalTexture, x: i32, y: i32, w: i32, h: i32) {
+        self.platform_window.damage_external_texture(
+            texture.0.texture_id,
+            Bounds {
+                origin: point(DevicePixels(x), DevicePixels(y)),
+                size: size(DevicePixels(w.max(0)), DevicePixels(h.max(0))),
+            },
+        );
+    }
