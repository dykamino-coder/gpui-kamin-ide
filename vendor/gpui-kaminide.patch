+            letter_spacing
+        };
+        let _font_generation = self.clear_if_font_generation_changed();
+        let key = &CacheKeyRef {
+            text: text.as_ref(),
+            font_size,
+            runs,
+            wrap_width,
+            force_width: None,
+            letter_spacing,
+        } as &dyn AsCacheKeyRef;
