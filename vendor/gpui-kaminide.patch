+                "{:<20} - {}:{}\n",
+                format!("{:?}", timing.poll_duration()),
+                timing.location.file(),
+                timing.location.column()
+            ))?;
+        }
+        f.write_str("Tasks that ran the longest\n")?;
+        for timing in self.longest_runtimes {
