index 0000000000000000000000000000000000000000..3f2115596cc2fd7ac11ac3be33de0ce6ce0d5daa
--- /dev/null
+++ b/vendor/gpui/src/scene/layer/boxes.rs
@@ -0,0 +1,222 @@
+//! KaminIDE patch: the paint ranges of boxes in a scene layer.
+//!
+//! While a layer is recorded, the own paint of a box (its shadows, fill,
+//! borders and host painter, `Window::with_run`) is painted as without
+//! a layer: each command takes its order from the scene's bounds tree when it
+//! is painted. The layer only notes the box's run of commands, its ink and
+//! paint state, so a later recording of the box replaces the run whole
+//! (`Window::rerecord_layer_box`) with the orders a paint from scratch gives
+//! the new commands (`scene::layer::order`). Blink keeps the display items of
+//! a client in paint order and repaints a client's items into a new artifact
+//! (`paint_controller.cc:228`); this layer splices the box's run in place.
+
+use super::super::{PaintOperation, Primitive, ScaledPixels, Scene, placed_bounds};
+use crate::{Bounds, ContentMask, Pixels, TransformationMatrix};
+use std::ops::Range;
+
+/// Painter responsible for a recorded owner's output.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum LayerPainter {
+    /// The box painter supplies all of its own paint.
+    Box,
+    /// The inline painter supplies one or more line fragments.
+    Band,
+    /// Decorations are painted by child elements.
+    DecoratedBox,
+    /// Other painters contribute to this owner's output.
+    External,
+}
+
+#[derive(Clone, Copy, Debug)]
+pub(crate) enum BoxContents {
+    Own,
+    DecoratedBox(Pixels),
+    External,
+}
+
+#[derive(Clone, Copy, Debug)]
+pub(crate) enum RunPainter {
+    Box(BoxContents),
+    Band(Option<crate::text_system::band_piece::BandEdges>),
+}
+
+impl RunPainter {
+    pub(crate) fn kind(self) -> LayerPainter {
+        match self {
+            Self::Box(BoxContents::Own) => LayerPainter::Box,
+            Self::Box(BoxContents::DecoratedBox(_)) => LayerPainter::DecoratedBox,
+            Self::Box(BoxContents::External) => LayerPainter::External,
+            Self::Band(_) => LayerPainter::Band,
+        }
+    }
+}
+
+/// The paint state a box's own paint ran in: what its later recording
+/// restores.
+#[derive(Clone, Copy, Debug)]
+pub(crate) struct BoxEnv {
+    pub(crate) bounds: Bounds<Pixels>,
+    pub(crate) mask: ContentMask<Pixels>,
+    pub(crate) transformation: TransformationMatrix,
+    pub(crate) opacity: f32,
+    pub(crate) rem_size: Pixels,
+    /// The unrounded border box of the painting element when its snapped
+    /// border box is `bounds` (`RasterFrame::exact_bounds`): border snapping
+    /// and child layers read it.
+    pub(crate) exact: Option<Bounds<Pixels>>,
+    /// Where the host placed the box's fill (Window::box_fill_bounds).
+    pub(crate) fill: Option<Bounds<Pixels>>,
+    /// The order of the stacking layer the run was painted in (`None`:
+    /// outside layers, ordered by the bounds tree).
+    pub(crate) layer: Option<crate::scene::DrawOrder>,
+    pub(crate) painter: RunPainter,
+    /// The hitbox whose hover refines the box's style (`Interactivity::hover_style`)
+    /// and whether the run was painted hovered: a later recording paints the
+    /// style the box shows now (`Window::layer_box_hover`).
+    pub(crate) hover: Option<(crate::HitboxId, bool)>,
+}
+
+/// A box's own paint in a layer: its owner, its placed area and ink, its run
+/// of paint commands and its environment.
+#[derive(Clone, Debug)]
+pub(crate) struct BoxRange {
+    pub(crate) owner: u32,
+    pub(crate) area: Bounds<ScaledPixels>,
+    pub(crate) ink: Option<Bounds<ScaledPixels>>,
+    pub(crate) ops: Range<u32>,
+    pub(crate) env: BoxEnv,
+    /// The run is plain primitives, which a recording replaces.
+    pub(crate) replaceable: bool,
+    /// How the run's commands came here from the paint record its box painted
+    /// in (`super::placed`); a recording of the box is placed the same way.
+    pub(crate) placed: Option<super::Placed>,
+    /// The group of the layer whose scene holds the run (`None`: the
+    /// layer's own scene); a run there is replaced in that scene
+    /// (`SceneLayer::replace_group_run`).
+    pub(crate) group: Option<u32>,
+}
+
+impl BoxRange {
+    pub(crate) fn accepts(&self, painter: LayerPainter) -> bool {
+        // A transformed run is painted again under its transformation
+        // (`Window::paint_box_run`).
+        self.replaceable
+            && match (self.env.painter, painter) {
+                (RunPainter::Box(BoxContents::Own), LayerPainter::Box) => self.env.layer.is_none(),
+                (RunPainter::Band(Some(_)), LayerPainter::Band) => true,
+                _ => false,
+            }
+    }
+}
+
+/// A box's own paint being recorded: where its commands start.
+pub(crate) struct OpenBox {
+    owner: u32,
+    ops: usize,
+    area: Bounds<ScaledPixels>,
+    env: BoxEnv,
+    /// The box placed more than one fill (painted per fragment of its
+    /// admission): its `env` restores none of them, so the run is not
+    /// replaceable and an edit of the box paints the layer anew.
+    split: bool,
+}
+
+/// The clipped placed bounds of a primitive.
+pub(crate) fn ink_of(primitive: &Primitive) -> Bounds<ScaledPixels> {
+    placed_bounds(primitive).intersect(&primitive.content_mask().bounds)
+}
+
+fn union(a: Option<Bounds<ScaledPixels>>, b: Bounds<ScaledPixels>) -> Option<Bounds<ScaledPixels>> {
+    if b.is_empty() {
+        return a;
+    }
+    Some(a.map_or(b, |a| a.union(&b)))
+}
+
+impl Scene {
+    /// Start the own paint of box `owner` with `area` (its placed bounds,
+    /// device pixels). `false` where the scene orders by other means
+    /// (nested or bottom stacking layers, 3D, a box already open): the box
+    /// paints as before. Inside one stacking layer (`Scene::push_layer`, the
+    /// layer of a text line) every command takes the layer's order, which the
+    /// run keeps (`BoxEnv::layer`).
+    pub(crate) fn open_box(&mut self, owner: u32, area: Bounds<ScaledPixels>, mut env: BoxEnv) -> bool {
+        if self.run_refusal().is_some() {
+            return false;
+        }
+        env.layer = self.layer_stack.last().copied();
+        self.book.open_box = Some(OpenBox {
+            owner,
+            ops: self.paint_operations.len(),
+            area,
+            env,
+            split: false,
+        });
+        true
+    }
+
+    /// Why a box's own paint opened now would keep no run (`open_box`), for
+    /// the DevTools `why` journal; `None` when it would.
+    pub(crate) fn run_refusal(&self) -> Option<&'static str> {
+        Some(match () {
+            _ if self.book.open_box.is_some() => "inside the run of another box",
+            // A group's scene (`in_group`) is composited into the layer as one
+            // result: a run of its commands is no run of the layer.
+            // A paint record that keeps box runs (`super::placed`) is no group.
+            _ if self.in_group && self.book.record_runs.is_none() && self.book.group_runs.is_none() => {
+                "inside a composition group"
+            }
+            _ if self.layer_stack.len() > 1 => "inside a nested stacking layer",
+            _ if self.layer_stack.last() == Some(&super::super::BOTTOM_LAYER) => "inside the bottom layer",
+            _ if !self.depth.plane_stack.is_empty() || !self.depth.contexts.is_empty() => "inside a 3D context",
+            _ => return None,
+        })
+    }
+
+    /// Whether a box's own paint is open.
+    pub(crate) fn box_open(&self) -> bool {
+        self.book.open_box.is_some()
+    }
+
+    /// Note a fill the open box's paint places: the first is its fill, a
+    /// second splits it (`OpenBox::split`).
+    pub(crate) fn note_open_box_fill(&mut self, fill: Bounds<Pixels>) {
+        if let Some(open) = self.book.open_box.as_mut() {
+            match open.env.fill {
+                None => open.env.fill = Some(fill),
+                Some(_) => open.split = true,
+            }
+        }
+    }
+
+    /// Finish the open box: its run of commands and their ink.
+    pub(crate) fn close_box(&mut self) -> Option<BoxRange> {
+        let open = self.book.open_box.take()?;
+        let ops = open.ops..self.paint_operations.len();
+        let mut ink = None;
+        let mut plain = true;
+        for operation in &self.paint_operations[ops.clone()] {
+            match operation {
+                PaintOperation::Primitive(p) => {
+                    // Sprites sort by tile within an order: not in paint order.
+                    plain &= matches!(
+                        p,
+                        Primitive::Shadow(_) | Primitive::Quad(_) | Primitive::Gradient(_) | Primitive::Underline(_)
+                    );
+                    ink = union(ink, ink_of(p));
+                }
+                _ => plain = false,
+            }
+        }
+        Some(BoxRange {
+            owner: open.owner,
+            area: union(ink, open.area).unwrap_or(open.area),
+            ink,
+            ops: ops.start as u32..ops.end as u32,
+            env: open.env,
+            replaceable: plain && !open.split,
+            placed: None,
+            group: None,
+        })
+    }
+}
diff --git a/vendor/gpui/src/scene/layer/clipped_tests.rs b/vendor/gpui/src/scene/layer/clipped_tests.rs
new file mode 100644
index 0000000000000000000000000000000000000000..b99f6e442b65c5477e0d8b6f75af751f047b57eb
--- /dev/null
+++ b/vendor/gpui/src/scene/layer/clipped_tests.rs
@@ -0,0 +1,78 @@
+//! Scene layers: a box of a placed record whose commands every placement's
+//! clip cut away keeps one empty run, as a box painted directly whose
+//! commands the content mask culled; a box painted in another placement
+//! keeps only its painted runs.
+
+use super::order_tests::{env, quad, rect};
+use super::{LayerHandle, Placed, PlacedMap, RecordRuns, SceneLayer};
+use crate::{Hsla, Scene, ScaledPixels, hsla, point};
+
+fn blue() -> Hsla {
+    hsla(0.6, 1., 0.5, 1.)
+}
+
+/// Two columns of a child 100 tall, 50 per column, 60 apart.
+fn columns() -> [Placed; 2] {
+    let at = |x: f32, y: f32| point(ScaledPixels(x), ScaledPixels(y));
+    [
+        Placed { offset: at(0., 0.), clip: Some(rect(0., 0., 40., 50.)) },
+        Placed { offset: at(60., -50.), clip: Some(rect(60., 0., 40., 50.)) },
+    ]
+}
+
+/// A record of box 1 (second column) and box 3 below both columns.
+fn record() -> Scene {
+    let mut s = Scene { in_group: true, ..Scene::default() };
+    s.book.record_runs = Some(Box::default());
+    for (owner, area) in [(1, rect(0., 60., 40., 30.)), (3, rect(0., 110., 40., 20.))] {
+        assert!(s.open_box(owner, area, env()));
+        s.insert_primitive(quad(area, blue()));
+        let run = s.close_box().unwrap();
+        s.book.record_runs.as_mut().unwrap().boxes.push(run);
+    }
+    s.end_record_runs();
+    s.finish();
+    s
+}
+
+fn layer() -> LayerHandle {
+    let record = record();
+    let mut page = Scene::default();
+    let mut carried = RecordRuns::default();
+    for placed in columns() {
+        page.book.placed_map = Some(PlacedMap::new(Some(placed), 0));
+        assert!(page.replay_placed(&record, placed.offset, placed.clip));
+        let map = page.book.placed_map.take().unwrap();
+        carried.extend(record.book.record_runs.as_deref().unwrap().carry(&map, &page));
+    }
+    LayerHandle::new(SceneLayer::finish(page, carried.bindings, carried.boxes))
+}
+
+#[test]
+fn a_box_clipped_away_in_every_placement_keeps_one_empty_run() {
+    let layer = layer();
+    let content = layer.0.content.borrow();
+    let runs: Vec<usize> = content.runs_of(3).collect();
+    assert_eq!(runs.len(), 1, "one empty run for both placements");
+    assert!(content.boxes[runs[0]].ops.is_empty(), "no command of box 3 landed");
+    drop(content);
+    assert!(layer.holds_box(3), "the layer holds the box clipped away");
+    let area = layer.box_area(3).expect("its area");
+    assert!(
+        !area.intersects(&rect(0., 0., 100., 50.)),
+        "its area lies outside the columns: {area:?}"
+    );
+    assert!(
+        layer.set_background(3, blue(), hsla(0., 1., 0.5, 1.)).is_none(),
+        "no fill of it is painted: a value write refuses"
+    );
+}
+
+#[test]
+fn a_box_painted_in_one_placement_keeps_only_its_painted_run() {
+    let layer = layer();
+    let content = layer.0.content.borrow();
+    let runs: Vec<usize> = content.runs_of(1).collect();
+    assert_eq!(runs.len(), 1, "box 1 shows in the second column only");
+    assert!(!content.boxes[runs[0]].ops.is_empty(), "its run holds its fill");
+}
diff --git a/vendor/gpui/src/scene/layer/frame.rs b/vendor/gpui/src/scene/layer/frame.rs
new file mode 100644
index 0000000000000000000000000000000000000000..aff9537f8bdb7c0d608fb3cd9d3d75461f10febf
--- /dev/null
+++ b/vendor/gpui/src/scene/layer/frame.rs
@@ -0,0 +1,233 @@
+//! KaminIDE patch: layers inside a frame scene (`scene::layer`).
+//!
+//! The frame takes one command per layer (`PaintOperation::Layer`) that names
+//! the host's layer weakly, and one slot that holds the content it draws
+//! strongly from its draw to its present (`Scene::release_layers`). A frame
+//! that replays the command reads the host's current content.
+
+use super::{LayerCell, LayerHandle, SceneLayer, layer_counters};
+use crate::scene::{BOTTOM_LAYER, Bounds, DrawOrder, ORDER_STEP, PaintOperation, ScaledPixels, Scene};
+use std::rc::{Rc, Weak};
+use std::sync::atomic::Ordering::Relaxed;
+
+/// A layer in a frame scene: its order there, the host's layer and, from the
+/// frame's draw to its present, the content the frame draws.
+pub(crate) struct LayerSlot {
+    pub(crate) order: DrawOrder,
+    pub(crate) cell: Weak<LayerCell>,
+    pub(crate) held: Option<Rc<SceneLayer>>,
+    /// Id and version of the content the frame drew: after its present the
+    /// next frame finds that content again only by them (`damage::shift`).
+    pub(crate) drawn: (u64, u64),
+}
+
+/// Id and version of a layer's content.
+fn drawn(content: &SceneLayer) -> (u64, u64) {
+    (content.id, content.version)
+}
+
+/// The command of a layer in a frame scene: the host's layer, its bounds in
+/// the frame (clipped by the content mask) and its order there.
+#[derive(Clone)]
+pub(crate) struct LayerOp {
+    pub(crate) cell: Weak<LayerCell>,
+    pub(crate) bounds: Bounds<ScaledPixels>,
+    pub(crate) order: DrawOrder,
+}
+
+impl Scene {
+    /// Add the current content of `layer` to this scene, ordered like one
+    /// primitive of `bounds` (already clipped by the content mask).
+    pub(crate) fn insert_layer(&mut self, layer: &LayerHandle, bounds: Bounds<ScaledPixels>) {
+        if bounds.is_empty() {
+            return;
+        }
+        crate::window::ink_add(&self.ink, self.ink_scope, bounds);
+        crate::window::scoped_ink(self.ink_scope, |sink| sink.add_in(self.ink_scope, bounds));
+        let order = match self.layer_stack.last().copied() {
+            Some(BOTTOM_LAYER) => {
+                self.bottom_seq = (self.bottom_seq + 1).min(ORDER_STEP - 1);
+                ORDER_STEP + self.bottom_seq
+            }
+            Some(order) => order,
+            None => self.tree_mut().insert(bounds) * ORDER_STEP,
+        };
+        // A recorded layer is new paint: its damage is all of it.
+        layer.0.damage.take();
+        self.book.fresh += 1;
+        let cell = Rc::downgrade(&layer.0);
+        self.paint_operations.push(PaintOperation::Layer(LayerOp { cell: cell.clone(), bounds, order }));
+        let held = layer.content();
+        self.book.layers.push(LayerSlot { order, cell, drawn: drawn(&held), held: Some(held) });
+    }
+
+    /// Add the slot of a replayed layer command (its order already set);
+    /// `false` when the host dropped the layer, which then draws nothing.
+    pub(crate) fn push_layer_slot(&mut self, op: &LayerOp) -> bool {
+        let Some(cell) = op.cell.upgrade() else {
+            return false;
+        };
+        let held = cell.content.borrow().clone();
+        if let Some(rect) = cell.damage.take() {
+            self.book.layer_damage = Some(self.book.layer_damage.map_or(rect, |d| d.union(&rect)));
+        }
+        self.book.layers.push(LayerSlot { order: op.order, cell: op.cell.clone(), drawn: drawn(&held), held: Some(held) });
+        true
+    }
+
+    /// The content of layer `index` (`PrimitiveBatch::Layer`), while the scene
+    /// holds it: its scene, id and version.
+    pub fn layer(&self, index: usize) -> Option<&SceneLayer> {
+        self.book.layers.get(index)?.held.as_deref()
+    }
+
+    /// The content of every layer this scene draws: what it holds, or after
+    /// its present the host's current content (tests and snapshots read it).
+    pub fn layer_contents(&self) -> Vec<Rc<SceneLayer>> {
+        let current = |slot: &LayerSlot| slot.cell.upgrade().map(|cell| cell.content.borrow().clone());
+        self.book.layers.iter().filter_map(|slot| slot.held.clone().or_else(|| current(slot))).collect()
+    }
+
+    /// Number of layers this scene draws.
+    pub fn layer_count(&self) -> usize {
+        self.book.layers.len()
+    }
+
+    /// The scene was presented: let the content of its layers go, so a write
+    /// before the next draw does not copy it.
+    pub(crate) fn release_layers(&mut self) {
+        for slot in &mut self.book.layers {
+            slot.held = None;
+        }
+        // The sources served this frame's damage (`damage::shift`), noted
+        // before its draw: no later write copies them.
+        self.book.layer_sources.clear();
+    }
+
+    /// Keep `source`, the content a layer recorded now replays from, until
+    /// this frame is presented: it is what the last frame drew of that layer,
+    /// and the comparison of a scroll step reads it (`damage::shift`).
+    pub(crate) fn keep_layer_source(&mut self, source: &Rc<SceneLayer>) {
+        if !self.book.layer_sources.iter().any(|s| Rc::ptr_eq(s, source)) {
+            self.book.layer_sources.push(source.clone());
+        }
+    }
+
+    /// The content `slot` of `previous` drew, while it is known: still held,
+    /// or a source this scene kept or a layer it draws, of the same id and version.
+    pub(crate) fn drawn_layer<'a>(&'a self, previous: &'a Scene, slot: usize) -> Option<&'a SceneLayer> {
+        let slot = previous.book.layers.get(slot)?;
+        if let Some(held) = slot.held.as_deref() {
+            return Some(held);
+        }
+        // A layer this frame did not record again holds that same content.
+        let current = self.book.layers.iter().filter_map(|s| s.held.as_deref());
+        self.book.layer_sources.iter().map(|s| &**s).chain(current).find(|s| drawn(s) == slot.drawn)
+    }
+
+    /// Hold the layers' current content again to present this scene once more.
+    pub(crate) fn hold_layers(&mut self) {
+        for slot in &mut self.book.layers {
+            if slot.held.is_none() {
+                slot.held = slot.cell.upgrade().map(|cell| cell.content.borrow().clone());
+            }
+        }
+    }
+
+    /// Primitives of every kind, the layers' included.
+    pub fn primitive_count(&self) -> usize {
+        self.shadows.len()
+            + self.quads.len()
+            + self.paths.len()
+            + self.underlines.len()
+            + self.monochrome_sprites.len()
+            + self.subpixel_sprites.len()
+            + self.polychrome_sprites.len()
+            + self.surfaces.len()
+            + self.book.layers.iter().filter_map(|s| s.held.as_ref()).map(|l| l.scene.primitive_count()).sum::<usize>()
+    }
+
+    /// `finish`, returning where each quad moved (`moved[old] == new`).
+    pub(crate) fn finish_tracking_quads(&mut self) -> Vec<u32> {
+        let mut by_order: Vec<u32> = (0..self.quads.len() as u32).collect();
+        // Stable, as `finish`'s sort: equal orders keep paint order.
+        by_order.sort_by_key(|&at| self.quads[at as usize].order);
+        let quads = by_order.iter().map(|&at| self.quads[at as usize]).collect();
+        self.quads = quads;
+        let mut moved = vec![0; by_order.len()];
+        for (new, &old) in by_order.iter().enumerate() {
+            moved[old as usize] = new as u32;
+        }
+        self.finish();
+        moved
+    }
+
+    /// A copy of a finished layer or group scene (a write's copy on write);
+    /// nested groups are shared handles.
+    pub(crate) fn copy_finished(&self) -> Scene {
+        Scene {
+            book: Box::new(super::super::SceneBook { images: self.book.images.clone(), gradients: self.book.gradients.clone(),
+                gradient_values: self.book.gradient_values.clone(), ..Default::default() }),
+            paint_operations: self.paint_operations.clone(),
+            primitive_bounds: self.primitive_bounds.clone(),
+            shadows: self.shadows.clone(),
+            quads: self.quads.clone(),
+            paths: self.paths.clone(),
+            underlines: self.underlines.clone(),
+            monochrome_sprites: self.monochrome_sprites.clone(),
+            subpixel_sprites: self.subpixel_sprites.clone(),
+            polychrome_sprites: self.polychrome_sprites.clone(),
+            surfaces: self.surfaces.clone(),
+            groups: self.groups.clone(),
+            in_group: self.in_group,
+            // The copy keeps the scroll marks and the space ranges recorded in
+            // the layer count in (`scroll_marks::SceneSpace`).
+            scroll: super::super::scroll_marks::ScrollBook {
+                marks: self.scroll.marks.clone(),
+                space: self.scroll.space,
+                ..Default::default()
+            },
+            ..Scene::default()
+        }
+    }
+
+    /// Order the layers for batching (`finish`).
+    pub(crate) fn finish_layers(&mut self) {
+        let layers = &self.book.layers;
+        self.book.layer_order.clear();
+        self.book.layer_order.extend(0..layers.len() as u32);
+        self.book.layer_order.sort_by_key(|&at| layers[at as usize].order);
+    }
+
+    /// What this finished frame changed against `previous`, the frame it
+    /// replays (`damage`). Platform-neutral: a renderer or a CPU backend may
+    /// raster only the damage, and a frame whose damage is off screen needs
+    /// no raster at all.
+    pub(crate) fn note_damage(&mut self, previous: &Scene) {
+        let same = self.book.fresh == 0
+            && self.hoisted_backdrops.is_empty()
+            && self.paint_operations.len() == previous.paint_operations.len()
+            && self.book.layers.len() == previous.book.layers.len()
+            && self.book.layers.iter().zip(&previous.book.layers).all(|(a, b)| {
+                a.order == b.order && Weak::ptr_eq(&a.cell, &b.cell)
+            });
+        // A group's image is painted from its own scene, which the layer
+        // writes do not track: with groups the damage holds only once the
+        // groups are matched (`note_frame_damage_moved`).
+        let grouped = !self.groups.is_empty() || !previous.groups.is_empty();
+        self.book.damage = (same && !grouped).then_some(self.book.layer_damage);
+        self.book.grouped_damage = (same && grouped).then_some(self.book.layer_damage);
+    }
+
+    /// The device-pixel rectangle this frame changed against the frame
+    /// before it: `Some(None)` — nothing, `Some(Some(r))` — only `r` (values
+    /// written into its layers), `None` — unknown (new paint).
+    pub fn damage(&self) -> Option<Option<Bounds<ScaledPixels>>> {
+        self.book.damage
+    }
+
+    /// Count `n` primitives copied from an earlier scene.
+    pub(crate) fn count_copied(n: usize) {
+        layer_counters::PRIMITIVES_COPIED.fetch_add(n as u64, Relaxed);
+    }
+}
