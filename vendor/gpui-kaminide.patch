-
-    const NB_SAMPLES: usize = 100;
-    const INFLEXION: f32 = 0.35;
-    const START_TENSION: f32 = 0.5;
-    const END_TENSION: f32 = 1.0;
-    const P1: f32 = START_TENSION * INFLEXION;
-    const P2: f32 = 1.0 - END_TENSION * (1.0 - INFLEXION);
