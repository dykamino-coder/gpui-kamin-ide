@@ -0,0 +1,115 @@
+//! Допуск сегментов сохраняется до завершения продолжения поддерева.
+
+use super::*;
+
+impl Window {
+    /// Удерживает область записи и её допуск до завершения продолжения.
+    pub async fn with_paint_segments_async<R>(
+        &mut self,
+        routes: Rc<[PaintSegment]>,
+        paint: impl AsyncFnOnce(&mut Self) -> R,
+    ) -> Result<R, PaintRecordError> {
+        if !valid(&routes, self.scale_factor()) {
+            return Err(PaintRecordError::InvalidGeometry);
+        }
+        let Some(segments) = self.render_contexts.get::<SegmentSet>() else {
+            return Err(PaintRecordError::InvalidSegment);
+        };
+        if routes
+            .iter()
+            .any(|route| !segments.0.iter().any(|segment| segment.id == route.id))
+        {
+            return Err(PaintRecordError::InvalidSegment);
+        }
+        if routes.iter().any(|route| {
+            !validation::scaled_bounds_valid(
+                Bounds::new(
+                    segments.1.origin + route.destination - route.source,
+                    segments.1.size,
+                ),
+                self.scale_factor(),
+            )
+        }) {
+            return Err(PaintRecordError::InvalidGeometry);
+        }
+        let _selection = self.render_contexts.enter(Some(Rc::new(Selection(routes))));
+        let _slices = self.render_contexts.enter::<admission::Slices>(None);
+        Ok(paint(self).await)
+    }
+
+    /// Удерживает область записи и её допуск до завершения продолжения.
+    pub async fn record_paint_segments_async<R>(
+        &mut self,
+        source_clip: Bounds<Pixels>,
+        routes: Rc<[PaintSegment]>,
+        cx: &mut App,
+        stack: &mut crate::PaintStack,
+        paint: impl AsyncFnOnce(&mut Self, &mut App, &mut crate::PaintStack) -> R,
+    ) -> Result<(R, PaintSegmentRecords), PaintRecordError> {
+        if !valid(&routes, self.scale_factor()) {
+            return Err(PaintRecordError::InvalidGeometry);
+        }
+        if !validation::scaled_bounds_valid(source_clip, self.scale_factor())
+            || routes.iter().any(|route| {
+                !validation::scaled_bounds_valid(
+                    Bounds::new(
+                        source_clip.origin + route.destination - route.source,
+                        source_clip.size,
+                    ),
+                    self.scale_factor(),
+                )
+            })
+        {
+            return Err(PaintRecordError::InvalidGeometry);
+        }
+        let segments = routes.clone();
+        let _segments = self
+            .render_contexts
+            .enter(Some(Rc::new(SegmentSet(routes.clone(), source_clip))));
+        let _selection = self.render_contexts.enter(Some(Rc::new(Selection(routes))));
+        let contexts = self.render_contexts.clone();
+        let scope_segments = segments.clone();
+        let read = Rc::new(move || crate::scene::segments::Tag {
+            routes: contexts
+                .get::<Selection>()
+                .map_or_else(|| Rc::from([]), |value| value.0.clone()),
+            scopes: scopes(&scope_segments, contexts.get::<Selection>().as_deref()),
+            clips: contexts.get::<crate::scene::segments::Clip>(),
+            slices: contexts
+                .get::<admission::Slices>()
+                .map_or_else(|| Rc::from([]), |value| value.0.clone()),
+        });
+        let (result, draft, identity, scale) = self
+            .capture_paint_commands_async(source_clip, cx, stack, async |window, cx, stack| {
+                let _recording = window.render_contexts.enter(Some(Rc::new(Recording)));
+                let _clips = window
+                    .render_contexts
+                    .enter::<crate::scene::segments::Clip>(None);
+                let _slices = window.render_contexts.enter::<admission::Slices>(None);
+                window.next_frame.scene.begin_segments(read);
+                paint(window, cx, stack).await
+            })
+            .await?;
+        let mut records = Vec::with_capacity(segments.len());
+        for (index, segment) in segments.iter().enumerate() {
+            if segments[..index].iter().any(|prior| prior.id == segment.id) {
+                continue;
+            }
+            let scene = draft.freeze_segment(segment.id, scale, source_clip);
+            let clip = draft.segment_clip(segment.id, source_clip);
+            if !validation::scaled_bounds_valid(clip, scale) {
+                return Err(PaintRecordError::InvalidGeometry);
+            }
+            records.push((
+                segment.id,
+                PaintRecord(Rc::new(Recorded {
+                    identity: identity.clone(),
+                    scale,
+                    clip,
+                    scene,
+                })),
+            ));
+        }
+        Ok((result, PaintSegmentRecords(records)))
+    }
+}
diff --git a/vendor/gpui/src/window/paint_record/validation.rs b/vendor/gpui/src/window/paint_record/validation.rs
new file mode 100644
index 0000000000000000000000000000000000000000..034695032ea9996211c1dca22dbdc9d26f450d4d
--- /dev/null
+++ b/vendor/gpui/src/window/paint_record/validation.rs
@@ -0,0 +1,55 @@
+//! Проверка явной геометрии до записи или изменения сцены назначения.
+
+use super::*;
+
+pub(super) fn point_valid(point: Point<Pixels>) -> bool {
+    point.x.0.is_finite() && point.y.0.is_finite()
+}
+
+pub(super) fn bounds_valid(bounds: Bounds<Pixels>) -> bool {
+    point_valid(bounds.origin)
+        && bounds.size.width.0.is_finite() && bounds.size.height.0.is_finite()
+        && bounds.size.width.0 >= 0.0 && bounds.size.height.0 >= 0.0
+        && (bounds.origin.x.0 + bounds.size.width.0).is_finite()
+        && (bounds.origin.y.0 + bounds.size.height.0).is_finite()
+}
+
+impl PaintScopeDescriptor {
+    pub(super) fn validate(&self, scale: f32) -> Result<Bounds<Pixels>, PaintRecordError> {
+        let bounds = match self {
+            Self::Clip(bounds) => *bounds,
+            Self::Group(group) => {
+                let corners = group.corner_radii;
+                let valid = [corners.top_left, corners.top_right, corners.bottom_right,
+                    corners.bottom_left].iter().all(|v| v.0.is_finite() && v.0 >= 0.0)
+                    && group.blur_radius.is_finite() && group.blur_radius >= 0.0
+                    && group.opacity.is_finite() && (0.0..=1.0).contains(&group.opacity)
+                    && (group.blur_radius * scale).is_finite()
+                    && [corners.top_left, corners.top_right, corners.bottom_right, corners.bottom_left]
+                        .iter().all(|v| (v.0 * scale).is_finite())
+                    && group.polygon.len() <= 8
+                    && group.polygon.iter().copied().all(|p| point_valid(p)
+                        && (p.x.0 * scale).is_finite() && (p.y.0 * scale).is_finite())
+                    && group.mask.as_ref().is_none_or(|(_, bounds, _)| scaled_bounds_valid(*bounds, scale))
+                    && group.mask_clip.is_none_or(|clip| clip.iter().all(|v| v.is_finite())
+                        && clip[2] >= 0.0 && clip[3] >= 0.0
+                        && (clip[0] + clip[2]).is_finite() && (clip[1] + clip[3]).is_finite())
+                    && group.projection.is_none_or(|map| map.iter().all(|v| v.is_finite()))
+                    && group.fragments.iter().all(|fragment| fragment.len() <= 8
+                        && fragment.iter().copied().all(|p| point_valid(p)
+                            && (p.x.0 * scale).is_finite() && (p.y.0 * scale).is_finite()));
+                if !valid { return Err(PaintRecordError::InvalidGeometry); }
+                group.bounds
+            }
+        };
+        if !scaled_bounds_valid(bounds, scale) { return Err(PaintRecordError::InvalidGeometry); }
+        Ok(bounds)
+    }
+}
+
+// Conversion must stay finite in the actual device coordinate space too.
+pub(super) fn scaled_bounds_valid(bounds: Bounds<Pixels>, scale: f32) -> bool {
+    bounds_valid(bounds) && [bounds.left().0, bounds.top().0, bounds.right().0,
+        bounds.bottom().0, bounds.size.width.0, bounds.size.height.0]
+        .iter().all(|v| (v * scale).is_finite())
+}
