+        #[cfg(any(test, gpui_leak_detection))]
+        if let Some(entity_map) = self.entity_map.upgrade() {
+            entity_map
+                .write()
+                .leak_detector
+                .handle_released(self.entity_id, self.handle_id)
+        }
+    }
+}
