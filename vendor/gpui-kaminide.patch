+            .unwrap();
+        assert!(platform_window.frame_wake_count() > wakes);
+        window
+            .update(cx, |_, window, _| assert!(window.needs_present.get()))
+            .unwrap();
+
+        platform_window.simulate_frame_request(RequestFrameOptions::default());
+        assert_eq!(renders.get(), rendered);
+        window
+            .update(cx, |_, window, _| assert!(!window.needs_present.get()))
+            .unwrap();
