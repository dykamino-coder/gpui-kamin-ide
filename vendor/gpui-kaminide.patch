+++ b/vendor/gpui/src/window/line_baselines.rs
@@ -0,0 +1,89 @@
+//! Detailed content baseline metadata for fragmentation without changing native first/last APIs.
+
+use super::*;
+
+impl Window {
+    /// KaminIDE patch: первая baseline содержимого завершённого border box, без замера.
+    pub fn first_content_baseline(&self, layout: LayoutId, axis: crate::Axis) -> Option<Pixels> {
+        self.layout_engine.as_ref()?.first_content_baseline(layout, axis, self.scale_factor())
+    }
+
+    /// KaminIDE patch: the single in-flow item of a laid-out baseline row and the baseline the
+    /// row aligns it by, read from the item's stored layout output (no probe sibling, no extra
+    /// layout pass). `None` when the row has no in-flow item.
+    pub fn row_item_baseline(&self, row: LayoutId) -> Option<crate::RowItemBaseline> {
+        self.layout_engine.as_ref()?.row_item_baseline(row, self.scale_factor())
+    }
+
+    /// Measure content with the actual containing block and native resolved padding/border.
+    /// The callback returns content size; native layout adds the supplied edges exactly once.
+    pub fn request_measured_layout_with_box(
+        &mut self,
+        style: Style,
+        mut measure: impl FnMut(
+            Size<Option<Pixels>>, Size<AvailableSpace>, crate::MeasuredBox, &mut Window, &mut App,
+        ) -> Size<Pixels> + 'static,
+    ) -> LayoutId {
+        self.invalidator.debug_assert_prepaint();
+        let rem_size = self.rem_size();
+        let scale_factor = self.scale_factor();
+        let scope = self.measure_scope();
+        self.layout_engine.as_mut().unwrap().request_measured_layout_with_box(
+            style, rem_size, scale_factor,
+            move |known, available, geometry, window, cx| scope.enter(window, |window| {
+                crate::MeasuredContent::new(measure(known, available, geometry, window, cx))
+            }),
+        )
+    }
+
+    /// Copy a subtree for independent measurement during the current layout phase.
+    pub fn snapshot_layout_measurement(&self, layout_id: LayoutId) -> crate::LayoutMeasurement {
+        self.layout_engine
+            .as_ref()
+            .unwrap()
+            .snapshot_measurement(layout_id, self.scale_factor())
+    }
+
+    /// Measure content and expose every actual line baseline for visible-fragment consumers.
+    pub fn request_measured_layout_with_line_baselines(
+        &mut self,
+        style: Style,
+        mut measure: impl FnMut(
+            Size<Option<Pixels>>,
+            Size<AvailableSpace>,
+            &mut Window,
+            &mut App,
+        ) -> (Size<Pixels>, Option<Pixels>, Option<Pixels>, Vec<Pixels>)
+        + 'static,
+    ) -> LayoutId {
+        self.invalidator.debug_assert_prepaint();
+        let rem_size = self.rem_size();
+        let scale_factor = self.scale_factor();
+        let scope = self.measure_scope();
+        self.layout_engine
+            .as_mut()
+            .unwrap()
+            .request_measured_layout_with_line_baselines(style, rem_size, scale_factor, move |known, available, window, cx| {
+                scope.enter(window, |window| measure(known, available, window, cx))
+            })
+    }
+
+    /// Measure actual first/last content baselines on both physical axes.
+    pub fn request_measured_layout_with_physical_baselines(
+        &mut self,
+        style: Style,
+        mut measure: impl FnMut(
+            Size<Option<Pixels>>, Size<AvailableSpace>, &mut Window, &mut App,
+        ) -> crate::MeasuredContent + 'static,
+    ) -> LayoutId {
+        self.invalidator.debug_assert_prepaint();
+        let rem_size = self.rem_size();
+        let scale_factor = self.scale_factor();
+        let scope = self.measure_scope();
+        self.layout_engine.as_mut().unwrap()
+            .request_measured_layout_with_physical_baselines(style, rem_size, scale_factor, move |known, available, window, cx| {
+                scope.enter(window, |window| measure(known, available, window, cx))
+            })
+    }
+
+}
diff --git a/vendor/gpui/src/window/natural_image.rs b/vendor/gpui/src/window/natural_image.rs
new file mode 100644
index 0000000000000000000000000000000000000000..cd15e6d8f7197306d93d93f11635f50a96791c02
--- /dev/null
+++ b/vendor/gpui/src/window/natural_image.rs
@@ -0,0 +1,132 @@
+//! Opt-in natural raster painting preserves source phase on the CSS edge grid.
+
+use super::*;
+use std::sync::{Mutex, OnceLock};
+
+type Cache = std::collections::HashMap<(usize, usize, u32, u32, u64, u64, u64), Arc<RenderImage>>;
+static CACHE: OnceLock<Mutex<Cache>> = OnceLock::new();
+
+impl Window {
+    /// Paint an unresized CSS raster with device-snapped destination edges and
+    /// nearest sampling in its original, unrounded source coordinate system.
+    pub fn paint_natural_image(
+        &mut self,
+        bounds: Bounds<Pixels>,
+        corners: Corners<Pixels>,
+        image: Arc<RenderImage>,
+        frame: usize,
+        grayscale: bool,
+    ) -> Result<()> {
+        if self.current_transformation() != TransformationMatrix::unit() {
+            return self.paint_image_with_sampling(
+                bounds,
+                corners,
+                image,
+                frame,
+                grayscale,
+                ImageSampling::Nearest,
+            );
+        }
+        let sf = self.scale_factor();
+        let physical = bounds.scale(sf);
+        let w = (physical.right().round() - physical.left().round())
+            .0
+            .max(0.0) as u32;
+        let h = (physical.bottom().round() - physical.top().round())
+            .0
+            .max(0.0) as u32;
+        let phase = |v: Pixels| {
+            let device = f64::from(f32::from(v)) * f64::from(sf);
+            device.round() - device
+        };
+        let data = resample(
+            &image,
+            frame,
+            w,
+            h,
+            [phase(bounds.left()), phase(bounds.top())],
+            f64::from(sf),
+        );
+        let (image, frame) = match data {
+            Some(image) => (image, 0),
+            None => (image, frame),
+        };
+        self.paint_image_with_sampling(
+            bounds,
+            corners,
+            image,
+            frame,
+            grayscale,
+            ImageSampling::NearestSnapped,
+        )
+    }
+}
+
+fn resample(
+    image: &Arc<RenderImage>,
+    frame: usize,
+    w: u32,
+    h: u32,
+    phase: [f64; 2],
+    scale: f64,
+) -> Option<Arc<RenderImage>> {
+    let source = image.size(frame);
+    let (iw, ih) = (
+        u32::try_from(source.width.0).ok()?,
+        u32::try_from(source.height.0).ok()?,
+    );
+    if iw == 0
+        || ih == 0
+        || w == 0
+        || h == 0
+        || w > 4096
+        || h > 4096
+        || scale <= 0.0
+        || (scale == 1.0 && phase == [0.0; 2])
+    {
+        return None;
+    }
+    let key = (
+        image.id.0,
+        frame,
+        w,
+        h,
+        phase[0].to_bits(),
+        phase[1].to_bits(),
+        scale.to_bits(),
+    );
+    let cache = CACHE.get_or_init(|| Mutex::new(std::collections::HashMap::new()));
+    if let Ok(cache) = cache.lock()
+        && let Some(found) = cache.get(&key)
+    {
+        return Some(found.clone());
+    }
+    let bytes = image.as_bytes(frame)?;
+    let mut out = Vec::with_capacity((w * h * 4) as usize);
+    for y in 0..h {
+        let sy = sample(y, ih, phase[1], scale);
+        for x in 0..w {
+            let sx = sample(x, iw, phase[0], scale);
+            let at = ((sy * iw + sx) * 4) as usize;
+            out.extend_from_slice(&bytes[at..at + 4]);
+        }
+    }
+    let result = crate::bgra_bytes_to_image(w, h, out)?;
+    if let Ok(mut cache) = cache.lock() {
+        if cache.len() >= 32 {
+            cache.clear();
+        }
+        cache.insert(key, result.clone());
+    }
+    Some(result)
+}
+
+fn sample(pixel: u32, source: u32, phase: f64, scale: f64) -> u32 {
+    // CSS Images 3 §5.2 permits nearest sampling. Choosing the preceding
+    // texel on an exact boundary rounds the painted edge upward, like CSS
+    // boxes. Keep source phase after snapping destination edges (Blink
+    // background_image_geometry.cc:114-122), so fractional placement never
+    // stretches or independently shifts the internal texel grid.
+    (((f64::from(pixel) + 0.5 + phase) / scale).ceil() - 1.0).clamp(0.0, f64::from(source - 1))
+        as u32
+}
diff --git a/vendor/gpui/src/window/paint_async.rs b/vendor/gpui/src/window/paint_async.rs
new file mode 100644
index 0000000000000000000000000000000000000000..cdcaeaa409be034ee42178351614e136cd31aae8
--- /dev/null
+++ b/vendor/gpui/src/window/paint_async.rs
@@ -0,0 +1,158 @@
+//! Области окружения сохраняются в продолжении, пока явный стек обходит потомков.
+
+use super::*;
+
+impl Window {
+    pub(crate) async fn with_child_style_async<R>(
+        &mut self,
+        style: &Style,
+        bounds: Bounds<Pixels>,
+        f: impl AsyncFnOnce(&mut Self) -> R,
+    ) -> R {
+        self.invalidator.debug_assert_paint_or_prepaint();
+        let depth = (self.text_style_stack.clone(), self.content_mask_stack.len());
+        if let Some(text) = style.text_style() {
+            self.push_text_style_ref(text);
+        }
+        let _clip_scope = self.push_content_mask(style.overflow_mask_snapped(bounds, self));
+        self.with_restore_async(
+            depth,
+            |window, depth| {
+                window.text_style_stack = std::mem::take(&mut depth.0);
+                window.content_mask_stack.truncate(depth.1);
+            },
+            f,
+        )
+        .await
+        .0
+    }
+
+    pub(crate) async fn with_element_opacity_async<R>(
+        &mut self,
+        opacity: Option<f32>,
+        f: impl AsyncFnOnce(&mut Self) -> R,
+    ) -> R {
+        self.invalidator.debug_assert_paint_or_prepaint();
+
+        let Some(opacity) = opacity else {
+            return f(self).await;
+        };
+
+        let previous_opacity = self.element_opacity;
+        self.element_opacity = previous_opacity * opacity;
+        self.with_restore_async(
+            previous_opacity,
+            |window, previous| window.element_opacity = *previous,
+            f,
+        )
+        .await
+        .0
+    }
+
+    /// Выполняет область окна с продолжением на явном стеке обхода.
+    pub async fn with_tab_group_async<R>(
+        &mut self,
+        index: Option<isize>,
+        f: impl AsyncFnOnce(&mut Self) -> R,
+    ) -> R {
+        if let Some(index) = index {
+            self.next_frame.tab_stops.begin_group(index);
+            let result = f(self).await;
+            self.next_frame.tab_stops.end_group();
+            result
+        } else {
+            f(self).await
+        }
+    }
+
+    /// Выполняет область окна с продолжением на явном стеке обхода.
+    pub async fn with_image_cache_async<R>(
+        &mut self,
+        image_cache: Option<AnyImageCache>,
+        f: impl AsyncFnOnce(&mut Self) -> R,
+    ) -> R {
+        if let Some(image_cache) = image_cache {
+            let depth = self.image_cache_stack.len();
+            self.image_cache_stack.push(image_cache);
+            self.with_restore_async(
+                depth,
+                |window, depth| window.image_cache_stack.truncate(*depth),
+                f,
+            )
+            .await
+            .0
+        } else {
+            f(self).await
+        }
+    }
+
+    /// Выполняет область окна с продолжением на явном стеке обхода.
+    pub async fn with_render_context_async<T: 'static, R>(
+        &mut self,
+        context: Option<Rc<T>>,
+        f: impl AsyncFnOnce(&mut Self) -> R,
+    ) -> R {
+        let scope = self.render_contexts.enter(context);
+        self.with_restore_async(scope, |_, _| {}, f).await.0
+    }
+
+    /// Выполняет область окна с продолжением на явном стеке обхода.
+    pub async fn with_raster_context_async<T: std::any::Any, R>(
+        &mut self,
+        value: Option<Rc<T>>,
+        f: impl AsyncFnOnce(&mut Self) -> R,
+    ) -> R {
+        let previous = self.raster_frame.contexts.replace(value);
+        self.with_restore_async(
+            previous,
+            |window, previous| {
+                window.raster_frame.contexts.set(previous.take());
+            },
+            f,
+        )
+        .await
+        .0
+    }
+    /// Удерживает подготовленную раскладку до завершения продолжения.
+    pub async fn with_retained_layout_async<R>(
+        &mut self,
+        retained: &mut RetainedLayout,
+        f: impl AsyncFnOnce(&mut Self) -> R,
+    ) -> R {
+        let outer = self.activate_retained_layout(retained);
+        self.with_restore_async(outer, Self::restore_retained_layout, f)
+            .await
+            .0
+    }
+
+    /// Удерживает цепочку идентификаторов до завершения продолжения.
+    pub async fn with_element_id_context_async<R>(
+        &mut self,
+        context: &ElementIdContext,
+        f: impl AsyncFnOnce(&mut Self) -> R,
+    ) -> R {
+        let outer = self.replace_element_id_context(context);
+        self.with_restore_async(
+            outer,
+            |window, outer| std::mem::swap(&mut window.element_id_stack, outer),
+            f,
+        )
+        .await
+        .0
+    }
+    /// Удерживает raster frame до завершения дочерней краски.
+    pub async fn with_raster_frame_async<R>(
+        &mut self,
+        mut frame: RasterFrame,
+        f: impl AsyncFnOnce(&mut Self) -> R,
+    ) -> R {
+        mem::swap(&mut self.raster_frame, &mut frame);
+        self.with_restore_async(
+            frame,
+            |window, frame| mem::swap(&mut window.raster_frame, frame),
+            f,
+        )
+        .await
+        .0
+    }
+}
diff --git a/vendor/gpui/src/window/paint_async_masks.rs b/vendor/gpui/src/window/paint_async_masks.rs
new file mode 100644
index 0000000000000000000000000000000000000000..6b33f55db76e5dfb4ab6d7a2e992591cb14cd07b
--- /dev/null
+++ b/vendor/gpui/src/window/paint_async_masks.rs
@@ -0,0 +1,231 @@
+//! Маски и преобразования при обходе детей через явный стек продолжений.
+
+use super::retained::InkProbe;
+use super::*;
+
+impl Window {
+    /// Выполняет область окна с продолжением на явном стеке обхода.
+    pub async fn with_content_mask_async<R>(
+        &mut self,
+        mask: Option<ContentMask<Pixels>>,
+        f: impl AsyncFnOnce(&mut Self) -> R,
+    ) -> R {
+        self.invalidator.debug_assert_paint_or_prepaint();
+        let depth = self.content_mask_stack.len();
+        let _clip_scope = self.push_content_mask(mask);
+        self.with_restore_async(
+            depth,
+            |window, depth| window.content_mask_stack.truncate(*depth),
+            f,
+        )
+        .await
+        .0
+    }
+
+    /// Выполняет область окна с продолжением на явном стеке обхода.
+    pub async fn with_content_mask_replaced_async<R>(
+        &mut self,
+        mask: ContentMask<Pixels>,
+        f: impl AsyncFnOnce(&mut Self) -> R,
+    ) -> R {
+        self.invalidator.debug_assert_paint_or_prepaint();
+        let mask = self.scaled_mask(mask);
+        let _clip_scope = self.segment_clip_scope(mask, true);
+        let depth = self.content_mask_stack.len();
+        self.content_mask_stack.push(mask);
+        self.with_restore_async(
+            depth,
+            |window, depth| window.content_mask_stack.truncate(*depth),
+            f,
+        )
+        .await
+        .0
+    }
+
+    /// Выполняет область окна с продолжением на явном стеке обхода.
+    pub async fn with_content_mask_exact_async<R>(
+        &mut self,
+        mask: ContentMask<Pixels>,
+        f: impl AsyncFnOnce(&mut Self) -> R,
+    ) -> R {
+        self.invalidator.debug_assert_paint_or_prepaint();
+        let _clip_scope = self.segment_clip_scope(mask, true);
+        let depth = self.content_mask_stack.len();
+        self.content_mask_stack.push(mask);
+        self.with_restore_async(
+            depth,
+            |window, depth| window.content_mask_stack.truncate(*depth),
+            f,
+        )
+        .await
+        .0
+    }
+
+    /// Отображает маски детей тем же подобием до завершения продолжения.
+    pub async fn with_mask_scale_async<R>(
+        &mut self,
+        origin: Point<Pixels>,
+        scale: f32,
+        f: impl AsyncFnOnce(&mut Self) -> R,
+    ) -> R {
+        let previous = self.mask_scale.replace((origin, scale));
+        self.with_restore_async(
+            previous,
+            |window, previous| window.mask_scale = *previous,
+            f,
+        )
+        .await
+        .0
+    }
+
+    /// Выполняет область окна с продолжением на явном стеке обхода.
+    pub async fn with_transformation_async<R>(
+        &mut self,
+        transformation: TransformationMatrix,
+        f: impl AsyncFnOnce(&mut Self) -> R,
+    ) -> R {
+        // KaminIDE patch: вложение `outer · inner` (css-transforms-1
+        // §transform-rendering: матрица предка применяется ПОСЛЕ своей; Blink
+        // GeometryMapper перемножает parent·local). Прежний `inner · outer`
+        // ломал вложенные поворот/скос (`transform-compound-001`); вертикальный
+        // `CombinedUpright` переводит свою четверть оборота в локальные точки
+        // строки (`combined_geometry::in_local_space`). При пустом стеке
+        // (`current` = unit) результат побайтно прежний: 1·a + 0·c = a.
+        let combined = self.current_transformation().compose(transformation);
+        // KaminIDE patch: обычное вложение маски не переводит — ни своё, ни
+        // унаследованное от `with_transformation_masked` снаружи: вертикальный
+        // абзац, `CombinedUpright`, стопка страниц и объёмный путь рисуются
+        // байт в байт как прежде.
+        self.with_transform_frame_async(combined, None, f).await
+    }
+
+    /// Выполняет область окна с продолжением на явном стеке обхода.
+    pub async fn with_transformation_masked_async<R>(
+        &mut self,
+        transformation: TransformationMatrix,
+        f: impl AsyncFnOnce(&mut Self) -> R,
+    ) -> R {
+        let combined = self.current_transformation().compose(transformation);
+        let r = combined.rotation_scale;
+        let keeps_axes = (r[0][1].abs() < 1e-4 && r[1][0].abs() < 1e-4)
+            || (r[0][0].abs() < 1e-4 && r[1][1].abs() < 1e-4);
+        self.with_transform_frame_async(combined, keeps_axes.then_some(combined), f)
+            .await
+    }
+
+    /// Выполняет область окна с продолжением на явном стеке обхода.
+    pub async fn paint_bottom_layer_async<R>(&mut self, f: impl AsyncFnOnce(&mut Self) -> R) -> R {
+        self.invalidator.debug_assert_paint();
+        self.next_frame.scene.push_bottom_layer();
+        self.with_restore_async((), |window, _| window.next_frame.scene.pop_layer(), f)
+            .await
+            .0
+    }
+
+    pub(super) async fn with_transform_frame_async<R>(
+        &mut self,
+        transformation: TransformationMatrix,
+        mask_map: Option<TransformationMatrix>,
+        f: impl AsyncFnOnce(&mut Self) -> R,
+    ) -> R {
+        let depth = self.transformation_stack.len();
+        self.transformation_stack.push(transformation);
+        let previous_map = mem::replace(&mut self.mask_map, mask_map);
+        self.with_restore_async(
+            (depth, previous_map),
+            |window, previous| {
+                window.transformation_stack.truncate(previous.0);
+                window.mask_map = previous.1;
+            },
+            f,
+        )
+        .await
+        .0
+    }
+
+    /// Выполняет область окна с продолжением на явном стеке обхода.
+    pub async fn with_ink_sink_async<R>(
+        &mut self,
+        sink: Rc<InkSink>,
+        f: impl AsyncFnOnce(&mut Self) -> R,
+    ) -> R {
+        self.next_frame.scene.ink.push(sink);
+        let probe = InkProbe::open(self);
+        let result = f(self).await;
+        if let Some(probe) = probe {
+            probe.close(self);
+        }
+        self.next_frame.scene.ink.pop();
+        result
+    }
+    // Геометрия слоя вычисляется одинаково для обоих способов исполнения области.
+    pub(super) fn push_paint_layer(&mut self, bounds: Bounds<Pixels>) -> bool {
+        self.invalidator.debug_assert_paint();
+
+        let content_mask = self.content_mask();
+        let clipped_bounds = bounds.intersect(&content_mask.bounds);
+        if !clipped_bounds.is_empty() {
+            // KaminIDE patch: порядок слоя считается по МЕСТУ НА ЭКРАНЕ.
+            // Внутри повёрнутого текста границы слоя до-трансформные — дерево
+            // границ видело его в чужой клетке, и фон соседа получал порядок
+            // ПОВЕРХ глифов (table-cell-align-005).
+            // KaminIDE patch: exact layer bounds, not upstream's floor/ceil
+            // cover: a layer grown to the next device pixel intersects the
+            // neighbour run's glyphs and is ordered above them (a run's
+            // background then covered the previous glyph's AA column,
+            // `inline-formatting-context-002`).
+            let mut scaled = clipped_bounds.scale(self.scale_factor());
+            let m = self.current_transformation();
+            if m != TransformationMatrix::unit() {
+                let b = scaled;
+                let corners = [
+                    (b.origin.x.0, b.origin.y.0),
+                    (b.origin.x.0 + b.size.width.0, b.origin.y.0),
+                    (b.origin.x.0, b.origin.y.0 + b.size.height.0),
+                    (
+                        b.origin.x.0 + b.size.width.0,
+                        b.origin.y.0 + b.size.height.0,
+                    ),
+                ];
+                let (mut x0, mut y0, mut x1, mut y1) = (f32::MAX, f32::MAX, f32::MIN, f32::MIN);
+                for (x, y) in corners {
+                    let tx =
+                        m.translation[0] + m.rotation_scale[0][0] * x + m.rotation_scale[0][1] * y;
+                    let ty =
+                        m.translation[1] + m.rotation_scale[1][0] * x + m.rotation_scale[1][1] * y;
+                    x0 = x0.min(tx);
+                    y0 = y0.min(ty);
+                    x1 = x1.max(tx);
+                    y1 = y1.max(ty);
+                }
+                scaled = Bounds {
+                    origin: point(ScaledPixels(x0), ScaledPixels(y0)),
+                    size: size(ScaledPixels(x1 - x0), ScaledPixels(y1 - y0)),
+                };
+            }
+            self.next_frame.scene.push_layer(scaled);
+        }
+
+        !clipped_bounds.is_empty()
+    }
+
+    /// Рисует слой, удерживая его область до завершения продолжения.
+    pub async fn paint_layer_async<R>(
+        &mut self,
+        bounds: Bounds<Pixels>,
+        f: impl AsyncFnOnce(&mut Self) -> R,
+    ) -> R {
+        let pushed = self.push_paint_layer(bounds);
+        self.with_restore_async(
+            pushed,
+            |window, pushed| {
+                if *pushed {
+                    window.next_frame.scene.pop_layer();
+                }
+            },
+            f,
+        )
+        .await
+        .0
+    }
+}
diff --git a/vendor/gpui/src/window/paint_contract.md b/vendor/gpui/src/window/paint_contract.md
new file mode 100644
index 0000000000000000000000000000000000000000..6a1794918b3be567d1fad54d7a61bb095b07e8e4
--- /dev/null
+++ b/vendor/gpui/src/window/paint_contract.md
@@ -0,0 +1,128 @@
+
+## Граница механизма и политики хозяина
+
+GPUI исполняет упорядоченные команды рисования в заданном состоянии окна.
+Хозяин определяет семантический порядок, атомарные поддеревья и нужные эффекты.
+Группа композиции — область вывода в отдельную сцену, а не семантический
+контекст хозяина. В частности, правила CSS stacking, выбор подложки текста
+и fill policy принадлежат HTML-движку.
+
+### Обязательства вызывающего и сохранение поведения
+
+- Layout и prepaint ребёнка исполняются ровно один раз на проход. Отложить
+  paint не означает повторить измерения, регистрацию hit-test или эффекты.
+  Identity hit-test, scroll/selection и порядок регистрации остаются частью
+  контракта хозяина и сверяются с окончательным paint order отдельно.
+- Отложенный ребёнок и снимок живут только в текущем проходе paint. Нельзя
+  хранить `AnyElement` между кадрами или документами.
+- Порядок исполнения задаёт хозяин. Replay сохраняет порядок команд,
+  дробные координаты и существующую растровую привязку без нового округления.
+- Задание должно завершиться внутри своей открытой композиционной группы:
+  его нельзя вынести за границу opacity, blend, clip, mask или offscreen.
+  Произвольный Element — непрозрачная граница; прозрачный адаптер явно
+  разрешает перенос ребёнка, сохраняя его окружение и область композиции.
+- Typed host contexts принадлежат окну, не глобальному потоку. Снимок
+  удерживает тот же `Rc<T>`; значения внутри него не копируются глубоко.
+  Отсутствующий тип скрывает одноимённый контекст вызывающего на время replay.
+
+### Снимки и проверяемый replay
+
+`paint_ctx` сохраняет element/entity ids, text style, typed host contexts,
+element offsets и глубину exact offsets, transformation stack, mask scale/map,
+opacity, content masks и image caches. `raster_paint_ctx` дополнительно сохраняет
+весь `RasterFrame`: glyph offset, actual/exact fill transforms, rounded/exact
+bounds и непрозрачные typed host raster data. Обычный `PaintCtx` этих полей
+не содержит; общий replay наследует frame вызывающего. `RasterPaintCtx` позволяет
+вызывающему явно выбрать fill transform перед replay.
+
+`snapshot_paint_state` сохраняет все эти поля, включая generic `RasterFrame`,
+точную fill matrix, device scale и стек rem overrides. `with_raster_frame` принимает явные placement
+и unsnapped fill transforms, не выбирая подложку или CSS policy. Существующий
+общий consumer наследует raster state вызывающего; inline consumer сохраняет
+прежний набор glyph/background полей и наследует fill transform. Все три пути
+исполняются одним механизмом replay и не меняют layout/prepaint или paint order.
+
+`with_raster_context` временно заменяет только один типизированный слот этого
+же frame и восстанавливает его через общий guard, включая unwind. Остальные
+host values и raster-геометрия сохраняются без клонирования всей карты.
+`ChildPaintContext` заимствуется только на время callback; хозяин завершает
+выбор геометрии перед рекурсивным рисованием детей.
+
+Replay проверяет identity окна, прохода и живой композиционной области до
+изменения состояния и вызова closure. `PaintError` различает чужое окно/проход,
+завершённый проход, другую открытую и уже закрытую группу; fallback нет.
+`PaintPassId` и `PaintScopeId` не продлевают жизнь области при клонировании.
+Prepaint и paint одного draw разделяют pass; изолированные effect/plane/capture
+сцены имеют собственные scope. Transform/clip сохраняются в снимке, поэтому
+их лексическое закрытие само по себе не запрещает отложенный replay.
+
+Guards восстанавливают caller environment, typed contexts и raster state также
+при unwind; scopes геометрии и scene swaps используют тот же Drop-механизм.
+Unwind помечает проход недействительным: продолжать частично нарисованный кадр
+нельзя. Внешний draw при abort очищает незавершённый frame и возвращает внешнее
+окружение. HTML coordinator владеет очередями прохода и освобождает их через Drop,
+в том числе при пойманном unwind. Глобального reset нет.
+
+### Capture и instrumentation
+
+`Window::set_frame_capture` передаёт backend единственный `FrameCaptureSink`
+этого окна без клонирования. Backend доставляет завершённые BGRA pixels и
+длительность readback. Хозяин владеет сессией, sequence, подписками и выбором
+first/latest; endpoint не смешивает кадры разных окон. Замена или уничтожение
+endpoint закрывает сессию и завершает ожидающие подписки. Readiness и выбор
+результата принадлежат WPT, а не renderer. Production offscreen scene остаётся
+общим механизмом GPUI/backend и не зависит от подписок на оконные кадры.
+
+`Application::with_instrumentation` принимает типизированные настройки хозяина
+до запуска платформы. Измерения prepaint и GPU принадлежат приложению и явно
+передаются backend, включая пересоздание устройства. Toolkit не разбирает
+диагностические переменные окружения.
+
+### Инварианты scoped API
+
+- frame-local pass token идентифицирует окно и кадр; scope token дополнительно
+  идентифицирует открытую композиционную область, включая offscreen capture;
+- snapshot включает всё окружение рисования, generic raster frame, typed host
+  contexts и entity/id environment; raster frame хранит исходную дробную
+  геометрию и device grid, а не решение хозяина о подложке текста;
+- replay принимает только token того же окна, кадра и открытой группы;
+  несовпадение возвращает типизированную ошибку без fallback на прямой paint;
+- clip/transform/effect scopes исполняются в порядке вызова, не пересортировывают
+  jobs и не пропускают отложенную работу через свою границу;
+- guards восстанавливают полное внешнее состояние при unwind. Abort уничтожает
+  текущий проход, освобождает jobs и не загрязняет следующий документ/кадр;
+- очередь jobs принадлежит хозяину; стабильная ограниченная сортировка и
+  однократное исполнение не требуют знания CSS внутри GPUI. Нельзя вводить
+  повторный minimum scan или бесконечный drain при добавлении новых jobs.
+
+Проверки HTML фиксируют порядок текущих consumers, nested scopes, identity
+contexts, raster origin, отклонение неверного replay и восстановление после abort.
+CSS очередь живёт в HTML coordinator, который задаёт порядок child visitor
+внутри прежних scopes GPUI. Opaque boundary guard и метаданные прозрачных
+holders являются общими hooks; GPUI их не интерпретирует. Text-background
+и fill policy принадлежат HTML. GPUI передаёт host callback геометрию и
+непрозрачные метаданные без интерпретации; snapshot не принимает решений хозяина.
+
+### Immutable command records
+
+`Window::record_paint(source_clip, cx, paint)` consumes source painting once.
+The explicit source clip replaces the ambient fragment clip before culling.
+An optional host `PaintRecording` lifecycle opens and finishes its own deferred
+work inside capture; guard destruction restores or aborts host state.
+No element or callback is retained by `PaintRecord` or `PaintPlan`.
+
+A record shares immutable canonical Scene commands and frame-local resources.
+It outlives its capture scope, but only in the same live window/draw and raster
+scale. This does not relax snapshot checks: PaintState/PaintCtx still require
+their original live composition scope. Stale identity or invalid placement is
+a typed error before destination writes.
+
+The host composes ordered records and explicit Clip/Group descriptors, including
+shared effect ancestors. GPUI does not choose CSS order, source identity,
+fragment scheduling, layout generation or hit geometry. Plan playback accepts
+no App and invokes no element/host callback. Each invocation adopts fresh group
+ids through the existing compositor. Source transforms/raster positions remain
+resolved; an explicit source-to-destination translation moves commands once.
+The final destination clip follows effects, preserving off-clip filter inputs.
+Pending plane contexts, raster state and host contexts are restored on return
+or unwind; an abort invalidates the draw rather than granting replay rights.
