+//! KaminIDE patch: локальный выбор LCD только для известной непрозрачной поверхности.
+
+use super::{
+    FontId, Pixels, TextRenderingMode, TransformationMatrix, Window, WindowBackgroundAppearance,
+};
+
+impl Window {
+    pub(super) fn should_use_subpixel_rendering(
+        &self,
+        font_id: FontId,
+        font_size: Pixels,
+        pixel_exact: bool,
+    ) -> bool {
+        if !lcd_surface_is_safe(
+            self.platform_window.background_appearance(),
+            self.next_frame.scene.in_group,
+            pixel_exact,
+            self.current_transformation(),
+        ) || !self.platform_window.is_subpixel_rendering_supported()
+        {
+            return false;
+        }
+
+        let mode = match self.text_rendering_mode.get() {
+            TextRenderingMode::PlatformDefault => self
+                .text_system()
+                .recommended_rendering_mode(font_id, font_size),
+            mode => mode,
+        };
+
+        mode == TextRenderingMode::Subpixel
+    }
+}
+
+fn lcd_surface_is_safe(
+    appearance: WindowBackgroundAppearance,
+    isolated: bool,
+    pixel_exact: bool,
+    transformation: TransformationMatrix,
+) -> bool {
+    // LCD blend сохраняет destination alpha: прозрачный intermediate не получает
+    // покрытия глифа. Записанная сцена также может позже попасть в такую группу.
+    // Alpha кисти на opaque root безопасна: она ослабляет RGB coverage, а не фон.
+    appearance == WindowBackgroundAppearance::Opaque
+        && !isolated
+        && !pixel_exact
+        // RGB-полосы должны совпадать с физическими пикселями после композиции.
+        && transformation.rotation_scale == TransformationMatrix::unit().rotation_scale
+        && transformation.translation.iter().all(|v| v.is_finite() && v.fract() == 0.0)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn opaque_root_allows_lcd_but_transparent_backdrops_do_not() {
+        for appearance in [
+            WindowBackgroundAppearance::Opaque,
+            WindowBackgroundAppearance::Transparent,
+            WindowBackgroundAppearance::Blurred,
+            WindowBackgroundAppearance::MicaBackdrop,
+            WindowBackgroundAppearance::MicaAltBackdrop,
+        ] {
+            assert_eq!(
+                lcd_surface_is_safe(appearance, false, false, TransformationMatrix::unit()),
+                appearance == WindowBackgroundAppearance::Opaque,
+            );
+        }
+    }
+
+    #[test]
+    fn isolated_scenes_and_exact_fonts_always_use_grayscale() {
+        for (isolated, pixel_exact) in [(true, false), (false, true), (true, true)] {
+            assert!(!lcd_surface_is_safe(
+                WindowBackgroundAppearance::Opaque,
+                isolated,
+                pixel_exact,
+                TransformationMatrix::unit(),
+            ));
+        }
+    }
+
+    #[test]
+    fn only_pixel_aligned_translation_preserves_lcd_stripes() {
+        let safe =
+            |matrix| lcd_surface_is_safe(WindowBackgroundAppearance::Opaque, false, false, matrix);
+        let mut matrix = TransformationMatrix::unit();
+        matrix.translation = [-12.0, 34.0];
+        assert!(safe(matrix));
+        for translation in [
+            [0.5, 0.0],
+            [0.0, -0.25],
+            [f32::NAN, 0.0],
+            [0.0, f32::INFINITY],
+        ] {
+            matrix.translation = translation;
+            assert!(!safe(matrix));
+        }
+        for rotation_scale in [
+            [[2.0, 0.0], [0.0, 2.0]],
+            [[0.0, -1.0], [1.0, 0.0]],
+            [[1.0, 0.25], [0.0, 1.0]],
+            [[-1.0, 0.0], [0.0, 1.0]],
+        ] {
+            matrix = TransformationMatrix::unit();
+            matrix.rotation_scale = rotation_scale;
+            assert!(!safe(matrix));
+        }
+    }
+}
diff --git a/vendor/gpui/src/window/text_style_scope.rs b/vendor/gpui/src/window/text_style_scope.rs
new file mode 100644
index 0000000000000000000000000000000000000000..8d16d84961fd4d691ad521a17d5560dde463a78c
--- /dev/null
+++ b/vendor/gpui/src/window/text_style_scope.rs
@@ -0,0 +1,110 @@
+//! KaminIDE patch: the inherited text style refinements as a shared persistent
+//! list. A push links one refinement to the current scope; capturing a scope for
+//! a deferred draw, a paint snapshot or a measure callback is one `Rc` clone.
+
+use super::*;
+
+/// The text style refinements in force, outermost first (see
+/// [`Window::text_style`]). Cloning shares the list.
+#[derive(Clone, Default)]
+pub struct TextStyleScope(Option<Rc<Link>>);
+
+struct Link {
+    style: TextStyleRefinement,
+    parent: TextStyleScope,
+    depth: usize,
+}
+
+impl TextStyleScope {
+    /// KaminIDE patch: the same scope (the same chain of links).
+    pub(crate) fn same(&self, other: &Self) -> bool {
+        match (&self.0, &other.0) {
+            (Some(a), Some(b)) => Rc::ptr_eq(a, b),
+            (None, None) => true,
+            _ => false,
+        }
+    }
+
+    /// This scope with `style` applied innermost.
+    pub(crate) fn push(&self, style: TextStyleRefinement) -> Self {
+        Self(Some(Rc::new(Link {
+            style,
+            parent: self.clone(),
+            depth: self.len() + 1,
+        })))
+    }
+
+    /// The number of refinements.
+    pub fn len(&self) -> usize {
+        self.0.as_ref().map_or(0, |link| link.depth)
+    }
+
+    /// Whether no refinement applies.
+    pub fn is_empty(&self) -> bool {
+        self.0.is_none()
+    }
+
+    /// Apply the refinements, outermost first, onto `style`.
+    pub(crate) fn refine(&self, style: &mut TextStyle) {
+        let mut links: SmallVec<[&TextStyleRefinement; 16]> = SmallVec::with_capacity(self.len());
+        let mut at = self.0.as_deref();
+        while let Some(link) = at {
+            links.push(&link.style);
+            at = link.parent.0.as_deref();
+        }
+        for refinement in links.into_iter().rev() {
+            style.refine(refinement);
+        }
+    }
+}
+
+impl Drop for TextStyleScope {
+    // Unlink iteratively: a deep document must not recurse once per level.
+    fn drop(&mut self) {
+        let mut next = self.0.take();
+        while let Some(link) = next {
+            next = match Rc::try_unwrap(link) {
+                Ok(mut link) => link.parent.0.take(),
+                Err(_) => None,
+            };
+        }
+    }
+}
+
+/// The context a measure callback was requested in: the requesting element's
+/// inherited text style and rem size. Taffy calls measure functions during
+/// the root's layout, after those scopes were popped; elements a callback
+/// builds for probing must still see them.
+#[derive(Clone)]
+pub(crate) struct MeasureScope {
+    text: TextStyleScope,
+    rem: Pixels,
+}
+
+impl Window {
+    pub(crate) fn measure_scope(&self) -> MeasureScope {
+        MeasureScope {
+            text: self.text_style_stack.clone(),
+            rem: self.rem_size(),
+        }
+    }
+}
+
+impl MeasureScope {
+    /// Run `f` (one measure callback) in this scope, then restore the window's.
+    pub(crate) fn enter<R>(&self, window: &mut Window, f: impl FnOnce(&mut Window) -> R) -> R {
+        let text = std::mem::replace(&mut window.text_style_stack, self.text.clone());
+        let depth = window.rem_size_override_stack.len();
+        window.rem_size_override_stack.push(self.rem);
+        window
+            .with_restore(
+                (text, depth),
+                |window, (text, depth)| {
+                    window.text_style_stack = std::mem::take(text);
+                    window.rem_size_override_stack.truncate(*depth);
+                },
+                f,
+            )
+            .0
+    }
+}
diff --git a/vendor/gpui/src/window/update_rendering.rs b/vendor/gpui/src/window/update_rendering.rs
new file mode 100644
index 0000000000000000000000000000000000000000..9519ec3c7b2f73b4c379a9e57426a4aee496bcce
--- /dev/null
+++ b/vendor/gpui/src/window/update_rendering.rs
@@ -0,0 +1,180 @@
+//! KaminIDE patch: the document step before a frame and layout passes
+//! between frames.
+//!
+//! A host lays out its content before `Window::draw` paints it (HTML "update
+//! the rendering": style and layout run before paint, and synchronous
+//! geometry reads of scripts run between frames). Two passes:
+//! - the frame step (`Window::with_layout_outside_draw`), run by the
+//!   observers of `Window::on_update_rendering` at the start of every draw:
+//!   its elements, layout nodes, shaped lines and element states belong to
+//!   the frame that follows, exactly as if they were made in its prepaint;
+//! - a read (`Window::with_layout_read`), between frames and without one:
+//!   nothing it makes outlives it except the element states it moved, which
+//!   the next frame takes before those of the drawn frame.
+
+use super::{DrawPhase, ElementArenaScope, ElementIdContext, ElementStateBox, Window};
+use crate::{App, EntityId, GlobalElementId, Subscription};
+use collections::FxHashMap;
+use std::any::TypeId;
+
+/// Element states moved by reads between frames, taken by the next frame.
+#[derive(Default)]
+pub(crate) struct ReadStates {
+    /// A read is running: element states go to `states`.
+    pub(crate) active: bool,
+    pub(crate) states: FxHashMap<(GlobalElementId, TypeId), ElementStateBox>,
+}
+
+/// Where an element stands in the frame: the ids of its ancestors and its own
+/// (the element id stack) and the view rendering it. A pass outside of the
+/// draw that builds elements for that place enters it, so their ids, states
+/// and view are those the frame gives them.
+#[derive(Clone, Debug, Default, PartialEq)]
+pub struct ElementPlace {
+    ids: ElementIdContext,
+    view: Option<EntityId>,
+}
+
+impl ElementPlace {
+    /// The place of the root element of `view`'s render: the view's id on
+    /// the stack, the view rendering.
+    pub fn of_view(view: EntityId) -> Self {
+        Self {
+            ids: ElementIdContext(std::rc::Rc::from([crate::ElementId::View(view)].as_slice())),
+            view: Some(view),
+        }
+    }
+
+}
+
+impl Window {
+    /// Snapshot the current element ancestry and rendering view for a later layout step.
+    /// KaminIDE patch: embedded hosts must preserve ancestor IDs, not only their own view.
+    pub fn element_place(&self) -> ElementPlace {
+        ElementPlace {
+            ids: self.element_id_context(),
+            view: self.rendered_entity_stack.last().copied(),
+        }
+    }
+
+    /// The element being laid out, prepainted or painted now (its own id on
+    /// top of the stack) stands directly under `parent`. Allocates nothing.
+    pub fn element_stands_under(&self, parent: &ElementPlace) -> bool {
+        let ids = &*parent.ids.0;
+        self.rendered_entity_stack.last().copied() == parent.view
+            && self.element_id_stack.len() == ids.len() + 1
+            && self.element_id_stack[..ids.len()] == *ids
+    }
+
+    /// Run `f` at `place`: its id stack and view (the stack is inline up to
+    /// its capacity, so entering a place does not allocate).
+    fn with_element_place<R>(&mut self, place: &ElementPlace, f: impl FnOnce(&mut Self) -> R) -> R {
+        let mut stack: smallvec::SmallVec<[crate::ElementId; 32]> =
+            place.ids.0.iter().cloned().collect();
+        std::mem::swap(&mut self.element_id_stack, &mut stack);
+        let (result, _) = self.with_restore(
+            stack,
+            |window, outer| std::mem::swap(&mut window.element_id_stack, outer),
+            |window| match place.view {
+                Some(view) => window.with_rendered_view(view, f),
+                None => f(window),
+            },
+        );
+        result
+    }
+
+    /// Register `f` to run at the start of every draw, before its paint pass
+    /// (outside of the draw phases): the host's step that styles and lays
+    /// out its content for the frame (`with_layout_outside_draw`).
+    pub fn on_update_rendering(
+        &self,
+        mut f: impl FnMut(&mut Window, &mut App) + 'static,
+    ) -> Subscription {
+        let (subscription, activate) = self.update_rendering_observers.insert(
+            (),
+            Box::new(move |window, cx| {
+                f(window, cx);
+                true
+            }),
+        );
+        activate();
+        subscription
+    }
+
+    pub(crate) fn update_rendering(&mut self, cx: &mut App) {
+        self.update_rendering_observers
+            .clone()
+            .retain(&(), |observer| observer(self, cx));
+    }
+
+    /// Lay out in `f` for the frame that follows, before its draw, at `place`
+    /// (`element_place` of the frame that drew the element): elements
+    /// go to the app's frame arena (that draw clears it) and layout nodes to
+    /// the window's engine, as if `f` ran in the frame's prepaint.
+    pub fn with_layout_outside_draw<R>(
+        &mut self,
+        place: &ElementPlace,
+        cx: &mut App,
+        f: impl FnOnce(&mut Window, &mut App) -> R,
+    ) -> R {
+        let idle = self.invalidator.not_drawing();
+        if !idle {
+            return f(self, cx);
+        }
+        self.invalidator.set_phase(DrawPhase::Prepaint);
+        let arena = ElementArenaScope::enter(&cx.element_arena);
+        let result = self.with_element_place(place, |window| f(window, cx));
+        // The frame's own draw clears the arena after painting these elements.
+        let _owed_by_the_draw = arena.exit(&cx.element_arena);
+        self.invalidator.set_phase(DrawPhase::None);
+        result
+    }
+
+    /// Lay out in `f` between frames for a read at `place`: elements in a private arena
+    /// released on return, an independent layout engine, the line caches
+    /// sealed (no growth, no lines lost for the next frame), element states
+    /// set aside for the next frame. Only numbers may escape `f`.
+    pub fn with_layout_read<R>(
+        &mut self,
+        place: &ElementPlace,
+        cx: &mut App,
+        f: impl FnOnce(&mut Window, &mut App) -> R,
+    ) -> R {
+        assert!(
+            self.invalidator.not_drawing() && !self.read_states.active,
+            "a layout read runs between frames"
+        );
+        self.invalidator.set_phase(DrawPhase::Prepaint);
+        self.read_states.active = true;
+        let result = super::with_temporary_element_arena(|| {
+            crate::text_system::with_layouts_sealed(|| {
+                self.with_nested_layout(|window| window.with_element_place(place, |w| f(w, cx)))
+            })
+        });
+        self.read_states.active = false;
+        self.invalidator.set_phase(DrawPhase::None);
+        result
+    }
+
+    /// Bounds of every laid out node of the subtree `root` in the active
+    /// engine, depth first, relative to the layout root: two passes placed a
+    /// subtree the same if they give equal lists.
+    pub fn subtree_layout_bounds(&mut self, root: crate::LayoutId) -> Vec<crate::Bounds<crate::Pixels>> {
+        let scale = self.scale_factor();
+        self.layout_engine
+            .as_mut()
+            .map(|engine| engine.subtree_bounds(root, scale))
+            .unwrap_or_default()
+    }
+
+    /// What layout passes leave between frames: values in the app's frame
+    /// arena, line layouts in the frame caches, element states set aside by
+    /// reads for the next frame.
+    pub fn layout_footprint(&self, cx: &App) -> (usize, usize, usize) {
+        (
+            cx.element_arena.borrow().allocations(),
+            self.text_system().cached_line_layouts(),
+            self.read_states.states.len(),
+        )
+    }
+}
diff --git a/vendor/gpui/src/window/vector_transform.rs b/vendor/gpui/src/window/vector_transform.rs
new file mode 100644
index 0000000000000000000000000000000000000000..0d44e43fe4669f31e3562caaf33e653a1c354573
--- /dev/null
+++ b/vendor/gpui/src/window/vector_transform.rs
@@ -0,0 +1,132 @@
+//! Явная презентационная матрица воспроизведения записей (лист стопки страниц): векторные
+//! команды переносятся точным подобием до растеризации и композиции. Вне scope запись
+//! воспроизводится как прежде: преобразования вызывающего не применяются повторно.
+
+use super::*;
+
+/// Exact axis-preserving similarity in device pixels: positive uniform scale,
+/// clockwise quarter-turns and a translation.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub(crate) struct VectorTransform {
+    scale: f32,
+    quarter_turns: u8,
+    translation: [f32; 2],
+}
+
+impl VectorTransform {
+    /// Decompose a device-space matrix; `None` unless it is an exact similarity
+    /// that keeps the axes (vector masks stay axis-aligned rectangles).
+    pub(crate) fn from_matrix(m: TransformationMatrix) -> Option<Self> {
+        let [[a, b], [c, d]] = m.rotation_scale;
+        let near = |x: f32, y: f32| (x - y).abs() <= 1e-5 * x.abs().max(y.abs()).max(1.0);
+        let (scale, quarter_turns) = if near(b, 0.) && near(c, 0.) && near(a, d) {
+            (a.abs(), if a > 0. { 0 } else { 2 })
+        } else if near(a, 0.) && near(d, 0.) && near(b, -c) {
+            (c.abs(), if c > 0. { 1 } else { 3 })
+        } else {
+            return None;
+        };
+        (scale.is_finite() && scale > 0. && (1. / scale).is_finite()
+            && m.translation.iter().all(|v| v.is_finite()))
+            .then_some(Self { scale, quarter_turns, translation: m.translation })
+    }
+
+    /// Positive uniform scale.
+    pub(crate) fn scale(self) -> f32 { self.scale }
+    /// Number of clockwise quarter-turns, in `0..4`.
+    pub(crate) fn quarter_turns(self) -> u8 { self.quarter_turns }
+
+    pub(crate) fn matrix(self) -> TransformationMatrix {
+        let s = self.scale;
+        let rotation_scale = match self.quarter_turns {
+            1 => [[0., -s], [s, 0.]], 2 => [[-s, 0.], [0., -s]],
+            3 => [[0., s], [-s, 0.]], _ => [[s, 0.], [0., s]],
+        };
+        TransformationMatrix { rotation_scale, translation: self.translation }
+    }
+
+    pub(crate) fn inverse_matrix(self) -> TransformationMatrix {
+        let s = 1.0 / self.scale;
+        let rotation_scale = match self.quarter_turns {
+            1 => [[0., s], [-s, 0.]], 2 => [[-s, 0.], [0., -s]],
+            3 => [[0., -s], [s, 0.]], _ => [[s, 0.], [0., s]],
+        };
+        let mut inverse = TransformationMatrix { rotation_scale, translation: [0.; 2] };
+        let p = inverse.apply(point(px(-self.translation[0]), px(-self.translation[1])));
+        inverse.translation = [p.x.0, p.y.0];
+        inverse
+    }
+
+    /// Exact image of an axis-aligned logical rectangle at device scale `density`.
+    pub(crate) fn bounds(self, b: Bounds<Pixels>, density: f32) -> Bounds<Pixels> {
+        let m = self.matrix();
+        let a = m.apply(point(b.origin.x * density, b.origin.y * density));
+        let z = m.apply(point(b.right() * density, b.bottom() * density));
+        Bounds::new(
+            point(a.x.min(z.x) / density, a.y.min(z.y) / density),
+            size((z.x - a.x).abs() / density, (z.y - a.y).abs() / density),
+        )
+    }
+}
+
+/// Logical image of `b` under the device presentation `m`.
+pub(crate) fn presented_bounds(m: TransformationMatrix, b: Bounds<Pixels>, density: f32) -> Bounds<Pixels> {
+    if let Some(exact) = VectorTransform::from_matrix(m) {
+        return exact.bounds(b, density);
+    }
+    let d = crate::scene::affine_transform::placed(b.scale(density), &m);
+    Bounds::new(
+        point(px(d.origin.x.0 / density), px(d.origin.y.0 / density)),
+        size(px(d.size.width.0 / density), px(d.size.height.0 / density)),
+    )
+}
+
+/// A frozen scene under the device presentation `m` (non-singular).
+pub(crate) fn present(scene: Scene, m: TransformationMatrix) -> Scene {
+    match (VectorTransform::from_matrix(m), m.inverse()) {
+        (Some(exact), _) => scene.transform_vector(exact),
+        (None, Some(inverse)) => scene.transform_affine(m, inverse),
+        (None, None) => scene,
+    }
+}
+
+/// Device-space presentation matrix (non-singular).
+struct Presentation(TransformationMatrix);
+
+impl Window {
+    /// Replay immutable records inside `paint` under `matrix` (logical pixels): the
+    /// presentation transform of a page sheet, or the transform of the copy that
+    /// replays a record. Only `paint_plan` reads it; live paint and capture are
+    /// unaffected, and without this scope a caller's transform is never applied.
+    /// Nested scopes compose (outer after inner). An exact axis-preserving similarity
+    /// moves every vector command exactly; any other affine matrix is applied with
+    /// live-paint parity (primitives compose it like `with_transformation`, masks move
+    /// only when the axes are kept, like `with_transformation_masked`). A singular or
+    /// non-finite matrix enters nothing and returns `InvalidGeometry`.
+    pub fn with_paint_presentation<R>(
+        &mut self,
+        matrix: TransformationMatrix,
+        paint: impl FnOnce(&mut Self) -> R,
+    ) -> Result<R, PaintRecordError> {
+        let scale = self.scale_factor();
+        let device = TransformationMatrix {
+            rotation_scale: matrix.rotation_scale,
+            translation: [matrix.translation[0] * scale, matrix.translation[1] * scale],
+        };
+        let device = match self.paint_presentation() {
+            Some(outer) => outer.compose(device),
+            None => device,
+        };
+        if !device.translation.iter().chain(device.rotation_scale.iter().flatten()).all(|v| v.is_finite())
+            || device.inverse().is_none()
+        {
+            return Err(PaintRecordError::InvalidGeometry);
+        }
+        let _scope = self.render_contexts.enter(Some(Rc::new(Presentation(device))));
+        Ok(paint(self))
+    }
+
+    pub(crate) fn paint_presentation(&self) -> Option<TransformationMatrix> {
+        self.render_contexts.get::<Presentation>().map(|value| value.0)
+    }
+}
