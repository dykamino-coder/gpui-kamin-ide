+/// A styled run of text, for use in [`crate::TextLayout`].
+#[derive(Clone, Debug, PartialEq, Eq, Default)]
+pub struct TextRun {
+    /// A number of utf8 bytes
+    pub len: usize,
+    /// The font to use for this run.
+    pub font: Font,
+    /// The color
+    pub color: Hsla,
+    /// The background color (if any)
+    pub background_color: Option<Hsla>,
+    /// KaminIDE patch: свой кегль прогона (`font-size` у `<span>` в строке).
+    ///
+    /// `None` — кегль всего блока. Без этого поля кусок другого размера
+    /// нельзя было положить в общий текстовый блок.
+    pub font_size: Option<Pixels>,
+    /// KaminIDE patch: поля вокруг фона прогона (`padding` строчного бокса).
+    ///
+    /// У строчного бокса CSS нет коробки: фон тянется по строкам и рвётся на
+    /// переносах. Прогон это умеет, но рисовал фон впритык к глифам, и
+    /// подсветка выходила уже браузерной.
+    pub background_pad: [Pixels; 4],
+    /// KaminIDE patch: скругление фона прогона (`border-radius`).
+    pub background_radius: Pixels,
+    /// KaminIDE patch: рамка строчного бокса (цвет, толщина).
+    pub background_border: Option<(Hsla, [Pixels; 4])>,
+    /// KaminIDE patch: the inline background band of a font with a line gap
+    /// metric spans ascent + descent + line gap, each rounded to whole pixels
+    /// (the HTML engine's inline box content area). `false` (IDE text) keeps
+    /// the band at ascent + descent.
+    pub background_line_gap: bool,
+    /// KaminIDE patch: the box whose band the run paints (the host's node
+    /// number of an inline box; 0 for none). Each piece of the band is that
+    /// box's run in a scene layer (`Window::with_run`) and its fill a
+    /// background value bound to it, so the box's fragments over all lines
+    /// are one owner's runs (`LayerHandle::set_backgrounds`).
+    pub background_owner: u32,
+    /// The underline style (if any)
+    pub underline: Option<UnderlineStyle>,
+    /// The strikethrough style (if any)
+    pub strikethrough: Option<StrikethroughStyle>,
+}
