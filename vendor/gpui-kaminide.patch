+    }
+
+    #[test]
+    fn test_sibling_nested_groups() {
+        TabStopMapTest::new()
+            .tab_stop(0, 0)
+            .tab_stop(1, 1)
+            .tab_group(2, |builder| {
+                builder
+                    .tab_stop(0, 2)
+                    .tab_stop(2, 5)
+                    .tab_group(1, |builder| builder.tab_stop(0, 3).tab_stop(1, 4))
+                    .tab_group(3, |builder| builder.tab_stop(0, 6).tab_stop(1, 7))
+            })
+            .tab_stop(3, 8)
+            .tab_stop(4, 9)
+            .assert();
+    }
+
+    #[test]
+    fn test_sibling_nested_groups_out_of_order() {
