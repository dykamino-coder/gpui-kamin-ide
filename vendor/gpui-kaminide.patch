--- /dev/null
+++ b/vendor/gpui/src/taffy/alignment_adapter.rs
@@ -0,0 +1,73 @@
+//! Fold GPUI legacy flags into native Taffy alignment and balanced wrapping.
+//! Existing HTML writing-mode projection remains physical and defaults to Ltr.
+use taffy::{AlignContent, AlignItems, AlignmentSafety, FlexWrap};
+
+pub(super) fn items(value: Option<AlignItems>, safe: bool) -> Option<AlignItems> {
+    value.map(|mut alignment| {
+        if safe {
+            alignment.safety = AlignmentSafety::Safe;
+        }
+        alignment
+    })
+}
+
+pub(super) fn content(value: Option<AlignContent>, safe: bool) -> Option<AlignContent> {
+    value.map(|mut alignment| {
+        if safe {
+            alignment.safety = AlignmentSafety::Safe;
+        }
+        alignment
+    })
+}
+
+pub(super) fn flex_wrap(value: FlexWrap, minimum_lines: u16) -> FlexWrap {
+    if minimum_lines == 0 {
+        return value;
+    }
+    match value {
+        FlexWrap::Wrap => FlexWrap::Balance,
+        FlexWrap::WrapReverse => FlexWrap::BalanceReverse,
+        other => other,
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn absent_alignment_preserves_normal_fallback() {
+        assert_eq!(items(None, true), None);
+        assert_eq!(content(None, true), None);
+    }
+    #[test]
+    fn safety_preserves_the_first_and_last_baseline_keywords() {
+        assert_eq!(
+            items(Some(AlignItems::BASELINE), true).unwrap().keyword,
+            AlignItems::BASELINE.keyword
+        );
+        assert_eq!(
+            items(Some(AlignItems::LAST_BASELINE), true)
+                .unwrap()
+                .keyword,
+            AlignItems::LAST_BASELINE.keyword
+        );
+        assert_eq!(
+            items(Some(AlignItems::END), true).unwrap().safety,
+            AlignmentSafety::Safe
+        );
+        assert_eq!(
+            content(Some(AlignContent::CENTER), false),
+            Some(AlignContent::CENTER)
+        );
+    }
+    #[test]
+    fn balancing_preserves_reverse_and_nowrap_semantics() {
+        assert_eq!(flex_wrap(FlexWrap::Wrap, 3), FlexWrap::Balance);
+        assert_eq!(
+            flex_wrap(FlexWrap::WrapReverse, 3),
+            FlexWrap::BalanceReverse
+        );
+        assert_eq!(flex_wrap(FlexWrap::NoWrap, 3), FlexWrap::NoWrap);
+        assert_eq!(flex_wrap(FlexWrap::WrapReverse, 0), FlexWrap::WrapReverse);
+    }
+}
diff --git a/vendor/gpui/src/taffy/box_edges.rs b/vendor/gpui/src/taffy/box_edges.rs
new file mode 100644
index 0000000000000000000000000000000000000000..c6f0330ea1d8b0d2e77496ff44155e0272552f23
--- /dev/null
+++ b/vendor/gpui/src/taffy/box_edges.rs
@@ -0,0 +1,94 @@
+//! KaminIDE patch: использованные кромки родителя для фоновых слоёв.
+//! Процентный padding уже разрешён раскладкой относительно containing block.
+
+use super::*;
+
+impl TaffyLayoutEngine {
+    /// Used border and padding of the parent, in unrounded logical pixels.
+    /// Absolute paint layers must not resolve CSS percentages a second time.
+    pub fn parent_box_edges(
+        &self,
+        child: LayoutId,
+        scale_factor: f32,
+    ) -> Option<(Edges<Pixels>, Edges<Pixels>)> {
+        let parent = self.taffy.parent(child.into())?;
+        let layout = self.taffy.layout(parent).ok()?;
+        let logical = |r: TaffyRect<f32>| Edges {
+            top: Pixels(r.top / scale_factor),
+            right: Pixels(r.right / scale_factor),
+            bottom: Pixels(r.bottom / scale_factor),
+            left: Pixels(r.left / scale_factor),
+        };
+        Some((logical(layout.border), logical(layout.padding)))
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::px;
+    use taffy::prelude::TaffyMaxContent;
+
+    #[test]
+    fn overlay_reads_used_parent_edges_with_percentage_padding_and_scale() {
+        use taffy::style_helpers::{length, percent};
+        for scale in [1.0, 1.25, 2.0] {
+            let mut engine = TaffyLayoutEngine::new();
+            let overlay = engine
+                .taffy
+                .new_leaf(taffy::Style {
+                    position: taffy::Position::Absolute,
+                    ..Default::default()
+                })
+                .unwrap();
+            let parent = engine
+                .taffy
+                .new_with_children(
+                    taffy::Style {
+                        box_sizing: taffy::BoxSizing::ContentBox,
+                        size: taffy::Size {
+                            width: length(100.0 * scale),
+                            height: length(50.0 * scale),
+                        },
+                        padding: taffy::Rect {
+                            top: percent(0.1),
+                            right: percent(0.1),
+                            bottom: percent(0.1),
+                            left: percent(0.1),
+                        },
+                        border: taffy::Rect {
+                            top: length(3.0 * scale),
+                            right: length(3.0 * scale),
+                            bottom: length(3.0 * scale),
+                            left: length(3.0 * scale),
+                        },
+                        ..Default::default()
+                    },
+                    &[overlay],
+                )
+                .unwrap();
+            let root = engine
+                .taffy
+                .new_with_children(
+                    taffy::Style {
+                        display: taffy::Display::Block,
+                        size: taffy::Size {
+                            width: length(400.0 * scale),
+                            height: length(300.0 * scale),
+                        },
+                        ..Default::default()
+                    },
+                    &[parent],
+                )
+                .unwrap();
+            engine
+                .taffy
+                .compute_layout(root, taffy::Size::MAX_CONTENT)
+                .unwrap();
+            let (border, padding) = engine.parent_box_edges(overlay.into(), scale).unwrap();
+            assert_eq!(border, Edges::all(px(3.0)));
+            assert_eq!(padding, Edges::all(px(40.0)));
+            assert_eq!(engine.parent_box_edges(root.into(), scale), None);
+        }
+    }
+}
