+/// KaminIDE patch: сортировка плоскостей объёмного контекста по глубине
+/// (css-transforms-2 §3d-transform-rendering: элементы одного контекста
+/// рисуются в порядке z, а не в порядке документа).
+///
+/// Порядок примитива назначается при вставке деревом границ, и ребёнок,
+/// нарисованный после фона родителя, иначе под него не ляжет. Каждый
+/// примитив контекста помечается плоскостью, а на выходе из корня контекста
+/// номера порядка переписываются: плоскости от дальней к ближней (ничья —
+/// по документу), внутри плоскости — прежний порядок.
+#[derive(Default)]
+struct DepthSort {
+    contexts: Vec<DepthContext>,
+    /// Глубина каждой плоскости кадра (больше — ближе к зрителю).
+    planes: Vec<f32>,
+    plane_stack: Vec<u32>,
+    /// (вид примитива, индекс в его списке, плоскость).
+    tags: Vec<(u8, u32, u32)>,
+}
+
+struct DepthContext {
+    tags_start: usize,
+    planes_start: usize,
+    /// Плоскость объемлющего контекста, в которую контекст сплющивается.
+    outer_plane: Option<u32>,
+    plane_depth: usize,
+    union: Option<Bounds<ScaledPixels>>,
+}
+
+#[expect(missing_docs)]
+impl Scene {
+    /// KaminIDE patch: начать объёмный контекст.
+    pub fn push_depth_context(&mut self) {
+        self.paint_operations.push(PaintOperation::StartDepthContext);
+        let d = &mut self.depth;
+        d.contexts.push(DepthContext {
+            tags_start: d.tags.len(),
+            planes_start: d.planes.len(),
+            outer_plane: d.plane_stack.last().copied(),
+            plane_depth: d.plane_stack.len(),
+            union: None,
+        });
+    }
+
+    /// KaminIDE patch: плоскость текущего контекста на глубине `z`; вне
+    /// контекста — `false`, и снимать её не нужно.
+    pub fn push_depth_plane(&mut self, z: f32) -> bool {
+        let d = &mut self.depth;
+        if d.contexts.is_empty() {
+            return false;
+        }
+        self.paint_operations.push(PaintOperation::StartDepthPlane(z));
+        d.plane_stack.push(d.planes.len() as u32);
+        d.planes.push(if z.is_finite() { z } else { 0.0 });
+        true
+    }
+
+    pub fn pop_depth_plane(&mut self) {
+        if self.depth.plane_stack.pop().is_some() {
+            self.paint_operations.push(PaintOperation::EndDepthPlane);
+        }
+    }
+
+    fn primitive_order_mut(&mut self, kind: u8, index: u32) -> Option<&mut DrawOrder> {
+        let i = index as usize;
+        match kind {
+            0 => self.shadows.get_mut(i).map(|p| &mut p.order),
+            1 => self.quads.get_mut(i).map(|p| &mut p.order),
+            2 => self.paths.get_mut(i).map(|p| &mut p.order),
+            3 => self.underlines.get_mut(i).map(|p| &mut p.order),
+            4 => self.monochrome_sprites.get_mut(i).map(|p| &mut p.order),
+            5 => self.polychrome_sprites.get_mut(i).map(|p| &mut p.order),
+            7 => self.subpixel_sprites.get_mut(i).map(|p| &mut p.order),
+            _ => self.surfaces.get_mut(i).map(|p| &mut p.order),
+        }
+    }
+
+    /// KaminIDE patch: закончить объёмный контекст — переписать порядок его
+    /// примитивов по глубине плоскостей.
+    pub fn pop_depth_context(&mut self) {
+        let Some(ctx) = self.depth.contexts.pop() else {
+            return;
+        };
+        self.paint_operations.push(PaintOperation::EndDepthContext);
+        self.depth.plane_stack.truncate(ctx.plane_depth);
+        let tags: Vec<(u8, u32, u32)> = self.depth.tags[ctx.tags_start..].to_vec();
+        if !tags.is_empty() {
+            // Ранг плоскости: от дальней к ближней, ничья — по документу.
+            let planes = &self.depth.planes;
+            let mut ids: Vec<u32> = (ctx.planes_start as u32..planes.len() as u32).collect();
+            ids.sort_by(|a, b| {
+                let (za, zb) = (planes[*a as usize], planes[*b as usize]);
+                za.partial_cmp(&zb)
+                    .unwrap_or(std::cmp::Ordering::Equal)
+                    .then(a.cmp(b))
+            });
+            let mut rank = vec![0u32; planes.len()];
+            for (r, id) in ids.iter().enumerate() {
+                rank[*id as usize] = r as u32;
+            }
+            let mut keyed: Vec<(u32, DrawOrder, usize)> = Vec::with_capacity(tags.len());
+            for (i, (kind, index, plane)) in tags.iter().enumerate() {
+                let old = self.primitive_order_mut(*kind, *index).map_or(0, |o| *o);
+                let r = if (*plane as usize) < ctx.planes_start {
+                    0
+                } else {
+                    rank[*plane as usize]
+                };
+                keyed.push((r, old, i));
+            }
+            let lo = keyed.iter().map(|k| k.1).min().unwrap_or(1);
+            let hi = keyed.iter().map(|k| k.1).max().unwrap_or(1);
+            keyed.sort_by_key(|k| (k.0, k.1, k.2));
+            let mut next = lo;
+            let mut prev: Option<(u32, DrawOrder)> = None;
+            for (r, old, i) in &keyed {
+                if let Some(p) = prev {
+                    if p != (*r, *old) {
+                        next += 1;
+                    }
+                }
+                prev = Some((*r, *old));
+                let (kind, index, _) = tags[*i];
+                if let Some(o) = self.primitive_order_mut(kind, index) {
+                    *o = next;
+                }
+            }
+            // Всё, что ляжет поверх контекста позже, обязано получить порядок
+            // выше переписанных номеров.
+            if next > hi {
+                if let Some(u) = ctx.union {
+                    self.tree_mut().insert_at_least(u, next / ORDER_STEP + 1);
+                }
+            }
+        }
+        match ctx.outer_plane {
+            // Вложенный контекст сплющен в плоскость объемлющего.
+            Some(outer) => {
+                for t in &mut self.depth.tags[ctx.tags_start..] {
+                    t.2 = outer;
+                }
+                if let (Some(u), Some(parent)) = (ctx.union, self.depth.contexts.last_mut()) {
+                    parent.union = Some(parent.union.map_or(u, |p| p.union(&u)));
+                }
+            }
+            None => {
+                self.depth.tags.truncate(ctx.tags_start);
+                if self.depth.contexts.is_empty() {
+                    self.depth.planes.clear();
+                }
+            }
+        }
+    }
+
+    /// KaminIDE patch: сдвинуть номера групп у меток этой сцены.
+    ///
+    /// Нужно при переносе вложенных групп в общий список кадра: их номера
+    /// были местными, а становятся сквозными.
+    pub(crate) fn shift_group_ids(&mut self, base: u32) {
+        for surface in self.surfaces.iter_mut().filter(|s| s.group > 0) {
+            surface.group += base;
+        }
+        for operation in &mut self.paint_operations {
+            match operation {
+                PaintOperation::Primitive(Primitive::Surface(surface)) if surface.group > 0 => surface.group += base,
+                // KaminIDE patch: a dormant label names its group as a drawn one does.
+                PaintOperation::Dormant(primitive) if matches!(&**primitive, Primitive::Surface(s) if s.group > 0) => {
+                    if let Primitive::Surface(surface) = std::rc::Rc::make_mut(primitive) {
+                        surface.group += base;
+                    }
+                }
+                _ => {}
+            }
+        }
+    }
+
+    pub fn clear(&mut self) {
+        self.book.images.clear();
+        self.segment_capture = None;
+        self.paint_operations.clear();
+        self.scroll.clear();
+        self.groups.clear();
+        match std::rc::Rc::get_mut(&mut self.primitive_bounds) {
+            Some(tree) => tree.clear(),
+            None => self.primitive_bounds = Default::default(),
+        }
+        self.blocks.clear();
+        self.layer_stack.clear();
+        self.bottom_seq = 0;
+        self.paths.clear();
+        self.shadows.clear();
+        self.quads.clear();
+        self.book.gradients.clear();
+        self.book.gradient_values.clear();
+        self.underlines.clear();
+        self.monochrome_sprites.clear();
+        self.subpixel_sprites.clear();
+        self.polychrome_sprites.clear();
+        self.surfaces.clear();
+        self.book.layers.clear();
+        self.book.layer_order.clear();
+        self.book.layer_sources.clear();
+        self.book.fresh = 0;
+        self.book.layer_damage = None;
+        self.book.damage = None;
+        self.book.grouped_damage = None;
+        self.book.primitive_ink = None;
+        self.hoisted_backdrops.clear();
+        self.depth = DepthSort::default();
+        self.ink.clear();
+        self.ink_scope = 0;
+        self.ink_allowed = (0, 0);
+        self.clear_damage_index();
+        crate::window::reset_ink_scopes();
+    }
+
+    pub fn len(&self) -> usize {
+        self.paint_operations.len()
+    }
+
+    pub fn push_layer(&mut self, bounds: Bounds<ScaledPixels>) {
+        let order = self.tree_mut().insert(bounds) * ORDER_STEP;
+        self.layer_stack.push(order);
+        // KaminIDE patch: a layer opened under a scroll node moves with it.
+        self.mark_layer(bounds);
+        self.paint_operations
+            .push(PaintOperation::StartLayer(bounds, order));
+    }
+
+    pub fn pop_layer(&mut self) {
+        self.layer_stack.pop();
+        self.paint_operations.push(PaintOperation::EndLayer);
+    }
+
+    /// KaminIDE patch: слой ПОД содержимым кадра, но НАД фоном страницы.
+    ///
+    /// Порядок примитива берётся из дерева границ с шагом `ORDER_STEP`:
+    /// первый вставленный (фон корня во весь кадр) получает `ORDER_STEP`, а
+    /// всё, что его перекрывает, — от `2 * ORDER_STEP` и выше. Примитивы слоя
+    /// получают порядки `ORDER_STEP + 1, + 2, …` в порядке краски: ПОСЛЕ фона,
+    /// но ДО перекрывающего содержимого — ровно место отрицательного
+    /// `z-index` из CSS 2.1 §9.9 (шаг 3: над фоном корневого контекста, под
+    /// потоком), и порядок документа между ними держится для любых видов
+    /// примитивов.
+    pub fn push_bottom_layer(&mut self) {
+        self.layer_stack.push(BOTTOM_LAYER);
+        self.paint_operations.push(PaintOperation::StartBottomLayer);
+    }
+
+    pub fn insert_primitive(&mut self, primitive: impl Into<Primitive>) {
+        self.book.fresh += 1;
+        let mut primitive = primitive.into();
+        let placed_bounds = placed_bounds(&primitive);
+        // KaminIDE patch: ink of open retained subtrees, culled or not.
+        crate::window::ink_add(&self.ink, self.ink_scope, placed_bounds);
+        crate::window::scoped_ink(self.ink_scope, |sink| sink.add_in(self.ink_scope, placed_bounds));
+        // KaminIDE patch: under a scroll node, drawn with own mask ∩ chain.
+        let ordered = match self.scroll.open {
+            Some((node, chain)) => match self.mark_scrolled(&mut primitive, node, chain) {
+                Some(ordered) => Some(ordered),
+                None => return,
+            },
+            None => None,
+        };
+        let clipped_bounds = placed_bounds.intersect(&primitive.content_mask().bounds);
+
+        if clipped_bounds.is_empty() {
+            return;
+        }
+        // KaminIDE patch: a record keeps the pivot of what it paints unmarked.
+        if ordered.is_none() {
+            self.note_record_pivot(&primitive);
+        }
+        self.add_primitive_ink(clipped_bounds);
+
+        let order = match self.layer_stack.last().copied() {
+            // Above the root background (tree order 1), below everything that
+            // overlaps it, in paint order.
+            Some(BOTTOM_LAYER) => {
+                self.bottom_seq = (self.bottom_seq + 1).min(ORDER_STEP - 1);
+                ORDER_STEP + self.bottom_seq
+            }
+            Some(o) => o,
+            None =>self.tree_mut().insert(ordered.unwrap_or(clipped_bounds)) * ORDER_STEP,
+        };
+        match &mut primitive {
+            Primitive::Shadow(shadow) => {
+                shadow.order = order;
+                self.shadows.push(*shadow);
+            }
+            Primitive::Gradient(p) => {
+                p.quad.order = order;
+                self.register_gradient(p);
+                self.quads.push(p.quad);
+            }
+            Primitive::Quad(quad) => {
+                quad.order = order;
+                self.quads.push(*quad);
+            }
+            Primitive::Path(path) => {
+                path.order = order;
+                path.id = PathId(self.paths.len());
+                self.paths.push(path.clone());
+            }
+            Primitive::Underline(underline) => {
+                underline.order = order;
+                self.underlines.push(*underline);
+            }
+            Primitive::MonochromeSprite(sprite) => {
+                sprite.order = order;
+                self.monochrome_sprites.push(*sprite);
+            }
+            Primitive::SubpixelSprite(sprite) => {
+                sprite.order = order;
+                self.subpixel_sprites.push(*sprite);
+            }
+            Primitive::PolychromeSprite(sprite) => {
+                sprite.order = order;
+                self.polychrome_sprites.push(*sprite);
+            }
+            Primitive::Surface(surface) => {
+                surface.order = order;
+                self.surfaces.push(surface.clone());
+            }
+        }
+        if let Some(&plane) = self.depth.plane_stack.last() {
+            let (kind, index) = match &primitive {
+                Primitive::Shadow(_) => (0, self.shadows.len() - 1),
+                Primitive::Quad(_) | Primitive::Gradient(_) => (1, self.quads.len() - 1),
+                Primitive::Path(_) => (2, self.paths.len() - 1),
+                Primitive::Underline(_) => (3, self.underlines.len() - 1),
+                Primitive::MonochromeSprite(_) => (4, self.monochrome_sprites.len() - 1),
+                Primitive::PolychromeSprite(_) => (5, self.polychrome_sprites.len() - 1),
+                Primitive::Surface(_) => (6, self.surfaces.len() - 1),
+                Primitive::SubpixelSprite(_) => (7, self.subpixel_sprites.len() - 1),
+            };
+            self.depth.tags.push((kind, index as u32, plane));
+            if let Some(ctx) = self.depth.contexts.last_mut() {
+                ctx.union = Some(ctx.union.map_or(clipped_bounds, |u| u.union(&clipped_bounds)));
+            }
+        }
+        self.paint_operations
+            .push(PaintOperation::Primitive(primitive));
+        if let Some(capture) = self.segment_capture.as_mut() {
+            capture.primitive();
+        }
+    }
+
+    /// KaminIDE patch: the bounds tree, copied first if a graft shares it.
+    fn tree_mut(&mut self) -> &mut BoundsTree<ScaledPixels> {
+        std::rc::Rc::make_mut(&mut self.primitive_bounds)
+    }
+
+    /// KaminIDE patch: finish a scene that will not be painted into again
+    /// (a paint record): its bounds tree is shared by the grafts of the scenes
+    /// that copy it and can outlive the record, so it drops its spare
+    /// capacity (`BoundsTree::freeze`). A frame scene keeps its capacity for
+    /// the next frame and is finished with `finish` alone.
+    pub(crate) fn finish_frozen(&mut self) {
+        self.finish();
+        if let Some(tree) = std::rc::Rc::get_mut(&mut self.primitive_bounds) {
+            tree.freeze();
+        }
+    }
+
+    /// KaminIDE patch: finish a frame. Its bounds tree only orders inserts
+    /// into this frame (a later frame replays from `blocks`), so the grafts it
+    /// holds are released now rather than at the next `clear`: the trees of
+    /// paint records that died during the frame die with them, as when every
+    /// primitive was inserted (the capacity stays for the next frame).
+    pub(crate) fn finish_frame(&mut self) {
+        self.finish();
+        match std::rc::Rc::get_mut(&mut self.primitive_bounds) {
+            Some(tree) => tree.clear(),
+            None => self.primitive_bounds = Default::default(),
+        }
+    }
+
+    /// Copy `range` of an earlier scene (the rendered frame) into this one.
+    ///
+    /// KaminIDE patch: a range copied the same way into that scene grafts the
+    /// frozen tree it was indexed with; another range is indexed once by a
+    /// packed tree (`BoundsTree::packed`) instead of one insert per primitive.
+    pub fn replay(&mut self, range: Range<usize>, prev_scene: &Scene) {
+        let landed = self.paint_operations.len();
+        self.scroll.raise = 0;
+        self.replay_unmarked(range.clone(), prev_scene);
+        self.copy_scroll_marks(prev_scene, range, landed);
+    }
+
+    fn replay_unmarked(&mut self, range: Range<usize>, prev_scene: &Scene) {
+        let operations = &prev_scene.paint_operations[range.clone()];
+        // A block whose borrowed tree died with its record is packed again.
+        let source = prev_scene
+            .blocks
+            .iter()
+            .find(|block| block.ops == range)
+            .and_then(|block| match &block.index {
+                BlockIndex::Empty => Some(ReplaySource::Graft(None, false)),
+                BlockIndex::Owned(graft) => Some(ReplaySource::Graft(Some(graft.clone()), true)),
+                BlockIndex::Shared(graft) => {
+                    graft.upgrade().map(|graft| ReplaySource::Graft(Some(graft), false))
+                }
+            })
+            .unwrap_or(ReplaySource::Pack);
+        if !self.replay_shifted(operations, source, &prev_scene.book.images, |_| true) {
+            for operation in operations {
+                self.replay_image_operation(operation.clone(), &prev_scene.book.images);
+            }
+        }
+    }
+
+    /// KaminIDE patch: copy every command of a finished, isolated `scene`
+    /// (a paint record or its copy) into this one, grafting its tree.
+    pub(crate) fn replay_record(&mut self, scene: &Scene) {
+        let graft = crate::bounds_tree::Graft::new(scene.primitive_bounds.clone(), Point::default(), None, 0);
+        let source = ReplaySource::Graft(graft, false);
+        // KaminIDE patch: under a scroll node, what the record marked under it.
+        let restored = self.scroll.open.and_then(|(node, _)| scene.unscrolled_under(node));
+        let operations = restored.as_deref().unwrap_or(&scene.paint_operations);
+        self.copying_pivots(scene, Point::default(), |this| {
+            if !this.replay_shifted(operations, source, &scene.book.images, |_| true) {
+                for operation in operations {
+                    this.replay_image_operation(operation.clone(), &scene.book.images);
+                }
+            }
+        });
+    }
+
+    /// KaminIDE patch: `replay` of `range` of the rendered `prev_scene` moved
+    /// by `offset` and clipped by `clip` (`Window::replay_retained_paint_moved`):
+    /// commands are placed as `replay_placed` places a record's, and indexed
+    /// by a tree packed from their new places.
+    pub(crate) fn replay_moved(
+        &mut self,
+        range: Range<usize>,
+        prev_scene: &Scene,
+        offset: Point<ScaledPixels>,
+        clip: Bounds<ScaledPixels>,
+    ) {
+        // KaminIDE patch: what a scroll node kept, with its own masks.
+        let mut operations = prev_scene.unscrolled(range);
+        operations.retain_mut(|operation| match operation {
+            PaintOperation::Primitive(primitive) => {
+                record::geometry::primitive(primitive, offset, Some(clip));
+                !placed_bounds(primitive)
+                    .intersect(&primitive.content_mask().bounds)
+                    .is_empty()
+            }
+            PaintOperation::StartLayer(bounds, _) => {
+                *bounds = record::geometry::bounds(*bounds, offset);
+                true
+            }
+            // KaminIDE patch: a moved copy is not a scroll step; its primitives
+            // stay as drawn, unmarked, so a scrolled replay builds instead.
+            PaintOperation::Reservoir(_) => false,
+            _ => true,
+        });
+        if !self.replay_shifted(&operations, ReplaySource::Pack, &prev_scene.book.images, |_| true) {
+            for operation in operations {
+                self.replay_image_operation(operation, &prev_scene.book.images);
+            }
+        }
+    }
+    /// KaminIDE patch: `replay_record` of `scene.copy_record(offset, clip)`
+    /// without the intermediate copy: every command is placed (moved by
+    /// `offset`, clipped by `clip`; primitives clipped away are dropped as
+    /// `copy_grafted` drops them) and appended here in one pass, and the
+    /// record's tree is grafted through the same offset and clip. The orders
+    /// and the index are those of the two-step path (a graft of a graft
+    /// collapses into one), and the copy's `finish` sort is not observable,
+    /// since this scene sorts at its own `finish`. `false` (nothing written)
+    /// when the record has paint groups or hoisted backdrops, which need the
+    /// intermediate scene for `Window::adopt_scene`, or when the commands or
+    /// this scene's open state need the per-primitive replay.
+    pub(crate) fn replay_placed(
+        &mut self,
+        scene: &Scene,
+        offset: Point<ScaledPixels>,
+        clip: Option<Bounds<ScaledPixels>>,
+    ) -> bool {
+        // A layer is drawn where it was recorded: it cannot be moved.
+        if !scene.groups.is_empty() || !scene.hoisted_backdrops.is_empty() || !scene.book.layers.is_empty() {
+            return false;
+        }
+        let graft = crate::bounds_tree::Graft::new(scene.primitive_bounds.clone(), offset, clip, 0);
+        let source = ReplaySource::Graft(graft, false);
+        // KaminIDE patch: under a scroll node, what the record marked under it.
+        let restored = self.scroll.open.and_then(|(node, _)| scene.unscrolled_under(node));
+        let operations = restored.as_deref().unwrap_or(&scene.paint_operations);
+        self.copying_pivots(scene, offset, |this| this.replay_shifted(operations, source, &scene.book.images, |operation| match operation {
+            PaintOperation::Primitive(primitive) => {
+                record::geometry::primitive(primitive, offset, clip);
+                !placed_bounds(primitive)
+                    .intersect(&primitive.content_mask().bounds)
+                    .is_empty()
+            }
+            PaintOperation::StartLayer(bounds, _) => {
+                *bounds = record::geometry::bounds(*bounds, offset);
+                true
+            }
+            // KaminIDE patch: a moved copy is not a scroll step; its primitives
+            // stay as drawn, unmarked, so a scrolled replay builds instead.
+            PaintOperation::Reservoir(_) => false,
+            _ => true,
+        }))
+    }
+
+    /// KaminIDE patch: whether every order in `operations` comes from the
+    /// bounds tree (no bottom layer, no 3D depth sort) and layers are closed,
+    /// so the commands keep their relative orders under one shift.
+    fn shiftable(operations: &[PaintOperation]) -> bool {
+        let mut layers = 0usize;
+        for operation in operations {
+            match operation {
+                PaintOperation::Primitive(_)
+                | PaintOperation::Layer(_)
+                | PaintOperation::Dormant(_)
+                | PaintOperation::Reservoir(_) => {}
+                PaintOperation::StartLayer(..) => layers += 1,
+                PaintOperation::EndLayer => match layers.checked_sub(1) {
+                    Some(open) => layers = open,
+                    None => return false,
+                },
+                PaintOperation::StartBottomLayer
+                | PaintOperation::StartDepthContext
+                | PaintOperation::EndDepthContext
+                | PaintOperation::StartDepthPlane(_)
+                | PaintOperation::EndDepthPlane => return false,
+            }
+        }
+        layers == 0
+    }
+
+    /// KaminIDE patch: the rectangles the bounds tree held for `operations`
+    /// when they were painted, packed into a tree (`shiftable` commands only):
+    /// layer bounds and primitives outside layers, as inserted.
+    fn packed(operations: &[PaintOperation]) -> BoundsTree<ScaledPixels> {
+        let mut rects = Vec::new();
+        let mut layers = 0usize;
+        for operation in operations {
+            match operation {
+                PaintOperation::StartLayer(bounds, order) => {
+                    if layers == 0 {
+                        rects.push((*bounds, order / ORDER_STEP));
+                    }
+                    layers += 1;
+                }
+                PaintOperation::EndLayer => layers -= 1,
+                PaintOperation::Primitive(primitive) if layers == 0 => {
+                    let clipped = placed_bounds(primitive).intersect(&primitive.content_mask().bounds);
+                    if !clipped.is_empty() {
+                        rects.push((clipped, primitive.order() / ORDER_STEP));
+                    }
+                }
+                PaintOperation::Layer(layer) if layers == 0 => {
+                    rects.push((layer.bounds, layer.order / ORDER_STEP));
+                }
+                _ => {}
+            }
+        }
+        BoundsTree::packed(rects, |coordinate| coordinate.0)
+    }
+
+    /// KaminIDE patch: copy `operations` with their recorded orders, raised
+    /// above everything earlier they overlap, and graft the tree that indexed
+    /// them (`source`: the graft of that tree, or a tree packed from the
+    /// commands). Every order keeps the
+    /// overlap rule of `insert_primitive` (later and overlapping means
+    /// higher), so the frame draws the same pixels, and later inserts see the
+    /// copied rectangles exactly through the graft. `false` when the commands
+    /// or this scene's open state need the per-primitive replay.
+    ///
+    /// The block remembering the copy for a later frame (`replay`) shares
+    /// only a tree this scene made (a packed one, or one inherited from such a
+    /// block); a borrowed tree (a paint record's) is remembered weakly, so the
+    /// rendered frame does not keep a record's index alive after the record.
+    fn replay_shifted(
+        &mut self,
+        operations: &[PaintOperation],
+        source: ReplaySource,
+        images: &image_resources::ImageResources,
+        mut place: impl FnMut(&mut PaintOperation) -> bool,
+    ) -> bool {
+        if !self.layer_stack.is_empty()
+            || !self.depth.contexts.is_empty()
+            || !self.depth.plane_stack.is_empty()
+            || !Self::shiftable(operations)
+        {
+            return false;
+        }
+        let (graft, owned) = match source {
+            ReplaySource::Graft(graft, owned) => (graft, owned),
+            ReplaySource::Pack => {
+                let mut packed = Self::packed(operations);
+                packed.freeze();
+                let tree = std::rc::Rc::new(packed);
+                (crate::bounds_tree::Graft::new(tree, Point::default(), None, 0), true)
+            }
+        };
+        let mut raise = 0;
+        let graft = graft.map(|mut graft| {
+            raise = self.tree_mut().min_raise(&graft);
+            graft.raise(raise);
+            graft
+        });
+        let shift = raise * ORDER_STEP;
+        // KaminIDE patch: dormant primitives take it when they wake.
+        self.scroll.raise = shift;
+        let start = self.paint_operations.len();
+        let mut ink: Option<Bounds<ScaledPixels>> = None;
+        let mut copied = 0;
+        // No `reserve(operations.len())`: `place` may drop most commands (a
+        // clipped record copies only what is visible), and a frame keeps its
+        // capacity for the next frame, so a reservation for every recorded
+        // command would stay as dead capacity in both frames.
+        for (index, operation) in operations.iter().enumerate() {
+            let mut operation = self.relabeled(operation);
+            // KaminIDE patch: the mark of a node the record opened inside itself.
+            let carried = self.carried(index);
+            if !place(&mut operation) {
+                layer::PlacedMap::skip(&mut self.book.placed_map);
+                self.land_carried(None, None, shift);
+                continue;
+            }
+            // KaminIDE patch: a moved copy builds its matrices from the moved pivots.
+            if let PaintOperation::Primitive(primitive) = &mut operation
+                && self.scroll.open.is_none()
+            {
+                self.copied_pivot(primitive, index, false);
+            }
+            // KaminIDE patch: a copy landing under a scroll node is marked
+            // there, ordered by its own mask, dormant where the chain hides it.
+            if carried.is_none() && self.scroll.open.is_some() && self.mark_copied(&mut operation, shift, index) {
+                let at = self.paint_operations.len();
+                layer::PlacedMap::land(&mut self.book.placed_map, at, None);
+                self.paint_operations.push(operation);
+                self.land_carried(Some(at), None, shift);
+                continue;
+            }
+            let mut quad = None;
+            match &mut operation {
+                PaintOperation::Primitive(primitive) => {
+                    let placed = placed_bounds(primitive);
+                    if !self.ink.is_empty() || self.ink_scope != 0 {
+                        ink = Some(ink.map_or(placed, |ink| ink.union(&placed)));
+                    }
+                    self.add_primitive_ink(placed.intersect(&primitive.content_mask().bounds));
+                    *primitive.order_mut() += shift;
+                    if matches!(primitive, Primitive::Quad(_)) {
+                        quad = Some(self.quads.len());
+                    }
+                    self.copy_image(primitive, images);
+                    self.push_ordered(primitive);
+                    copied += 1;
+                    if let Some(capture) = self.segment_capture.as_mut() {
+                        capture.primitive();
+                    }
+                }
+                PaintOperation::StartLayer(_, order) => *order += shift,
+                // KaminIDE patch: the primitives a reservoir draws next take it too.
+                PaintOperation::Reservoir(reservoir) => reservoir.raised += shift,
+                PaintOperation::Layer(layer) => {
+                    if !self.ink.is_empty() || self.ink_scope != 0 {
+                        ink = Some(ink.map_or(layer.bounds, |ink| ink.union(&layer.bounds)));
+                    }
+                    layer.order += shift;
+                    if !self.push_layer_slot(layer) {
+                        layer::PlacedMap::skip(&mut self.book.placed_map);
+                        self.land_carried(None, None, shift);
+                        continue;
+                    }
+                }
+                _ => {}
+            }
+            let at = self.paint_operations.len();
+            layer::PlacedMap::land(&mut self.book.placed_map, at, quad);
+            self.paint_operations.push(operation);
+            self.land_carried(Some(at), carried, shift);
+        }
+        Self::count_copied(copied);
+        if let Some(ink) = ink {
+            crate::window::ink_add(&self.ink, self.ink_scope, ink);
+            crate::window::scoped_ink(self.ink_scope, |sink| sink.add_in(self.ink_scope, ink));
+        }
+        let index = match graft {
+            None => BlockIndex::Empty,
+            Some(graft) => {
+                let index = if owned {
+                    BlockIndex::Owned(graft.clone())
+                } else {
+                    BlockIndex::Shared(graft.downgrade())
+                };
+                self.tree_mut().insert_graft(graft);
+                index
+            }
+        };
+        self.blocks.push(ReplayedBlock {
+            ops: start..self.paint_operations.len(),
+            index,
+        });
+        true
+    }
+
+    /// KaminIDE patch: room in the command and primitive lists for as many as
+    /// `other` holds (a recording of content painted before).
+    pub(crate) fn reserve_like(&mut self, other: &Scene) {
+        self.paint_operations.reserve_exact(other.paint_operations.len());
+        self.shadows.reserve_exact(other.shadows.len());
+        self.quads.reserve_exact(other.quads.len());
+        self.paths.reserve_exact(other.paths.len());
+        self.underlines.reserve_exact(other.underlines.len());
+        self.monochrome_sprites.reserve_exact(other.monochrome_sprites.len());
+        self.subpixel_sprites.reserve_exact(other.subpixel_sprites.len());
+        self.polychrome_sprites.reserve_exact(other.polychrome_sprites.len());
+        self.surfaces.reserve_exact(other.surfaces.len());
+    }
+
+    /// KaminIDE patch: whether the scene draws anything: a command (a
+    /// primitive, a nested composite, a layer) or a hoisted backdrop.
+    pub(crate) fn paints(&self) -> bool {
+        !self.paint_operations.is_empty() || !self.hoisted_backdrops.is_empty()
+    }
+
+    /// KaminIDE patch: count the clipped bounds of a primitive command added
+    /// to this scene in `primitive_ink`; empty bounds paint nothing.
+    fn add_primitive_ink(&mut self, clipped: Bounds<ScaledPixels>) {
+        if !clipped.is_empty() {
+            self.book.primitive_ink = Some(self.book.primitive_ink.map_or(clipped, |u| u.union(&clipped)));
+        }
+    }
+
+    /// KaminIDE patch: add an ordered primitive to its kind's list.
+    fn push_ordered(&mut self, primitive: &mut Primitive) {
+        match primitive {
+            Primitive::Shadow(shadow) => self.shadows.push(*shadow),
+            Primitive::Quad(quad) => self.quads.push(*quad),
+            Primitive::Gradient(p) => {
+                self.register_gradient(p);
+                self.quads.push(p.quad);
+            }
+            Primitive::Path(path) => {
+                path.id = PathId(self.paths.len());
+                self.paths.push(path.clone());
+            }
+            Primitive::Underline(underline) => self.underlines.push(*underline),
+            Primitive::MonochromeSprite(sprite) => self.monochrome_sprites.push(*sprite),
+            Primitive::SubpixelSprite(sprite) => self.subpixel_sprites.push(*sprite),
+            Primitive::PolychromeSprite(sprite) => self.polychrome_sprites.push(*sprite),
+            Primitive::Surface(surface) => self.surfaces.push(surface.clone()),
+        }
+    }
+
+    /// KaminIDE patch: a copy of every command of this finished scene moved
+    /// by `offset` and clipped by `clip`, with the recorded orders, indexed by
+    /// a graft of this scene's tree. Primitives clipped away are dropped as
+    /// `insert_primitive` drops them.
+    pub(crate) fn copy_grafted(
+        &self,
+        offset: Point<ScaledPixels>,
+        clip: Option<Bounds<ScaledPixels>>,
+        mut place: impl FnMut(&mut PaintOperation),
+    ) -> Self {
+        // Layers are recorded only in the root environment, never in a record.
+        debug_assert!(self.book.layers.is_empty(), "a paint record with a scene layer");
+        let mut scene = Self { in_group: self.in_group, ..Self::default() };
+        // Without an output clip every command is kept (a composition
+        // group's copy, which the frame keeps): reserve exactly. With one,
+        // most may be dropped, so grow by the kept ones.
+        if clip.is_none() {
+            scene.paint_operations.reserve_exact(self.paint_operations.len());
+        }
+        // KaminIDE patch: the copy keeps the scroll marks of what it keeps,
+        // moved and clipped as the commands are, so a copy placed under the
+        // node gives them back (`unscrolled_under`).
+        let mut marks = self.scroll.marks.iter().peekable();
+        let mut unmarked = self.scroll.pivots.iter().peekable();
+        for (at, operation) in self.paint_operations.iter().enumerate() {
+            let mark = marks.next_if(|mark| mark.op as usize == at);
+            let mut operation = operation.clone();
+            place(&mut operation);
+            // A placed primitive takes the matrix its moved pivot builds, the
+            // bits a fresh paint there builds; a dormant one keeps its own.
+            let dormant = matches!(operation, PaintOperation::Dormant(_));
+            let own_pivot = unmarked.next_if(|(op, _)| *op as usize == at).map(|(_, pivot)| pivot);
+            let pivot = match mark.and_then(|mark| mark.pivot.as_ref()).or(own_pivot) {
+                Some(pivot) if !dormant && offset != Point::default() => Some(std::rc::Rc::new(pivot.moved(offset))),
+                pivot => pivot.cloned(),
+            };
+            if let (PaintOperation::Primitive(primitive), Some(pivot)) = (&mut operation, &pivot) {
+                scroll_marks::pivots::set_matrix(primitive, pivot.matrix());
+            }
+            if let PaintOperation::Primitive(primitive) = &mut operation {
+                let clipped = placed_bounds(primitive).intersect(&primitive.content_mask().bounds);
+                if clipped.is_empty() {
+                    continue;
+                }
+                scene.add_primitive_ink(clipped);
+                scene.copy_image(primitive, &self.book.images);
+                scene.push_ordered(primitive);
+            }
+            if let Some(mark) = mark {
+                let moved = |bounds| {
+                    let bounds = record::geometry::bounds(bounds, offset);
+                    clip.map_or(bounds, |clip| bounds.intersect(&clip))
+                };
+                // A dormant command was not placed: its mark carries the shift.
+                let shift = if dormant { mark.moved + offset } else { mark.moved };
+                let op = scene.paint_operations.len() as u32;
+                scene.scroll.marks.push(scroll_marks::ScrollMark {
+                    op,
+                    own: moved(mark.own),
+                    placed: record::geometry::bounds(mark.placed, offset),
+                    moved: shift,
+                    pivot,
+                    ..*mark
+                });
+            } else if let Some(pivot) = pivot {
+                scene.scroll.pivots.push((scene.paint_operations.len() as u32, pivot));
+            }
+            scene.paint_operations.push(operation);
+        }
+        if let Some(graft) =
+            crate::bounds_tree::Graft::new(self.primitive_bounds.clone(), offset, clip, 0)
+        {
+            scene.tree_mut().insert_graft(graft);
+        }
+        scene.tree_mut().freeze();
+        scene
+    }
+
+    fn replay_operation(&mut self, operation: PaintOperation) {
+        match operation {
+            PaintOperation::Primitive(primitive) => {
+                Self::count_copied(1);
+                let fresh = self.book.fresh;
+                self.insert_primitive(primitive);
+                self.book.fresh = fresh;
+            }
+            PaintOperation::Layer(layer) => {
+                if let Some(cell) = layer.cell.upgrade() {
+                    let (fresh, damage) = (self.book.fresh, cell.damage.take());
+                    self.insert_layer(&LayerHandle(cell), layer.bounds);
+                    self.book.fresh = fresh;
+                    if let Some(rect) = damage {
+                        self.book.layer_damage = Some(self.book.layer_damage.map_or(rect, |d| d.union(&rect)));
+                    }
+                }
+            }
+            PaintOperation::StartLayer(bounds, _) => self.push_layer(bounds),
+            PaintOperation::StartBottomLayer => self.push_bottom_layer(),
+            PaintOperation::EndLayer => self.pop_layer(),
+            PaintOperation::StartDepthContext => self.push_depth_context(),
+            PaintOperation::EndDepthContext => self.pop_depth_context(),
+            PaintOperation::StartDepthPlane(z) => { self.push_depth_plane(z); }
+            PaintOperation::EndDepthPlane => self.pop_depth_plane(),
+            // KaminIDE patch: kept as it is, not drawn.
+            PaintOperation::Dormant(primitive) => self.paint_operations.push(PaintOperation::Dormant(primitive)),
+            PaintOperation::Reservoir(reservoir) => self.paint_operations.push(PaintOperation::Reservoir(reservoir)),
+        }
+    }
+
+    pub fn finish(&mut self) {
+        self.shadows.sort_by_key(|shadow| shadow.order);
+        self.quads.sort_by_key(|quad| quad.order);
+        self.paths.sort_by_key(|path| path.order);
+        self.underlines.sort_by_key(|underline| underline.order);
+        // KaminIDE patch: sprites of one order keep their paint order (a stable
+        // sort), as quads do. Upstream also sorted them by atlas tile id, so two
+        // overlapping glyphs of one text run blended in the order the atlas
+        // happened to number their tiles: the same text with tiles made by
+        // another font instance or in another frame differed by a code.
+        self.monochrome_sprites.sort_by_key(|sprite| sprite.order);
+        self.subpixel_sprites.sort_by_key(|sprite| sprite.order);
+        self.polychrome_sprites.sort_by_key(|sprite| sprite.order);
+        self.surfaces.sort_by_key(|surface| surface.order);
+        self.finish_layers();
+    }
+
+    #[cfg_attr(
+        all(
+            any(target_os = "linux", target_os = "freebsd"),
+            not(any(feature = "x11", feature = "wayland"))
+        ),
+        allow(dead_code)
+    )]
+    pub fn batches(&self) -> impl Iterator<Item = PrimitiveBatch> + '_ {
+        BatchIterator {
+            shadows_start: 0,
+            shadows_iter: self.shadows.iter().peekable(),
+            quads_start: 0,
+            quads_iter: self.quads.iter().peekable(),
+            paths_start: 0,
+            paths_iter: self.paths.iter().peekable(),
+            underlines_start: 0,
+            underlines_iter: self.underlines.iter().peekable(),
+            monochrome_sprites_start: 0,
+            monochrome_sprites_iter: self.monochrome_sprites.iter().peekable(),
+            subpixel_sprites_start: 0,
+            subpixel_sprites_iter: self.subpixel_sprites.iter().peekable(),
+            polychrome_sprites_start: 0,
+            polychrome_sprites_iter: self.polychrome_sprites.iter().peekable(),
+            surfaces_start: 0,
+            surfaces_iter: self.surfaces.iter().peekable(),
+            layers: &self.book.layers,
+            layers_iter: self.book.layer_order.iter().peekable(),
+        }
+    }
+}
