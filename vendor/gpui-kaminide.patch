+            y0 = y0.min(ty);
+            x1 = x1.max(tx);
+            y1 = y1.max(ty);
+        }
+        ContentMask {
+            bounds: Bounds {
+                origin: Point::new(Pixels(x0), Pixels(y0)),
+                size: Size { width: Pixels(x1 - x0), height: Pixels(y1 - y0) },
+            },
