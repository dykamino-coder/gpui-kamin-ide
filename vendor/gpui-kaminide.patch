+                KeyContext::parse("Workspace").unwrap(),
+                KeyContext::parse("Editor").unwrap(),
+            ],
+        );
+        assert_eq!(
+            describe_bindings(&bindings),
+            vec![
+                ("ctrl-k b".to_string(), "test_only::ActionGamma"),
+                ("ctrl-k a".to_string(), "test_only::ActionAlpha"),
+            ]
