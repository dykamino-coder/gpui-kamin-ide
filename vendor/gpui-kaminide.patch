+            ForegroundJournalEntry::Discontinuity { lost: 1 },
+            ForegroundJournalEntry::Event(task_poll_event(at(10), at(15))),
+            ForegroundJournalEntry::Boundary(IntervalBoundary::Idle { ended_at: at(15) }),
+            ForegroundJournalEntry::Discontinuity { lost: 1 },
