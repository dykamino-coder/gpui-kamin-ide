+    fn need_hitbox(&self) -> bool {
+        self.window_control.is_some()
+            || self.hover_style.is_some()
+            || self.group_hover_style.is_some()
+            || self.hover_listener.is_some()
+            || self.drag_listener.is_some()
+            || self.tooltip_builder.is_some()
+    }
