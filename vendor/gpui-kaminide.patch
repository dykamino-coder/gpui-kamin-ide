+        &'a mut self,
+        id: Option<&'a GlobalElementId>,
+        inspector_id: Option<&'a InspectorElementId>,
+        window: &'a mut Window,
+        cx: &'a mut App,
+        stack: &'a mut crate::PaintStack,
