+[dependencies.strum]
+version = "0.28"
+features = ["derive"]
+
+[dependencies.sum_tree]
+version = "=0.3.8"
+package = "gpui-pre-sum-tree"
+
+[dependencies.taffy]
+version = "=0.14.0"
+
+[dependencies.thiserror]
+version = "2.0.12"
+
+[dependencies.ttf-parser]
+version = "0.25"
+
+[dependencies.url]
+version = "2.2"
+
+[dependencies.usvg]
+version = "0.48.0"
+default-features = false
+
+[dependencies.unicode-linebreak]
+version = "0.1"
+[dependencies.util_macros]
+version = "=0.3.8"
+package = "gpui-pre-util-macros"
+
+[dependencies.uuid]
+version = "1.1.2"
+features = [
+    "v4",
+    "v5",
+    "v7",
+    "serde",
+]
+
+[dependencies.waker-fn]
+version = "1.2.0"
+
+[dependencies.web-time]
+version = "1.1.0"
+
+# KaminIDE patch: the crates.io package dropped upstream's path-only
+# dev-dependencies while keeping its examples. Their published equivalents of
+# the same snapshot let the examples build standalone (docs/VENDORING.md).
+[dev-dependencies.env_logger]
+version = "0.11"
+
+[dev-dependencies.gpui_platform]
+version = "=0.3.8"
+package = "gpui-pre-platform"
+
+[dev-dependencies.lyon]
+version = "1.0"
+features = ["extra"]
+
+[dev-dependencies.unicode-segmentation]
+version = "1.10"
+
+[build-dependencies.embed-resource]
+version = "3.0"
+optional = true
+
+[target.'cfg(all(target_arch = "wasm32", target_os = "unknown"))'.dependencies.async-channel]
+version = "2.5.0"
+default-features = false
+
+[target.'cfg(any(target_os = "linux", target_os = "android"))'.dependencies.libc]
+version = "0.2"
+
+[target.'cfg(any(target_os = "linux", target_os = "freebsd", target_os = "windows"))'.dependencies.scap]
