@@ -0,0 +1,221 @@
+//! Живая идентичность прохода и композиционных областей одного окна.
+
+use super::*;
+
+/// Identity of one window draw, shared by prepaint and paint.
+#[derive(Clone, Default)]
+pub struct PaintPassId(Rc<Cell<bool>>);
+
+/// Identity of a live composition scope, independent of host paint policy.
+#[derive(Clone, Default)]
+pub struct PaintScopeId(Rc<Cell<bool>>);
+
+/// A snapshot cannot be replayed outside its original live scope.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, thiserror::Error)]
+pub enum PaintError {
+    /// The snapshot was captured by another window.
+    #[error("paint snapshot belongs to another window")]
+    WrongWindow,
+    /// The captured draw completed or was aborted.
+    #[error("paint snapshot pass has ended")]
+    ExpiredPass,
+    /// Another draw is currently active in this window.
+    #[error("paint snapshot belongs to another pass")]
+    WrongPass,
+    /// The captured composition scope has closed.
+    #[error("paint snapshot composition scope has closed")]
+    ExpiredScope,
+    /// Another composition scope is currently active.
+    #[error("paint snapshot belongs to another composition scope")]
+    WrongScope,
+}
+
+#[derive(Clone)]
+pub(super) struct Identity {
+    window: Rc<()>,
+    pass: PaintPassId,
+    scope: PaintScopeId,
+}
+
+impl Identity {
+    pub(super) fn capture(window: &Window) -> Self {
+        Self {
+            window: window.paint_window.clone(),
+            pass: window.paint_pass.clone(),
+            scope: window.paint_scope.clone(),
+        }
+    }
+
+    pub(super) fn check(&self, window: &Window) -> Result<(), PaintError> {
+        self.check_pass(window)?;
+        if !self.scope.0.get() {
+            return Err(PaintError::ExpiredScope);
+        }
+        if !Rc::ptr_eq(&self.scope.0, &window.paint_scope.0) {
+            return Err(PaintError::WrongScope);
+        }
+        Ok(())
+    }
+
+    // Commands retain draw resources, not permission to restore an old scope.
+    pub(super) fn check_pass(&self, window: &Window) -> Result<(), PaintError> {
+        if !Rc::ptr_eq(&self.window, &window.paint_window) {
+            return Err(PaintError::WrongWindow);
+        }
+        if !self.pass.0.get() {
+            return Err(PaintError::ExpiredPass);
+        }
+        if !Rc::ptr_eq(&self.pass.0, &window.paint_pass.0) {
+            return Err(PaintError::WrongPass);
+        }
+        Ok(())
+    }
+}
+
+impl PartialEq for PaintPassId {
+    fn eq(&self, other: &Self) -> bool {
+        Rc::ptr_eq(&self.0, &other.0)
+    }
+}
+impl Eq for PaintPassId {}
+
+impl PaintPassId {
+    /// Whether the original draw is still open and has not unwound.
+    pub fn is_live(&self) -> bool {
+        self.0.get()
+    }
+    pub(super) fn invalidate(&self) {
+        self.0.set(false);
+    }
+}
+
+impl PartialEq for PaintScopeId {
+    fn eq(&self, other: &Self) -> bool {
+        Rc::ptr_eq(&self.0, &other.0)
+    }
+}
+impl Eq for PaintScopeId {}
+
+impl PaintScopeId {
+    /// Whether the original composition scope remains open.
+    pub fn is_live(&self) -> bool {
+        self.0.get()
+    }
+}
+
+impl Window {
+    /// Identify the current draw without extending its validity.
+    pub fn paint_pass_id(&self) -> PaintPassId {
+        self.paint_pass.clone()
+    }
+
+    /// Identify the current composition scope without extending its validity.
+    pub fn paint_scope_id(&self) -> PaintScopeId {
+        self.paint_scope.clone()
+    }
+
+    pub(crate) fn with_paint_pass<R>(&mut self, f: impl FnOnce(&mut Self) -> R) -> R {
+        let pass = mem::replace(&mut self.paint_pass, PaintPassId(Rc::new(Cell::new(true))));
+        let scope = mem::replace(
+            &mut self.paint_scope,
+            PaintScopeId(Rc::new(Cell::new(true))),
+        );
+        let state = Box::new(self.snapshot_paint_state());
+        let inputs = (self.layout_retry, self.layout_inputs.clone());
+        self.with_restore(
+            (pass, scope, state, self.refreshing, inputs),
+            |window, previous| {
+                if std::thread::panicking() || !window.paint_pass.is_live() {
+                    previous.2.restore(window);
+                    window.next_frame.clear();
+                    if let Some(layout) = window.layout_engine.as_mut() {
+                        layout.discard();
+                    }
+                    window.text_system().finish_frame();
+                    window.refreshing = previous.3;
+                    window.layout_retry = previous.4.0;
+                    mem::swap(&mut window.layout_inputs, &mut previous.4.1);
+                    window.invalidator.set_phase(DrawPhase::None);
+                }
+                window.paint_pass.0.set(false);
+                window.paint_scope.0.set(false);
+                mem::swap(&mut window.paint_pass, &mut previous.0);
+                mem::swap(&mut window.paint_scope, &mut previous.1);
+            },
+            f,
+        )
+        .0
+    }
+
+    pub(super) fn with_paint_scope<R>(&mut self, f: impl FnOnce(&mut Self) -> R) -> R {
+        let scope = mem::replace(
+            &mut self.paint_scope,
+            PaintScopeId(Rc::new(Cell::new(true))),
+        );
+        self.with_restore(
+            scope,
+            |window, previous| {
+                window.paint_scope.0.set(false);
+                mem::swap(&mut window.paint_scope, previous);
+            },
+            f,
+        )
+        .0
+    }
+
+    pub(super) fn with_isolated_scene<R>(&mut self, f: impl FnOnce(&mut Self) -> R) -> (R, Scene) {
+        let mut scene = Scene::default();
+        scene.in_group = true;
+        if self.segment_capture_mask().is_some() {
+            scene.inherit_segments(&self.next_frame.scene);
+        }
+        mem::swap(&mut self.next_frame.scene, &mut scene);
+        self.with_restore(
+            scene,
+            |window, scene| {
+                mem::swap(&mut window.next_frame.scene, scene);
+            },
+            |window| window.with_paint_scope(f),
+        )
+    }
+
+    pub(super) async fn with_paint_scope_async<R>(
+        &mut self,
+        f: impl AsyncFnOnce(&mut Self) -> R,
+    ) -> R {
+        let scope = mem::replace(
+            &mut self.paint_scope,
+            PaintScopeId(Rc::new(Cell::new(true))),
+        );
+        self.with_restore_async(
+            scope,
+            |window, previous| {
+                window.paint_scope.0.set(false);
+                mem::swap(&mut window.paint_scope, previous);
+            },
+            f,
+        )
+        .await
+        .0
+    }
+
+    pub(super) async fn with_isolated_scene_async<R>(
+        &mut self,
+        f: impl AsyncFnOnce(&mut Self) -> R,
+    ) -> (R, Scene) {
+        let mut scene = Scene::default();
+        scene.in_group = true;
+        if self.segment_capture_mask().is_some() {
+            scene.inherit_segments(&self.next_frame.scene);
+        }
+        mem::swap(&mut self.next_frame.scene, &mut scene);
+        self.with_restore_async(
+            scene,
+            |window, scene| {
+                mem::swap(&mut window.next_frame.scene, scene);
+            },
+            async |window| window.with_paint_scope_async(f).await,
+        )
+        .await
+    }
+}
diff --git a/vendor/gpui/src/window/paint_snapshot.rs b/vendor/gpui/src/window/paint_snapshot.rs
new file mode 100644
index 0000000000000000000000000000000000000000..b8b2caba460226adfdc86c2d457e46d0692bb6fa
--- /dev/null
+++ b/vendor/gpui/src/window/paint_snapshot.rs
@@ -0,0 +1,175 @@
+//! Снимок окружения и единый проверяемый replay с восстановлением через guard.
+
+use super::*;
+mod traversal;
+
+/// General element environment; raster placement is inherited from the caller.
+#[doc = include_str!("paint_contract.md")]
+#[derive(Clone)]
+pub struct PaintCtx {
+    identity: paint_scope::Identity,
+    layout_owner: RetainedLayout,
+    element_id_stack: SmallVec<[ElementId; 32]>,
+    text_style_stack: TextStyleScope,
+    render_contexts: render_context::Snapshot,
+    rendered_entity_stack: Vec<EntityId>,
+    element_offset_stack: Vec<Point<Pixels>>,
+    exact_element_offset_depth: u32,
+    transformation_stack: Vec<TransformationMatrix>,
+    mask_scale: Option<(Point<Pixels>, f32)>,
+    mask_map: Option<TransformationMatrix>,
+    element_opacity: f32,
+    content_mask_stack: Vec<ContentMask<Pixels>>,
+    image_cache_stack: Vec<AnyImageCache>,
+    /// KaminIDE patch: ink sinks open at capture keep measuring deferred paint.
+    ink: Vec<Rc<InkSink>>,
+}
+
+/// Full paint environment, including device scale and exact raster placement.
+/// Cloning retains values and host Rc identities, but does not keep scopes alive.
+#[derive(Clone)]
+pub struct PaintState {
+    base: PaintCtx,
+    raster: RasterFrame,
+    scale_factor: f32,
+    rem_size_overrides: SmallVec<[Pixels; 8]>,
+}
+
+/// Paint environment retaining raster placement at the current device scale.
+pub struct RasterPaintCtx {
+    base: PaintCtx,
+    raster: RasterFrame,
+}
+
+impl RasterPaintCtx {
+    /// Select fill placement independently of the retained glyph placement.
+    pub fn set_fill_transform(
+        &mut self,
+        transform: Option<(TransformationMatrix, TransformationMatrix)>,
+    ) {
+        self.raster.fill_transform = transform;
+    }
+}
+
+impl PaintState {
+    pub(super) fn restore(&mut self, window: &mut Window) {
+        self.base.swap(window);
+        mem::swap(&mut self.raster, &mut window.raster_frame);
+        mem::swap(&mut window.scale_factor, &mut self.scale_factor);
+        mem::swap(
+            &mut window.rem_size_override_stack,
+            &mut self.rem_size_overrides,
+        );
+    }
+}
+
+impl PaintCtx {
+    fn swap(&mut self, window: &mut Window) {
+        mem::swap(&mut window.element_id_stack, &mut self.element_id_stack);
+        mem::swap(&mut window.text_style_stack, &mut self.text_style_stack);
+        mem::swap(
+            &mut window.rendered_entity_stack,
+            &mut self.rendered_entity_stack,
+        );
+        mem::swap(
+            &mut window.element_offset_stack,
+            &mut self.element_offset_stack,
+        );
+        mem::swap(
+            &mut window.exact_element_offset_depth,
+            &mut self.exact_element_offset_depth,
+        );
+        mem::swap(
+            &mut window.transformation_stack,
+            &mut self.transformation_stack,
+        );
+        mem::swap(&mut window.mask_scale, &mut self.mask_scale);
+        mem::swap(&mut window.mask_map, &mut self.mask_map);
+        mem::swap(&mut window.element_opacity, &mut self.element_opacity);
+        mem::swap(&mut window.content_mask_stack, &mut self.content_mask_stack);
+        mem::swap(&mut window.image_cache_stack, &mut self.image_cache_stack);
+        mem::swap(&mut window.next_frame.scene.ink, &mut self.ink);
+    }
+}
+
+impl Window {
+    /// Capture the general environment used by positioned/prepaint consumers.
+    pub fn paint_ctx(&self) -> PaintCtx {
+        PaintCtx {
+            identity: paint_scope::Identity::capture(self),
+            layout_owner: self.retained_layout(),
+            element_id_stack: self.element_id_stack.clone(),
+            text_style_stack: self.text_style_stack.clone(),
+            render_contexts: self.render_contexts.snapshot(),
+            rendered_entity_stack: self.rendered_entity_stack.clone(),
+            element_offset_stack: self.element_offset_stack.clone(),
+            exact_element_offset_depth: self.exact_element_offset_depth,
+            transformation_stack: self.transformation_stack.clone(),
+            mask_scale: self.mask_scale,
+            mask_map: self.mask_map,
+            element_opacity: self.element_opacity,
+            content_mask_stack: self.content_mask_stack.clone(),
+            image_cache_stack: self.image_cache_stack.clone(),
+            ink: self.next_frame.scene.ink.clone(),
+        }
+    }
+
+    /// Capture all paint and raster state in the current live composition scope.
+    pub fn snapshot_paint_state(&self) -> PaintState {
+        self.paint_state(self.paint_ctx(), self.raster_frame().clone())
+    }
+
+    fn paint_state(&self, base: PaintCtx, raster: RasterFrame) -> PaintState {
+        PaintState {
+            base,
+            raster,
+            scale_factor: self.scale_factor,
+            rem_size_overrides: self.rem_size_override_stack.clone(),
+        }
+    }
+
+    /// Replay a full snapshot. Invalid identity never invokes the callback.
+    pub fn with_paint_state<R>(
+        &mut self,
+        state: PaintState,
+        f: impl FnOnce(&mut Self) -> R,
+    ) -> Result<R, PaintError> {
+        self.replay_paint(state, f)
+    }
+
+    /// Replay the general environment, inheriting the caller's raster placement.
+    pub fn with_paint_ctx<R>(
+        &mut self,
+        ctx: PaintCtx,
+        f: impl FnOnce(&mut Self) -> R,
+    ) -> Result<R, PaintError> {
+        self.replay_paint(self.paint_state(ctx, self.raster_frame().clone()), f)
+    }
+
+    /// Capture environment and raster placement without a scale override.
+    pub fn raster_paint_ctx(&self) -> RasterPaintCtx {
+        RasterPaintCtx {
+            base: self.paint_ctx(),
+            raster: self.raster_frame().clone(),
+        }
+    }
+
+    /// Replay captured raster placement in the original live scope.
+    pub fn with_raster_paint_ctx<R>(
+        &mut self,
+        ctx: RasterPaintCtx,
+        f: impl FnOnce(&mut Self) -> R,
+    ) -> Result<R, PaintError> {
+        self.replay_paint(self.paint_state(ctx.base, ctx.raster), f)
+    }
+
+    fn replay_paint<R>(
+        &mut self,
+        state: PaintState,
+        f: impl FnOnce(&mut Self) -> R,
+    ) -> Result<R, PaintError> {
+        reblessive::Stack::new()
+            .enter(|_| self.replay_paint_async(state, async |window| f(window)))
+            .finish()
+    }
+}
diff --git a/vendor/gpui/src/window/paint_snapshot/traversal.rs b/vendor/gpui/src/window/paint_snapshot/traversal.rs
new file mode 100644
index 0000000000000000000000000000000000000000..654982c6855350c7213be3215ecf15944c7f1262
--- /dev/null
+++ b/vendor/gpui/src/window/paint_snapshot/traversal.rs
@@ -0,0 +1,63 @@
+//! Replay окружения до завершения продолжения потомка.
+
+use super::*;
+
+impl Window {
+    /// Восстанавливает полное окружение для продолжения paint.
+    pub async fn with_paint_state_async<R>(
+        &mut self,
+        state: PaintState,
+        f: impl AsyncFnOnce(&mut Self) -> R,
+    ) -> Result<R, PaintError> {
+        self.replay_paint_async(state, f).await
+    }
+    /// Восстанавливает окружение с raster placement вызывающей стороны.
+    pub async fn with_paint_ctx_async<R>(
+        &mut self,
+        ctx: PaintCtx,
+        f: impl AsyncFnOnce(&mut Self) -> R,
+    ) -> Result<R, PaintError> {
+        self.replay_paint_async(self.paint_state(ctx, self.raster_frame().clone()), f)
+            .await
+    }
+    /// Восстанавливает окружение и raster placement отложенного задания.
+    pub async fn with_raster_paint_ctx_async<R>(
+        &mut self,
+        ctx: RasterPaintCtx,
+        f: impl AsyncFnOnce(&mut Self) -> R,
+    ) -> Result<R, PaintError> {
+        self.replay_paint_async(self.paint_state(ctx.base, ctx.raster), f)
+            .await
+    }
+    pub(super) async fn replay_paint_async<R>(
+        &mut self,
+        state: PaintState,
+        f: impl AsyncFnOnce(&mut Self) -> R,
+    ) -> Result<R, PaintError> {
+        state.base.identity.check(self)?;
+        let mut layout_owner = state.base.layout_owner.clone();
+        // Keep retained vectors outside recursive paint frames.
+        let mut state = Box::new(state);
+        let _contexts = self
+            .render_contexts
+            .enter_snapshot(mem::take(&mut state.base.render_contexts));
+        state.restore(self);
+        // KaminIDE patch: effects of deferred paint taint the sinks it feeds.
+        let f = async |window: &mut Self| {
+            let probe = crate::window::retained::InkProbe::open(window);
+            let result = f(window).await;
+            if let Some(probe) = probe {
+                probe.close(window);
+            }
+            result
+        };
+        Ok(self
+            .with_retained_layout_async(&mut layout_owner, async |window| {
+                window
+                    .with_restore_async(state, |window, state| state.restore(window), f)
+                    .await
+                    .0
+            })
+            .await)
+    }
+}
diff --git a/vendor/gpui/src/window/plane3d.rs b/vendor/gpui/src/window/plane3d.rs
new file mode 100644
index 0000000000000000000000000000000000000000..3c3de5fd2e8c1b46ea32515274ab458e5053eda3
--- /dev/null
+++ b/vendor/gpui/src/window/plane3d.rs
@@ -0,0 +1,296 @@
+//! KaminIDE patch: planes of CSS 3D rendering contexts, painted through buffers.
+//!
+//! css-transforms-2 §3d-transform-rendering: each plane is rendered flat and
+//! then mapped by its accumulated 4×4 matrix. A plane's content is painted
+//! into a group buffer under an affine "raster" transform (the affine part
+//! of the plane's matrix, so pure 2D cases stay pixel-exact), and the buffer
+//! is composited with the remaining homography: the pixel shader maps each
+//! frame pixel back through H⁻¹ (perspective-correct sampling, like viz
+//! drawing a textured quad with a full 4×4). Planes of one context are
+//! ordered and split by a BSP tree (`crate::plane_bsp`) before compositing.
+
+use super::*;
+use crate::plane_bsp::{PlanePoly, back_to_front};
+use crate::{PaintGroup, PaintSurface};
+
+/// Near-plane threshold for `w` of homogeneous corners.
+const W_EPS: f32 = 1e-3;
+
+/// Pending planes of the innermost open 3D rendering context.
+pub(crate) struct PlaneContext {
+    pending: Vec<Option<PlaneRecord>>,
+    content_mask: ContentMask<ScaledPixels>,
+}
+
+struct PlaneRecord {
+    scene: Scene,
+    projection: Option<[f32; 9]>,
+    corners: [[f32; 4]; 4],
+}
+
+/// How a plane is painted and composited (all in device pixels of the
+/// coordinate space the caller paints in).
+pub struct PlaneSpec {
+    /// Absolute transform the plane's content is painted under.
+    pub raster: TransformationMatrix,
+    /// Frame point → raster point (3×3 row-major, homogeneous); `None` when
+    /// the plane's map is the raster transform itself.
+    pub projection: Option<[f32; 9]>,
+    /// The plane's full 4x4 (row-major): local device point (z = 0) to the
+    /// context space.
+    pub full: [[f32; 4]; 4],
+    /// Affine transform active outside the context (applied after `full`).
+    pub outer: TransformationMatrix,
+    /// The plane's box in local device points (x0, y0, x1, y1); grown by the
+    /// painted content that overflows it when the plane closes.
+    pub rect: (f32, f32, f32, f32),
+    /// Child masks follow the raster transform (`with_transformation_masked`).
+    pub masked: bool,
+}
+
+/// Corners of `rect` mapped by `full` and the outer affine: (x, y, z, w).
+fn plane_corners(
+    full: &[[f32; 4]; 4],
+    outer: TransformationMatrix,
+    rect: (f32, f32, f32, f32),
+) -> [[f32; 4]; 4] {
+    let (r, t) = (outer.rotation_scale, outer.translation);
+    let (x0, y0, x1, y1) = rect;
+    [(x0, y0), (x1, y0), (x1, y1), (x0, y1)].map(|(x, y)| {
+        let row = |i: usize| full[i][0] * x + full[i][1] * y + full[i][3];
+        let (px, py, pz, pw) = (row(0), row(1), row(2), row(3));
+        [
+            r[0][0] * px + r[0][1] * py + t[0] * pw,
+            r[1][0] * px + r[1][1] * py + t[1] * pw,
+            pz,
+            pw,
+        ]
+    })
+}
+
+/// Bounds of everything a plane's scene painted, in the plane's local device
+/// points (the space `PlaneSpec::rect` lives in): primitive bounds are mapped
+/// by their own transformation and back through the raster map. A plane's
+/// content may overflow its box (an empty `div` holding an absolutely
+/// positioned child); like a compositor layer, the plane covers its ink.
+fn ink_bounds(scene: &Scene, raster: TransformationMatrix) -> Option<(f32, f32, f32, f32)> {
+    let [[a, b], [c, d]] = raster.rotation_scale;
+    let det = a * d - b * c;
+    if det.abs() < 1e-9 {
+        return None;
+    }
+    let (t0, t1) = (raster.translation[0], raster.translation[1]);
+    let inverse = |x: f32, y: f32| {
+        let (x, y) = (x - t0, y - t1);
+        ((d * x - b * y) / det, (-c * x + a * y) / det)
+    };
+    let mut ink: Option<(f32, f32, f32, f32)> = None;
+    let mut add = |bounds: &Bounds<ScaledPixels>, map: Option<TransformationMatrix>| {
+        let (x0, y0) = (bounds.origin.x.0, bounds.origin.y.0);
+        let (x1, y1) = (x0 + bounds.size.width.0, y0 + bounds.size.height.0);
+        for (x, y) in [(x0, y0), (x1, y0), (x1, y1), (x0, y1)] {
+            let (x, y) = match map {
+                Some(m) => {
+                    let r = m.rotation_scale;
+                    let (px, py) = (
+                        r[0][0] * x + r[0][1] * y + m.translation[0],
+                        r[1][0] * x + r[1][1] * y + m.translation[1],
+                    );
+                    inverse(px, py)
+                }
+                None => (x, y),
+            };
+            if !x.is_finite() || !y.is_finite() {
+                continue;
+            }
+            ink = Some(match ink {
+                Some((ax, ay, bx, by)) => (ax.min(x), ay.min(y), bx.max(x), by.max(y)),
+                None => (x, y, x, y),
+            });
+        }
+    };
+    for q in &scene.quads {
+        add(&q.bounds, Some(q.transformation));
+    }
+    for s in &scene.monochrome_sprites {
+        add(&s.bounds, Some(s.transformation));
+    }
+    for s in &scene.subpixel_sprites {
+        add(&s.bounds, Some(s.transformation));
+    }
+    for s in &scene.polychrome_sprites {
+        add(&s.bounds, Some(s.transformation));
+    }
+    for s in &scene.shadows {
+        add(&s.bounds, None);
+    }
+    for u in &scene.underlines {
+        add(&u.bounds, None);
+    }
+    for p in &scene.paths {
+        add(&p.bounds, None);
+    }
+    ink
+}
+
+/// Clip a homogeneous polygon to `w ≥ W_EPS` and divide; `None` if nothing
+/// is in front of the eye. `clipped` tells whether a corner was cut away.
+fn near_clip(corners: &[[f32; 4]; 4]) -> Option<(Vec<[f32; 3]>, bool)> {
+    let mut out = Vec::new();
+    let mut clipped = false;
+    for i in 0..4 {
+        let (p, q) = (corners[i], corners[(i + 1) % 4]);
+        let (pin, qin) = (p[3] >= W_EPS, q[3] >= W_EPS);
+        if pin {
+            out.push(p);
+        } else {
+            clipped = true;
+        }
+        if pin != qin {
+            let t = (W_EPS - p[3]) / (q[3] - p[3]);
+            out.push([0, 1, 2, 3].map(|k| p[k] + (q[k] - p[k]) * t));
+        }
+    }
+    if out.len() < 3 {
+        return None;
+    }
+    let pts = out
+        .iter()
+        .map(|v| [v[0] / v[3], v[1] / v[3], v[2] / v[3]])
+        .collect();
+    Some((pts, clipped))
+}
+
+fn to_points(points: &[[f32; 3]]) -> Vec<Point<ScaledPixels>> {
+    points
+        .iter()
+        .map(|p| point(ScaledPixels(p[0]), ScaledPixels(p[1])))
+        .collect()
+}
+
+/// A BSP piece's polygon with its box edges pushed 1px outward: the content
+/// is already antialiased along the box, only the cuts need the polygon's
+/// coverage (otherwise the box edge would be faded twice).
+fn grow_box_edges(poly: &PlanePoly) -> Vec<[f32; 3]> {
+    let pts = &poly.points;
+    let n = pts.len();
+    let area: f32 = (0..n)
+        .map(|i| {
+            let (a, b) = (pts[i], pts[(i + 1) % n]);
+            a[0] * b[1] - b[0] * a[1]
+        })
+        .sum();
+    let sign = if area >= 0.0 { 1.0 } else { -1.0 };
+    // Edge lines as (point, direction, outward offset).
+    let lines: Vec<([f32; 2], [f32; 2])> = (0..n)
+        .map(|i| {
+            let (a, b) = (pts[i], pts[(i + 1) % n]);
+            let d = [b[0] - a[0], b[1] - a[1]];
+            let len = (d[0] * d[0] + d[1] * d[1]).sqrt();
+            if poly.cut[i] || len < 1e-4 {
+                return ([a[0], a[1]], d);
+            }
+            // Outward normal of a counter-clockwise (area > 0) polygon.
+            let nrm = [sign * d[1] / len, -sign * d[0] / len];
+            ([a[0] + nrm[0], a[1] + nrm[1]], d)
+        })
+        .collect();
+    (0..n)
+        .map(|i| {
+            let (p0, d0) = lines[(i + n - 1) % n];
+            let (p1, d1) = lines[i];
+            let den = d0[0] * d1[1] - d0[1] * d1[0];
+            if den.abs() < 1e-6 {
+                return [p1[0], p1[1], pts[i][2]];
+            }
+            let t = ((p1[0] - p0[0]) * d1[1] - (p1[1] - p0[1]) * d1[0]) / den;
+            [p0[0] + d0[0] * t, p0[1] + d0[1] * t, pts[i][2]]
+        })
+        .collect()
+}
+
+mod traversal;
+
+impl Window {
+    /// Paint `f` as one 3D rendering context.
+    pub fn paint_plane_context<R>(&mut self, f: impl FnOnce(&mut Self) -> R) -> R {
+        reblessive::Stack::new()
+            .enter(|_| self.paint_plane_context_async(async |window| f(window)))
+            .finish()
+    }
+
+    /// Paint `f` as one plane in the current context.
+    pub fn paint_plane<R>(&mut self, spec: PlaneSpec, f: impl FnOnce(&mut Self) -> R) -> R {
+        reblessive::Stack::new()
+            .enter(|_| self.paint_plane_async(spec, async |window| f(window)))
+            .finish()
+    }
+
+    /// Prepare a plane scene for replay into the current one: its nested
+    /// groups join the frame's list (ids shifted), hoisted backdrops go first.
+    pub(super) fn adopt_scene(&mut self, mut inner: Scene) -> Scene {
+        inner.bind_record_segments(&self.next_frame.scene);
+        let hoisted = inner.take_backdrops();
+        let mut nested = std::mem::take(&mut inner.groups);
+        let base = self.next_frame.scene.groups.len() as u32;
+        if !nested.is_empty() {
+            inner.shift_group_ids(base);
+            for group in &mut nested {
+                group.scene.shift_group_ids(base);
+            }
+            self.next_frame.scene.groups.append(&mut nested);
+        }
+        self.next_frame.scene.adopt_backdrops(hoisted);
+        inner
+    }
+
+    /// Move a finished plane scene into the frame's group list (nested
+    /// groups first, as `paint_group` does); returns its group index.
+    fn push_plane_group(
+        &mut self,
+        mut inner: Scene,
+        projection: Option<[f32; 9]>,
+        polygon: Vec<Point<ScaledPixels>>,
+        fragments: Vec<Vec<Point<ScaledPixels>>>,
+    ) -> u32 {
+        let hoisted = inner.take_backdrops();
+        let mut nested = std::mem::take(&mut inner.groups);
+        let base = self.next_frame.scene.groups.len() as u32;
+        if !nested.is_empty() {
+            inner.shift_group_ids(base);
+            for group in &mut nested {
+                group.scene.shift_group_ids(base);
+            }
+            self.next_frame.scene.groups.append(&mut nested);
+        }
+        let index = self.next_frame.scene.groups.len() as u32;
+        let size = self.viewport_size.scale(self.scale_factor());
+        self.next_frame.scene.groups.push(PaintGroup {
+            scene: inner,
+            bounds: Bounds::new(Point::default(), size),
+            polygon,
+            projection,
+            fragments,
+            ..Default::default()
+        });
+        self.next_frame.scene.adopt_backdrops(hoisted);
+        index
+    }
+
+    fn insert_plane_mark(&mut self, index: u32, fragment: u32, mask: ContentMask<ScaledPixels>) {
+        self.next_frame.scene.insert_group_surface(
+            PaintSurface {
+                order: 0,
+                bounds: mask.bounds,
+                content_mask: mask,
+                corner_radii: Corners::default(),
+                blur_radius: 0.0,
+                group: index + 1,
+                opacity: 1.0,
+                color_matrix: None,
+                fragment,
+            },
+            self.content_mask_stack.len() == 1,
+        );
+    }
+}
diff --git a/vendor/gpui/src/window/plane3d/traversal.rs b/vendor/gpui/src/window/plane3d/traversal.rs
new file mode 100644
index 0000000000000000000000000000000000000000..3e93d88262c23a7bed03ac15a376ea5c888d481e
--- /dev/null
+++ b/vendor/gpui/src/window/plane3d/traversal.rs
@@ -0,0 +1,161 @@
+//! Продолжения композиции удерживают сцены до завершения дочернего обхода.
+
+use super::*;
+
+impl Window {
+    /// Paint `f` as one 3D rendering context: planes opened inside it
+    /// (`paint_plane`) are depth-sorted and split when it closes.
+    pub async fn paint_plane_context_async<R>(&mut self, f: impl AsyncFnOnce(&mut Self) -> R) -> R {
+        self.invalidator.debug_assert_paint();
+        let content_mask = self.content_mask().scale(self.scale_factor());
+        self.plane_contexts.push(PlaneContext {
+            pending: Vec::new(),
+            content_mask,
+        });
+        let (result, ctx) = self
+            .with_restore_async(
+                None,
+                |window, ctx| {
+                    *ctx = window.plane_contexts.pop();
+                },
+                async |window| window.with_paint_scope_async(f).await,
+            )
+            .await;
+        let Some(ctx) = ctx else { return result };
+        let records: Vec<PlaneRecord> = ctx.pending.into_iter().flatten().collect();
+        let mut polys = Vec::new();
+        for (i, rec) in records.iter().enumerate() {
+            if let Some((pts, _)) = near_clip(&rec.corners) {
+                let poly = PlanePoly::new(pts, i);
+                // Edge-on planes are invisible and must not split others.
+                if !poly.degenerate() {
+                    polys.push(poly);
+                }
+            }
+        }
+        let ordered = back_to_front(polys);
+        let mut pieces = vec![0usize; records.len()];
+        for p in &ordered {
+            pieces[p.owner] += 1;
+        }
+        let mut ids = vec![None; records.len()];
+        let mut inline: Vec<Option<Scene>> = (0..records.len()).map(|_| None).collect();
+        let mut first = vec![0u32; records.len()];
+        for (i, rec) in records.into_iter().enumerate() {
+            if pieces[i] == 0 {
+                continue;
+            }
+            let polygon = match near_clip(&rec.corners) {
+                Some((pts, true)) => to_points(&pts),
+                _ => Vec::new(),
+            };
+            // An affine plane that is neither cut nor clipped needs no
+            // buffer: its primitives are replayed straight into the frame at
+            // its place in the BSP order (byte-identical to painting it
+            // directly; a buffer would requantize glyph coverage).
+            if rec.projection.is_none() && pieces[i] == 1 && polygon.is_empty() {
+                inline[i] = Some(self.adopt_scene(rec.scene));
+                continue;
+            }
+            let fragments = if pieces[i] > 1 {
+                ordered
+                    .iter()
+                    .filter(|p| p.owner == i)
+                    .map(|p| to_points(&grow_box_edges(p)))
+                    .collect()
+            } else {
+                Vec::new()
+            };
+            ids[i] = Some(self.push_plane_group(rec.scene, rec.projection, polygon, fragments));
+        }
+        for p in &ordered {
+            if let Some(scene) = inline[p.owner].take() {
+                let ops = scene.paint_operations.len();
+                self.next_frame.scene.replay(0..ops, &scene);
+                continue;
+            }
+            let Some(id) = ids[p.owner] else { continue };
+            let fragment = if pieces[p.owner] > 1 {
+                first[p.owner] += 1;
+                first[p.owner]
+            } else {
+                0
+            };
+            self.insert_plane_mark(id, fragment, ctx.content_mask);
+        }
+        result
+    }
+
+    /// Paint `f` as one plane (see the module docs). Inside an open context
+    /// the plane is composited when the context closes; otherwise at once.
+    pub async fn paint_plane_async<R>(
+        &mut self,
+        spec: PlaneSpec,
+        f: impl AsyncFnOnce(&mut Self) -> R,
+    ) -> R {
+        self.invalidator.debug_assert_paint();
+        let slot = self.plane_contexts.last_mut().map(|c| {
+            c.pending.push(None);
+            c.pending.len() - 1
+        });
+        let depth = self.plane_contexts.len();
+        let content_mask = self.content_mask().scale(self.scale_factor());
+        let r = spec.raster.rotation_scale;
+        let keeps_axes = (r[0][1].abs() < 1e-4 && r[1][0].abs() < 1e-4)
+            || (r[0][0].abs() < 1e-4 && r[1][1].abs() < 1e-4);
+        let map = (spec.masked && keeps_axes).then_some(spec.raster);
+        let (result, mut scene) = self
+            .with_isolated_scene_async(async |window| {
+                let state = (
+                    mem::replace(&mut window.transformation_stack, vec![spec.raster]),
+                    mem::replace(&mut window.mask_map, map),
+                    mem::take(&mut window.content_mask_stack),
+                );
+                window
+                    .with_restore_async(
+                        state,
+                        |window, state| {
+                            mem::swap(&mut window.transformation_stack, &mut state.0);
+                            mem::swap(&mut window.mask_map, &mut state.1);
+                            mem::swap(&mut window.content_mask_stack, &mut state.2);
+                        },
+                        f,
+                    )
+                    .await
+                    .0
+            })
+            .await;
+        scene.finish();
+        let mut rect = spec.rect;
+        if let Some((ix0, iy0, ix1, iy1)) = ink_bounds(&scene, spec.raster) {
+            rect = (
+                rect.0.min(ix0),
+                rect.1.min(iy0),
+                rect.2.max(ix1),
+                rect.3.max(iy1),
+            );
+        }
+        let record = PlaneRecord {
+            scene,
+            projection: spec.projection,
+            corners: plane_corners(&spec.full, spec.outer, rect),
+        };
+        match slot {
+            Some(i) if self.plane_contexts.len() == depth => {
+                if let Some(ctx) = self.plane_contexts.last_mut() {
+                    ctx.pending[i] = Some(record);
+                }
+            }
+            _ => {
+                let Some((pts, clipped)) = near_clip(&record.corners) else {
+                    return result;
+                };
+                let polygon = if clipped { to_points(&pts) } else { Vec::new() };
+                let id =
+                    self.push_plane_group(record.scene, record.projection, polygon, Vec::new());
+                self.insert_plane_mark(id, 0, content_mask);
+            }
+        }
+        result
+    }
+}
diff --git a/vendor/gpui/src/window/prepaint_transaction.rs b/vendor/gpui/src/window/prepaint_transaction.rs
new file mode 100644
index 0000000000000000000000000000000000000000..a941f3b21f23a96273782996529d873e50f4619d
--- /dev/null
+++ b/vendor/gpui/src/window/prepaint_transaction.rs
@@ -0,0 +1,52 @@
+//! Пробный prepaint откатывает те же записи при синхронном и lending-вызове.
+use super::*;
+
+struct Transaction<'a> {
+    window: &'a mut Window,
+    index: Option<PrepaintStateIndex>,
+}
+impl Drop for Transaction<'_> {
+    fn drop(&mut self) {
+        if let Some(index) = self.index.take() {
+            self.window.rollback_prepaint(index);
+        }
+    }
+}
+impl Window {
+    pub(super) fn rollback_prepaint(&mut self, index: PrepaintStateIndex) {
+        self.next_frame.hitboxes.truncate(index.hitboxes_index);
+        self.next_frame
+            .hitbox_entry_scopes
+            .retain(|entry, _| *entry < index.hitboxes_index);
+        self.next_frame
+            .tooltip_requests
+            .truncate(index.tooltips_index);
+        self.next_frame
+            .deferred_draws
+            .truncate(index.deferred_draws_index);
+        self.next_frame
+            .dispatch_tree
+            .truncate(index.dispatch_tree_index);
+        self.next_frame
+            .accessed_element_states
+            .truncate(index.accessed_element_states_index);
+        self.text_system.truncate_layouts(index.line_layout_index);
+    }
+    /// Perform a retryable prepaint while sharing its descendant traversal stack.
+    pub async fn transact_async<T, U>(
+        &mut self,
+        f: impl AsyncFnOnce(&mut Self) -> Result<T, U>,
+    ) -> Result<T, U> {
+        self.invalidator.debug_assert_prepaint();
+        let index = Some(self.prepaint_index());
+        let mut transaction = Transaction {
+            window: self,
+            index,
+        };
+        let result = f(transaction.window).await;
+        if result.is_ok() {
+            transaction.index = None;
+        }
+        result
+    }
+}
diff --git a/vendor/gpui/src/window/prompts.rs b/vendor/gpui/src/window/prompts.rs
new file mode 100644
index 0000000000000000000000000000000000000000..980c6f6812405a8fbf4f8c6e24388ab4f967a94c
--- /dev/null
+++ b/vendor/gpui/src/window/prompts.rs
@@ -0,0 +1,232 @@
+use std::ops::Deref;
+
+use futures::channel::oneshot;
+
+use crate::{
+    AnyView, App, AppContext as _, Context, Entity, EventEmitter, FocusHandle, Focusable,
+    InteractiveElement, IntoElement, ParentElement, PromptButton, PromptLevel, Render,
+    StatefulInteractiveElement, Styled, div, opaque_grey, white,
+};
+
+use super::Window;
+
+/// The event emitted when a prompt's option is selected.
+/// The usize is the index of the selected option, from the actions
+/// passed to the prompt.
+pub struct PromptResponse(pub usize);
+
+/// A prompt that can be rendered in the window.
+pub trait Prompt: EventEmitter<PromptResponse> + Focusable {}
+
+impl<V: EventEmitter<PromptResponse> + Focusable> Prompt for V {}
+
+/// A handle to a prompt that can be used to interact with it.
+pub struct PromptHandle {
+    sender: oneshot::Sender<usize>,
+}
+
+impl PromptHandle {
+    pub(crate) fn new(sender: oneshot::Sender<usize>) -> Self {
+        Self { sender }
+    }
+
+    /// Construct a new prompt handle from a view of the appropriate types
+    pub fn with_view<V: Prompt + Render>(
+        self,
+        view: Entity<V>,
+        window: &mut Window,
+        cx: &mut App,
+    ) -> RenderablePromptHandle {
+        let mut sender = Some(self.sender);
+        let previous_focus = window.focused(cx);
+        let window_handle = window.window_handle();
+        cx.subscribe(&view, move |_: Entity<V>, e: &PromptResponse, cx| {
+            if let Some(sender) = sender.take() {
+                sender.send(e.0).ok();
+                window_handle
+                    .update(cx, |_, window, cx| {
+                        window.prompt.take();
+                        if let Some(previous_focus) = &previous_focus {
+                            window.focus(previous_focus, cx);
+                        }
+                    })
+                    .ok();
+            }
+        })
+        .detach();
+
+        window.focus(&view.focus_handle(cx), cx);
+
+        RenderablePromptHandle {
+            view: Box::new(view),
+        }
+    }
+}
+
+/// A prompt handle capable of being rendered in a window.
+pub struct RenderablePromptHandle {
+    pub(crate) view: Box<dyn PromptViewHandle>,
+}
+
+/// Use this function in conjunction with [App::set_prompt_builder] to force
+/// GPUI to always use the fallback prompt renderer.
+pub fn fallback_prompt_renderer(
+    level: PromptLevel,
+    message: &str,
+    detail: Option<&str>,
+    actions: &[PromptButton],
+    handle: PromptHandle,
+    window: &mut Window,
+    cx: &mut App,
+) -> RenderablePromptHandle {
+    let renderer = cx.new(|cx| FallbackPromptRenderer {
+        _level: level,
+        message: message.to_string(),
+        detail: detail.map(ToString::to_string),
+        actions: actions.to_vec(),
+        focus: cx.focus_handle(),
+    });
+
+    handle.with_view(renderer, window, cx)
+}
+
+/// The default GPUI fallback for rendering prompts, when the platform doesn't support it.
+pub struct FallbackPromptRenderer {
+    _level: PromptLevel,
+    message: String,
+    detail: Option<String>,
+    actions: Vec<PromptButton>,
+    focus: FocusHandle,
+}
+
+impl Render for FallbackPromptRenderer {
+    fn render(&mut self, _: &mut Window, cx: &mut Context<Self>) -> impl IntoElement {
+        let prompt = div()
+            .cursor_default()
+            .track_focus(&self.focus)
+            .w_72()
+            .bg(white())
+            .rounded_lg()
+            .overflow_hidden()
+            .p_3()
+            .child(
+                div()
+                    .w_full()
+                    .flex()
+                    .flex_row()
+                    .justify_around()
+                    .child(div().overflow_hidden().child(self.message.clone())),
+            )
+            .children(self.detail.clone().map(|detail| {
+                div()
+                    .w_full()
+                    .flex()
+                    .flex_row()
+                    .justify_around()
+                    .text_sm()
+                    .mb_2()
+                    .child(div().child(detail))
+            }))
+            .children(self.actions.iter().enumerate().map(|(ix, action)| {
+                div()
+                    .flex()
+                    .flex_row()
+                    .justify_around()
+                    .border_1()
+                    .border_color(opaque_grey(0.2, 0.5))
+                    .mt_1()
+                    .rounded_xs()
+                    .cursor_pointer()
+                    .text_sm()
+                    .child(action.label().clone())
+                    .id(ix)
+                    .on_click(cx.listener(move |_, _, _, cx| {
+                        cx.emit(PromptResponse(ix));
+                        cx.stop_propagation();
+                    }))
+            }));
+
+        div()
+            .size_full()
+            .child(
+                div()
+                    .size_full()
+                    .bg(opaque_grey(0.5, 0.6))
+                    .absolute()
+                    .top_0()
+                    .left_0(),
+            )
+            .child(
+                div()
+                    .size_full()
+                    .absolute()
+                    .top_0()
+                    .left_0()
+                    .flex()
+                    .flex_col()
+                    .justify_around()
+                    .child(
+                        div()
+                            .w_full()
+                            .flex()
+                            .flex_row()
+                            .justify_around()
+                            .child(prompt),
+                    ),
+            )
+    }
+}
+
+impl EventEmitter<PromptResponse> for FallbackPromptRenderer {}
+
+impl Focusable for FallbackPromptRenderer {
+    fn focus_handle(&self, _: &crate::App) -> FocusHandle {
+        self.focus.clone()
+    }
+}
+
+pub(crate) trait PromptViewHandle {
+    fn any_view(&self) -> AnyView;
+}
+
+impl<V: Prompt + Render> PromptViewHandle for Entity<V> {
+    fn any_view(&self) -> AnyView {
+        self.clone().into()
+    }
+}
+
+pub(crate) enum PromptBuilder {
+    Default,
+    Custom(
+        Box<
+            dyn Fn(
+                PromptLevel,
+                &str,
+                Option<&str>,
+                &[PromptButton],
+                PromptHandle,
+                &mut Window,
+                &mut App,
+            ) -> RenderablePromptHandle,
+        >,
+    ),
+}
+
+impl Deref for PromptBuilder {
+    type Target = dyn Fn(
+        PromptLevel,
+        &str,
+        Option<&str>,
+        &[PromptButton],
+        PromptHandle,
+        &mut Window,
+        &mut App,
+    ) -> RenderablePromptHandle;
+
+    fn deref(&self) -> &Self::Target {
+        match self {
+            Self::Default => &fallback_prompt_renderer,
+            Self::Custom(f) => f.as_ref(),
+        }
+    }
+}
diff --git a/vendor/gpui/src/window/raster_frame.rs b/vendor/gpui/src/window/raster_frame.rs
new file mode 100644
index 0000000000000000000000000000000000000000..bc58113f146f236fc2ec37947d0ece68c6309982
--- /dev/null
+++ b/vendor/gpui/src/window/raster_frame.rs
@@ -0,0 +1,76 @@
+//! Точная геометрия и непрозрачные данные raster consumers без правил хозяина.
+
+use super::*;
+
+/// Явная raster-геометрия и данные хозяина без выбора подложки или заливки.
+#[derive(Clone, Debug, Default, PartialEq)]
+pub struct RasterFrame {
+    /// Логическое смещение глифов перед масштабированием в пиксели устройства.
+    pub glyph_offset: Point<Pixels>,
+    /// Матрица размещения и соответствующая точная матрица заливки.
+    pub fill_transform: Option<(TransformationMatrix, TransformationMatrix)>,
+    /// Округлённые и точные границы рисуемого бокса.
+    pub exact_bounds: Option<(Bounds<Pixels>, Bounds<Pixels>)>,
+    pub(super) contexts: render_context::Snapshot,
+}
+
+impl RasterFrame {
+    /// Создание геометрии без точного бокса и данных хозяина.
+    pub fn new(
+        glyph_offset: Point<Pixels>,
+        fill_transform: Option<(TransformationMatrix, TransformationMatrix)>,
+    ) -> Self {
+        Self {
+            glyph_offset,
+            fill_transform,
+            ..Self::default()
+        }
+    }
+
+    /// Чтение непрозрачных raster-данных с сохранением идентичности Rc.
+    pub fn context<T: std::any::Any>(&self) -> Option<Rc<T>> {
+        self.contexts.get()
+    }
+
+    /// Установка данных хозяина; клоны frame сохраняют тот же Rc.
+    pub fn set_context<T: std::any::Any>(&mut self, value: Option<Rc<T>>) {
+        self.contexts.set(value);
+    }
+}
+
+impl Window {
+    /// Чтение raster-геометрии и данных без интерпретации правил хозяина.
+    pub fn raster_frame(&self) -> &RasterFrame {
+        &self.raster_frame
+    }
+
+    /// Чтение текущего контекста хозяина без клонирования всего frame.
+    pub fn raster_context<T: std::any::Any>(&self) -> Option<Rc<T>> {
+        self.raster_frame.context()
+    }
+
+    /// Область данных хозяина сохраняет остальные поля общего raster frame.
+    pub fn with_raster_context<T: std::any::Any, R>(
+        &mut self,
+        value: Option<Rc<T>>,
+        f: impl FnOnce(&mut Self) -> R,
+    ) -> R {
+        let previous = self.raster_frame.contexts.replace(value);
+        self.with_restore(previous, |window, previous| {
+            window.raster_frame.contexts.set(previous.take());
+        }, f).0
+    }
+
+    /// Применение raster-данных с восстановлением вызывающего при unwind.
+    pub fn with_raster_frame<R>(
+        &mut self,
+        mut frame: RasterFrame,
+        f: impl FnOnce(&mut Self) -> R,
+    ) -> R {
+        fn swap(window: &mut Window, frame: &mut RasterFrame) {
+            mem::swap(&mut window.raster_frame, frame);
+        }
+        swap(self, &mut frame);
+        self.with_restore(frame, swap, f).0
+    }
+}
diff --git a/vendor/gpui/src/window/render_context.rs b/vendor/gpui/src/window/render_context.rs
new file mode 100644
index 0000000000000000000000000000000000000000..92a6535e1c1aca02cd1446d39f5bc2340a43bfb1
--- /dev/null
+++ b/vendor/gpui/src/window/render_context.rs
@@ -0,0 +1,226 @@
+//! Window-owned typed traversal scopes and snapshots for deferred drawing.
+// KaminIDE patch: pass host paint/prepaint context through GPUI without thread-local state.
+
+use std::any::{Any, TypeId};
+use std::cell::RefCell;
+use std::collections::HashMap;
+use std::rc::Rc;
+
+type Values = HashMap<TypeId, Rc<dyn Any>>;
+
+#[derive(Clone, Default)]
+pub(super) struct Snapshot(Values);
+
+impl Snapshot {
+    pub(super) fn get<T: Any>(&self) -> Option<Rc<T>> {
+        self.0.get(&TypeId::of::<T>()).cloned()?.downcast().ok()
+    }
+
+    pub(super) fn set<T: Any>(&mut self, value: Option<Rc<T>>) {
+        self.replace(value);
+    }
+
+    pub(super) fn replace<T: Any>(&mut self, value: Option<Rc<T>>) -> Option<Rc<T>> {
+        let id = TypeId::of::<T>();
+        let previous = match value {
+            Some(value) => self.0.insert(id, value),
+            None => self.0.remove(&id),
+        };
+        previous?.downcast().ok()
+    }
+}
+
+impl std::fmt::Debug for Snapshot {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.debug_set().entries(self.0.keys()).finish()
+    }
+}
+
+impl PartialEq for Snapshot {
+    fn eq(&self, other: &Self) -> bool {
+        self.0.len() == other.0.len()
+            && self.0.iter().all(|(id, value)| {
+                other.0.get(id).is_some_and(|other| Rc::ptr_eq(value, other))
+            })
+    }
+}
+
+#[derive(Clone, Default)]
+pub(super) struct RenderContexts(Rc<RefCell<Values>>);
+
+impl RenderContexts {
+    pub(super) fn snapshot(&self) -> Snapshot {
+        Snapshot(self.0.borrow().clone())
+    }
+
+    pub(super) fn enter_snapshot(&self, snapshot: Snapshot) -> SnapshotScope {
+        let previous = std::mem::replace(&mut *self.0.borrow_mut(), snapshot.0);
+        SnapshotScope {
+            values: self.0.clone(),
+            previous,
+        }
+    }
+
+    pub(super) fn get<T: Any>(&self) -> Option<Rc<T>> {
+        self.0
+            .borrow()
+            .get(&TypeId::of::<T>())
+            .cloned()?
+            .downcast()
+            .ok()
+    }
+
+    pub(super) fn enter<T: Any>(&self, value: Option<Rc<T>>) -> Scope {
+        let id = TypeId::of::<T>();
+        let previous = match value {
+            Some(value) => self.0.borrow_mut().insert(id, value),
+            None => self.0.borrow_mut().remove(&id),
+        };
+        Scope {
+            values: self.0.clone(),
+            id,
+            previous,
+        }
+    }
+}
+
+pub(super) struct SnapshotScope {
+    values: Rc<RefCell<Values>>,
+    previous: Values,
+}
+
+impl Drop for SnapshotScope {
+    fn drop(&mut self) {
+        *self.values.borrow_mut() = std::mem::take(&mut self.previous);
+    }
+}
+
+pub(super) struct Scope {
+    values: Rc<RefCell<Values>>,
+    id: TypeId,
+    previous: Option<Rc<dyn Any>>,
+}
+
+impl Drop for Scope {
+    fn drop(&mut self) {
+        let mut values = self.values.borrow_mut();
+        match self.previous.take() {
+            Some(previous) => {
+                values.insert(self.id, previous);
+            }
+            None => {
+                values.remove(&self.id);
+            }
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn nested_scope_restores_the_same_outer_value() {
+        let contexts = RenderContexts::default();
+        let outer = Rc::new(17u32);
+        let _outer = contexts.enter(Some(outer.clone()));
+        {
+            let _inner = contexts.enter(Some(Rc::new(23u32)));
+            assert_eq!(*contexts.get::<u32>().unwrap(), 23);
+        }
+        assert!(Rc::ptr_eq(&contexts.get::<u32>().unwrap(), &outer));
+    }
+
+    #[test]
+    fn unrelated_context_types_coexist() {
+        let contexts = RenderContexts::default();
+        let _number = contexts.enter(Some(Rc::new(17u32)));
+        {
+            let _text = contexts.enter(Some(Rc::new(String::from("fragment"))));
+            assert_eq!(*contexts.get::<u32>().unwrap(), 17);
+            assert_eq!(&*contexts.get::<String>().unwrap(), "fragment");
+        }
+        assert!(contexts.get::<String>().is_none());
+        assert_eq!(*contexts.get::<u32>().unwrap(), 17);
+    }
+
+    #[test]
+    fn empty_scope_temporarily_hides_the_parent() {
+        let contexts = RenderContexts::default();
+        let _outer = contexts.enter(Some(Rc::new(17u32)));
+        {
+            let _hidden = contexts.enter::<u32>(None);
+            assert!(contexts.get::<u32>().is_none());
+        }
+        assert_eq!(*contexts.get::<u32>().unwrap(), 17);
+    }
+
+    #[test]
+    fn windows_have_independent_contexts() {
+        let first = RenderContexts::default();
+        let second = RenderContexts::default();
+        let _scope = first.enter(Some(Rc::new(17u32)));
+        assert!(second.get::<u32>().is_none());
+        let _scope = second.enter(Some(Rc::new(23u32)));
+        assert_eq!(*first.get::<u32>().unwrap(), 17);
+        assert_eq!(*second.get::<u32>().unwrap(), 23);
+    }
+
+    #[test]
+    fn unwinding_restores_the_parent() {
+        let contexts = RenderContexts::default();
+        let _outer = contexts.enter(Some(Rc::new(17u32)));
+        let result = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
+            let _inner = contexts.enter(Some(Rc::new(23u32)));
+            panic!("host traversal failed");
+        }));
+        assert!(result.is_err());
+        assert_eq!(*contexts.get::<u32>().unwrap(), 17);
+    }
+
+    #[test]
+    fn finished_scope_releases_values_and_keys() {
+        let contexts = RenderContexts::default();
+        let value = Rc::new(17u32);
+        let weak = Rc::downgrade(&value);
+        {
+            let _scope = contexts.enter(Some(value));
+            assert!(weak.upgrade().is_some());
+        }
+        assert!(weak.upgrade().is_none());
+        assert!(contexts.0.borrow().is_empty());
+    }
+
+    #[test]
+    fn captured_context_survives_its_scope_and_restores_the_caller() {
+        let contexts = RenderContexts::default();
+        let saved = {
+            let _scope = contexts.enter(Some(Rc::new(17u32)));
+            contexts.snapshot()
+        };
+        let _scope = contexts.enter(Some(Rc::new(23u32)));
+        let _other = contexts.enter(Some(Rc::new(String::from("caller"))));
+        {
+            let _replay = contexts.enter_snapshot(saved);
+            assert_eq!(*contexts.get::<u32>().unwrap(), 17);
+            assert!(contexts.get::<String>().is_none());
+            let _nested = contexts.enter(Some(Rc::new(29u32)));
+            assert_eq!(*contexts.get::<u32>().unwrap(), 29);
+        }
+        assert_eq!(*contexts.get::<u32>().unwrap(), 23);
+        assert_eq!(&*contexts.get::<String>().unwrap(), "caller");
+    }
+
+    #[test]
+    fn unwinding_a_replay_restores_the_callers_context() {
+        let contexts = RenderContexts::default();
+        let _scope = contexts.enter(Some(Rc::new(17u32)));
+        let result = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
+            let _replay = contexts.enter_snapshot(Snapshot::default());
+            assert!(contexts.get::<u32>().is_none());
+            panic!("deferred traversal failed");
+        }));
+        assert!(result.is_err());
+        assert_eq!(*contexts.get::<u32>().unwrap(), 17);
+    }
+}
diff --git a/vendor/gpui/src/window/retained.rs b/vendor/gpui/src/window/retained.rs
new file mode 100644
index 0000000000000000000000000000000000000000..a972fc30ab10e3b88e6efba839e55d04936fbc07
--- /dev/null
+++ b/vendor/gpui/src/window/retained.rs
@@ -0,0 +1,391 @@
+//! KaminIDE patch: host-keyed retained subtrees across frames.
+//!
+//! Entity views are cached by `Context::notify`; a host engine that owns its
+//! own invalidation (a document with dirty bits) needs the same reuse keyed by
+//! its inputs instead. The host records the prepaint and paint index ranges of
+//! a subtree, stores them in element state (which only survives a frame in
+//! which it was accessed), and replays them while every input it keys on is
+//! unchanged. GPUI reports which recorded ranges are replayable at all and the
+//! window inputs (events, focus) the host cannot observe itself.
+
+use super::*;
+mod continuation;
+
+/// Prepaint output of a subtree in the frame that recorded it.
+#[derive(Clone, Default)]
+pub struct RetainedPrepaint(Range<PrepaintStateIndex>);
+
+/// Paint output of a subtree in the frame that recorded it.
+#[derive(Clone, Default)]
+pub struct RetainedPaint {
+    range: Range<PaintIndex>,
+    replayable: bool,
+}
+
+impl RetainedPaint {
+    /// Whether these commands can be copied into a later frame unchanged.
+    /// Composition groups live outside the command list (`Scene::groups`) and
+    /// isolated scenes are discarded by their owner, so neither replays.
+    pub fn replayable(&self) -> bool {
+        self.replayable
+    }
+
+    /// Extend this output by `next`, recorded right after it in the same
+    /// frame: one replay of the joined range copies exactly the commands of
+    /// both, in order. `false` leaves this output unchanged when `next` does
+    /// not start where this one ends.
+    pub fn append(&mut self, next: &RetainedPaint) -> bool {
+        if self.range.end != next.range.start {
+            return false;
+        }
+        self.range.end = next.range.end.clone();
+        self.replayable &= next.replayable;
+        true
+    }
+}
+
+impl Window {
+    /// Whether the current element draws in window coordinates without an
+    /// enclosing transform, opacity, mask, 3D plane, composition group or
+    /// segment capture: replayed commands carry their environment baked in.
+    pub fn retained_root_environment(&self) -> bool {
+        self.transformation_stack.is_empty()
+            && self.element_opacity == 1.0
+            && self.mask_map.is_none()
+            && self.mask_scale.is_none()
+            && self.plane_contexts.is_empty()
+            && self.exact_element_offset_depth == 0
+            && !self.next_frame.scene.in_group
+            && self.next_frame.scene.segment_capture.is_none()
+    }
+
+    /// Counter of window inputs that can change element state without the
+    /// host's knowledge: dispatched platform events and focus changes.
+    pub fn interaction_epoch(&self) -> u64 {
+        self.interaction_epoch
+    }
+
+    /// Callbacks scheduled for the next frame so far in this draw. A subtree
+    /// that adds one (animation frames, deferred notifications) is not settled.
+    pub fn next_frame_callback_count(&self) -> usize {
+        self.next_frame_callbacks.borrow().len()
+    }
+
+    /// Number of frames this window has drawn. A record made while drawing
+    /// frame `n` replays only while `frame_serial() == n + 1`, i.e. while the
+    /// frame it was made in is the rendered one.
+    pub fn frame_serial(&self) -> u64 {
+        self.frame_serial
+    }
+
+    /// Copy the prepaint output recorded in the previous frame into this one.
+    /// The caller guarantees the record comes from the rendered frame.
+    pub fn replay_retained_prepaint(&mut self, record: &RetainedPrepaint) -> RetainedPrepaint {
+        let start = self.prepaint_index();
+        self.reuse_prepaint(record.0.clone());
+        RetainedPrepaint(start..self.prepaint_index())
+    }
+
+    /// Whether a record made in the rendered frame can be replayed into this
+    /// one. Deferred draws paint after the whole tree, outside the subtree's
+    /// paint range, and nested deferred draws are appended after their owner;
+    /// when the subtree registered any, every deferred draw from its first one
+    /// on must be free of composition groups.
+    pub fn retained_replayable(&self, prepaint: &RetainedPrepaint, paint: &RetainedPaint) -> bool {
+        use crate::scene::{PaintOperation, Primitive};
+        let frame = &self.rendered_frame;
+        let first = prepaint.0.start.deferred_draws_index;
+        let groups = |draw: &DeferredDraw| {
+            let range = draw.paint_range.start.scene_index..draw.paint_range.end.scene_index;
+            frame.scene.paint_operations[range].iter().any(|operation| {
+                matches!(
+                    operation,
+                    PaintOperation::Primitive(Primitive::Surface(surface)) if surface.group > 0
+                )
+            })
+        };
+        paint.replayable
+            && (first == prepaint.0.end.deferred_draws_index
+                || !frame.deferred_draws[first..].iter().any(groups))
+    }
+
+    /// Copy replayable paint output recorded in the previous frame into this one.
+    /// The caller guarantees the record comes from the rendered frame.
+    pub fn replay_retained_paint(&mut self, record: &RetainedPaint) -> RetainedPaint {
+        debug_assert!(record.replayable, "non-replayable paint record");
+        let start = self.paint_index();
+        self.reuse_paint(record.range.clone());
+        RetainedPaint {
+            range: start..self.paint_index(),
+            replayable: true,
+        }
+    }
+}
+
+/// KaminIDE patch: placed bounds of everything a retained subtree offered to
+/// the scene in one frame, culled primitives included, in device pixels.
+///
+/// A host that skips a settled subtree may do so only where every primitive
+/// of the subtree would be culled; the sink measures that ink while the
+/// subtree paints. Paint deferred past the subtree (`Window::paint_ctx`
+/// snapshots) keeps feeding the sinks open at capture. A sink is tainted when
+/// a scope it observes does more than offer primitives: input state, element
+/// state, composition groups, a non-root paint environment, accessibility.
+#[derive(Default)]
+pub struct InkSink {
+    bounds: std::cell::Cell<Option<Bounds<ScaledPixels>>>,
+    tainted: std::cell::Cell<bool>,
+}
+
+impl InkSink {
+    pub(crate) fn add(&self, bounds: Bounds<ScaledPixels>) {
+        self.bounds.set(Some(match self.bounds.get() {
+            Some(ink) => ink.union(&bounds),
+            None => bounds,
+        }));
+    }
+
+    /// Union of the placed bounds offered so far; `None` when nothing painted.
+    pub fn bounds(&self) -> Option<Bounds<ScaledPixels>> {
+        self.bounds.get()
+    }
+
+    /// Whether an observed scope had effects beyond offering primitives.
+    pub fn tainted(&self) -> bool {
+        self.tainted.get()
+    }
+}
+
+/// Paint effects of a scope observed by open ink sinks.
+pub(crate) struct InkProbe {
+    start: PaintIndex,
+    groups: usize,
+    callbacks: usize,
+    allowed: (usize, usize),
+    clean: bool,
+}
+
+impl InkProbe {
+    pub(crate) fn open(window: &Window) -> Option<Self> {
+        (!window.next_frame.scene.ink.is_empty()).then(|| Self {
+            start: window.paint_index(),
+            groups: window.next_frame.scene.groups.len(),
+            callbacks: window.next_frame_callback_count(),
+            allowed: window.next_frame.scene.ink_allowed,
+            clean: window.retained_root_environment() && !window.a11y.is_active(),
+        })
+    }
+
+    pub(crate) fn close(self, window: &Window) {
+        let end = window.paint_index();
+        let start = &self.start;
+        let allowed = window.next_frame.scene.ink_allowed;
+        let quiet = self.clean
+            && end.mouse_listeners_index - start.mouse_listeners_index
+                == allowed.0 - self.allowed.0
+            && start.input_handlers_index == end.input_handlers_index
+            && start.cursor_styles_index == end.cursor_styles_index
+            && end.accessed_element_states_index - start.accessed_element_states_index
+                == allowed.1 - self.allowed.1
+            && start.tab_handle_index == end.tab_handle_index
+            && self.groups == window.next_frame.scene.groups.len()
+            && self.callbacks == window.next_frame_callback_count();
+        if !quiet {
+            for sink in &window.next_frame.scene.ink {
+                sink.tainted.set(true);
+            }
+        }
+    }
+}
+
+impl RetainedPrepaint {
+    /// Whether the recorded prepaint registered nothing a later frame could
+    /// miss: no tooltips, deferred draws or element state, and only plain
+    /// hitboxes. Returns the union of those hitboxes (`Some(None)` for none):
+    /// a frame that skips the subtree misses them only where they lie outside
+    /// the content mask, where they could not be hit.
+    pub fn quiet(&self, window: &Window) -> Option<Option<Bounds<Pixels>>> {
+        let (start, end) = (&self.0.start, &self.0.end);
+        let frame = &window.next_frame;
+        let hitboxes = frame
+            .hitboxes
+            .get(start.hitboxes_index..end.hitboxes_index)?;
+        let plain = hitboxes
+            .iter()
+            .zip(start.hitboxes_index..)
+            .all(|(hitbox, index)| {
+                hitbox.behavior == crate::HitboxBehavior::Normal
+                    && !frame.hitbox_scopes.contains_key(&hitbox.id)
+                    && !frame.hitbox_entry_scopes.contains_key(&index)
+            });
+        let quiet = plain
+            && start.tooltips_index == end.tooltips_index
+            && start.deferred_draws_index == end.deferred_draws_index
+            && start.accessed_element_states_index == end.accessed_element_states_index;
+        quiet.then(|| {
+            hitboxes
+                .iter()
+                .map(|hitbox| hitbox.bounds)
+                .reduce(|a, b| a.union(&b))
+        })
+    }
+}
+
+/// KaminIDE patch: the layout nodes one subtree requested in a pass
+/// (`Window::capture_layout`). A later pass that keeps the root's stamp can
+/// claim them whole (`Window::request_retained_layout`) instead of requesting
+/// every node again: the subtree's elements need not be built.
+#[derive(Clone)]
+pub struct RetainedSubtree {
+    stamp: u64,
+    nodes: Rc<[::taffy::tree::NodeId]>,
+}
+
+impl RetainedSubtree {
+    /// Number of layout nodes in the subtree.
+    pub fn len(&self) -> usize {
+        self.nodes.len()
+    }
+
+    /// Whether the subtree has no nodes (never: the root is one).
+    pub fn is_empty(&self) -> bool {
+        self.nodes.is_empty()
+    }
+}
+
+/// KaminIDE patch: an exact layout leaf standing in for a laid out subtree
+/// (`Window::layout_snapshot`), valid at the device scale it was taken at.
+#[derive(Clone, Copy)]
+pub struct LayoutSnapshot {
+    leaf: crate::taffy::ExactLeaf,
+    scale: f32,
+}
+
+impl LayoutSnapshot {
+    /// Device scale of the layout the snapshot was taken from.
+    pub fn scale(&self) -> f32 {
+        self.scale
+    }
+
+    /// Border-box width of the snapshot leaf, in logical pixels; for an
+    /// unpainted box ([`Window::layout_snapshot_unpainted`]) at least the
+    /// width of its content.
+    pub fn width(&self) -> f32 {
+        self.leaf.width() / self.scale
+    }
+
+    /// The same leaf with its width left to the parent: the stretch-fit
+    /// width of a block-level box (CSS2 §10.3.3), for a host that knows the
+    /// subtree's height and overflow do not depend on that width.
+    pub fn stretched(self) -> Self {
+        Self { leaf: self.leaf.stretched(), ..self }
+    }
+}
+
+impl Window {
+    /// Paint `f` with `sink` measuring its ink (see [`InkSink`]).
+    pub fn with_ink_sink<R>(&mut self, sink: Rc<InkSink>, f: impl FnOnce(&mut Self) -> R) -> R {
+        self.next_frame.scene.ink.push(sink);
+        let probe = InkProbe::open(self);
+        let result = f(self);
+        if let Some(probe) = probe {
+            probe.close(self);
+        }
+        self.next_frame.scene.ink.pop();
+        result
+    }
+
+    /// Run paint `f`, which reports whether its mouse listeners and element
+    /// state reads are inert while nothing it guards is visible: listeners
+    /// that act only on a hit of a hitbox under the mouse or on a gesture the
+    /// state records, and state that is at its default. Open ink sinks then
+    /// allow those effects; otherwise they are tainted.
+    pub fn offscreen_inert<R>(&mut self, f: impl FnOnce(&mut Self) -> (R, bool)) -> R {
+        if self.next_frame.scene.ink.is_empty() {
+            return f(self).0;
+        }
+        let start = self.paint_index();
+        let (result, inert) = f(self);
+        let end = self.paint_index();
+        let scene = &mut self.next_frame.scene;
+        if inert {
+            scene.ink_allowed.0 += end.mouse_listeners_index - start.mouse_listeners_index;
+            scene.ink_allowed.1 +=
+                end.accessed_element_states_index - start.accessed_element_states_index;
+        } else {
+            for sink in &scene.ink {
+                sink.tainted.set(true);
+            }
+        }
+        result
+    }
+
+    /// The exact leaf of the laid out node `id`: an inflexible normal-flow item
+    /// of a single-line column flex container, or a block-level box of a block
+    /// container whose descendant margins do not adjoin its edges, whose
+    /// overflow stays inside its border box. `None` when the node does not
+    /// qualify. The snapshot is a few numbers (`Copy`).
+    pub fn layout_snapshot(&self, id: LayoutId) -> Option<LayoutSnapshot> {
+        let leaf = self.layout_engine.as_ref()?.exact_leaf(id)?;
+        Some(LayoutSnapshot {
+            leaf,
+            scale: self.scale_factor(),
+        })
+    }
+
+    /// The exact leaf of a laid out node that paints nothing of its own and
+    /// holds its content at its inline-start edge whatever its width (an
+    /// anonymous wrapper box; the caller guarantees both). Unlike
+    /// [`Self::layout_snapshot`] its content may overflow its inline-end edge:
+    /// the leaf takes the parent's stretch fit, at least the content's width
+    /// ([`LayoutSnapshot::width`]), which the parent places and unions into
+    /// its scrollable overflow exactly like the node with its content.
+    pub fn layout_snapshot_unpainted(&self, id: LayoutId) -> Option<LayoutSnapshot> {
+        let leaf = self.layout_engine.as_ref()?.unpainted_leaf(id)?;
+        Some(LayoutSnapshot { leaf, scale: self.scale_factor() })
+    }
+
+    /// Position in this pass's layout requests; pass it to `capture_layout`
+    /// after requesting a subtree.
+    pub fn layout_request_position(&self) -> usize {
+        self.layout_engine
+            .as_ref()
+            .map_or(0, |engine| engine.request_position())
+    }
+
+    /// The nodes of the subtree `root` requested since `start`, when the frame
+    /// tree keeps them (`None` otherwise).
+    pub fn capture_layout(&mut self, start: usize, root: LayoutId) -> Option<RetainedSubtree> {
+        let (stamp, nodes) = self.layout_engine.as_mut()?.capture_subtree(start, root)?;
+        Some(RetainedSubtree { stamp, nodes })
+    }
+
+    /// Claim a subtree captured in the previous pass whole. `None` when a node
+    /// of it changed or was dropped. Its leaves are not measured again: if the
+    /// layout needs a new measurement, `layout_stale` reports it after
+    /// `compute_layout`, and the caller must discard this layout (the frame
+    /// tree drops itself at the end of such a pass).
+    pub fn request_retained_layout(&mut self, layout: &RetainedSubtree) -> Option<LayoutId> {
+        self.invalidator.debug_assert_prepaint();
+        self.layout_engine
+            .as_mut()?
+            .claim_subtree(layout.stamp, &layout.nodes)
+    }
+
+    /// Whether this pass measured a leaf of a subtree claimed whole.
+    pub fn layout_stale(&self) -> bool {
+        self.layout_engine
+            .as_ref()
+            .is_some_and(|engine| engine.layout_stale())
+    }
+
+    /// Request the leaf of `snapshot` in this frame's layout. The caller
+    /// guarantees the device scale and the parent are those of the snapshot.
+    pub fn request_snapshot_layout(&mut self, snapshot: &LayoutSnapshot) -> LayoutId {
+        self.invalidator.debug_assert_prepaint();
+        self.layout_engine
+            .as_mut()
+            .expect("layout engine during request_layout")
+            .request_exact_leaf(&snapshot.leaf)
+    }
+}
