+//! Keep complete content line baselines alongside the matching performed native layout.
+
+use super::*;
+
+impl TaffyLayoutEngine {
+    pub(super) fn request_measured_layout_with_line_data(
+        &mut self,
+        style: Style,
+        rem_size: Pixels,
+        scale_factor: f32,
+        mut measure: impl FnMut(
+            Size<Option<Pixels>>,
+            Size<AvailableSpace>,
+            &mut Window,
+            &mut App,
+        ) -> (
+            Size<Pixels>,
+            Option<Pixels>,
+            Option<Pixels>,
+            Option<Vec<Pixels>>,
+        ) + 'static,
+    ) -> LayoutId {
+        self.request_measured_layout_with_physical_baselines(
+            style,
+            rem_size,
+            scale_factor,
+            move |known, available, window, cx| measure(known, available, window, cx).into(),
+        )
+    }
+
+    /// Measure actual content baseline coordinates on both physical axes.
+    pub fn request_measured_layout_with_physical_baselines(
+        &mut self,
+        style: Style,
+        rem_size: Pixels,
+        scale_factor: f32,
+        mut measure: impl FnMut(
+            Size<Option<Pixels>>,
+            Size<AvailableSpace>,
+            &mut Window,
+            &mut App,
+        ) -> MeasuredContent
+        + 'static,
+    ) -> LayoutId {
+        self.request_measured_layout_with_box(
+            style,
+            rem_size,
+            scale_factor,
+            move |known, available, _, window, cx| measure(known, available, window, cx),
+        )
+    }
+
+    /// KaminIDE patch: expose the containing block and resolved edges to measured hosts.
+    pub fn request_measured_layout_with_box(
+        &mut self,
+        style: Style,
+        rem_size: Pixels,
+        scale_factor: f32,
+        measure: impl FnMut(
+            Size<Option<Pixels>>,
+            Size<AvailableSpace>,
+            MeasuredBox,
+            &mut Window,
+            &mut App,
+        ) -> MeasuredContent
+        + 'static,
+    ) -> LayoutId {
+        self.register_measured(
+            style,
+            rem_size,
+            scale_factor,
+            node_measure(Box::new(measure)),
+        )
+    }
+
+    pub fn request_measured_layout_with_line_baselines(
+        &mut self,
+        style: Style,
+        rem_size: Pixels,
+        scale_factor: f32,
+        mut measure: impl FnMut(
+            Size<Option<Pixels>>,
+            Size<AvailableSpace>,
+            &mut Window,
+            &mut App,
+        ) -> (Size<Pixels>, Option<Pixels>, Option<Pixels>, Vec<Pixels>)
+        + 'static,
+    ) -> LayoutId {
+        self.request_measured_layout_with_line_data(
+            style,
+            rem_size,
+            scale_factor,
+            move |known, available, window, cx| {
+                let (size, first, last, lines) = measure(known, available, window, cx);
+                (size, first, last, Some(lines))
+            },
+        )
+    }
+    fn register_measured(
+        &mut self,
+        style: Style,
+        rem_size: Pixels,
+        scale_factor: f32,
+        measure: NodeMeasureFn,
+    ) -> LayoutId {
+        // KaminIDE: `calc()` pairs of this style belong to this tree (`kamin_calc`).
+        let taffy_style = {
+            let _calc = self.taffy.calc_scope();
+            style.to_taffy(rem_size, scale_factor)
+        };
+        let taffy_style = self.styles.share(taffy_style);
+        // KaminIDE patch: measurement also supports the ordinary native stack.
+        let mut context = Some(NodeContext {
+            static_positions: Vec::new(),
+            measure: std::rc::Rc::new(std::cell::RefCell::new(measure)),
+            layout_lines: None,
+            layout_lines_x: None,
+            layout_lines_x_from_right: false,
+            key_slot: crate::taffy::retained::NO_SLOT,
+        });
+        // KaminIDE patch: a keyed leaf keeps a previous leaf of the same key.
+        let key = self.retained.next_key.take();
+        if let Some(id) = key.and_then(|key| self.claim_measured(key, &taffy_style, &mut context)) {
+            return id;
+        }
+        let context = context.expect("measured leaf context");
+        let id = if let Some(node) = self.recycle(true) {
+            self.taffy
+                .reset_node(node, taffy_style, &[], Some(context))
+                .expect(EXPECT_MESSAGE);
+            LayoutId(node)
+        } else {
+            self.taffy
+                .new_leaf_with_context(taffy_style, context)
+                .expect(EXPECT_MESSAGE)
+                .into()
+        };
+        self.created(id, key)
+    }
+    /// Register a leaf whose intrinsic measurement can suspend.
+    pub fn request_measured_layout_with_box_async(
+        &mut self,
+        style: Style,
+        rem_size: Pixels,
+        scale_factor: f32,
+        measure: impl AsyncMeasureFn + 'static,
+    ) -> LayoutId {
+        self.register_measured(
+            style,
+            rem_size,
+            scale_factor,
+            NodeMeasureFn::Async(Box::new(measure)),
+        )
+    }
+}
diff --git a/vendor/gpui/src/taffy/measure_callback.rs b/vendor/gpui/src/taffy/measure_callback.rs
new file mode 100644
index 0000000000000000000000000000000000000000..b18dbec8e26cd630771cf4c225049dd1924ba380
--- /dev/null
+++ b/vendor/gpui/src/taffy/measure_callback.rs
@@ -0,0 +1,114 @@
+//! Синхронные листья и вложенные измерения используют один контракт.
+use super::*;
+use crate::{PaintFuture, PaintStack};
+/// Borrowed measurement which may suspend for an intrinsic descendant probe.
+pub trait AsyncMeasureFn {
+    /// Measure content using the caller's explicit traversal stack.
+    fn measure<'a>(
+        &'a mut self,
+        known: Size<Option<Pixels>>,
+        available: Size<AvailableSpace>,
+        geometry: MeasuredBox,
+        window: &'a mut Window,
+        cx: &'a mut App,
+        stack: &'a mut PaintStack,
+    ) -> PaintFuture<'a, MeasuredContent>;
+}
+impl<F> AsyncMeasureFn for F
+where
+    F: for<'a> AsyncFnMut(
+        Size<Option<Pixels>>,
+        Size<AvailableSpace>,
+        MeasuredBox,
+        &'a mut Window,
+        &'a mut App,
+        &'a mut PaintStack,
+    ) -> MeasuredContent,
+{
+    fn measure<'a>(
+        &'a mut self,
+        known: Size<Option<Pixels>>,
+        available: Size<AvailableSpace>,
+        geometry: MeasuredBox,
+        window: &'a mut Window,
+        cx: &'a mut App,
+        stack: &'a mut PaintStack,
+    ) -> PaintFuture<'a, MeasuredContent> {
+        Box::pin(self(known, available, geometry, window, cx, stack))
+    }
+}
+pub(super) enum NodeMeasureFn {
+    Sync(StackSafe<Box<MeasureFn>>),
+    Async(Box<dyn AsyncMeasureFn>),
+    Active,
+}
+impl NodeMeasureFn {
+    pub(super) async fn measure(
+        &mut self,
+        known: Size<Option<Pixels>>,
+        available: Size<AvailableSpace>,
+        geometry: MeasuredBox,
+        window: &mut Window,
+        cx: &mut App,
+        stack: &mut PaintStack,
+    ) -> MeasuredContent {
+        match self {
+            Self::Active => panic!("reentrant measurement of the same node"),
+            Self::Sync(f) => f(known, available, geometry, window, cx),
+            Self::Async(f) => {
+                stack
+                    .run(|stack| f.measure(known, available, geometry, window, cx, stack))
+                    .await
+            }
+        }
+    }
+}
+
+// The callback is owned across suspension; no RefCell borrow survives an await.
+pub(super) struct MeasureGuard<'a> {
+    slot: &'a std::cell::RefCell<NodeMeasureFn>,
+    callback: Option<NodeMeasureFn>,
+}
+impl<'a> MeasureGuard<'a> {
+    pub(super) fn take(slot: &'a std::cell::RefCell<NodeMeasureFn>) -> Self {
+        let mut value = slot.borrow_mut();
+        assert!(
+            !matches!(*value, NodeMeasureFn::Active),
+            "reentrant measurement of the same node"
+        );
+        let callback = Some(std::mem::replace(&mut *value, NodeMeasureFn::Active));
+        Self { slot, callback }
+    }
+}
+impl std::ops::Deref for MeasureGuard<'_> {
+    type Target = NodeMeasureFn;
+    fn deref(&self) -> &Self::Target {
+        self.callback.as_ref().unwrap()
+    }
+}
+impl std::ops::DerefMut for MeasureGuard<'_> {
+    fn deref_mut(&mut self) -> &mut Self::Target {
+        self.callback.as_mut().unwrap()
+    }
+}
+impl Drop for MeasureGuard<'_> {
+    fn drop(&mut self) {
+        *self.slot.borrow_mut() = self.callback.take().unwrap();
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn suspended_callback_is_restored_on_cancellation() {
+        let slot = std::cell::RefCell::new(NodeMeasureFn::Sync(StackSafe::new(Box::new(
+            |_, _, _, _, _| MeasuredContent::new(Size::default()),
+        ))));
+        {
+            let _guard = MeasureGuard::take(&slot);
+            assert!(matches!(*slot.borrow(), NodeMeasureFn::Active));
+        }
+        assert!(matches!(*slot.borrow(), NodeMeasureFn::Sync(_)));
+    }
+}
diff --git a/vendor/gpui/src/taffy/measured_box.rs b/vendor/gpui/src/taffy/measured_box.rs
new file mode 100644
index 0000000000000000000000000000000000000000..96010ce19be719780cab6e49cc10a7077dd058a8
--- /dev/null
+++ b/vendor/gpui/src/taffy/measured_box.rs
@@ -0,0 +1,98 @@
+//! Containing-block dimensions and native resolved box edges of a measured leaf.
+
+use super::*;
+use taffy::util::ResolveOrZero;
+
+/// Used edges share Taffy's percentage basis, independently of the leaf's own width.
+#[derive(Clone, Copy, Debug, Default)]
+pub struct MeasuredBox {
+    /// A size-only query for this axis; absent when both dimensions or final layout are needed.
+    pub intrinsic_axis: Option<crate::Axis>,
+    /// Axes whose border-box size the parent algorithm already fixed for this
+    /// final layout pass. Taffy passes a leaf performing layout no known
+    /// dimensions, only the definite available space, so a box that would
+    /// otherwise size itself to fit-content can tell that its size is decided
+    /// and skip the intrinsic probes that only re-derive it (Blink
+    /// `ConstraintSpace::IsFixedInlineSize`). Always false for size queries.
+    pub fixed: Size<bool>,
+    /// Containing block dimensions, before resolving this leaf's preferred size.
+    pub parent_size: Size<Option<Pixels>>,
+    /// Used padding, resolved against the containing block inline size.
+    pub padding: Edges<Pixels>,
+    /// Used border widths in logical pixels.
+    pub border: Edges<Pixels>,
+}
+
+impl MeasuredBox {
+    pub(super) fn from_native(
+        parent: taffy::Size<Option<f32>>,
+        style: &taffy::Style,
+        scale: f32,
+    ) -> Self {
+        let edges = |rect: taffy::Rect<f32>| Edges {
+            top: Pixels(rect.top / scale),
+            right: Pixels(rect.right / scale),
+            bottom: Pixels(rect.bottom / scale),
+            left: Pixels(rect.left / scale),
+        };
+        Self {
+            intrinsic_axis: None,
+            fixed: Size::default(),
+            parent_size: size(
+                parent.width.map(|v| Pixels(v / scale)),
+                parent.height.map(|v| Pixels(v / scale)),
+            ),
+            padding: edges(
+                style
+                    .padding
+                    .resolve_or_zero(parent.width, &taffy::tree::calc_value),
+            ),
+            border: edges(
+                style
+                    .border
+                    .resolve_or_zero(parent.width, &taffy::tree::calc_value),
+            ),
+        }
+    }
+
+    /// Border and padding added outside the measured content size by native leaf layout.
+    pub fn inset(self) -> Edges<Pixels> {
+        Edges {
+            top: self.padding.top + self.border.top,
+            right: self.padding.right + self.border.right,
+            bottom: self.padding.bottom + self.border.bottom,
+            left: self.padding.left + self.border.left,
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::px;
+
+    #[test]
+    fn percentage_padding_uses_containing_width_on_both_axes_and_scales_once() {
+        let style = taffy::Style {
+            padding: taffy::Rect {
+                top: taffy::LengthPercentage::percent(0.1),
+                bottom: taffy::LengthPercentage::percent(0.1),
+                left: taffy::LengthPercentage::percent(0.1),
+                right: taffy::LengthPercentage::percent(0.1),
+            },
+            ..Default::default()
+        };
+        let geometry = MeasuredBox::from_native(
+            taffy::Size {
+                width: Some(600.),
+                height: Some(100.),
+            },
+            &style,
+            2.,
+        );
+        assert_eq!(geometry.parent_size.width, Some(px(300.)));
+        assert_eq!(geometry.padding.top, px(30.));
+        assert_eq!(geometry.padding.left, px(30.));
+        assert_eq!(geometry.padding.bottom, px(30.));
+    }
+}
diff --git a/vendor/gpui/src/taffy/measured_content.rs b/vendor/gpui/src/taffy/measured_content.rs
