+                ForegroundEvent::Input(InputTiming {
+                    kind: "test",
+                    start: at(340),
+                    end: at(345),
+                    caused_invalidation: false,
+                }),
+                ForegroundEvent::Present(presentation),
+            ],
+            small_polls: vec![SmallPollFlush {
+                summary: PollSummary {
+                    count: 2,
+                    total: Duration::from_millis(1),
+                },
+                since: at(105),
+                until: at(145),
+            }],
+            dropped_events: 0,
+            journal_discontinuous: false,
