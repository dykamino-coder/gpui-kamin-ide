index 0000000000000000000000000000000000000000..769b03c9f8f9e91e6c7a53e11e91c735a81f929f
--- /dev/null
+++ b/vendor/gpui/src/window/paint_record/segments.rs
@@ -0,0 +1,236 @@
+//! Границы сегментов до публикации immutable record; CSS выбирает размещения.
+
+use super::*;
+mod admission;
+mod hits;
+mod traversal;
+pub use admission::{PaintSegmentClips, PaintSegmentSlice};
+
+/// Идентичность сегмента фрагментации, назначенная хозяином записи.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, PartialOrd, Ord, Hash)]
+pub struct PaintSegmentId(pub u64);
+
+/// Явное размещение исходных команд в сегменте до композиции групп.
+#[derive(Clone, Copy, Debug)]
+pub struct PaintSegment {
+    /// Идентичность фрагментаинера, выбранная хозяином.
+    pub id: PaintSegmentId,
+    /// Порядковый номер размещения узла внутри сегмента.
+    pub ordinal: u32,
+    /// Разрешённая исходная точка в координатах окна.
+    pub source: Point<Pixels>,
+    /// Целевая точка в системе координат сегмента.
+    pub destination: Point<Pixels>,
+}
+
+/// Отдельные неизменяемые записи с экземплярами охватывающих эффектов.
+pub struct PaintSegmentRecords(Vec<(PaintSegmentId, PaintRecord)>);
+
+impl PaintSegmentRecords {
+    /// Чтение сегмента без потребления его повторно используемых команд.
+    pub fn get(&self, id: PaintSegmentId) -> Option<&PaintRecord> {
+        self.0
+            .iter()
+            .find(|(key, _)| *key == id)
+            .map(|(_, record)| record)
+    }
+
+    /// Упорядоченный набор сегментов, включая пустые записи пустых сегментов.
+    pub fn into_records(self) -> Vec<(PaintSegmentId, PaintRecord)> {
+        self.0
+    }
+}
+
+pub(super) struct Recording;
+
+struct Selection(Rc<[PaintSegment]>);
+struct SegmentSet(Rc<[PaintSegment]>, Bounds<Pixels>);
+
+fn valid(routes: &[PaintSegment], scale: f32) -> bool {
+    routes.iter().enumerate().all(|(index, route)| {
+        !routes[..index]
+            .iter()
+            .any(|other| other.id == route.id && other.ordinal == route.ordinal)
+            && validation::point_valid(route.source)
+            && validation::point_valid(route.destination)
+            && validation::point_valid(route.destination - route.source)
+            && validation::point_valid((route.destination - route.source) * scale)
+    })
+}
+
+fn scopes(roots: &[PaintSegment], selected: Option<&Selection>) -> Rc<[PaintSegment]> {
+    let mut result = Vec::new();
+    for (index, root) in roots.iter().enumerate() {
+        if roots[..index].iter().any(|prior| prior.id == root.id) {
+            continue;
+        }
+        let chosen: Vec<_> = selected
+            .into_iter()
+            .flat_map(|value| value.0.iter())
+            .filter(|route| route.id == root.id)
+            .copied()
+            .collect();
+        if chosen.is_empty() {
+            // Предок без собственного допуска охватывает все размещения
+            // потомков одним scope; ordinal повторяет только явный выбор.
+            result.push(*root);
+        } else {
+            result.extend(chosen);
+        }
+    }
+    result.into()
+}
+
+impl Window {
+    /// Допуск исходных фрагментов при единственном native paint поддерева.
+    /// Отложенные задания сохраняют выбор в paint-контексте. Пустой выбор
+    /// исключает собственные команды узла; потомки могут выбрать свои сегменты.
+    pub fn with_paint_segments<R>(
+        &mut self,
+        routes: Rc<[PaintSegment]>,
+        paint: impl FnOnce(&mut Self) -> R,
+    ) -> Result<R, PaintRecordError> {
+        if !valid(&routes, self.scale_factor()) {
+            return Err(PaintRecordError::InvalidGeometry);
+        }
+        let Some(segments) = self.render_contexts.get::<SegmentSet>() else {
+            return Err(PaintRecordError::InvalidSegment);
+        };
+        if routes
+            .iter()
+            .any(|route| !segments.0.iter().any(|segment| segment.id == route.id))
+        {
+            return Err(PaintRecordError::InvalidSegment);
+        }
+        if routes.iter().any(|route| {
+            !validation::scaled_bounds_valid(
+                Bounds::new(
+                    segments.1.origin + route.destination - route.source,
+                    segments.1.size,
+                ),
+                self.scale_factor(),
+            )
+        }) {
+            return Err(PaintRecordError::InvalidGeometry);
+        }
+        let _selection = self.render_contexts.enter(Some(Rc::new(Selection(routes))));
+        let _slices = self.render_contexts.enter::<admission::Slices>(None);
+        Ok(paint(self))
+    }
+
+    /// Единственный paint маршрутизирует журнал Scene до заморозки PaintRecord.
+    /// Охватывающие группы создаются один раз на сегмент и совместно
+    /// используются всеми его вложенными листьями.
+    pub fn record_paint_segments<R>(
+        &mut self,
+        source_clip: Bounds<Pixels>,
+        routes: Rc<[PaintSegment]>,
+        cx: &mut App,
+        paint: impl FnOnce(&mut Self, &mut App) -> R,
+    ) -> Result<(R, PaintSegmentRecords), PaintRecordError> {
+        if !valid(&routes, self.scale_factor()) {
+            return Err(PaintRecordError::InvalidGeometry);
+        }
+        if !validation::scaled_bounds_valid(source_clip, self.scale_factor())
+            || routes.iter().any(|route| {
+                !validation::scaled_bounds_valid(
+                    Bounds::new(
+                        source_clip.origin + route.destination - route.source,
+                        source_clip.size,
+                    ),
+                    self.scale_factor(),
+                )
+            })
+        {
+            return Err(PaintRecordError::InvalidGeometry);
+        }
+        let segments = routes.clone();
+        let _segments = self
+            .render_contexts
+            .enter(Some(Rc::new(SegmentSet(routes.clone(), source_clip))));
+        let _selection = self.render_contexts.enter(Some(Rc::new(Selection(routes))));
+        let contexts = self.render_contexts.clone();
+        let scope_segments = segments.clone();
+        let read = Rc::new(move || crate::scene::segments::Tag {
+            routes: contexts
+                .get::<Selection>()
+                .map_or_else(|| Rc::from([]), |value| value.0.clone()),
+            scopes: scopes(&scope_segments, contexts.get::<Selection>().as_deref()),
+            clips: contexts.get::<crate::scene::segments::Clip>(),
+            slices: contexts
+                .get::<admission::Slices>()
+                .map_or_else(|| Rc::from([]), |value| value.0.clone()),
+        });
+        let (result, draft, identity, scale) =
+            self.capture_paint_commands(source_clip, cx, |window, cx| {
+                let _recording = window.render_contexts.enter(Some(Rc::new(Recording)));
+                let _clips = window
+                    .render_contexts
+                    .enter::<crate::scene::segments::Clip>(None);
+                let _slices = window.render_contexts.enter::<admission::Slices>(None);
+                window.next_frame.scene.begin_segments(read);
+                paint(window, cx)
+            })?;
+        let mut records = Vec::with_capacity(segments.len());
+        for (index, segment) in segments.iter().enumerate() {
+            if segments[..index].iter().any(|prior| prior.id == segment.id) {
+                continue;
+            }
+            let scene = draft.freeze_segment(segment.id, scale, source_clip);
+            let clip = draft.segment_clip(segment.id, source_clip);
+            if !validation::scaled_bounds_valid(clip, scale) {
+                return Err(PaintRecordError::InvalidGeometry);
+            }
+            records.push((
+                segment.id,
+                PaintRecord(Rc::new(Recorded {
+                    identity: identity.clone(),
+                    scale,
+                    clip,
+                    scene,
+                })),
+            ));
+        }
+        Ok((result, PaintSegmentRecords(records)))
+    }
+}
+
+impl Window {
+    pub(in crate::window) fn segment_capture_mask(&self) -> Option<ContentMask<Pixels>> {
+        self.render_contexts.get::<Recording>()?;
+        // До размещения нельзя отбрасывать исходные команды по clip предка.
+        // Заморозка применяет конечные границы и эффекты каждого сегмента.
+        let radius = f32::MAX / 64.0 / self.scale_factor().max(1.0);
+        Some(ContentMask {
+            bounds: Bounds::new(
+                point(px(-radius), px(-radius)),
+                size(px(radius * 2.0), px(radius * 2.0)),
+            ),
+        })
+    }
+
+    pub(in crate::window) fn segment_clip_scope(
+        &self,
+        mask: ContentMask<Pixels>,
+        replace: bool,
+    ) -> Option<render_context::Scope> {
+        self.render_contexts.get::<Recording>()?;
+        let segments = self.render_contexts.get::<SegmentSet>()?;
+        let selected = self.render_contexts.get::<Selection>()?;
+        // Scope присутствует во всех сегментах: собственный допуск предка
+        // может быть пустым, когда независимый потомок всё ещё рисуется.
+        let routes = scopes(&segments.0, Some(&selected));
+        Some(
+            self.render_contexts
+                .enter(Some(Rc::new(crate::scene::segments::Clip {
+                    bounds: mask.bounds,
+                    routes,
+                    parent: if replace {
+                        None
+                    } else {
+                        self.render_contexts.get()
+                    },
+                }))),
+        )
+    }
+}
diff --git a/vendor/gpui/src/window/paint_record/segments/admission.rs b/vendor/gpui/src/window/paint_record/segments/admission.rs
new file mode 100644
index 0000000000000000000000000000000000000000..0a7d5925295a72cb973bcebb7aaf5275b0d92ac6
--- /dev/null
+++ b/vendor/gpui/src/window/paint_record/segments/admission.rs
@@ -0,0 +1,143 @@
+//! Собственный срез узла и цепочка CSS clip отделены от охватывающих эффектов.
+
+use super::*;
+mod traversal;
+
+/// Допуск и размещение одного узла независимо от срезов его предков.
+#[derive(Clone, Copy, Debug)]
+pub struct PaintSegmentSlice {
+    /// Идентичность сегмента и разрешённое размещение исходной точки.
+    pub placement: PaintSegment,
+    /// Собственный исходный срез узла до размещения.
+    pub source_clip: Bounds<Pixels>,
+}
+
+pub(super) struct Slices(pub(super) Rc<[PaintSegmentSlice]>);
+
+/// Сохранённая цепочка clip, выбранная CSS-политикой containing block.
+/// Не изменяет opacity, transform, filter или выбор сегментов.
+#[derive(Clone)]
+pub struct PaintSegmentClips {
+    identity: paint_scope::Identity,
+    segments: Rc<SegmentSet>,
+    clips: Option<Rc<crate::scene::segments::Clip>>,
+}
+
+impl Window {
+    /// Замена собственного допуска узла. Независимый потомок не наследует
+    /// этот срез; охватывающие эффекты остаются общими.
+    pub fn with_paint_segment_slices<R>(
+        &mut self,
+        slices: Rc<[PaintSegmentSlice]>,
+        paint: impl FnOnce(&mut Self) -> R,
+    ) -> Result<R, PaintRecordError> {
+        if slices.iter().any(|slice| {
+            !validation::scaled_bounds_valid(slice.source_clip, self.scale_factor())
+                || !validation::scaled_bounds_valid(
+                    Bounds::new(
+                        slice.source_clip.origin + slice.placement.destination
+                            - slice.placement.source,
+                        slice.source_clip.size,
+                    ),
+                    self.scale_factor(),
+                )
+        }) {
+            return Err(PaintRecordError::InvalidGeometry);
+        }
+        let routes = slices.iter().map(|slice| slice.placement).collect();
+        self.with_paint_segments(routes, |window| {
+            let _slices = window.render_contexts.enter(Some(Rc::new(Slices(slices))));
+            paint(window)
+        })
+    }
+
+    /// Сохранение активной цепочки CSS clip на границе containing block.
+    pub fn paint_segment_clips(&self) -> Result<PaintSegmentClips, PaintRecordError> {
+        if self.render_contexts.get::<Recording>().is_none() {
+            return Err(PaintRecordError::InvalidSegment);
+        }
+        Ok(PaintSegmentClips {
+            identity: paint_scope::Identity::capture(self),
+            clips: self.render_contexts.get(),
+            segments: self
+                .render_contexts
+                .get::<SegmentSet>()
+                .ok_or(PaintRecordError::InvalidSegment)?,
+        })
+    }
+
+    /// Выбор цепочки clip по containing block без повторной группы эффектов.
+    /// Отложенные задания сохраняют выбранную цепочку в своём контексте.
+    pub fn with_paint_segment_clips<R>(
+        &mut self,
+        clips: &PaintSegmentClips,
+        paint: impl FnOnce(&mut Self) -> R,
+    ) -> Result<R, PaintRecordError> {
+        clips.identity.check_pass(self)?;
+        if self.render_contexts.get::<Recording>().is_none() {
+            return Err(PaintRecordError::InvalidSegment);
+        }
+        if !self
+            .render_contexts
+            .get::<SegmentSet>()
+            .is_some_and(|segments| Rc::ptr_eq(&segments, &clips.segments))
+        {
+            return Err(PaintRecordError::InvalidSegment);
+        }
+        let _clips = self.render_contexts.enter(clips.clips.clone());
+        Ok(paint(self))
+    }
+
+    /// Повтор во вложенной записи тех clip, которые цепочка containing block
+    /// добавляет поверх `base`. Обе цепочки сохранены одной охватывающей записью
+    /// над теми же исходными координатами; каждый clip следует за всеми
+    /// выбранными размещениями активной записи, как собственный clip её узлов.
+    pub fn with_paint_source_clips<R>(
+        &mut self,
+        clips: &PaintSegmentClips,
+        base: &PaintSegmentClips,
+        paint: impl FnOnce(&mut Self) -> R,
+    ) -> Result<R, PaintRecordError> {
+        clips.identity.check_pass(self)?;
+        if !Rc::ptr_eq(&clips.segments, &base.segments) {
+            return Err(PaintRecordError::InvalidSegment);
+        }
+        let mut local = Vec::new();
+        let mut scope = clips.clips.as_ref();
+        while let Some(clip) = scope {
+            if base
+                .clips
+                .as_ref()
+                .is_some_and(|base| Rc::ptr_eq(clip, base))
+            {
+                break;
+            }
+            local.push(clip.bounds);
+            scope = clip.parent.as_ref();
+        }
+        if scope.is_none() && base.clips.is_some() {
+            return Err(PaintRecordError::InvalidSegment);
+        }
+        if self.render_contexts.get::<Recording>().is_none() {
+            return Err(PaintRecordError::InvalidSegment);
+        }
+        let segments = self
+            .render_contexts
+            .get::<SegmentSet>()
+            .ok_or(PaintRecordError::InvalidSegment)?;
+        let routes = scopes(
+            &segments.0,
+            self.render_contexts.get::<Selection>().as_deref(),
+        );
+        let mut chain = self.render_contexts.get::<crate::scene::segments::Clip>();
+        for bounds in local.into_iter().rev() {
+            chain = Some(Rc::new(crate::scene::segments::Clip {
+                bounds,
+                routes: routes.clone(),
+                parent: chain,
+            }));
+        }
+        let _clips = self.render_contexts.enter(chain);
+        Ok(paint(self))
+    }
+}
