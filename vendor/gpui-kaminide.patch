-                    }
-                    Effect::EntityCreated {
-                        entity,
-                        tid,
-                        window,
-                    } => {
-                        self.apply_entity_created_effect(entity, tid, window);
-                    }
-                }
-            } else {
-                #[cfg(any(test, feature = "test-support"))]
