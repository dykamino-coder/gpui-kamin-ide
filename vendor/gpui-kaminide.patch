+                            line_start = i + 1;
+                            break;
+                        }
+                    }
+                }
+            }
+            bounds_for_range(line_start..line_start)
+        } else {
+            // No active composition — use the selection endpoint.
+            let offset = if selection.reversed {
+                selection.range.start
+            } else {
+                selection.range.end
+            };
+            bounds_for_range(offset..offset)
+        }
+    }
