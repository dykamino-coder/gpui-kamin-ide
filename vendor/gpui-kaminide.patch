+    #[cfg(any(test, feature = "test-support"))]
+    pub fn painted_quads(&self) -> Vec<Quad> {
+        let scene = &self.rendered_frame.scene;
+        let mut quads = scene.quads.clone();
+        for layer in scene.layer_contents() {
