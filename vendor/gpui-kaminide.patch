+/// The canonical implementation of [`crate::PlatformInputHandler`]. Call [`Window::handle_input`]
+/// with an instance during your element's paint.
+pub struct ElementInputHandler<V> {
+    view: Entity<V>,
+    element_bounds: Bounds<Pixels>,
+}
