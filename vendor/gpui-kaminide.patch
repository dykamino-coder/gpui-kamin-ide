-
-                    if width.floor() > truncate_width {
-                        return Some(truncate_ix);
-                    }
-                }
-            }
-            TruncateFrom::End => {
-                for (ix, c) in line.char_indices() {
-                    if width + suffix_width < truncate_width {
-                        truncate_ix = ix;
-                    }
-
-                    let char_width = self.width_for_char(c);
-                    width += char_width;
-
-                    if width.floor() > truncate_width {
