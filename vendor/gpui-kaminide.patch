index 0000000000000000000000000000000000000000..e5aa691fbb6bac6e6066cb3ba2bc2475f06a7615
--- /dev/null
+++ b/vendor/gpui/src/scene/segments/freeze.rs
@@ -0,0 +1,48 @@
+//! Экземпляры исходной группы сохраняют общий эффект и явные повторные размещения.
+
+use super::*;
+
+impl Scene {
+    pub(crate) fn freeze_segment(&self, id: PaintSegmentId, scale: f32, source: Bounds<Pixels>) -> Scene {
+        let extent = self.segment_clip(id, source).scale(scale);
+        let mut groups = Vec::new();
+        let mut mapping: Vec<Vec<Group>> = Vec::with_capacity(self.groups.len());
+        for group in &self.groups {
+            let entries: Vec<_> = group.scene.segment_capture.as_ref().into_iter()
+                .flat_map(|capture| capture.entry.scopes.iter())
+                .filter(|route| route.id == id).copied().collect();
+            let mut copies = Vec::new();
+            for entry in &entries {
+                // Один scope объединяет независимых потомков. Явно повторённый
+                // scope получает отдельный эффект для каждого ordinal.
+                let ordinal = (entries.len() > 1).then_some(entry.ordinal);
+                let clips = group.scene.common_segment_clips(id, ordinal, &mapping);
+                let (scene, route) = group.scene.segment_commands(id, ordinal, scale, &mapping, extent, clips.as_ref());
+                let Some(route) = route else { continue; };
+                let offset = (route.destination - route.source).scale(scale);
+                let index = groups.len() as u32 + 1;
+                let mut copy = Self::copy_group(group, scene, offset);
+                if let Some(capture) = &group.scene.segment_capture {
+                    for tag in &capture.primitives {
+                        for route in tag.routes.iter().filter(|route| route.id == id
+                            && ordinal.is_none_or(|ordinal| route.ordinal == ordinal)) {
+                            copy.bounds = copy.bounds.union(&record::geometry::bounds(
+                                group.bounds, (route.destination - route.source).scale(scale),
+                            ));
+                        }
+                    }
+                }
+                for mark in &copy.scene.surfaces { copy.bounds = copy.bounds.union(&mark.bounds); }
+                let bounds = copy.bounds;
+                groups.push(copy);
+                copies.push(Group { index, route, bounds, clips: clips.clone(),
+                    atomic: group.scene.segment_capture.as_ref().is_some_and(|capture| capture.atomic) });
+            }
+            mapping.push(copies);
+        }
+        let (mut scene, _) = self.segment_commands(id, None, scale, &mapping, extent, None);
+        scene.groups = groups;
+        scene.finish_frozen();
+        scene
+    }
+}
diff --git a/vendor/gpui/src/scene/segments/groups.rs b/vendor/gpui/src/scene/segments/groups.rs
new file mode 100644
index 0000000000000000000000000000000000000000..b09832d694d351eac6b4b47d155f7b2bc8f54b9f
--- /dev/null
+++ b/vendor/gpui/src/scene/segments/groups.rs
@@ -0,0 +1,56 @@
+//! Общий внешний clip группы сохраняется после фильтра только для всех её листьев.
+
+use super::*;
+
+pub(super) struct Group {
+    pub(super) index: u32,
+    pub(super) route: PaintSegment,
+    pub(super) bounds: Bounds<ScaledPixels>,
+    pub(super) clips: Option<Rc<Clip>>,
+    pub(super) atomic: bool,
+}
+
+impl Scene {
+    pub(super) fn common_segment_clips(&self, id: PaintSegmentId, ordinal: Option<u32>, groups: &[Vec<Group>]) -> Option<Rc<Clip>> {
+        let capture = self.segment_capture.as_ref()?;
+        let mut common = capture.entry.clips.clone();
+        let mut tags = capture.primitives.iter();
+        for op in &self.paint_operations {
+            let PaintOperation::Primitive(primitive) = op else { continue; };
+            let tag = tags.next().expect("captured primitive tag");
+            let chain = if let Primitive::Surface(surface) = primitive {
+                if surface.group > 0 {
+                    let Some(copies) = groups.get(surface.group as usize - 1) else { continue; };
+                    for group in copies.iter().filter(|group| ordinal.is_none_or(|ordinal| group.route.ordinal == ordinal)) {
+                        retain_common(&mut common, if group.atomic { tag.clips.as_ref() } else { group.clips.as_ref() });
+                    }
+                    continue;
+                } else {
+                    if !tag.routes.iter().any(|route| route.id == id && ordinal.is_none_or(|ordinal| route.ordinal == ordinal)) { continue; }
+                    tag.clips.as_ref()
+                }
+            } else {
+                if !tag.routes.iter().any(|route| route.id == id && ordinal.is_none_or(|ordinal| route.ordinal == ordinal)) { continue; }
+                tag.clips.as_ref()
+            };
+            retain_common(&mut common, chain);
+        }
+        for tag in &capture.hoisted {
+            if tag.routes.iter().any(|route| route.id == id && ordinal.is_none_or(|ordinal| route.ordinal == ordinal)) {
+                retain_common(&mut common, tag.clips.as_ref());
+            }
+        }
+        common
+    }
+}
+
+fn retain_common(common: &mut Option<Rc<Clip>>, chain: Option<&Rc<Clip>>) {
+    while let Some(candidate) = common {
+        let mut node = chain;
+        while let Some(clip) = node {
+            if Rc::ptr_eq(candidate, clip) { return; }
+            node = clip.parent.as_ref();
+        }
+        *common = candidate.parent.clone();
+    }
+}
diff --git a/vendor/gpui/src/scene/vector_transform.rs b/vendor/gpui/src/scene/vector_transform.rs
new file mode 100644
index 0000000000000000000000000000000000000000..d3a62e2bdc1b0167e3ed1b9dcd1389dee3d07dff
--- /dev/null
+++ b/vendor/gpui/src/scene/vector_transform.rs
@@ -0,0 +1,138 @@
+//! Точный перенос векторных команд страницы: равномерный масштаб и четверти оборота.
+
+use super::*;
+use crate::TransformationMatrix;
+use crate::window::vector_transform::VectorTransform;
+
+impl Scene {
+    pub(crate) fn transform_vector(mut self, transform: VectorTransform) -> Self {
+        let matrix = transform.matrix();
+        let groups = mem::take(&mut self.groups);
+        let mut scene = self.transform_commands(transform, matrix);
+        scene.groups = groups.into_iter().map(|mut group| {
+            group.bounds = map_bounds(group.bounds, matrix);
+            group.blur_radius *= transform.scale();
+            group.polygon.iter_mut().for_each(|p| *p = map_point(*p, matrix));
+            group.mask_bounds = map_bounds(group.mask_bounds, matrix);
+            let turn = ((group.mask_once >> 3) + u32::from(transform.quarter_turns())) % 4;
+            group.mask_once = (group.mask_once & 7) | (turn << 3);
+            group.mask_clip = group.mask_clip.map(|b| {
+                let b = map_bounds(Bounds::new(point(ScaledPixels(b[0]), ScaledPixels(b[1])),
+                    crate::size(ScaledPixels(b[2]), ScaledPixels(b[3]))), matrix);
+                [b.origin.x.0, b.origin.y.0, b.size.width.0, b.size.height.0]
+            });
+            group.projection = group.projection.map(|m| conjugate(m, matrix, transform.inverse_matrix()));
+            for fragment in &mut group.fragments {
+                fragment.iter_mut().for_each(|p| *p = map_point(*p, matrix));
+            }
+            group.scene = group.scene.transform_commands(transform, matrix);
+            group
+        }).collect();
+        scene
+    }
+
+    fn transform_commands(mut self, transform: VectorTransform, matrix: TransformationMatrix) -> Self {
+        let mut scene = Self { in_group: self.in_group, ..Self::default() };
+        for mut command in mem::take(&mut self.paint_operations) {
+            match &mut command {
+                PaintOperation::Primitive(p) => primitive(p, transform, matrix),
+                PaintOperation::StartLayer(b, _) => *b = map_bounds(*b, matrix),
+                _ => {},
+            }
+            scene.replay_operation(command);
+        }
+        scene.segment_capture = self.segment_capture;
+        scene.hoisted_backdrops = self.hoisted_backdrops.into_iter().map(|mut p| {
+            surface(&mut p, transform, matrix);
+            p
+        }).collect();
+        scene.finish();
+        scene
+    }
+}
+
+use std::mem;
+
+fn map_point(p: Point<ScaledPixels>, m: TransformationMatrix) -> Point<ScaledPixels> {
+    let p = m.apply(point(crate::px(p.x.0), crate::px(p.y.0)));
+    point(ScaledPixels(p.x.0), ScaledPixels(p.y.0))
+}
+
+fn map_bounds(b: Bounds<ScaledPixels>, m: TransformationMatrix) -> Bounds<ScaledPixels> {
+    let a = map_point(b.origin, m);
+    let z = map_point(b.bottom_right(), m);
+    Bounds::new(point(a.x.min(z.x), a.y.min(z.y)),
+        crate::size(ScaledPixels((z.x - a.x).0.abs()), ScaledPixels((z.y - a.y).0.abs())))
+}
+
+fn radii(c: &mut Corners<ScaledPixels>, t: VectorTransform) {
+    let mut v = [c.top_left, c.top_right, c.bottom_right, c.bottom_left];
+    v.rotate_right(usize::from(t.quarter_turns()));
+    *c = Corners { top_left: v[0], top_right: v[1], bottom_right: v[2], bottom_left: v[3] }.map(|x| *x * t.scale());
+}
+
+fn surface(p: &mut PaintSurface, t: VectorTransform, m: TransformationMatrix) {
+    p.bounds = map_bounds(p.bounds, m);
+    p.content_mask.bounds = map_bounds(p.content_mask.bounds, m);
+    #[cfg(not(target_os = "macos"))] {
+        radii(&mut p.corner_radii, t);
+        p.blur_radius *= t.scale();
+    }
+}
+
+fn primitive(p: &mut Primitive, t: VectorTransform, m: TransformationMatrix) {
+    match p {
+        Primitive::Quad(p) => {
+            p.transformation = m.compose(p.transformation);
+            p.content_mask.bounds = map_bounds(p.content_mask.bounds, m);
+        },
+        Primitive::MonochromeSprite(p) => {
+            p.transformation = m.compose(p.transformation);
+            p.content_mask.bounds = map_bounds(p.content_mask.bounds, m);
+        },
+        Primitive::SubpixelSprite(p) => {
+            p.transformation = m.compose(p.transformation);
+            p.content_mask.bounds = map_bounds(p.content_mask.bounds, m);
+        },
+        Primitive::PolychromeSprite(p) => {
+            p.transformation = m.compose(p.transformation);
+            p.content_mask.bounds = map_bounds(p.content_mask.bounds, m);
+        },
+        Primitive::Shadow(p) => {
+            p.bounds = map_bounds(p.bounds, m);
+            p.element_bounds = map_bounds(p.element_bounds, m);
+            p.content_mask.bounds = map_bounds(p.content_mask.bounds, m);
+            radii(&mut p.corner_radii, t);
+            radii(&mut p.element_corner_radii, t);
+            p.blur_radius = p.blur_radius * t.scale();
+        },
+        Primitive::Underline(p) => {
+            p.bounds = map_bounds(p.bounds, m);
+            p.content_mask.bounds = map_bounds(p.content_mask.bounds, m);
+            p.thickness = p.thickness * t.scale();
+            p.pad = (p.pad + u32::from(t.quarter_turns())) % 4;
+        },
+        Primitive::Surface(p) => surface(p, t, m),
+        Primitive::Path(p) => {
+            let (bounds, inverse) = p.color_mapping.unwrap_or((p.clipped_bounds(), TransformationMatrix::unit()));
+            p.color_mapping = Some((bounds, inverse.compose(t.inverse_matrix())));
+            p.bounds = map_bounds(p.bounds, m);
+            p.start = map_point(p.start, m);
+            p.current = map_point(p.current, m);
+            p.content_mask.bounds = map_bounds(p.content_mask.bounds, m);
+            for v in &mut p.vertices {
+                v.xy_position = map_point(v.xy_position, m);
+                v.content_mask.bounds = map_bounds(v.content_mask.bounds, m);
+            }
+        },
+    }
+}
+
+pub(super) fn conjugate(h: [f32; 9], m: TransformationMatrix, inverse: TransformationMatrix) -> [f32; 9] {
+    let expand = |m: TransformationMatrix| [m.rotation_scale[0][0], m.rotation_scale[0][1], m.translation[0],
+        m.rotation_scale[1][0], m.rotation_scale[1][1], m.translation[1], 0., 0., 1.];
+    let multiply = |a: [f32; 9], b: [f32; 9]| {
+        std::array::from_fn(|i| (0..3).map(|k| a[i / 3 * 3 + k] * b[k * 3 + i % 3]).sum())
+    };
+    multiply(multiply(expand(m), h), expand(inverse))
+}
diff --git a/vendor/gpui/src/seeds.rs b/vendor/gpui/src/seeds.rs
new file mode 100644
index 0000000000000000000000000000000000000000..e90784d72188d715a73ff263cc07f39ea3690331
--- /dev/null
+++ b/vendor/gpui/src/seeds.rs
@@ -0,0 +1,67 @@
+use std::env;
+
+/// Returns the seeds a randomized `#[gpui::test]` or `#[gpui::bench]` runs with, in
+/// order, and whether there is more than one.
+///
+/// With `$SEED` set, runs `$SEED..$SEED + iterations` and ignores `explicit_seeds`.
+/// Otherwise runs `0..iterations` followed by `explicit_seeds`, except that the
+/// default single iteration is dropped when explicit seeds are given.
+/// `$ITERATIONS` overrides `iterations`.
+/// Tests and benchmarks share this so that one `SEED` reproduces either.
+///
+/// This is intended for use by the `gpui::test` and `gpui::bench` macros and generally
+/// should not be used directly.
+#[doc(hidden)]
+pub fn calculate_seeds(
+    iterations: u64,
+    explicit_seeds: &[u64],
+) -> (impl Iterator<Item = u64> + '_, bool) {
+    let iterations = env::var("ITERATIONS")
+        .ok()
+        .map(|var| var.parse().expect("invalid ITERATIONS variable"))
+        .unwrap_or(iterations);
+
+    let env_seed = env::var("SEED")
+        .map(|seed| seed.parse().expect("invalid SEED variable as integer"))
+        .ok();
+
+    let iter = seeds(iterations, explicit_seeds, env_seed);
+    let is_multiple_runs = iter.clone().nth(1).is_some();
+    (iter, is_multiple_runs)
+}
+
+fn seeds(
+    iterations: u64,
+    explicit_seeds: &[u64],
+    env_seed: Option<u64>,
+) -> impl Iterator<Item = u64> + Clone + '_ {
+    let (iterations_range, explicit_seeds) = match env_seed {
+        Some(env_seed) => (env_seed..env_seed + iterations, &[][..]),
+        None if iterations == 1 && !explicit_seeds.is_empty() => (0..0, explicit_seeds),
+        None => (0..iterations, explicit_seeds),
+    };
+    iterations_range.chain(explicit_seeds.iter().copied())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::seeds;
+
+    fn collect(iterations: u64, explicit_seeds: &[u64], env_seed: Option<u64>) -> Vec<u64> {
+        seeds(iterations, explicit_seeds, env_seed).collect()
+    }
+
+    #[test]
+    fn seeds_follow_iterations_explicit_seeds_and_seed_variable() {
+        assert_eq!(collect(1, &[], None), [0]);
+        assert_eq!(collect(3, &[], None), [0, 1, 2]);
+        assert_eq!(collect(1, &[10, 20], None), [10, 20]);
+        assert_eq!(collect(2, &[10], None), [0, 1, 10]);
+        assert_eq!(collect(1, &[10], Some(7)), [7]);
+        assert_eq!(
+            collect(2, &[10], Some(7)),
+            [7, 8],
+            "`SEED` starts the iterations once, without repeating itself"
+        );
+    }
+}
