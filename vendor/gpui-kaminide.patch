+
+    fn draw_roots(&mut self, cx: &mut App) {
+        self.invalidator.set_phase(DrawPhase::Prepaint);
+        self.tooltip_bounds.take();
+
+        self.a11y.sync_active_flag();
+
+        let _inspector_width: Pixels = rems(30.0).to_pixels(self.rem_size());
+        let root_size = {
+            #[cfg(any(feature = "inspector", debug_assertions))]
+            {
+                if self.inspector.is_some() {
+                    let mut size = self.viewport_size;
+                    size.width = (size.width - _inspector_width).max(px(0.0));
+                    size
+                } else {
+                    self.viewport_size
+                }
+            }
+            #[cfg(not(any(feature = "inspector", debug_assertions)))]
+            {
+                self.viewport_size
+            }
+        };
+
+        // Layout all root elements. Like the root element on the web, which
+        // stretches to fill the viewport unless explicitly sized, window roots
+        // fill the window when their size is `auto`.
+        // KaminIDE patch: стоимость фаз кадра (`frame_perf`).
+        let _phase_started = std::time::Instant::now();
+        let PrepaintRoots {
+            root_element,
+            root_prepaint,
+            kept_root,
+            #[cfg(any(feature = "inspector", debug_assertions))]
+            inspector_element,
+            prompt_element,
+            active_drag_element,
+            tooltip_element,
+        } = self.prepaint_roots_with_layout_inputs(root_size, _inspector_width, cx);
+        crate::frame_perf::PREPAINT_US.fetch_add(
+            _phase_started.elapsed().as_micros() as u32,
+            std::sync::atomic::Ordering::Relaxed,
+        );
+
+        let _hit_started = std::time::Instant::now();
+        self.mouse_hit_test = self.next_frame.hit_test(self.mouse_position);
+        crate::frame_perf::HITTEST_US.fetch_add(
+            _hit_started.elapsed().as_micros() as u32,
+            std::sync::atomic::Ordering::Relaxed,
+        );
+
+        // Now actually paint the elements.
+        self.invalidator.set_phase(DrawPhase::Paint);
+        let _paint_started = std::time::Instant::now();
+        // KaminIDE patch: a kept root replays its paint records (`window/isolated.rs`).
+        let root_paint_start = self.paint_index();
+        match (root_element, kept_root) {
+            (Some(mut root_element), _) => root_element.paint(self, cx),
+            (None, Some(kept)) => self.reuse_paint(kept.paint),
+            (None, None) => {}
+        }
+        self.root_ranges = Some(RootRanges {
+            prepaint: root_prepaint,
+            paint: root_paint_start..self.paint_index(),
+        });
+        crate::frame_perf::PAINT_US.fetch_add(
+            _paint_started.elapsed().as_micros() as u32,
+            std::sync::atomic::Ordering::Relaxed,
+        );
+
+        #[cfg(any(feature = "inspector", debug_assertions))]
+        self.paint_inspector(inspector_element, cx);
+
+        self.paint_deferred_draws(cx);
+
+        if let Some(mut prompt_element) = prompt_element {
+            prompt_element.paint(self, cx);
+        } else if let Some(mut drag_element) = active_drag_element {
+            drag_element.paint(self, cx);
+        } else if let Some(mut tooltip_element) = tooltip_element {
+            tooltip_element.paint(self, cx);
+        }
+
+        #[cfg(any(feature = "inspector", debug_assertions))]
+        self.paint_inspector_hitbox(cx);
+
+        // a11y may have been activated/deactivated halfway through the frame
+        let a11y_active_start_of_frame = self.a11y.is_active();
+        self.a11y.sync_active_flag();
+        let a11y_active_end_of_frame = self.a11y.is_active();
+
+        let should_send_a11y_update = a11y_active_start_of_frame && a11y_active_end_of_frame;
+
+        if a11y_active_start_of_frame {
+            // Harvest frame metadata for the debug dump while the live window
+            // and frame are still in scope.
+            let frame_info = crate::window::a11y::debug::FrameDebugInfo {
+                viewport_size: self.viewport_size,
+                scale_factor: self.scale_factor,
+                tab_stop_count: self.next_frame.tab_stops.tab_stop_count(),
+            };
+            // clear the builder state regardless
+            let tree_update = self.a11y.end_frame(frame_info);
+
+            if should_send_a11y_update {
+                log::debug!(
+                    "Sending a11y tree update: {} nodes",
+                    tree_update.nodes.len()
+                );
+                self.platform_window.a11y_tree_update(tree_update);
+            }
+        }
+    }
+
+    fn prepaint_tooltip(&mut self, cx: &mut App) -> Option<AnyElement> {
+        // Use indexing instead of iteration to avoid borrowing self for the duration of the loop.
+        for tooltip_request_index in (0..self.next_frame.tooltip_requests.len()).rev() {
+            let Some(Some(tooltip_request)) = self
+                .next_frame
+                .tooltip_requests
+                .get(tooltip_request_index)
+                .cloned()
+            else {
+                log::error!("Unexpectedly absent TooltipRequest");
+                continue;
+            };
+            let mut element = tooltip_request.tooltip.view.clone().into_any_element();
+            let mouse_position = tooltip_request.tooltip.mouse_position;
+            let tooltip_size = element.layout_as_root(AvailableSpace::min_size(), self, cx);
+
+            let mut tooltip_bounds =
+                Bounds::new(mouse_position + point(px(1.), px(1.)), tooltip_size);
+            let window_bounds = Bounds {
+                origin: Point::default(),
+                size: self.viewport_size(),
+            };
+
+            if tooltip_bounds.right() > window_bounds.right() {
+                let new_x = mouse_position.x - tooltip_bounds.size.width - px(1.);
+                if new_x >= Pixels::ZERO {
+                    tooltip_bounds.origin.x = new_x;
+                } else {
+                    tooltip_bounds.origin.x = cmp::max(
+                        Pixels::ZERO,
+                        tooltip_bounds.origin.x - tooltip_bounds.right() - window_bounds.right(),
+                    );
+                }
+            }
+
+            if tooltip_bounds.bottom() > window_bounds.bottom() {
+                let new_y = mouse_position.y - tooltip_bounds.size.height - px(1.);
+                if new_y >= Pixels::ZERO {
+                    tooltip_bounds.origin.y = new_y;
+                } else {
+                    tooltip_bounds.origin.y = cmp::max(
+                        Pixels::ZERO,
+                        tooltip_bounds.origin.y - tooltip_bounds.bottom() - window_bounds.bottom(),
+                    );
+                }
+            }
+
+            // It's possible for an element to have an active tooltip while not being painted (e.g.
+            // via the `visible_on_hover` method). Since mouse listeners are not active in this
+            // case, instead update the tooltip's visibility here.
+            let is_visible =
+                (tooltip_request.tooltip.check_visible_and_update)(tooltip_bounds, self, cx);
+            if !is_visible {
+                continue;
+            }
+
+            self.with_absolute_element_offset(tooltip_bounds.origin, |window| {
+                element.prepaint(window, cx)
+            });
+
+            self.tooltip_bounds = Some(TooltipBounds {
+                id: tooltip_request.id,
+                bounds: tooltip_bounds,
+            });
+            return Some(element);
+        }
+        None
+    }
+
+    fn prepaint_deferred_draws(&mut self, cx: &mut App) {
+        assert_eq!(self.element_id_stack.len(), 0);
+
+        // Process deferred draws in multiple rounds to support nesting.
+        // Each round processes all current deferred draws, which may push new ones.
+        //
+        // The draws are processed in place rather than being moved out of
+        // `next_frame.deferred_draws`: `prepaint_index` snapshots that vector's
+        // length, so any prepaint range recorded during a round (view caches,
+        // nested deferred draws) must index the same vector `reuse_prepaint`
+        // slices on the next frame. Moving the draws out and re-appending them
+        // shifts the indices of nested draws, causing reused subtrees to graft
+        // the wrong deferred draws and panic in the dispatch tree.
+        let mut round_start = 0;
+        let mut depth = 0;
+        loop {
+            let round_end = self.next_frame.deferred_draws.len();
+            if round_start == round_end {
+                break;
+            }
+            // Limit maximum nesting depth to prevent infinite loops.
+            assert!(depth < 10, "Exceeded maximum (10) deferred depth");
+            depth += 1;
+
+            // Sort this round by priority.
+            let mut traversal_order = (round_start..round_end).collect::<SmallVec<[usize; 8]>>();
+            traversal_order.sort_by_key(|ix| self.next_frame.deferred_draws[*ix].priority);
+
+            for deferred_draw_ix in traversal_order {
+                let _render_scope = self.render_contexts.enter_snapshot(
+                    self.next_frame.deferred_draws[deferred_draw_ix].render_contexts.clone(),
+                );
+                // KaminIDE patch: a dirty isolated view is drawn again alone.
+                self.rebuild_isolated(deferred_draw_ix, cx);
+                let (element, parent_node, current_view, rem_size, absolute_offset, prepaint_range) = {
+                    let deferred_draw = &mut self.next_frame.deferred_draws[deferred_draw_ix];
+                    self.element_id_stack
+                        .clone_from(&deferred_draw.element_id_stack);
+                    self.text_style_stack = deferred_draw.text_style_stack.clone();
+                    (
+                        deferred_draw.element.take(),
+                        deferred_draw.parent_node,
+                        deferred_draw.current_view,
+                        deferred_draw.rem_size,
+                        deferred_draw.absolute_offset,
+                        deferred_draw.prepaint_range.clone(),
+                    )
+                };
+                self.next_frame.dispatch_tree.set_active_node(parent_node);
+
+                let prepaint_start = self.prepaint_index();
+                // KaminIDE patch: under the node the draw belongs to (`scroll_deferred`).
+                let entered = self.enter_deferred_prepaint(deferred_draw_ix);
+                if let Some(mut element) = element {
+                    let mut layout_owner = self.next_frame.deferred_draws[deferred_draw_ix]
+                        .layout_owner.clone();
+                    self.with_retained_layout(&mut layout_owner, |window| {
+                        window.with_rendered_view(current_view, |window| {
+                            window.with_rem_size(Some(rem_size), |window| {
+                                window.with_absolute_element_offset(absolute_offset, |window| {
+                                    element.prepaint(window, cx);
+                                });
+                            });
+                        });
+                    });
+                    self.next_frame.deferred_draws[deferred_draw_ix].element = Some(element);
+                } else {
+                    self.reuse_deferred_prepaint(deferred_draw_ix, prepaint_range);
+                }
+                self.leave_deferred_prepaint(entered);
+                let prepaint_end = self.prepaint_index();
+                self.next_frame.deferred_draws[deferred_draw_ix].prepaint_range =
+                    prepaint_start..prepaint_end;
+            }
+
+            self.element_id_stack.clear();
+            self.text_style_stack = TextStyleScope::default();
+            round_start = round_end;
+        }
+    }
+
+    fn paint_deferred_draws(&mut self, cx: &mut App) {
+        assert_eq!(self.element_id_stack.len(), 0);
+
+        // Paint all deferred draws in priority order.
+        // Since prepaint has already processed nested deferreds, we just paint them all.
+        if self.next_frame.deferred_draws.len() == 0 {
+            return;
+        }
+
+        let traversal_order = self.deferred_draw_traversal_order();
+        let mut deferred_draws = mem::take(&mut self.next_frame.deferred_draws);
+        for deferred_draw_ix in traversal_order {
+            let mut deferred_draw = &mut deferred_draws[deferred_draw_ix];
+            let _render_scope = self.render_contexts
+                .enter_snapshot(deferred_draw.render_contexts.clone());
+            self.element_id_stack
+                .clone_from(&deferred_draw.element_id_stack);
+            self.next_frame
+                .dispatch_tree
+                .set_active_node(deferred_draw.parent_node);
+
+            let paint_start = self.paint_index();
+            let groups_start = self.next_frame.scene.groups.len();
+            let content_mask = deferred_draw.content_mask;
+            if let Some(element) = deferred_draw.element.as_mut() {
+                // KaminIDE patch: under the node the draw belongs to (`scroll_deferred`).
+                let entered = self.enter_deferred_paint(&deferred_draw.scroll);
+                self.with_retained_layout(&mut deferred_draw.layout_owner, |window| {
+                    window.with_rendered_view(deferred_draw.current_view, |window| {
+                        window.with_content_mask(content_mask, |window| {
+                            window.with_rem_size(Some(deferred_draw.rem_size), |window| {
+                                element.paint(window, cx);
+                            });
+                        })
+                    })
+                });
+                self.leave_deferred_paint(entered);
+            } else {
+                let range = deferred_draw.paint_range.clone();
+                self.reuse_deferred_paint(&mut deferred_draw.scroll, range, deferred_draw.groups.clone());
+            }
+            let paint_end = self.paint_index();
+            deferred_draw.paint_range = paint_start..paint_end;
+            deferred_draw.groups = groups_start..self.next_frame.scene.groups.len();
+        }
+        self.next_frame.deferred_draws = deferred_draws;
+        self.element_id_stack.clear();
+    }
+
+    fn deferred_draw_traversal_order(&mut self) -> SmallVec<[usize; 8]> {
+        let deferred_count = self.next_frame.deferred_draws.len();
+        let mut sorted_indices = (0..deferred_count).collect::<SmallVec<[_; 8]>>();
+        sorted_indices.sort_by_key(|ix| self.next_frame.deferred_draws[*ix].priority);
+        sorted_indices
+    }
+
+    pub(crate) fn prepaint_index(&self) -> PrepaintStateIndex {
+        PrepaintStateIndex {
+            hitboxes_index: self.next_frame.hitboxes.len(),
+            tooltips_index: self.next_frame.tooltip_requests.len(),
+            deferred_draws_index: self.next_frame.deferred_draws.len(),
+            dispatch_tree_index: self.next_frame.dispatch_tree.len(),
+            accessed_element_states_index: self.next_frame.accessed_element_states.len(),
+            scroll_nodes_index: self.next_frame.scroll_nodes.len(),
+            line_layout_index: self.text_system.layout_index(),
+        }
+    }
+
+    pub(crate) fn reuse_prepaint(&mut self, range: Range<PrepaintStateIndex>) {
+        // KaminIDE patch: the scroll nodes prepainted in the range, and where
+        // they land (deferred draws keep their owner node, `scroll_deferred`).
+        let owners = scroll_deferred::OwnerMap::new(&range, self);
+        self.reuse_scroll_nodes(&range);
+        for hitbox in &self.rendered_frame.hitboxes[range.start.hitboxes_index..range.end.hitboxes_index] {
+            if let Some(scope) = self.rendered_frame.hitbox_scopes.get(&hitbox.id) {
+                self.next_frame.hitbox_scopes.insert(hitbox.id, scope.clone());
+            }
+            if self.rendered_frame.hover_hitboxes.contains(&hitbox.id) {
+                self.next_frame.hover_hitboxes.insert(hitbox.id);
+            }
+        }
+        let shift = self.next_frame.hitboxes.len();
+        for index in range.start.hitboxes_index..range.end.hitboxes_index {
+            if let Some(scope) = self.rendered_frame.hitbox_entry_scopes.get(&index) {
+                let entry = shift + index - range.start.hitboxes_index;
+                self.next_frame.hitbox_entry_scopes.insert(entry, scope.clone());
+            }
+        }
+        self.next_frame.hitboxes.extend(
+            self.rendered_frame.hitboxes[range.start.hitboxes_index..range.end.hitboxes_index]
+                .iter()
+                .cloned(),
+        );
+        self.next_frame.tooltip_requests.extend(
+            self.rendered_frame.tooltip_requests
+                [range.start.tooltips_index..range.end.tooltips_index]
+                .iter_mut()
+                .map(|request| request.take()),
+        );
+        self.next_frame.accessed_element_states.extend(
+            self.rendered_frame.accessed_element_states[range.start.accessed_element_states_index
+                ..range.end.accessed_element_states_index]
+                .iter()
+                .map(|(id, type_id)| (id.clone(), *type_id)),
+        );
+        self.text_system
+            .reuse_layouts(range.start.line_layout_index..range.end.line_layout_index);
+
+        let reused_subtree = self.next_frame.dispatch_tree.reuse_subtree(
+            range.start.dispatch_tree_index..range.end.dispatch_tree_index,
+            &mut self.rendered_frame.dispatch_tree,
+            self.focus,
+        );
+
+        if reused_subtree.contains_focus() {
+            self.next_frame.focus = self.focus;
+        }
+
+        self.next_frame.deferred_draws.extend(
+            self.rendered_frame.deferred_draws
+                [range.start.deferred_draws_index..range.end.deferred_draws_index]
+                .iter()
+                .map(|deferred_draw| DeferredDraw {
+                    current_view: deferred_draw.current_view,
+                    parent_node: reused_subtree.refresh_node_id(deferred_draw.parent_node),
+                    element_id_stack: deferred_draw.element_id_stack.clone(),
+                    text_style_stack: deferred_draw.text_style_stack.clone(),
+                    render_contexts: deferred_draw.render_contexts.clone(),
+                    layout_owner: deferred_draw.layout_owner.clone(),
+                    content_mask: deferred_draw.content_mask,
+                    rem_size: deferred_draw.rem_size,
+                    priority: deferred_draw.priority,
+                    element: None,
+                    absolute_offset: deferred_draw.absolute_offset,
+                    prepaint_range: deferred_draw.prepaint_range.clone(),
+                    paint_range: deferred_draw.paint_range.clone(),
+                    groups: deferred_draw.groups.clone(),
+                    isolated: deferred_draw.isolated.clone(),
+                    scroll: owners.copy(&deferred_draw.scroll),
+                    site: deferred_draw.site,
+                }),
+        );
+        // KaminIDE patch: reused isolated draws stay isolated in the new frame.
+        let isolated = &mut self.next_frame.isolated_views;
+        for draw in &self.rendered_frame.deferred_draws
+            [range.start.deferred_draws_index..range.end.deferred_draws_index]
+        {
+            if let Some(draw) = &draw.isolated {
+                isolated.insert(draw.view.entity_id());
+            }
+        }
+    }
+
+    pub(crate) fn paint_index(&self) -> PaintIndex {
+        PaintIndex {
+            scene_index: self.next_frame.scene.len(),
+            #[cfg(any(test, feature = "test-support"))]
+            debug_bounds_index: self.next_frame.debug_bounds_records.len(),
+            mouse_listeners_index: self.next_frame.mouse_listeners.len(),
+            input_handlers_index: self.next_frame.input_handlers.len(),
+            cursor_styles_index: self.next_frame.cursor_styles.len(),
+            accessed_element_states_index: self.next_frame.accessed_element_states.len(),
+            tab_handle_index: self.next_frame.tab_stops.paint_index(),
+            line_layout_index: self.text_system.layout_index(),
+        }
+    }
+
+    /// KaminIDE patch: `reuse_paint` of everything but the scene commands.
+    pub(crate) fn reuse_paint_state(&mut self, range: &Range<PaintIndex>) {
+        // Cached elements still exist in the frame even when their paint methods don't run.
+        #[cfg(any(test, feature = "test-support"))]
+        for (selector, bounds) in &self.rendered_frame.debug_bounds_records
+            [range.start.debug_bounds_index..range.end.debug_bounds_index]
+        {
+            self.next_frame
+                .record_debug_bounds(selector.clone(), *bounds);
+        }
+        self.next_frame.cursor_styles.extend(
+            self.rendered_frame.cursor_styles
+                [range.start.cursor_styles_index..range.end.cursor_styles_index]
+                .iter()
+                .cloned(),
+        );
+        self.next_frame.input_handlers.extend(
+            self.rendered_frame.input_handlers
+                [range.start.input_handlers_index..range.end.input_handlers_index]
+                .iter_mut()
+                .map(|handler| handler.take()),
+        );
+        self.next_frame.mouse_listeners.extend(
+            self.rendered_frame.mouse_listeners
+                [range.start.mouse_listeners_index..range.end.mouse_listeners_index]
+                .iter_mut()
+                .map(|listener| listener.take()),
+        );
+        self.next_frame.accessed_element_states.extend(
+            self.rendered_frame.accessed_element_states[range.start.accessed_element_states_index
+                ..range.end.accessed_element_states_index]
+                .iter()
+                .map(|(id, type_id)| (id.clone(), *type_id)),
+        );
+        self.next_frame.tab_stops.replay(
+            &self.rendered_frame.tab_stops.insertion_history
+                [range.start.tab_handle_index..range.end.tab_handle_index],
+        );
+
+        self.text_system
+            .reuse_layouts(range.start.line_layout_index.clone()..range.end.line_layout_index.clone());
+    }
+
+    pub(crate) fn reuse_paint(&mut self, range: Range<PaintIndex>) {
+        self.reuse_paint_state(&range);
+        // KaminIDE patch: a range recorded inside a scene layer is in its scene.
+        let scenes = range.start.scene_index..range.end.scene_index;
+        let landed = self.next_frame.scene.paint_operations.len();
+        let from = match self.replay_source() {
+            Some(source) => {
+                self.next_frame.scene.replay(scenes.clone(), source.scene());
+                source.scene().scroll.space
+            }
+            None => {
+                self.next_frame.scene.replay(scenes.clone(), &self.rendered_frame.scene);
+                self.rendered_frame.scene.scroll.space
+            }
+        };
+        self.land_scroll_paint(scenes, landed, from);
+    }
+
+    /// KaminIDE patch: read the host context of type `T` for this traversal.
+    /// Values belong to this window; callers retain ownership through `Rc`.
+    pub fn render_context<T: 'static>(&self) -> Option<Rc<T>> {
+        self.render_contexts.get()
+    }
+
+    /// KaminIDE patch: run descendants with a typed host context.
+    /// `None` hides this type's outer value. Nested scopes restore it on return
+    /// or unwind. Paint/deferred snapshots clone each `Rc`; interior mutations
+    /// remain shared with the original value.
+    pub fn with_render_context<T: 'static, R>(
+        &mut self,
+        context: Option<Rc<T>>,
+        f: impl FnOnce(&mut Self) -> R,
+    ) -> R {
+        let scope = self.render_contexts.enter(context);
+        self.with_restore(scope, |_, _| {}, f).0
+    }
+
+    /// Push a text style onto the stack, and call a function with that style active.
+    /// Use [`Window::text_style`] to get the current, combined text style. This method
+    /// should only be called as part of element drawing.
+    pub fn with_text_style<F, R>(&mut self, style: Option<TextStyleRefinement>, f: F) -> R
+    where
+        F: FnOnce(&mut Self) -> R,
+    {
+        self.invalidator.debug_assert_paint_or_prepaint();
+        if let Some(style) = style {
+            let inner = self.text_style_stack.push(style);
+            let outer = std::mem::replace(&mut self.text_style_stack, inner);
+            self.with_restore(outer, |window, outer| window.text_style_stack = std::mem::take(outer), f).0
+        } else {
+            f(self)
+        }
+    }
+
+    /// Apply borrowed text and overflow context together during child drawing.
+    pub(crate) fn with_child_style<R>(
+        &mut self,
+        style: &Style,
+        bounds: Bounds<Pixels>,
+        f: impl FnOnce(&mut Self) -> R,
+    ) -> R {
+        self.invalidator.debug_assert_paint_or_prepaint();
+        let depth = (self.text_style_stack.clone(), self.content_mask_stack.len());
+        if let Some(text) = style.text_style() {
+            self.push_text_style_ref(text);
+        }
+        let _clip_scope = self.push_content_mask(style.overflow_mask_snapped(bounds, self));
+        self.with_restore(depth, |window, depth| {
+            window.text_style_stack = std::mem::take(&mut depth.0);
+            window.content_mask_stack.truncate(depth.1);
+        }, f).0
+    }
+
+    #[inline(never)]
+    fn push_text_style_ref(&mut self, style: &TextStyleRefinement) {
+        self.text_style_stack = self.text_style_stack.push(style.clone());
+    }
+
+    /// Updates the cursor style at the platform level. This method should only be called
+    /// during the paint phase of element drawing.
+    pub fn set_cursor_style(&mut self, style: CursorStyle, hitbox: &Hitbox) {
+        self.invalidator.debug_assert_paint();
+        self.next_frame.cursor_styles.push(CursorStyleRequest {
+            hitbox_id: Some(hitbox.id),
+            style,
+        });
+    }
+
+    /// Updates the cursor style for the entire window at the platform level. A cursor
+    /// style using this method will have precedence over any cursor style set using
+    /// `set_cursor_style`. This method should only be called during the paint
+    /// phase of element drawing.
+    pub fn set_window_cursor_style(&mut self, style: CursorStyle) {
+        self.invalidator.debug_assert_paint();
+        self.next_frame.cursor_styles.push(CursorStyleRequest {
+            hitbox_id: None,
+            style,
+        })
+    }
+
+    /// Sets a tooltip to be rendered for the upcoming frame. This method should only be called
+    /// during the paint phase of element drawing.
+    pub fn set_tooltip(&mut self, tooltip: AnyTooltip) -> TooltipId {
+        self.invalidator.debug_assert_prepaint();
+        let id = TooltipId(post_inc(&mut self.next_tooltip_id.0));
+        self.next_frame
+            .tooltip_requests
+            .push(Some(TooltipRequest { id, tooltip }));
+        id
+    }
+
+    /// Invoke the given function with the given content mask after intersecting it
+    /// with the current mask. This method should only be called during element drawing.
+    // This function is called in a highly recursive manner in editor
+    // prepainting, make sure its inlined to reduce the stack burden
+    #[inline]
+    pub fn with_content_mask<R>(
+        &mut self,
+        mask: Option<ContentMask<Pixels>>,
+        f: impl FnOnce(&mut Self) -> R,
+    ) -> R {
+        self.invalidator.debug_assert_paint_or_prepaint();
+        let depth = self.content_mask_stack.len();
+        let _clip_scope = self.push_content_mask(mask);
+        self.with_restore(depth, |window, depth| window.content_mask_stack.truncate(*depth), f).0
+    }
+
+    // Prepare mask temporaries before entering the recursive child traversal.
+    #[inline(never)]
+    fn push_content_mask(&mut self, mask: Option<ContentMask<Pixels>>) -> Option<render_context::Scope> {
+        if let Some(mask) = mask {
+            // KaminIDE patch: под `with_transformation_masked` маска ребёнка
+            // задана в его НЕпреобразованных точках, а шейдер сравнивает её с
+            // уже преобразованной позицией (`distance_from_clip_rect_transformed`):
+            // переводим той же матрицей, что и квады. Подобие стопки страниц
+            // в итоговой матрице уже есть, `scaled_mask` второй раз не нужен.
+            let mask = match self.mask_map {
+                Some(m) => self.mapped_mask(mask, &m),
+                None => self.scaled_mask(mask),
+            };
+            let scope = self.segment_clip_scope(mask, false);
+            self.content_mask_stack.push(mask.intersect(&self.content_mask()));
+            scope
+        } else {
+            None
+        }
+    }
+
+    /// KaminIDE patch: подменить маску содержимого БЕЗ пересечения с
+    /// текущей. Нужно собственному фону коробки с `overflow: hidden`: маска
+    /// коробки — её padding-box, а фон по `background-clip` красится до
+    /// border-box (css-backgrounds-3 §3.7; overflow режет содержимое, не
+    /// собственный фон).
+    pub fn with_content_mask_replaced<R>(
+        &mut self,
+        mask: ContentMask<Pixels>,
+        f: impl FnOnce(&mut Self) -> R,
+    ) -> R {
+        self.invalidator.debug_assert_paint_or_prepaint();
+        let mask = self.scaled_mask(mask);
+        let _clip_scope = self.segment_clip_scope(mask, true);
+        let depth = self.content_mask_stack.len();
+        self.content_mask_stack.push(mask);
+        self.with_restore(depth, |window, depth| window.content_mask_stack.truncate(*depth), f).0
+    }
+
+    /// KaminIDE patch: восстановить маску, прочитанную `content_mask` (уже в
+    /// итоговых координатах окна), без пересечения с текущей и без повторного
+    /// масштаба стопки страниц. Продолжение OOF в копии фрагмента режет его
+    /// фрагментаинер, а не срез копии (`paint::continuation`).
+    pub fn with_content_mask_exact<R>(
+        &mut self,
+        mask: ContentMask<Pixels>,
+        f: impl FnOnce(&mut Self) -> R,
+    ) -> R {
+        self.invalidator.debug_assert_paint_or_prepaint();
+        let _clip_scope = self.segment_clip_scope(mask, true);
