+            bounds: Bounds {
+                origin: Point::new(
+                    Pixels(o.x.0 + (b.origin.x.0 - o.x.0) * s),
+                    Pixels(o.y.0 + (b.origin.y.0 - o.y.0) * s),
+                ),
+                size: Size {
+                    width: Pixels(b.size.width.0 * s),
+                    height: Pixels(b.size.height.0 * s),
+                },
+            },
+        }
