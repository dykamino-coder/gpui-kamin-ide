+        #[test]
+        fn completion_order_sealer_matches_reference_under_arbitrary_batching(
+            specifications in prop::collection::vec((0u8..16, 0u8..128, any::<u8>()), 1..=96),
+            batch_sizes in prop::collection::vec(1usize..=12, 1..=24),
+        ) {
