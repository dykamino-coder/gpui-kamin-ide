+    pub spawned: SpawnTime,
+    pub start: Instant,
+}
+
+impl TaskTiming {
+    /// A task timing with a duration of zero. Any task will replace this in history.
+    pub fn placeholder() -> Self {
+        let now = Instant::now();
+        Self {
+            location: std::panic::Location::caller(),
+            spawned: SpawnTime(now),
+            start: now,
+            end: YieldTime(now),
+        }
+    }
