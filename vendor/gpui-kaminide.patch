-    pub fn possible_next_bindings_for_input(
-        &self,
-        input: &[Keystroke],
-        context_stack: &[KeyContext],
-    ) -> Vec<KeyBinding> {
-        // Keeps `null` and `Unbind` bindings, which can disable candidates.
