+/// KaminIDE patch: описатель ЧУЖОЙ текстуры (кадр браузера), лежащей в
+/// атласе. Наружу отдаётся как непрозрачный тип: приложение не должно знать
+/// про внутренности атласа.
+#[derive(Clone, Debug)]
+pub struct ExternalTexture(pub(crate) AtlasTile);
+
+impl ExternalTexture {
+    /// KaminIDE patch: тот же кадр, но с обрезкой до `width`×`height`
+    /// (в физических px, от левого верхнего угла).
+    ///
+    /// Нужно при ресайзе: пока браузер не перевёрстывал, лучше показать ЧАСТЬ
+    /// старого кадра пиксель в пиксель, чем сжать его целиком — сжатие глаз
+    /// ловит сразу.
+    pub fn cropped(&self, width: i32, height: i32) -> Self {
+        let mut tile = self.0.clone();
+        tile.bounds.size.width = crate::DevicePixels(width.max(1)).min(tile.bounds.size.width);
+        tile.bounds.size.height = crate::DevicePixels(height.max(1)).min(tile.bounds.size.height);
+        Self(tile)
+    }
+
+    /// KaminIDE patch: вырезка региона кадра СО СМЕЩЕНИЕМ (физические px).
+    ///
+    /// Chromium кладёт страницу внутри буфера не с угла: при ресайзе
+    /// `content_rect` бывает `482×369 @0,64`, а края буфера прозрачны и
+    /// рисуются чёрным. Обрезка только по размеру (`cropped`) оставляла
+    /// чёрную полосу СВЕРХУ — нужно и смещение начала.
+    pub fn region(&self, x: i32, y: i32, width: i32, height: i32) -> Self {
+        let mut tile = self.0.clone();
+        let max_w = (tile.bounds.size.width.0 - x).max(1);
+        let max_h = (tile.bounds.size.height.0 - y).max(1);
+        tile.bounds.origin.x = tile.bounds.origin.x + crate::DevicePixels(x.max(0));
+        tile.bounds.origin.y = tile.bounds.origin.y + crate::DevicePixels(y.max(0));
+        tile.bounds.size.width = crate::DevicePixels(width.clamp(1, max_w));
+        tile.bounds.size.height = crate::DevicePixels(height.clamp(1, max_h));
+        Self(tile)
+    }
+
+    /// KaminIDE patch: тот же слот атласа, но кадр другого размера.
+    pub fn with_size(&self, width: i32, height: i32) -> Self {
+        let mut tile = self.0.clone();
+        tile.bounds.size.width = crate::DevicePixels(width.max(1));
+        tile.bounds.size.height = crate::DevicePixels(height.max(1));
+        Self(tile)
+    }
+
+    /// KaminIDE patch: размер кадра в физических px.
+    pub fn size(&self) -> (i32, i32) {
+        (self.0.bounds.size.width.0, self.0.bounds.size.height.0)
+    }
+}
