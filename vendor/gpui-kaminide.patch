+    /// Inserts `count` random rectangles, returning them with their orderings.
+    fn filled(rng: &mut rand::rngs::StdRng, count: usize) -> (BoundsTree<f32>, Vec<(Bounds<f32>, u32)>) {
+        let mut tree = BoundsTree::default();
