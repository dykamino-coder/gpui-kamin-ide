+//! The layer damage of a replayed frame that draws effect groups
+//! (`Scene::note_damage`, `grouped_damage`).
+
+use super::{Binding, LayerHandle, LayerValue, SceneLayer};
+use crate::scene::{PaintGroup, SceneDamage};
+use crate::{Background, Bounds, ContentMask, Hsla, Quad, ScaledPixels, Scene, hsla, point, size};
+use std::rc::Rc;
+
+const W: u32 = 400;
+const H: u32 = 400;
+
+fn rect(x: f32, y: f32, w: f32, h: f32) -> Bounds<ScaledPixels> {
+    Bounds {
+        origin: point(ScaledPixels(x), ScaledPixels(y)),
+        size: size(ScaledPixels(w), ScaledPixels(h)),
+    }
+}
+
+fn quad(b: Bounds<ScaledPixels>, color: Hsla) -> Quad {
+    Quad {
+        bounds: b,
+        content_mask: ContentMask {
+            bounds: rect(0., 0., W as f32, H as f32),
+        },
+        background: Background::from(color),
+        ..Default::default()
+    }
+}
+
+fn red() -> Hsla {
+    hsla(0., 1., 0.5, 1.)
+}
+
+fn blue() -> Hsla {
+    hsla(0.66, 1., 0.5, 1.)
+}
+
+/// A layer whose owner 7 paints one box at (50, 50).
+fn layer() -> LayerHandle {
+    let mut scene = Scene::default();
+    scene.insert_primitive(quad(rect(50., 50., 100., 100.), red()));
+    let op = (scene.paint_operations.len() - 1) as u32;
+    let bindings = vec![Binding { owner: 7, value: LayerValue::Background, quad: 0, op, opacity: 1. }];
+    LayerHandle::new(SceneLayer::finish(scene, bindings, Vec::new()))
+}
+
+/// A group at (250, 250) painting one box of `color`.
+fn group(color: Hsla) -> PaintGroup {
+    let mut inner = Scene::default();
+    inner.insert_primitive(quad(rect(250., 250., 50., 50.), color));
+    PaintGroup {
+        scene: Rc::new(inner),
+        bounds: rect(250., 250., 50., 50.),
+        ..Default::default()
+    }
+}
+
+/// The damage of a frame replaying `rendered` after owner 7 turned blue,
+/// drawing `next_group` where `rendered` drew a red group.
+fn replayed(layer: &LayerHandle, next_group: PaintGroup) -> SceneDamage {
+    let mut rendered = Scene::default();
+    rendered.insert_layer(layer, rect(0., 0., W as f32, H as f32));
+    rendered.groups.push(group(red()));
+    rendered.finish();
+    rendered.note_frame_damage(&Scene::default(), 1, (W, H));
+    rendered.release_layers();
+    layer.set_background(7, red(), blue()).expect("owner 7 painted red");
+    let mut next = Scene::default();
+    next.replay(0..rendered.paint_operations.len(), &rendered);
+    next.groups.push(next_group);
+    next.finish();
+    next.note_damage(&rendered);
+    next.note_frame_damage(&rendered, 2, (W, H));
+    next.frame_damage().0
+}
+
+#[test]
+fn a_replayed_frame_whose_groups_paint_the_same_images_is_damaged_where_its_layers_were_written() {
+    assert_eq!(
+        replayed(&layer(), group(red())),
+        SceneDamage::Rect { x: 50, y: 50, width: 100, height: 100 }
+    );
+}
+
+#[test]
+fn a_group_that_paints_another_image_leaves_the_layer_damage_unknown() {
+    assert_eq!(replayed(&layer(), group(blue())), SceneDamage::Unknown);
+}
diff --git a/vendor/gpui/src/scene/layer/no_run.rs b/vendor/gpui/src/scene/layer/no_run.rs
new file mode 100644
index 0000000000000000000000000000000000000000..08c807b4b2435a6f38f84019371e88905229d2ce
--- /dev/null
+++ b/vendor/gpui/src/scene/layer/no_run.rs
@@ -0,0 +1,70 @@
+//! KaminIDE patch: why a box painted into a scene layer keeps no run there,
+//! for the DevTools `why` journal of a host (`LayerHandle::no_run`).
+//!
+//! A host that cannot record a box again asks why the layer holds no run of
+//! it: the box painted in a group's scene, a nested stacking layer or a 3D
+//! context (`Scene::run_refusal`), or its paint left its runs
+//! (`Window::unhold_owner`). Kept only while a reader traces
+//! (`dirty_sources::trace::enabled`), for the last layer recorded, and bounded;
+//! otherwise nothing is noted and nothing is held.
+
+use crate::dirty_sources::trace::{Shared, enabled};
+use std::sync::atomic::{AtomicU64, Ordering::Relaxed};
+
+/// Notes kept for one layer; later ones are dropped.
+const NOTES: usize = 1 << 16;
+
+static NO_RUN: Shared<Vec<(u32, &'static str)>> = Shared::new(Vec::new());
+/// The draw that recorded the notes, and the draw now (`drawn`).
+static NOTED: AtomicU64 = AtomicU64::new(0);
+static DRAW: AtomicU64 = AtomicU64::new(0);
+
+/// A window draws: the layers it records replace the notes of earlier draws.
+pub(crate) fn drawn() {
+    if enabled() {
+        DRAW.fetch_add(1, Relaxed);
+    }
+}
+
+/// A layer is recorded: the first of a draw drops the notes of the last draw
+/// that recorded, so the layers of one draw (the root's, lifted ones) keep theirs.
+pub(crate) fn start() {
+    if enabled() {
+        let draw = DRAW.load(Relaxed);
+        if NOTED.swap(draw, Relaxed) != draw {
+            NO_RUN.lock().clear();
+        }
+    }
+}
+
+/// Box `owner` keeps no run of this paint, for `why`.
+pub(crate) fn note(owner: u32, why: &'static str) {
+    if enabled() {
+        let mut notes = NO_RUN.lock();
+        if notes.len() < NOTES {
+            notes.push((owner, why));
+        }
+    }
+}
+
+impl super::LayerHandle {
+    /// Why box `owner` keeps no run in the layer last recorded, when a reader
+    /// traced its recording; `None` when nothing refused it a run (the frame
+    /// did not paint the box) or nobody traced.
+    pub fn no_run(&self, owner: u32) -> Option<&'static str> {
+        NO_RUN.lock().iter().find(|(o, _)| *o == owner).map(|(_, why)| *why)
+    }
+
+    /// The painters of box `owner`'s runs, in paint order (a mixed
+    /// `LayerPainter::External` named apart), for `why`.
+    pub fn run_painters(&self, owner: u32) -> Vec<(crate::LayerPainter, bool)> {
+        let content = self.0.content.borrow();
+        content
+            .runs_of(owner)
+            .map(|at| {
+                let run = &content.boxes[at];
+                (run.env.painter.kind(), run.replaceable)
+            })
+            .collect()
+    }
+}
diff --git a/vendor/gpui/src/scene/layer/order.rs b/vendor/gpui/src/scene/layer/order.rs
new file mode 100644
index 0000000000000000000000000000000000000000..cab5f255190c3f9f50bf0c1a668fe10d8115e719
--- /dev/null
+++ b/vendor/gpui/src/scene/layer/order.rs
@@ -0,0 +1,258 @@
+//! KaminIDE patch: the draw orders of a box's run recorded again in a scene
+//! layer.
+//!
+//! A layer's scene holds the orders a scene without layers gives the same
+//! commands (`scene::layer::boxes`): a primitive outside layers takes
+//! `ORDER_STEP` times one more than the highest bucket of the earlier
+//! rectangles of the bounds tree it meets, a layer's primitives the layer's.
+//! The commands give the tree's rectangles: primitives outside layers by their
+//! ink, layers by their bounds at any depth (`Scene::push_layer`), retained
+//! layers outside layers by theirs; the bottom layer adds none. A box's new
+//! run takes, command by command, the bucket the tree gives it after the
+//! commands before the run, as a paint from scratch does. A later rectangle
+//! the change reaches takes the bucket that paint gives it: above a moved
+//! rectangle it meets that went higher, or, held by one that went or went
+//! lower, one above the highest it meets before it; the others keep theirs
+//! (`scene::layer::reorder` moves them). The layer keeps the orders of that
+//! paint, so each later run is planned from exact orders again.
+
+use super::SceneLayer;
+use super::boxes::{BoxRange, ink_of};
+use crate::scene::{DrawOrder, ORDER_STEP, PaintOperation, Primitive};
+use crate::{Bounds, ScaledPixels};
+
+/// The orders of a box's new run and what its splice needs.
+pub(crate) struct Plan {
+    /// The new run's ink.
+    pub(crate) ink: Option<Bounds<ScaledPixels>>,
+    /// The order of each new command.
+    pub(crate) orders: Vec<DrawOrder>,
+    /// `(kind, order, n)`: the `n` primitives of a kind and order of the old
+    /// or new run painted before the run (each sorted list holds an order's
+    /// entries in paint order).
+    pub(crate) before: Vec<(u8, DrawOrder, usize)>,
+    /// Whether an ink or order of the run, or a later order, changed.
+    pub(crate) changed: bool,
+    /// `(command, bucket)`: later commands (primitives outside layers and
+    /// layers) a paint from scratch gives another bucket, in paint order.
+    pub(crate) later: Vec<(usize, DrawOrder)>,
+}
+
+/// A rectangle of the tree whose bucket the new run moves: `was` before,
+/// `now` after (`None`: not there).
+struct Moved {
+    rect: Bounds<ScaledPixels>,
+    was: Option<DrawOrder>,
+    now: Option<DrawOrder>,
+}
+
+impl Plan {
+    /// The entries of `kind` (shadow 0, quad 1, underline 2) and `order`
+    /// painted before the run.
+    pub(crate) fn before(&self, kind: u8, order: DrawOrder) -> usize {
+        self.before
+            .iter()
+            .find(|b| b.0 == kind && b.1 == order)
+            .map_or(0, |b| b.2)
+    }
+}
+
+/// The kind of a plain primitive, as `Plan::before` counts it.
+pub(crate) fn plain_kind(p: &Primitive) -> Option<u8> {
+    match p {
+        Primitive::Shadow(_) => Some(0),
+        Primitive::Quad(_) | Primitive::Gradient(_) => Some(1),
+        Primitive::Underline(_) => Some(2),
+        _ => None,
+    }
+}
+
+/// Each rectangle the bounds tree holds for `ops`, with its command and
+/// bucket, in insertion order; `false` for 3D commands, whose depth sort
+/// reorders them.
+fn tree_rects(ops: &[PaintOperation], mut f: impl FnMut(usize, Bounds<ScaledPixels>, DrawOrder)) -> bool {
+    let mut depth = 0usize;
+    for (at, op) in ops.iter().enumerate() {
+        match op {
+            PaintOperation::Primitive(p) => {
+                let ink = ink_of(p);
+                if depth == 0 && !ink.is_empty() {
+                    f(at, ink, p.order() / ORDER_STEP);
+                }
+            }
+            PaintOperation::StartLayer(bounds, order) => {
+                depth += 1;
+                f(at, *bounds, order / ORDER_STEP);
+            }
+            PaintOperation::StartBottomLayer => depth += 1,
+            PaintOperation::EndLayer => depth = depth.saturating_sub(1),
+            // KaminIDE patch: a dormant primitive draws nothing.
+            PaintOperation::Dormant(_) | PaintOperation::Reservoir(_) => {}
+            PaintOperation::Layer(layer) => {
+                if depth == 0 {
+                    f(at, layer.bounds, layer.order / ORDER_STEP);
+                }
+            }
+            PaintOperation::StartDepthContext
+            | PaintOperation::EndDepthContext
+            | PaintOperation::StartDepthPlane(_)
+            | PaintOperation::EndDepthPlane => return false,
+        }
+    }
+    true
+}
+
+fn max_meeting(rects: &[Bounds<ScaledPixels>], buckets: &[DrawOrder], r: &Bounds<ScaledPixels>) -> DrawOrder {
+    rects
+        .iter()
+        .zip(buckets)
+        .filter(|(n, _)| n.intersects(r))
+        .map(|(_, t)| *t)
+        .max()
+        .unwrap_or(0)
+}
+
+impl SceneLayer {
+    /// The orders of `new` (plain primitives, painted by box `b` again) as a
+    /// paint from scratch gives them; `None` when that paint would order a
+    /// later command otherwise, or the layer holds 3D commands.
+    pub(crate) fn plan_box(&self, b: &BoxRange, new: &[PaintOperation]) -> Option<Plan> {
+        let ops = &self.scene.paint_operations;
+        let run = b.ops.start as usize..b.ops.end as usize;
+        let mut rects = Vec::with_capacity(new.len());
+        for op in new {
+            let PaintOperation::Primitive(p) = op else { return None };
+            let ink = ink_of(p);
+            if ink.is_empty() {
+                return None;
+            }
+            rects.push(ink);
+        }
+        let mut old = Vec::with_capacity(run.len());
+        for op in &ops[run.clone()] {
+            if let PaintOperation::Primitive(p) = op {
+                old.push((ink_of(p), p.order() / ORDER_STEP));
+            }
+        }
+        // The highest bucket below each new command, then its own.
+        let mut below = vec![0; rects.len()];
+        let exact = tree_rects(ops, |at, r, t| {
+            if at < run.start {
+                for (low, n) in below.iter_mut().zip(&rects) {
+                    if n.intersects(&r) {
+                        *low = (*low).max(t);
+                    }
+                }
+            }
+        });
+        if !exact {
+            return None;
+        }
+        let mut buckets: Vec<DrawOrder> = Vec::with_capacity(rects.len());
+        for (j, n) in rects.iter().enumerate() {
+            let inside = max_meeting(&rects[..j], &buckets, n);
+            buckets.push(below[j].max(inside) + 1);
+        }
+        // The rectangles whose bucket moved: the old run's (gone), the new
+        // run's, and each later one the change moves, in paint order.
+        let mut moved: Vec<Moved> = old.iter().map(|&(rect, t)| Moved { rect, was: Some(t), now: None }).collect();
+        moved.extend(rects.iter().zip(&buckets).map(|(&rect, &t)| Moved { rect, was: None, now: Some(t) }));
+        let mut later: Vec<(usize, DrawOrder)> = Vec::new();
+        let mut layers_moved = false;
+        tree_rects(ops, |at, r, x| {
+            if at < run.end {
+                return;
+            }
+            let meeting = moved.iter().filter(|m| m.rect.intersects(&r));
+            let up = meeting.clone().filter_map(|m| m.now).max().unwrap_or(0);
+            // Held by a rectangle that went or went down: it may go down too.
+            let held = meeting.clone().any(|m| m.was == Some(x - 1) && m.now.is_none_or(|n| n + 1 < x));
+            let now = if up + 1 > x {
+                up + 1
+            } else if held && up + 1 < x {
+                self.highest_below(at, &run, &later, &moved, &r) + 1
+            } else {
+                x
+            };
+            if now != x {
+                layers_moved |= matches!(ops[at], PaintOperation::Layer(_));
+                moved.push(Moved { rect: r, was: Some(x), now: Some(now) });
+                later.push((at, now));
+            }
+        });
+        if layers_moved {
+            return None;
+        }
+        let orders: Vec<DrawOrder> = buckets.iter().map(|t| t * ORDER_STEP).collect();
+        let before = before_run(ops, &run, new, &orders);
+        let changed = !later.is_empty()
+            || old.len() != rects.len()
+            || old.iter().zip(rects.iter().zip(&buckets)).any(|((o, t), (n, u))| o != n || t != u);
+        let ink = rects.iter().copied().reduce(|a, b| a.union(&b));
+        Some(Plan { ink, orders, before, changed, later })
+    }
+
+    /// The highest bucket meeting `r` of the rectangles before command `at`:
+    /// those of the commands outside `run` (with the buckets `later` gave)
+    /// and of the new run.
+    fn highest_below(
+        &self,
+        at: usize,
+        run: &std::ops::Range<usize>,
+        later: &[(usize, DrawOrder)],
+        moved: &[Moved],
+        r: &Bounds<ScaledPixels>,
+    ) -> DrawOrder {
+        let mut high = moved
+            .iter()
+            .filter(|m| m.was.is_none() && m.rect.intersects(r))
+            .filter_map(|m| m.now)
+            .max()
+            .unwrap_or(0);
+        tree_rects(&self.scene.paint_operations[..at], |i, n, t| {
+            if !run.contains(&i) && n.intersects(r) {
+                let t = later.binary_search_by_key(&i, |l| l.0).map_or(t, |k| later[k].1);
+                high = high.max(t);
+            }
+        });
+        high
+    }
+}
+
+/// `(kind, order, n)` for each kind and order of the old run `run` of `ops`
+/// and of the new commands `new` (with `orders`): the `n` primitives of that
+/// kind and order painted before the run.
+pub(crate) fn before_run(
+    ops: &[PaintOperation],
+    run: &std::ops::Range<usize>,
+    new: &[PaintOperation],
+    orders: &[DrawOrder],
+) -> Vec<(u8, DrawOrder, usize)> {
+    let mut before: Vec<(u8, DrawOrder, usize)> = Vec::new();
+    let olds = ops[run.clone()].iter();
+    let news = new.iter().zip(orders).map(|(op, o)| (op, *o));
+    for (op, order) in olds.map(|op| (op, order_of(op))).chain(news) {
+        if let PaintOperation::Primitive(p) = op
+            && let Some(kind) = plain_kind(p)
+            && !before.iter().any(|b| b.0 == kind && b.1 == order)
+        {
+            before.push((kind, order, 0));
+        }
+    }
+    for op in &ops[..run.start] {
+        if let PaintOperation::Primitive(p) = op
+            && let Some(kind) = plain_kind(p)
+            && let Some(b) = before.iter_mut().find(|b| b.0 == kind && b.1 == p.order())
+        {
+            b.2 += 1;
+        }
+    }
+    before
+}
+
+fn order_of(op: &PaintOperation) -> DrawOrder {
+    match op {
+        PaintOperation::Primitive(p) => p.order(),
+        _ => 0,
+    }
+}
diff --git a/vendor/gpui/src/scene/layer/order_line.rs b/vendor/gpui/src/scene/layer/order_line.rs
new file mode 100644
index 0000000000000000000000000000000000000000..6b953056e7c90f41ab6f6a9cbbd9da64b8d297cd
--- /dev/null
+++ b/vendor/gpui/src/scene/layer/order_line.rs
@@ -0,0 +1,66 @@
+//! KaminIDE patch: the draw orders of a run recorded again inside a stacking
+//! layer (the piece of an inline box's band on its line,
+//! `text_system::band_piece`).
+//!
+//! Every primitive inside a stacking layer takes the layer's order
+//! (`Scene::insert_primitive`), and the layer's rectangle in the bounds tree
+//! is its bounds (`Scene::push_layer`), not the ink of what it holds. A run
+//! painted again inside the layer therefore takes the layer's order for each
+//! command and moves no rectangle of the tree: nothing after it is ordered
+//! otherwise. The layer's order is read from the commands, the stacking
+//! layer that encloses the run, so a run placed from a paint record
+//! (`super::placed`) takes the order its placement gave.
+
+use super::SceneLayer;
+use super::boxes::{BoxRange, ink_of};
+use super::order::{Plan, before_run};
+use crate::scene::{DrawOrder, PaintOperation};
+
+/// The order of the stacking layer around command `at` of `ops`; `None`
+/// outside layers or in the bottom layer, whose primitives take orders of
+/// their own.
+fn enclosing_layer(ops: &[PaintOperation], at: usize) -> Option<DrawOrder> {
+    let mut depth = 0usize;
+    for op in ops[..at].iter().rev() {
+        match op {
+            PaintOperation::EndLayer => depth += 1,
+            PaintOperation::StartLayer(_, order) if depth == 0 => return Some(*order),
+            PaintOperation::StartBottomLayer if depth == 0 => return None,
+            PaintOperation::StartLayer(..) | PaintOperation::StartBottomLayer => depth -= 1,
+            _ => {}
+        }
+    }
+    None
+}
+
+impl SceneLayer {
+    /// The orders of `new` (plain primitives, the run `b` inside a stacking
+    /// layer painted again) as a paint from scratch gives them: the layer's
+    /// order for each.
+    pub(crate) fn plan_layer_run(&self, b: &BoxRange, new: &[PaintOperation]) -> Option<Plan> {
+        let ops = &self.scene.paint_operations;
+        let run = b.ops.start as usize..b.ops.end as usize;
+        let order = enclosing_layer(ops, run.start)?;
+        let mut inks = Vec::with_capacity(new.len());
+        for op in new {
+            let PaintOperation::Primitive(p) = op else { return None };
+            let ink = ink_of(p);
+            if ink.is_empty() {
+                return None;
+            }
+            inks.push(ink);
+        }
+        let old: Vec<_> = ops[run.clone()]
+            .iter()
+            .filter_map(|op| match op {
+                PaintOperation::Primitive(p) => Some(ink_of(p)),
+                _ => None,
+            })
+            .collect();
+        let orders = vec![order; new.len()];
+        let before = before_run(ops, &run, new, &orders);
+        let changed = old != inks;
+        let ink = inks.iter().copied().reduce(|a, b| a.union(&b));
+        Some(Plan { ink, orders, before, changed, later: Vec::new() })
+    }
+}
diff --git a/vendor/gpui/src/scene/layer/order_tests.rs b/vendor/gpui/src/scene/layer/order_tests.rs
new file mode 100644
index 0000000000000000000000000000000000000000..36dc6b56d9e18e485a64583a877411ef8f6656ee
--- /dev/null
+++ b/vendor/gpui/src/scene/layer/order_tests.rs
@@ -0,0 +1,168 @@
+//! Scene layers: a layer's scene draws its commands in the order the scene
+//! without layers draws them, as recorded and as a box's run is recorded
+//! again.
+
+use crate::scene::draw_sequence;
+use crate::{Background, Bounds, ContentMask, Hsla, Quad, ScaledPixels, Scene, Underline, hsla, point, size};
+
+pub(super) fn rect(x: f32, y: f32, w: f32, h: f32) -> Bounds<ScaledPixels> {
+    Bounds {
+        origin: point(ScaledPixels(x), ScaledPixels(y)),
+        size: size(ScaledPixels(w), ScaledPixels(h)),
+    }
+}
+
+fn mask() -> ContentMask<ScaledPixels> {
+    ContentMask {
+        bounds: rect(0., 0., 1000., 1000.),
+    }
+}
+
+pub(super) fn quad(b: Bounds<ScaledPixels>, color: Hsla) -> Quad {
+    Quad {
+        bounds: b,
+        content_mask: mask(),
+        background: Background::from(color),
+        ..Default::default()
+    }
+}
+
+fn underline(b: Bounds<ScaledPixels>) -> Underline {
+    Underline {
+        order: 0, pad: 0,
+        bounds: b,
+        content_mask: mask(),
+        color: hsla(0., 0., 0., 1.),
+        thickness: ScaledPixels(b.size.height.0),
+        wavy: false.into(),
+    }
+}
+
+pub(super) fn env() -> super::BoxEnv {
+    super::BoxEnv {
+        bounds: Bounds::default(),
+        mask: ContentMask {
+            bounds: Bounds::default(),
+        },
+        transformation: crate::TransformationMatrix::unit(),
+        opacity: 1.,
+        rem_size: crate::px(16.),
+        exact: None,
+        fill: None,
+        layer: None,
+        painter: crate::scene::RunPainter::Box(crate::scene::BoxContents::Own),
+        hover: None,
+    }
+}
+
+/// One paint step of a test page.
+pub(super) enum Step {
+    Quad(Bounds<ScaledPixels>, Hsla),
+    /// A layer (a line) of `bounds` whose quad or underline `ink` passes them.
+    Line(Bounds<ScaledPixels>, Bounds<ScaledPixels>, bool),
+    /// A box of `area` painting the quads.
+    Box(u32, Bounds<ScaledPixels>, Vec<(Bounds<ScaledPixels>, Hsla)>),
+}
+
+/// The steps painted into a scene, as a layer recording (`layered`) or a
+/// frame without layers; the layer's box runs.
+pub(super) fn paint(steps: &[Step], layered: bool) -> (Scene, Vec<super::BoxRange>) {
+    let mut scene = Scene::default();
+    let mut boxes = Vec::new();
+    for step in steps {
+        match step {
+            Step::Quad(b, c) => scene.insert_primitive(quad(*b, *c)),
+            Step::Line(bounds, ink, as_quad) => {
+                scene.push_layer(*bounds);
+                if *as_quad {
+                    scene.insert_primitive(quad(*ink, hsla(0.3, 1., 0.5, 1.)));
+                } else {
+                    scene.insert_primitive(underline(*ink));
+                }
+                scene.pop_layer();
+            }
+            Step::Box(owner, area, fills) => {
+                let open = layered && scene.open_box(*owner, *area, env());
+                for (b, c) in fills {
+                    scene.insert_primitive(quad(*b, *c));
+                }
+                if open {
+                    boxes.extend(scene.close_box());
+                }
+            }
+        }
+    }
+    (scene, boxes)
+}
+
+pub(super) fn drawn(scene: &mut Scene) -> Vec<(String, Bounds<ScaledPixels>)> {
+    scene.finish();
+    let mut out = Vec::new();
+    draw_sequence(scene, &mut out);
+    out
+}
+
+/// The layer draws the steps as the frame without layers does.
+fn assert_as_without_layers(steps: &[Step]) {
+    let (mut layered, _) = paint(steps, true);
+    let (mut plain, _) = paint(steps, false);
+    assert_eq!(drawn(&mut layered), drawn(&mut plain));
+}
+
+pub(super) fn root() -> Step { Step::Quad(rect(0., 0., 100., 100.), hsla(0., 0., 1., 1.)) }
+
+#[test]
+fn a_line_ink_in_the_gap_between_a_box_area_and_its_fill_keeps_its_order() {
+    // The line's underline passes its bounds (to x = 12) into the box's area
+    // (from x = 9.5) but its fill starts at x = 11: the fill meets only the
+    // root, one bucket below the line, and draws first.
+    assert_as_without_layers(&[
+        root(),
+        Step::Line(rect(0., 0., 10., 10.), rect(0., 0., 12., 10.), false),
+        Step::Box(1, rect(9.5, 0., 20.5, 10.), vec![(rect(11., 0., 19., 10.), hsla(0.6, 1., 0.5, 1.))]),
+    ]);
+}
+
+#[test]
+fn a_line_quad_past_its_bounds_and_a_later_box_fill_of_its_bucket_keep_paint_order() {
+    // Equal orders draw quads in paint order: the line's quad, then the fill.
+    assert_as_without_layers(&[
+        root(),
+        Step::Line(rect(0., 0., 10., 10.), rect(0., 0., 12., 10.), true),
+        Step::Box(1, rect(11., 0., 19., 10.), vec![(rect(11., 0., 19., 10.), hsla(0.6, 1., 0.5, 1.))]),
+    ]);
+}
+
+#[test]
+fn a_box_with_a_fill_and_a_border_over_it_keeps_the_orders_of_both() {
+    assert_as_without_layers(&[
+        root(),
+        Step::Box(
+            1,
+            rect(10., 10., 50., 50.),
+            vec![(rect(10., 10., 50., 50.), hsla(0.6, 1., 0.5, 1.)), (rect(10., 10., 50., 2.), hsla(0., 1., 0.5, 1.))],
+        ),
+        Step::Line(rect(10., 12., 20., 10.), rect(10., 12., 45., 10.), false),
+        Step::Box(2, rect(30., 12., 20., 10.), vec![(rect(31., 12., 19., 10.), hsla(0.1, 1., 0.5, 1.))]),
+    ]);
+}
+
+#[test]
+fn a_box_in_a_line_layer_keeps_the_layer_order_and_a_nested_one_opens_no_run() {
+    // The pieces of an inline box's band paint in the layer of their line.
+    let mut scene = Scene::default();
+    scene.insert_primitive(quad(rect(0., 0., 100., 100.), hsla(0., 0., 1., 1.)));
+    scene.push_layer(rect(0., 0., 50., 10.));
+    let order = *scene.layer_stack.last().unwrap();
+    assert!(scene.open_box(7, rect(0., 0., 20., 10.), env()));
+    scene.insert_primitive(quad(rect(0., 0., 20., 10.), hsla(0.6, 1., 0.5, 1.)));
+    let run = scene.close_box().unwrap();
+    assert_eq!(run.env.layer, Some(order));
+    assert!(run.replaceable);
+    scene.push_layer(rect(0., 0., 10., 10.));
+    assert!(!scene.open_box(8, rect(0., 0., 10., 10.), env()), "a nested layer orders by its own");
+    scene.pop_layer();
+    scene.pop_layer();
+    scene.push_bottom_layer();
+    assert!(!scene.open_box(9, rect(0., 0., 10., 10.), env()), "the bottom layer orders by paint");
+}
