+                    dispatcher.clone(),
+                    Some("randomized_element_tree_matches_full_render"),
+                );
+                randomized_element_tree_property(&mut cx, seed);
+                dispatcher.run_until_parked();
+                cx.executor().forbid_parking();
+                cx.quit();
+                dispatcher.run_until_parked();
+            }),
