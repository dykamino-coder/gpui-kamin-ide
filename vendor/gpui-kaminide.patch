+#[derive(Copy, Clone, Debug, PartialEq, Eq, Hash)]
+#[expect(missing_docs)]
+pub struct PathId(pub usize);
+
+/// A line made up of a series of vertices and control points.
+#[derive(Clone, Debug)]
+#[expect(missing_docs)]
+pub struct Path<P: Clone + Debug + Default + PartialEq> {
+    pub id: PathId,
+    pub order: DrawOrder,
+    pub bounds: Bounds<P>,
+    pub content_mask: ContentMask<P>,
+    pub vertices: Vec<PathVertex<P>>,
+    pub color: Background,
+    /// Original color coordinates and destination-to-source matrix for vector presentation.
+    pub color_mapping: Option<(Bounds<P>, TransformationMatrix)>,
+    start: Point<P>,
+    current: Point<P>,
+    contour_count: usize,
+}
+
+impl Path<Pixels> {
+    /// Create a new path with the given starting point.
+    pub fn new(start: Point<Pixels>) -> Self {
+        Self {
+            id: PathId(0),
+            order: DrawOrder::default(),
+            vertices: Vec::new(),
+            start,
+            current: start,
+            bounds: Bounds {
+                origin: start,
+                size: Default::default(),
+            },
+            content_mask: Default::default(),
+            color: Default::default(),
+            color_mapping: None,
+            contour_count: 0,
+        }
+    }
+
+    /// Scale this path by the given factor.
+    pub fn scale(&self, factor: f32) -> Path<ScaledPixels> {
+        Path {
+            id: self.id,
+            order: self.order,
+            bounds: self.bounds.scale(factor),
+            content_mask: self.content_mask.scale(factor),
+            vertices: self
+                .vertices
+                .iter()
+                .map(|vertex| vertex.scale(factor))
+                .collect(),
+            start: self.start.map(|start| start.scale(factor)),
+            current: self.current.scale(factor),
+            contour_count: self.contour_count,
+            color: self.color,
+            color_mapping: self.color_mapping.as_ref().map(|(bounds, matrix)| {
+                let mut matrix = *matrix;
+                matrix.translation[0] *= factor;
+                matrix.translation[1] *= factor;
+                (bounds.scale(factor), matrix)
+            }),
+        }
+    }
+
+    /// Move the start, current point to the given point.
+    pub fn move_to(&mut self, to: Point<Pixels>) {
+        self.contour_count += 1;
+        self.start = to;
+        self.current = to;
+    }
+
+    /// Draw a straight line from the current point to the given point.
+    pub fn line_to(&mut self, to: Point<Pixels>) {
+        self.contour_count += 1;
+        if self.contour_count > 1 {
+            self.push_triangle(
+                (self.start, self.current, to),
+                (point(0., 1.), point(0., 1.), point(0., 1.)),
+            );
+        }
+        self.current = to;
+    }
+
+    /// Draw a curve from the current point to the given point, using the given control point.
+    pub fn curve_to(&mut self, to: Point<Pixels>, ctrl: Point<Pixels>) {
+        self.contour_count += 1;
+        if self.contour_count > 1 {
+            self.push_triangle(
+                (self.start, self.current, to),
+                (point(0., 1.), point(0., 1.), point(0., 1.)),
+            );
+        }
+
+        self.push_triangle(
+            (self.current, ctrl, to),
+            (point(0., 0.), point(0.5, 0.), point(1., 1.)),
+        );
+        self.current = to;
+    }
+
+    /// Push a triangle to the Path.
+    pub fn push_triangle(
+        &mut self,
+        xy: (Point<Pixels>, Point<Pixels>, Point<Pixels>),
+        st: (Point<f32>, Point<f32>, Point<f32>),
+    ) {
+        self.bounds = self
+            .bounds
+            .union(&Bounds {
+                origin: xy.0,
+                size: Default::default(),
+            })
+            .union(&Bounds {
+                origin: xy.1,
+                size: Default::default(),
+            })
+            .union(&Bounds {
+                origin: xy.2,
+                size: Default::default(),
+            });
+
+        self.vertices.push(PathVertex {
+            xy_position: xy.0,
+            st_position: st.0,
+            content_mask: Default::default(),
+        });
+        self.vertices.push(PathVertex {
+            xy_position: xy.1,
+            st_position: st.1,
+            content_mask: Default::default(),
+        });
+        self.vertices.push(PathVertex {
+            xy_position: xy.2,
+            st_position: st.2,
+            content_mask: Default::default(),
+        });
+    }
+}
+
+impl<T> Path<T>
+where
+    T: Clone + Debug + Default + PartialEq + PartialOrd + Add<T, Output = T> + Sub<Output = T>,
+{
+    #[allow(unused)]
+    #[expect(missing_docs)]
+    pub fn clipped_bounds(&self) -> Bounds<T> {
+        self.bounds.intersect(&self.content_mask.bounds)
+    }
+}
+
+impl From<Path<ScaledPixels>> for Primitive {
+    fn from(path: Path<ScaledPixels>) -> Self {
+        Primitive::Path(path)
+    }
+}
+
+#[derive(Clone, Debug)]
+#[repr(C)]
+#[expect(missing_docs)]
+pub struct PathVertex<P: Clone + Debug + Default + PartialEq> {
+    pub xy_position: Point<P>,
+    pub st_position: Point<f32>,
+    pub content_mask: ContentMask<P>,
+}
+
+#[expect(missing_docs)]
+impl PathVertex<Pixels> {
+    pub fn scale(&self, factor: f32) -> PathVertex<ScaledPixels> {
+        PathVertex {
+            xy_position: self.xy_position.scale(factor),
+            st_position: self.st_position,
+            content_mask: self.content_mask.scale(factor),
+        }
+    }
+}
diff --git a/vendor/gpui/src/scene/affine_transform.rs b/vendor/gpui/src/scene/affine_transform.rs
new file mode 100644
index 0000000000000000000000000000000000000000..ce8acb35ac9cf0333bc961c32a10b181002c4629
--- /dev/null
+++ b/vendor/gpui/src/scene/affine_transform.rs
@@ -0,0 +1,108 @@
+//! Воспроизведение записи под произвольной аффинной презентацией с паритетом live-отрисовки:
+//! матрица композируется в примитивы так же, как `Window::with_transformation`, а маски
+//! переносятся только при сохранении осей, как у `Window::with_transformation_masked`.
+
+use super::*;
+use crate::TransformationMatrix;
+
+/// The rule of `with_transformation_masked`: masks move only with an axis-keeping matrix.
+pub(crate) fn keeps_axes(m: &TransformationMatrix) -> bool {
+    let r = m.rotation_scale;
+    (r[0][1].abs() < 1e-4 && r[1][0].abs() < 1e-4) || (r[0][0].abs() < 1e-4 && r[1][1].abs() < 1e-4)
+}
+
+/// Device bounds of the image of `b` (four corners).
+pub(crate) fn placed(b: Bounds<ScaledPixels>, m: &TransformationMatrix) -> Bounds<ScaledPixels> {
+    let corners = [
+        point(b.origin.x, b.origin.y), point(b.right(), b.origin.y),
+        point(b.origin.x, b.bottom()), point(b.right(), b.bottom()),
+    ];
+    let (mut x0, mut y0, mut x1, mut y1) = (f32::MAX, f32::MAX, f32::MIN, f32::MIN);
+    for corner in corners {
+        let p = map(corner, m);
+        x0 = x0.min(p.x.0);
+        y0 = y0.min(p.y.0);
+        x1 = x1.max(p.x.0);
+        y1 = y1.max(p.y.0);
+    }
+    Bounds::new(point(ScaledPixels(x0), ScaledPixels(y0)), crate::size(ScaledPixels(x1 - x0), ScaledPixels(y1 - y0)))
+}
+
+fn map(p: Point<ScaledPixels>, m: &TransformationMatrix) -> Point<ScaledPixels> {
+    let p = m.apply(point(crate::px(p.x.0), crate::px(p.y.0)));
+    point(ScaledPixels(p.x.0), ScaledPixels(p.y.0))
+}
+
+impl Scene {
+    /// `matrix` is a non-singular device-space affine transform.
+    pub(crate) fn transform_affine(mut self, matrix: TransformationMatrix, inverse: TransformationMatrix) -> Self {
+        let masks = keeps_axes(&matrix);
+        let groups = std::mem::take(&mut self.groups);
+        let mut scene = self.affine_commands(&matrix, masks);
+        scene.groups = groups.into_iter().map(|mut group| {
+            group.bounds = placed(group.bounds, &matrix);
+            group.polygon.iter_mut().for_each(|p| *p = map(*p, &matrix));
+            if masks {
+                group.mask_bounds = placed(group.mask_bounds, &matrix);
+                group.mask_clip = group.mask_clip.map(|b| {
+                    let b = placed(Bounds::new(point(ScaledPixels(b[0]), ScaledPixels(b[1])),
+                        crate::size(ScaledPixels(b[2]), ScaledPixels(b[3]))), &matrix);
+                    [b.origin.x.0, b.origin.y.0, b.size.width.0, b.size.height.0]
+                });
+            }
+            group.projection = group.projection.map(|h| super::vector_transform::conjugate(h, matrix, inverse));
+            for fragment in &mut group.fragments {
+                fragment.iter_mut().for_each(|p| *p = map(*p, &matrix));
+            }
+            group.scene = group.scene.affine_commands(&matrix, masks);
+            group
+        }).collect();
+        scene
+    }
+
+    fn affine_commands(mut self, matrix: &TransformationMatrix, masks: bool) -> Self {
+        let mut scene = Self { in_group: self.in_group, ..Self::default() };
+        let mask = |bounds: &mut Bounds<ScaledPixels>| if masks { *bounds = placed(*bounds, matrix) };
+        for mut command in std::mem::take(&mut self.paint_operations) {
+            match &mut command {
+                PaintOperation::Primitive(p) => match p {
+                    // Live paint carries the active matrix on these primitives only.
+                    Primitive::Quad(p) => {
+                        p.transformation = matrix.compose(p.transformation);
+                        mask(&mut p.content_mask.bounds);
+                    }
+                    Primitive::MonochromeSprite(p) => {
+                        p.transformation = matrix.compose(p.transformation);
+                        mask(&mut p.content_mask.bounds);
+                    }
+                    Primitive::SubpixelSprite(p) => {
+                        p.transformation = matrix.compose(p.transformation);
+                        mask(&mut p.content_mask.bounds);
+                    }
+                    Primitive::PolychromeSprite(p) => {
+                        p.transformation = matrix.compose(p.transformation);
+                        mask(&mut p.content_mask.bounds);
+                    }
+                    Primitive::Shadow(p) => mask(&mut p.content_mask.bounds),
+                    Primitive::Underline(p) => mask(&mut p.content_mask.bounds),
+                    Primitive::Surface(p) => mask(&mut p.content_mask.bounds),
+                    Primitive::Path(p) => {
+                        mask(&mut p.content_mask.bounds);
+                        p.vertices.iter_mut().for_each(|v| mask(&mut v.content_mask.bounds));
+                    }
+                },
+                // Layer bounds are placed like live layers under a matrix.
+                PaintOperation::StartLayer(b, _) => *b = placed(*b, matrix),
+                _ => {}
+            }
+            scene.replay_operation(command);
+        }
+        scene.segment_capture = self.segment_capture;
+        scene.hoisted_backdrops = self.hoisted_backdrops.into_iter().map(|mut p| {
+            mask(&mut p.content_mask.bounds);
+            p
+        }).collect();
+        scene.finish();
+        scene
+    }
+}
diff --git a/vendor/gpui/src/scene/record.rs b/vendor/gpui/src/scene/record.rs
new file mode 100644
index 0000000000000000000000000000000000000000..41235cb1752500e02bd1494ac6f7e29acb8744ab
--- /dev/null
+++ b/vendor/gpui/src/scene/record.rs
@@ -0,0 +1,64 @@
+//! Копирование неизменяемых команд с явным переносом и выходным clip.
+
+use super::*;
+
+pub(super) mod geometry;
+
+impl Scene {
+    pub(crate) fn copy_record(
+        &self,
+        offset: Point<ScaledPixels>,
+        clip: Option<Bounds<ScaledPixels>>,
+    ) -> Self {
+        let mut scene = self.copy_commands(offset, clip);
+        // The compositor keeps dependencies flat, children before parents.
+        scene.groups = self.groups.iter().map(|group| Self::copy_group(group, group.scene.copy_commands(offset, None), offset)).collect();
+        scene
+    }
+
+    pub(super) fn copy_group(group: &PaintGroup, scene: Scene, offset: Point<ScaledPixels>) -> PaintGroup {
+        PaintGroup {
+            scene,
+            bounds: geometry::bounds(group.bounds, offset),
+            blur_radius: group.blur_radius,
+            blend: group.blend,
+            polygon: group.polygon.iter().map(|p| *p + offset).collect(),
+            polygon_inverse: group.polygon_inverse,
+            mask: group.mask.clone(),
+            mask_bounds: geometry::bounds(group.mask_bounds, offset),
+            mask_once: group.mask_once,
+            mask_clip: group.mask_clip.map(|mut b| {
+                b[0] += offset.x.0;
+                b[1] += offset.y.0;
+                b
+            }),
+            projection: group.projection.map(|m| geometry::projection(m, offset)),
+            fragments: group.fragments.iter().map(|fragment| {
+                fragment.iter().map(|p| *p + offset).collect()
+            }).collect(),
+        }
+    }
+
+    fn copy_commands(
+        &self,
+        offset: Point<ScaledPixels>,
+        clip: Option<Bounds<ScaledPixels>>,
+    ) -> Self {
+        // KaminIDE patch: the copy keeps the recorded orders and grafts the
+        // record's bounds tree moved and clipped the same way, instead of
+        // inserting every primitive into a new tree (`Scene::copy_grafted`).
+        let mut scene = self.copy_grafted(offset, clip, |command| match command {
+            PaintOperation::Primitive(primitive) => geometry::primitive(primitive, offset, clip),
+            PaintOperation::StartLayer(b, _) => *b = geometry::bounds(*b, offset),
+            _ => {},
+        });
+        scene.hoisted_backdrops = self.hoisted_backdrops.iter().map(|surface| {
+            let mut surface = surface.clone();
+            surface.bounds = geometry::bounds(surface.bounds, offset);
+            geometry::mask(&mut surface.content_mask, offset, clip);
+            surface
+        }).collect();
+        scene.finish();
+        scene
+    }
+}
diff --git a/vendor/gpui/src/scene/record/geometry.rs b/vendor/gpui/src/scene/record/geometry.rs
new file mode 100644
index 0000000000000000000000000000000000000000..6d2ea81a9a139481107fc909826a19d7493593b8
--- /dev/null
+++ b/vendor/gpui/src/scene/record/geometry.rs
@@ -0,0 +1,81 @@
+//! Перенос разрешённой геометрии команд без повторной растеризации текста.
+
+use super::*;
+
+pub(in crate::scene) fn bounds(mut bounds: Bounds<ScaledPixels>, offset: Point<ScaledPixels>) -> Bounds<ScaledPixels> {
+    bounds.origin += offset;
+    bounds
+}
+
+pub(super) fn mask(mask: &mut ContentMask<ScaledPixels>, offset: Point<ScaledPixels>, clip: Option<Bounds<ScaledPixels>>) {
+    mask.bounds = bounds(mask.bounds, offset);
+    if let Some(clip) = clip {
+        mask.bounds = mask.bounds.intersect(&clip);
+    }
+}
+
+fn transform(matrix: &mut TransformationMatrix, offset: Point<ScaledPixels>) {
+    matrix.translation[0] += offset.x.0;
+    matrix.translation[1] += offset.y.0;
+}
+
+pub(in crate::scene) fn primitive(primitive: &mut Primitive, offset: Point<ScaledPixels>, clip: Option<Bounds<ScaledPixels>>) {
+    match primitive {
+        Primitive::Quad(p) => {
+            transform(&mut p.transformation, offset);
+            mask(&mut p.content_mask, offset, clip);
+        }
+        Primitive::MonochromeSprite(p) => {
+            transform(&mut p.transformation, offset);
+            mask(&mut p.content_mask, offset, clip);
+        }
+        Primitive::SubpixelSprite(p) => {
+            transform(&mut p.transformation, offset);
+            mask(&mut p.content_mask, offset, clip);
+        }
+        Primitive::PolychromeSprite(p) => {
+            transform(&mut p.transformation, offset);
+            mask(&mut p.content_mask, offset, clip);
+        }
+        Primitive::Shadow(p) => {
+            p.bounds = bounds(p.bounds, offset);
+            p.element_bounds = bounds(p.element_bounds, offset);
+            mask(&mut p.content_mask, offset, clip);
+        }
+        Primitive::Underline(p) => {
+            p.bounds = bounds(p.bounds, offset);
+            mask(&mut p.content_mask, offset, clip);
+        }
+        Primitive::Surface(p) => {
+            p.bounds = bounds(p.bounds, offset);
+            mask(&mut p.content_mask, offset, clip);
+        }
+        Primitive::Path(p) => {
+            if let Some((_, inverse)) = &mut p.color_mapping {
+                *inverse = inverse.compose(TransformationMatrix::unit().translate(point(ScaledPixels(-offset.x.0), ScaledPixels(-offset.y.0))));
+            }
+            p.bounds = bounds(p.bounds, offset);
+            p.start += offset;
+            p.current += offset;
+            mask(&mut p.content_mask, offset, clip);
+            for vertex in &mut p.vertices {
+                vertex.xy_position += offset;
+                mask(&mut vertex.content_mask, offset, clip);
+            }
+        }
+    }
+}
+
+/// Перенос затрагивает координаты кадра и буфера: H' = T H T^-1.
+pub(super) fn projection(m: [f32; 9], offset: Point<ScaledPixels>) -> [f32; 9] {
+    let (x, y) = (offset.x.0, offset.y.0);
+    let a = m[0] + x * m[6];
+    let b = m[1] + x * m[7];
+    let c = m[2] + x * m[8];
+    let d = m[3] + y * m[6];
+    let e = m[4] + y * m[7];
+    let f = m[5] + y * m[8];
+    [a, b, c - a * x - b * y,
+     d, e, f - d * x - e * y,
+     m[6], m[7], m[8] - m[6] * x - m[7] * y]
+}
diff --git a/vendor/gpui/src/scene/replay_tests.rs b/vendor/gpui/src/scene/replay_tests.rs
new file mode 100644
index 0000000000000000000000000000000000000000..96ce71c11a00c60ddb6cd3e9af73e105368f4ae6
--- /dev/null
+++ b/vendor/gpui/src/scene/replay_tests.rs
@@ -0,0 +1,192 @@
+//! KaminIDE patch: the one-pass placed replay equals copy + replay.
+
+use super::*;
+
+fn quad(x: f32, y: f32, w: f32, h: f32) -> Quad {
+    let bounds = Bounds {
+        origin: point(ScaledPixels(x), ScaledPixels(y)),
+        size: Size { width: ScaledPixels(w), height: ScaledPixels(h) },
+    };
+    Quad {
+        bounds,
+        content_mask: ContentMask { bounds },
+        transformation: TransformationMatrix::unit(),
+        ..Default::default()
+    }
+}
+
+fn rect(x: f32, y: f32, w: f32, h: f32) -> Bounds<ScaledPixels> {
+    quad(x, y, w, h).bounds
+}
+
+/// A finished record: overlapping quads, a layer, one quad that the
+/// output clip removes.
+fn record() -> Scene {
+    let mut scene = Scene::default();
+    scene.insert_primitive(quad(0., 0., 40., 40.));
+    scene.insert_primitive(quad(10., 10., 40., 40.));
+    scene.push_layer(rect(0., 50., 30., 30.));
+    scene.insert_primitive(quad(0., 50., 30., 30.));
+    scene.insert_primitive(quad(5., 55., 10., 10.));
+    scene.pop_layer();
+    scene.insert_primitive(quad(200., 0., 10., 10.));
+    scene.insert_primitive(quad(20., 20., 5., 5.));
+    scene.finish();
+    scene
+}
+
+/// The destination already holds content under part of the copy.
+fn destination() -> Scene {
+    let mut scene = Scene::default();
+    scene.insert_primitive(quad(100., 100., 30., 30.));
+    scene.insert_primitive(quad(110., 110., 30., 30.));
+    scene
+}
+
+fn summary(scene: &Scene) -> Vec<String> {
+    scene
+        .paint_operations
+        .iter()
+        .map(|operation| match operation {
+            PaintOperation::Primitive(Primitive::Quad(q)) => format!(
+                "quad {} {:?} {:?} {:?}",
+                q.order, q.bounds, q.content_mask.bounds, q.transformation.translation
+            ),
+            PaintOperation::StartLayer(bounds, order) => format!("layer {order} {bounds:?}"),
+            PaintOperation::EndLayer => "end".into(),
+            _ => "other".into(),
+        })
+        .collect()
+}
+
+fn quads(scene: &Scene) -> Vec<(DrawOrder, [f32; 2])> {
+    scene.quads.iter().map(|q| (q.order, q.transformation.translation)).collect()
+}
+
+#[test]
+fn placed_replay_matches_copy_then_replay() {
+    let offset = point(ScaledPixels(100.), ScaledPixels(100.));
+    let clip = Some(rect(90., 90., 150., 150.));
+    let record = record();
+
+    let mut two_step = destination();
+    two_step.replay_record(&record.copy_record(offset, clip));
+    let mut fused = destination();
+    assert!(fused.replay_placed(&record, offset, clip));
+
+    assert_eq!(summary(&fused), summary(&two_step));
+    // The quad at x=200 is moved to 300, outside the clip, and dropped.
+    assert_eq!(fused.paint_operations.len(), destination().paint_operations.len() + 7);
+    // Later inserts see the copy exactly as they see the two-step copy.
+    for probe in [quad(115., 115., 2., 2.), quad(105., 155., 3., 3.), quad(300., 100., 5., 5.)] {
+        fused.insert_primitive(probe);
+        two_step.insert_primitive(probe);
+    }
+    assert_eq!(summary(&fused), summary(&two_step));
+    fused.finish();
+    two_step.finish();
+    assert_eq!(quads(&fused), quads(&two_step));
+}
+
+#[test]
+fn placed_replay_of_a_fully_clipped_record_writes_only_kept_commands() {
+    let record = record();
+    let clip = Some(rect(1000., 1000., 10., 10.));
+    let mut two_step = destination();
+    two_step.replay_record(&record.copy_record(Point::default(), clip));
+    let mut fused = destination();
+    assert!(fused.replay_placed(&record, Point::default(), clip));
+    assert_eq!(summary(&fused), summary(&two_step));
+}
+
+#[test]
+fn placed_replay_declines_records_with_groups_and_open_layers() {
+    let mut grouped = record();
+    grouped.groups.push(PaintGroup {
+        scene: Scene::default(),
+        bounds: rect(0., 0., 1., 1.),
+        blur_radius: 0.,
+        blend: 0,
+        polygon: Vec::new(),
+        polygon_inverse: false,
+        mask: None,
+        mask_bounds: rect(0., 0., 1., 1.),
+        mask_once: 0,
+        mask_clip: None,
+        projection: None,
+        fragments: Vec::new(),
+    });
+    let mut scene = destination();
+    let before = scene.paint_operations.len();
+    assert!(!scene.replay_placed(&grouped, Point::default(), None));
+    scene.push_layer(rect(0., 0., 10., 10.));
+    assert!(!scene.replay_placed(&record(), Point::default(), None));
+    assert_eq!(scene.paint_operations.len(), before + 1);
+}
+
+/// A finished frame releases its grafts, so the tree of a record that died
+/// during the frame dies with it (as when every primitive was inserted), and
+/// a later frame that replays the copy packs it again: same commands, orders
+/// and later-insert orders as replaying it while the record lives.
+#[test]
+fn finished_frame_does_not_keep_a_dead_record_tree() {
+    let offset = point(ScaledPixels(100.), ScaledPixels(100.));
+    let clip = Some(rect(90., 90., 150., 150.));
+    let probes = [quad(115., 115., 2., 2.), quad(105., 155., 3., 3.), quad(300., 100., 5., 5.)];
+    let record = record();
+    let tree = std::rc::Rc::downgrade(&record.primitive_bounds);
+    let mut frame = destination();
+    let start = frame.paint_operations.len();
+    assert!(frame.replay_placed(&record, offset, clip));
+    let copied = start..frame.paint_operations.len();
+    frame.finish_frame();
+
+    let replayed = |frame: &Scene| {
+        let mut next = destination();
+        next.replay(copied.clone(), frame);
+        let owned = matches!(next.blocks.last().map(|b| &b.index), Some(BlockIndex::Owned(_)));
+        for probe in probes {
+            next.insert_primitive(probe);
+        }
+        next.finish_frame();
+        (summary(&next), quads(&next), owned, next)
+    };
+    let (live, live_quads, live_owned, _) = replayed(&frame);
+    assert!(!live_owned, "a live record's tree is grafted again, not owned");
+
+    drop(record);
+    assert!(tree.upgrade().is_none(), "the finished frame kept the record's tree");
+    let (packed, packed_quads, packed_owned, next) = replayed(&frame);
+    assert!(packed_owned);
+    assert_eq!(packed, live);
+    assert_eq!(packed_quads, live_quads);
+
+    // The packed tree belongs to the frames: the next one grafts it again.
+    let range = destination().paint_operations.len()..next.paint_operations.len() - probes.len();
+    let mut third = destination();
+    third.replay(range, &next);
+    assert!(matches!(third.blocks.last().map(|b| &b.index), Some(BlockIndex::Owned(_))));
+}
+
+/// A placed copy of a mostly clipped record grows the destination by the
+/// commands it keeps, not by the record's length: a frame keeps its
+/// capacity, so a reservation for every recorded command would stay dead.
+#[test]
+fn placed_replay_reserves_only_what_it_keeps() {
+    let mut record = Scene::default();
+    for i in 0..1000 {
+        record.insert_primitive(quad(0., i as f32 * 20., 10., 10.));
+    }
+    record.finish();
+    let mut frame = Scene::default();
+    assert!(frame.replay_placed(&record, Point::default(), Some(rect(0., 0., 100., 50.))));
+    assert_eq!(frame.paint_operations.len(), 3);
+    assert!(frame.paint_operations.capacity() < 100, "{}", frame.paint_operations.capacity());
+    let copy = record.copy_record(Point::default(), Some(rect(0., 0., 100., 50.)));
+    assert_eq!(copy.paint_operations.len(), 3);
+    assert!(copy.paint_operations.capacity() < 100, "{}", copy.paint_operations.capacity());
+    // Unclipped (a composition group's copy, kept by the frame): exact.
+    let full = record.copy_record(Point::default(), None);
+    assert_eq!(full.paint_operations.len(), 1000);
+    assert_eq!(full.paint_operations.capacity(), 1000);
+}
diff --git a/vendor/gpui/src/scene/segments.rs b/vendor/gpui/src/scene/segments.rs
new file mode 100644
index 0000000000000000000000000000000000000000..710a156c3f64da9df8c978553ebf14494034dac8
--- /dev/null
+++ b/vendor/gpui/src/scene/segments.rs
@@ -0,0 +1,98 @@
+//! Разветвление некомпозированных команд по явным сегментам перед заморозкой.
+
+use super::*;
+use crate::{PaintSegment, PaintSegmentId};
+use std::rc::Rc;
+
+mod backdrops;
+mod clips;
+mod groups;
+mod freeze;
+mod commands;
+use groups::Group;
+pub(crate) use clips::{Clip, Tag};
+
+type Routes = Rc<[PaintSegment]>;
+type ReadRoutes = Rc<dyn Fn() -> Tag>;
+
+pub(crate) struct Capture {
+    read: ReadRoutes,
+    entry: Tag,
+    primitives: Vec<Tag>,
+    hoisted: Vec<Tag>,
+    unclipped_groups: Vec<usize>,
+    atomic: bool,
+}
+
+impl Capture {
+    pub(super) fn primitive(&mut self) { self.primitives.push((self.read)()); }
+}
+
+impl Scene {
+    pub(crate) fn begin_segments(&mut self, read: ReadRoutes) {
+        self.segment_capture = Some(Box::new(Capture {
+            entry: read(), read, primitives: Vec::new(), hoisted: Vec::new(), unclipped_groups: Vec::new(), atomic: false,
+        }));
+    }
+
+    pub(crate) fn inherit_segments(&mut self, outer: &Scene) {
+        if let Some(capture) = &outer.segment_capture {
+            self.begin_segments(capture.read.clone());
+        }
+    }
+
+    pub(crate) fn bind_record_segments(&mut self, outer: &Scene) {
+        if self.segment_capture.is_some() { return; }
+        self.inherit_segments(outer);
+        if let Some(capture) = &mut self.segment_capture {
+            let routes = (capture.read)();
+            capture.primitives = self.paint_operations.iter().filter_map(|op| {
+                matches!(op, PaintOperation::Primitive(_)).then(|| routes.clone())
+            }).collect();
+            capture.hoisted = vec![routes; self.hoisted_backdrops.len()];
+        }
+        // Внешний clip ограничивает выход immutable-поддерева; записанные
+        // входы его групп должны оставаться доступны фильтрам.
+        if let Some(capture) = &self.segment_capture {
+            let read = capture.read.clone();
+            let input = Rc::new(move || { let mut tag = read(); tag.clips = None; tag.slices = Rc::from([]); tag });
+            for group in &mut self.groups {
+                group.scene.begin_segments(input.clone());
+                if let Some(capture) = &mut group.scene.segment_capture {
+                    capture.atomic = true;
+                    let tag = (capture.read)();
+                    capture.primitives = group.scene.paint_operations.iter().filter_map(|op| {
+                        matches!(op, PaintOperation::Primitive(_)).then(|| tag.clone())
+                    }).collect();
+                    capture.hoisted = vec![tag; group.scene.hoisted_backdrops.len()];
+                }
+            }
+        }
+    }
+
+    pub(crate) fn insert_group_surface(&mut self, surface: PaintSurface, unbounded: bool) {
+        let before = self.paint_operations.len();
+        self.insert_primitive(surface);
+        if unbounded && self.paint_operations.len() > before {
+            if let Some(capture) = &mut self.segment_capture {
+                capture.unclipped_groups.push(capture.primitives.len() - 1);
+            }
+        }
+    }
+
+    pub(crate) fn segment_clip(&self, id: PaintSegmentId, source: Bounds<Pixels>) -> Bounds<Pixels> {
+        let mut result = None;
+        for scene in std::iter::once(self).chain(self.groups.iter().map(|group| &group.scene)) {
+            if let Some(capture) = &scene.segment_capture {
+                for routes in std::iter::once(&capture.entry).chain(&capture.primitives).chain(&capture.hoisted) {
+                    for route in routes.routes.iter().filter(|route| route.id == id) {
+                        let clip = Bounds::new(source.origin + route.destination - route.source, source.size);
+                        result = Some(result.map_or(clip, |prior: Bounds<Pixels>| prior.union(&clip)));
+                    }
+                }
+            }
+        }
+        result.unwrap_or(Bounds::new(source.origin, crate::Size::default()))
+    }
+
+}
diff --git a/vendor/gpui/src/scene/segments/backdrops.rs b/vendor/gpui/src/scene/segments/backdrops.rs
new file mode 100644
index 0000000000000000000000000000000000000000..c6fa95902baa8c68a2cec0c03c64ada478eb437e
--- /dev/null
+++ b/vendor/gpui/src/scene/segments/backdrops.rs
@@ -0,0 +1,51 @@
+//! Сегмент поднятой подложки сохраняется при переносе сквозь группы.
+
+use super::*;
+
+impl Scene {
+    pub(crate) fn hoist_backdrop(&mut self, surface: PaintSurface) {
+        self.hoisted_backdrops.push(surface);
+        if let Some(capture) = &mut self.segment_capture {
+            capture.hoisted.push((capture.read)());
+        }
+    }
+
+    pub(crate) fn take_backdrops(&mut self) -> Vec<(PaintSurface, Option<Tag>)> {
+        let routes = self.segment_capture.as_mut().map(|capture| std::mem::take(&mut capture.hoisted));
+        std::mem::take(&mut self.hoisted_backdrops).into_iter().enumerate()
+            .map(|(index, surface)| (surface, routes.as_ref().and_then(|routes| routes.get(index)).cloned()))
+            .collect()
+    }
+
+    pub(crate) fn adopt_backdrops(&mut self, backdrops: Vec<(PaintSurface, Option<Tag>)>) {
+        for (surface, routes) in backdrops {
+            if self.in_group {
+                self.hoisted_backdrops.push(surface);
+                if let Some(capture) = &mut self.segment_capture {
+                    capture.hoisted.push(routes.unwrap_or_else(|| (capture.read)()));
+                }
+            } else {
+                let before = self.paint_operations.len();
+                self.insert_primitive(surface);
+                if self.paint_operations.len() > before {
+                    if let (Some(capture), Some(routes)) = (&mut self.segment_capture, routes) {
+                        *capture.primitives.last_mut().expect("inserted primitive") = routes;
+                    }
+                }
+            }
+        }
+    }
+
+    pub(super) fn segment_backdrops(&self, output: &mut Scene, id: PaintSegmentId, ordinal: Option<u32>, scale: f32, extent: Bounds<ScaledPixels>, excluded: Option<&Rc<Clip>>) {
+        let Some(capture) = &self.segment_capture else { return; };
+        for (surface, routes) in self.hoisted_backdrops.iter().zip(&capture.hoisted) {
+            for route in routes.routes.iter().filter(|route| route.id == id && ordinal.is_none_or(|ordinal| route.ordinal == ordinal)).copied() {
+                let mut primitive = Primitive::Surface(surface.clone());
+                record::geometry::primitive(&mut primitive, (route.destination - route.source).scale(scale), Some(routes.admission(route, scale, Tag::clip_chain(routes.clips.as_ref(), excluded, route, scale, extent))));
+                if let Primitive::Surface(surface) = primitive {
+                    output.hoisted_backdrops.push(surface);
+                }
+            }
+        }
+    }
+}
diff --git a/vendor/gpui/src/scene/segments/clips.rs b/vendor/gpui/src/scene/segments/clips.rs
new file mode 100644
index 0000000000000000000000000000000000000000..a7cd3de1e23cc00cc05ab0a0cc4fbf8781548a37
--- /dev/null
+++ b/vendor/gpui/src/scene/segments/clips.rs
@@ -0,0 +1,57 @@
+//! Clip принадлежит охватывающему scope, а не размещению его листьев.
+
+use super::*;
+
+/// Хранится независимо от маршрутов листьев, включая отложенный paint.
+#[derive(Clone)]
+pub(crate) struct Tag {
+    pub(crate) routes: Routes,
+    pub(crate) scopes: Routes,
+    pub(crate) clips: Option<Rc<Clip>>,
+    pub(crate) slices: Rc<[crate::PaintSegmentSlice]>,
+}
+
+pub(crate) struct Clip {
+    pub(crate) bounds: Bounds<Pixels>,
+    pub(crate) routes: Routes,
+    pub(crate) parent: Option<Rc<Clip>>,
+}
+
+impl Drop for Clip {
+    fn drop(&mut self) {
+        // Глубокая цепочка overflow освобождается без рекурсивного Drop.
+        let mut parent = self.parent.take();
+        while let Some(node) = parent {
+            match Rc::try_unwrap(node) {
+                Ok(mut node) => parent = node.parent.take(),
+                Err(_) => break,
+            }
+        }
+    }
+}
+
+impl Tag {
+    pub(crate) fn admission(&self, route: PaintSegment, scale: f32, extent: Bounds<ScaledPixels>) -> Bounds<ScaledPixels> {
+        self.slices.iter().find(|slice| slice.placement.id == route.id && slice.placement.ordinal == route.ordinal).map_or(extent, |slice| {
+            let route = slice.placement;
+            extent.intersect(&Bounds::new(slice.source_clip.origin + route.destination - route.source, slice.source_clip.size).scale(scale))
+        })
+    }
+
+    pub(crate) fn clip_chain(
+        chain: Option<&Rc<Clip>>, excluded: Option<&Rc<Clip>>,
+        placement: PaintSegment, scale: f32, mut extent: Bounds<ScaledPixels>,
+    ) -> Bounds<ScaledPixels> {
+        let mut scope = chain;
+        while let Some(clip) = scope {
+            if excluded.is_some_and(|excluded| Rc::ptr_eq(clip, excluded)) { break; }
+            if let Some(route) = clip.routes.iter().find(|route| route.id == placement.id && route.ordinal == placement.ordinal)
+                .or_else(|| clip.routes.iter().find(|route| route.id == placement.id)) {
+                let bounds = Bounds::new(clip.bounds.origin + route.destination - route.source, clip.bounds.size);
+                extent = extent.intersect(&bounds.scale(scale));
+            }
+            scope = clip.parent.as_ref();
+        }
+        extent
+    }
+}
diff --git a/vendor/gpui/src/scene/segments/commands.rs b/vendor/gpui/src/scene/segments/commands.rs
new file mode 100644
index 0000000000000000000000000000000000000000..356ef06f6f2057d9f85f42882b30cf3474dd200d
--- /dev/null
+++ b/vendor/gpui/src/scene/segments/commands.rs
@@ -0,0 +1,69 @@
+//! Проекция каждого допуска выполняется до композиции неизменяемого сегмента.
+
+use super::*;
+
+impl Scene {
+    pub(super) fn segment_commands(
+        &self, id: PaintSegmentId, ordinal: Option<u32>, scale: f32,
+        groups: &[Vec<Group>], extent: Bounds<ScaledPixels>, excluded: Option<&Rc<Clip>>,
+    ) -> (Scene, Option<PaintSegment>) {
+        let mut output = Scene { in_group: self.in_group, ..Scene::default() };
+        let Some(capture) = &self.segment_capture else { return (output, None); };
+        let admits = |route: &&PaintSegment| route.id == id && ordinal.is_none_or(|ordinal| route.ordinal == ordinal);
+        let entry = capture.entry.scopes.iter().find(admits).copied();
+        let mut first = None;
+        let layer_route = entry.or_else(|| capture.primitives.iter()
+            .find_map(|tag| tag.routes.iter().find(admits).copied()));
+        let mut tags = capture.primitives.iter();
+        let mut primitive_index = 0;
+        for operation in &self.paint_operations {
+            match operation {
+                PaintOperation::Primitive(primitive) => {
+                    let tag = tags.next().expect("captured primitive tag");
+                    let unclipped = capture.unclipped_groups.contains(&primitive_index);
+                    primitive_index += 1;
+                    if let Primitive::Surface(surface) = primitive {
+                        if surface.group > 0 {
+                            let Some(copies) = groups.get(surface.group as usize - 1) else { continue; };
+                            for group in copies.iter().filter(|group| ordinal.is_none_or(|ordinal| group.route.ordinal == ordinal)) {
+                                let mut primitive = primitive.clone();
+                                let Primitive::Surface(surface) = &mut primitive else { unreachable!() };
+                                surface.group = group.index;
+                                let route = if copies.len() > 1 { group.route } else {
+                                    entry.or_else(|| tag.routes.iter().find(admits).copied()).unwrap_or(group.route)
+                                };
+                                // Вход группы уже размещён; выход не получает второй перенос.
+                                surface.bounds = record::geometry::bounds(group.bounds, (route.source - route.destination).scale(scale));
+                                if unclipped { surface.content_mask.bounds = surface.bounds; }
+                                let clips = if group.atomic { tag.clips.as_ref() } else { group.clips.as_ref() };
+                                let clip = Tag::clip_chain(clips, excluded, route, scale, extent);
+                                let clip = if group.atomic { tag.admission(route, scale, clip) } else { clip };
+                                record::geometry::primitive(&mut primitive, (route.destination - route.source).scale(scale), Some(clip));
+                                output.insert_primitive(primitive);
+                                first.get_or_insert(route);
+                            }
+                            continue;
+                        }
+                    }
+                    for route in tag.routes.iter().filter(admits).copied() {
+                        let mut primitive = primitive.clone();
+                        let clip = Tag::clip_chain(tag.clips.as_ref(), excluded, route, scale, extent);
+                        let clip = tag.admission(route, scale, clip);
+                        record::geometry::primitive(&mut primitive, (route.destination - route.source).scale(scale), Some(clip));
+                        output.insert_primitive(primitive);
+                        first.get_or_insert(route);
+                    }
+                }
+                PaintOperation::StartLayer(bounds, _) => {
+                    let route = layer_route.or(first);
+                    let delta = route.map_or(Point::default(), |route| (route.destination - route.source).scale(scale));
+                    output.push_layer(record::geometry::bounds(*bounds, delta).union(&extent));
+                }
+                _ => output.replay_operation(operation.clone()),
+            }
+        }
+        self.segment_backdrops(&mut output, id, ordinal, scale, extent, excluded);
+        output.finish();
+        (output, first.map(|route| entry.unwrap_or(route)))
+    }
+}
diff --git a/vendor/gpui/src/scene/segments/freeze.rs b/vendor/gpui/src/scene/segments/freeze.rs
