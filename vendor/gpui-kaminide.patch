+        width: i32,
+        height: i32,
+    ) -> Option<ExternalTexture> {
+        if !self
+            .platform_window
+            .update_external_texture(texture.0.texture_id, raw)
+        {
+            return None;
+        }
+        Some(texture.with_size(width, height))
+    }
