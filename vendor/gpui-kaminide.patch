+    pub fn simulate_keystrokes(&mut self, window: AnyWindowHandle, keystrokes: &str) {
+        for keystroke in keystrokes
+            .split(' ')
+            .map(Keystroke::parse)
+            .map(Result::unwrap)
+        {
