+    #[allow(clippy::too_many_arguments)]
+    pub(crate) fn layout_line_with<Text>(
+        &self,
+        text: Text,
+        font_size: Pixels,
+        runs: &[FontRun],
+        wrap_width: Option<Pixels>,
+        force_width: Option<Pixels>,
+        letter_spacing: Pixels,
+        shape: impl FnOnce(&SharedString, &dyn PlatformTextSystem) -> LineLayout,
+    ) -> Arc<LineLayout>
+    where
+        Text: AsRef<str>,
+        SharedString: From<Text>,
+    {
+        let _font_generation = self.clear_if_font_generation_changed();
+        let key = &CacheKeyRef {
+            text: text.as_ref(),
+            font_size,
+            runs,
+            wrap_width,
+            force_width,
+            letter_spacing,
+        } as &dyn AsCacheKeyRef;
+
+        let current_frame = self.current_frame.upgradable_read();
+        if let Some(layout) = current_frame.lines.get(key) {
+            // KaminIDE patch (#76): счётчики кэша шейпинга.
+            crate::frame_perf::CACHED_LINES.fetch_add(1, std::sync::atomic::Ordering::Relaxed);
