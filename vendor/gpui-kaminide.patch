+//! Adapter dimensions preserve keyword identity and scale only absolute lengths.
+use super::ToTaffy;
+use crate::{CssSizingKeyword, Style, px};
+
+#[test]
+fn native_keywords_and_ratio_basis_survive_style_conversion() {
+    let style = Style {
+        sizing_keywords: [
+            Some(CssSizingKeyword::MinContent),
+            Some(CssSizingKeyword::FitContent),
+        ],
+        aspect_ratio_preferred_size: [None, Some(50.0)],
+        ..Style::default()
+    };
+    let native: taffy::Style = style.to_taffy(px(16.0), 1.25);
+    assert_eq!(native.size.width, taffy::Dimension::min_content());
+    assert_eq!(native.size.height, taffy::Dimension::fit_content());
+    assert_eq!(native.aspect_ratio_preferred_size.height, Some(62.5));
+}
+
+#[test]
+fn fit_content_arguments_keep_length_and_percentage_units() {
+    let style = Style {
+        sizing_keywords: [
+            Some(CssSizingKeyword::FitContentPixels(40.0)),
+            Some(CssSizingKeyword::FitContentPercent(0.5)),
+        ],
+        ..Style::default()
+    };
+    let native: taffy::Style = style.to_taffy(px(16.0), 1.25);
+    assert_eq!(native.size.width, taffy::Dimension::fit_content_px(50.0));
+    assert_eq!(
+        native.size.height,
+        taffy::Dimension::fit_content_percent(0.5)
+    );
+}
diff --git a/vendor/gpui/src/taffy/node_reserve_tests.rs b/vendor/gpui/src/taffy/node_reserve_tests.rs
new file mode 100644
index 0000000000000000000000000000000000000000..6c3da420c98e3b81516a996ce5e34797c9dfb06c
--- /dev/null
+++ b/vendor/gpui/src/taffy/node_reserve_tests.rs
@@ -0,0 +1,45 @@
+//! KaminIDE patch: only the window's frame tree grows to the frame's element count,
+//! and only once it is large; small trees keep doubling.
+
+use super::{RESERVE_FROM_NODES, TaffyLayoutEngine};
+use std::cell::Cell;
+use taffy::style::Style;
+
+/// Insert nodes until the storage is full with at least `nodes` nodes.
+fn fill(engine: &mut TaffyLayoutEngine, nodes: usize) {
+    while !engine.taffy.node_storage_full() || engine.taffy.total_node_count() < nodes {
+        engine.taffy.new_leaf(Style::default()).unwrap();
+    }
+}
+
+#[test]
+fn a_full_large_frame_tree_grows_once_to_the_hint() {
+    let mut engine = TaffyLayoutEngine::new();
+    fill(&mut engine, RESERVE_FROM_NODES);
+    let asked = Cell::new(0);
+    engine.reserve_nodes_when_full(|| {
+        asked.set(asked.get() + 1);
+        RESERVE_FROM_NODES * 3
+    });
+    assert_eq!(asked.get(), 1);
+    assert!(!engine.taffy.node_storage_full());
+    // Storage with room left does not read the hint again.
+    engine.reserve_nodes_when_full(|| unreachable!("storage is not full"));
+}
+
+#[test]
+fn a_small_full_frame_tree_keeps_doubling() {
+    let mut engine = TaffyLayoutEngine::new();
+    fill(&mut engine, 1);
+    assert!(engine.taffy.total_node_count() < RESERVE_FROM_NODES);
+    engine.reserve_nodes_when_full(|| unreachable!("small trees do not read the hint"));
+    assert!(engine.taffy.node_storage_full());
+}
+
+#[test]
+fn an_independent_subtree_keeps_only_its_own_nodes() {
+    let mut engine = TaffyLayoutEngine::new_for_subtree();
+    fill(&mut engine, RESERVE_FROM_NODES);
+    engine.reserve_nodes_when_full(|| unreachable!("subtrees are not sized by the frame"));
+    assert!(engine.taffy.node_storage_full());
+}
diff --git a/vendor/gpui/src/taffy/overflow_contribution.rs b/vendor/gpui/src/taffy/overflow_contribution.rs
new file mode 100644
index 0000000000000000000000000000000000000000..bc3520cc87ec0543e168891aaac54a07bb4691ef
--- /dev/null
+++ b/vendor/gpui/src/taffy/overflow_contribution.rs
@@ -0,0 +1,27 @@
+//! KaminIDE patch: native overflow geometry for independently measured children.
+
+use super::{LayoutId, TaffyLayoutEngine};
+use crate::{Bounds, Pixels, point, size};
+
+impl TaffyLayoutEngine {
+    pub fn overflow_contribution(&self, id: LayoutId, scale: f32) -> Bounds<Pixels> {
+        let node = id.into();
+        let layout = self.taffy.unrounded_layout(node);
+        let style = self.taffy.style(node).expect(super::EXPECT_MESSAGE);
+        let rect = taffy::compute_scrollable_overflow_contribution(
+            layout.relative_offset,
+            layout.size,
+            layout.scrollable_overflow_rect,
+            style.overflow,
+            style.contain,
+            false,
+        );
+        Bounds {
+            origin: point(Pixels(rect.left / scale), Pixels(rect.top / scale)),
+            size: size(
+                Pixels((rect.right - rect.left) / scale),
+                Pixels((rect.bottom - rect.top) / scale),
+            ),
+        }
+    }
+}
diff --git a/vendor/gpui/src/taffy/overflow_reach.rs b/vendor/gpui/src/taffy/overflow_reach.rs
new file mode 100644
index 0000000000000000000000000000000000000000..ac321b3c234c591cf3d5059d91faf9d515853d38
--- /dev/null
+++ b/vendor/gpui/src/taffy/overflow_reach.rs
@@ -0,0 +1,68 @@
+//! KaminIDE patch: which descendants carry a box's scrollable overflow, for DevTools `why`.
+
+use super::{LayoutId, TaffyLayoutEngine};
+use taffy::style::Overflow;
+
+impl TaffyLayoutEngine {
+    /// KaminIDE patch: the node and its ancestors as `display/position size min max`,
+    /// for DevTools `why`: what fixed a box's size.
+    pub fn layout_ancestry(&self, id: LayoutId, depth: usize) -> Vec<String> {
+        let mut node: Option<taffy::NodeId> = Some(id.into());
+        let mut steps = Vec::new();
+        while let Some(at) = node.filter(|_| steps.len() < depth) {
+            let Ok(style) = self.taffy.style(at) else { break };
+            steps.push(format!(
+                "{:?}/{:?} size {:?} min {:?} max {:?}",
+                style.display, style.position, style.size, style.min_size, style.max_size
+            ));
+            node = self.taffy.parent(at);
+        }
+        steps
+    }
+
+    /// KaminIDE patch: the chain of descendants that reach farthest along the physical
+    /// axis (`vertical` false: right edge) in the last layout of `id`, from `id` down,
+    /// each as `display/position overflow at offset size -> reach` (layout points,
+    /// from `id`'s border box). Diagnostics only: it walks the laid-out tree.
+    pub fn overflow_reach(&self, id: LayoutId, vertical: bool, scale_factor: f32) -> Vec<String> {
+        let mut steps = Vec::new();
+        let mut node: taffy::NodeId = id.into();
+        let mut origin = 0.0_f32;
+        // A degenerate tree cannot loop: the chain is as deep as the tree.
+        for _ in 0..256 {
+            let Ok(children) = self.taffy.children(node) else { break };
+            let mut best: Option<(taffy::NodeId, f32, f32)> = None;
+            for child in children {
+                let (Ok(layout), Ok(style)) = (self.taffy.layout(child), self.taffy.style(child)) else {
+                    continue;
+                };
+                let (at, extent, overflow, clip) = if vertical {
+                    (layout.location.y, layout.size.height, layout.border.top + layout.scrollable_overflow_rect.bottom, style.overflow.y)
+                } else {
+                    (layout.location.x, layout.size.width, layout.border.left + layout.scrollable_overflow_rect.right, style.overflow.x)
+                };
+                // A box that clips its content offers only its border box (CSS Overflow 3 §2.2).
+                let reach = at + if clip == Overflow::Visible { extent.max(overflow) } else { extent };
+                if best.is_none_or(|(_, _, far)| reach > far) {
+                    best = Some((child, at, reach));
+                }
+            }
+            let Some((child, at, reach)) = best else { break };
+            let (Ok(layout), Ok(style)) = (self.taffy.layout(child), self.taffy.style(child)) else { break };
+            let to = |v: f32| v / scale_factor;
+            steps.push(format!(
+                "{:?}/{:?} {:?} at {:.1} size {:.1}x{:.1} -> {:.1}",
+                style.display,
+                style.position,
+                style.overflow,
+                to(origin + at),
+                to(layout.size.width),
+                to(layout.size.height),
+                to(origin + reach),
+            ));
+            origin += at;
+            node = child;
+        }
+        steps
+    }
+}
diff --git a/vendor/gpui/src/taffy/physical_measurement.rs b/vendor/gpui/src/taffy/physical_measurement.rs
