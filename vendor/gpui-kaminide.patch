-    let style = &node.style;
-    div()
-        .id(ElementId::NamedInteger(
-            "randomized-element".into(),
-            node.id,
-        ))
-        .flex()
-        .when(style.vertical, |element| element.flex_col())
-        .when(style.wrap, |element| element.flex_wrap())
-        .gap(px(style.gap))
-        .p(px(style.padding))
-        .w(px(style.width))
