+                (m.translation[0] + m.rotation_scale[0][0] * x + m.rotation_scale[0][1] * y) / s,
+                (m.translation[1] + m.rotation_scale[1][0] * x + m.rotation_scale[1][1] * y) / s,
+            )
+        };
