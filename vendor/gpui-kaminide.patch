+                    .tab_stop(2, 5)
+                    .tab_group(3, |builder| builder.tab_stop(1, 7).tab_stop(0, 6))
+                    .tab_group(1, |builder| builder.tab_stop(0, 3).tab_stop(1, 4))
+            })
+            .tab_stop(3, 0)
+            .tab_stop(4, 1)
+            .assert();
+    }
