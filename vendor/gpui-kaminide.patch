--- /dev/null
+++ b/vendor/gpui/src/taffy/physical_measurement.rs
@@ -0,0 +1,35 @@
+//! Read both completed physical baseline sets from independently measured subtrees.
+
+use super::*;
+use crate::MeasuredContent;
+
+impl LayoutMeasurement {
+    /// Measure size and both physical first/last sets without device-pixel rounding.
+    /// Complete line metadata is retained in the subtree for fragment consumers.
+    pub fn measure_physical_baselines(
+        &mut self,
+        available: Size<AvailableSpace>,
+        window: &mut Window,
+        cx: &mut App,
+    ) -> MeasuredContent {
+        let (size, first_y, last_y) = self.measure(available, window, cx);
+        let output = self
+            .tree
+            .computed_layout_output(self.root)
+            .expect(EXPECT_MESSAGE)
+            .expect("the subtree completed full layout");
+        MeasuredContent {
+            first_y,
+            last_y,
+            first_x: output
+                .baselines_x
+                .first
+                .map(|value| Pixels(value / self.scale_factor)),
+            last_x: output
+                .baselines_x
+                .last
+                .map(|value| Pixels(value / self.scale_factor)),
+            ..MeasuredContent::new(size)
+        }
+    }
+}
diff --git a/vendor/gpui/src/taffy/retained.rs b/vendor/gpui/src/taffy/retained.rs
new file mode 100644
index 0000000000000000000000000000000000000000..7612889a79b97d33a9f2d18acd23919929d36acc
--- /dev/null
+++ b/vendor/gpui/src/taffy/retained.rs
@@ -0,0 +1,636 @@
+//! KaminIDE patch: the window's frame tree survives frames.
+//!
+//! A frame used to drop its Taffy tree, so every node lost its layout cache
+//! (Taffy keys it by known dimensions, available space and parent size, the
+//! same idea as the LayoutNG constraint-space cache). Now the frame tree keeps
+//! the nodes of the last pass. A node requested again with the same inputs is
+//! *claimed*: it keeps its Taffy node and with it the cached results of its
+//! whole subtree, so a relayout recomputes only nodes whose inputs changed and
+//! the ancestors of those nodes.
+//!
+//! The inputs of a node are its style, its children and, for a measured leaf,
+//! its measure function. A function is opaque, so a measured leaf is claimed
+//! only under a *layout key* its host supplies (`Window::set_next_layout_key`)
+//! that covers everything the function reads. Identity:
+//! - a parent is the previous parent of its first child, when it has exactly
+//!   the same children in the same order and the same style;
+//! - a plain leaf is the node at the same position of the previous pass's
+//!   request sequence, when it is still a childless plain leaf of that style;
+//! - a measured leaf is any unclaimed previous leaf with the same layout key
+//!   and style (equal keys mean interchangeable measurements), the one at the
+//!   same request position first.
+//!
+//! Positions are aligned, not absolute: a claimed measured leaf moves the
+//! cursor into the previous sequence to the position after its own, so a
+//! subtree of another size before it (a block replaced by one leaf, a
+//! paragraph that gained a node) shifts only the requests up to the next
+//! keyed leaf. A position is only a guess at identity: whatever node it
+//! finds is claimed only when it is a childless plain leaf of an equal style,
+//! whose layout depends on nothing else.
+//!
+//! Equal keys repeat (equal texts), so a keyed leaf moves the cursor only
+//! while the cursor may be off (`astray`: a node was created since the last
+//! anchor, or a parent was claimed away from the cursor). While the cursor
+//! is aligned, a keyed request takes the leaf at the cursor or one left
+//! behind it, never one ahead: that one belongs to a later request (a cell
+//! whose text became that of a later cell), and taking it would move the
+//! cursor there and set every later request against the wrong nodes.
+//!
+//! Styles are compared by value (shared allocation first, `style_share`); a
+//! claimed node takes this pass's shared allocation of its equal style.
+//!
+//! Nothing is ever marked dirty: a node whose inputs differ is a new node, so
+//! its ancestors are new nodes as well, and new nodes start with empty caches.
+//! At the end of a pass (`TaffyLayoutEngine::clear`) the previous nodes that
+//! were not claimed are dropped in one sweep (`TaffyTree::retain_nodes`).
+//!
+//! A host may keep the measure functions of a subtree's leaves for the next
+//! pass (`keep_measures`): that pass can claim the subtree whole and lay it
+//! out at new constraints (another available width) without its requests.
+//!
+//! The bookkeeping lives on the nodes where it can: a key's candidate slot in
+//! the measured leaf's context, the pinned identity of a stamped node in its
+//! Taffy node; only keys and memos are side tables.
+
+use super::{LayoutId, NodeContext, NodeMeasureFn, TaffyLayoutEngine, node_measure};
+use crate::RetainedSubtree;
+use collections::{FxHashMap, FxHashSet};
+use std::any::Any;
+use std::rc::Rc;
+use taffy::tree::NodeId;
+
+/// `NodeContext::key_slot` of a leaf that is in no candidate list.
+pub(super) const NO_SLOT: u32 = u32::MAX;
+
+/// Mark of a position whose leaf left its candidate list (`Candidates`).
+const GONE: u32 = 1 << 31;
+
+/// Previous-pass positions of the measured leaves of one layout key,
+/// ascending, so the one nearest the cursor is found by bisection. A leaf
+/// that is claimed (by its request or with a whole subtree) or recycled leaves
+/// its list in O(1): its entry, found through `NodeContext::key_slot`, keeps
+/// its position for the bisection and gets the `GONE` mark, and `head` skips
+/// the marked entries at the front. Requests mostly claim in order, so a key
+/// shared by many leaves does not make a request scan the claimed ones.
+#[derive(Default)]
+pub(super) struct Candidates {
+    pub(super) positions: Vec<u32>,
+    head: usize,
+}
+
+#[cfg(test)]
+impl Candidates {
+    /// No unclaimed leaf is left.
+    pub(super) fn is_empty(&self) -> bool {
+        self.positions[self.head..].iter().all(|p| p & GONE != 0)
+    }
+}
+
+/// Request history of the frame tree across passes.
+#[derive(Default)]
+pub(super) struct Retained {
+    /// Nodes in request order of the previous pass.
+    prev: Vec<NodeId>,
+    /// Nodes in request order of this pass.
+    seq: Vec<NodeId>,
+    /// Name of this pass, and of the pass `prev` was requested in (0: none):
+    /// a captured subtree is a range of one of them (`RetainedSubtree`).
+    pass: Pass,
+    prev_pass: u64,
+    /// Position in `prev` that corresponds to the next request of this pass.
+    cursor: usize,
+    /// The cursor may be off: a node was created since it was last confirmed
+    /// (a keyed leaf claimed at the cursor, a parent claimed at the cursor).
+    astray: bool,
+    /// Nodes requested (claimed or created) in this pass.
+    live: FxHashSet<NodeId>,
+    /// Layout keys of the keyed measured leaves in the tree.
+    keys: FxHashMap<NodeId, u64>,
+    /// Positions in `prev` of the previous pass's measured leaves by layout
+    /// key (`Candidates`).
+    pub(super) by_key: FxHashMap<u64, Candidates>,
+    /// Layout key for the next measured leaf request.
+    pub(super) next_key: Option<u64>,
+    /// Whether the host vouches for its layout keys now (Window::with_layout_keys).
+    pub(super) keys_enabled: bool,
+    /// Nodes claimed from a previous pass, for counters and tests.
+    pub(super) claimed: u64,
+    /// Host values derived from a node's subtree (`Window::set_layout_memo`),
+    /// valid while the node keeps its stamp.
+    memos: FxHashMap<NodeId, Rc<dyn Any>>,
+    /// Requested styles of nodes a pass overrode in place (shrink-to-fit caps,
+    /// root stretch): restored at the end of the pass, so the next request
+    /// with the same style claims the node again.
+    overrides: FxHashMap<NodeId, taffy::SharedStyle>,
+    /// A measure function of a kept leaf ran in this pass. Only a leaf of a
+    /// subtree claimed whole (`claim_subtree`) keeps the retired function, so
+    /// its constraints changed and the caches of this pass's ancestors hold
+    /// results computed from a stub: the host rebuilds the frame and the tree
+    /// is dropped at the end of the pass.
+    stale: Rc<std::cell::Cell<bool>>,
+}
+
+/// Name of a pass, unique among the passes of every engine of the process:
+/// a range captured in one sequence is never read from another. Never 0, so
+/// an `Option<RetainedSubtree>` takes no more room than the subtree.
+struct Pass(std::num::NonZeroU64);
+
+impl Default for Pass {
+    fn default() -> Self {
+        static NEXT: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(1);
+        let next = NEXT.fetch_add(1, std::sync::atomic::Ordering::Relaxed);
+        Self(std::num::NonZeroU64::new(next).unwrap_or(std::num::NonZeroU64::MAX))
+    }
+}
+
+/// The request sequence a captured subtree lies in.
+#[derive(Clone, Copy)]
+enum Sequence {
+    This,
+    Previous,
+}
+
+impl Retained {
+    /// The sequence and range of `subtree`, if it was captured or claimed in
+    /// this pass or in the previous one. A range of an older pass names
+    /// nothing: nodes no pass requested since were swept.
+    fn span(&self, subtree: &RetainedSubtree) -> Option<(Sequence, std::ops::Range<usize>)> {
+        let sequence = match subtree.pass {
+            pass if pass == self.pass.0 => Sequence::This,
+            pass if pass.get() == self.prev_pass => Sequence::Previous,
+            _ => return None,
+        };
+        let range = subtree.start as usize..subtree.start as usize + subtree.len as usize;
+        (range.end <= self.nodes(sequence).len()).then_some((sequence, range))
+    }
+
+    fn nodes(&self, sequence: Sequence) -> &[NodeId] {
+        match sequence {
+            Sequence::This => &self.seq,
+            Sequence::Previous => &self.prev,
+        }
+    }
+
+    fn note(&mut self, node: NodeId) {
+        self.live.insert(node);
+        // A pass requests about as many nodes as the previous one: one
+        // allocation at its first request instead of a doubling series. The
+        // sequence is reserved only while the pass runs, so between passes the
+        // tree holds no more than the previous sequence.
+        if self.seq.capacity() == 0 && !self.prev.is_empty() {
+            self.seq.reserve(self.prev.len());
+        }
+        self.seq.push(node);
+        self.cursor += 1;
+    }
+}
+
+impl TaffyLayoutEngine {
+    /// The previous node that a parent request with `style` and `children`
+    /// claims, if any.
+    pub(super) fn claim_parent(
+        &mut self,
+        style: &taffy::SharedStyle,
+        children: &[LayoutId],
+    ) -> Option<LayoutId> {
+        if !self.frame_tree {
+            return None;
+        }
+        let first = children.first()?.0;
+        let parent = self.taffy.parent(first)?;
+        let found = !self.retained.live.contains(&parent)
+            && !self.taffy.has_node_context(parent)
+            && self.taffy.children_slice(parent) == LayoutId::to_taffy_slice(children)
+            && children
+                .iter()
+                .all(|child| self.taffy.parent(child.0) == Some(parent))
+            && self.taffy.style_equals(parent, style);
+        if found {
+            // A parent is known by its children: claimed at the cursor, it
+            // confirms the alignment; elsewhere, it shows the cursor is off.
+            self.retained.astray = self.retained.prev.get(self.retained.cursor) != Some(&parent);
+        }
+        found.then(|| self.claim(parent, style))
+    }
+
+    /// The previous plain leaf that a leaf request with `style` claims.
+    pub(super) fn claim_leaf(&mut self, style: &taffy::SharedStyle) -> Option<LayoutId> {
+        if !self.frame_tree {
+            return None;
+        }
+        let node = *self.retained.prev.get(self.retained.cursor)?;
+        let found = !self.retained.live.contains(&node)
+            && self.taffy.style_equals(node, style)
+            && self.taffy.children_slice(node).is_empty()
+            && !self.taffy.has_node_context(node);
+        found.then(|| self.claim(node, style))
+    }
+
+    /// The previous measured leaf that a keyed request claims. The new
+    /// measure function replaces the old one; the leaf's measured outputs
+    /// (static positions, line baselines) and cache stay.
+    pub(super) fn claim_measured(
+        &mut self,
+        key: u64,
+        style: &taffy::SharedStyle,
+        context: &mut Option<NodeContext>,
+    ) -> Option<LayoutId> {
+        if !self.frame_tree {
+            return None;
+        }
+        let cursor = self.retained.cursor;
+        let candidates = self.retained.by_key.get(&key)?;
+        let (prev, live) = (&self.retained.prev, &self.retained.live);
+        let fits = |position: &u32| {
+            let node = prev[(*position & !GONE) as usize];
+            *position & GONE == 0
+                && !live.contains(&node)
+                && self.taffy.style_equals(node, style)
+                && self.taffy.children_slice(node).is_empty()
+        };
+        // Equal keys are interchangeable, but the one nearest the cursor keeps
+        // the requests after it aligned (equal texts repeat in a document).
+        let positions = &candidates.positions;
+        let head = candidates.head;
+        let start =
+            head + positions[head..].partition_point(|&position| (position & !GONE) < cursor as u32);
+        let after = (start..positions.len()).find(|&at| fits(&positions[at]));
+        let before = (head..start).rev().find(|&at| fits(&positions[at]));
+        let distance = |at: usize| ((positions[at] & !GONE) as usize).abs_diff(cursor);
+        let astray = self.retained.astray;
+        let at = match (before, after) {
+            (_, Some(a)) if distance(a) == 0 => a,
+            // An aligned cursor: a leaf ahead is a later request's.
+            (b, _) if !astray => b?,
+            (Some(b), Some(a)) if distance(b) < distance(a) => b,
+            (_, Some(a)) => a,
+            (b, None) => b?,
+        };
+        let position = positions[at] as usize;
+        let node = prev[position];
+        self.unlist(key, node);
+        let fresh = context.take()?;
+        if let Some(old) = self.taffy.get_node_context_mut(node) {
+            old.measure = fresh.measure;
+            old.kept = false;
+        }
+        // The requests after this leaf follow the ones after it last pass; a
+        // leaf left behind an aligned cursor is new content, the cursor stays.
+        if astray || position == cursor {
+            self.retained.cursor = position;
+            self.retained.astray = false;
+        }
+        Some(self.claim(node, style))
+    }
+
+    /// Take the previous measured leaf `node` out of the candidates of `key`.
+    fn unlist(&mut self, key: u64, node: NodeId) {
+        let Some(context) = self.taffy.get_node_context_mut(node) else {
+            return;
+        };
+        let at = std::mem::replace(&mut context.key_slot, NO_SLOT) as usize;
+        let prev = &self.retained.prev;
+        let Some(list) = self.retained.by_key.get_mut(&key) else {
+            return;
+        };
+        if let Some(position) = list.positions.get_mut(at)
+            && prev.get((*position & !GONE) as usize) == Some(&node)
+        {
+            *position |= GONE;
+        }
+        while list.positions.get(list.head).is_some_and(|p| p & GONE != 0) {
+            list.head += 1;
+        }
+    }
+
+    /// An unclaimed previous node at this request's position, whose storage a
+    /// new node takes (TaffyTree::reset_node): a pass that claims little
+    /// then holds about one tree, not the previous and the new one. A keyed
+    /// leaf is taken only by a `measured` request: until the cursor is aligned
+    /// again the position may belong to a later request that would claim the
+    /// leaf by its key, and taking it would renew that request's ancestors too.
+    /// A node with a pinned identity (`layout_stamp`) is never reused: its id
+    /// must not name another subtree.
+    pub(super) fn recycle(&mut self, measured: bool) -> Option<NodeId> {
+        if !self.frame_tree {
+            return None;
+        }
+        let node = *self.retained.prev.get(self.retained.cursor)?;
+        if self.retained.live.contains(&node) || self.taffy.identity_pinned(node) {
+            return None;
+        }
+        if !measured && self.retained.keys.contains_key(&node) {
+            return None;
+        }
+        if let Some(key) = self.retained.keys.remove(&node) {
+            self.unlist(key, node);
+        }
+        Some(node)
+    }
+
+    /// Claim `node`, whose style equals `style`. The node takes the shared allocation
+    /// of this pass (`style_share`): the value is the same, so its cache stays valid,
+    /// and the allocation of the previous pass is freed with its last node.
+    fn claim(&mut self, node: NodeId, style: &taffy::SharedStyle) -> LayoutId {
+        let adopted = self.taffy.adopt_equal_style(node, style);
+        debug_assert!(adopted, "a claimed node has the requested style");
+        self.retained.claimed += 1;
+        self.retained.note(node);
+        LayoutId(node)
+    }
+
+    /// Register a node created in this pass; `key` is its layout key.
+    pub(super) fn created(&mut self, node: LayoutId, key: Option<u64>) -> LayoutId {
+        if self.frame_tree {
+            self.retained.astray = true;
+            self.retained.note(node.0);
+            debug_assert!(
+                !self.retained.memos.contains_key(&node.0),
+                "a reused node never had a stamp, so it has no memo"
+            );
+            if let Some(key) = key {
+                self.retained.keys.insert(node.0, key);
+            }
+        }
+        node
+    }
+
+    /// End a pass of the frame tree: drop the nodes this pass did not request
+    /// and make its requests the candidates of the next pass.
+    pub(super) fn retire(&mut self) {
+        if self.retained.stale.get() {
+            self.forget();
+            self.taffy.clear();
+            return;
+        }
+        let retained = &mut self.retained;
+        let live = std::mem::take(&mut retained.live);
+        // Taken, not drained: the table is freed between passes.
+        for (node, style) in std::mem::take(&mut retained.overrides) {
+            if live.contains(&node) {
+                let _ = self.taffy.set_style(node, style);
+            }
+        }
+        // A pass only adds nodes, so this pass's nodes are in the tree: when
+        // they are all of it there is nothing to sweep, and the sweep would
+        // visit every slot the tree ever had (its storage never shrinks).
+        if live.len() != self.taffy.total_node_count() {
+            self.taffy.retain_nodes(|node| live.contains(&node));
+        }
+        retained.memos.retain(|node, _| live.contains(node));
+        // A kept leaf is measured again only by the function of the request
+        // that claims it, so the old function and everything it captured (a
+        // whole paragraph probe) need not outlive the frame. Leaves the host
+        // keeps (`keep_measures`) keep their functions for one more pass.
+        let stub = retired_measure(retained.stale.clone());
+        for node in &live {
+            if self.taffy.has_node_context(*node)
+                && let Some(context) = self.taffy.get_node_context_mut(*node)
+            {
+                context.remeasured = false;
+                context.kept = std::mem::take(&mut context.keep_measure);
+                if !context.kept {
+                    context.measure = stub.clone();
+                }
+            }
+        }
+        retained.keys.retain(|node, _| live.contains(node));
+        retained.by_key.clear();
+        for (position, node) in retained.seq.iter().enumerate() {
+            if let Some(key) = retained.keys.get(node) {
+                let list = &mut retained.by_key.entry(*key).or_default().positions;
+                if let Some(context) = self.taffy.get_node_context_mut(*node) {
+                    context.key_slot = list.len() as u32;
+                }
+                list.push(position as u32);
+            }
+        }
+        retained.prev = std::mem::take(&mut retained.seq);
+        retained.prev_pass = std::mem::take(&mut retained.pass).0.get();
+        retained.cursor = 0;
+        retained.astray = false;
+        retained.next_key = None;
+        retained.keys_enabled = false;
+        retained.live = live;
+        retained.live.clear();
+    }
+
+    /// Forget every retained node (a discarded or panicking pass).
+    pub(super) fn forget(&mut self) {
+        self.retained = Retained::default();
+    }
+
+    /// Remember the requested style of `node` before the pass overrides it.
+    pub(super) fn keep_requested_style(&mut self, node: NodeId) {
+        if self.frame_tree
+            && !self.retained.overrides.contains_key(&node)
+            && let Ok(style) = self.taffy.shared_style(node)
+        {
+            self.retained.overrides.insert(node, style);
+        }
+    }
+
+    /// The stamp of a node of this pass: its id, pinned so that no other
+    /// subtree takes it over (`recycle`). A node keeps its id while passes
+    /// claim it, and a claimed parent has only claimed children, so an equal
+    /// stamp means the whole subtree has the inputs it had when it was stamped.
+    pub fn layout_stamp(&mut self, id: LayoutId) -> Option<u64> {
+        if !self.frame_tree || !self.retained.live.contains(&id.0) {
+            return None;
+        }
+        self.taffy.pin_identity(id.0);
+        Some(u64::from(id.0))
+    }
+
+    /// The host memo of a node, if the node kept its stamp since it was set.
+    pub fn layout_memo(&self, id: LayoutId) -> Option<Rc<dyn Any>> {
+        self.retained.memos.get(&id.0).cloned()
+    }
+
+    /// Attach a host value derived only from the node's subtree inputs; it
+    /// lives while the node is claimed and is dropped with the node.
+    pub fn set_layout_memo(&mut self, id: LayoutId, memo: Rc<dyn Any>) {
+        if self.layout_stamp(id).is_some() {
+            self.retained.memos.insert(id.0, memo);
+        }
+    }
+
+    /// Request position of this pass: a subtree requested from here on is
+    /// captured by `capture_subtree`.
+    pub fn request_position(&self) -> usize {
+        self.retained.seq.len()
+    }
+
+    /// The nodes requested since `start` when they form the subtree of `root`
+    /// (requested last), with the stamp of `root`. The next pass may claim the
+    /// subtree whole while it keeps the stamp (`claim_subtree`). The capture
+    /// is the range of the requests in this pass's sequence, not a copy of
+    /// them: it allocates nothing.
+    pub fn capture_subtree(&mut self, start: usize, root: LayoutId) -> Option<RetainedSubtree> {
+        let nodes = self.retained.seq.get(start..)?;
+        if nodes.last() != Some(&root.0) {
+            return None;
+        }
+        let (start, len) = (u32::try_from(start).ok()?, u32::try_from(nodes.len()).ok()?);
+        let stamp = self.layout_stamp(root)?;
+        Some(RetainedSubtree { stamp, pass: self.retained.pass.0, start, len })
+    }
+
+    /// The nodes of `subtree`, if its pass is this one or the previous one.
+    #[cfg(test)]
+    pub(super) fn subtree_nodes(&self, subtree: &RetainedSubtree) -> Option<&[NodeId]> {
+        let (sequence, range) = self.retained.span(subtree)?;
+        self.retained.nodes(sequence).get(range)
+    }
+
+    /// Claim a subtree captured in a previous pass without its requests. The
+    /// stamp of the root proves that every node of the subtree was kept with
+    /// its inputs; the leaves keep the retired measure function, so a layout
+    /// that needs a new measurement marks the pass stale (`layout_stale`).
+    /// The root's id is its stamp: a pinned node is never recycled and a swept
+    /// one leaves its slot with a new version, so a live pinned root with that
+    /// id is the stamped node. The claim puts the nodes into this pass's
+    /// sequence, and `subtree` becomes their range there: the capture the
+    /// next pass claims.
+    pub fn claim_subtree(&mut self, subtree: &mut RetainedSubtree) -> Option<LayoutId> {
+        let (Sequence::Previous, range) = self.retained.span(subtree)? else {
+            // Captured or claimed in this pass: its nodes are requested.
+            return None;
+        };
+        let nodes = &self.retained.prev[range.clone()];
+        let root = *nodes.last()?;
+        if !self.frame_tree
+            || u64::from(root) != subtree.stamp
+            || !self.taffy.identity_pinned(root)
+            || nodes.iter().any(|node| self.retained.live.contains(node))
+        {
+            return None;
+        }
+        let start = u32::try_from(self.retained.seq.len()).ok()?;
+        for at in range {
+            let node = self.retained.prev[at];
+            // A keyed leaf leaves its candidate list, as when its request claims it.
+            if self
+                .taffy
+                .get_node_context(node)
+                .is_some_and(|context| context.key_slot != NO_SLOT)
+                && let Some(&key) = self.retained.keys.get(&node)
+            {
+                self.unlist(key, node);
+            }
+            self.retained.note(node);
+        }
+        self.retained.claimed += u64::from(subtree.len);
+        subtree.pass = self.retained.pass.0;
+        subtree.start = start;
+        Some(LayoutId(root))
+    }
+
+    /// Keep the measure functions of the measured leaves of `subtree`
+    /// (requested in this pass) for the next pass, instead of retiring them:
+    /// a subtree the next pass claims whole (`claim_subtree`) is then laid
+    /// out at any new constraints by the functions of its own requests, like
+    /// a fresh request of the same subtree, and the pass does not go stale.
+    /// The host vouches that the functions read nothing that changes between
+    /// the passes; it keeps them pass by pass, as long as it claims them.
+    /// With `compact`, a kept function that has a smaller form
+    /// (Measure::compacted) is replaced by it.
+    pub fn keep_measures(&mut self, subtree: &RetainedSubtree, compact: bool) {
+        if !self.frame_tree {
+            return;
+        }
+        let Some((sequence, range)) = self.retained.span(subtree) else {
+            return;
+        };
+        for &node in &self.retained.nodes(sequence)[range] {
+            if self.retained.live.contains(&node)
+                && self.taffy.has_node_context(node)
+                && let Some(context) = self.taffy.get_node_context_mut(node)
+            {
+                context.keep_measure = true;
+                if !compact {
+                    continue;
+                }
+                // The kept function gives way to its compacted form, if any.
+                let compacted = context.measure.borrow_mut().compacted();
+                if let Some(measure) = compacted {
+                    *context.measure.borrow_mut() = super::boxed_measure(measure);
+                }
+            }
+        }
+    }
+
+    /// Let the kept measure functions of the leaves of `subtree`, claimed in
+    /// this pass, prepare for its measures (`Measure::prepare`).
+    pub fn prepare_measures(&mut self, subtree: &RetainedSubtree) {
+        if !self.frame_tree {
+            return;
+        }
+        let Some((sequence, range)) = self.retained.span(subtree) else {
+            return;
+        };
+        for &node in &self.retained.nodes(sequence)[range] {
+            if self.retained.live.contains(&node)
+                && self.taffy.has_node_context(node)
+                && let Some(context) = self.taffy.get_node_context_mut(node)
+            {
+                context.measure.borrow_mut().prepare();
+            }
+        }
+    }
+
+    /// Union of the absolute layout bounds of the nodes of `subtree` in this
+    /// pass.
+    pub fn nodes_layout_bounds(
+        &mut self,
+        subtree: &RetainedSubtree,
+        scale_factor: f32,
+    ) -> Option<crate::Bounds<crate::Pixels>> {
+        let (sequence, range) = self.retained.span(subtree)?;
+        range
+            .map(|at| {
+                let node = self.retained.nodes(sequence)[at];
+                self.layout_bounds(LayoutId(node), scale_factor)
+            })
+            .reduce(|a, b| a.union(&b))
+    }
+
+    /// Whether this pass measured a leaf of `subtree` with the function an
+    /// earlier pass kept (`keep_measures`): its constraints changed, and
+    /// the leaf may lie or draw otherwise than when it was captured.
+    pub fn remeasured(&self, subtree: &RetainedSubtree) -> bool {
+        let Some((sequence, range)) = self.retained.span(subtree) else {
+            return true;
+        };
+        self.retained.nodes(sequence)[range].iter().any(|&node| {
+            self.taffy
+                .get_node_context(node)
+                .is_some_and(|context| context.remeasured)
+        })
+    }
+
+    /// Whether a leaf of a subtree claimed whole was measured in this pass.
+    pub fn layout_stale(&self) -> bool {
+        self.retained.stale.get()
+    }
+
+    /// Nodes claimed from previous passes since the engine was created.
+    pub fn claimed_nodes(&self) -> u64 {
+        self.retained.claimed
+    }
+}
+
+/// The measure function of a leaf between passes: a leaf claimed by its request
+/// gets that request's function before any layout, so this one measures only a
+/// leaf of a subtree claimed whole whose constraints changed; it marks the pass.
+fn retired_measure(
+    stale: Rc<std::cell::Cell<bool>>,
+) -> std::rc::Rc<std::cell::RefCell<NodeMeasureFn>> {
+    std::rc::Rc::new(std::cell::RefCell::new(node_measure(
+        move |_, _, _, _: &mut crate::Window, _: &mut crate::App| {
+            stale.set(true);
+            let none = crate::size(crate::Pixels(0.), crate::Pixels(0.));
+            crate::MeasuredContent::from((none, None, None, None))
+        },
+    )))
+}
diff --git a/vendor/gpui/src/taffy/retained_tests.rs b/vendor/gpui/src/taffy/retained_tests.rs
new file mode 100644
index 0000000000000000000000000000000000000000..eb9ec9893f479dc8c7230187efa449387b8c19de
--- /dev/null
+++ b/vendor/gpui/src/taffy/retained_tests.rs
@@ -0,0 +1,387 @@
+//! KaminIDE patch: the frame tree keeps nodes whose inputs did not change.
+
+use super::{LayoutId, TaffyLayoutEngine};
+use crate::{MeasuredContent, Pixels, Style, px, size};
+
+fn leaf(engine: &mut TaffyLayoutEngine, width: f32) -> LayoutId {
+    let mut style = Style::default();
+    style.size.width = px(width).into();
+    engine.request_layout(&style, px(16.), 1.0, &[])
+}
+
+fn parent(engine: &mut TaffyLayoutEngine, children: &[LayoutId]) -> LayoutId {
+    engine.request_layout(&Style::default(), px(16.), 1.0, children)
+}
+
+fn measured(engine: &mut TaffyLayoutEngine, key: Option<u64>) -> LayoutId {
+    if let Some(key) = key {
+        engine.set_next_layout_key(key);
+    }
+    engine.request_measured_layout_with_box(Style::default(), px(16.), 1.0, |_, _, _, _, _| {
+        MeasuredContent::from((size(Pixels(10.), Pixels(10.)), None, None, None))
+    })
+}
+
+#[test]
+fn an_unchanged_pass_keeps_every_node() {
+    let mut engine = TaffyLayoutEngine::new();
+    let (a, b) = (leaf(&mut engine, 10.), leaf(&mut engine, 20.));
+    let p = parent(&mut engine, &[a, b]);
+    engine.clear();
+    let (a2, b2) = (leaf(&mut engine, 10.), leaf(&mut engine, 20.));
+    assert_eq!((a2, b2), (a, b));
+    assert_eq!(parent(&mut engine, &[a2, b2]), p);
+    assert_eq!(engine.claimed_nodes(), 3);
+}
+
+#[test]
+fn a_changed_leaf_renews_it_and_its_ancestors_and_drops_the_old_ones() {
+    let mut engine = TaffyLayoutEngine::new();
+    let (a, b) = (leaf(&mut engine, 10.), leaf(&mut engine, 20.));
+    let p = parent(&mut engine, &[a, b]);
+    let root = parent(&mut engine, &[p]);
+    engine.clear();
+    let (a2, b2) = (leaf(&mut engine, 10.), leaf(&mut engine, 30.));
+    let p2 = parent(&mut engine, &[a2, b2]);
+    let root2 = parent(&mut engine, &[p2]);
+    assert_eq!(a2, a);
+    // Only the unchanged leaf is kept; the others reuse storage as new nodes.
+    assert_eq!(engine.claimed_nodes(), 1);
+    let _ = (b, p, root, root2);
+    engine.clear();
+    assert_eq!(engine.taffy.total_node_count(), 4);
+    assert_eq!(engine.taffy.children_slice(p2.0), &[a2.0, b2.0]);
+}
+
+#[test]
+fn a_measured_leaf_is_kept_only_under_an_honoured_equal_key() {
+    let mut engine = TaffyLayoutEngine::new();
+    engine.set_layout_keys(true);
+    let keyed = measured(&mut engine, Some(7));
+    let plain = measured(&mut engine, None);
+    engine.clear();
+    engine.set_layout_keys(true);
+    assert_eq!(measured(&mut engine, Some(7)), keyed);
+    let _ = (plain, measured(&mut engine, None));
+    assert_eq!(engine.claimed_nodes(), 1);
+    engine.clear();
+    // Keys outside `set_layout_keys(true)` are ignored.
+    measured(&mut engine, Some(7));
+    assert_eq!(engine.claimed_nodes(), 1);
+}
+
+#[test]
+fn a_parent_with_other_children_is_not_kept() {
+    let mut engine = TaffyLayoutEngine::new();
+    let (a, b) = (leaf(&mut engine, 10.), leaf(&mut engine, 20.));
+    let p = parent(&mut engine, &[a, b]);
+    engine.clear();
+    let a2 = leaf(&mut engine, 10.);
+    assert_eq!(a2, a);
+    assert_ne!(parent(&mut engine, &[a2]), p);
+    assert_eq!(engine.claimed_nodes(), 1);
+}
+
+#[test]
+fn a_kept_node_takes_the_shared_style_of_its_pass() {
+    let mut engine = TaffyLayoutEngine::new();
+    // More distinct styles than sharing candidates: the first one is forgotten.
+    let first = leaf(&mut engine, 0.);
+    for width in 1..=super::style_share::CANDIDATES {
+        leaf(&mut engine, width as f32);
+    }
+    let old = engine.taffy.shared_style(first.0).unwrap();
+    engine.clear();
+    assert_eq!(leaf(&mut engine, 0.), first);
+    let twin = leaf(&mut engine, 0.);
+    assert_ne!(twin, first);
+    let kept = engine.taffy.shared_style(first.0).unwrap();
+    assert!(taffy::SharedStyle::ptr_eq(&kept, &engine.taffy.shared_style(twin.0).unwrap()));
+    assert!(!taffy::SharedStyle::ptr_eq(&kept, &old));
+    assert_eq!(*kept, *old);
+}
+
+#[test]
+fn a_leaf_whose_style_changed_is_not_kept() {
+    let mut engine = TaffyLayoutEngine::new();
+    let a = leaf(&mut engine, 10.);
+    engine.clear();
+    let a2 = leaf(&mut engine, 11.);
+    assert_eq!(engine.claimed_nodes(), 0);
+    assert_eq!(engine.taffy.style(a2.0).unwrap().size.width, taffy::Dimension::length(11.));
+    let _ = a;
+}
+
+#[test]
+fn a_kept_subtree_keeps_its_stamp_and_memo_and_a_renewed_one_loses_them() {
+    let mut engine = TaffyLayoutEngine::new();
+    let a = leaf(&mut engine, 10.);
+    let p = parent(&mut engine, &[a]);
+    let stamp = engine.layout_stamp(p);
+    assert!(stamp.is_some());
+    engine.set_layout_memo(p, std::rc::Rc::new(5u32));
+    engine.clear();
+    let a2 = leaf(&mut engine, 10.);
+    let p2 = parent(&mut engine, &[a2]);
+    assert_eq!((p2, engine.layout_stamp(p2)), (p, stamp));
+    let memo = engine.layout_memo(p2).expect("memo of a kept node");
+    assert_eq!(memo.downcast_ref::<u32>(), Some(&5));
+    engine.clear();
+    let b = leaf(&mut engine, 30.);
+    let p3 = parent(&mut engine, &[b]);
+    assert_ne!(engine.layout_stamp(p3), stamp);
+    assert!(engine.layout_memo(p3).is_none());
+}
+
+#[test]
+fn a_capped_child_is_restored_and_kept_by_the_next_equal_request() {
+    let mut engine = TaffyLayoutEngine::new();
+    let a = leaf(&mut engine, 10.);
+    let p = parent(&mut engine, &[a]);
+    assert!(engine.cap_child_outer_width(p, 0, px(4.), 1.0));
+    engine.clear();
+    let a2 = leaf(&mut engine, 10.);
+    assert_eq!(parent(&mut engine, &[a2]), p);
+    assert_eq!(engine.claimed_nodes(), 2);
+}
+
+#[test]
+fn leaves_of_one_key_are_kept_at_their_positions_with_their_parents() {
+    let mut engine = TaffyLayoutEngine::new();
+    engine.set_layout_keys(true);
+    let mut parents = Vec::new();
+    for width in [10., 20., 30., 40.] {
+        let probe = measured(&mut engine, Some(1));
+        let a = leaf(&mut engine, width);
+        parents.push(parent(&mut engine, &[probe, a]));
+    }
+    engine.clear();
+    engine.set_layout_keys(true);
+    for (width, old) in [10., 20., 30., 40.].into_iter().zip(parents) {
+        let probe = measured(&mut engine, Some(1));
+        let a = leaf(&mut engine, width);
+        assert_eq!(parent(&mut engine, &[probe, a]), old);
+    }
+    assert_eq!(engine.claimed_nodes(), 12);
+}
+#[test]
+fn a_captured_subtree_is_claimed_whole_while_its_root_keeps_the_stamp() {
+    let mut engine = TaffyLayoutEngine::new();
+    // A request before the subtree: the pass that claims it first has the
+    // subtree at another place of its sequence.
+    let _ = leaf(&mut engine, 5.);
+    let start = engine.request_position();
+    let (a, b) = (leaf(&mut engine, 10.), leaf(&mut engine, 20.));
+    let p = parent(&mut engine, &[a, b]);
+    let mut subtree = engine.capture_subtree(start, p).expect("captured");
+    let nodes = [a.0, b.0, p.0];
+    assert_eq!(engine.subtree_nodes(&subtree), Some(&nodes[..]));
+    let captured = subtree;
+    let root = parent(&mut engine, &[p]);
+    engine.clear();
+    // Claimed whole: no requests for its nodes, the next pass keeps them.
+    assert_eq!(engine.claim_subtree(&mut subtree), Some(p));
+    // The claim renews the capture: the same nodes at their place in this pass.
+    assert_eq!(engine.subtree_nodes(&subtree), Some(&nodes[..]));
+    assert_eq!(engine.claim_subtree(&mut subtree), None, "claimed once per pass");
+    assert_eq!(engine.claim_subtree(&mut { captured }), None, "claimed once per pass");
+    assert_eq!(parent(&mut engine, &[p]), root);
+    assert!(!engine.layout_stale());
+    engine.clear();
+    assert_eq!(engine.taffy.total_node_count(), 4);
+    // The capture of the first pass names nothing two passes later; the
+    // renewed one is claimed again.
+    assert_eq!(engine.claim_subtree(&mut { captured }), None);
+    assert_eq!(engine.claim_subtree(&mut subtree), Some(p));
+    assert_eq!(engine.subtree_nodes(&subtree), Some(&nodes[..]));
+    engine.clear();
+    // A pass that renews the subtree drops the stamp: the capture is void.
+    let (a2, c) = (leaf(&mut engine, 10.), leaf(&mut engine, 30.));
+    let _ = parent(&mut engine, &[a2, c]);
+    engine.clear();
+    assert_eq!(engine.claim_subtree(&mut subtree), None);
+}
+
+#[test]
+fn a_capture_is_not_read_from_another_engine_or_after_the_tree_is_forgotten() {
+    let mut engine = TaffyLayoutEngine::new();
+    let start = engine.request_position();
+    let a = leaf(&mut engine, 10.);
+    let p = parent(&mut engine, &[a]);
+    let subtree = engine.capture_subtree(start, p).expect("captured");
+    // Another engine with the same requests has nodes of the same ids.
+    let mut other = TaffyLayoutEngine::new();
+    let a2 = leaf(&mut other, 10.);
+    let p2 = parent(&mut other, &[a2]);
+    let _ = other.layout_stamp(p2);
+    other.clear();
+    assert_eq!(other.claim_subtree(&mut { subtree }), None);
+    assert!(other.subtree_nodes(&subtree).is_none());
+    engine.clear();
+    engine.forget();
+    assert_eq!(engine.claim_subtree(&mut { subtree }), None);
+}
+
+#[test]
+fn a_keyed_leaf_of_a_subtree_claimed_whole_leaves_the_candidates_of_its_key() {
+    let mut engine = TaffyLayoutEngine::new();
+    engine.set_layout_keys(true);
+    let start = engine.request_position();
+    let m = measured(&mut engine, Some(1));
+    let p = parent(&mut engine, &[m]);
+    let mut subtree = engine.capture_subtree(start, p).expect("captured");
+    engine.clear();
+    engine.set_layout_keys(true);
+    assert_eq!(engine.claim_subtree(&mut subtree), Some(p));
+    assert!(engine.retained.by_key.get(&1).is_none_or(|list| list.is_empty()));
+    let context = engine.taffy.get_node_context(m.0).expect("measured leaf");
+    assert_eq!(context.key_slot, super::retained::NO_SLOT);
+    // A request of the same key does not take the claimed leaf again.
+    assert_ne!(measured(&mut engine, Some(1)), m);
+}
+
+#[test]
+fn a_claimed_leaf_leaves_the_candidates_of_its_key() {
+    let mut engine = TaffyLayoutEngine::new();
+    engine.set_layout_keys(true);
+    let a = measured(&mut engine, Some(1));
+    let _ = leaf(&mut engine, 10.);
+    let b = measured(&mut engine, Some(1));
+    engine.clear();
+    engine.set_layout_keys(true);
+    // A new leaf first: the cursor is astray, so the requests take the
+    // nearest candidates, `b` ahead and then `a` behind.
+    let _ = leaf(&mut engine, 99.);
+    assert_eq!(measured(&mut engine, Some(1)), b);
+    assert_eq!(measured(&mut engine, Some(1)), a);
+    assert!(engine.retained.by_key.get(&1).is_none_or(|list| list.is_empty()));
+    for leaf in [a, b] {
+        let context = engine.taffy.get_node_context(leaf.0).expect("measured leaf");
+        assert_eq!(context.key_slot, super::retained::NO_SLOT);
+    }
+    // A third request of the key finds no claimed leaf to take again.
+    let c = measured(&mut engine, Some(1));
+    assert!(c != a && c != b);
+    assert_eq!(engine.claimed_nodes(), 2);
+}
+#[test]
+fn a_stamped_node_is_never_reused_for_another_subtree() {
+    let mut engine = TaffyLayoutEngine::new();
+    let a = leaf(&mut engine, 10.);
+    let p = parent(&mut engine, &[a]);
+    let stamp = engine.layout_stamp(p);
+    let l = leaf(&mut engine, 5.);
+    let plain = parent(&mut engine, &[l]);
+    engine.clear();
+    // Changed subtrees: the stamped parent is not recycled, the plain one is.
+    let l = leaf(&mut engine, 30.);
+    let p2 = parent(&mut engine, &[l]);
+    let l = leaf(&mut engine, 6.);
+    let q2 = parent(&mut engine, &[l]);
+    assert_ne!(p2, p);
+    assert_eq!(q2, plain);
+    assert_ne!(engine.layout_stamp(p2), stamp);
+    engine.clear();
+    // The swept stamped node's id never comes back.
+    for _ in 0..4 {
+        let l = leaf(&mut engine, 7.);
+        let n = parent(&mut engine, &[l]);
+        engine.clear();
+        assert_ne!(engine.layout_stamp(n), stamp);
+    }
+}
+
+fn a_subtree_of_another_size_before_a_keyed_leaf_shifts_no_later_leaf() {
+    let mut engine = TaffyLayoutEngine::new();
+    engine.set_layout_keys(true);
+    let _ = (leaf(&mut engine, 10.), leaf(&mut engine, 20.));
+    let keyed = measured(&mut engine, Some(7));
+    let after = leaf(&mut engine, 30.);
+    engine.clear();
+    // Two leaves become one: the plain leaf after the keyed one keeps its
+    // node although its position in the request sequence moved.
+    engine.set_layout_keys(true);
+    let _ = leaf(&mut engine, 99.);
+    assert_eq!(measured(&mut engine, Some(7)), keyed);
+    assert_eq!(leaf(&mut engine, 30.), after);
+    assert_eq!(engine.claimed_nodes(), 2);
+}
+
+fn of_equal_keys_the_leaf_nearest_its_position_is_kept() {
+    let mut engine = TaffyLayoutEngine::new();
+    engine.set_layout_keys(true);
+    let first = measured(&mut engine, Some(7));
+    let _ = leaf(&mut engine, 10.);
+    let second = measured(&mut engine, Some(7));
+    let after = leaf(&mut engine, 20.);
+    engine.clear();
+    // The first subtree became one leaf: the second keyed leaf is nearer its
+    // previous position than the first one, and the leaf after it follows.
+    engine.set_layout_keys(true);
+    let _ = leaf(&mut engine, 99.);
+    assert_eq!(measured(&mut engine, Some(7)), second);
+    assert_eq!(leaf(&mut engine, 20.), after);
+    let _ = first;
+}
+
+fn a_new_plain_request_does_not_take_a_later_keyed_leaf() {
+    let mut engine = TaffyLayoutEngine::new();
+    engine.set_layout_keys(true);
+    let keyed = measured(&mut engine, Some(7));
+    let after = leaf(&mut engine, 20.);
+    engine.clear();
+    // A new leaf before them sits at the keyed leaf's old position.
+    engine.set_layout_keys(true);
+    let _ = leaf(&mut engine, 99.);
+    assert_eq!(measured(&mut engine, Some(7)), keyed);
+    assert_eq!(leaf(&mut engine, 20.), after);
+}
+
+fn cell(engine: &mut TaffyLayoutEngine, key: u64) -> [LayoutId; 3] {
+    let plain = leaf(engine, 10.);
+    let keyed = measured(engine, Some(key));
+    [plain, keyed, parent(engine, &[plain, keyed])]
+}
+
+fn a_leaf_whose_new_key_a_later_leaf_has_takes_no_node_of_a_later_request() {
+    let mut engine = TaffyLayoutEngine::new();
+    engine.set_layout_keys(true);
+    let before = [1, 2, 3, 4].map(|key| cell(&mut engine, key));
+    parent(&mut engine, &before.map(|c| c[2]));
+    engine.clear();
+    // The second cell's text became the fourth one's: the second cell is new,
+    // and the cells after it keep their nodes, the fourth its own leaf.
+    engine.set_layout_keys(true);
+    let after = [1, 4, 3, 4].map(|key| cell(&mut engine, key));
+    parent(&mut engine, &after.map(|c| c[2]));
+    assert_eq!([after[0], after[2], after[3]], [before[0], before[2], before[3]]);
+    assert_eq!(after[1][0], before[1][0]);
+    assert_eq!(engine.claimed_nodes(), 10);
+}
+
+#[test]
+fn a_tree_that_shrank_keeps_its_nodes_while_its_passes_request_all_of_them() {
+    let mut engine = TaffyLayoutEngine::new();
+    let wide: Vec<_> = (0..64).map(|i| leaf(&mut engine, i as f32)).collect();
+    parent(&mut engine, &wide);
+    engine.clear();
+    // The document became one leaf: the sweep drops the 65 old nodes, and the
+    // storage keeps their slots.
+    let one = leaf(&mut engine, 500.);
+    engine.clear();
+    assert_eq!(engine.taffy.total_node_count(), 1);
+    // Unchanged passes request every node of the tree: nothing is swept.
+    for _ in 0..3 {
+        assert_eq!(leaf(&mut engine, 500.), one);
+        engine.clear();
+        assert_eq!(engine.taffy.total_node_count(), 1);
+    }
+    // A pass that leaves a node out sweeps it again.
+    let kept = leaf(&mut engine, 500.);
+    leaf(&mut engine, 600.);
+    engine.clear();
+    assert_eq!(engine.taffy.total_node_count(), 2);
+    assert_eq!(leaf(&mut engine, 500.), kept);
+    engine.clear();
+    assert_eq!(engine.taffy.total_node_count(), 1);
+}
