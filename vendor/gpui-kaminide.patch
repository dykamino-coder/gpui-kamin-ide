index 0000000000000000000000000000000000000000..466fb22a1859060d509375a341b69402791cae17
--- /dev/null
+++ b/vendor/gpui/src/window/image_sampling.rs
@@ -0,0 +1,82 @@
+//! Image sampling selected by the caller without changing the native UI default.
+
+use super::*;
+
+/// How a raster image is sampled between its source pixels.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum ImageSampling {
+    /// Interpolate neighboring pixels when resizing an image.
+    Linear,
+    /// Interpolate while preserving fractional destination geometry.
+    LinearSubpixel,
+    /// Preserve source pixel boundaries without interpolation.
+    Nearest,
+    /// Interpolate with untransformed destination edges snapped to device pixels.
+    LinearSnapped,
+    /// Preserve source pixels with untransformed edges snapped to device pixels.
+    NearestSnapped,
+}
+
+impl Window {
+    /// Paint an image with an explicit sampling mode during the paint phase.
+    /// Panics if `frame_index` is invalid, like `paint_image`.
+    pub fn paint_image_with_sampling(
+        &mut self,
+        bounds: Bounds<Pixels>,
+        corner_radii: Corners<Pixels>,
+        data: Arc<RenderImage>,
+        frame_index: usize,
+        grayscale: bool,
+        sampling: ImageSampling,
+    ) -> Result<()> {
+        self.invalidator.debug_assert_paint();
+        let scale_factor = self.scale_factor();
+        let bounds = bounds.scale(scale_factor);
+        let params = RenderImageParams {
+            image_id: data.id,
+            frame_index,
+        };
+        let tile = self
+            .sprite_atlas
+            .get_or_insert_with(params.into(), &mut || {
+                Ok(Some((
+                    data.size(frame_index),
+                    Cow::Borrowed(
+                        data.as_bytes(frame_index)
+                            .expect("It's the caller's job to pass a valid frame index"),
+                    ),
+                )))
+            })?
+            .expect("Callback above only returns Some");
+        let content_mask = self.content_mask().scale(scale_factor);
+        let corner_radii = corner_radii.scale(scale_factor);
+        let opacity = self.element_opacity();
+        let transformation = self.current_transformation();
+        self.next_frame.scene.insert_primitive(PolychromeSprite {
+            transformation,
+            order: 0,
+            pad: u32::from(matches!(
+                sampling,
+                ImageSampling::Nearest | ImageSampling::NearestSnapped
+            )),
+            grayscale: grayscale.into(),
+            bounds: match sampling {
+                ImageSampling::LinearSubpixel => bounds,
+                ImageSampling::LinearSnapped | ImageSampling::NearestSnapped => {
+                    Bounds::from_corners(
+                        point(bounds.left().round(), bounds.top().round()),
+                        point(bounds.right().round(), bounds.bottom().round()),
+                    )
+                }
+                _ => bounds
+                    .map_origin(|origin| origin.floor())
+                    .map_size(|size| size.ceil()),
+            },
+            content_mask,
+            corner_radii,
+            tile,
+            opacity,
+        });
+        Ok(())
+    }
+}
diff --git a/vendor/gpui/src/window/layout_async.rs b/vendor/gpui/src/window/layout_async.rs
new file mode 100644
index 0000000000000000000000000000000000000000..1bcdb7b4f2bc62fe7702b35f4373a46a374317ab
--- /dev/null
+++ b/vendor/gpui/src/window/layout_async.rs
@@ -0,0 +1,160 @@
+//! Корень и его измерения приостанавливаются на общем явном стеке.
+use super::*;
+use crate::Axis;
+struct LayoutEngineRestore<'a> {
+    window: &'a mut Window,
+    engine: Option<TaffyLayoutEngine>,
+}
+impl Drop for LayoutEngineRestore<'_> {
+    fn drop(&mut self) {
+        self.window.layout_engine = self.engine.take();
+    }
+}
+impl Window {
+    /// Compute layout without starting a new descendant traversal stack.
+    pub async fn compute_layout_async(
+        &mut self,
+        layout_id: LayoutId,
+        available_space: Size<AvailableSpace>,
+        cx: &mut App,
+        stack: &mut crate::PaintStack,
+    ) {
+        self.invalidator.debug_assert_prepaint();
+        let engine = self.layout_engine.take();
+        let mut restore = LayoutEngineRestore {
+            window: self,
+            engine,
+        };
+        restore
+            .engine
+            .as_mut()
+            .unwrap()
+            .compute_layout_async(layout_id, available_space, restore.window, cx, stack)
+            .await;
+    }
+    /// Register content measurement that can perform descendant intrinsic queries.
+    pub fn request_measured_layout_with_box_async<F>(
+        &mut self,
+        style: Style,
+        mut measure: F,
+    ) -> LayoutId
+    where
+        F: for<'a> AsyncFnMut(
+                Size<Option<Pixels>>,
+                Size<AvailableSpace>,
+                crate::MeasuredBox,
+                &'a mut Window,
+                &'a mut App,
+                &'a mut crate::PaintStack,
+            ) -> crate::MeasuredContent
+            + 'static,
+    {
+        self.invalidator.debug_assert_prepaint();
+        let rem_size = self.rem_size();
+        let scale_factor = self.scale_factor();
+        let scope = self.measure_scope();
+        self.layout_engine
+            .as_mut()
+            .unwrap()
+            .request_measured_layout_with_box_async(
+                style,
+                rem_size,
+                scale_factor,
+                async move |known,
+                            available,
+                            geometry,
+                            window: &mut Window,
+                            cx: &mut App,
+                            stack: &mut crate::PaintStack| {
+                    scope
+                        .enter_async(window, async |window| {
+                            measure(known, available, geometry, window, cx, stack).await
+                        })
+                        .await
+                },
+            )
+    }
+    /// Register both physical baseline sets with a lending descendant measurement.
+    pub fn request_measured_layout_with_physical_baselines_async<F>(
+        &mut self,
+        style: Style,
+        mut measure: F,
+    ) -> LayoutId
+    where
+        F: for<'a> AsyncFnMut(
+                Size<Option<Pixels>>,
+                Size<AvailableSpace>,
+                &'a mut Window,
+                &'a mut App,
+                &'a mut crate::PaintStack,
+            ) -> crate::MeasuredContent
+            + 'static,
+    {
+        self.request_measured_layout_with_box_async(
+            style,
+            async move |known,
+                        available,
+                        _,
+                        window: &mut Window,
+                        cx: &mut App,
+                        stack: &mut crate::PaintStack| {
+                measure(known, available, window, cx, stack).await
+            },
+        )
+    }
+}
+
+impl Window {
+    /// Query one intrinsic axis without nesting a native traversal stack.
+    pub async fn measure_layout_size_async(
+        &mut self,
+        id: LayoutId,
+        available: Size<AvailableSpace>,
+        axis: Axis,
+        cx: &mut App,
+        stack: &mut crate::PaintStack,
+    ) -> Size<Pixels> {
+        let engine = self.layout_engine.take();
+        let mut restore = LayoutEngineRestore {
+            window: self,
+            engine,
+        };
+        restore
+            .engine
+            .as_mut()
+            .expect("layout engine during measurement")
+            .measure_size_async(id, available, axis, restore.window, cx, stack)
+            .await
+    }
+}
+
+impl Window {
+    /// Register horizontal baseline measurement on the caller's traversal stack.
+    pub fn request_measured_layout_with_baselines_async<F>(
+        &mut self,
+        style: Style,
+        mut measure: F,
+    ) -> LayoutId
+    where
+        F: for<'a> AsyncFnMut(
+                Size<Option<Pixels>>,
+                Size<AvailableSpace>,
+                &'a mut Window,
+                &'a mut App,
+                &'a mut crate::PaintStack,
+            ) -> (Size<Pixels>, Option<Pixels>, Option<Pixels>)
+            + 'static,
+    {
+        self.request_measured_layout_with_physical_baselines_async(
+            style,
+            async move |known,
+                        available,
+                        window: &mut Window,
+                        cx: &mut App,
+                        stack: &mut crate::PaintStack| {
+                let (size, first, last) = measure(known, available, window, cx, stack).await;
+                crate::MeasuredContent::from((size, first, last, None))
+            },
+        )
+    }
+}
diff --git a/vendor/gpui/src/window/layout_inputs.rs b/vendor/gpui/src/window/layout_inputs.rs
new file mode 100644
index 0000000000000000000000000000000000000000..17fa748198138cc0ffaff42257858357cf4f4c45
--- /dev/null
+++ b/vendor/gpui/src/window/layout_inputs.rs
@@ -0,0 +1,121 @@
+//! KaminIDE patch: завершение входов стиля из layout до фиксации кадра.
+use super::*;
+
+/// Идентичность постоянного источника layout-dependent style input.
+/// Копии одной коробки используют тот же идентификатор.
+#[derive(Clone, Copy, Debug, Eq, Hash, PartialEq)]
+pub struct LayoutInputId(u64);
+
+impl Default for LayoutInputId {
+    fn default() -> Self {
+        use std::sync::atomic::{AtomicU64, Ordering};
+        static NEXT: AtomicU64 = AtomicU64::new(0);
+        Self(NEXT.fetch_add(1, Ordering::Relaxed))
+    }
+}
+
+pub(super) struct PrepaintRoots {
+    pub(super) root_element: AnyElement,
+    #[cfg(any(feature = "inspector", debug_assertions))]
+    pub(super) inspector_element: Option<AnyElement>,
+    pub(super) prompt_element: Option<AnyElement>,
+    pub(super) active_drag_element: Option<AnyElement>,
+    pub(super) tooltip_element: Option<AnyElement>,
+}
+
+impl Window {
+    /// Опубликовать вход один раз за кадр, после layout его источника.
+    /// Предок обязан отложить prepaint потомков, если вход изменился:
+    /// тогда они будут обработаны только с окончательным стилем предка.
+    /// Изолированный prepaint вне сборки кадра входы не публикует.
+    pub fn update_layout_input(
+        &mut self,
+        id: LayoutInputId,
+        update: impl FnOnce() -> bool,
+    ) -> bool {
+        self.invalidator.debug_assert_prepaint();
+        let Some(inputs) = self.layout_inputs.as_mut() else {
+            return false;
+        };
+        if !inputs.insert(id) {
+            return false;
+        }
+        let changed = update();
+        self.layout_retry |= changed;
+        changed
+    }
+
+    pub(super) fn prepaint_roots_with_layout_inputs(
+        &mut self,
+        root_size: Size<Pixels>,
+        _inspector_width: Pixels,
+        cx: &mut App,
+    ) -> PrepaintRoots {
+        let text_index = self.text_system.layout_index();
+        self.layout_inputs = Some(FxHashSet::default());
+        loop {
+            self.layout_retry = false;
+            if self.a11y.is_active() {
+                self.a11y.begin_frame();
+            }
+            let mut root = self.root.as_ref().unwrap().clone().into_any_element();
+            let id = root.request_layout(self, cx);
+            let scale_factor = self.scale_factor();
+            self.layout_engine
+                .as_mut()
+                .unwrap()
+                .stretch_auto_size_to_fill(id, root_size, scale_factor);
+            root.prepaint_as_root(Point::default(), root_size.into(), self, cx);
+            #[cfg(any(feature = "inspector", debug_assertions))]
+            let inspector_element = self.prepaint_inspector(_inspector_width, cx);
+
+            self.prepaint_deferred_draws(cx);
+
+            let mut prompt_element = None;
+            let mut active_drag_element = None;
+            let mut tooltip_element = None;
+            if let Some(prompt) = self.prompt.take() {
+                let mut element = prompt.view.any_view().into_any_element();
+                let prompt_layout_id = element.request_layout(self, cx);
+                self.layout_engine
+                    .as_mut()
+                    .unwrap()
+                    .stretch_auto_size_to_fill(prompt_layout_id, root_size, scale_factor);
+                element.prepaint_as_root(Point::default(), root_size.into(), self, cx);
+                prompt_element = Some(element);
+                self.prompt = Some(prompt);
+            } else if let Some(active_drag) = cx.active_drag.take() {
+                let mut element = active_drag.view.clone().into_any_element();
+                let offset = self.mouse_position() - active_drag.cursor_offset;
+                element.prepaint_as_root(offset, AvailableSpace::min_size(), self, cx);
+                active_drag_element = Some(element);
+                cx.active_drag = Some(active_drag);
+            } else {
+                tooltip_element = self.prepaint_tooltip(cx);
+            }
+            if !self.layout_retry {
+                self.layout_inputs = None;
+                return PrepaintRoots {
+                    root_element: root,
+                    #[cfg(any(feature = "inspector", debug_assertions))]
+                    inspector_element,
+                    prompt_element,
+                    active_drag_element,
+                    tooltip_element,
+                };
+            }
+
+            // Регистрации отброшенной попытки не попадают в кадр; состояние
+            // элементов (scroll/focus/view caches) сохраняется. Refresh не
+            // позволяет повторно использовать диапазоны отброшенного prepaint.
+            let states = mem::take(&mut self.next_frame.element_states);
+            self.next_frame.clear();
+            self.next_frame.element_states = states;
+            self.text_system.truncate_layouts(text_index.clone());
+            self.requested_autoscroll = None;
+            self.tooltip_bounds = None;
+            self.layout_engine.as_mut().unwrap().clear();
+            self.refreshing = true;
+        }
+    }
+}
diff --git a/vendor/gpui/src/window/line_baselines.rs b/vendor/gpui/src/window/line_baselines.rs
new file mode 100644
index 0000000000000000000000000000000000000000..24e56fea3e260af4d042e7a10763b851f3999574
