+++ b/vendor/gpui/src/window/scene_capture.rs
@@ -0,0 +1,102 @@
+//! Isolated transparent scene capture for embedded document content.
+use super::*;
+use image::ImageEncoder as _;
+
+impl Window {
+    /// Lay out embedded content at its capture density without changing display state.
+    pub fn with_scene_capture_scale<R>(
+        &mut self,
+        density: f32,
+        f: impl FnOnce(&mut Self) -> R,
+    ) -> R {
+        let previous = self.scale_factor;
+        self.scale_factor *= density.max(1.0);
+        self.with_restore(previous, |window, previous| {
+            window.scale_factor = *previous;
+        }, f).0
+    }
+
+    /// Paint a local scene into a transparent PNG, without presenting a frame.
+    /// The caller lays out and prepaints its content in the same local coordinates.
+    pub fn paint_scene_to_png(
+        &mut self,
+        size: Size<Pixels>,
+        density: f32,
+        paint: impl FnOnce(&mut Self),
+    ) -> anyhow::Result<Vec<u8>> {
+        self.invalidator.debug_assert_paint();
+        let sf = self.scale_factor() * density.max(1.0);
+        let (_, mut scene) = self.with_isolated_scene(|window| {
+            let previous = (
+                mem::replace(&mut window.scale_factor, sf),
+                window.mask_scale.take(),
+                mem::replace(&mut window.element_opacity, 1.0),
+            );
+            window.with_restore(previous, |window, previous| {
+                window.scale_factor = previous.0;
+                window.mask_scale = previous.1;
+                window.element_opacity = previous.2;
+            }, |window| {
+                window.with_absolute_transformation(TransformationMatrix::unit(), |window| {
+                    window.with_content_mask_replaced(
+                        ContentMask { bounds: Bounds { origin: Point::default(), size } },
+                        paint,
+                    );
+                });
+            });
+        });
+        normalize_solid_quads(&mut scene);
+        scene.finish();
+        let size = crate::size(
+            DevicePixels((f32::from(size.width) * sf).ceil().max(1.0) as i32),
+            DevicePixels((f32::from(size.height) * sf).ceil().max(1.0) as i32),
+        );
+        let mut image = self.platform_window.rasterize_scene(&scene, size)?;
+        // GPU scenes contain premultiplied RGBA; PNG stores straight RGBA.
+        for pixel in image.pixels_mut() {
+            let alpha = u32::from(pixel[3]);
+            if alpha > 0 && alpha < 255 {
+                for channel in &mut pixel.0[..3] {
+                    *channel = ((u32::from(*channel) * 255 + alpha / 2) / alpha).min(255) as u8;
+                }
+            }
+        }
+        let mut bytes = Vec::new();
+        image::codecs::png::PngEncoder::new(&mut bytes).write_image(
+            image.as_raw(),
+            image.width(),
+            image.height(),
+            image::ExtendedColorType::Rgba8,
+        )?;
+        Ok(bytes)
+    }
+}
+
+// Bake uniform scale into solid geometry so the quad shader's antialiasing
+// stays in capture pixels, regardless of whether scale came from HTML or SVG.
+fn normalize_solid_quads(scene: &mut Scene) {
+    for quad in &mut scene.quads {
+        let [[s, b], [c, d]] = quad.transformation.rotation_scale;
+        if s <= 0.0
+            || !s.is_finite()
+            || s != d
+            || b != 0.0
+            || c != 0.0
+            || quad.background.tag != crate::BackgroundTag::Solid
+            || quad.border_style != crate::BorderStyle::Solid
+        {
+            continue;
+        }
+        let [x, y] = quad.transformation.translation;
+        quad.bounds.origin.x = ScaledPixels(quad.bounds.origin.x.0 * s + x);
+        quad.bounds.origin.y = ScaledPixels(quad.bounds.origin.y.0 * s + y);
+        quad.bounds.size.width = quad.bounds.size.width * s;
+        quad.bounds.size.height = quad.bounds.size.height * s;
+        quad.corner_radii = quad.corner_radii.map(|v| *v * s);
+        quad.border_widths = quad.border_widths.map(|v| *v * s);
+        quad.transformation = TransformationMatrix::unit();
+    }
+    for group in &mut scene.groups {
+        normalize_solid_quads(group.scene_mut());
+    }
+}
diff --git a/vendor/gpui/src/window/scene_layer.rs b/vendor/gpui/src/window/scene_layer.rs
new file mode 100644
index 0000000000000000000000000000000000000000..ab1e24ee0e896baa660071215d7d960dde9d6846
--- /dev/null
+++ b/vendor/gpui/src/window/scene_layer.rs
@@ -0,0 +1,260 @@
+//! KaminIDE patch: recording retained scene layers (`scene::layer`) and
+//! binding the values a host may write into them.
+//!
+//! A host paints its content into a layer once and hands the layer to each
+//! later frame (`paint_scene_layer`); a frame that replays the host's paint
+//! range copies the layer's one command, not its primitives. Ranges recorded
+//! inside the layer (a host's inner records) index the layer's scene: a later
+//! recording names that layer as its `source`, from which `reuse_paint` copies.
+
+use super::*;
+use crate::scene::{Binding, BoxRange, LayerHandle, LayerValue, SceneLayer};
+
+/// A layer being recorded: the bindings its scopes painted and the layer
+/// the previous recording of the same content made.
+pub(crate) struct LayerRecording {
+    pub(crate) bindings: Vec<Binding>,
+    pub(crate) boxes: Vec<BoxRange>,
+    /// Owners whose paint reached the layer outside their runs
+    /// (`scene::layer::placed`): the layer holds none of their runs.
+    pub(crate) unheld: Vec<u32>,
+    pub(crate) source: Option<Rc<SceneLayer>>,
+}
+
+/// What `Window::record_scene_layer` made of the content.
+pub enum RecordedLayer {
+    /// The content's commands are in the layer and nowhere else yet: the
+    /// caller paints the layer (`Window::paint_scene_layer`) where it wants it.
+    /// Content that needs the frame scene (groups naming the frame's scroll
+    /// nodes or 3D planes, hoisted backdrops) is a layer too, drawn by a copy
+    /// (`SceneLayer::framed`): writes and box runs address it as any layer.
+    Layer(LayerHandle),
+    /// The paint environment allows no layer (a transform, opacity, mask,
+    /// group, capture, open ink sinks or a layer being recorded): the content
+    /// painted into the frame.
+    Painted(NoLayer),
+}
+
+/// Why `record_scene_layer` made no layer, for DevTools: a stable reason and
+/// the line that decided.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct NoLayer {
+    /// `environment`, `ink`, `nested` or `disabled`.
+    pub reason: &'static str,
+    /// The line that decided.
+    pub site: &'static core::panic::Location<'static>,
+}
+
+impl NoLayer {
+    #[track_caller]
+    fn at(reason: &'static str) -> Self {
+        Self { reason, site: core::panic::Location::caller() }
+    }
+}
+
+impl Window {
+    /// Paint `f` into a new scene layer. `source` is the layer the previous
+    /// recording of this content made: ranges recorded in it replay from it.
+    pub fn record_scene_layer<R>(
+        &mut self,
+        source: Option<&LayerHandle>,
+        f: impl FnOnce(&mut Self) -> R,
+    ) -> (R, RecordedLayer) {
+        self.invalidator.debug_assert_paint();
+        let scene = &self.next_frame.scene;
+        let source = source.map(LayerHandle::content);
+        if !self.retained_root_environment()
+            || !scene.ink.is_empty()
+            || scene.ink_scope != 0
+            || self.layer_recording.is_some()
+            || self.scene_layers_disabled()
+        {
+            let why = match () {
+                _ if !self.retained_root_environment() => NoLayer::at("environment"),
+                _ if !scene.ink.is_empty() || scene.ink_scope != 0 => NoLayer::at("ink"),
+                _ if self.layer_recording.is_some() => NoLayer::at("nested"),
+                _ => NoLayer::at("disabled"),
+            };
+            let previous = mem::replace(&mut self.layer_source, source);
+            let (result, _) = self.with_restore(previous, |window, previous| {
+                window.layer_source = previous.take();
+            }, f);
+            return (result, RecordedLayer::Painted(why));
+        }
+        // The content painted again is about the size of its last recording:
+        // its lists start at that size instead of growing by copies.
+        let mut scene = Scene::default();
+        let (mut bindings, mut boxes) = (Vec::new(), Vec::new());
+        if let Some(last) = &source {
+            // KaminIDE patch: what the last frame drew of this content, for
+            // the comparison of a scroll step (`scene::damage::shift`).
+            self.next_frame.scene.keep_layer_source(last);
+            scene.reserve_like(&last.scene);
+            let (bound, runs) = last.recorded_sizes();
+            bindings.reserve_exact(bound);
+            boxes.reserve_exact(runs);
+        }
+        crate::scene::no_run::start();
+        let recording = Box::new(LayerRecording { bindings, boxes, unheld: Vec::new(), source });
+        // The frame's scene and no recording wait in `state` while `f`
+        // paints into a new scene; restoring swaps them back, on unwind too.
+        let mut state = (scene, Some(recording));
+        mem::swap(&mut self.next_frame.scene, &mut state.0);
+        mem::swap(&mut self.layer_recording, &mut state.1);
+        let (result, (scene, recording)) = self.with_restore(state, |window, state| {
+            mem::swap(&mut window.next_frame.scene, &mut state.0);
+            mem::swap(&mut window.layer_recording, &mut state.1);
+        }, f);
+        let (mut bindings, mut boxes, unheld) =
+            recording.map_or_else(Default::default, |r| (r.bindings, r.boxes, r.unheld));
+        crate::scene::release_unheld(&mut bindings, &mut boxes, unheld);
+        // A layer keeps the groups and hoisted backdrops it made, even when
+        // they name the frame's scroll nodes or 3D planes: a frame draws such
+        // a layer by a copy (`grouped_layer`), and the layer stays the one
+        // target of writes and box runs and the source of the ranges recorded
+        // inside it. A layer records at the frame's root only, outside any
+        // paint record's segment capture, so the copy binds no segments.
+        debug_assert!(self.next_frame.scene.segment_capture.is_none(), "a layer inside a segment capture");
+        (result, RecordedLayer::Layer(LayerHandle::new(SceneLayer::finish(scene, bindings, boxes))))
+    }
+
+    /// Keep what the last frame drew of `layer` until this frame is
+    /// presented: a host that records that content anew without it as the
+    /// source (a layer of a draw lifted out of the document) still lets the
+    /// comparison of this frame with the last find it (`scene::damage::shift`).
+    pub fn keep_last_layer(&mut self, layer: &LayerHandle) {
+        self.next_frame.scene.keep_layer_source(&layer.content());
+    }
+
+    /// Tests paint without scene layers (`Window::set_scene_layers`).
+    fn scene_layers_disabled(&self) -> bool {
+        #[cfg(any(test, feature = "test-support"))]
+        return self.scene_layers_off;
+        #[cfg(not(any(test, feature = "test-support")))]
+        false
+    }
+
+    /// Draw `layer` here: one command in the frame, ordered like one
+    /// primitive covering the layer's ink within the content mask. A layer
+    /// that kept groups or backdrops is copied instead (`paint_grouped_layer`).
+    pub fn paint_scene_layer(&mut self, layer: &LayerHandle) {
+        self.invalidator.debug_assert_paint();
+        let content = layer.content();
+        if content.copied() {
+            return self.paint_grouped_layer(layer, &content, true);
+        }
+        let mask = self.content_mask().scale(self.scale_factor());
+        let bounds = layer.content().bounds().map_or_else(Bounds::default, |b| b.intersect(&mask.bounds));
+        self.next_frame.scene.insert_layer(layer, bounds);
+    }
+
+    /// Draw again a layer that kept groups and was written since the frame
+    /// that drew it (`SceneLayer::copied`): its last copy in the
+    /// rendered frame is stale, a replay of it would show the old content.
+    pub fn redraw_scene_layer(&mut self, layer: &LayerHandle) {
+        self.invalidator.debug_assert_paint();
+        let content = layer.content();
+        if !content.copied() {
+            return self.paint_scene_layer(layer);
+        }
+        self.paint_grouped_layer(layer, &content, false);
+    }
+
+    /// Paint `f` with `owner` (0: none) naming the values its painters bind.
+    pub fn with_paint_owner<R>(&mut self, owner: u32, f: impl FnOnce(&mut Self) -> R) -> R {
+        if self.layer_recording.is_none() && self.paint_owner == 0 {
+            return f(self);
+        }
+        let previous = mem::replace(&mut self.paint_owner, owner);
+        self.with_restore(previous, |window, previous| window.paint_owner = *previous, f).0
+    }
+
+    /// Paint `f` binding the quads it paints to `value` of the paint owner.
+    pub fn with_paint_value<R>(&mut self, value: LayerValue, f: impl FnOnce(&mut Self) -> R) -> R {
+        if self.layer_recording.is_none() || self.paint_owner == 0 {
+            return f(self);
+        }
+        let previous = self.paint_value.replace(value);
+        self.with_restore(previous, |window, previous| window.paint_value = *previous, f).0
+    }
+
+    /// Bind the quad `paint_quad` just inserted, if it inserted one (`before`:
+    /// the quad count before) inside a binding scope of a layer recording.
+    pub(crate) fn bind_painted_quad(&mut self, before: usize, opacity: f32) {
+        let (Some(value), Some(recording)) = (self.paint_value, self.layer_recording.as_mut()) else {
+            return;
+        };
+        let scene = &self.next_frame.scene;
+        if self.paint_owner == 0 || scene.quads.len() != before + 1 {
+            return;
+        }
+        // A group paints into a scene of its own (`with_isolated_scene`, the
+        // groups of a paint plan), composited into the layer as one result:
+        // its quads are not the layer's, and a binding to one would index
+        // another scene's list.
+        if scene.in_group && scene.book.record_runs.is_none() {
+            crate::scene::layer_counters::GROUP_BINDS_SKIPPED
+                .fetch_add(1, std::sync::atomic::Ordering::Relaxed);
+            return;
+        }
+        let binding = Binding {
+            owner: self.paint_owner,
+            value,
+            quad: before as u32,
+            op: (scene.paint_operations.len() - 1) as u32,
+            opacity,
+        };
+        // A paint record keeps the binding for its placements (`scene::layer::placed`).
+        match self.next_frame.scene.book.record_runs.as_mut() {
+            Some(runs) => runs.bindings.push(binding),
+            None => recording.bindings.push(binding),
+        }
+    }
+
+    /// Whether the rendered frame shows nothing new on screen: it repeats the
+    /// frame before it except values written into layers outside the window
+    /// (`Scene::damage`), and the platform shows that frame already. Then it
+    /// needs neither raster nor present.
+    pub(crate) fn present_unneeded(&self) -> bool {
+        if self.frame_readback && !self.unpresented_readback {
+            return false;
+        }
+        let Some(damage) = self.rendered_frame.scene.damage() else {
+            return false;
+        };
+        let screen = Bounds { origin: Point::default(), size: self.viewport_size }
+            .scale(self.scale_factor());
+        let unseen = damage.is_none_or(|d| d.intersect(&screen).is_empty());
+        unseen && self.frame_presented && self.platform_window.last_frame_presented()
+    }
+
+    /// Present the next drawn frame whatever it changed on screen: a reader of
+    /// the presented pixels (a capture, a readback) waits for it.
+    pub fn require_presentation(&mut self) {
+        self.presentation_required = true;
+    }
+
+    /// Present the frame just drawn, unless it changed nothing on screen and
+    /// the platform did not ask for a presentation (`present_unneeded`).
+    pub(crate) fn present_drawn(&mut self, required: bool) {
+        let required = required || std::mem::take(&mut self.presentation_required);
+        if !required && self.present_unneeded() {
+            crate::scene::layer_counters::PRESENTS_SKIPPED.fetch_add(1, std::sync::atomic::Ordering::Relaxed);
+            if let Ok(mut at) = crate::scene::layer_counters::LAST_SKIP.lock() {
+                *at = Some(std::time::Instant::now());
+            }
+            self.needs_present.set(false);
+            return;
+        }
+        self.present();
+    }
+
+    /// The scene `reuse_paint` copies paint ranges from: the source layer of
+    /// the content being painted, else the rendered frame's.
+    pub(crate) fn replay_source(&self) -> Option<Rc<SceneLayer>> {
+        match &self.layer_recording {
+            Some(recording) => recording.source.clone(),
+            None => self.layer_source.clone(),
+        }
+    }
+}
diff --git a/vendor/gpui/src/window/scoped.rs b/vendor/gpui/src/window/scoped.rs
new file mode 100644
index 0000000000000000000000000000000000000000..c63e084b94a6344306491f7a2dea173f5efd226a
--- /dev/null
+++ b/vendor/gpui/src/window/scoped.rs
@@ -0,0 +1,29 @@
+//! Восстановление состояния окна при обычном выходе и раскрутке стека.
+
+use super::Window;
+
+impl Window {
+    pub(super) fn with_restore<S, R>(
+        &mut self,
+        mut state: S,
+        restore: fn(&mut Window, &mut S),
+        f: impl FnOnce(&mut Window) -> R,
+    ) -> (R, S) {
+        struct Restore<'a, S> {
+            window: &'a mut Window,
+            state: &'a mut S,
+            restore: fn(&mut Window, &mut S),
+        }
+        impl<S> Drop for Restore<'_, S> {
+            fn drop(&mut self) {
+                (self.restore)(self.window, self.state);
+                if std::thread::panicking() { self.window.paint_pass.invalidate(); }
+            }
+        }
+        let result = {
+            let guard = Restore { window: self, state: &mut state, restore };
+            f(guard.window)
+        };
+        (result, state)
+    }
+}
diff --git a/vendor/gpui/src/window/scroll_deferred.rs b/vendor/gpui/src/window/scroll_deferred.rs
new file mode 100644
index 0000000000000000000000000000000000000000..fc759cb117b049c843f268a6d2a7485a487768a5
--- /dev/null
+++ b/vendor/gpui/src/window/scroll_deferred.rs
@@ -0,0 +1,213 @@
+//! KaminIDE patch: deferred draws that belong to a scroll node.
+//!
+//! A deferred draw paints after the whole tree, in priority order, but its
+//! content may still live in a scroll container's space: a positioned box
+//! with a positive `z-index` or a sticky box lifted above the flow
+//! (`Window::defer_scrolled_draw`). Such a draw keeps the scroll node that
+//! was open when it was deferred (its owner) and prepaints and paints under
+//! it again: its hitboxes and primitives are marked under the owner, clipped
+//! by its chain, and its nested nodes are the owner's children. A scrolled
+//! replay of a record takes each draw's prepaint and paint range as one more
+//! part of the record and moves it with its owner as it moves the record
+//! (`plan_scrolled_replay`), in the draw's own place of the
+//! deferred pass: paint order and spatial node are separate, as Blink keeps
+//! paint chunks in paint order with their own scroll translation and
+//! WebRender primitives with their own spatial node.
+//!
+//! A plain `defer_draw` (a popover escaping its scroller) has no owner: a
+//! record holding one is built instead of replayed scrolled.
+
+use super::scroll_nodes::ScrollNodeRecord;
+use super::scroll_replay::ScrollReplay;
+use super::*;
+
+/// The scroll node of a deferred draw, and the plan its copy replays with.
+#[derive(Clone, Default)]
+pub(crate) struct DeferredScroll {
+    /// Deferred with `defer_scrolled_draw`.
+    owned: bool,
+    /// Index of the owner node in the draw's frame (`None`: under no node).
+    pub(super) owner: Option<u32>,
+    /// The interest margin its nodes record with (`with_scroll_interest_margin`
+    /// where it was deferred): the deferred pass runs outside that scope.
+    margin: Pixels,
+    /// A scrolled replay copied the draw: the plan and the draw's position
+    /// among the record's deferred draws (`ScrollReplay::deferred`).
+    pub(super) plan: Option<(Rc<ScrollReplay>, usize)>,
+}
+
+/// Where `reuse_prepaint` of a range puts the owners of its deferred draws:
+/// an owner inside the range is renumbered with the copied nodes, one
+/// outside it is the node open where the range is copied, as
+/// `reuse_scroll_nodes` renumbers parents.
+#[derive(Clone)]
+pub(super) struct OwnerMap {
+    old: Range<usize>,
+    first: usize,
+    open: Option<u32>,
+}
+
+impl OwnerMap {
+    pub(super) fn new(range: &Range<PrepaintStateIndex>, window: &Window) -> Self {
+        Self {
+            old: range.start.scroll_nodes_index..range.end.scroll_nodes_index,
+            first: window.next_frame.scroll_nodes.len(),
+            open: window.next_frame.scroll_node_stack.last().copied(),
+        }
+    }
+
+    pub(super) fn copy(&self, scroll: &DeferredScroll) -> DeferredScroll {
+        let owner = match scroll.owner {
+            Some(owner) if self.old.contains(&(owner as usize)) => Some((self.first + owner as usize - self.old.start) as u32),
+            Some(_) => self.open,
+            None => None,
+        };
+        DeferredScroll { owned: scroll.owned, owner, margin: scroll.margin, plan: None }
+    }
+}
+
+impl Window {
+    /// The owner a draw deferred now gets: the innermost open prepaint node.
+    pub(super) fn deferred_scroll_owner(&self) -> DeferredScroll {
+        let owner = self.next_frame.scroll_node_stack.last().copied();
+        DeferredScroll { owned: true, owner, margin: self.scroll_interest_margin, plan: None }
+    }
+
+    /// Open the owner of deferred draw `ix` for its prepaint: nodes it
+    /// opens are the owner's children and record its margin, its hitboxes
+    /// are marked under it. Returns the margin to restore.
+    pub(super) fn enter_deferred_prepaint(&mut self, ix: usize) -> Option<Pixels> {
+        let scroll = &self.next_frame.deferred_draws[ix].scroll;
+        let (owner, margin) = (scroll.owned_node()?, scroll.margin);
+        let interest = self.next_frame.scroll_nodes[owner as usize].interest;
+        self.next_frame.scroll_node_stack.push(owner);
+        self.open_interest(interest, false);
+        Some(std::mem::replace(&mut self.scroll_interest_margin, margin))
+    }
+
+    /// Close what `enter_deferred_prepaint` opened.
+    pub(super) fn leave_deferred_prepaint(&mut self, entered: Option<Pixels>) {
+        if let Some(margin) = entered {
+            self.scroll_interest_margin = margin;
+            self.end_scroll_node_prepaint(Some(0));
+        }
+    }
+
+    /// Prepaint of a deferred draw without its element: a copy of its
+    /// rendered range, moved by the plan of the scrolled replay that copied
+    /// the draw.
+    pub(super) fn reuse_deferred_prepaint(&mut self, ix: usize, range: Range<PrepaintStateIndex>) {
+        let plan = self.next_frame.deferred_draws[ix].scroll.plan.clone();
+        let start = self.prepaint_index();
+        self.reuse_prepaint(range.clone());
+        if let Some((plan, at)) = plan {
+            self.place_scrolled_prepaint(&start, plan.deferred[at].clone(), &plan);
+            self.plan_deferred_copies(&start, &range, &plan);
+        }
+    }
+
+    /// The draws `reuse_prepaint` of the rendered `range` just copied from
+    /// `start` on replay with `plan`, each as the draw it copies.
+    pub(super) fn plan_deferred_copies(&mut self, start: &PrepaintStateIndex, range: &Range<PrepaintStateIndex>, plan: &Rc<ScrollReplay>) {
+        let first = range.start.deferred_draws_index;
+        let copies = &mut self.next_frame.deferred_draws[start.deferred_draws_index..];
+        for (at, draw) in copies.iter_mut().enumerate() {
+            draw.scroll.plan = plan.draws.get(&(first + at)).map(|&part| (plan.clone(), part));
+        }
+    }
+
+    /// Open the owner of a deferred draw for its paint: its primitives are
+    /// marked under it (`with_scene_node`), with its interest rect as their
+    /// own mask and its clip chain as what they draw in.
+    pub(super) fn enter_deferred_paint(&mut self, scroll: &DeferredScroll) -> bool {
+        let Some(owner) = scroll.owned_node() else { return false };
+        let interest = self.next_frame.scroll_nodes[owner as usize].interest;
+        self.open_interest(interest, true);
+        let depth = self.content_mask_stack.len() - 1;
+        self.next_frame.scroll_paint.open.push((owner, depth));
+        true
+    }
+
+    /// Close what `enter_deferred_paint` opened. The draw's commands stay
+    /// the draw's range (`paint_range`), not one of the owner's: the owner
+    /// may have painted in a scene layer, the deferred pass paints in the
+    /// frame's scene, and a scrolled replay checks and moves that range
+    /// itself (`deferred_scroll_part`).
+    pub(super) fn leave_deferred_paint(&mut self, entered: bool) {
+        if entered {
+            self.close_interest(true);
+        }
+    }
+
+    /// Paint of a deferred draw without its element: a copy of its rendered
+    /// commands, moved by the plan of the scrolled replay that copied it,
+    /// with the composition `groups` it made in the rendered frame copied
+    /// and its labels renumbered, as a record's (`replay_groups`).
+    pub(super) fn reuse_deferred_paint(&mut self, scroll: &mut DeferredScroll, range: Range<PaintIndex>, groups: Range<usize>) {
+        let scenes = range.start.scene_index..range.end.scene_index;
+        match scroll.plan.take() {
+            None => {
+                self.replay_groups(groups, None);
+                self.reuse_paint(range);
+            }
+            Some((plan, _)) => {
+                self.reuse_paint_state(&range);
+                let scale = self.scale_factor();
+                let node = |id: ScrollNodeId| plan.scaled(id, scale);
+                let labels = self.rendered_frame.scene.group_labels(scenes.clone(), groups.clone());
+                self.replay_groups(groups, Some((&labels, &node)));
+                self.replay_scenes_scrolled(scenes, &plan);
+            }
+        }
+        self.next_frame.scene.relabel = 0;
+    }
+
+    /// What a deferred draw of a record adds to the record for a scrolled
+    /// replay: its prepainted nodes, its paint range and the draws nested in
+    /// it (by index). `DeferredDraws` when the copy could not be placed: a
+    /// draw without an owner node (`defer_draw`), with an own mask or of an
+    /// isolated view. The planner checks the owner is planned before it.
+    pub(super) fn deferred_scroll_part(
+        &self,
+        draw: &DeferredDraw,
+    ) -> Result<(Range<usize>, Range<usize>, Range<usize>), ScrollRefusal> {
+        let (prepaint, paint) = (&draw.prepaint_range, &draw.paint_range);
+        if draw.scroll_refusal().is_some() {
+            return Err(ScrollRefusal::DeferredDraws);
+        }
+        let nodes = prepaint.start.scroll_nodes_index..prepaint.end.scroll_nodes_index;
+        let nested = prepaint.start.deferred_draws_index..prepaint.end.deferred_draws_index;
+        Ok((nodes, paint.start.scene_index..paint.end.scene_index, nested))
+    }
+
+    /// The nodes of the rendered frame's deferred draws registered in
+    /// `range` (a record's prepaint range).
+    pub(super) fn deferred_scroll_nodes(&self, range: &Range<PrepaintStateIndex>) -> impl Iterator<Item = &ScrollNodeRecord> {
+        let frame = &self.rendered_frame;
+        frame.deferred_draws[range.start.deferred_draws_index..range.end.deferred_draws_index]
+            .iter()
+            .flat_map(|draw| &frame.scroll_nodes[draw.prepaint_range.start.scroll_nodes_index..draw.prepaint_range.end.scroll_nodes_index])
+    }
+}
+
+impl DeferredDraw {
+    /// Why a scrolled replay cannot take this draw (`deferred_scroll_part`),
+    /// for DevTools; `None` when it can.
+    pub(super) fn scroll_refusal(&self) -> Option<&'static str> {
+        match () {
+            _ if !self.scroll.owned => Some("no scroll node (a plain defer_draw)"),
+            _ if self.content_mask.is_some() => Some("its own content mask"),
+            _ if self.isolated.is_some() => Some("an isolated view"),
+            _ => None,
+        }
+    }
+}
+
+impl DeferredScroll {
+    fn owned_node(&self) -> Option<u32> {
+        self.owned.then_some(self.owner).flatten()
+    }
+}
+
+#[cfg(test)]
+mod tests;
diff --git a/vendor/gpui/src/window/scroll_deferred/tests.rs b/vendor/gpui/src/window/scroll_deferred/tests.rs
new file mode 100644
index 0000000000000000000000000000000000000000..6bdb8f7a22a111b7b077559814b8635e5c042821
--- /dev/null
+++ b/vendor/gpui/src/window/scroll_deferred/tests.rs
@@ -0,0 +1,76 @@
+use super::*;
+use crate::{ScrollHandle, TestAppContext, deferred, div, prelude::*, px};
+
+/// A scroller whose second row is lifted above the flow by a deferred draw:
+/// owned by the scroller's node (`in_scroll_node`) or a plain one.
+struct Lifted {
+    handle: ScrollHandle,
+    owned: bool,
+}
+
+impl Render for Lifted {
+    fn render(&mut self, _: &mut Window, _: &mut Context<Self>) -> impl IntoElement {
+        let row = || div().h(px(20.)).w(px(50.)).bg(crate::red());
+        let lifted = deferred(row().id("lifted").cursor_pointer()).with_priority(1);
+        let lifted = if self.owned { lifted.in_scroll_node() } else { lifted };
+        div()
+            .id("scroller")
+            .size(px(100.))
+            .overflow_y_scroll()
+            .track_scroll(&self.handle)
+            .child(row())
+            .child(lifted)
+            .children((0..20).map(|_| row()))
+    }
+}
+
+fn draw(cx: &mut TestAppContext, owned: bool) -> crate::AnyWindowHandle {
+    let handle = ScrollHandle::new();
+    let window = cx.add_window(move |_, _| Lifted { handle, owned });
+    cx.run_until_parked();
+    window.into()
+}
+
+/// An owned draw keeps the scroller's node: its commands are marked under
+/// it and its hitbox too, while its paint stays the draw's own range.
+#[crate::test]
+fn an_owned_deferred_draw_paints_under_its_scroll_node(cx: &mut TestAppContext) {
+    let window = draw(cx, true);
+    window
+        .update(cx, |_, window, _| {
+            let frame = &window.rendered_frame;
+            let [draw] = &frame.deferred_draws[..] else { panic!("one deferred draw") };
+            let owner = draw.scroll.owner.expect("the scroller's node") as usize;
+            let node = &frame.scroll_nodes[owner];
+            let painted = draw.paint_range.start.scene_index..draw.paint_range.end.scene_index;
+            assert!(!painted.is_empty());
+            assert!(node.more.is_empty() && !node.torn);
+            let marks = frame.scene.scroll.within(&painted);
+            assert!(!marks.is_empty() && marks.iter().all(|mark| mark.node == node.id));
+            let hitboxes = draw.prepaint_range.start.hitboxes_index..draw.prepaint_range.end.hitboxes_index;
+            assert!(!hitboxes.is_empty());
+            let marked = frame.scroll_hitboxes.iter().filter(|mark| hitboxes.contains(&(mark.index as usize)));
+            assert!(marked.clone().count() == hitboxes.len() && marked.into_iter().all(|mark| mark.node == node.id));
+        })
+        .unwrap();
+}
+
+/// A plain draw (a popover escaping its scroller) stays outside the node,
+/// and a record holding it cannot be replayed scrolled.
+#[crate::test]
+fn a_plain_deferred_draw_has_no_scroll_node(cx: &mut TestAppContext) {
+    let window = draw(cx, false);
+    window
+        .update(cx, |_, window, _| {
+            let frame = &window.rendered_frame;
+            let [draw] = &frame.deferred_draws[..] else { panic!("one deferred draw") };
+            assert!(frame.scroll_nodes.iter().all(|node| node.more.is_empty()));
+            let painted = draw.paint_range.start.scene_index..draw.paint_range.end.scene_index;
+            assert!(frame.scene.scroll.within(&painted).is_empty());
+            assert_eq!(window.deferred_scroll_part(draw).err(), Some(ScrollRefusal::DeferredDraws));
+            // DevTools reads why, and the line that deferred it (`Lifted::render`).
+            assert_eq!(draw.scroll_refusal(), Some("no scroll node (a plain defer_draw)"));
+            assert!(draw.site.file().replace('\\', "/").ends_with("window/scroll_deferred/tests.rs"), "{}", draw.site);
+        })
+        .unwrap();
+}
diff --git a/vendor/gpui/src/window/scroll_masks.rs b/vendor/gpui/src/window/scroll_masks.rs
new file mode 100644
index 0000000000000000000000000000000000000000..fb008e5a7619cd84d27cb9cc8fdd6f89f6897565
--- /dev/null
+++ b/vendor/gpui/src/window/scroll_masks.rs
@@ -0,0 +1,204 @@
+//! KaminIDE patch: masks under scroll nodes (`scroll_nodes`).
+//!
+//! The children of a scroll node are prepainted and painted under the node's
+//! interest rect instead of its clip, so their own masks (`scene::scroll_marks`)
+//! cover what a replay at another offset may show. Each primitive and hitbox
+//! is drawn and hit-tested with own mask ∩ the node's real clip chain.
+
+mod viewport;
+
+use super::*;
+use crate::ScrollHandle;
+use crate::scene::{Primitive, Scene, scroll_marks::SceneSpace};
+
+/// The scroll node and own mask of a hitbox inserted under it.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub(crate) struct HitboxMark {
+    /// Index of the hitbox in the frame's `hitboxes`.
+    pub(crate) index: u32,
+    pub(crate) node: ScrollNodeId,
+    pub(crate) own: Bounds<Pixels>,
+}
+
+impl Frame {
+    /// Run `f` on the scene with the innermost open paint node as the node
+    /// its commands land under (`Scene::mark_scrolled`, `mark_layer`,
+    /// `mark_copied`): its id and real clip chain in scene pixels. A
+    /// primitive the scene could not keep taints the node.
+    pub(crate) fn with_scene_node<R>(&mut self, scale: f32, f: impl FnOnce(&mut Scene) -> R) -> R {
+        let open = self.recorded_node();
+        self.scene.scroll.open = open.map(|index| {
+            let node = &self.scroll_nodes[index as usize];
+            (node.id, node.clip.scale(scale))
+        });
+        let result = f(&mut self.scene);
+        self.scene.scroll.open = None;
+        if std::mem::take(&mut self.scene.scroll.lost) {
+            if let Some(index) = open {
+                self.scroll_nodes[index as usize].torn = true;
+            }
+        }
+        if std::mem::take(&mut self.scene.scroll.unpivoted) {
+            if let Some(index) = open {
+                self.scroll_nodes[index as usize].unpivoted = true;
+            }
+        }
+        result
+    }
+
+    /// The innermost open paint node a command painted now is marked under:
+    /// none in a paint record while only the nodes open before it began are
+    /// (`ScrollBook::record_base`), which mark its copy where it lands.
+    fn recorded_node(&self) -> Option<u32> {
+        let open = &self.scroll_paint.open;
+        if self.scene.scroll.record_base.is_some_and(|base| open.len() <= base) {
+            return None;
+        }
+        open.last().map(|&(index, _)| index)
+    }
+}
+
+impl Window {
+    /// Run `f` with the scroll nodes it opens recording `margin` past their
+    /// clip (window pixels, each side): a host's subtree that replays scrolled
+    /// (`plan_scrolled_replay`). Zero, the default, records what is visible.
+    pub fn with_scroll_interest_margin<R>(&mut self, margin: Pixels, f: impl FnOnce(&mut Self) -> R) -> R {
+        let outer = std::mem::replace(&mut self.scroll_interest_margin, margin);
+        let result = f(self);
+        self.scroll_interest_margin = outer;
+        result
+    }
+
+    /// The margin `with_scroll_interest_margin` set for what runs now.
+    pub fn scroll_interest_margin(&self) -> Pixels {
+        self.scroll_interest_margin
+    }
+
+    /// Push a node's interest rect as the content mask of its children.
+    pub(super) fn open_interest(&mut self, interest: Bounds<Pixels>, paint: bool) {
+        let depth = self.content_mask_stack.len();
+        self.content_mask_stack.push(ContentMask { bounds: interest });
+        if !paint {
+            self.next_frame.scroll_paint.depths.push(depth);
+        }
+    }
+
+    /// Pop the mask `open_interest` pushed for the innermost prepaint or
+    /// paint node.
+    pub(super) fn close_interest(&mut self, paint: bool) {
+        let pairing = &mut self.next_frame.scroll_paint;
+        let depth = if paint { pairing.open.pop().map(|(_, depth)| depth) } else { pairing.depths.pop() };
+        if let Some(depth) = depth {
+            self.content_mask_stack.truncate(depth);
+        }
+    }
+
+    /// Insert a primitive into the next frame's scene, under the innermost
+    /// open paint node when there is one.
+    pub(crate) fn insert_scene_primitive(&mut self, primitive: impl Into<Primitive>) {
+        let scale = self.scale_factor();
+        // The flat transform painted now, for a mark's move (`TransformPivot`).
+        let pivot = self.transform_pivot.clone();
+        self.next_frame.with_scene_node(scale, |scene| {
+            scene.scroll.pivot = pivot;
+            scene.insert_primitive(primitive);
+            scene.scroll.pivot = None;
+        });
+    }
+
+    /// The pivot of the current transformation, when it is the matrix the
+    /// innermost `with_transform_pivot` builds: a transform painted under it
+    /// builds its own pivot on it.
+    pub fn current_transform_pivot(&self) -> Option<std::rc::Rc<crate::TransformPivot>> {
+        let current = self.current_transformation();
+        self.transform_pivot.clone().filter(|pivot| pivot.matrix() == current)
+    }
+
+    /// Run `f` painting under the flat transform `pivot` builds (its
+    /// `matrix()` the current transformation): primitives drawn through
+    /// that matrix keep its inputs, so a scrolled replay moves them as a
+    /// fresh paint there would build them.
+    pub fn with_transform_pivot<R>(&mut self, pivot: crate::TransformPivot, f: impl FnOnce(&mut Self) -> R) -> R {
+        let outer = self.transform_pivot.replace(std::rc::Rc::new(pivot));
+        let result = f(self);
+        self.transform_pivot = outer;
+        result
+    }
+
+    /// Run `f`, which copies a finished scene (a paint record) into the
+    /// frame's scene, with the open paint node as the node the copies land
+    /// under (`Scene::mark_copied`), as `with_scene_node` does for one
+    /// primitive: a record placed under a scroll node moves with it in a
+    /// scrolled replay instead of refusing it as unmarked paint.
+    pub(crate) fn with_copies_marked<R>(&mut self, f: impl FnOnce(&mut Self) -> R) -> R {
+        let scale = self.scale_factor();
+        let frame = &mut self.next_frame;
+        let open = frame.recorded_node();
+        let node = open.map(|index| {
+            let node = &frame.scroll_nodes[index as usize];
+            (node.id, node.clip.scale(scale))
+        });
+        frame.scene.scroll.open = node;
+        let result = f(self);
+        let frame = &mut self.next_frame;
+        frame.scene.scroll.open = None;
+        if std::mem::take(&mut frame.scene.scroll.lost) {
+            if let Some(index) = open {
+                frame.scroll_nodes[index as usize].torn = true;
+            }
+        }
+        if std::mem::take(&mut frame.scene.scroll.unpivoted) {
+            if let Some(index) = open {
+                frame.scroll_nodes[index as usize].unpivoted = true;
+            }
+        }
+        result
+    }
+
+    /// The mask a hitbox inserted now is hit-tested with, and its mark when
+    /// it lies under a prepaint node: own mask ∩ the node's clip.
+    pub(crate) fn scroll_hitbox_mask(
+        &self,
+        mask: ContentMask<Pixels>,
+    ) -> (ContentMask<Pixels>, Option<(ScrollNodeId, Bounds<Pixels>)>) {
+        match self.next_frame.scroll_node_stack.last() {
+            Some(&top) => {
+                let node = &self.next_frame.scroll_nodes[top as usize];
+                let real = ContentMask { bounds: mask.bounds.intersect(&node.clip) };
+                (real, Some((node.id, mask.bounds)))
+            }
+            None => (mask, None),
+        }
+    }
+
+    /// Paint something that depends on `handle`'s offset outside its node
+    /// other than by a translation (a follower node moves those): a
+    /// scrolled replay of a record holding it while that node moved needs a
+    /// build (`plan_scrolled_replay`).
+    pub fn paint_scroll_dependent(&mut self, handle: &ScrollHandle) {
+        let at = self.next_frame.scene.paint_operations.len();
+        let space = self.next_frame.scene.scroll.space;
+        self.next_frame.scroll_dependents.push((ScrollNodeId::of(handle), at, space));
+    }
+
+    /// Paint placed against the viewport inside the open paint nodes (a
+    /// `background-attachment: fixed` layer): it stays while they move, so a
+    /// scrolled replay of a record holding it while any of them moved needs a
+    /// build, as for `paint_scroll_dependent`.
+    pub fn paint_viewport_dependent(&mut self) {
+        let frame = &mut self.next_frame;
+        let (at, space) = (frame.scene.paint_operations.len(), frame.scene.scroll.space);
+        let nodes = &frame.scroll_nodes;
+        let open = frame.scroll_paint.open.iter().map(|&(index, _)| (nodes[index as usize].id, at, space));
+        frame.scroll_dependents.extend(open.collect::<Vec<_>>());
+    }
+
+    /// Whether a dependent painted in `scenes` of the rendered frame belongs
+    /// (in scene `space`) to a node `moved` says moved.
+    pub(crate) fn scroll_dependents_moved(&self, space: SceneSpace, scenes: &Range<usize>, moved: impl Fn(ScrollNodeId) -> bool) -> bool {
+        self.rendered_frame
+            .scroll_dependents
+            .iter()
+            .any(|&(id, at, of)| of == space && scenes.contains(&at) && moved(id))
+    }
+}
