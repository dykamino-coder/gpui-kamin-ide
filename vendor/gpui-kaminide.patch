-                    }
-                    "zed::main" => {
-                        strip = true;
-                        f.frame().backtrace_frame(frame)?;
-                    }
-                    _ => {}
-                }
-            }
-            if strip {
-                continue;
-            }
-            f.frame().backtrace_frame(frame)?;
-        }
