+            bounds: Bounds {
+                origin: Point::new(Pixels(x0.min(x1)), Pixels(y0.min(y1))),
+                size: Size {
+                    width: Pixels((x1 - x0).abs()),
+                    height: Pixels((y1 - y0).abs()),
