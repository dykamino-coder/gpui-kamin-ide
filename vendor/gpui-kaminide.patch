diff --git a/vendor/gpui/src/window/natural_image.rs b/vendor/gpui/src/window/natural_image.rs
new file mode 100644
index 0000000000000000000000000000000000000000..f12c7dea586cf161fe74767351718224e3cb909f
--- /dev/null
+++ b/vendor/gpui/src/window/natural_image.rs
@@ -0,0 +1,161 @@
+//! Opt-in natural raster painting preserves source phase on the CSS edge grid.
+
+use super::*;
+
+pub(super) type Cache =
+    std::collections::HashMap<(usize, usize, u32, u32, u64, u64, u64), Arc<RenderImage>>;
+
+impl Window {
+    /// Paint an unresized CSS raster with device-snapped destination edges and
+    /// nearest sampling in its original, unrounded source coordinate system.
+    pub fn paint_natural_image(
+        &mut self,
+        bounds: Bounds<Pixels>,
+        corners: Corners<Pixels>,
+        image: Arc<RenderImage>,
+        frame: usize,
+        grayscale: bool,
+    ) -> Result<()> {
+        if self.current_transformation() != TransformationMatrix::unit() {
+            return self.paint_image_with_sampling(
+                bounds,
+                corners,
+                image,
+                frame,
+                grayscale,
+                ImageSampling::Nearest,
+            );
+        }
+        let sf = self.scale_factor();
+        let physical = bounds.scale(sf);
+        let w = (physical.right().round() - physical.left().round())
+            .0
+            .max(0.0) as u32;
+        let h = (physical.bottom().round() - physical.top().round())
+            .0
+            .max(0.0) as u32;
+        let phase = |v: Pixels| {
+            let device = f64::from(f32::from(v)) * f64::from(sf);
+            device.round() - device
+        };
+        let data = resample(
+            &mut self.natural_images,
+            &image,
+            frame,
+            w,
+            h,
+            [phase(bounds.left()), phase(bounds.top())],
+            f64::from(sf),
+        );
+        let (image, frame) = match data {
+            Some(image) => (image, 0),
+            None => (image, frame),
+        };
+        self.paint_image_with_sampling_tile(
+            bounds,
+            corners,
+            image,
+            frame,
+            grayscale,
+            ImageSampling::NearestSnapped,
+        )?;
+        Ok(())
+    }
+}
+
+#[allow(clippy::too_many_arguments)]
+fn resample(
+    cache: &mut Cache,
+    image: &Arc<RenderImage>,
+    frame: usize,
+    w: u32,
+    h: u32,
+    phase: [f64; 2],
+    scale: f64,
+) -> Option<Arc<RenderImage>> {
+    let source = image.size(frame);
+    let (iw, ih) = (
+        u32::try_from(source.width.0).ok()?,
+        u32::try_from(source.height.0).ok()?,
+    );
+    if iw == 0
+        || ih == 0
+        || w == 0
+        || h == 0
+        || w > 4096
+        || h > 4096
+        || scale <= 0.0
+        || (scale == 1.0 && phase == [0.0; 2])
+    {
+        return None;
+    }
+    let key = (
+        image.id.0,
+        frame,
+        w,
+        h,
+        phase[0].to_bits(),
+        phase[1].to_bits(),
+        scale.to_bits(),
+    );
+    if let Some(found) = cache.get(&key) {
+        return Some(found.clone());
+    }
+    let bytes = image.upload_bytes(frame)?;
+    let mut out = Vec::with_capacity((w * h * 4) as usize);
+    for y in 0..h {
+        let sy = sample(y, ih, phase[1], scale);
+        for x in 0..w {
+            let sx = sample(x, iw, phase[0], scale);
+            let at = ((sy * iw + sx) * 4) as usize;
+            out.extend_from_slice(&bytes[at..at + 4]);
+        }
+    }
+    let result = crate::bgra_bytes_to_image(w, h, out)?;
+    if cache.len() >= 32 {
+        cache.clear();
+    }
+    cache.insert(key, result.clone());
+    Some(result)
+}
+
+fn sample(pixel: u32, source: u32, phase: f64, scale: f64) -> u32 {
+    // CSS Images 3 §5.2 permits nearest sampling. Choosing the preceding
+    // texel on an exact boundary rounds the painted edge upward, like CSS
+    // boxes. Keep source phase after snapping destination edges (Blink
+    // background_image_geometry.cc:114-122), so fractional placement never
+    // stretches or independently shifts the internal texel grid.
+    (((f64::from(pixel) + 0.5 + phase) / scale).ceil() - 1.0).clamp(0.0, f64::from(source - 1))
+        as u32
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn natural_cache_eviction_releases_cpu_images() {
+        let image = crate::bgra_bytes_to_image(2, 2, vec![255; 16]).unwrap();
+        let mut cache = Cache::default();
+        let mut expired = Vec::new();
+        for width in 3..=35 {
+            let entry = resample(&mut cache, &image, 0, width, 3, [0.; 2], 1.25).unwrap();
+            expired.push(Arc::downgrade(&entry));
+        }
+        assert_eq!(cache.len(), 1);
+        assert!(expired[..32].iter().all(|image| image.upgrade().is_none()));
+        assert!(expired[32].upgrade().is_some());
+        cache.clear();
+        assert!(expired[32].upgrade().is_none());
+    }
+
+    #[test]
+    fn separate_windows_have_independent_resampled_images() {
+        let image = crate::bgra_bytes_to_image(2, 2, vec![255; 16]).unwrap();
+        let (mut ac, mut bc) = (Cache::default(), Cache::default());
+        let aa = resample(&mut ac, &image, 0, 3, 3, [0.; 2], 1.25).unwrap();
+        let bb = resample(&mut bc, &image, 0, 3, 3, [0.; 2], 1.25).unwrap();
+        assert_ne!(aa.id, bb.id);
+        assert_eq!(aa.as_bytes(0), bb.as_bytes(0));
+    }
+}
diff --git a/vendor/gpui/src/window/paint_contract.md b/vendor/gpui/src/window/paint_contract.md
new file mode 100644
index 0000000000000000000000000000000000000000..6a1794918b3be567d1fad54d7a61bb095b07e8e4
--- /dev/null
+++ b/vendor/gpui/src/window/paint_contract.md
@@ -0,0 +1,128 @@
+
+## Граница механизма и политики хозяина
+
+GPUI исполняет упорядоченные команды рисования в заданном состоянии окна.
+Хозяин определяет семантический порядок, атомарные поддеревья и нужные эффекты.
+Группа композиции — область вывода в отдельную сцену, а не семантический
+контекст хозяина. В частности, правила CSS stacking, выбор подложки текста
+и fill policy принадлежат HTML-движку.
+
+### Обязательства вызывающего и сохранение поведения
+
+- Layout и prepaint ребёнка исполняются ровно один раз на проход. Отложить
+  paint не означает повторить измерения, регистрацию hit-test или эффекты.
+  Identity hit-test, scroll/selection и порядок регистрации остаются частью
+  контракта хозяина и сверяются с окончательным paint order отдельно.
+- Отложенный ребёнок и снимок живут только в текущем проходе paint. Нельзя
+  хранить `AnyElement` между кадрами или документами.
+- Порядок исполнения задаёт хозяин. Replay сохраняет порядок команд,
+  дробные координаты и существующую растровую привязку без нового округления.
+- Задание должно завершиться внутри своей открытой композиционной группы:
+  его нельзя вынести за границу opacity, blend, clip, mask или offscreen.
+  Произвольный Element — непрозрачная граница; прозрачный адаптер явно
+  разрешает перенос ребёнка, сохраняя его окружение и область композиции.
+- Typed host contexts принадлежат окну, не глобальному потоку. Снимок
+  удерживает тот же `Rc<T>`; значения внутри него не копируются глубоко.
+  Отсутствующий тип скрывает одноимённый контекст вызывающего на время replay.
+
+### Снимки и проверяемый replay
+
+`paint_ctx` сохраняет element/entity ids, text style, typed host contexts,
+element offsets и глубину exact offsets, transformation stack, mask scale/map,
+opacity, content masks и image caches. `raster_paint_ctx` дополнительно сохраняет
+весь `RasterFrame`: glyph offset, actual/exact fill transforms, rounded/exact
+bounds и непрозрачные typed host raster data. Обычный `PaintCtx` этих полей
+не содержит; общий replay наследует frame вызывающего. `RasterPaintCtx` позволяет
+вызывающему явно выбрать fill transform перед replay.
+
+`snapshot_paint_state` сохраняет все эти поля, включая generic `RasterFrame`,
+точную fill matrix, device scale и стек rem overrides. `with_raster_frame` принимает явные placement
+и unsnapped fill transforms, не выбирая подложку или CSS policy. Существующий
+общий consumer наследует raster state вызывающего; inline consumer сохраняет
+прежний набор glyph/background полей и наследует fill transform. Все три пути
+исполняются одним механизмом replay и не меняют layout/prepaint или paint order.
+
+`with_raster_context` временно заменяет только один типизированный слот этого
+же frame и восстанавливает его через общий guard, включая unwind. Остальные
+host values и raster-геометрия сохраняются без клонирования всей карты.
+`ChildPaintContext` заимствуется только на время callback; хозяин завершает
+выбор геометрии перед рекурсивным рисованием детей.
+
+Replay проверяет identity окна, прохода и живой композиционной области до
+изменения состояния и вызова closure. `PaintError` различает чужое окно/проход,
+завершённый проход, другую открытую и уже закрытую группу; fallback нет.
+`PaintPassId` и `PaintScopeId` не продлевают жизнь области при клонировании.
+Prepaint и paint одного draw разделяют pass; изолированные effect/plane/capture
+сцены имеют собственные scope. Transform/clip сохраняются в снимке, поэтому
+их лексическое закрытие само по себе не запрещает отложенный replay.
+
+Guards восстанавливают caller environment, typed contexts и raster state также
+при unwind; scopes геометрии и scene swaps используют тот же Drop-механизм.
+Unwind помечает проход недействительным: продолжать частично нарисованный кадр
+нельзя. Внешний draw при abort очищает незавершённый frame и возвращает внешнее
+окружение. HTML coordinator владеет очередями прохода и освобождает их через Drop,
+в том числе при пойманном unwind. Глобального reset нет.
+
+### Capture и instrumentation
+
+`Window::set_frame_capture` передаёт backend единственный `FrameCaptureSink`
+этого окна без клонирования. Backend доставляет завершённые BGRA pixels и
+длительность readback. Хозяин владеет сессией, sequence, подписками и выбором
+first/latest; endpoint не смешивает кадры разных окон. Замена или уничтожение
+endpoint закрывает сессию и завершает ожидающие подписки. Readiness и выбор
+результата принадлежат WPT, а не renderer. Production offscreen scene остаётся
+общим механизмом GPUI/backend и не зависит от подписок на оконные кадры.
+
+`Application::with_instrumentation` принимает типизированные настройки хозяина
+до запуска платформы. Измерения prepaint и GPU принадлежат приложению и явно
+передаются backend, включая пересоздание устройства. Toolkit не разбирает
+диагностические переменные окружения.
+
+### Инварианты scoped API
+
+- frame-local pass token идентифицирует окно и кадр; scope token дополнительно
+  идентифицирует открытую композиционную область, включая offscreen capture;
+- snapshot включает всё окружение рисования, generic raster frame, typed host
+  contexts и entity/id environment; raster frame хранит исходную дробную
+  геометрию и device grid, а не решение хозяина о подложке текста;
+- replay принимает только token того же окна, кадра и открытой группы;
+  несовпадение возвращает типизированную ошибку без fallback на прямой paint;
+- clip/transform/effect scopes исполняются в порядке вызова, не пересортировывают
+  jobs и не пропускают отложенную работу через свою границу;
+- guards восстанавливают полное внешнее состояние при unwind. Abort уничтожает
+  текущий проход, освобождает jobs и не загрязняет следующий документ/кадр;
+- очередь jobs принадлежит хозяину; стабильная ограниченная сортировка и
+  однократное исполнение не требуют знания CSS внутри GPUI. Нельзя вводить
+  повторный minimum scan или бесконечный drain при добавлении новых jobs.
+
+Проверки HTML фиксируют порядок текущих consumers, nested scopes, identity
+contexts, raster origin, отклонение неверного replay и восстановление после abort.
+CSS очередь живёт в HTML coordinator, который задаёт порядок child visitor
+внутри прежних scopes GPUI. Opaque boundary guard и метаданные прозрачных
+holders являются общими hooks; GPUI их не интерпретирует. Text-background
+и fill policy принадлежат HTML. GPUI передаёт host callback геометрию и
+непрозрачные метаданные без интерпретации; snapshot не принимает решений хозяина.
+
+### Immutable command records
+
+`Window::record_paint(source_clip, cx, paint)` consumes source painting once.
+The explicit source clip replaces the ambient fragment clip before culling.
+An optional host `PaintRecording` lifecycle opens and finishes its own deferred
+work inside capture; guard destruction restores or aborts host state.
+No element or callback is retained by `PaintRecord` or `PaintPlan`.
+
+A record shares immutable canonical Scene commands and frame-local resources.
+It outlives its capture scope, but only in the same live window/draw and raster
+scale. This does not relax snapshot checks: PaintState/PaintCtx still require
+their original live composition scope. Stale identity or invalid placement is
+a typed error before destination writes.
+
+The host composes ordered records and explicit Clip/Group descriptors, including
+shared effect ancestors. GPUI does not choose CSS order, source identity,
+fragment scheduling, layout generation or hit geometry. Plan playback accepts
+no App and invokes no element/host callback. Each invocation adopts fresh group
+ids through the existing compositor. Source transforms/raster positions remain
+resolved; an explicit source-to-destination translation moves commands once.
+The final destination clip follows effects, preserving off-clip filter inputs.
+Pending plane contexts, raster state and host contexts are restored on return
+or unwind; an abort invalidates the draw rather than granting replay rights.
diff --git a/vendor/gpui/src/window/paint_record/invocation.rs b/vendor/gpui/src/window/paint_record/invocation.rs
new file mode 100644
index 0000000000000000000000000000000000000000..086264246f9da359379c9ffb095d5d221132114a
--- /dev/null
+++ b/vendor/gpui/src/window/paint_record/invocation.rs
@@ -0,0 +1,128 @@
+//! Запись один раз и атомарный вызов плана в свежей композиционной области.
+
+use super::*;
+
+impl Window {
+    /// Consume source paint once, replacing the ambient fragment clip explicitly.
+    /// Layout/prepaint/event registration remain the caller's one-time work.
+    pub fn record_paint<R>(
+        &mut self,
+        source_clip: Bounds<Pixels>,
+        cx: &mut App,
+        paint: impl FnOnce(&mut Self, &mut App) -> R,
+    ) -> Result<(R, PaintRecord), PaintRecordError> {
+        let _recording = self.render_contexts.enter::<segments::Recording>(None);
+        let (result, scene, identity, scale) = self.capture_paint_commands(source_clip, cx, paint)?;
+        Ok((result, PaintRecord(Rc::new(Recorded { identity, scale, clip: source_clip, scene }))))
+    }
+
+    pub(super) fn capture_paint_commands<R>(
+        &mut self,
+        source_clip: Bounds<Pixels>,
+        cx: &mut App,
+        paint: impl FnOnce(&mut Self, &mut App) -> R,
+    ) -> Result<(R, Scene, paint_scope::Identity, f32), PaintRecordError> {
+        let identity = paint_scope::Identity::capture(self);
+        identity.check_pass(self)?;
+        if !validation::scaled_bounds_valid(source_clip, self.scale_factor()) || !self.scale_factor().is_finite()
+            || self.scale_factor() <= 0.0 {
+            return Err(PaintRecordError::InvalidGeometry);
+        }
+        if self.invalidator.inner.borrow().draw_phase != DrawPhase::Paint {
+            return Err(PaintRecordError::NotPainting);
+        }
+        let scale = self.scale_factor();
+        let (result, mut scene) = self.record_scene(source_clip, false, |window| {
+            let recording = window.render_context::<crate::PaintTraversal>()
+                .and_then(|traversal| traversal.recording.clone());
+            let mut guard = recording.as_ref().map(|recording| (recording.begin)(window));
+            let result = paint(window, cx);
+            if let (Some(recording), Some(guard)) = (recording, guard.as_mut()) {
+                (recording.finish)(guard.as_mut(), window, cx);
+            }
+            result
+        });
+        identity.check_pass(self)?;
+        scene.finish_frozen();
+        Ok((result, scene, identity, scale))
+    }
+
+    /// Invoke immutable commands under new scopes, without any element callback.
+    /// The returned closed scope identifies this invocation; it grants no replay right.
+    pub fn paint_plan(
+        &mut self,
+        plan: &PaintPlan,
+        placement: PaintPlacement,
+    ) -> Result<PaintScopeId, PaintRecordError> {
+        let presentation = self.paint_presentation();
+        let extent = plan.validate(self, presentation)?;
+        paint_scope::Identity::capture(self).check_pass(self)?;
+        if self.invalidator.inner.borrow().draw_phase != DrawPhase::Paint {
+            return Err(PaintRecordError::NotPainting);
+        }
+        let delta = placement.destination - placement.source;
+        let scaled = delta.scale(self.scale_factor());
+        if !validation::point_valid(placement.source)
+            || !validation::point_valid(placement.destination)
+            || !validation::point_valid(delta) || !validation::scaled_bounds_valid(placement.clip, self.scale_factor())
+            || !validation::scaled_bounds_valid(Bounds::new(extent.origin + delta, extent.size), self.scale_factor())
+            || !scaled.x.0.is_finite() || !scaled.y.0.is_finite() {
+            return Err(PaintRecordError::InvalidGeometry);
+        }
+        let clip = placement.clip.intersect(&self.content_mask().bounds).scale(self.scale_factor());
+        let (invocation, scene) = {
+            // Неизменяемый план — один лист сегментного обхода;
+            // его собственные эффекты разрешены до привязки к сегментам.
+            let _recording = self.render_contexts.enter::<segments::Recording>(None);
+            self.record_scene(extent, true, |window| {
+                window.begin_record_runs();
+                let id = window.paint_scope_id();
+                plan.paint(window, presentation);
+                id
+            })
+        };
+        // No destination writes occur until the complete invocation has succeeded.
+        paint_scope::Identity::capture(self).check_pass(self)?;
+        let mut scene = scene;
+        scene.end_record_runs();
+        // A copy under a scroll node is marked under it (`with_copies_marked`).
+        self.with_copies_marked(|window| {
+            if !window.replay_placed_landing(&scene, scaled, Some(clip)) {
+                // A record with groups: their runs follow the copy (`placed_groups`).
+                window.place_record_copy(&scene, scaled, clip);
+            }
+        });
+        Ok(invocation)
+    }
+
+    fn record_scene<R>(
+        &mut self,
+        clip: Bounds<Pixels>,
+        explicit_coordinates: bool,
+        paint: impl FnOnce(&mut Self) -> R,
+    ) -> (R, Scene) {
+        let state = Box::new(self.snapshot_paint_state());
+        let contexts = self.render_contexts.snapshot();
+        let _contexts = self.render_contexts.enter_snapshot(contexts);
+        let planes = mem::take(&mut self.plane_contexts);
+        self.with_restore((state, planes), |window, state| {
+            state.0.restore(window);
+            mem::swap(&mut window.plane_contexts, &mut state.1);
+        }, |window| {
+            // Source/destination clips are already in explicit window coordinates.
+            window.content_mask_stack = vec![ContentMask { bounds: clip }];
+            if explicit_coordinates {
+                window.transformation_stack.clear();
+                window.mask_map = None;
+                window.mask_scale = None;
+                window.element_opacity = 1.0;
+            }
+            window.with_isolated_scene(|window| {
+                // Its copy is marked where it lands (`ScrollBook::record_base`).
+                let base = window.next_frame.scroll_paint.open.len();
+                window.next_frame.scene.scroll.record_base = Some(base);
+                paint(window)
+            })
+        }).0
+    }
+}
diff --git a/vendor/gpui/src/window/paint_record/landing.rs b/vendor/gpui/src/window/paint_record/landing.rs
new file mode 100644
index 0000000000000000000000000000000000000000..64c4377e1ea502ef0b4aeab5ce8d4c0f55101850
--- /dev/null
+++ b/vendor/gpui/src/window/paint_record/landing.rs
@@ -0,0 +1,72 @@
+//! KaminIDE patch: a paint record lands with the scroll nodes it painted.
+//!
+//! A node opened while a record records has its ranges in the record's
+//! scene (`Window::begin_scroll_node_paint`), a scene the frame never draws.
+//! When the record lands where it was recorded (no offset), its copy keeps
+//! those nodes' marks (`scene::scroll_marks::carry`) and the nodes take
+//! their ranges in the scene it lands in, so a scrolled replay of the frame
+//! moves them as the nodes the frame painted itself. Landed elsewhere, or
+//! with a command of their ranges dropped by the copy, they stay in the
+//! record's scene (torn): a scrolled replay then builds, as before.
+
+use super::*;
+use crate::scene::scroll_marks::{SceneSpace, carry::Carry};
+
+impl Window {
+    /// `replay_placed_carrying` of the record `scene`, landing the nodes it
+    /// painted when it lands where it was recorded.
+    pub(super) fn replay_placed_landing(
+        &mut self,
+        scene: &Scene,
+        offset: Point<ScaledPixels>,
+        clip: Option<Bounds<ScaledPixels>>,
+    ) -> bool {
+        let from = scene.scroll.space;
+        let painted = self.next_frame.scroll_nodes.iter().any(|node| node.painted_in == Some(from));
+        let carry = painted && offset == Point::default();
+        if carry {
+            self.next_frame.scene.scroll.carry = Some(Carry::of(scene));
+        }
+        let done = self.replay_placed_carrying(scene, offset, clip);
+        let carry = self.next_frame.scene.scroll.carry.take();
+        let landed = carry.as_ref().is_some_and(|carry| done && carry.landed.len() == scene.paint_operations.len());
+        if painted && crate::dirty_sources::trace::enabled() && !landed {
+            // DevTools `why`: the nodes stay in the record's scene, and the frame builds.
+            let why = if offset != Point::default() {
+                format!("lands moved by {offset:?}")
+            } else if !done {
+                format!("copied, not placed ({} groups)", scene.groups.len())
+            } else {
+                "placed per primitive".to_string()
+            };
+            crate::dirty_sources::trace::push_with("scroll_node.record_unlanded", core::panic::Location::caller(), || why);
+        }
+        if let Some(carry) = carry.filter(|_| landed) {
+            self.land_carried_nodes(from, &carry);
+        }
+        done
+    }
+
+    /// Move the ranges of the nodes painted in scene `from` to where
+    /// `carry` says its commands landed in the scene painted now.
+    fn land_carried_nodes(&mut self, from: SceneSpace, carry: &Carry) {
+        let frame = &mut self.next_frame;
+        let here = frame.scene.scroll.space;
+        for node in frame.scroll_nodes.iter_mut().filter(|node| node.painted_in == Some(from)) {
+            let paint = node.paint.as_ref().map(|range| carry.range(range));
+            let more: Option<Vec<_>> = node.more.iter().map(|range| carry.range(range)).collect();
+            match (paint, more) {
+                (Some(Some(paint)), Some(more)) => {
+                    (node.paint, node.more, node.painted_in) = (Some(paint), more, Some(here));
+                }
+                _ => node.torn = true,
+            }
+        }
+        // A dependent lands before the next command the copy kept.
+        for dependent in frame.scroll_dependents.iter_mut().filter(|dependent| dependent.2 == from) {
+            if let Some(at) = carry.range(&(dependent.1..dependent.1)) {
+                (dependent.1, dependent.2) = (at.start, here);
+            }
+        }
+    }
+}
diff --git a/vendor/gpui/src/window/paint_record/mod.rs b/vendor/gpui/src/window/paint_record/mod.rs
new file mode 100644
index 0000000000000000000000000000000000000000..6d1530a5a660a6617cb11d7e983d8798bccf318d
--- /dev/null
+++ b/vendor/gpui/src/window/paint_record/mod.rs
@@ -0,0 +1,77 @@
+//! Неизменяемые команды одного draw и явное размещение в другом paint scope.
+
+use super::*;
+mod invocation;
+mod landing;
+mod plan;
+mod validation;
+#[cfg(test)]
+mod scroll_tests;
+pub(super) mod segments;
+pub use plan::{PaintGroupDescriptor, PaintPlan, PaintScopeDescriptor};
+pub use segments::{PaintSegment, PaintSegmentId, PaintSegmentRecords, PaintSegmentClips, PaintSegmentSlice};
+
+/// Immutable drawing commands. Clones share commands and retained resources.
+/// Capture scope may close; the original window, draw and raster scale must live.
+#[derive(Clone)]
+pub struct PaintRecord(Rc<Recorded>);
+
+struct Recorded {
+    identity: paint_scope::Identity,
+    scale: f32,
+    clip: Bounds<Pixels>,
+    scene: Scene,
+}
+
+/// Explicit source-to-destination translation and final destination-space clip.
+/// Captured transforms are already resolved; caller transforms are not reapplied.
+#[derive(Clone, Copy, Debug)]
+pub struct PaintPlacement {
+    /// Anchor in the recorded source coordinate system.
+    pub source: Point<Pixels>,
+    /// Destination of the source anchor, in the target window coordinate system.
+    pub destination: Point<Pixels>,
+    /// Clip after the complete plan's effects, in destination coordinates.
+    pub clip: Bounds<Pixels>,
+}
+
+/// A rejected record or placement never changes the destination scene.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, thiserror::Error)]
+pub enum PaintRecordError {
+    /// Commands can only be captured or invoked during paint.
+    #[error("paint record operation is outside the paint phase")]
+    NotPainting,
+    /// Record resources belong to another or completed window draw.
+    #[error(transparent)]
+    Identity(#[from] PaintError),
+    /// Rasterized resources cannot be reinterpreted at another device scale.
+    #[error("paint record raster scale differs from the destination")]
+    ScaleMismatch,
+    /// Geometry contains nonfinite coordinates, sizes or effect parameters.
+    #[error("paint record geometry is invalid")]
+    InvalidGeometry,
+    /// Выбран необъявленный сегмент либо сегментная запись не активна.
+    #[error("paint segment is outside the active recording boundary")]
+    InvalidSegment,
+}
+
+impl PaintRecord {
+    /// Whether two handles share the same immutable command storage.
+    pub fn same_record(&self, other: &Self) -> bool { Rc::ptr_eq(&self.0, &other.0) }
+
+    /// Inspect frozen commands in renderer contract tests without mutating them.
+    #[cfg(any(test, feature = "test-support"))]
+    pub fn scene(&self) -> &Scene { &self.0.scene }
+
+    /// Проверка сохранённых подложек до включения их команд в кадр.
+    #[cfg(any(test, feature = "test-support"))]
+    pub fn hoisted_backdrops(&self) -> &[crate::PaintSurface] { &self.0.scene.hoisted_backdrops }
+
+    fn check(&self, window: &Window) -> Result<(), PaintRecordError> {
+        self.0.identity.check_pass(window)?;
+        if self.0.scale != window.scale_factor() {
+            return Err(PaintRecordError::ScaleMismatch);
+        }
+        Ok(())
+    }
+}
diff --git a/vendor/gpui/src/window/paint_record/plan.rs b/vendor/gpui/src/window/paint_record/plan.rs
new file mode 100644
index 0000000000000000000000000000000000000000..68de8dfc5fbfee7059ad21425eb5943f64059ae2
--- /dev/null
+++ b/vendor/gpui/src/window/paint_record/plan.rs
@@ -0,0 +1,192 @@
+//! Плоское неизменяемое дерево команд и переоткрываемых механических scopes.
+
+use super::*;
+use crate::window::vector_transform::{present, presented_bounds};
+
+/// Inputs to the existing group compositor, in source coordinates.
+/// The host chooses effect policy and which records share one group.
+#[derive(Clone)]
+pub struct PaintGroupDescriptor {
+    /// Complete output bounds of the group.
+    pub bounds: Bounds<Pixels>,
+    /// Rounded composite corners.
+    pub corner_radii: Corners<Pixels>,
+    /// Blur radius in logical pixels.
+    pub blur_radius: f32,
+    /// Opacity applied once to the complete group.
+    pub opacity: f32,
+    /// Renderer blend operation, as accepted by Window::paint_group.
+    pub blend: u32,
+    /// Composite coverage polygon; empty means the group's rectangle.
+    pub polygon: Vec<Point<Pixels>>,
+    /// Invert polygon coverage.
+    pub polygon_inverse: bool,
+    /// Retained image, source-space tile bounds and repeat restriction bits.
+    pub mask: Option<(Arc<RenderImage>, Bounds<Pixels>, u32)>,
+    /// Device-space mask clip at the record's raster scale.
+    pub mask_clip: Option<[f32; 4]>,
+    /// Device-space projective map retained from a source ancestor plane.
+    pub projection: Option<[f32; 9]>,
+    /// Source-space BSP coverage pieces, in dependency order.
+    pub fragments: Vec<Vec<Point<Pixels>>>,
+}
+
+impl Default for PaintGroupDescriptor {
+    fn default() -> Self {
+        Self {
+            bounds: Bounds::default(), corner_radii: Corners::default(),
+            blur_radius: 0.0, opacity: 1.0, blend: 0, polygon: Vec::new(),
+            polygon_inverse: false, mask: None, mask_clip: None, projection: None, fragments: Vec::new(),
+        }
+    }
+}
+
+/// A mechanical source-space ancestor scope, without CSS classification.
+#[derive(Clone)]
+pub enum PaintScopeDescriptor {
+    /// Intersect subsequent output with a source-space rectangular clip.
+    Clip(Bounds<Pixels>),
+    /// Composite all nested records as one group using the existing backend.
+    Group(PaintGroupDescriptor),
+}
+
+/// Ordered immutable drawing plan. Construction retains no element callbacks.
+/// A flat balanced stream avoids recursive ownership and recursive destruction.
+#[derive(Clone, Default)]
+pub struct PaintPlan(Rc<[Command]>);
+
+#[derive(Clone)]
+enum Command {
+    Record(PaintRecord),
+    Begin(Box<PaintScopeDescriptor>),
+    End,
+}
+
+impl PaintPlan {
+    /// One shared immutable record.
+    pub fn record(record: PaintRecord) -> Self {
+        Self(Rc::from([Command::Record(record)]))
+    }
+
+    /// Concatenate plans without reordering or deduplicating their records.
+    pub fn sequence(plans: impl IntoIterator<Item = Self>) -> Self {
+        Self(plans.into_iter().flat_map(|plan| plan.0.to_vec()).collect())
+    }
+
+    /// Wrap a whole plan in one ancestor scope, shared by all nested records.
+    pub fn scope(descriptor: PaintScopeDescriptor, children: Self) -> Self {
+        let mut commands = Vec::with_capacity(children.0.len() + 2);
+        commands.push(Command::Begin(Box::new(descriptor)));
+        commands.extend_from_slice(&children.0);
+        commands.push(Command::End);
+        Self(commands.into())
+    }
+
+    pub(super) fn validate(
+        &self, window: &Window, presentation: Option<TransformationMatrix>,
+    ) -> Result<Bounds<Pixels>, PaintRecordError> {
+        if !window.scale_factor().is_finite() || window.scale_factor() <= 0.0 {
+            return Err(PaintRecordError::InvalidGeometry);
+        }
+        let mut extent: Option<Bounds<Pixels>> = None;
+        for command in self.0.iter() {
+            let bounds = match command {
+                Command::Record(record) => {
+                    record.check(window)?;
+                    match presentation {
+                        Some(matrix) => presented_bounds(matrix, record.0.clip, window.scale_factor()),
+                        None => record.0.clip,
+                    }
+                }
+                // Host scopes are source-space descriptors; a presentation scope
+                // transforms frozen records only.
+                Command::Begin(_) if presentation.is_some() => return Err(PaintRecordError::InvalidGeometry),
+                Command::Begin(descriptor) => descriptor.validate(window.scale_factor())?,
+                Command::End => continue,
+            };
+            extent = Some(extent.map_or(bounds, |extent| extent.union(&bounds)));
+        }
+        let extent = extent.unwrap_or_default();
+        if !validation::scaled_bounds_valid(extent, window.scale_factor()) {
+            return Err(PaintRecordError::InvalidGeometry);
+        }
+        Ok(extent)
+    }
+
+    pub(super) fn paint(&self, window: &mut Window, presentation: Option<TransformationMatrix>) {
+        enum Frame<'a> {
+            Clip,
+            Group(Box<Scene>, Vec<ContentMask<Pixels>>, &'a PaintGroupDescriptor),
+        }
+        let input_mask = window.content_mask();
+        let mut frames = Vec::new();
+        for command in self.0.iter() {
+            match command {
+                Command::Record(record) => {
+                    let mask = window.content_mask().scale(window.scale_factor());
+                    // A copy under a scroll node is marked under it (`with_copies_marked`).
+                    if presentation.is_none()
+                        && window.with_copies_marked(|window| {
+                            window.replay_placed_landing(&record.0.scene, Point::default(), Some(mask.bounds))
+                        })
+                    {
+                        continue;
+                    }
+                    let Some(matrix) = presentation else {
+                        // Its groups' runs follow the copy (`placed_groups`).
+                        window.with_copies_marked(|window| {
+                            window.place_record_copy(&record.0.scene, Point::default(), mask.bounds)
+                        });
+                        continue;
+                    };
+                    let scene = present(record.0.scene.copy_record(Point::default(), None), matrix)
+                        .copy_record(Point::default(), Some(mask.bounds));
+                    let scene = window.adopt_scene(scene);
+                    window.with_copies_marked(|window| window.next_frame.scene.replay_record(&scene));
+                }
+                Command::Begin(descriptor) => match descriptor.as_ref() {
+                    PaintScopeDescriptor::Clip(bounds) => {
+                        let mask = ContentMask { bounds: window.content_mask().bounds.intersect(bounds) };
+                        window.content_mask_stack.push(mask);
+                        frames.push(Frame::Clip);
+                    }
+                    PaintScopeDescriptor::Group(group) => {
+                        let mut inner = Scene::default();
+                        inner.inherit_segments(&window.next_frame.scene);
+                        inner.in_group = true;
+                        // Ancestor clips apply to the group output, not its filter input.
+                        let masks = mem::replace(&mut window.content_mask_stack, vec![input_mask]);
+                        frames.push(Frame::Group(Box::new(mem::replace(&mut window.next_frame.scene, inner)), masks, group));
+                    }
+                },
+                Command::End => match frames.pop() {
+                    Some(Frame::Clip) => { window.content_mask_stack.pop(); }
+                    Some(Frame::Group(mut outer, masks, group)) => {
+                        mem::swap(&mut window.next_frame.scene, &mut outer);
+                        window.content_mask_stack = masks;
+                        group.composite(window, *outer);
+                    }
+                    None => unreachable!("balanced private paint plan"),
+                },
+            }
+        }
+    }
+}
+
+impl PaintGroupDescriptor {
+    fn composite(&self, window: &mut Window, scene: Scene) {
+        window.paint_group(
+            self.bounds, self.corner_radii, self.blur_radius, self.opacity,
+            self.blend, &self.polygon, self.mask.clone(), self.mask_clip,
+            |window| window.next_frame.scene = scene,
+        );
+        let scale = window.scale_factor();
+        if let Some(last) = window.next_frame.scene.groups.last_mut() {
+            last.polygon_inverse = self.polygon_inverse;
+            last.projection = self.projection;
+            last.fragments = self.fragments.iter().map(|fragment| {
+                fragment.iter().map(|point| point.scale(scale)).collect()
+            }).collect();
+        }
+    }
+}
diff --git a/vendor/gpui/src/window/paint_record/scroll_tests.rs b/vendor/gpui/src/window/paint_record/scroll_tests.rs
new file mode 100644
index 0000000000000000000000000000000000000000..a983716bff1961a4703d5a919dc7f1e495dc0ef1
--- /dev/null
+++ b/vendor/gpui/src/window/paint_record/scroll_tests.rs
@@ -0,0 +1,173 @@
+//! A paint record that lands under a scroll node replays scrolled: what it
+//! records under the node open before it began stays unmarked and is never
+//! made dormant there (`ScrollBook::record_base`), and its copy is marked
+//! under the node where it lands (`Window::with_copies_marked`).
+
+use super::segments::{PaintSegment, PaintSegmentId};
+use super::*;
+use crate::scene::{PaintOperation, Primitive};
+use crate::{Context, IntoElement, Quad, Render, ScrollHandle, ScrollNodeId, TestAppContext, div};
+
+struct Empty;
+impl Render for Empty {
+    fn render(&mut self, _: &mut Window, _: &mut Context<Self>) -> impl IntoElement {
+        div()
+    }
+}
+
+fn rect(x: f32, y: f32, w: f32, h: f32) -> Bounds<Pixels> {
+    Bounds::new(point(px(x), px(y)), size(px(w), px(h)))
+}
+
+/// The placed quads of the next frame's scene, drawn ones only.
+fn quads(window: &Window) -> Vec<Bounds<ScaledPixels>> {
+    let scene = &window.next_frame.scene;
+    scene
+        .paint_operations
+        .iter()
+        .filter_map(|op| match op {
+            PaintOperation::Primitive(p @ Primitive::Quad(_)) => {
+                Some(crate::scene::placed_bounds(p))
+            }
+            _ => None,
+        })
+        .collect()
+}
+
+#[crate::test]
+fn a_record_hidden_below_the_node_clip_replays_into_view(cx: &mut TestAppContext) {
+    cx.add_window(|_, _| Empty)
+        .update(cx, |_, window, cx| {
+            window.scroll_interest_margin = px(100.);
+            let handle = ScrollHandle::new();
+            handle.set_max_offset(point(px(0.), px(10_000.)));
+            let id = ScrollNodeId::of(&handle);
+            window.invalidator.set_phase(DrawPhase::Prepaint);
+            let (_, prepaint) = window.record_retained_prepaint(|window| {
+                window.with_scroll_node_prepaint(&handle, rect(0., 0., 100., 50.), |_| {});
+            });
+            window.invalidator.set_phase(DrawPhase::Paint);
+            // A record belongs to a live paint pass (`paint_scope::Identity`).
+            let (_, paint) = window.with_paint_pass(|window| {
+                window.record_retained_paint(|window| {
+                    window.with_scroll_node_paint(id, |window| {
+                        let extent = rect(0., 0., 100., 120.);
+                        // Inside the node's interest rect, below its clip: hidden now.
+                        // One segment of a recorded flow (a column), frozen out of
+                        // the record's scene (`Scene::freeze_segment`).
+                        let segment = PaintSegment {
+                            id: PaintSegmentId(1),
+                            ordinal: 0,
+                            source: point(px(0.), px(0.)),
+                            destination: point(px(0.), px(0.)),
+                        };
+                        let (_, records) = window
+                            .record_paint_segments(
+                                extent,
+                                std::rc::Rc::from([segment]),
+                                cx,
+                                |window, _| {
+                                    let scale = window.scale_factor();
+                                    window.insert_scene_primitive(Quad {
+                                        bounds: rect(10., 80., 10., 10.).scale(scale),
+                                        content_mask: window.content_mask().scale(scale),
+                                        ..Default::default()
+                                    });
+                                },
+                            )
+                            .unwrap();
+                        let record = records.get(PaintSegmentId(1)).unwrap().clone();
+                        let placement = PaintPlacement {
+                            source: point(px(0.), px(0.)),
+                            destination: point(px(0.), px(0.)),
+                            clip: extent,
+                        };
+                        window
+                            .paint_plan(&PaintPlan::record(record), placement)
+                            .unwrap();
+                    });
+                })
+            });
+            std::mem::swap(&mut window.rendered_frame, &mut window.next_frame);
+            window.next_frame.clear();
+            handle.set_offset(point(px(0.), px(-40.)));
+            let plan = window
+                .plan_scrolled_replay(&prepaint, &paint, None)
+                .expect("a landed record replays scrolled");
+            window.invalidator.set_phase(DrawPhase::Prepaint);
+            window.replay_retained_prepaint_scrolled(&prepaint, &plan);
+            window.invalidator.set_phase(DrawPhase::Paint);
+            window.replay_retained_paint_scrolled(&paint, &plan);
+            let scale = window.scale_factor();
+            assert_eq!(
+                quads(window),
+                vec![rect(10., 40., 10., 10.).scale(scale)],
+                "the step shows the quad"
+            );
+        })
+        .unwrap();
+}
+
+/// A node opened inside a record paints into the record's scene: landed
+/// where it was recorded, the record's copy keeps the node's marks and the
+/// node takes its range in the frame's scene, so a step of the outer node
+/// replays the frame (the inner node moves with it) instead of building.
+#[crate::test]
+fn a_node_painted_inside_a_record_lands_with_it(cx: &mut TestAppContext) {
+    cx.add_window(|_, _| Empty)
+        .update(cx, |_, window, cx| {
+            window.scroll_interest_margin = px(100.);
+            let (outer, inner) = (ScrollHandle::new(), ScrollHandle::new());
+            outer.set_max_offset(point(px(0.), px(10_000.)));
+            let (outer_id, inner_id) = (ScrollNodeId::of(&outer), ScrollNodeId::of(&inner));
+            window.invalidator.set_phase(DrawPhase::Prepaint);
+            let (_, prepaint) = window.record_retained_prepaint(|window| {
+                window.with_scroll_node_prepaint(&outer, rect(0., 0., 100., 50.), |window| {
+                    window.with_scroll_node_prepaint(&inner, rect(0., 0., 100., 120.), |_| {});
+                });
+            });
+            window.invalidator.set_phase(DrawPhase::Paint);
+            let (_, paint) = window.with_paint_pass(|window| {
+                window.record_retained_paint(|window| {
+                    window.with_scroll_node_paint(outer_id, |window| {
+                        let extent = rect(0., 0., 100., 120.);
+                        let (_, record) = window
+                            .record_paint(extent, cx, |window, _| {
+                                window.with_scroll_node_paint(inner_id, |window| {
+                                    let scale = window.scale_factor();
+                                    // Below the outer clip: dormant under the inner node.
+                                    window.insert_scene_primitive(Quad {
+                                        bounds: rect(10., 80., 10., 10.).scale(scale),
+                                        content_mask: window.content_mask().scale(scale),
+                                        ..Default::default()
+                                    });
+                                });
+                            })
+                            .unwrap();
+                        let placement = PaintPlacement {
+                            source: point(px(0.), px(0.)),
+                            destination: point(px(0.), px(0.)),
+                            clip: extent,
+                        };
+                        window.paint_plan(&PaintPlan::record(record), placement).unwrap();
+                    });
+                })
+            });
+            let frame_space = window.next_frame.scene.scroll.space;
+            let node = window.next_frame.scroll_nodes.iter().find(|node| node.id == inner_id).unwrap();
+            assert_eq!(node.painted_in, Some(frame_space), "the inner node lands in the frame's scene");
+            std::mem::swap(&mut window.rendered_frame, &mut window.next_frame);
+            window.next_frame.clear();
+            outer.set_offset(point(px(0.), px(-40.)));
+            let plan = window
+                .plan_scrolled_replay(&prepaint, &paint, None)
+                .expect("the record's node replays scrolled");
+            window.invalidator.set_phase(DrawPhase::Prepaint);
+            window.replay_retained_prepaint_scrolled(&prepaint, &plan);
+            window.invalidator.set_phase(DrawPhase::Paint);
+            window.replay_retained_paint_scrolled(&paint, &plan);
+            let scale = window.scale_factor();
+            assert_eq!(quads(window), vec![rect(10., 40., 10., 10.).scale(scale)], "the step shows the quad");
+        })
+        .unwrap();
+}
