+    pub subgrid_columns: Option<GridAxisLineNames>,
+    /// `<line-name-list>` подсеточных рядов.
+    pub subgrid_rows: Option<GridAxisLineNames>,
+    /// Именованные грани по колонкам: начало, конец.
+    pub column: [Option<GridNamedLine>; 2],
