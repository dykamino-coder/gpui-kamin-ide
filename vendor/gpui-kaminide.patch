+#[derive(Clone, Default, PartialEq)]
+pub(crate) struct LineLayoutIndex {
+    font_generation: usize,
+    lines_index: usize,
+    wrapped_lines_index: usize,
+    lines_by_hash_index: usize,
+    wrapped_lines_by_hash_index: usize,
+}
+
+impl LineLayoutIndex {
+    /// KaminIDE patch: this index in 32-bit words; retained ranges keep many.
+    pub(crate) fn pack(&self) -> [u32; 5] {
+        [
+            self.font_generation,
+            self.lines_index,
+            self.wrapped_lines_index,
+            self.lines_by_hash_index,
+            self.wrapped_lines_by_hash_index,
+        ]
+        .map(crate::window::pack_index)
+    }
+
+    /// KaminIDE patch: the index `pack` gave.
+    pub(crate) fn unpack(words: [u32; 5]) -> Self {
+        let [font_generation, lines_index, wrapped_lines_index, lines_by_hash_index, wrapped_lines_by_hash_index] =
+            words.map(|w| w as usize);
+        Self {
+            font_generation,
+            lines_index,
+            wrapped_lines_index,
+            lines_by_hash_index,
+            wrapped_lines_by_hash_index,
+        }
+    }
+}
+
+impl LineLayoutCache {
+    pub fn new(
+        platform_text_system: Arc<dyn PlatformTextSystem>,
+        font_generation: Arc<AtomicUsize>,
+    ) -> Self {
+        let cached_font_generation = font_generation.load(Ordering::Acquire);
+        Self {
+            previous_frame: Mutex::default(),
+            current_frame: RwLock::default(),
+            platform_text_system,
+            font_generation,
+            cached_font_generation: AtomicUsize::new(cached_font_generation),
+        }
+    }
+
+    pub fn layout_index(&self) -> LineLayoutIndex {
+        let font_generation = self.clear_if_font_generation_changed();
+        let frame = self.current_frame.read();
+        LineLayoutIndex {
+            font_generation,
+            lines_index: frame.used_lines.len(),
+            wrapped_lines_index: frame.used_wrapped_lines.len(),
+            lines_by_hash_index: frame.used_lines_by_hash.len(),
+            wrapped_lines_by_hash_index: frame.used_wrapped_lines_by_hash.len(),
+        }
+    }
+
+    pub fn reuse_layouts(&self, range: Range<LineLayoutIndex>) {
+        let font_generation = self.clear_if_font_generation_changed();
+        if range.start.font_generation != font_generation
+            || range.end.font_generation != font_generation
+        {
+            return;
+        }
+        let current_frame = &mut *self.current_frame.write();
+        let previous_frame = &mut *self.previous_frame.lock();
+
+        // KaminIDE patch: a subtree that replays the previous frame's layouts
+        // from its first one, before this frame laid out anything (a retained
+        // document replayed whole: its prepaint, then its paint), takes the
+        // whole previous frame in the same order: a swap of the frames, O(1)
+        // instead of two hash-map operations per line. Uses after `range`
+        // come along at the same positions, so the replay that follows reuses
+        // them in place; a frame that does not replay them only keeps them
+        // cached one frame longer.
+        if previous_frame.used_from_start(&range) && current_frame.is_empty() {
+            std::mem::swap(current_frame, previous_frame);
+            return;
+        }
+
+        // KaminIDE patch: a range the swap above already brought into this
+        // frame is past the previous frame's lists: nothing is left to reuse.
+        if let Some(keys) = previous_frame
+            .used_lines
+            .get(range.start.lines_index..range.end.lines_index)
+        {
+            for key in keys {
+                if let Some((key, line)) = previous_frame.lines.remove_entry(key) {
+                    current_frame.lines.insert(key, line);
+                }
+                current_frame.used_lines.push(key.clone());
+            }
+        }
+
+        if let Some(keys) = previous_frame
+            .used_wrapped_lines
+            .get(range.start.wrapped_lines_index..range.end.wrapped_lines_index)
+        {
+            for key in keys {
+                if let Some((key, line)) = previous_frame.wrapped_lines.remove_entry(key) {
+                    current_frame.wrapped_lines.insert(key, line);
+                }
+                current_frame.used_wrapped_lines.push(key.clone());
+            }
+        }
+
+        if let Some(keys) = previous_frame
+            .used_lines_by_hash
+            .get(range.start.lines_by_hash_index..range.end.lines_by_hash_index)
+        {
+            for key in keys {
+                if let Some((key, line)) = previous_frame.lines_by_hash.remove_entry(key) {
+                    current_frame.lines_by_hash.insert(key, line);
+                }
+                current_frame.used_lines_by_hash.push(key.clone());
+            }
+        }
+
+        if let Some(keys) = previous_frame
+            .used_wrapped_lines_by_hash
+            .get(range.start.wrapped_lines_by_hash_index..range.end.wrapped_lines_by_hash_index)
+        {
+            for key in keys {
+                if let Some((key, line)) = previous_frame.wrapped_lines_by_hash.remove_entry(key) {
+                    current_frame.wrapped_lines_by_hash.insert(key, line);
+                }
+                current_frame.used_wrapped_lines_by_hash.push(key.clone());
+            }
+        }
+    }
+
+    pub fn truncate_layouts(&self, index: LineLayoutIndex) {
+        let font_generation = self.clear_if_font_generation_changed();
+        if index.font_generation != font_generation {
+            return;
+        }
+        let mut current_frame = &mut *self.current_frame.write();
+        current_frame.used_lines.truncate(index.lines_index);
+        current_frame
+            .used_wrapped_lines
+            .truncate(index.wrapped_lines_index);
+        current_frame
+            .used_lines_by_hash
+            .truncate(index.lines_by_hash_index);
+        current_frame
+            .used_wrapped_lines_by_hash
+            .truncate(index.wrapped_lines_by_hash_index);
+    }
+
+    /// KaminIDE patch: line layouts the frame caches hold (current and
+    /// previous frame), for hosts that check a pass leaves them unchanged.
+    pub fn cached_layouts(&self) -> usize {
+        let current = self.current_frame.read();
+        let previous = self.previous_frame.lock();
+        [&*current, &*previous]
+            .iter()
+            .map(|f| f.lines.len() + f.wrapped_lines.len() + f.lines_by_hash.len() + f.wrapped_lines_by_hash.len())
+            .sum()
+    }
+
+    pub fn finish_frame(&self) {
+        let _font_generation = self.clear_if_font_generation_changed();
+        let mut curr_frame = self.current_frame.write();
+        let mut prev_frame = self.previous_frame.lock();
+        std::mem::swap(&mut *prev_frame, &mut *curr_frame);
+        super::composed::PIECES.finish_frame();
+        curr_frame.lines.clear();
+        curr_frame.wrapped_lines.clear();
+        curr_frame.used_lines.clear();
+        curr_frame.used_wrapped_lines.clear();
+
+        curr_frame.lines_by_hash.clear();
+        curr_frame.wrapped_lines_by_hash.clear();
+        curr_frame.used_lines_by_hash.clear();
+        curr_frame.used_wrapped_lines_by_hash.clear();
+    }
+
+    /// KaminIDE patch: раскладка строки с переносом и трекингом (вместо
