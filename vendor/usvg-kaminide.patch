--- /dev/null
+++ b/vendor/usvg/src/parser/svgtree/parse/css.rs
@@ -0,0 +1,61 @@
+//! SVG typed-tree css; source cascade remains in its resource scope.
+pub(super) fn resolve_css<'a>(
+    xml: &'a roxmltree::Document<'a>,
+    style_sheet: Option<&'a str>,
+) -> simplecss::StyleSheet<'a> {
+    let mut sheet = simplecss::StyleSheet::new();
+
+    // Injected style sheets do not override internal ones (we mimic the logic of rsvg-convert),
+    // so we need to parse it first.
+    if let Some(style_sheet) = style_sheet {
+        sheet.parse_more(style_sheet);
+    }
+
+    for node in xml.descendants().filter(|n| n.has_tag_name("style")) {
+        match node.attribute("type") {
+            Some("text/css") => {}
+            Some(_) => continue,
+            None => {}
+        }
+
+        let text = match node.text() {
+            Some(v) => v,
+            None => continue,
+        };
+
+        sheet.parse_more(text);
+    }
+
+    sheet
+}
+
+pub(super) struct XmlNode<'a, 'input: 'a>(pub(super) roxmltree::Node<'a, 'input>);
+
+impl simplecss::Element for XmlNode<'_, '_> {
+    fn parent_element(&self) -> Option<Self> {
+        self.0.parent_element().map(XmlNode)
+    }
+
+    fn prev_sibling_element(&self) -> Option<Self> {
+        self.0.prev_sibling_element().map(XmlNode)
+    }
+
+    fn has_local_name(&self, local_name: &str) -> bool {
+        self.0.tag_name().name() == local_name
+    }
+
+    fn attribute_matches(&self, local_name: &str, operator: simplecss::AttributeOperator) -> bool {
+        match self.0.attribute(local_name) {
+            Some(value) => operator.matches(value),
+            None => false,
+        }
+    }
+
+    fn pseudo_class_matches(&self, class: simplecss::PseudoClass) -> bool {
+        match class {
+            simplecss::PseudoClass::FirstChild => self.prev_sibling_element().is_none(),
+            // TODO: lang
+            _ => false, // Since we are querying a static SVG we can ignore other pseudo-classes.
+        }
+    }
+}
diff --git a/vendor/usvg/src/parser/svgtree/parse/elements.rs b/vendor/usvg/src/parser/svgtree/parse/elements.rs
new file mode 100644
index 0000000000000000000000000000000000000000..c309a26327b5f835663a1561e436e8a22bfbcfca
--- /dev/null
+++ b/vendor/usvg/src/parser/svgtree/parse/elements.rs
@@ -0,0 +1,253 @@
+//! SVG typed-tree elements; source cascade remains in its resource scope.
+use super::*;
+pub(crate) fn parse_svg_element<'input>(
+    xml_node: roxmltree::Node<'_, 'input>,
+    parent_id: NodeId,
+    tag_name: EId,
+    style_sheet: &simplecss::StyleSheet,
+    ignore_ids: bool,
+    doc: &mut Document<'input>,
+) -> Result<NodeId, Error> {
+    let attrs_start_idx = doc.attrs.len();
+    let mut href_idx: Option<usize> = None;
+
+    // Copy presentational attributes first.
+    for attr in xml_node.attributes() {
+        match attr.namespace() {
+            None | Some(SVG_NS) | Some(XLINK_NS) | Some(XML_NAMESPACE_NS) => {}
+            _ => continue,
+        }
+
+        let aid = match AId::from_str(attr.name()) {
+            Some(v) => v,
+            None => continue,
+        };
+
+        // During a `use` resolving, all `id` attributes must be ignored.
+        // Otherwise we will get elements with duplicated id's.
+        if ignore_ids && aid == AId::Id {
+            continue;
+        }
+
+        // For some reason those properties are allowed only inside a `style` attribute and CSS.
+        if matches!(aid, AId::MixBlendMode | AId::Isolation | AId::FontKerning) {
+            continue;
+        } else if aid == AId::ImageRendering
+            && matches!(
+                attr.value(),
+                "smooth" | "high-quality" | "crisp-edges" | "pixelated"
+            )
+        {
+            continue;
+        }
+
+        // SVG 2: when both `href` and `xlink:href` are present, the unprefixed
+        // `href` takes precedence and the XLink one must be ignored, regardless
+        // of their order in the source document.
+        // https://www.w3.org/TR/SVG2/linking.html#XLinkRefAttrs
+        if aid == AId::Href {
+            let is_unprefixed = attr.namespace().is_none();
+            let is_xlink = attr.namespace() == Some(XLINK_NS);
+            if !is_unprefixed && !is_xlink {
+                continue;
+            }
+
+            if let Some(idx) = href_idx {
+                // An `href` was already stored. Only an unprefixed `href` is
+                // allowed to override it; an `xlink:href` is ignored.
+                if is_unprefixed {
+                    doc.attrs[idx].value = attr.value_storage().clone();
+                }
+                continue;
+            }
+        }
+
+        let added = append_attribute(
+            parent_id,
+            tag_name,
+            aid,
+            attr.value_storage().clone(),
+            false,
+            doc,
+        );
+        if added && aid == AId::Href {
+            href_idx = Some(doc.attrs.len() - 1);
+        }
+    }
+
+    let mut insert_attribute = |aid, value: &str, important: bool| {
+        // Check that attribute already exists.
+        let idx = doc.attrs[attrs_start_idx..]
+            .iter_mut()
+            .position(|a| a.name == aid);
+
+        // Append an attribute as usual.
+        let added = append_attribute(
+            parent_id,
+            tag_name,
+            aid,
+            roxmltree::StringStorage::new_owned(value),
+            important,
+            doc,
+        );
+
+        // Check that attribute was actually added, because it could be skipped.
+        if added {
+            if let Some(idx) = idx {
+                let last_idx = doc.attrs.len() - 1;
+                let existing_idx = attrs_start_idx + idx;
+
+                // See https://developer.mozilla.org/en-US/docs/Web/CSS/important
+                // When a declaration is important, the order of precedence is reversed.
+                // Declarations marked as important in the user-agent style sheets override
+                // all important declarations in the user style sheets. Similarly, all important
+                // declarations in the user style sheets override all important declarations in the
+                // author's style sheets. Finally, all important declarations take precedence over
+                // all animations.
+                //
+                // Which means:
+                // 1) Existing is not important, new is not important -> swap
+                // 2) Existing is important, new is not important -> don't swap
+                // 3) Existing is not important, new is important -> swap
+                // 4) Existing is important, new is important -> don't swap (since the order
+                // is reversed, so existing important attributes take precedence over new
+                // important attributes)
+                let has_precedence = !doc.attrs[existing_idx].important;
+
+                if has_precedence {
+                    doc.attrs.swap(existing_idx, last_idx);
+                }
+
+                // Remove last.
+                doc.attrs.pop();
+            }
+        }
+    };
+
+    let mut write_declaration = |declaration: &Declaration| {
+        // TODO: perform XML attribute normalization
+        let imp = declaration.important;
+        let val = declaration.value;
+
+        if declaration.name == "marker" {
+            insert_attribute(AId::MarkerStart, val, imp);
+            insert_attribute(AId::MarkerMid, val, imp);
+            insert_attribute(AId::MarkerEnd, val, imp);
+        } else if declaration.name == "font" {
+            if let Ok(shorthand) = FontShorthand::from_str(val) {
+                // First we need to reset all values to their default.
+                insert_attribute(AId::FontStyle, "normal", imp);
+                insert_attribute(AId::FontVariant, "normal", imp);
+                insert_attribute(AId::FontWeight, "normal", imp);
+                insert_attribute(AId::FontStretch, "normal", imp);
+                insert_attribute(AId::LineHeight, "normal", imp);
+                insert_attribute(AId::FontSizeAdjust, "none", imp);
+                insert_attribute(AId::FontKerning, "auto", imp);
+                insert_attribute(AId::FontVariantCaps, "normal", imp);
+                insert_attribute(AId::FontVariantLigatures, "normal", imp);
+                insert_attribute(AId::FontVariantNumeric, "normal", imp);
+                insert_attribute(AId::FontVariantEastAsian, "normal", imp);
+                insert_attribute(AId::FontVariantPosition, "normal", imp);
+
+                // Then, we set the properties that have been declared.
+                shorthand
+                    .font_stretch
+                    .map(|s| insert_attribute(AId::FontStretch, s, imp));
+                shorthand
+                    .font_weight
+                    .map(|s| insert_attribute(AId::FontWeight, s, imp));
+                shorthand
+                    .font_variant
+                    .map(|s| insert_attribute(AId::FontVariant, s, imp));
+                shorthand
+                    .font_style
+                    .map(|s| insert_attribute(AId::FontStyle, s, imp));
+                insert_attribute(AId::FontSize, shorthand.font_size, imp);
+                insert_attribute(AId::FontFamily, shorthand.font_family, imp);
+            } else {
+                log::warn!(
+                    "Failed to parse {} value: '{}'",
+                    AId::Font,
+                    declaration.value
+                );
+            }
+        } else if let Some(aid) = AId::from_str(declaration.name) {
+            // Parse only the presentation attributes and the SVG 2 geometry
+            // properties of this element.
+            if aid.is_presentation() {
+                insert_attribute(aid, val, imp);
+            } else if is_geometry_property(tag_name, aid) {
+                match geometry_value(aid, val) {
+                    Some(v) => insert_attribute(aid, &v, imp),
+                    None => insert_attribute(aid, val, imp),
+                }
+            }
+        }
+    };
+
+    // Apply CSS.
+    for rule in &style_sheet.rules {
+        if rule.selector.matches(&XmlNode(xml_node)) {
+            for declaration in &rule.declarations {
+                write_declaration(declaration);
+            }
+        }
+    }
+
+    // Split a `style` attribute.
+    if let Some(value) = xml_node.attribute("style") {
+        for declaration in simplecss::DeclarationTokenizer::from(value) {
+            write_declaration(&declaration);
+        }
+    }
+
+    if doc.nodes.len() > 1_000_000 {
+        return Err(Error::NodesLimitReached);
+    }
+
+    let node_id = doc.append(
+        parent_id,
+        NodeKind::Element {
+            tag_name,
+            attributes: ShortRange::new(attrs_start_idx as u32, doc.attrs.len() as u32),
+        },
+    );
+
+    Ok(node_id)
+}
+
+/// SVG 2 geometry properties (SVG 2 §9.1-§9.4, §5.1, §12.3; Blink
+/// `SVGRectElement`/`SVGCircleElement`/`SVGEllipseElement`/`SVGUseElement`/
+/// `SVGPathElement` map them to `CSSPropertyID::kX`… `kD`): the CSS cascade
+/// overrides the attribute of the same name, but only on the elements the
+/// property applies to: `x` on `text` stays a list attribute, and `svg` takes
+/// none of them (svgwg#1059; WPT svg/styling `nested-svg-sizing*`).
+fn is_geometry_property(tag: EId, aid: AId) -> bool {
+    match aid {
+        AId::Cx | AId::Cy => matches!(tag, EId::Circle | EId::Ellipse),
+        AId::R => tag == EId::Circle,
+        AId::Rx | AId::Ry => matches!(tag, EId::Rect | EId::Ellipse),
+        AId::X | AId::Y => matches!(tag, EId::Rect | EId::Image | EId::Use),
+        AId::Width | AId::Height => matches!(tag, EId::Rect | EId::Image),
+        AId::D => tag == EId::Path,
+        _ => false,
+    }
+}
+
+/// The attribute form of a geometry property value: `d: path("…")` carries
+/// the path data string, `d: none` is an empty path.
+fn geometry_value(aid: AId, val: &str) -> Option<String> {
+    if aid != AId::D {
+        return None;
+    }
+    let v = val.trim();
+    if v.eq_ignore_ascii_case("none") {
+        return Some(String::new());
+    }
+    let inner = v.strip_prefix("path(")?.strip_suffix(')')?.trim();
+    let inner = inner
+        .strip_prefix('"')
+        .and_then(|s| s.strip_suffix('"'))
+        .or_else(|| inner.strip_prefix('\'').and_then(|s| s.strip_suffix('\'')))?;
+    Some(inner.to_string())
+}
diff --git a/vendor/usvg/src/parser/svgtree/parse/external.rs b/vendor/usvg/src/parser/svgtree/parse/external.rs
new file mode 100644
index 0000000000000000000000000000000000000000..08744d5eda546a4dda1ac04e4da69b8bf787ffe6
--- /dev/null
+++ b/vendor/usvg/src/parser/svgtree/parse/external.rs
@@ -0,0 +1,185 @@
+//! External use resolves a separate resource cascade before importing typed nodes.
+use super::owned::Snapshot;
+use super::*;
+use std::{
+    collections::{HashMap, HashSet},
+    sync::Arc,
+};
+use url::Url;
+
+#[derive(Default)]
+struct Session {
+    active: HashSet<String>,
+    cache: HashMap<String, Arc<Resource>>,
+}
+struct Resource {
+    definitions: Snapshot,
+    target: Snapshot,
+}
+
+impl Document<'_> {
+    pub(crate) fn import_external(&mut self, opt: &crate::Options) {
+        let base = opt
+            .resources_dir
+            .as_ref()
+            .and_then(|p| Url::from_directory_path(p).ok());
+        Session::default().expand(self, base.as_ref(), 0);
+        super::super::cycles::fix_resource_cycles(self);
+    }
+}
+
+impl Session {
+    fn expand(&mut self, doc: &mut Document, base: Option<&Url>, depth: usize) {
+        if depth >= 32 {
+            return;
+        }
+        let uses: Vec<_> = doc
+            .descendants()
+            .filter(|n| n.tag_name() == Some(EId::Use))
+            .filter_map(|n| n.attribute::<&str>(AId::Href).map(|h| (n.id, h.to_owned())))
+            .collect();
+        // Images retain the resource base even after their nodes are imported.
+        for attr in &mut doc.attrs {
+            if attr.name == AId::Href && !attr.value.starts_with('#') {
+                if let Some(uri) = resolve(&attr.value, base) {
+                    let text = if uri.fragment().is_none() {
+                        uri.to_file_path()
+                            .ok()
+                            .map(|p| p.to_string_lossy().into_owned())
+                            .unwrap_or(uri.to_string())
+                    } else {
+                        uri.to_string()
+                    };
+                    attr.value = roxmltree::StringStorage::new_owned(&text);
+                }
+            }
+        }
+        for (parent, href) in uses {
+            if href.starts_with('#') || doc.get(parent).has_children() {
+                continue;
+            }
+            let Some(uri) = resolve(&href, base) else {
+                continue;
+            };
+            let Some(resource) = self.load(uri, depth + 1) else {
+                continue;
+            };
+            if doc.nodes.len() + resource.definitions.count() + resource.target.count() > 1_000_000
+            {
+                continue;
+            }
+            let prefix = format!("__kamin_resource_{}_", doc.nodes.len());
+            let empty = doc.attrs.len() as u32;
+            let defs = doc.append(
+                doc.root_element().id,
+                NodeKind::Element {
+                    tag_name: EId::Defs,
+                    attributes: ShortRange::new(empty, empty),
+                },
+            );
+            resource.definitions.append(doc, defs, &prefix, true);
+            resource.target.append(doc, parent, &prefix, false);
+        }
+    }
+
+    fn load(&mut self, uri: Url, depth: usize) -> Option<Arc<Resource>> {
+        let fragment = uri.fragment().unwrap_or("").to_owned();
+        let path = std::fs::canonicalize(uri.to_file_path().ok()?).ok()?;
+        let mut canonical = Url::from_file_path(&path).ok()?;
+        canonical.set_fragment(Some(&fragment));
+        let key = canonical.to_string();
+        if let Some(resource) = self.cache.get(&key) {
+            return Some(resource.clone());
+        }
+        if depth >= 32 || !self.active.insert(key.clone()) {
+            return None;
+        }
+        let result = (|| {
+            let bytes = read_resource(&path)?;
+            let text = std::str::from_utf8(&bytes).ok()?;
+            let xml = roxmltree::Document::parse_with_options(
+                text,
+                roxmltree::ParsingOptions {
+                    allow_dtd: true,
+                    ..Default::default()
+                },
+            )
+            .ok()?;
+            let mut source = parse(&xml, None, true).ok()?;
+            self.expand(&mut source, Some(&canonical), depth);
+            let target = if fragment.is_empty() {
+                source.root_element()
+            } else {
+                source.element_by_id(&fragment)?
+            };
+            Some(Arc::new(Resource {
+                target: Snapshot::capture(target, 0)?,
+                definitions: Snapshot::capture(source.root(), 0)?,
+            }))
+        })();
+        self.active.remove(&key);
+        if let Some(resource) = &result {
+            self.cache.insert(key, resource.clone());
+        }
+        result
+    }
+}
+
+fn resolve(href: &str, base: Option<&Url>) -> Option<Url> {
+    // A file path containing a Windows drive is not a URL scheme.
+    let path = std::path::Path::new(href.split('#').next()?);
+    if path.is_absolute() {
+        let mut uri = Url::from_file_path(path).ok()?;
+        uri.set_fragment(href.split_once('#').map(|(_, f)| f));
+        Some(uri)
+    } else {
+        Url::parse(href).ok().or_else(|| base?.join(href).ok())
+    }
+}
+
+// KaminIDE patch: refuse oversized files before allocation and bound the read
+// as well: metadata alone cannot protect against a file growing after open.
+const RESOURCE_BYTE_LIMIT: u64 = 16 * 1024 * 1024;
+
+fn read_resource(path: &std::path::Path) -> Option<Vec<u8>> {
+    let file = std::fs::File::open(path).ok()?;
+    if file.metadata().ok()?.len() > RESOURCE_BYTE_LIMIT {
+        return None;
+    }
+    read_bounded(file, RESOURCE_BYTE_LIMIT)
+}
+
+fn read_bounded(reader: impl std::io::Read, limit: u64) -> Option<Vec<u8>> {
+    use std::io::Read;
+    let mut bytes = Vec::new();
+    reader.take(limit + 1).read_to_end(&mut bytes).ok()?;
+    (bytes.len() as u64 <= limit).then_some(bytes)
+}
+
+#[cfg(test)]
+mod byte_limit_tests {
+    use super::read_bounded;
+    use std::cell::Cell;
+    use std::io::{self, Read};
+
+    #[test]
+    fn accepts_the_limit_and_rejects_one_extra_byte() {
+        assert_eq!(read_bounded(&b"abcd"[..], 4), Some(b"abcd".to_vec()));
+        assert!(read_bounded(&b"abcde"[..], 4).is_none());
+    }
+
+    #[test]
+    fn growing_source_is_never_read_past_limit_plus_one() {
+        struct Growing<'a>(&'a Cell<usize>);
+        impl Read for Growing<'_> {
+            fn read(&mut self, buf: &mut [u8]) -> io::Result<usize> {
+                buf.fill(b'x');
+                self.0.set(self.0.get() + buf.len());
+                Ok(buf.len())
+            }
+        }
+        let count = Cell::new(0);
+        assert!(read_bounded(Growing(&count), 4).is_none());
+        assert_eq!(count.get(), 5);
+    }
+}
diff --git a/vendor/usvg/src/parser/svgtree/parse/owned.rs b/vendor/usvg/src/parser/svgtree/parse/owned.rs
new file mode 100644
index 0000000000000000000000000000000000000000..9bf60f22583ae44785f958524e2949d1d21eb1c4
--- /dev/null
+++ b/vendor/usvg/src/parser/svgtree/parse/owned.rs
@@ -0,0 +1,106 @@
+//! Owned post-cascade resource nodes and collision-free instance import.
+use super::*;
+
+#[derive(Clone)]
+pub(super) struct Snapshot {
+    tag: Option<EId>,
+    text: String,
+    attrs: Vec<(AId, String, bool)>,
+    children: Vec<Snapshot>,
+}
+
+impl Snapshot {
+    pub(super) fn capture(node: super::super::SvgNode, depth: usize) -> Option<Self> {
+        if depth > 256 {
+            return None;
+        }
+        Some(Self {
+            tag: node.tag_name(),
+            text: if node.is_text() {
+                node.text().to_owned()
+            } else {
+                String::new()
+            },
+            attrs: node
+                .attributes()
+                .iter()
+                .map(|a| (a.name, a.value.to_string(), a.important))
+                .collect(),
+            children: node
+                .children()
+                .map(|n| Self::capture(n, depth + 1))
+                .collect::<Option<_>>()?,
+        })
+    }
+
+    pub(super) fn count(&self) -> usize {
+        1 + self.children.iter().map(Self::count).sum::<usize>()
+    }
+
+    pub(super) fn append(&self, doc: &mut Document, parent: NodeId, prefix: &str, ids: bool) {
+        if self.tag.is_none() && self.text.is_empty() {
+            for child in &self.children {
+                child.append(doc, parent, prefix, ids);
+            }
+            return;
+        }
+        let kind = if let Some(tag_name) = self.tag {
+            let start = doc.attrs.len();
+            for (name, value, important) in &self.attrs {
+                if *name == AId::Id && !ids {
+                    continue;
+                }
+                let value = if *name == AId::Id {
+                    format!("{prefix}{value}")
+                } else {
+                    remap(*name, value, prefix)
+                };
+                doc.attrs.push(Attribute {
+                    name: *name,
+                    value: roxmltree::StringStorage::new_owned(&value),
+                    important: *important,
+                });
+            }
+            NodeKind::Element {
+                tag_name,
+                attributes: ShortRange::new(start as u32, doc.attrs.len() as u32),
+            }
+        } else {
+            NodeKind::Text(self.text.clone())
+        };
+        let node = doc.append(parent, kind);
+        if ids {
+            if let Some(id) = doc.get(node).attribute::<&str>(AId::Id) {
+                doc.links.insert(id.to_owned(), node);
+            }
+        }
+        for child in &self.children {
+            child.append(doc, node, prefix, ids);
+        }
+    }
+}
+
+fn remap(name: AId, value: &str, prefix: &str) -> String {
+    if name == AId::Href && value.starts_with('#') {
+        return format!("#{prefix}{}", &value[1..]);
+    }
+    let mut out = String::new();
+    let mut rest = value;
+    while let Some(at) = rest.find("url(") {
+        out.push_str(&rest[..at + 4]);
+        rest = &rest[at + 4..];
+        let Some(end) = rest.find(')') else {
+            break;
+        };
+        let iri = rest[..end].trim().trim_matches(['\'', '"']);
+        if let Some(fragment) = iri.strip_prefix('#') {
+            out.push_str(&format!("#{prefix}{fragment}"));
+        } else {
+            out.push_str(&rest[..end]);
+        }
+        out.push(')');
+        rest = &rest[end + 1..];
+    }
+    out.push_str(rest);
+    out
+}
