diff --git a/vendor/usvg/src/tree/path_scene.rs b/vendor/usvg/src/tree/path_scene.rs
new file mode 100644
index 0000000000000000000000000000000000000000..cb47d86705d4dd51eeb379998c71d6e4acd36021
