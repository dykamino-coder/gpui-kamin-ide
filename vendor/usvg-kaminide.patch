-    // would return whichever `href`/`xlink:href` comes first, so we have to
-    // filter by namespace explicitly.
-    let link_value = node
-        .attributes()
-        .find(|a| a.name() == "href" && a.namespace().is_none())
-        .or_else(|| {
-            node.attributes()
-                .find(|a| a.name() == "href" && a.namespace() == Some(XLINK_NS))
-        })
-        .map(|a| a.value())?;
