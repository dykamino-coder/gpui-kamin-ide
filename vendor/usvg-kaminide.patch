-pub(crate) fn parse_svg_element<'input>(
-    xml_node: roxmltree::Node<'_, 'input>,
-    parent_id: NodeId,
-    tag_name: EId,
-    style_sheet: &simplecss::StyleSheet,
-    ignore_ids: bool,
-    doc: &mut Document<'input>,
