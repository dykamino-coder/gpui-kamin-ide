+/// KaminIDE patch: ресурсы backdrop blur. Копия бэкбуфера (сэмплить
+/// связанный RTV нельзя) + каскад даунсемплов области + свой GlobalParams
+/// (вьюпорты проходов не равны вьюпорту кадра).
+#[derive(Default)]
+struct BlurScratch {
+    /// KaminIDE patch: общий кадровый домен растеризатора; готовые группы ограничены.
+    stage: Option<BlurTexture>,
+    /// KaminIDE patch: stage rectangles written since the last clear (one per
+    /// group of the pending layer).
+    stage_dirty: Vec<Region>,
+    /// KaminIDE patch: groups drawn into the stage whose regions are pairwise
+    /// disjoint; one batched blur moves them into the atlas (`flush_group_layer`).
+    layer: Vec<usize>,
+    /// KaminIDE patch: instances of a stage layer, uploaded together.
+    layer_instances: group_batch::LayerInstances,
+    /// KaminIDE patch: frame-sized backdrop copy of a composite level.
+    level_backdrop: Option<BlurTexture>,
+    /// KaminIDE patch: viewport size last written to the frame parameter buffer.
+    frame_globals: Option<[f32; 2]>,
+    stage_rasterizer: Option<ID3D11RasterizerState>,
+    copy: Option<BlurTexture>,
+    blend_copy: Option<BlurTexture>,
+    down: Vec<BlurTexture>,
+    /// KaminIDE patch: half-float intermediate of the separable Gaussian (grow-only).
+    gauss: Option<BlurTexture>,
+    globals: [Option<ID3D11Buffer>; 1],
+    /// KaminIDE patch: atlas pages holding the retained image of every group
+    /// of the frame (`group_atlas`); `group_place` is each group's rectangle.
+    groups: Vec<BlurTexture>,
+    group_place: Vec<group_atlas::Place>,
+    group_regions: Vec<Region>,
+    /// KaminIDE patch: tile lists of the composite run in one pass (`group_tiles`).
+    tile_lists: group_tiles::TileLists,
+    /// KaminIDE patch: the scissor of the frame scene being drawn
+    /// (`retained::Plan::Within`); group composites outside it are skipped.
+    frame_within: Option<Region>,
+    pool: texture_pool::Pool,
+    /// Готовый буфер каждой группы: сырой или размытый.
+    group_slots: Vec<usize>,
+    /// Режим смешивания каждой группы (`mix-blend-mode`).
+    group_blend: Vec<u32>,
+    /// Обрезающий многоугольник каждой группы: вершины парами и их число.
+    group_poly: Vec<([[f32; 4]; 4], u32)>,
+    /// Маска-изображение каждой группы: SRV плитки, её прямоугольник
+    /// (угол и размер в device px) и флаг «одна плитка» (no-repeat).
+    group_mask: Vec<Option<([Option<ID3D11ShaderResourceView>; 1], [f32; 4], f32)>>,
+    /// Коробка окраски маски / `clip: rect` каждой группы (device px);
+    /// нулевой размер — без клипа. Живёт отдельно от текстуры: старый
+    /// `clip` режет и группу БЕЗ маски-изображения.
+    group_clip: Vec<[f32; 4]>,
+    /// KaminIDE patch: гомография плоскости и BSP-куски каждой группы.
+    group_proj: Vec<[[f32; 4]; 3]>,
+    group_frags: Vec<Vec<([[f32; 4]; 4], u32)>>,
+    /// Текстуры масок по картинке-источнику: заливать пиксели каждый кадр
+    /// незачем, картинка неизменна (`ImageId` уникален на содержимое).
+    mask_cache: mask_uploads::MaskUploads,
+}
