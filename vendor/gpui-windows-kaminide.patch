+
+    pub(crate) fn sprite_atlas(&self) -> Arc<dyn PlatformAtlas> {
+        self.atlas.clone()
+    }
+
+    fn pre_draw(&mut self, clear_color: &[f32; 4], clear: bool) -> Result<()> {
+        let clear_color = *self.backdrop.as_ref().unwrap_or(clear_color);
+        let resources = self.resources.as_ref().expect("resources missing");
+        let device_context = &self
+            .devices
+            .as_ref()
+            .expect("devices missing")
+            .device_context;
+        update_buffer(
+            device_context,
+            self.globals.global_params_buffer.as_ref().unwrap(),
+            &[GlobalParams {
+                gamma_ratios: self.font_info.gamma_ratios,
+                viewport_size: [resources.viewport.Width, resources.viewport.Height],
+                grayscale_enhanced_contrast: self.font_info.grayscale_enhanced_contrast,
+                subpixel_enhanced_contrast: self.font_info.subpixel_enhanced_contrast,
+                is_bgr: self.font_info.is_bgr as u32,
+                origin: [0.0; 2],
+                _pad: 0,
+            }],
+        )?;
+        // KaminIDE patch: the clear is a draw, issued once the target, the
+        // viewport and the frame parameters are bound (quad_clear).
+        unsafe {
+            device_context
+                .OMSetRenderTargets(Some(slice::from_ref(&resources.render_target_view)), None);
+            device_context.RSSetViewports(Some(slice::from_ref(&resources.viewport)));
+            device_context
+                .VSSetConstantBuffers(0, Some(slice::from_ref(&self.globals.global_params_buffer)));
+            device_context
+                .VSSetConstantBuffers(1, Some(slice::from_ref(&self.globals.batch_params_buffer)));
+            device_context
+                .PSSetConstantBuffers(0, Some(slice::from_ref(&self.globals.global_params_buffer)));
+        }
+        // KaminIDE patch: a frame drawn within a rectangle clears it later,
+        // under the scissor (`render`).
+        if !clear {
+            return Ok(());
+        }
+        self.clear_frame(clear_color)
+    }
+
+    #[inline]
+    fn present(&mut self) -> Result<()> {
+        // KaminIDE patch (#76): БЕЗ dcomp-Commit и без ожиданий. dcomp-дерево
+        // статично после set_swap_chain (underlay-эпоха WebView2 удалена как
+        // мёртвая), а прежний пер-кадровый commit() делал
+        // WaitForCommitCompletion — блокировку UI-потока до завершения
+        // композиции DWM: на RDP-компоузере это 30-90 мс НА КАЖДЫЙ КАДР
+        // (замер diag.log юзера: «презент 397-911 мс»/с) — корень задержки
+        // ввода ~1.5с на слабой машине.
+        // KaminIDE patch: an offscreen target is complete once drawn.
+        let Some(swap_chain) = self.resources.as_ref().expect("resources missing").swap_chain.clone()
+        else {
+            self.unpresented = false;
+            return Ok(());
+        };
+        // KaminIDE patch (canvas.rs): the buffer takes what it lacks from the canvas.
+        let copied = self.copy_to_back_buffer()?;
+        // KaminIDE patch (BR-31A): never wait inside Present. While the GPU
+        // or the compositor is behind, a plain Present blocked the UI thread
+        // for about 1 s per frame and webview pulls waited behind it. A frame
+        // that cannot be queued now is dropped, and the next paint presents.
+        let started = std::time::Instant::now();
+        let result = present_gate::present_dirty(&swap_chain, copied, (self.width, self.height));
+        present_gate::count_present_call(started.elapsed());
+        let shown = present_gate::frame_shown(result)?;
+        if result == windows::Win32::Foundation::DXGI_STATUS_OCCLUDED {
+            // KaminIDE patch: whether the chain took a buffer is unknown; the
+            // canvas still holds the frame.
+            self.forget_buffers();
+        }
+        if shown {
+            // KaminIDE patch (retained.rs): the next frame draws into the next buffer.
+            self.retained.presents = self.retained.presents.wrapping_add(1);
+            // The queued frame will signal the gate again; a dropped one
+            // keeps the count it took for the next attempt.
+            if let Some(gate) = &self.res().frame_gate {
+                gate.spend();
+            }
+        } else {
+            self.drop_frame();
+        }
+        self.unpresented = !shown;
+        Ok(())
+    }
+
+    /// KaminIDE patch (BR-31A): the frame was not handed to the compositor;
+    /// ask for a low-priority paint, which presents it (`needs_presentation`).
+    fn drop_frame(&mut self) {
+        self.unpresented = true;
+        present_gate::count_dropped_frame();
+        if !self.hwnd.is_invalid() {
+            unsafe {
+                let _ = windows::Win32::Graphics::Gdi::InvalidateRect(Some(self.hwnd), None, false);
+            }
+        }
+    }
+
+    /// KaminIDE patch (BR-31A): the last frame was dropped, so the next paint
+    /// must present even if the scene is unchanged.
+    pub(crate) fn needs_presentation(&self) -> bool {
+        self.unpresented
+    }
+
+    pub(crate) fn handle_device_lost(&mut self, directx_devices: &DirectXDevices) -> Result<()> {
+        // KaminIDE patch: layer buffers die with the device.
+        self.layer_cache.clear();
+        try_to_recover_from_device_lost(|| {
+            self.handle_device_lost_impl(directx_devices)
+                .context("DirectXRenderer handling device lost")
+        })
+    }
+
+    /// KaminIDE patch: устройства окна (upstream держит их в `Option` на
+    /// время пересоздания после device lost).
+    fn dev(&self) -> &DirectXRendererDevices {
+        self.devices.as_ref().expect("devices missing")
+    }
+
+    /// KaminIDE patch: ресурсы свапчейна, см. `dev`.
+    fn res(&self) -> &DirectXResources {
+        self.resources.as_ref().expect("resources missing")
+    }
+
+    /// KaminIDE patch: блендер для буферов групп (создаётся по требованию).
+    fn premultiplied_blend(&mut self) -> Result<ID3D11BlendState> {
+        if self.blend_premultiplied.is_none() {
+            self.blend_premultiplied = Some(create_blend_state_premultiplied(&self.dev().device)?);
+        }
+        Ok(self.blend_premultiplied.clone().unwrap())
+    }
+
+    /// KaminIDE patch: писать результат поверх — смешивание уже посчитано.
+    fn replace_blend(&mut self) -> Result<ID3D11BlendState> {
+        if self.blend_replace.is_none() {
+            self.blend_replace = Some(create_blend_state_replace(&self.dev().device)?);
+        }
+        Ok(self.blend_replace.clone().unwrap())
+    }
+
+    /// KaminIDE patch: цель отрисовки сейчас — буфер группы или кадр.
+    fn current_target(&self) -> &[Option<ID3D11RenderTargetView>] {
+        match self.group_target.as_ref() {
+            Some(target) => &target[..],
+            None => slice::from_ref(&self.res().render_target_view),
+        }
+    }
+
+    pub(crate) fn draw(
+        &mut self,
+        scene: &Scene,
+        background_appearance: WindowBackgroundAppearance,
+    ) -> Result<()> {
+        if self.skip_draws {
+            // skip drawing this frame, we just recovered from a device lost event
+            // and so likely do not have the textures anymore that are required for drawing
+            return Ok(());
+        }
+        self.ensure_drawable_resources()?;
+        // KaminIDE patch (retained.rs): unite this frame's damage into every
+        // buffer first, so a skipped frame still leaves what the buffers lack.
+        // A frame the target and the screen already show is neither drawn nor
+        // presented, and takes nothing from the latency gate.
+        let plan = self.plan_frame(scene, background_appearance);
+        self.count_plan(&plan, scene.frame_shift_miss(), scene.frame_shift_stats());
+        let keep = matches!(plan, retained::Plan::Keep);
+        if keep {
+            self.release_unused_effect_targets(scene);
+            // KaminIDE patch (group_cache.rs): the kept frame's groups own the images now.
+            self.carry_kept_groups(scene);
+        }
+        if keep && !self.unpresented {
+            self.frame_drawn(&plan);
+            if self.capture.is_some()
+                && let Err(e) = self.capture_frame()
+            {
+                log::warn!("frame capture failed: {e}");
+            }
+            return Ok(());
+        }
+        // KaminIDE patch (#76): буфер свапчейна занят компоузером (DWM/RDP
+        // ещё кодирует прошлый кадр) — НЕ рисовать и НЕ блокироваться:
+        // пропускаем кадр и просим низкоприоритетный WM_PAINT — он придёт
+        // ПОСЛЕ обработки очереди ввода, содержимое догонит без лага букв.
+        // KaminIDE patch: under frame capture (WPT runner) never skip a frame
+        // on the compositor's latency gate — an occluded window's frames are
+        // consumed rarely and the page would never be drawn.
+        let gate_open = self
+            .res()
+            .frame_gate
+            .as_ref()
+            .filter(|_| self.capture.is_none())
+            .is_none_or(FrameLatencyGate::try_take);
+        if !gate_open {
+            self.drop_frame();
+            return Ok(());
+        }
+        let drawn = match &plan {
+            retained::Plan::Keep => Ok(()),
+            retained::Plan::Full => self.render(scene, background_appearance, None),
+            retained::Plan::Within(region) => {
+                self.render(scene, background_appearance, Some(slice::from_ref(region)))
+            }
+            // KaminIDE patch (canvas.rs): the last frame moved, then the rest.
+            retained::Plan::Shift { delta, copy, redraw } => self
+                .move_canvas(*delta, *copy)
+                .and_then(|()| self.render(scene, background_appearance, Some(redraw))),
+        };
+        if let Err(e) = drawn {
+            self.forget_frames();
+            return Err(e);
+        }
+        // KaminIDE patch: stand-only check against a whole redraw (`damage_audit`).
+        if damage_audit::enabled() && !keep {
+            if let Err(e) = self.audit_frame(scene, background_appearance, &plan) {
+                log::warn!("damage audit failed: {e}");
+            }
+        }
+        self.frame_drawn(&plan);
+        if self.capture.is_some() {
+            if let Err(e) = self.capture_frame() {
+                log::warn!("frame capture failed: {e}");
+            }
+        }
+        self.present()
+    }
+
+    /// Clear the render target for `background_appearance` and encode every
+    /// primitive batch of `scene` into it, without presenting. Shared by
+    /// [`draw`](Self::draw) (which then presents) and
+    /// [`render_to_image`](Self::render_to_image) (which reads the target back
+    /// instead), so the two cannot drift.
+    ///
+    /// KaminIDE patch: with `within`, the target keeps the last frame and only
+    /// those rectangles are cleared and drawn (scissor, `retained.rs`), one
+    /// after another from the instances uploaded once; groups whose composite
+    /// cannot reach their bounds are not drawn.
+    fn render(
+        &mut self,
+        scene: &Scene,
+        background_appearance: WindowBackgroundAppearance,
+        within: Option<&[Region]>,
+    ) -> Result<()> {
+        self.ensure_drawable_resources()?;
+        self.release_unused_path_target(scene);
+        self.release_unused_effect_targets(scene);
+        self.backdrop = backdrop::opaque_backdrop(scene, self.width, self.height);
+        self.backdrop_pending = self.backdrop.is_some();
+        self.layer_cache.begin_frame();
+        let clear_color = match background_appearance {
+            WindowBackgroundAppearance::Opaque => [1.0f32; 4],
+            _ => [0.0f32; 4],
+        };
+        self.pre_draw(&clear_color, within.is_none())?;
+        // KaminIDE patch: pre_draw wrote the frame parameters for the viewport size.
+        let viewport = self.res().viewport;
+        self.blur.frame_globals = Some([viewport.Width, viewport.Height]);
+        let (device, ctx) = (self.dev().device.clone(), self.dev().device_context.clone());
+        self.gpu_timer.begin(&device, &ctx);
+        let bounds = within.and_then(|rects| rects.iter().copied().reduce(|a, b| a.union(b)));
+        let needed = within.map(|_| match bounds {
+            Some(r) => scene.groups_needed([r.x, r.y, r.width, r.height]),
+            None => vec![false; scene.groups.len()],
+        });
+        log::debug!(
+            target: "gpui::frame",
+            "plan within {within:?} groups {} needed {:?}",
+            scene.groups.len(),
+            needed.as_ref().map(|n| n.iter().filter(|&&v| v).count())
+        );
+        // KaminIDE patch: группы рисуются в свои буферы ДО кадра — в кадре
+        // от них остаётся метка, по которой готовый буфер и композитится.
+        if let Err(e) = self.render_groups(scene, needed.as_deref()) {
+            log::warn!("paint group failed: {e}");
+            self.retained.failed = true;
+        }
+        if !scene.groups.is_empty() {
+            self.gpu_timer.instrumentation.batches.count(8, scene.groups.len(), 0.0);
+            self.gpu_timer.mark(&device, &ctx, 8);
+        }
+        // Цель — снова кадр, даже если проход группы оборвался ошибкой.
+        unsafe {
+            self.dev()
+                .device_context
+                .OMSetRenderTargets(Some(slice::from_ref(&self.res().render_target_view)), None);
+        }
+        self.gpu_timer.instrumentation.batches.quad_detail(&scene.quads);
+        self.timing_main = true;
+        let drawn = match within {
+            None => self.draw_scene(scene),
+            Some(rects) => self.draw_scene_within(scene, rects, clear_color),
+        };
+        self.timing_main = false;
+        self.gpu_timer.end(&ctx);
+        drawn
+    }
+
+    /// KaminIDE patch: примитивы одной сцены — кадра или группы.
+    ///
+    /// Буферы инстансов upstream заливает один раз на сцену, а пачки рисуют
+    /// диапазоны из них; у каждой группы своя сцена, поэтому заливка — здесь,
+    /// перед её пачками. Параметры кадра (b0/b1, вьюпорт) тоже ставятся
+    /// заново: проходы размытия предыдущей группы привязывали свои.
+    fn draw_scene(&mut self, scene: &Scene) -> Result<()> {
+        self.draw_scene_at(scene, None)
+    }
+
+    /// KaminIDE patch: draw `scene`'s batches; with `base` its instances were
+    /// already uploaded as part of a larger buffer (a stage layer, see
+    /// `group_batch::upload_layer`) starting at these offsets per instance kind
+    /// (shadows, quads, underlines, monochrome, subpixel, polychrome sprites).
+    fn draw_scene_at(&mut self, scene: &Scene, base: Option<[usize; 6]>) -> Result<()> {
+        self.restore_frame_globals()?;
+        if base.is_none() {
+            self.upload_scene_buffers(scene)?;
+        }
+        let b = base.unwrap_or_default();
+
+        let annotation = self
+            .devices
+            .as_ref()
+            .and_then(|devices| devices.annotation.clone())
+            .filter(|annotation| unsafe { annotation.GetStatus().as_bool() });
+        for batch in scene.batches() {
+            // KaminIDE patch: a layer draws its own batches from its buffers.
+            if let PrimitiveBatch::Layer(index) = batch {
+                self.draw_layer(scene, index)?;
+                continue;
+            }
+            // A composite writes only its frame region (`composite_region`:
+            // the projected footprint within the clip), not its whole mask.
+            let cost = self.timing_main.then(|| match &batch {
+                PrimitiveBatch::Surfaces(r) => {
+                    let written = scene.surfaces[r.clone()].iter().map(|s| {
+                        let g = self.composite_region(s);
+                        f64::from(g.width) * f64::from(g.height)
+                    });
+                    (7, r.len(), written.sum())
+                }
+                _ => batch_area(scene, &batch),
+            });
+            let _annotation = annotation
+                .as_ref()
+                .map(|annotation| Annotation::new(annotation, HSTRING::from(batch.label())));
+            match batch {
+                PrimitiveBatch::Shadows(range) => self.draw_shadows(b[0] + range.start, range.len()),
+                PrimitiveBatch::Quads(range) => {
+                    self.draw_quads(&scene.quads[range.clone()], b[1] + range.start)
+                }
+                PrimitiveBatch::Paths(range) => self.draw_paths(&scene.paths[range]),
+                PrimitiveBatch::Underlines(range) => self.draw_underlines(b[2] + range.start, range.len()),
+                PrimitiveBatch::MonochromeSprites { texture_id, range } => {
+                    self.draw_monochrome_sprites(texture_id, b[3] + range.start, range.len())
+                }
+                PrimitiveBatch::SubpixelSprites { texture_id, range } => {
+                    self.draw_subpixel_sprites(texture_id, b[4] + range.start, range.len())
+                }
+                PrimitiveBatch::PolychromeSprites { texture_id, range } => {
+                    self.draw_polychrome_sprites(texture_id, b[5] + range.start, range.len())
+                }
+                PrimitiveBatch::Surfaces(range) => self.draw_surfaces(&scene.surfaces[range]),
+                PrimitiveBatch::Layer(_) => Ok(()),
+            }
+            .with_context(|| {
+                format!(
+                    "scene too large:\
+                    {} paths, {} shadows, {} quads, {} underlines, {} mono, {} subpixel, {} poly, {} surfaces",
+                    scene.paths.len(),
+                    scene.shadows.len(),
+                    scene.quads.len(),
+                    scene.underlines.len(),
+                    scene.monochrome_sprites.len(),
+                    scene.subpixel_sprites.len(),
+                    scene.polychrome_sprites.len(),
+                    scene.surfaces.len(),
+                )
+            })?;
+            if let Some((kind, prims, area)) = cost {
+                self.gpu_timer.instrumentation.batches.count(kind, prims, area);
+                let (device, ctx) = (self.dev().device.clone(), self.dev().device_context.clone());
+                self.gpu_timer.mark(&device, &ctx, kind);
+            }
+        }
+        Ok(())
+    }
+
+    /// KaminIDE patch: нарисовать каждую группу в свой буфер.
+    ///
+    /// Эффектам вроде размытия поддерева нужна готовая картинка целиком,
+    /// поэтому дети группы идут в текстуру её области с полем размытия.
+    /// Общий staging сохраняет viewport и точность интерполяции исходного кадра.
+    fn render_groups(&mut self, scene: &Scene, needed: Option<&[bool]>) -> Result<()> {
+        if scene.groups.is_empty() {
+            self.blur.groups.clear();
+            self.blur.group_place.clear();
+            self.blur.level_backdrop = None;
+            self.blur.group_regions.clear();
+            self.blur.group_slots.clear();
+            self.blur.group_blend.clear();
+            self.blur.group_poly.clear();
+            self.blur.group_mask.clear();
+            self.blur.group_clip.clear();
+            self.blur.group_proj.clear();
+            self.blur.group_frags.clear();
+            return Ok(());
+        }
+        let device = self.dev().device.clone();
+        let dc = self.dev().device_context.clone();
+        // KaminIDE patch: images kept from the last frame (`group_cache`).
+        let reuse = self.prepare_group_targets(scene)?;
+        let kept = reuse.iter().filter(|&&k| k).count();
+        let mut valid = reuse.clone();
+        self.retained.groups.valid.clear();
+        // A pass that failed last frame may have left its rectangles in the stage.
+        self.clear_group_stage()?;
+        self.blur.group_slots.clear();
+        self.blur.group_blend.clear();
+        self.blur.group_poly.clear();
+        self.blur.group_mask.clear();
+        self.blur.group_clip.clear();
+        self.blur.group_proj.clear();
+        self.blur.group_frags.clear();
+        // KaminIDE patch: per-group composite data first (nested composites of an
+        // outer group read it while the outer group is drawn).
+        for (i, group) in scene.groups.iter().enumerate() {
+            self.blur.group_slots.push(i);
+            self.blur.group_blend.push(group.blend);
+            let mut poly = [[0.0f32; 4]; 4];
+            for (i, point) in group.polygon.iter().take(8).enumerate() {
+                poly[i / 2][(i % 2) * 2] = point.x.0;
+                poly[i / 2][(i % 2) * 2 + 1] = point.y.0;
+            }
+            self.blur
+                .group_poly
+                .push((
+                    poly,
+                    group.polygon.len().min(8) as u32
+                        | if group.polygon_inverse { 16 } else { 0 },
+                ));
+            self.blur.group_proj.push(match group.projection {
+                Some(h) => [[h[0], h[1], h[2], 0.0], [h[3], h[4], h[5], 0.0], [h[6], h[7], h[8], 1.0]],
+                None => [[0.0; 4]; 3],
+            });
+            self.blur
+                .group_frags
+                .push(group.fragments.iter().map(|f| pack_poly(f)).collect());
+            let mask = group.mask.as_ref().and_then(|img| {
+                let srv = match self.blur.mask_cache.get(img.id) {
+                    Some(srv) => srv,
+                    None => {
+                        let size = img.size(0);
+                        let (mw, mh) = (size.width.0.max(1) as u32, size.height.0.max(1) as u32);
+                        let bytes = img.as_bytes(0)?;
+                        if bytes.len() < (mw * mh * 4) as usize {
+                            return None;
+                        }
+                        let upload = create_mask_texture(&device, mw, mh, bytes).log_err()?;
+                        if self.gpu_timer.instrumentation.config().gpu_timing {
+                            self.gpu_timer.instrumentation.batches.mask_uploaded(
+                                gpu_memory::texture_bytes(&upload.texture),
+                            );
+                        }
+                        self.blur.mask_cache.insert(img.id, upload)
+                    }
+                };
+                Some((
+                    srv,
+                    [
+                        group.mask_bounds.origin.x.0,
+                        group.mask_bounds.origin.y.0,
+                        group.mask_bounds.size.width.0.max(1.0),
+                        group.mask_bounds.size.height.0.max(1.0),
+                    ],
+                    group.mask_once as f32,
+                ))
+            });
+            self.blur.group_mask.push(mask);
+            self.blur
+                .group_clip
+                .push(group.mask_clip.unwrap_or([0.0; 4]));
+        }
+        // KaminIDE patch: consecutive groups that can join a stage layer are drawn
+        // layer by layer (`group_batch::draw_group_layers`); any other group ends
+        // the segment, so its nested groups are in the atlas before it is drawn.
+        self.blur.layer.clear();
+        log::debug!(
+            target: "gpui::frame",
+            "groups {} reused {}",
+            scene.groups.len(),
+            reuse.iter().filter(|&&r| r).count()
+        );
+        let mut segment = Vec::new();
+        for (i, group) in scene.groups.iter().enumerate() {
+            // KaminIDE patch: a frame drawn within a rectangle skips groups no
+            // composite in it needs (`Scene::groups_needed`).
+            if reuse[i] || needed.is_some_and(|n| !n.get(i).copied().unwrap_or(true)) {
+                continue;
+            }
+            valid[i] = true;
+            if group_batch::joins_layer(group) {
+                segment.push(i);
+                continue;
+            }
+            self.draw_group_layers(&scene.groups, &mut segment)?;
+            // KaminIDE patch: a direct Gaussian writes the atlas rectangle itself.
+            self.draw_group_alone(i, group)?;
+        }
+        self.draw_group_layers(&scene.groups, &mut segment)?;
+        // KaminIDE patch: one kept image per frame is drawn again (group_scrub).
+        self.scrub_kept_group(scene, &reuse)?;
+        self.groups_kept(scene, valid, kept);
+
+        // Вернуть состояние кадра: цель и вьюпорт меняли проходы групп.
+        unsafe {
+            dc.OMSetRenderTargets(Some(slice::from_ref(&self.res().render_target_view)), None);
+            dc.RSSetViewports(Some(slice::from_ref(&self.res().viewport)));
+        }
+        self.restore_frame_globals()
+    }
+
+    /// KaminIDE patch: draw the scene of `group` into the frame-domain stage,
+    /// scissored to its stage region `raw`.
+    pub(super) fn draw_group_content(
+        &mut self,
+        group: &gpui::PaintGroup,
+        raw: Region,
+        base: Option<[usize; 6]>,
+    ) -> Result<()> {
+        let dc = self.dev().device_context.clone();
+        let rasterizer = self.begin_group_stage(raw)?;
+        let raw_rtv = self.blur.stage.as_ref().unwrap().rtv.clone();
+        unsafe {
+            dc.OMSetRenderTargets(Some(&raw_rtv), None);
+            dc.RSSetViewports(Some(slice::from_ref(&self.res().viewport)));
+        }
+        self.group_target = Some(raw_rtv);
+        self.group_target_tex = Some(self.blur.stage.as_ref().unwrap().texture.clone());
+        let drawn = self.draw_scene_at(&group.scene, base);
+        unsafe { dc.RSSetState(&rasterizer) };
+        self.group_target = None;
+        self.group_target_tex = None;
+        drawn
+    }
+
+    /// KaminIDE patch: размыть готовый буфер группы (`filter: blur(N)`).
+    fn blur_group(&mut self, index: usize, group: &gpui::PaintGroup) -> Result<()> {
+        let device = self.dev().device.clone();
+        let dc = self.dev().device_context.clone();
+        let (vw, vh) = (self.width as f32, self.height as f32);
+        // Шаг каскада от радиуса: делитель подобран сравнением с Chrome на
+        // фикстуре blur.html — при 8 (как у фона) размытие выходило заметно
+        // шире браузерного.
+        let strength = (group.blur_radius / 14.0).clamp(0.2, 6.0);
+        // Поля под растекание: размытая картинка шире исходной.
+        let margin = (24.0 * strength).min(96.0);
+        let bx = (group.bounds.origin.x.0 - margin).max(0.0).floor();
+        let by = (group.bounds.origin.y.0 - margin).max(0.0).floor();
+        let bx1 = (group.bounds.origin.x.0 + group.bounds.size.width.0 + margin)
+            .min(vw)
+            .ceil();
+        let by1 = (group.bounds.origin.y.0 + group.bounds.size.height.0 + margin)
+            .min(vh)
+            .ceil();
+        let (rw, rh) = (bx1 - bx, by1 - by);
+        if rw < 8.0 || rh < 8.0 {
+            return Ok(());
+        }
+
+        let src = self.blur.stage.as_ref().unwrap().srv.clone();
+        self.blur_cascade(
+            &src,
+            (vw, vh),
+            (bx, by, rw, rh),
+            strength,
+            true,
+            [0.0; 4],
+        )?;
+
+        // KaminIDE patch: апсемпл тоже использует исходный viewport, затем Copy
+        // переносит точные пиксели в ограниченную сохранённую текстуру.
+        self.clear_group_stage()?;
+        self.blur.stage_dirty.push(self.blur.group_regions[index]);
+        let dest_rtv = self.blur.stage.as_ref().unwrap().rtv.clone();
+        let last = self.blur.down[2].srv.clone();
+        let (lw, lh) = (
+            self.blur.down[2].width as f32,
+            self.blur.down[2].height as f32,
+        );
+        update_buffer(
+            &dc,
+            self.blur.globals[0].as_ref().unwrap(),
+            &[global_params(self.font_info, [vw, vh])],
+        )?;
+        let quad = BlurQuad {
+            bounds: [bx, by, rw, rh],
+            content_mask: [bx, by, rw, rh],
+            corner_radii: [0.0; 4],
+            src_origin: [0.0, 0.0],
+            src_scale: [1.0, 1.0],
+            texel: [1.0 / lw, 1.0 / lh],
+            blur_pass: 2.0,
+            pad: 0.0,
+            blend_mode: 0,
+            poly_count: 0,
+            pad2: [0.0; 2],
+            poly: [[0.0; 4]; 4],
+            mask_rect: [0.0; 4],
+            mask_clip: [0.0; 4],
+            proj: [[0.0; 4]; 3],
+            source_rect: [0.0; 4],
+            backdrop_rect: [0.0; 4],
+        };
+        self.pipelines
+            .blur_pipeline
+            .update_buffer(&device, &dc, &[quad])?;
+        unsafe {
+            dc.OMSetRenderTargets(Some(&dest_rtv), None);
+        }
+        let blend = self.premultiplied_blend()?;
+        self.pipelines.blur_pipeline.draw_with_texture_blended(
+            &dc,
+            &last,
+            slice::from_ref(&self.res().viewport),
+            &self.blur.globals,
+            slice::from_ref(&self.globals.sampler),
+            1,
+            Some(&blend),
+        )
+    }
+
+    /// KaminIDE patch: каскад уменьшений области текстуры.
+    ///
+    /// Широкое размытие одним фильтром стоит квадрат радиуса выборок; цепочка
+    /// /2 → /4 → /8 с tent-фильтром даёт ту же мягкость за десятки.
+    fn blur_cascade(
+        &mut self,
+        src: &[Option<ID3D11ShaderResourceView>; 1],
+        src_size: (f32, f32),
+        region: (f32, f32, f32, f32),
+        strength: f32,
+        keep_alpha: bool,
+        source_rect: [f32; 4],
+    ) -> Result<()> {
+        let device = self.dev().device.clone();
+        let dc = self.dev().device_context.clone();
+        // Прозрачность значима только у групп — там цвет премультиплирован.
+        let blend = if keep_alpha {
+            Some(self.premultiplied_blend()?)
+        } else {
+            None
+        };
+        let (bx, by, rw, rh) = region;
+        let step = |d: f32| -> (u32, u32) { (((rw / d) as u32).max(1), ((rh / d) as u32).max(1)) };
+        let sizes = [
+            step(2.0 * strength),
+            step(4.0 * strength),
+            step(8.0 * strength),
+        ];
+        if self.blur.down.len() != 3
+            || self
+                .blur
+                .down
+                .iter()
+                .zip(sizes.iter())
+                .any(|(t, s)| t.width != s.0 || t.height != s.1)
+        {
+            self.blur.down.clear();
+            for (w, h) in sizes {
+                self.blur
+                    .down
+                    .push(create_blur_texture(&device, w, h, true)?);
+            }
+        }
+        self.ensure_blur_globals(&device)?;
+
+        blur_down_pass(
+            &device,
+            &dc,
+            &mut self.pipelines.blur_pipeline,
+            &self.blur.globals,
+            slice::from_ref(if source_rect[2] > 0.0 {
+                &self.globals.group_samplers[texture_pool::sampler_index(source_rect, src_size)]
+            } else {
+                &self.globals.sampler
+            }),
+            self.font_info,
+            &self.blur.down[0],
+            src,
+            src_size,
+            [bx / src_size.0, by / src_size.1],
+            [rw / src_size.0, rh / src_size.1],
+            keep_alpha,
+            source_rect,
+            blend.as_ref(),
+        )?;
+        // split_at: цель и источник — разные элементы одного вектора.
+        let (a, b) = self.blur.down.split_at(1);
+        blur_down_pass(
+            &device,
+            &dc,
+            &mut self.pipelines.blur_pipeline,
+            &self.blur.globals,
+            slice::from_ref(&self.globals.sampler),
+            self.font_info,
+            &b[0],
+            &a[0].srv,
+            (a[0].width as f32, a[0].height as f32),
+            [0.0, 0.0],
+            [1.0, 1.0],
+            keep_alpha,
+            [0.0; 4],
+            blend.as_ref(),
+        )?;
+        blur_down_pass(
+            &device,
+            &dc,
+            &mut self.pipelines.blur_pipeline,
+            &self.blur.globals,
+            slice::from_ref(&self.globals.sampler),
+            self.font_info,
+            &b[1],
+            &b[0].srv,
+            (b[0].width as f32, b[0].height as f32),
+            [0.0, 0.0],
+            [1.0, 1.0],
+            keep_alpha,
+            [0.0; 4],
+            blend.as_ref(),
+        )
+    }
+
+    /// KaminIDE patch: свой буфер параметров у проходов размытия — их вьюпорты
+    /// не равны вьюпорту кадра.
+    fn ensure_blur_globals(&mut self, device: &ID3D11Device) -> Result<()> {
+        if self.blur.globals[0].is_some() {
+            return Ok(());
+        }
+        let desc = D3D11_BUFFER_DESC {
+            ByteWidth: std::mem::size_of::<GlobalParams>() as u32,
+            Usage: D3D11_USAGE_DYNAMIC,
+            BindFlags: D3D11_BIND_CONSTANT_BUFFER.0 as u32,
+            CPUAccessFlags: D3D11_CPU_ACCESS_WRITE.0 as u32,
+            ..Default::default()
+        };
+        let mut buffer = None;
+        unsafe { device.CreateBuffer(&desc, None, Some(&mut buffer))? };
+        self.blur.globals[0] = buffer;
+        Ok(())
+    }
+
+    /// KaminIDE patch: вернуть параметры кадра после проходов с чужим вьюпортом.
+    ///
+    /// Upstream привязывает b0/b1 и вьюпорт один раз в `pre_draw`, а проходы
+    /// размытия ставят свои (буфер `blur.globals`, вьюпорт уменьшенной
+    /// текстуры) — поэтому здесь не только заливка, но и повторная привязка.
+    fn restore_frame_globals(&mut self) -> Result<()> {
+        let device_context = &self.dev().device_context;
+        let viewport = self.res().viewport;
+        // KaminIDE patch: the frame parameters are written once per frame (pre_draw);
+        // passes with other viewports use their own buffer (`blur.globals`), so
+        // only the bindings need restoring, once per group instead of a Map each.
+        let size = [self.width as f32, self.height as f32];
+        if self.blur.frame_globals != Some(size) {
+            update_buffer(
+                device_context,
+                self.globals.global_params_buffer.as_ref().unwrap(),
+                &[global_params(self.font_info, size)],
+            )?;
+            self.blur.frame_globals = Some(size);
+        }
+        let device_context = &self.dev().device_context;
+        unsafe {
+            device_context.RSSetViewports(Some(slice::from_ref(&viewport)));
+            device_context
+                .VSSetConstantBuffers(0, Some(slice::from_ref(&self.globals.global_params_buffer)));
+            device_context
+                .VSSetConstantBuffers(1, Some(slice::from_ref(&self.globals.batch_params_buffer)));
+            device_context
+                .PSSetConstantBuffers(0, Some(slice::from_ref(&self.globals.global_params_buffer)));
+        }
+        Ok(())
+    }
+
+    /// Render `scene` to an offscreen CPU image **without presenting** so
+    /// the window need never be shown or visible (the macOS headless path
+    /// goes through MetalRenderer; this is the Windows analogue). Draws into
+    /// the existing render target, copies it into a `D3D11_USAGE_STAGING`
+    /// texture, maps it, and converts BGRA to RGBA.
+    pub(crate) fn render_to_image(
+        &mut self,
+        scene: &Scene,
+        background_appearance: WindowBackgroundAppearance,
+    ) -> Result<image::RgbaImage> {
+        // A pending device-lost recovery (`skip_draws`) leaves the atlas holding
+        // tile references from the previous device; drawing before the forced
+        // re-render rebuilds them panics in `DirectXAtlasTextures::texture`.
+        anyhow::ensure!(
+            !self.skip_draws,
+            "render_to_image unavailable while recovering from a lost device"
+        );
+        // KaminIDE patch: the target now holds a frame outside the window's
+        // sequence of compared scenes (`retained.rs`).
+        self.forget_frames();
+        self.render(scene, background_appearance, None)?;
+
+        let devices = self.devices.as_ref().context("devices missing")?;
+        let device = &devices.device;
+        let context = &devices.device_context;
+        let resources = self.resources.as_ref().context("resources missing")?;
+        let render_target = resources
+            .render_target
+            .as_ref()
+            .context("render target missing")?;
+
+        // A CPU-readable copy of the render target.
+        let mut desc = D3D11_TEXTURE2D_DESC::default();
+        unsafe { render_target.GetDesc(&mut desc) };
+        let width = desc.Width;
+        let height = desc.Height;
+        let staging_desc = D3D11_TEXTURE2D_DESC {
+            Usage: D3D11_USAGE_STAGING,
+            BindFlags: 0,
+            CPUAccessFlags: D3D11_CPU_ACCESS_READ.0 as u32,
+            MiscFlags: 0,
+            MipLevels: 1,
+            ArraySize: 1,
+            SampleDesc: DXGI_SAMPLE_DESC {
+                Count: 1,
+                Quality: 0,
+            },
+            ..desc
+        };
+        let mut staging: Option<ID3D11Texture2D> = None;
+        unsafe { device.CreateTexture2D(&staging_desc, None, Some(&mut staging))? };
+        let staging = staging.context("creating staging texture")?;
+        unsafe { context.CopyResource(&staging, render_target) };
+
+        let mut mapped = D3D11_MAPPED_SUBRESOURCE::default();
+        unsafe { context.Map(&staging, 0, D3D11_MAP_READ, 0, Some(&mut mapped))? };
+        let row_bytes = (width as usize) * 4;
+        let mut pixels = vec![0u8; row_bytes * height as usize];
+        // SAFETY: `Map` succeeded, so `pData` points at `RowPitch * height`
+        // readable bytes for as long as the mapping is held, and `RowPitch >=
+        // row_bytes` (it only ever adds trailing padding). `pixels` is sized
+        // `row_bytes * height`, so every copy stays in bounds on both sides,
+        // and the regions cannot overlap (`pixels` is a fresh allocation).
+        unsafe {
+            let src = mapped.pData as *const u8;
+            for row in 0..height as usize {
+                let s = src.add(row * mapped.RowPitch as usize);
+                let d = pixels.as_mut_ptr().add(row * row_bytes);
+                std::ptr::copy_nonoverlapping(s, d, row_bytes);
+            }
+            context.Unmap(&staging, 0);
+        }
+        // The render target is BGRA; image::RgbaImage expects RGBA.
+        for px in pixels.chunks_exact_mut(4) {
+            px.swap(0, 2);
+        }
+        image::RgbaImage::from_raw(width, height, pixels)
+            .context("Failed to build RgbaImage from staging readback")
+    }
+
+    pub(crate) fn resize(&mut self, new_size: Size<DevicePixels>) -> Result<()> {
+        let width = new_size.width.0.max(1) as u32;
+        let height = new_size.height.0.max(1) as u32;
+        if self.width == width && self.height == height && self.ensure_drawable_resources().is_ok()
+        {
+            return Ok(());
+        }
+        self.width = width;
+        self.height = height;
+
+        self.resize_with(|resources, devices| {
+            // KaminIDE patch: an offscreen target is simply recreated.
+            if let Some(swap_chain) = &resources.swap_chain {
+                unsafe {
+                    swap_chain.ResizeBuffers(
+                        BUFFER_COUNT as u32,
+                        width,
+                        height,
+                        RENDER_TARGET_FORMAT,
+                        DXGI_SWAP_CHAIN_FLAG_FRAME_LATENCY_WAITABLE_OBJECT,
+                    )
+                    .context("Failed to resize swap chain")?;
+                }
+            }
+            resources.recreate_resources(devices, width, height)
+        })
+    }
+
+    fn resize_with(
+        &mut self,
+        recreate: impl FnOnce(&mut DirectXResources, &DirectXRendererDevices) -> Result<()>,
+    ) -> Result<()> {
+        // KaminIDE patch: recreated buffers hold no known frame (`retained.rs`).
+        self.forget_target();
+        self.release_path_target();
+        let devices = self.devices.as_ref().context("devices missing")?;
+        unsafe { devices.device_context.OMSetRenderTargets(None, None) };
+        let resources = self.resources.as_mut().context("resources missing")?;
+        resources.render_target.take();
+        resources.render_target_view.take();
+        // KaminIDE patch: ResizeBuffers needs every reference to the buffers released.
+        resources.back_buffer.take();
+        recreate(resources, devices)?;
+
+        unsafe {
+            devices
+                .device_context
+                .OMSetRenderTargets(Some(slice::from_ref(&resources.render_target_view)), None);
+        }
+
+        Ok(())
+    }
+
+    fn upload_scene_buffers(&mut self, scene: &Scene) -> Result<()> {
+        let devices = self.devices.as_ref().context("devices missing")?;
+
+        if !scene.shadows.is_empty() {
+            self.pipelines.shadow_pipeline.update_buffer(
+                &devices.device,
+                &devices.device_context,
+                &scene.shadows,
+            )?;
+        }
+
+        self.pipelines.quad_pipeline.upload_gradients(
+            &devices.device, &devices.device_context, &scene.gradient_data())?;
+        if !scene.quads.is_empty() {
+            self.pipelines.quad_pipeline.update_buffer(
+                &devices.device,
+                &devices.device_context,
+                &scene.quads,
+            )?;
+        }
+
+        if !scene.underlines.is_empty() {
+            self.pipelines.underline_pipeline.update_buffer(
+                &devices.device,
+                &devices.device_context,
+                &scene.underlines,
+            )?;
+        }
+
+        if !scene.monochrome_sprites.is_empty() {
+            self.pipelines.mono_sprites.update_buffer(
+                &devices.device,
+                &devices.device_context,
+                &scene.monochrome_sprites,
+            )?;
+        }
+
+        if !scene.subpixel_sprites.is_empty() {
+            self.pipelines.subpixel_sprites.update_buffer(
+                &devices.device,
+                &devices.device_context,
+                &scene.subpixel_sprites,
+            )?;
+        }
+
+        if !scene.polychrome_sprites.is_empty() {
+            self.pipelines.poly_sprites.update_buffer(
+                &devices.device,
+                &devices.device_context,
+                &scene.polychrome_sprites,
+            )?;
+        }
+
+        Ok(())
+    }
+
+    fn draw_shadows(&mut self, start: usize, len: usize) -> Result<()> {
+        if len == 0 {
+            return Ok(());
+        }
+        let devices = self.devices.as_ref().context("devices missing")?;
+        self.pipelines.shadow_pipeline.draw_range(
+            &devices.device_context,
+            self.globals
+                .batch_params_buffer
+                .as_ref()
+                .context("batch params buffer missing")?,
+            start as u32,
+            len as u32,
+        )
+    }
+
+    /// `quads` are the batch's instances, uploaded at `start` of the quad buffer.
+    fn draw_quads(&mut self, quads: &[Quad], start: usize) -> Result<()> {
+        // KaminIDE patch: фон окна уже лёг очисткой кадра (`backdrop`). Буферы
+        // групп очищаются прозрачным — там первый квад рисуется как есть.
+        let skip = start == 0 && self.backdrop_pending && self.group_target.is_none();
+        if self.group_target.is_none() {
+            self.backdrop_pending = false;
+        }
+        let (quads, start) = if skip { (quads.get(1..).unwrap_or_default(), 1) } else { (quads, start) };
+        let devices = self.devices.as_ref().context("devices missing")?;
+        let params = self
+            .globals
+            .batch_params_buffer
+            .as_ref()
+            .context("batch params buffer missing")?;
+        let pipeline = &self.pipelines.quad_pipeline;
+        for (analytic, first, len) in analytic_gradient::program_runs(quads, start) {
+            if analytic {
+                pipeline.bind_gradients(&devices.device_context);
+                pipeline.draw_range_with_program(
+                    &devices.device_context,
+                    params,
+                    first as u32,
+                    len as u32,
+                    self.pipelines.quad_gradient.fragment(&devices.device)?,
+                )?;
+            } else {
+                pipeline.draw_range(&devices.device_context, params, first as u32, len as u32)?;
+            }
+        }
+        Ok(())
+    }
+
