@@ -0,0 +1,113 @@
+//! KaminIDE patch (BR-31A): presenting without blocking the UI thread.
+//!
+//! The frame-latency gate (#76) keeps one frame in the compositor queue and
+//! drops a frame instead of waiting for it. `Present` itself must not wait
+//! either: while the GPU or the compositor was behind, a plain `Present`
+//! blocked the UI thread for about 1 s per frame, and webview pulls, which
+//! run between frames, waited behind it. A dropped frame is presented by the
+//! next paint (`DirectXRenderer::needs_presentation`).
+
+use std::cell::Cell;
+use std::sync::atomic::Ordering::Relaxed;
+use std::time::Duration;
+
+use anyhow::{Context, Result};
+use windows::Win32::Foundation::{CloseHandle, HANDLE, WAIT_OBJECT_0};
+use windows::Win32::Graphics::Dxgi::DXGI_ERROR_WAS_STILL_DRAWING;
+use windows::Win32::System::Threading::WaitForSingleObject;
+use windows::core::HRESULT;
+
+/// The waitable object of the swap chain (latency 1); closed when the
+/// resources are recreated (device lost, resize to a new swap chain).
+pub(super) struct FrameLatencyGate {
+    handle: HANDLE,
+    /// A count taken from the gate whose frame has not been queued yet. A
+    /// dropped `Present` keeps it: the gate is signaled only when a queued
+    /// frame retires, so waiting again would lose the count for good and
+    /// close the gate.
+    held: Cell<bool>,
+}
+
+impl FrameLatencyGate {
+    pub(super) fn new(handle: HANDLE) -> Self {
+        Self {
+            handle,
+            held: Cell::new(false),
+        }
+    }
+
+    /// True when a frame may be queued now; never waits.
+    pub(super) fn try_take(&self) -> bool {
+        if self.held.get() {
+            return true;
+        }
+        let taken = unsafe { WaitForSingleObject(self.handle, 0) } == WAIT_OBJECT_0;
+        self.held.set(taken);
+        taken
+    }
+
+    /// The frame of the held count was queued.
+    pub(super) fn spend(&self) {
+        self.held.set(false);
+    }
+}
+
+impl Drop for FrameLatencyGate {
+    fn drop(&mut self) {
+        unsafe {
+            let _ = CloseHandle(self.handle);
+        }
+    }
+}
+
+/// Whether a `Present(.., DXGI_PRESENT_DO_NOT_WAIT)` result queued the frame.
+pub(super) fn frame_shown(result: HRESULT) -> Result<bool> {
+    if result == DXGI_ERROR_WAS_STILL_DRAWING {
+        return Ok(false);
+    }
+    result.ok().context("Presenting swap chain failed")?;
+    Ok(true)
+}
+
+pub(super) fn count_present_call(spent: Duration) {
+    let us = u32::try_from(spent.as_micros()).unwrap_or(u32::MAX);
+    gpui::frame_perf::SWAP_US.fetch_add(us, Relaxed);
+}
+
+pub(super) fn count_dropped_frame() {
+    gpui::frame_perf::DROPPED_FRAMES.fetch_add(1, Relaxed);
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use windows::Win32::Foundation::S_OK;
+    use windows::Win32::Graphics::Dxgi::DXGI_ERROR_DEVICE_REMOVED;
+    use windows::Win32::System::Threading::{CreateSemaphoreW, ReleaseSemaphore};
+
+    fn gate(count: i32) -> FrameLatencyGate {
+        FrameLatencyGate::new(unsafe { CreateSemaphoreW(None, count, 1, None) }.unwrap())
+    }
+
+    #[test]
+    fn a_present_that_would_wait_drops_the_frame() {
+        assert!(!frame_shown(DXGI_ERROR_WAS_STILL_DRAWING).unwrap());
+        assert!(frame_shown(S_OK).unwrap());
+        // DXGI_STATUS_OCCLUDED is a success code: the frame was queued.
+        assert!(frame_shown(HRESULT(0x087A_0001)).unwrap());
+        assert!(frame_shown(DXGI_ERROR_DEVICE_REMOVED).is_err());
+    }
+
+    #[test]
+    fn a_dropped_frame_keeps_its_gate_count() {
+        let g = gate(1);
+        assert!(g.try_take());
+        // Present dropped the frame: no spend, so the next attempt may queue
+        // although nothing will signal the gate for this frame.
+        assert!(g.try_take());
+        g.spend();
+        assert!(!g.try_take(), "queued frame has not retired yet");
+        unsafe { ReleaseSemaphore(g.handle, 1, None) }.unwrap();
+        assert!(g.try_take());
+    }
+}
diff --git a/vendor/gpui-windows/src/directx_renderer/quad_clear.rs b/vendor/gpui-windows/src/directx_renderer/quad_clear.rs
new file mode 100644
index 0000000000000000000000000000000000000000..f4e892eb7deb669e5a2b55edc00fba207fd66caf
--- /dev/null
+++ b/vendor/gpui-windows/src/directx_renderer/quad_clear.rs
@@ -0,0 +1,49 @@
+//! KaminIDE patch: the frame clear is a draw, not `ClearRenderTargetView`.
+//!
+//! On Intel Iris Xe (driver 32.0.101.7085) the hardware clear of the frame
+//! target is not reliably ordered before the draws that follow it: about one
+//! frame in twenty of an unchanged scene came out with a single wrong pixel
+//! inside a glyph, at a random place. The scene was byte-identical between the
+//! right and the wrong frame, two readbacks of the same target agreed, and the
+//! wrong colour (per-channel coverage 0.89 / 0.56 / 0.40 for one monochrome
+//! sprite) is not one a sprite can blend. Zero-initialised or padded atlas
+//! tiles and point sampling kept the fault; drawing the clear removed it
+//! (0 of 130 processes against 4.4 % with the hardware clear). WebRender works
+//! around the same driver behaviour by clearing its caches with quads
+//! (`webrender/src/renderer/init.rs:172`, `clear_caches_with_quads`).
+//!
+//! The clear is a strip over the whole target with blending off, so the
+//! target takes the colour exactly as `ClearRenderTargetView` wrote it: the
+//! pixel shader output converts to UNORM like the clear value does. Its cost
+//! was below the noise on both adapters (warm frames of text-200 and a page of
+//! many paragraphs, 10 interleaved pairs on Intel Iris Xe and RTX 4080), so it
+//! replaces the hardware clear on every adapter.
+
+use super::*;
+
+/// The colour of the frame clear (`clear_colors` in `shaders.hlsl`).
+#[derive(Clone, Copy)]
+#[repr(C)]
+pub(super) struct ClearColor {
+    color: [f32; 4],
+}
+
+impl DirectXRenderer {
+    /// Fill the bound frame target with `color`: one draw with blending off,
+    /// after the target, its viewport and the frame parameters are bound.
+    pub(super) fn clear_frame(&mut self, color: [f32; 4]) -> Result<()> {
+        let devices = self.devices.as_ref().context("devices missing")?;
+        let pipeline = &mut self.pipelines.clear_pipeline;
+        pipeline.update_buffer(
+            &devices.device,
+            &devices.device_context,
+            &[ClearColor { color }],
+        )?;
+        pipeline.draw(
+            &devices.device_context,
+            D3D_PRIMITIVE_TOPOLOGY_TRIANGLESTRIP,
+            4,
+            1,
+        )
+    }
+}
diff --git a/vendor/gpui-windows/src/directx_renderer/recovery.rs b/vendor/gpui-windows/src/directx_renderer/recovery.rs
new file mode 100644
index 0000000000000000000000000000000000000000..7c415a7e31aaf60596ce59bd82631fc533558716
--- /dev/null
+++ b/vendor/gpui-windows/src/directx_renderer/recovery.rs
@@ -0,0 +1,137 @@
+//! Build replacements off to the side: failed allocations drop only local owners.
+
+use super::*;
+
+pub(super) struct RecoveryResources {
+    pub(super) devices: DirectXRendererDevices,
+    pub(super) resources: DirectXResources,
+    pub(super) globals: DirectXGlobalElements,
+    pub(super) pipelines: DirectXRenderPipelines,
+    pub(super) direct_composition: Option<DirectComposition>,
+}
+
+impl RecoveryResources {
+    pub(super) fn new(
+        directx_devices: &DirectXDevices,
+        width: u32,
+        height: u32,
+        hwnd: HWND,
+        disable_direct_composition: bool,
+        offscreen: bool,
+    ) -> Result<Self> {
+        let devices = DirectXRendererDevices::new(directx_devices, disable_direct_composition)
+            .context("Recreating DirectX devices")?;
+        // KaminIDE patch: an offscreen renderer recovers an offscreen target.
+        let resources = if offscreen {
+            DirectXResources::new_offscreen(&devices, width, height)
+        } else {
+            DirectXResources::new(&devices, width, height, hwnd, disable_direct_composition)
+        }
+        .context("Creating DirectX resources")?;
+        let globals = DirectXGlobalElements::new(&devices.device)
+            .context("Creating DirectXGlobalElements")?;
+        let pipelines = DirectXRenderPipelines::new(&devices.device)
+            .context("Creating DirectXRenderPipelines")?;
+        let direct_composition = if disable_direct_composition || offscreen {
+            None
+        } else {
+            let composition = DirectComposition::new(devices.dxgi_device.as_ref().unwrap(), hwnd)?;
+            composition.set_swap_chain(resources.swap_chain()?)?;
+            Some(composition)
+        };
+        Ok(Self {
+            devices,
+            resources,
+            globals,
+            pipelines,
+            direct_composition,
+        })
+    }
+}
+
+impl DirectXRenderer {
+    pub(super) fn handle_device_lost_impl(
+        &mut self,
+        directx_devices: &DirectXDevices,
+    ) -> Result<()> {
+        let (width, height, hwnd, offscreen) = (self.width, self.height, self.hwnd, self.offscreen);
+        self.recover_with(|disabled| {
+            RecoveryResources::new(directx_devices, width, height, hwnd, disabled, offscreen)
+        })
+    }
+
+    pub(super) fn recover_with(
+        &mut self,
+        recreate: impl FnOnce(bool) -> Result<RecoveryResources>,
+    ) -> Result<()> {
+        // Failed allocation must leave drawing disabled, including after retry exhaustion.
+        self.skip_draws = true;
+        self.clear_effect_resources();
+        // KaminIDE patch: the kept frame and its device objects die with the device.
+        self.reset_retained();
+        unsafe {
+            #[cfg(debug_assertions)]
+            if let Some(devices) = &self.devices {
+                report_live_objects(&devices.device)
+                    .context("Failed to report live objects after device lost")
+                    .log_err();
+            }
+
+            self.resources.take();
+            if let Some(devices) = &self.devices {
+                devices.device_context.OMSetRenderTargets(None, None);
+                devices.device_context.ClearState();
+                devices.device_context.Flush();
+                #[cfg(debug_assertions)]
+                report_live_objects(&devices.device)
+                    .context("Failed to report live objects after device lost")
+                    .log_err();
+            }
+
+            self.direct_composition.take();
+            self.devices.take();
+        }
+
+        let RecoveryResources {
+            devices,
+            resources,
+            globals,
+            pipelines,
+            direct_composition,
+        } = recreate(self.disable_direct_composition)?;
+
+        self.atlas
+            .handle_device_lost(&devices.device, &devices.device_context);
+
+        unsafe {
+            devices
+                .device_context
+                .OMSetRenderTargets(Some(slice::from_ref(&resources.render_target_view)), None);
+        }
+        self.devices = Some(devices);
+        self.resources = Some(resources);
+        self.globals = globals;
+        self.pipelines = pipelines;
+        self.direct_composition = direct_composition;
+        Ok(())
+    }
+
+    pub(super) fn clear_effect_resources(&mut self) {
+        // Every effect target, mask and blend state belongs to the old device.
+        self.blur = BlurScratch::default();
+        self.group_target = None;
+        self.group_target_tex = None;
+        self.blend_premultiplied = None;
+        self.blend_replace = None;
+    }
+
+    pub(super) fn ensure_drawable_resources(&self) -> Result<()> {
+        let resources = self.resources.as_ref().context("resources missing")?;
+        anyhow::ensure!(self.devices.is_some(), "devices missing");
+        anyhow::ensure!(
+            resources.render_target.is_some() && resources.render_target_view.is_some(),
+            "render target unavailable after failed resize"
+        );
+        Ok(())
+    }
+}
diff --git a/vendor/gpui-windows/src/directx_renderer/recovery_tests.rs b/vendor/gpui-windows/src/directx_renderer/recovery_tests.rs
new file mode 100644
index 0000000000000000000000000000000000000000..d3432f8a2c42f73bcef325254289139c20712566
--- /dev/null
+++ b/vendor/gpui-windows/src/directx_renderer/recovery_tests.rs
@@ -0,0 +1,216 @@
+//! Headless COM ownership regressions; never create a HWND. Only `present`
+//! hands frames to a composition swap chain that no visual shows.
+
+use super::recovery::RecoveryResources;
+use super::{
+    BUFFER_COUNT, BlurScratch, DirectXAtlas, DirectXDevices, DirectXGlobalElements,
+    DirectXRenderPipelines, DirectXRenderer, DirectXRendererDevices, DirectXResources, FontInfo,
+    RENDER_TARGET_FORMAT, create_blur_texture, create_path_intermediate_msaa_texture_and_view,
+    create_path_intermediate_texture, create_render_target_and_its_view,
+    try_to_recover_from_device_lost,
+};
+use gpui::{DevicePixels, ImageId, Scene, Size, WindowBackgroundAppearance};
+use std::sync::Arc;
+use windows::Win32::{
+    Foundation::HWND, Graphics::Dxgi::DXGI_SWAP_CHAIN_FLAG_FRAME_LATENCY_WAITABLE_OBJECT,
+};
+
+mod fixtures;
+use fixtures::*;
+// KaminIDE patch: offscreen targets share these headless fixtures.
+mod offscreen;
+// KaminIDE patch (R4): a frame redrawn within its damage equals the whole frame.
+mod damage;
+// KaminIDE patch (BR-31A): dropped frames are presented by the next paint.
+mod present;
+
+#[test]
+fn effects_follow_device_generation_after_repeated_recovery() {
+    let a = DirectXDevices::new().unwrap();
+    let b = DirectXDevices::new().unwrap();
+    assert_ne!(a.device, b.device);
+    let mut r = renderer(&a);
+    for (width, height, effects, next) in
+        [(16, 16, true, &b), (32, 24, true, &a), (32, 24, false, &b)]
+    {
+        if effects {
+            populate_effects(&mut r);
+        }
+        r.width = width;
+        r.height = height;
+        r.recover_with(|disabled| {
+            assert!(!disabled);
+            Ok(replacement(next, width, height))
+        })
+        .unwrap();
+        assert_effects_empty(&r);
+        assert_eq!(r.dev().device, next.device);
+        populate_effects(&mut r);
+        assert_eq!(
+            (r.blur.groups[0].width, r.blur.groups[0].height),
+            (width, height)
+        );
+        let copy_device = unsafe { r.blur.copy.as_ref().unwrap().texture.GetDevice() }.unwrap();
+        let group_device = unsafe { r.blur.groups[0].texture.GetDevice() }.unwrap();
+        let global_device = unsafe { r.blur.globals[0].as_ref().unwrap().GetDevice() }.unwrap();
+        let blend_device = unsafe { r.blend_replace.as_ref().unwrap().GetDevice() }.unwrap();
+        assert_eq!(copy_device, next.device);
+        assert_eq!(group_device, next.device);
+        assert_eq!(global_device, next.device);
+        assert_eq!(blend_device, next.device);
+        assert_eq!(
+            unsafe { r.blur.down[0].texture.GetDevice() }.unwrap(),
+            next.device
+        );
+        assert_eq!(
+            unsafe { r.blend_premultiplied.as_ref().unwrap().GetDevice() }.unwrap(),
+            next.device
+        );
+        r.clear_effect_resources();
+    }
+}
+
+#[test]
+fn failed_recovery_releases_slots_and_preserves_composition_policy() {
+    let device = DirectXDevices::new().unwrap();
+    let mut r = renderer(&device);
+    populate_effects(&mut r);
+    // Fail after each replacement stage; locals unwind with normal COM Drop.
+    for stage in 0..6 {
+        let result = r.recover_with(|disabled| {
+            assert!(!disabled);
+            if stage == 0 {
+                anyhow::bail!("injected devices failure");
+            }
+            let devices = DirectXRendererDevices::new(&device, disabled)?;
+            if stage == 1 {
+                anyhow::bail!("injected resources failure");
+            }
+            let _resources = DirectXResources::new(&devices, 16, 16, HWND::default(), false)?;
+            if stage == 2 {
+                anyhow::bail!("injected globals failure");
+            }
+            let _globals = DirectXGlobalElements::new(&devices.device)?;
+            if stage == 3 {
+                anyhow::bail!("injected pipelines failure");
+            }
+            let _pipelines = DirectXRenderPipelines::new(&devices.device)?;
+            anyhow::bail!("injected composition/set_swap_chain failure at {stage}")
+        });
+        assert!(result.is_err());
+        assert!(r.devices.is_none() && r.resources.is_none());
+        assert_effects_empty(&r);
+        assert!(r.skip_draws);
+        assert!(r.d3d_device_raw().is_none() && r.d3d_context_raw().is_none());
+        r.mark_drawable();
+        assert!(
+            r.draw(&Scene::default(), WindowBackgroundAppearance::Opaque)
+                .is_err()
+        );
+    }
+    r.recover_with(|disabled| {
+        assert!(!disabled);
+        Ok(replacement(&device, 16, 16))
+    })
+    .unwrap();
+    assert!(r.ensure_drawable_resources().is_ok());
+}
+
+#[test]
+fn failed_resize_is_unavailable_and_same_or_different_size_retry_repairs_it() {
+    let device = DirectXDevices::new().unwrap();
+    let mut r = renderer(&device);
+    for (size, stage) in [(16, 0), (24, 1), (24, 2), (32, 3), (32, 4)] {
+        r.width = size;
+        r.height = size;
+        r.resize_with(|resources, devices| {
+            if stage == 0 {
+                anyhow::bail!("injected ResizeBuffers failure");
+            }
+            unsafe {
+                resources.swap_chain().unwrap().ResizeBuffers(
+                    BUFFER_COUNT as u32,
+                    size,
+                    size,
+                    RENDER_TARGET_FORMAT,
+                    DXGI_SWAP_CHAIN_FLAG_FRAME_LATENCY_WAITABLE_OBJECT,
+                )?;
+            }
+            if stage == 1 {
+                anyhow::bail!("injected target failure");
+            }
+            let _target =
+                create_render_target_and_its_view(resources.swap_chain()?, &devices.device)?;
+            if stage == 2 {
+                anyhow::bail!("injected intermediate failure");
+            }
+            let _path = create_path_intermediate_texture(&devices.device, size, size)?;
+            if stage == 3 {
+                anyhow::bail!("injected MSAA failure");
+            }
+            let _msaa =
+                create_path_intermediate_msaa_texture_and_view(&devices.device, size, size)?;
+            anyhow::bail!("injected failure after partial construction")
+        })
+        .unwrap_err();
+        assert!(r.res().render_target.is_none() && r.res().render_target_view.is_none());
+        assert!(
+            r.draw(&Scene::default(), WindowBackgroundAppearance::Opaque)
+                .is_err()
+        );
+        r.resize(Size {
+            width: DevicePixels(size as i32),
+            height: DevicePixels(size as i32),
+        })
+        .unwrap();
+        assert!(r.ensure_drawable_resources().is_ok());
+        assert_eq!(
+            (r.res().viewport.Width, r.res().viewport.Height),
+            (size as f32, size as f32)
+        );
+    }
+    r.resize_with(|_, _| anyhow::bail!("injected final failure"))
+        .unwrap_err();
+    r.resize(Size {
+        width: DevicePixels(48),
+        height: DevicePixels(24),
+    })
+    .unwrap();
+    assert!(r.ensure_drawable_resources().is_ok());
+    r.resize_with(|_, _| anyhow::bail!("injected final failure"))
+        .unwrap_err();
+    drop(r); // Teardown of an unavailable renderer must not release dead slots.
+}
+
+#[test]
+fn exhausted_recovery_can_retry_from_empty_owners_and_teardown() {
+    let device = DirectXDevices::new().unwrap();
+    for disabled in [false, true] {
+        let mut r = renderer(&device);
+        r.disable_direct_composition = disabled;
+        let mut attempts = 0;
+        let error = try_to_recover_from_device_lost(|| {
+            r.recover_with(|policy| {
+                assert_eq!(policy, disabled);
+                attempts += 1;
+                anyhow::bail!("injected allocation failure")
+            })
+        })
+        .unwrap_err();
+        assert!(error.to_string().contains("multiple attempts"));
+        assert_eq!(attempts, 5);
+        assert!(r.devices.is_none() && r.resources.is_none());
+        assert!(r.skip_draws);
+        assert_effects_empty(&r);
+        r.recover_with(|policy| {
+            assert_eq!(policy, disabled);
+            Ok(replacement(&device, 16, 16))
+        })
+        .unwrap();
+        r.mark_drawable();
+        assert!(r.ensure_drawable_resources().is_ok());
+        r.recover_with(|_| anyhow::bail!("injected final failure"))
+            .unwrap_err();
+        drop(r);
+    }
+}
diff --git a/vendor/gpui-windows/src/directx_renderer/recovery_tests/damage.rs b/vendor/gpui-windows/src/directx_renderer/recovery_tests/damage.rs
new file mode 100644
index 0000000000000000000000000000000000000000..7c3edffccef9604c4fdc26619d9d7b1827257726
--- /dev/null
+++ b/vendor/gpui-windows/src/directx_renderer/recovery_tests/damage.rs
@@ -0,0 +1,266 @@
+//! KaminIDE patch (R4): the retained target redrawn only within a frame's
+//! damage (`retained.rs`) holds byte for byte what a whole redraw of that
+//! frame draws, for every kind of edit the damage diff must see: a changed,
+//! moved, inserted or removed primitive, a shadow, a group's content and
+//! opacity, an unchanged frame and a chain of frames.
+
+use super::*;
+use gpui::{
+    Background, Bounds, ContentMask, Corners, Hsla, PaintGroup, PaintSurface, Quad, ScaledPixels,
+    SceneDamage, Shadow, hsla, point, size,
+};
+use windows::Win32::Graphics::Direct3D11::{D3D11_MAP_READ, D3D11_MAPPED_SUBRESOURCE};
+
+mod groups;
+// KaminIDE patch: output-merger blend series equal their formulas.
+mod tiles;
+
+const W: u32 = 256;
+const H: u32 = 192;
+
+fn b(x: f32, y: f32, w: f32, h: f32) -> Bounds<ScaledPixels> {
+    Bounds {
+        origin: point(ScaledPixels(x), ScaledPixels(y)),
+        size: size(ScaledPixels(w), ScaledPixels(h)),
+    }
+}
+
+fn mask() -> ContentMask<ScaledPixels> {
+    ContentMask {
+        bounds: b(0., 0., W as f32, H as f32),
+    }
+}
+
+fn quad(r: [f32; 4], color: Hsla) -> Quad {
+    Quad {
+        bounds: b(r[0], r[1], r[2], r[3]),
+        content_mask: mask(),
+        background: Background::from(color),
+        corner_radii: Corners::all(ScaledPixels(4.)),
+        ..Default::default()
+    }
+}
+
+/// What a frame paints: a shadow, quads, and one group of two quads.
+#[derive(Clone)]
+struct Frame {
+    shadow_blur: f32,
+    quads: Vec<([f32; 4], Hsla)>,
+    group_color: Hsla,
+    group_opacity: f32,
+}
+
+impl Frame {
+    fn base() -> Self {
+        Frame {
+            shadow_blur: 6.,
+            quads: vec![
+                ([10., 10., 60., 40.], hsla(0.0, 0.8, 0.5, 1.)),
+                ([90., 20., 50., 50.], hsla(0.3, 0.8, 0.5, 1.)),
+                ([200., 140., 40., 40.], hsla(0.6, 0.8, 0.5, 1.)),
+                ([30., 120., 70., 30.], hsla(0.1, 0.8, 0.5, 0.6)),
+            ],
+            group_color: hsla(0.8, 0.7, 0.5, 1.),
+            group_opacity: 0.7,
+        }
+    }
+
+    fn scene(&self) -> Scene {
+        let mut s = Scene::default();
+        let mut order = 0;
+        let mut next = || {
+            order += 1;
+            order
+        };
+        let bounds = b(20., 60., 50., 30.);
+        s.shadows.push(Shadow {
+            order: next(),
+            blur_radius: ScaledPixels(self.shadow_blur),
+            bounds,
+            corner_radii: Corners::default(),
+            content_mask: mask(),
+            color: hsla(0., 0., 0., 0.5),
+            element_bounds: bounds,
+            element_corner_radii: Corners::default(),
+            inset: 0,
+            pad: 0,
+        });
+        for (r, c) in &self.quads {
+            let mut q = quad(*r, *c);
+            q.order = next();
+            s.quads.push(q);
+        }
+        let mut inner = Scene::default();
+        for (i, r) in [[150., 90., 40., 30.], [170., 100., 40., 30.]]
+            .into_iter()
+            .enumerate()
+        {
+            let mut q = quad(
+                r,
+                if i == 0 {
+                    self.group_color
+                } else {
+                    hsla(0.5, 0.6, 0.4, 0.8)
+                },
+            );
+            q.order = i as u32 + 1;
+            inner.quads.push(q);
+        }
+        let group = b(150., 90., 60., 40.);
+        s.groups.push(PaintGroup {
+            scene: inner,
+            bounds: group,
+            ..Default::default()
+        });
+        s.surfaces.push(PaintSurface {
+            order: next(),
+            bounds: group,
+            content_mask: mask(),
+            corner_radii: Corners::default(),
+            blur_radius: 0.,
+            group: 1,
+            opacity: self.group_opacity,
+            color_matrix: None,
+            fragment: 0,
+        });
+        s
+    }
+}
+
+fn edits() -> Vec<(&'static str, Frame)> {
+    let base = Frame::base();
+    let with = |f: &dyn Fn(&mut Frame)| {
+        let mut e = base.clone();
+        f(&mut e);
+        e
+    };
+    vec![
+        ("colour", with(&|e| e.quads[2].1 = hsla(0.9, 0.8, 0.5, 1.))),
+        ("move", with(&|e| e.quads[1].0[0] += 7.)),
+        (
+            "insert",
+            with(&|e| {
+                e.quads
+                    .push(([220., 10., 20., 20.], hsla(0.2, 0.9, 0.5, 1.)))
+            }),
+        ),
+        (
+            "remove",
+            with(&|e| {
+                e.quads.remove(0);
+            }),
+        ),
+        ("shadow", with(&|e| e.shadow_blur = 2.)),
+        (
+            "group content",
+            with(&|e| e.group_color = hsla(0.4, 0.7, 0.5, 1.)),
+        ),
+        ("group opacity", with(&|e| e.group_opacity = 0.3)),
+        ("unchanged", base.clone()),
+    ]
+}
+
+/// The offscreen target's bytes (BGRA rows).
+fn target_bytes(r: &mut DirectXRenderer) -> Vec<u8> {
+    let staging = r.capture_staging().unwrap();
+    let ctx = r.dev().device_context.clone();
+    let target = r.res().render_target.clone().unwrap();
+    let mut m = D3D11_MAPPED_SUBRESOURCE::default();
+    unsafe {
+        ctx.CopyResource(&staging, &target);
+        ctx.Map(&staging, 0, D3D11_MAP_READ, 0, Some(&mut m))
+            .unwrap();
+    }
+    let row = (r.width * 4) as usize;
+    let mut out = Vec::with_capacity(row * r.height as usize);
+    for y in 0..r.height as usize {
+        // SAFETY: the mapped staging texture is width x height BGRA8; each
+        // row has RowPitch >= width * 4 readable bytes until Unmap.
+        out.extend_from_slice(unsafe {
+            std::slice::from_raw_parts((m.pData as *const u8).add(y * m.RowPitch as usize), row)
+        });
+    }
+    unsafe { ctx.Unmap(&staging, 0) };
+    out
+}
+
+/// `frames` drawn in sequence, each compared with the previous one; returns
+/// the target after the last and the last frame's damage.
+fn draw_chain(device: &DirectXDevices, frames: &[&Frame]) -> (Vec<u8>, SceneDamage) {
+    let mut r = offscreen(device, W, H);
+    let mut previous = Scene::default();
+    let mut damage = SceneDamage::Unknown;
+    for (i, f) in frames.iter().enumerate() {
+        let mut s = f.scene();
+        s.note_damage(&previous, i as u64 + 1, (W, H));
+        damage = s.frame_damage().0;
+        r.draw(&s, WindowBackgroundAppearance::Opaque).unwrap();
+        previous = s;
+    }
+    (target_bytes(&mut r), damage)
+}
+
+fn differing(a: &[u8], b: &[u8]) -> usize {
+    a.chunks(4).zip(b.chunks(4)).filter(|(x, y)| x != y).count()
+}
+
+#[test]
+fn a_frame_drawn_within_its_damage_equals_the_whole_frame() {
+    let device = DirectXDevices::new().unwrap();
+    let base = Frame::base();
+    for (name, edit) in edits() {
+        let (got, damage) = draw_chain(&device, &[&base, &edit]);
+        let (want, whole) = draw_chain(&device, &[&edit]);
+        assert_eq!(
+            whole,
+            SceneDamage::Unknown,
+            "{name}: the reference is drawn whole"
+        );
+        match name {
+            "unchanged" => assert_eq!(damage, SceneDamage::Unchanged, "{name}"),
+            _ => assert!(
+                matches!(damage, SceneDamage::Rect { width, height, .. } if width * height < W * H),
+                "{name}: damage {damage:?} must be a part of the frame"
+            ),
+        }
+        assert_eq!(got.len(), want.len());
+        assert!(
+            got == want,
+            "{name}: {} pixels differ from the whole frame",
+            differing(&got, &want)
+        );
+    }
+}
+
+#[test]
+fn a_chain_of_edits_equals_its_last_frame_drawn_whole() {
+    // Edits that stay in the lower right quarter, so every redraw is partial.
+    let device = DirectXDevices::new().unwrap();
+    let base = Frame::base();
+    let mut chain = vec![base.clone()];
+    for c in [0.9, 0.95, 0.35] {
+        let mut e = chain[chain.len() - 1].clone();
+        e.quads[2].1 = hsla(c, 0.8, 0.5, 1.);
+        chain.push(e.clone());
+        e.group_color = hsla(c, 0.7, 0.5, 1.);
+        chain.push(e);
+    }
+    chain.push(chain[chain.len() - 1].clone());
+    let frames: Vec<&Frame> = chain.iter().collect();
+    for n in 2..=frames.len() {
+        let (got, damage) = draw_chain(&device, &frames[..n]);
+        assert!(
+            matches!(
+                damage,
+                SceneDamage::Unchanged | SceneDamage::Rect { x: 128.., .. }
+            ),
+            "frame {n}: damage {damage:?}"
+        );
+        let (want, _) = draw_chain(&device, &[frames[n - 1]]);
+        assert!(
+            got == want,
+            "frame {n}: {} pixels differ from the whole frame",
+            differing(&got, &want)
+        );
+    }
+}
