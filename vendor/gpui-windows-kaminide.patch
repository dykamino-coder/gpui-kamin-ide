--- /dev/null
+++ b/vendor/gpui-windows/src/directx_renderer/scene_capture.rs
@@ -0,0 +1,53 @@
+//! Transparent offscreen targets for embedded document scenes.
+use super::*;
+
+impl DirectXRenderer {
+    pub(crate) fn rasterize_scene(
+        &mut self,
+        scene: &Scene,
+        size: Size<DevicePixels>,
+    ) -> Result<image::RgbaImage> {
+        self.ensure_drawable_resources()?;
+        let (width, height) = (size.width.0.max(1) as u32, size.height.0.max(1) as u32);
+        anyhow::ensure!(
+            width <= 8192 && height <= 8192,
+            "scene capture exceeds texture limit"
+        );
+        let resources = self.res();
+        let device = &self.dev().device;
+        let (texture, _) = create_path_intermediate_texture(device, width, height)?;
+        let mut view = None;
+        unsafe { device.CreateRenderTargetView(&texture, None, Some(&mut view))? };
+        let (path, path_srv) = create_path_intermediate_texture(device, width, height)?;
+        let (msaa, msaa_view) =
+            create_path_intermediate_msaa_texture_and_view(device, width, height)?;
+        let isolated = DirectXResources {
+            swap_chain: resources.swap_chain.clone(),
+            frame_gate: None,
+            render_target: Some(texture),
+            render_target_view: view,
+            path_intermediate_texture: path,
+            path_intermediate_srv: path_srv,
+            path_intermediate_msaa_texture: msaa,
+            path_intermediate_msaa_view: msaa_view,
+            viewport: D3D11_VIEWPORT {
+                Width: width as f32,
+                Height: height as f32,
+                MaxDepth: 1.0,
+                ..Default::default()
+            },
+        };
+        let original = self.resources.replace(isolated);
+        let dimensions = (self.width, self.height);
+        (self.width, self.height) = (width, height);
+        let result = self.render_to_image(scene, WindowBackgroundAppearance::Transparent);
+        self.resources = original;
+        (self.width, self.height) = dimensions;
+        unsafe {
+            self.dev()
+                .device_context
+                .OMSetRenderTargets(Some(slice::from_ref(&self.res().render_target_view)), None);
+        }
+        result
+    }
+}
diff --git a/vendor/gpui-windows/src/directx_renderer/shader_compilation.rs b/vendor/gpui-windows/src/directx_renderer/shader_compilation.rs
new file mode 100644
index 0000000000000000000000000000000000000000..c3854feacc6d9499b7d38dbc985fdee7ce013150
--- /dev/null
+++ b/vendor/gpui-windows/src/directx_renderer/shader_compilation.rs
@@ -0,0 +1,104 @@
+//! Встроенные исходники debug-шейдеров и их общего HLSL include.
+
+use super::shader_resources::{ShaderModule, ShaderTarget};
+use anyhow::Result;
+use std::ffi::c_void;
+use windows::{
+    Win32::{
+        Foundation::E_INVALIDARG,
+        Graphics::Direct3D::{
+            D3D_INCLUDE_TYPE,
+            Fxc::{D3DCOMPILE_DEBUG, D3DCOMPILE_SKIP_OPTIMIZATION, D3DCompile},
+            ID3DBlob, ID3DInclude, ID3DInclude_Impl,
+        },
+    },
+    core::{PCSTR, s},
+};
+
+const ALPHA_CORRECTION: &[u8] = include_bytes!("../alpha_correction.hlsl");
+
+struct EmbeddedIncludes;
+
+#[allow(non_snake_case)]
+impl ID3DInclude_Impl for EmbeddedIncludes {
+    fn Open(
+        &self,
+        _include_type: D3D_INCLUDE_TYPE,
+        filename: &PCSTR,
+        _parent: *const c_void,
+        data: *mut *mut c_void,
+        size: *mut u32,
+    ) -> windows::core::Result<()> {
+        // SAFETY: D3DCompile supplies the NUL-terminated include name and valid out-pointers.
+        // The static bytes remain alive through every Open/Close and the synchronous compile.
+        unsafe {
+            if filename.as_bytes() != b"alpha_correction.hlsl" {
+                return Err(E_INVALIDARG.into());
+            }
+            *data = ALPHA_CORRECTION.as_ptr().cast_mut().cast();
+            *size = ALPHA_CORRECTION.len() as u32;
+        }
+        Ok(())
+    }
+
+    fn Close(&self, _data: *const c_void) -> windows::core::Result<()> {
+        Ok(())
+    }
+}
+
+pub(super) fn build_shader_blob(entry: ShaderModule, target: ShaderTarget) -> Result<ID3DBlob> {
+    // Rooted virtual names stop D3DCompiler from prefixing the worktree in debug info.
+    let (source, name): (&[u8], PCSTR) = if matches!(entry, ShaderModule::EmojiRasterization) {
+        (
+            include_bytes!("../color_text_raster.hlsl"),
+            s!("/gpui/color_text_raster.hlsl"),
+        )
+    } else {
+        (include_bytes!("../shaders.hlsl"), s!("/gpui/shaders.hlsl"))
+    };
+    let entry = format!(
+        "{}_{}\0",
+        entry.as_str(),
+        match target {
+            ShaderTarget::Vertex => "vertex",
+            ShaderTarget::Fragment => "fragment",
+        }
+    );
+    let target = match target {
+        ShaderTarget::Vertex => s!("vs_4_1"),
+        ShaderTarget::Fragment => s!("ps_4_1"),
+    };
+    let includes = EmbeddedIncludes;
+    let include_handler = ID3DInclude::new(&includes);
+    let mut compile_blob = None;
+    let mut error_blob = None;
+    // SAFETY: all source/entry/include storage outlives this synchronous call; the compiler
+    // owns the returned COM blobs. Only logical filenames enter the debug information.
+    let ret = unsafe {
+        D3DCompile(
+            source.as_ptr().cast(),
+            source.len(),
+            name,
+            None,
+            &*include_handler,
+            PCSTR::from_raw(entry.as_ptr()),
+            target,
+            D3DCOMPILE_DEBUG | D3DCOMPILE_SKIP_OPTIMIZATION,
+            0,
+            &mut compile_blob,
+            Some(&mut error_blob),
+        )
+    };
+    if ret.is_err() {
+        let Some(error_blob) = error_blob else {
+            return Err(anyhow::anyhow!("{ret:?}"));
+        };
+        // SAFETY: a compiler error blob contains NUL-terminated diagnostic text and is live.
+        let error_string = unsafe {
+            std::ffi::CStr::from_ptr(error_blob.GetBufferPointer() as *const i8).to_string_lossy()
+        };
+        log::error!("Shader compile error: {}", error_string);
+        return Err(anyhow::anyhow!("Compile error: {}", error_string));
+    }
+    Ok(compile_blob.unwrap())
+}
diff --git a/vendor/gpui-windows/src/directx_renderer/shader_identity.rs b/vendor/gpui-windows/src/directx_renderer/shader_identity.rs
new file mode 100644
index 0000000000000000000000000000000000000000..2d54819b1af8b85e736bea680f8520b819cc8c7d
--- /dev/null
+++ b/vendor/gpui-windows/src/directx_renderer/shader_identity.rs
@@ -0,0 +1,61 @@
+//! KaminIDE patch: исполняемые DXBC chunks отделены от нестабильных debug paths.
+
+use super::*;
+use sha2::{Digest, Sha256};
+
+fn executable(bytes: &[u8]) -> Result<String> {
+    anyhow::ensure!(bytes.starts_with(b"DXBC") && bytes.len() >= 32, "Invalid DXBC container");
+    let word = |offset: usize| -> Result<usize> {
+        Ok(u32::from_le_bytes(bytes.get(offset..offset + 4).context("Truncated DXBC word")?.try_into()?) as usize)
+    };
+    let mut digest = Sha256::new();
+    let mut found = false;
+    for index in 0..word(28)? {
+        let offset = word(32 + index * 4)?;
+        let tag = bytes.get(offset..offset + 4).context("Truncated DXBC chunk")?;
+        if tag == b"SHDR" || tag == b"SHEX" {
+            let size = word(offset + 4)?;
+            digest.update(bytes.get(offset..offset + 8 + size).context("Truncated shader executable")?);
+            found = true;
+        }
+    }
+    anyhow::ensure!(found, "DXBC contains no executable chunk");
+    Ok(format!("{:x}", digest.finalize()))
+}
+
+impl<T> PipelineState<T> {
+    pub(super) fn new(
+        device: &ID3D11Device,
+        label: &'static str,
+        shader_module: ShaderModule,
+        buffer_size: usize,
+        blend_state: ID3D11BlendState,
+    ) -> Result<Self> {
+        let mut shader_executables = [String::new(), String::new()];
+        let vertex = {
+            let raw_shader = RawShaderBytes::new(shader_module, ShaderTarget::Vertex)?;
+            shader_executables[0] = executable(raw_shader.as_bytes())?;
+            create_vertex_shader(device, raw_shader.as_bytes())?
+        };
+        let fragment = {
+            let raw_shader = RawShaderBytes::new(shader_module, ShaderTarget::Fragment)?;
+            shader_executables[1] = executable(raw_shader.as_bytes())?;
+            create_fragment_shader(device, raw_shader.as_bytes())?
+        };
+        let buffer = create_buffer(device, std::mem::size_of::<T>(), buffer_size)?;
+        let view = create_buffer_view(device, &buffer)?;
+
+        Ok(PipelineState {
+            label,
+            shader_executables,
+            vertex,
+            fragment,
+            buffer,
+            buffer_size,
+            view,
+            blend_state,
+            _marker: std::marker::PhantomData,
+        })
+    }
+
+}
