+StructuredBuffer<BlurQuad> blur_quads: register(t1);
+// KaminIDE patch: копия кадра — цвет назначения для формул смешивания.
+Texture2D<float4> t_backdrop: register(t2);
+// KaminIDE patch: маска-изображение группы (`mask-image`) — альфа гасит буфер.
+Texture2D<float4> t_maskimg: register(t3);
+
+// KaminIDE patch: расстояние со знаком до многоугольника (`clip-path`).
+//
+// Прямоугольная маска со скруглением берёт круг и вставку, но не звезду и не
+// стрелку. Знак даёт проверка пересечений, модуль — ближайшее ребро; вместе
+// это край, который можно сгладить, а не ступенька.
+float poly_sdf(float4 poly[4], uint n, float2 p) {
+    float2 first = poly[0].xy;
+    float d = dot(p - first, p - first);
+    float sign_acc = 1.0;
+    for (uint i = 0u; i < n; i++) {
+        uint j = (i + n - 1u) % n;
+        float2 vi = (i % 2u == 0u) ? poly[i / 2u].xy : poly[i / 2u].zw;
+        float2 vj = (j % 2u == 0u) ? poly[j / 2u].xy : poly[j / 2u].zw;
+        float2 e = vj - vi;
+        float2 w = p - vi;
+        float2 b = w - e * clamp(dot(w, e) / max(dot(e, e), 0.0001), 0.0, 1.0);
+        d = min(d, dot(b, b));
+        bool3 c = bool3(p.y >= vi.y, p.y < vj.y, e.x * w.y > e.y * w.x);
+        if (all(c) || all(!c)) {
+            sign_acc = -sign_acc;
+        }
+    }
+    return sign_acc * sqrt(d);
+}
+
+// KaminIDE patch: формулы смешивания CSS.
+//
+// Аппаратный блендер считает по одной формуле на состояние и знает лишь
+// умножение, обратное умножение, минимум и максимум. Остальные режимы CSS
+// требуют читать цвет назначения — здесь он есть, поэтому считаются все.
+float blend_channel(uint mode, float cb, float cs) {
+    switch (mode) {
+        case 1u: return cb * cs;                        // multiply
+        case 2u: return cb + cs - cb * cs;              // screen
+        case 3u: return min(cb, cs);                    // darken
+        case 4u: return max(cb, cs);                    // lighten
+        case 5u:                                        // overlay = hard-light наоборот
+            return cb <= 0.5 ? 2.0 * cb * cs : 1.0 - 2.0 * (1.0 - cb) * (1.0 - cs);
+        case 6u:                                        // color-dodge
+            if (cb <= 0.0) return 0.0;
+            if (cs >= 1.0) return 1.0;
+            return min(1.0, cb / (1.0 - cs));
+        case 7u:                                        // color-burn
+            if (cb >= 1.0) return 1.0;
+            if (cs <= 0.0) return 0.0;
+            return 1.0 - min(1.0, (1.0 - cb) / cs);
+        case 8u:                                        // hard-light
+            return cs <= 0.5 ? 2.0 * cs * cb : 1.0 - 2.0 * (1.0 - cs) * (1.0 - cb);
+        case 9u: {                                      // soft-light
+            float d = cb <= 0.25 ? ((16.0 * cb - 12.0) * cb + 4.0) * cb : sqrt(cb);
+            return cs <= 0.5 ? cb - (1.0 - 2.0 * cs) * cb * (1.0 - cb)
+                             : cb + (2.0 * cs - 1.0) * (d - cb);
+        }
+        case 10u: return abs(cb - cs);                  // difference
+        case 11u: return cb + cs - 2.0 * cb * cs;       // exclusion
+        default: return cs;
+    }
+}
+
+float blend_lum(float3 c) {
+    return dot(c, float3(0.3, 0.59, 0.11));
+}
+
+/// Вернуть цвету заданную светлоту, не выходя за пределы диапазона.
+float3 blend_set_lum(float3 c, float l) {
+    c += l - blend_lum(c);
+    float lo = min(c.r, min(c.g, c.b));
+    float hi = max(c.r, max(c.g, c.b));
+    float lum = blend_lum(c);
+    if (lo < 0.0) {
+        c = lum + (c - lum) * lum / max(lum - lo, 1e-5);
+    }
+    if (hi > 1.0) {
+        c = lum + (c - lum) * (1.0 - lum) / max(hi - lum, 1e-5);
+    }
+    return c;
+}
+
+float blend_sat(float3 c) {
+    return max(c.r, max(c.g, c.b)) - min(c.r, min(c.g, c.b));
+}
+
+/// Вернуть цвету заданную насыщенность, сохранив порядок каналов.
+float3 blend_set_sat(float3 c, float sat) {
+    float lo = min(c.r, min(c.g, c.b));
+    float hi = max(c.r, max(c.g, c.b));
+    if (hi <= lo) {
+        return float3(0.0, 0.0, 0.0);
+    }
+    return (c - lo) * sat / (hi - lo);
+}
+
+/// Несмешиваемые режимы: они берут у сторон целые характеристики цвета —
+/// тон, насыщенность или светлоту, — а не считают канал за каналом.
+float3 blend_nonseparable(uint mode, float3 cb, float3 cs) {
+    switch (mode) {
+        case 12u: return blend_set_lum(blend_set_sat(cs, blend_sat(cb)), blend_lum(cb));
+        case 13u: return blend_set_lum(blend_set_sat(cb, blend_sat(cs)), blend_lum(cb));
+        case 14u: return blend_set_lum(cs, blend_lum(cb));
+        default:  return blend_set_lum(cb, blend_lum(cs));
+    }
+}
+
+struct BlurVertexOutput {
+    nointerpolation uint quad_id: TEXCOORD0;
+    float4 position: SV_Position;
+    float2 uv: POSITION;
+    float4 clip_distance: SV_ClipDistance;
+};
+
+struct BlurFragmentInput {
+    nointerpolation uint quad_id: TEXCOORD0;
+    float4 position: SV_Position;
+    float2 uv: POSITION;
+};
+
+BlurVertexOutput blur_vertex(uint vertex_id: SV_VertexID, uint quad_id: SV_InstanceID) {
+    float2 unit_vertex = float2(float(vertex_id & 1u), 0.5 * float(vertex_id & 2u));
+    BlurQuad q = blur_quads[quad_id];
+    BlurVertexOutput output;
+    output.position = to_device_position(unit_vertex, q.bounds);
+    output.uv = q.src_origin + unit_vertex * q.src_scale;
+    output.quad_id = quad_id;
+    output.clip_distance = distance_from_clip_rect(unit_vertex, q.bounds, q.content_mask);
+    return output;
+}
+
+// KaminIDE patch: цветовые функции `backdrop-filter` (filter-effects-1
+// §«Supported filter functions»: все — аффинные матрицы 4×5 над НЕумноженным
+// RGBA). Строки множителей едут в poly[0..3], сдвиги — в mask_rect: у
+// проходов подложки многоугольника и маски-изображения нет. Выход —
+// НЕумноженный цвет с альфой (блендер пайплайна — SRC_ALPHA).
+float4 backdrop_matrix(BlurQuad q, float4 c) {
+    float3 rgb = c.a > 0.0 ? c.rgb / c.a : float3(0.0, 0.0, 0.0);
+    float4 u = float4(rgb, c.a);
+    return saturate(float4(dot(q.poly[0], u), dot(q.poly[1], u),
+                           dot(q.poly[2], u), dot(q.poly[3], u)) + q.mask_rect);
+}
+
+// KaminIDE patch: tap of the backdrop-filter blur (passes 0 and 1). Filter
+// Effects 2 §backdrop-filter clips the backdrop to the border box and Blink
+// blurs it with SkTileMode::kMirror (cc RenderSurfaceFilters backdrop
+// bounds): taps beyond the source region reflect back into it instead of
+// reading neighbouring frame pixels. Group blurs (pass 2) are unchanged.
+float4 blur_tap(BlurQuad q, float2 uv, float2 off) {
+    float2 u = uv + off;
+    if (q.blur_pass < 1.5) {
+        float2 lo = q.src_origin;
+        float2 hi = q.src_origin + q.src_scale;
+        u = u < lo ? 2.0 * lo - u : u;
+        u = u > hi ? 2.0 * hi - u : u;
+        float2 h = min(0.5 * q.texel, 0.5 * (hi - lo));
+        u = clamp(u, lo + h, hi - h);
+    }
+    if (q.source_rect.z > 0.0) {
+        // KaminIDE patch: выбираем период WRAP, ближайший к области группы.
+        // У шва кадра оставляем полупиксель за границей: BORDER должен
+        // смешать прозрачный край с первым/последним пикселем группы.
+        float2 center = (q.source_rect.xy + 0.5 * q.source_rect.zw) * q.texel;
+        float2 period = floor(u - center + 0.5);
+        float2 local = ((u - period) / q.texel - q.source_rect.xy) / q.source_rect.zw;
+        u = float2(q.source_rect.z == round(1.0 / q.texel.x) ? u.x : local.x,
+                   q.source_rect.w == round(1.0 / q.texel.y) ? u.y : local.y);
+    }
+    return t_sprite.Sample(s_sprite, u);
+}
+
+// KaminIDE patch: texel of a group's retained image at frame point p. The image
+// is the integer rectangle source_rect of the frame, stored in an atlas page at
+// src_origin; outside the rectangle the image is transparent.
+float4 group_texel(BlurQuad q, float2 p) {
+    int2 local = int2(floor(p) - q.source_rect.xy);
+    if (any(local < 0) || any(local >= int2(q.source_rect.zw))) {
+        return float4(0.0, 0.0, 0.0, 0.0);
+    }
+    return t_sprite.Load(int3(local + int2(q.src_origin), 0));
+}
+
+// KaminIDE patch: premultiplied source of a group composite at frame point p:
+// the retained image (or its plane through H^-1) under the rounded, polygon,
+// clip and mask-image coverage and the group opacity. Shared by blur_fragment
+// (blend modes mixed in the shader against a backdrop copy) and
+// group_tiles_fragment (a run of composites in one pass, no copies).
+// `in_loop` (a literal): the mask image is read at level 0 instead of by the
+// derivatives, which a loop with a varying count has none of; every texture
+// has one level (MipLevels 1), so the texel is the same.
+float4 group_source_with(BlurQuad q, float2 p, bool in_loop) {
+    float4 src;
+    // KaminIDE patch: plane of a 3D rendering context — map the frame
+    // pixel back through the inverse homography (perspective-correct
+    // sampling, css-transforms-2 §3d-transform-rendering); behind the
+    // eye or outside the buffer nothing is drawn.
+    if (q.proj[2].w > 0.5) {
+        float3 sp = float3(p, 1.0);
+        float3 h = float3(dot(q.proj[0].xyz, sp), dot(q.proj[1].xyz, sp),
+                          dot(q.proj[2].xyz, sp));
+        float2 rp = h.z > 1e-6 ? h.xy / h.z : float2(-1.0, -1.0);
+        float2 ruv = rp * q.texel;
+        // Nearest texel: the raster map is the plane's tangent affine, so
+        // texels stay ~1:1 with frame pixels; a bilinear tap would blur
+        // every edge already antialiased in the buffer a second time.
+        src = (h.z > 1e-6 && all(ruv >= 0.0) && all(ruv < 1.0))
+            ? group_texel(q, rp)
+            : float4(0.0, 0.0, 0.0, 0.0);
+    } else {
+        src = group_texel(q, p);
+    }
+    float distance = quad_sdf(p, q.bounds, q.corner_radii);
+    float corner = saturate(0.5 - distance);
+    // KaminIDE patch: rounded composite (clip-path `round`) — the same
+    // 8-bit coverage a rounded quad reaches the blend stage with.
+    if (any(float4(q.corner_radii.top_left, q.corner_radii.top_right,
+                   q.corner_radii.bottom_right, q.corner_radii.bottom_left) > 0.0)) {
+        corner = round(corner * 255.0) / 255.0;
+    }
+    float mask = corner * q.pad;
+    // KaminIDE patch: bit 16 of poly_count inverts the polygon clip
+    // (border ring outside the inner contour, 1 - coverage).
+    uint poly_n = q.poly_count & 15u;
+    if (poly_n >= 3u) {
+        float pd = poly_sdf(q.poly, poly_n, p);
+        if (q.proj[0].w > 0.5) {
+            // KaminIDE patch: BSP piece of a 3D plane - cut edges are hard
+            // (viz draws split polygons without edge AA): two pieces meeting
+            // on a cut must not both fade and let the backdrop through.
+            mask *= pd <= 0.0 ? 1.0 : 0.0;
+        } else {
+            float poly_cover = saturate(0.5 - pd);
+            mask *= (q.poly_count & 16u) != 0u ? 1.0 - poly_cover : poly_cover;
+        }
+    }
+    // Маска-изображение: плитка лежит от угла коробки своим размером и
+    // повторяется по обеим осям (`mask-repeat: repeat` — начальное
+    // значение css-masking); запрет мощения пооосный (pad2.y: бит 0 —
+    // x, бит 1 — y) — за краем первой плитки маска пуста. Гасится вся
+    // картинка, альфа её умножена.
+    // Коробка окраски (`mask-clip`) и старый `clip: rect` режут группу
+    // и БЕЗ маски-изображения: вне коробки картинка пуста.
+    if (q.mask_clip.z > 0.0 && (
+        p.x < q.mask_clip.x ||
+        p.x >= q.mask_clip.x + q.mask_clip.z ||
+        p.y < q.mask_clip.y ||
+        p.y >= q.mask_clip.y + q.mask_clip.w)) {
+        mask = 0.0;
+    }
+    if (q.pad2.x > 0.5) {
+        float2 mt = (p - q.mask_rect.xy) / q.mask_rect.zw;
+        uint norep = uint(q.pad2.y + 0.5);
+        uint turn = (norep >> 3u) & 3u;
+        if (turn == 1u) { mt = float2(mt.y, 1.0 - mt.x); }
+        if (turn == 2u) { mt = 1.0 - mt; }
+        if (turn == 3u) { mt = float2(1.0 - mt.y, mt.x); }
+        float inside = 1.0;
+        if ((norep & 1u) && (mt.x < 0.0 || mt.x >= 1.0)) { inside = 0.0; }
+        if ((norep & 2u) && (mt.y < 0.0 || mt.y >= 1.0)) { inside = 0.0; }
+        float4 mc;
+        if (in_loop) {
+            mc = t_maskimg.SampleLevel(s_sprite, frac(mt), 0.0);
+        } else {
+            mc = t_maskimg.Sample(s_sprite, frac(mt));
+        }
+        // Светимость (`mask-mode: luminance`, бит 2): цвет уже умножен
+        // на альфа, поэтому взвешенная сумма сразу равна lum * a.
+        float mval = (norep & 4u)
+            ? dot(mc.rgb, float3(0.2126, 0.7152, 0.0722))
+            : mc.a;
+        mask *= inside * mval;
+    }
+    src *= mask;
+    return src;
+}
+
+float4 group_source(BlurQuad q, float2 p) {
+    return group_source_with(q, p, false);
+}
+
+// KaminIDE patch: premultiplied source `src` of blend mode `mode` (not normal)
+// composited over the premultiplied destination `dst` (Compositing 1 §5.8:
+// the mixed colour shows only where both sides are opaque). The CSS formulas
+// take colour that is not multiplied, so both sides are divided by their alpha
+// first and the result is multiplied back as a whole.
+float4 composite_mix(uint mode, float4 src, float4 dst) {
+    // Compositing 2 §9.1.15: plus-lighter adds premultiplied RGBA.
+    // This Porter-Duff operator does not use the source-over blend formula.
+    if (mode == 16u) {
+        return saturate(src + dst);
+    }
+    float3 cs = src.a > 0.0 ? src.rgb / src.a : float3(0.0, 0.0, 0.0);
+    float3 cb = dst.a > 0.0 ? dst.rgb / dst.a : float3(0.0, 0.0, 0.0);
+    float3 mixed;
+    if (mode >= 12u) {
+        mixed = blend_nonseparable(mode, cb, cs);
+    } else {
+        mixed = float3(
+            blend_channel(mode, cb.r, cs.r),
+            blend_channel(mode, cb.g, cs.g),
+            blend_channel(mode, cb.b, cs.b));
+    }
+    float3 co = (1.0 - dst.a) * src.a * cs
+              + dst.a * src.a * mixed
+              + (1.0 - src.a) * dst.a * cb;
+    return float4(co, src.a + dst.a * (1.0 - src.a));
+}
+
+float4 blur_fragment(BlurFragmentInput input): SV_Target {
+    input.position.xy += global_origin;
+    BlurQuad q = blur_quads[input.quad_id];
+    float2 t = q.texel;
+    // KaminIDE patch: Gaussian of a group: filter-effects-1 blur() with standard
+    // deviation σ ≤ 4 px. poly holds the one-sided weights w[0..15]; outside
+    // source_rect the filter input is transparent black. blur_pass 6: the whole
+    // (2r+1)² kernel in one pass (small r, no intermediate target);
+    // blur_pass 5: one separable pass along pad2.
+    if (q.blur_pass > 5.5) {
+        int2 p = int2(floor(input.position.xy)) + int2(q.src_origin);
+        int r = int(q.pad);
+        int2 lo = int2(q.source_rect.xy);
+        int2 hi = lo + int2(q.source_rect.zw);
+        // Unrolled to the largest single-pass radius (4): constant tap indices keep
+        // the weights in registers instead of reloading the instance per tap. Taps
+        // beyond r are skipped, so the sum and its order equal the r-bounded loop.
+        float w[5] = { q.poly[0][0], q.poly[0][1], q.poly[0][2], q.poly[0][3], q.poly[1][0] };
+        float4 g = float4(0.0, 0.0, 0.0, 0.0);
+        [unroll] for (int j = -4; j <= 4; j++) {
+            if (abs(j) <= r) {
+                float wj = w[abs(j)];
+                [unroll] for (int k = -4; k <= 4; k++) {
+                    int2 s = p + int2(k, j);
+                    if (abs(k) <= r && all(s >= lo) && all(s < hi)) {
+                        g += (w[abs(k)] * wj) * t_sprite.Load(int3(s, 0));
+                    }
+                }
+            }
+        }
+        return g;
+    }
+    if (q.blur_pass > 4.5) {
+        int2 p = int2(floor(input.position.xy)) + int2(q.src_origin);
+        int2 dir = int2(q.pad2);
+        int r = int(q.pad);
+        int2 lo = int2(q.source_rect.xy);
+        int2 hi = lo + int2(q.source_rect.zw);
+        // Unrolled to the largest tap count (15), as in pass 6.
+        float4 g = float4(0.0, 0.0, 0.0, 0.0);
+        [unroll] for (int k = -15; k <= 15; k++) {
+            int2 s = p + dir * k;
+            if (abs(k) <= r && all(s >= lo) && all(s < hi)) {
+                g += q.poly[abs(k) >> 2][abs(k) & 3] * t_sprite.Load(int3(s, 0));
+            }
+        }
+        return g;
+    }
+    // KaminIDE patch: подложка без размытия (blur_pass 4) — копия кадра
+    // один в один, матрица, маска скруглений и прозрачность элемента (pad).
+    // Стоит ДО ветки групп (blur_pass > 2.5).
+    if (q.blur_pass > 3.5) {
+        float4 backdrop = t_sprite.Sample(s_sprite, input.uv);
+        float4 o = backdrop_matrix(q, backdrop);
+        float distance = quad_sdf(input.position.xy, q.bounds, q.corner_radii);
+        float alpha = o.a * saturate(0.5 - distance) * q.pad;
+        if (backdrop.a == 1.0) {
+            // Compositing 1 §5.1: source-over onto an opaque backdrop is a
+            // weighted sum with opaque output. D3D11 §17.5 permits UNORM
+            // blend precision; compute in float to avoid weighting colors
+            // with quantized alpha (0.5 becomes 128/255).
+            return float4(lerp(backdrop.rgb, o.rgb, alpha), 1.0);
+        }
+        return float4(o.rgb, alpha);
+    }
+    // KaminIDE patch: композит буфера группы. Картинка уже готова — её
+    // нельзя размазывать, поэтому выборка одна, а маска скруглений и
+    // прозрачность группы гасят и цвет, и альфу (цвет премультиплирован).
+    if (q.blur_pass > 2.5) {
+        float4 src = group_source(q, input.position.xy);
+        if (q.blend_mode == 0u) {
+            return src;
+        }
+        // Цвет назначения — копия кадра под группой.
+        float4 dst = t_backdrop.Load(int3(int2(floor(input.position.xy) - q.backdrop_rect.xy), 0));
+        return composite_mix(q.blend_mode, src, dst);
+    }
+    // Tent 3x3: с билинейкой и каскадом /2 → мягкое размытие без колец.
+    float4 c = blur_tap(q, input.uv, float2(0.0, 0.0)) * 0.25;
+    c += blur_tap(q, input.uv, float2(-t.x, 0.0)) * 0.125;
+    c += blur_tap(q, input.uv, float2( t.x, 0.0)) * 0.125;
+    c += blur_tap(q, input.uv, float2(0.0, -t.y)) * 0.125;
+    c += blur_tap(q, input.uv, float2(0.0,  t.y)) * 0.125;
+    c += blur_tap(q, input.uv, float2(-t.x, -t.y)) * 0.0625;
+    c += blur_tap(q, input.uv, float2( t.x, -t.y)) * 0.0625;
+    c += blur_tap(q, input.uv, float2(-t.x,  t.y)) * 0.0625;
+    c += blur_tap(q, input.uv, float2( t.x,  t.y)) * 0.0625;
+    if (q.blur_pass < 0.5) {
+        float distance = quad_sdf(input.position.xy, q.bounds, q.corner_radii);
+        float mask = saturate(0.5 - distance);
+        if (q.pad2.x > 0.5) {
+            // Размытие + цветовые функции: подложка непрозрачна (каскад
+            // ставит a = 1), матрица — поверх размытого.
+            float4 o = backdrop_matrix(q, float4(c.rgb, 1.0));
+            c = float4(o.rgb, o.a * mask);
+        } else {
+            c = float4(c.rgb * mask, mask);
+        }
+    } else if (q.blur_pass < 1.5) {
+        // Фон непрозрачен по определению: копия кадра.
+        c.a = 1.0;
+    }
+    // KaminIDE patch: у группы прозрачность — часть картинки (режим 2),
+    // поэтому её оставляем как есть.
+    return c;
+}
+
+/*
+**
+**              Frame clear
+**
+*/
+
+// KaminIDE patch: the frame clear is drawn as a target-covering strip with
+// blending off instead of ClearRenderTargetView. On Intel Iris Xe the
+// hardware clear is not reliably ordered before the draws that follow it:
+// single pixels of later primitives come out wrong (see `quad_clear.rs`).
+struct ClearColor {
+    float4 color;
+};
+
+StructuredBuffer<ClearColor> clear_colors: register(t1);
+
+struct ClearVertexOutput {
+    float4 position: SV_Position;
+    nointerpolation float4 color: COLOR;
+};
+
+ClearVertexOutput clear_vertex(uint vertex_id: SV_VertexID) {
+    float2 unit_vertex = float2(float(vertex_id & 1u), 0.5 * float(vertex_id & 2u));
+    ClearVertexOutput output;
+    output.position = float4(unit_vertex.x * 2.0 - 1.0, 1.0 - unit_vertex.y * 2.0, 0.0, 1.0);
+    output.color = clear_colors[0].color;
+    return output;
+}
+
+float4 clear_fragment(ClearVertexOutput input): SV_Target {
+    return input.color;
+}
+
+// KaminIDE patch: a run of group composites in one pass (`group_tiles`).
+//
+// blur_quads[0] is the cover: bounds = the run's rectangle, src_origin = the
+// tile grid's corner, poly_count = tiles per row. Composites are
+// blur_quads[1..]. tile_lists holds the first entry of every tile (one more
+// than the tiles, the last is the end), then composite indices, each tile's in
+// document order. Every pixel starts from the backdrop copy and applies the
+// composites covering it in order, rounding to the 8-bit target after every
+// step: the canonical group arithmetic (design.md), the frame the copy path
+// writes composite by composite.
+#define GROUP_TILE 16.0
+StructuredBuffer<uint> tile_lists: register(t4);
+
+// The pixels the composite's own draw covers: its rectangle with vertices on
+// the rasterizer's 1/256 grid (D3D11 §15.13: top-left rule) and the content
+// mask the clip distances keep (§15.4: kept at distance >= 0).
+bool composite_covers(BlurQuad q, float2 c) {
+    float2 lo = round(q.bounds.origin * 256.0) / 256.0;
+    float2 hi = round((q.bounds.origin + q.bounds.size) * 256.0) / 256.0;
+    float2 mlo = q.content_mask.origin;
+    float2 mhi = mlo + q.content_mask.size;
+    return all(c >= lo) && all(c < hi) && all(c >= mlo) && all(c <= mhi);
+}
+
+BlurVertexOutput group_tiles_vertex(uint vertex_id: SV_VertexID) {
+    float2 unit_vertex = float2(float(vertex_id & 1u), 0.5 * float(vertex_id & 2u));
+    BlurVertexOutput output;
+    output.position = to_device_position(unit_vertex, blur_quads[0].bounds);
+    output.uv = unit_vertex;
+    output.quad_id = 0u;
+    output.clip_distance = float4(1.0, 1.0, 1.0, 1.0);
+    return output;
+}
+
+float4 group_tiles_fragment(BlurFragmentInput input): SV_Target {
+    float2 c = input.position.xy;
+    BlurQuad cover = blur_quads[0];
+    float4 dst = t_backdrop.Load(int3(int2(floor(c)), 0));
+    uint2 tile = uint2(floor((c - cover.src_origin) / GROUP_TILE));
+    uint t = tile.y * cover.poly_count + tile.x;
+    uint end = tile_lists[t + 1u];
+    float2 p = c + global_origin;
+    for (uint i = tile_lists[t]; i < end; i++) {
+        BlurQuad q = blur_quads[tile_lists[i]];
+        if (!composite_covers(q, c)) {
+            continue;
+        }
+        float4 src = group_source_with(q, p, true);
+        float4 o = q.blend_mode == 0u ? src + dst * (1.0 - src.a) : composite_mix(q.blend_mode, src, dst);
+        dst = round(saturate(o) * 255.0) / 255.0;
+    }
+    return dst;
+}
