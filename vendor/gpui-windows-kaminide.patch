index 0000000000000000000000000000000000000000..e5829845ce1e7c40f428f0f273fecce70482b1ce
--- /dev/null
+++ b/vendor/gpui-windows/src/directx_renderer/cull/pass.rs
@@ -0,0 +1,374 @@
+//! KaminIDE patch: the redraw rectangles of a frame drawn in one pass from
+//! the instances that reach them (`cull`).
+//!
+//! The frame's batches are walked in paint order, retained layers expanded
+//! at their place, exactly as a whole frame draws them. Instance batches
+//! leave only their gathered copies; a batch whose copies follow a run of the
+//! same kind (and atlas texture) without anything drawn between joins that
+//! run's draw. Paths and surfaces (group composites, backdrop passes) read
+//! or write beyond their instances, so they stay rectangle by rectangle under
+//! the scissor, as before, without the group composites whose region misses
+//! the rectangle (`composite_region`) and the path batches that miss it
+//! (`path_pass`). A layer drawn this way keeps its cached buffers
+//! for the next whole frame (`LayerCache::keep`).
+
+use super::super::{
+    DirectXRenderer, batch_area, group_batch::LayerInstances, group_region::Region,
+};
+use super::{bounds, disjoint, extent, gather, region};
+use anyhow::Result;
+use gpui::{AtlasTextureId, ContentMask, GradientData, PrimitiveBatch, Quad, ScaledPixels, Scene};
+use std::ops::Range;
+
+/// What one draw of the pass draws: an instance kind and its atlas texture.
+#[derive(Clone, Copy, PartialEq)]
+enum Kind {
+    Shadows,
+    Quads,
+    Underlines,
+    Mono(AtlasTextureId),
+    Subpixel(AtlasTextureId),
+    Poly(AtlasTextureId),
+}
+
+impl Kind {
+    /// The batch kind of the frame instrumentation (`batch_area`).
+    fn index(self) -> usize {
+        match self {
+            Kind::Shadows => 0,
+            Kind::Quads => 1,
+            Kind::Underlines => 3,
+            Kind::Mono(_) => 4,
+            Kind::Subpixel(_) => 5,
+            Kind::Poly(_) => 6,
+        }
+    }
+}
+
+enum Op<'s> {
+    /// Gathered instances `range` of one kind; `area` pixels they cover.
+    Draw {
+        kind: Kind,
+        range: Range<usize>,
+        area: f64,
+    },
+    /// A batch drawn within each rectangle in turn.
+    Each(&'s Scene, PrimitiveBatch),
+    /// Gathered instances `range` of one kind, uncut, drawn within each
+    /// rectangle in turn under the scissor (`gather_runs`).
+    Scissored { kind: Kind, range: Range<usize> },
+}
+
+/// The pass being gathered.
+struct Gather<'s> {
+    ops: Vec<Op<'s>>,
+    /// No quad batch was met yet: the first one's quad 0 may be the clear.
+    first_quads: bool,
+    backdrop: bool,
+    /// Where each scene's gradients start in the pass's gradient buffer.
+    bases: Vec<(*const Scene, u32)>,
+}
+
+impl Gather<'_> {
+    fn push(&mut self, kind: Kind, (n, area): (usize, f64), end: usize) {
+        if n == 0 {
+            return;
+        }
+        if let Some(Op::Draw {
+            kind: k,
+            range,
+            area: a,
+        }) = self.ops.last_mut()
+            && *k == kind
+        {
+            range.end = end;
+            *a += area;
+            return;
+        }
+        self.ops.push(Op::Draw {
+            kind,
+            range: end - n..end,
+            area,
+        });
+    }
+
+    /// Gather `items` in paint order: a run whose extent is known as cut
+    /// copies (`gather`), a run that a transformation moves (no extent) once
+    /// each with its own mask, drawn within each rectangle under the scissor.
+    /// A mask cut through a transformed instance clips its triangles anew
+    /// (`SV_ClipDistance`, clipped as geometry on WARP), moving the edge
+    /// pixels the whole frame draws; the scissor tests pixels only.
+    fn gather_runs<T: Copy>(
+        &mut self,
+        kind: Kind,
+        out: &mut Vec<T>,
+        items: &[T],
+        rects: &[[f32; 4]],
+        extent: impl Fn(&T) -> Option<[f32; 4]>,
+        mask: impl Fn(&mut T) -> &mut ContentMask<ScaledPixels>,
+    ) {
+        let mut at = 0;
+        while at < items.len() {
+            let moved = extent(&items[at]).is_none();
+            let run = items[at..].iter().take_while(|item| extent(item).is_none() == moved).count();
+            let part = &items[at..at + run];
+            if moved {
+                let start = out.len();
+                out.extend_from_slice(part);
+                match self.ops.last_mut() {
+                    Some(Op::Scissored { kind: k, range }) if *k == kind && range.end == start => range.end = out.len(),
+                    _ => self.ops.push(Op::Scissored { kind, range: start..out.len() }),
+                }
+            } else {
+                let got = gather(out, part, rects, &extent, &mask);
+                self.push(kind, got, out.len());
+            }
+            at += run;
+        }
+    }
+
+    fn gradient_base(&mut self, scene: &Scene, gradients: &mut GradientData) -> u32 {
+        let key = scene as *const Scene;
+        if let Some(&(_, base)) = self.bases.iter().find(|(s, _)| *s == key) {
+            return base;
+        }
+        let base = gradients.descriptors.len() as u32;
+        gradients.append(scene, &mut []);
+        self.bases.push((key, base));
+        base
+    }
+}
+
+impl DirectXRenderer {
+    /// Draw `scene` within `rects` (cleared first) in one pass. The scissor
+    /// goes on only now: the group passes and their blurs write other
+    /// targets in their own coordinates.
+    pub(in super::super) fn draw_scene_within(
+        &mut self,
+        scene: &Scene,
+        rects: &[Region],
+        clear_color: [f32; 4],
+    ) -> Result<()> {
+        let rects = disjoint(rects);
+        let Some(all) = bounds(&rects) else {
+            return Ok(());
+        };
+        let mut instances = std::mem::take(&mut self.blur.layer_instances);
+        instances.clear();
+        let mut g = Gather {
+            ops: Vec::new(),
+            first_quads: true,
+            backdrop: self.backdrop.is_some(),
+            bases: Vec::new(),
+        };
+        self.gather_scene(scene, &rects, &mut instances, &mut g);
+        let state = self.begin_scissor(all)?;
+        let clear = *self.backdrop.as_ref().unwrap_or(&clear_color);
+        let drawn = self.draw_gathered(&rects, all, clear, &instances, g.ops);
+        self.blur.frame_within = None;
+        self.backdrop_pending = false;
+        unsafe { self.dev().device_context.RSSetState(&state) };
+        instances.clear();
+        self.blur.layer_instances = instances;
+        drawn
+    }
+
+    fn gather_scene<'s>(
+        &mut self,
+        scene: &'s Scene,
+        rects: &[[f32; 4]],
+        all: &mut LayerInstances,
+        g: &mut Gather<'s>,
+    ) {
+        for batch in scene.batches() {
+            match batch {
+                PrimitiveBatch::Layer(index) => {
+                    if let Some(layer) = scene.layer(index) {
+                        self.layer_cache.keep(layer.id());
+                        self.gather_scene(layer.scene(), rects, all, g);
+                    }
+                }
+                PrimitiveBatch::Paths(_) | PrimitiveBatch::Surfaces(_) => {
+                    g.ops.push(Op::Each(scene, batch))
+                }
+                PrimitiveBatch::Shadows(r) => {
+                    let got = gather(
+                        &mut all.shadows,
+                        &scene.shadows[r],
+                        rects,
+                        shadow_extent,
+                        |s| &mut s.content_mask,
+                    );
+                    g.push(Kind::Shadows, got, all.shadows.len());
+                }
+                PrimitiveBatch::Quads(r) => {
+                    // The frame clear drew the first quad of a frame with a backdrop.
+                    let skip = std::mem::take(&mut g.first_quads) && g.backdrop && r.start == 0;
+                    let start = all.quads.len();
+                    let items = &scene.quads[r.start + usize::from(skip)..r.end];
+                    g.gather_runs(
+                        Kind::Quads,
+                        &mut all.quads,
+                        items,
+                        rects,
+                        |q| extent(q.bounds, &q.content_mask, Some(&q.transformation), 1.0),
+                        |q| &mut q.content_mask,
+                    );
+                    if all.quads[start..].iter().any(Quad::is_analytic_gradient) {
+                        let base = g.gradient_base(scene, &mut all.gradients);
+                        all.quads[start..]
+                            .iter_mut()
+                            .for_each(|q| q.offset_gradient(base));
+                    }
+                }
+                PrimitiveBatch::Underlines(r) => {
+                    let got = gather(
+                        &mut all.underlines,
+                        &scene.underlines[r],
+                        rects,
+                        |u| extent(u.bounds, &u.content_mask, None, 1.0),
+                        |u| &mut u.content_mask,
+                    );
+                    g.push(Kind::Underlines, got, all.underlines.len());
+                }
+                PrimitiveBatch::MonochromeSprites { texture_id, range } => {
+                    let items = &scene.monochrome_sprites[range];
+                    g.gather_runs(
+                        Kind::Mono(texture_id),
+                        &mut all.mono,
+                        items,
+                        rects,
+                        |s| extent(s.bounds, &s.content_mask, Some(&s.transformation), 1.0),
+                        |s| &mut s.content_mask,
+                    );
+                }
+                PrimitiveBatch::SubpixelSprites { texture_id, range } => {
+                    let items = &scene.subpixel_sprites[range];
+                    g.gather_runs(
+                        Kind::Subpixel(texture_id),
+                        &mut all.subpixel,
+                        items,
+                        rects,
+                        |s| extent(s.bounds, &s.content_mask, Some(&s.transformation), 1.0),
+                        |s| &mut s.content_mask,
+                    );
+                }
+                PrimitiveBatch::PolychromeSprites { texture_id, range } => {
+                    let items = &scene.polychrome_sprites[range];
+                    g.gather_runs(
+                        Kind::Poly(texture_id),
+                        &mut all.poly,
+                        items,
+                        rects,
+                        |s| extent(s.bounds, &s.content_mask, Some(&s.transformation), 1.0),
+                        |s| &mut s.content_mask,
+                    );
+                }
+            }
+        }
+    }
+
+    fn draw_gathered(
+        &mut self,
+        rects: &[[f32; 4]],
+        all: Region,
+        clear: [f32; 4],
+        instances: &LayerInstances,
+        ops: Vec<Op>,
+    ) -> Result<()> {
+        self.restore_frame_globals()?;
+        for r in rects {
+            self.set_scissor(region(r));
+            self.clear_frame(clear)?;
+        }
+        self.set_scissor(all);
+        self.upload_instances(instances)?;
+        // The clear drew the backdrop quad: it was left out of the gathered quads.
+        self.backdrop_pending = false;
+        for op in ops {
+            let cost = match &op {
+                Op::Draw { kind, range, area } => (kind.index(), range.len(), *area),
+                Op::Scissored { kind, range } => (kind.index(), range.len() * rects.len(), 0.0),
+                Op::Each(scene, batch) => batch_area(scene, batch),
+            };
+            match op {
+                Op::Draw { kind, range, .. } => self.draw_kind(kind, range, instances)?,
+                Op::Scissored { kind, range } => {
+                    for r in rects {
+                        self.set_scissor(region(r));
+                        self.draw_kind(kind, range.clone(), instances)?;
+                    }
+                    self.set_scissor(all);
+                }
+                Op::Each(scene, batch) => {
+                    for r in rects {
+                        self.set_scissor(region(r));
+                        self.blur.frame_within = Some(region(r));
+                        match &batch {
+                            // Works within the rectangle only (`path_pass`).
+                            PrimitiveBatch::Paths(range) => {
+                                self.draw_paths(&scene.paths[range.clone()])?
+                            }
+                            PrimitiveBatch::Surfaces(range) => {
+                                // A group composite writes only within its
+                                // region: one that misses the rectangle is left out.
+                                let within: Vec<_> = scene.surfaces[range.clone()]
+                                    .iter()
+                                    .filter(|s| {
+                                        s.group == 0 || self.composite_region(s).meets(region(r))
+                                    })
+                                    .cloned()
+                                    .collect();
+                                if !within.is_empty() {
+                                    self.draw_surfaces(&within)?;
+                                }
+                            }
+                            _ => {}
+                        }
+                    }
+                    self.blur.frame_within = None;
+                    self.set_scissor(all);
+                }
+            }
+            if self.timing_main {
+                let (kind, prims, area) = cost;
+                self.gpu_timer
+                    .instrumentation
+                    .batches
+                    .count(kind, prims, area);
+                let (device, ctx) = (self.dev().device.clone(), self.dev().device_context.clone());
+                self.gpu_timer.mark(&device, &ctx, kind);
+            }
+        }
+        Ok(())
+    }
+}
+
+impl DirectXRenderer {
+    /// Draw the gathered instances `range` of `kind`.
+    fn draw_kind(&mut self, kind: Kind, range: Range<usize>, instances: &LayerInstances) -> Result<()> {
+        let (start, len) = (range.start, range.len());
+        match kind {
+            Kind::Shadows => self.draw_shadows(start, len),
+            Kind::Quads => self.draw_quads(&instances.quads[range], start),
+            Kind::Underlines => self.draw_underlines(start, len),
+            Kind::Mono(t) => self.draw_monochrome_sprites(t, start, len),
+            Kind::Subpixel(t) => self.draw_subpixel_sprites(t, start, len),
+            Kind::Poly(t) => self.draw_polychrome_sprites(t, start, len),
+        }
+    }
+}
+
+/// The pixels a shadow can write (`shadow_vertex`): an inset one its
+/// element's box, a drop shadow its box with the gaussian tail.
+fn shadow_extent(s: &gpui::Shadow) -> Option<[f32; 4]> {
+    if s.inset != 0 {
+        return extent(s.element_bounds, &s.content_mask, None, 1.0);
+    }
+    extent(
+        s.bounds,
+        &s.content_mask,
+        None,
+        3.0 * s.blur_radius.0.max(0.0) + 1.0,
+    )
+}
diff --git a/vendor/gpui-windows/src/directx_renderer/cull/tests.rs b/vendor/gpui-windows/src/directx_renderer/cull/tests.rs
new file mode 100644
index 0000000000000000000000000000000000000000..4b0c22223bdac4b8ee8815338d15a85799a0e89b
--- /dev/null
+++ b/vendor/gpui-windows/src/directx_renderer/cull/tests.rs
@@ -0,0 +1,120 @@
+//! Tests of the instances gathered for redraw rectangles (`cull`).
+
+use super::*;
+use gpui::{point, size};
+
+fn b(x: f32, y: f32, w: f32, h: f32) -> Bounds<ScaledPixels> {
+    Bounds {
+        origin: point(ScaledPixels(x), ScaledPixels(y)),
+        size: size(ScaledPixels(w), ScaledPixels(h)),
+    }
+}
+
+fn r(x: u32, y: u32, width: u32, height: u32) -> Region {
+    Region {
+        x,
+        y,
+        width,
+        height,
+    }
+}
+
+#[test]
+fn every_instance_is_copied_once_per_rectangle_it_reaches_in_batch_order() {
+    let mask = ContentMask {
+        bounds: b(0.0, 0.0, 800.0, 600.0),
+    };
+    // Ten rows 60 px apart; a strip at the bottom and a bar on the right.
+    let items: Vec<_> = (0..10)
+        .map(|k| (b(0.0, 60.0 * k as f32, 800.0, 20.0), mask))
+        .collect();
+    let rects = disjoint(&[r(0, 480, 800, 120), r(780, 0, 20, 600)]);
+    let mut out = Vec::new();
+    let (n, _) = gather(
+        &mut out,
+        &items,
+        &rects,
+        |i| extent(i.0, &i.1, None, 1.0),
+        |i| &mut i.1,
+    );
+    assert_eq!(n, out.len());
+    // Rows 0..8 reach only the bar above the strip, row 9 only the strip,
+    // row 8 both (its antialiasing margin crosses the strip's top edge).
+    let ys: Vec<f32> = out.iter().map(|i| i.0.origin.y.0).collect();
+    let want: Vec<f32> = (0..8)
+        .map(|k| 60.0 * k as f32)
+        .chain([480.0, 480.0, 540.0])
+        .collect();
+    assert_eq!(ys, want);
+    for (i, item) in out.iter().enumerate() {
+        let m = item.1.bounds;
+        let inside = rects.iter().any(|q| {
+            m.origin.x.0 >= q[0]
+                && m.origin.y.0 >= q[1]
+                && m.origin.x.0 + m.size.width.0 <= q[2]
+                && m.origin.y.0 + m.size.height.0 <= q[3]
+        });
+        assert!(inside, "copy {i} {m:?} outside every rectangle");
+    }
+}
+
+#[test]
+fn an_edge_the_rectangle_keeps_keeps_its_float() {
+    // A mask edge at a pixel centre: the shader keeps pixels at distance 0.
+    let mut m = ContentMask {
+        bounds: b(10.5, 3.25, 489.5, 100.0),
+    };
+    let end = m.bounds.origin.x.0 + m.bounds.size.width.0;
+    assert!(cut(&mut m, &[100.0, 0.0, 800.0, 600.0]));
+    assert_eq!(m.bounds.origin.x.0, 100.0);
+    assert_eq!(m.bounds.origin.x.0 + m.bounds.size.width.0, end);
+    assert_eq!((m.bounds.origin.y.0, m.bounds.size.height.0), (3.25, 100.0));
+    let mut whole = ContentMask {
+        bounds: b(1.0 / 3.0, 0.1, 7.7, 9.9),
+    };
+    let before = whole;
+    assert!(cut(&mut whole, &[0.0, 0.0, 800.0, 600.0]));
+    assert_eq!(whole, before);
+    let mut outside = ContentMask {
+        bounds: b(0.0, 0.0, 10.0, 10.0),
+    };
+    assert!(!cut(&mut outside, &[10.0, 0.0, 20.0, 10.0]));
+}
+
+#[test]
+fn rectangles_become_disjoint_and_cover_the_same_pixels() {
+    let rects = [r(0, 0, 100, 100), r(50, 50, 100, 100), r(0, 0, 10, 10)];
+    let parts = disjoint(&rects);
+    let covered = |x: f32, y: f32| {
+        parts
+            .iter()
+            .filter(|p| p[0] <= x && x < p[2] && p[1] <= y && y < p[3])
+            .count()
+    };
+    for y in (0..160).step_by(5) {
+        for x in (0..160).step_by(5) {
+            let (x, y) = (x as f32 + 0.5, y as f32 + 0.5);
+            let want = usize::from(
+                x < 100.0 && y < 100.0 || (50.0..150.0).contains(&x) && (50.0..150.0).contains(&y),
+            );
+            assert_eq!(covered(x, y), want, "pixel {x} {y}");
+        }
+    }
+    assert_eq!(bounds(&parts), Some(r(0, 0, 150, 150)));
+}
+
+#[test]
+fn a_transformation_reaches_every_rectangle() {
+    let clipped = ContentMask {
+        bounds: b(0.0, 0.0, 800.0, 100.0),
+    };
+    assert_eq!(
+        extent(b(0.0, 50.0, 10.0, 500.0), &clipped, None, 1.0).map(|e| e[3]),
+        Some(100.0)
+    );
+    let mut turned = TransformationMatrix::unit();
+    turned.translation[1] = 500.0;
+    let e = extent(b(0.0, 0.0, 10.0, 10.0), &clipped, Some(&turned), 1.0);
+    assert_eq!(e, None);
+    assert!(meets(e, &[700.0, 500.0, 800.0, 600.0]));
+}
diff --git a/vendor/gpui-windows/src/directx_renderer/damage_audit.rs b/vendor/gpui-windows/src/directx_renderer/damage_audit.rs
new file mode 100644
index 0000000000000000000000000000000000000000..a1f516eb2ac0ec493bf706b80ef604728f953369
--- /dev/null
+++ b/vendor/gpui-windows/src/directx_renderer/damage_audit.rs
@@ -0,0 +1,113 @@
+//! KaminIDE patch: сверка кадра, нарисованного по плану (повреждение, кэш
+//! групп), с тем же кадром, нарисованным целиком без кэша групп.
+//!
+//! Только для стенда ([`set_damage_audit`]): каждый нарисованный кадр
+//! читается из цели, затем та же сцена рисуется заново целиком без картинок
+//! прошлого кадра и читается ещё раз. Несовпадение пишется в лог ошибкой с
+//! номером кадра, планом и рамкой различий. Цель после сверки держит целый
+//! кадр: следующий кадр сравнивается с верной базой, и ошибка видна там,
+//! где возникла, а не там, где накопилась.
+
+use super::*;
+use std::sync::atomic::{AtomicBool, AtomicU64, Ordering};
+
+static AUDIT: AtomicBool = AtomicBool::new(false);
+static MISMATCHES: AtomicU64 = AtomicU64::new(0);
+
+/// Включить сверку для всех окон процесса (стенд, сверка RGB).
+pub fn set_damage_audit(on: bool) {
+    AUDIT.store(on, Ordering::Relaxed);
+}
+
+/// Число кадров, не совпавших с целой перерисовкой, с начала процесса.
+pub fn damage_audit_mismatches() -> u64 {
+    MISMATCHES.load(Ordering::Relaxed)
+}
+
+pub(super) fn enabled() -> bool {
+    AUDIT.load(Ordering::Relaxed)
+}
+
+impl DirectXRenderer {
+    /// Compare the frame just drawn by plan `within` with a whole redraw.
+    pub(super) fn audit_frame(
+        &mut self,
+        scene: &Scene,
+        background: WindowBackgroundAppearance,
+        within: &retained::Plan,
+    ) -> Result<()> {
+        let planned = self.read_target()?;
+        let (kept, drawn) = (
+            self.retained.groups.counts.kept,
+            self.retained.groups.counts.drawn,
+        );
+        // Целый кадр без картинок групп прошлого кадра.
+        self.retained.chain = None;
+        self.retained.group_chain = None;
+        self.retained.groups.valid.clear();
+        self.render(scene, background, None)?;
+        let whole = self.read_target()?;
+        let w = self.width as usize;
+        let mut count = 0usize;
+        let (mut x0, mut y0, mut x1, mut y1) = (usize::MAX, usize::MAX, 0, 0);
+        let mut first = None;
+        for (i, (a, b)) in planned
+            .chunks_exact(4)
+            .zip(whole.chunks_exact(4))
+            .enumerate()
+        {
+            if a[..3] != b[..3] {
+                count += 1;
+                let (x, y) = (i % w, i / w);
+                first.get_or_insert((x, y, [a[0], a[1], a[2]], [b[0], b[1], b[2]]));
+                (x0, y0, x1, y1) = (x0.min(x), y0.min(y), x1.max(x), y1.max(y));
+            }
+        }
+        if count > 0 {
+            MISMATCHES.fetch_add(1, Ordering::Relaxed);
+            let (_, base, id, _) = scene.frame_damage();
+            log::error!(
+                "damage audit: frame {id} (base {base}) plan {within:?}, groups kept {kept} drawn {drawn}: \
+                 {count} px differ from the whole frame in x {x0}..={x1} y {y0}..={y1}"
+            );
+            if let Some((x, y, planned, whole)) = first {
+                log::error!(
+                    "damage audit: first at ({x}, {y}) planned bgr {planned:?} whole {whole:?}; primitives there {:?}",
+                    scene.primitives_at(x as f32, y as f32)
+                );
+            }
+        }
+        Ok(())
+    }
+
+    /// The render target as tightly packed BGRA rows.
+    fn read_target(&mut self) -> Result<Vec<u8>> {
+        let (w, h) = (self.width, self.height);
+        let staging = self.capture_staging()?;
+        let ctx = self.dev().device_context.clone();
+        let target = self
+            .res()
+            .render_target
+            .as_ref()
+            .context("render target missing")?;
+        unsafe { ctx.CopyResource(&staging, target) };
+        let mut mapped = D3D11_MAPPED_SUBRESOURCE::default();
+        unsafe { ctx.Map(&staging, 0, D3D11_MAP_READ, 0, Some(&mut mapped))? };
+        let row = (w * 4) as usize;
+        let mut out = vec![0u8; row * h as usize];
+        for y in 0..h as usize {
+            // KaminIDE patch: SAFETY: the mapped staging texture is w x h
+            // BGRA8; each of its rows has RowPitch >= w * 4 readable bytes
+            // until Unmap below.
+            let src = unsafe {
+                std::slice::from_raw_parts(
+                    (mapped.pData as *const u8).add(y * mapped.RowPitch as usize),
+                    row,
+                )
+            };
+            out[y * row..(y + 1) * row].copy_from_slice(src);
+        }
+        unsafe { ctx.Unmap(&staging, 0) };
+        Ok(out)
+    }
+}
diff --git a/vendor/gpui-windows/src/directx_renderer/effect_targets.rs b/vendor/gpui-windows/src/directx_renderer/effect_targets.rs
new file mode 100644
index 0000000000000000000000000000000000000000..b8f38313c44fb8d3cc21edfbf1d7b8011e5f62ab
--- /dev/null
+++ b/vendor/gpui-windows/src/directx_renderer/effect_targets.rs
@@ -0,0 +1,127 @@
+//! Effect scratch belongs to the complete scene, independently of its damage.
+//!
+//! A retained group may need its scratch again after a mutation, so an unchanged
+//! frame keeps it. Removing the last user releases it, including cached mask
+//! uploads. No texture dimensions, sampling or paint operations change here.
+
+use super::*;
+
+#[derive(Default, Debug, PartialEq, Eq)]
+struct Demand {
+    groups: bool,
+    backdrop: bool,
+    cascade: bool,
+    gaussian: bool,
+    blend: bool,
+}
+
+impl Demand {
+    fn scene(scene: &Scene) -> Self {
+        let mut demand = Self::default();
+        demand.visit(scene);
+        demand
+    }
+
+    fn visit(&mut self, scene: &Scene) {
+        for surface in &scene.surfaces {
+            if surface.group == 0 {
+                self.backdrop = true;
+                self.cascade |= surface.color_matrix.is_none() || surface.blur_radius > 0.0;
+            }
+        }
+        self.groups |= !scene.groups.is_empty();
+        for group in &scene.groups {
+            self.blend |= group.blend != 0;
+            if group.blur_radius > 0.0 {
+                match gaussian::direct_radius(group.blur_radius) {
+                    Some(radius) => self.gaussian |= radius > gaussian::MAX_SINGLE_PASS_RADIUS,
+                    None => self.cascade = true,
+                }
+            }
+            self.visit(&group.scene);
+        }
+    }
+}
+
+impl DirectXRenderer {
+    pub(super) fn release_unused_effect_targets(&mut self, scene: &Scene) {
+        let demand = Demand::scene(scene);
+        let instrumented = self.gpu_timer.instrumentation.config().gpu_timing;
+        let (mut released, mut bytes) = (0, 0);
+        let mut dropped = |texture: &ID3D11Texture2D| {
+            released += 1;
+            if instrumented {
+                bytes += gpu_memory::texture_bytes(texture);
+            }
+        };
+        let blur = &mut self.blur;
+        let masks_dropped = blur.mask_cache.retain_scene(scene, &mut dropped);
+        for (needed, target) in [
+            (demand.groups, &mut blur.stage),
+            (demand.backdrop, &mut blur.copy),
+            (demand.gaussian, &mut blur.gauss),
+            // Tile composites read a backdrop even with normal source-over.
+            (
+                demand.blend || (demand.groups && self.group_tiles),
+                &mut blur.level_backdrop,
+            ),
+            (demand.blend, &mut blur.blend_copy),
+        ] {
+            if !needed && let Some(target) = target.take() {
+                dropped(&target.texture);
+            }
+        }
+        for (needed, targets) in [
+            (demand.groups, &mut blur.groups),
+            (demand.cascade, &mut blur.down),
+        ] {
+            if !needed {
+                for target in targets.drain(..) {
+                    dropped(&target.texture);
+                }
+            }
+        }
+        if !demand.blend {
+            for target in blur.pool.idle() {
+                dropped(&target.texture);
+            }
+            blur.pool = Default::default();
+        }
+        // Composite data is rebuilt before drawing, and is unused by a kept
+        // frame. Its SRVs must not keep the previous scene's masks alive.
+        if masks_dropped > 0 {
+            blur.group_mask.clear();
+        }
+        if !demand.groups {
+            blur.stage_dirty.clear();
+            blur.layer.clear();
+            blur.layer_instances = Default::default();
+            blur.stage_rasterizer = None;
+            blur.group_place.clear();
+            blur.group_regions.clear();
+            blur.group_slots.clear();
+            blur.group_blend.clear();
+            blur.group_poly.clear();
+            blur.group_mask.clear();
+            blur.group_clip.clear();
+            blur.group_proj.clear();
+            blur.group_frags.clear();
+            blur.mask_cache.clear();
+        }
+        if released > 0 {
+            // D3D's bindings own references too. The next pre_draw binds the
+            // frame target and every pass supplies its shader resources again.
+            let dc = &self.dev().device_context;
+            unsafe {
+                dc.PSSetShaderResources(0, Some(&[None, None, None, None]));
+                dc.OMSetRenderTargets(None, None);
+            }
+            if instrumented {
+                self.gpu_timer
+                    .instrumentation
+                    .batches
+                    .effect_targets_dropped(released, bytes);
+            }
+        }
+    }
+}
diff --git a/vendor/gpui-windows/src/directx_renderer/frame_capture.rs b/vendor/gpui-windows/src/directx_renderer/frame_capture.rs
new file mode 100644
index 0000000000000000000000000000000000000000..5ff0b653eee68f4001fef1a9a506bb3bd36cbfea
--- /dev/null
+++ b/vendor/gpui-windows/src/directx_renderer/frame_capture.rs
@@ -0,0 +1,111 @@
+//! KaminIDE patch: readback владеет неизменяемым контекстом своего устройства.
+
+use super::*;
+
+impl DirectXRenderer {
+    /// KaminIDE patch: copy the drawn back buffer to memory (`frame_capture`).
+    pub(super) fn capture_frame(&mut self) -> Result<()> {
+        let started = std::time::Instant::now();
+        let (w, h) = (self.width, self.height);
+        // KaminIDE patch: one staging texture per size (`retained.rs`).
+        let staging = self.capture_staging()?;
+        // KaminIDE patch: the frame is complete when the GPU has executed it;
+        // the copy below is the capture's own cost, reported apart (`copied`).
+        // The wait is reported apart too (`waited`): on a hardware adapter it
+        // is GPU execution the window path never waits for (`present` is
+        // DO_NOT_WAIT), on WARP it is the frame's CPU raster.
+        let waited = std::time::Instant::now();
+        self.wait_gpu_idle()?;
+        let gpu_wait = waited.elapsed();
+        let drawn = &self.retained.drawn;
+        let report = gpui::frame_capture::RasterReport {
+            plan: drawn.plan.to_string(),
+            full_by: drawn.full_by.map(str::to_string),
+            shift_miss: drawn.shift_miss.map(str::to_string),
+            shift_compare: drawn.shift_stats.map(|s| s.to_string()),
+            delta: drawn.delta,
+            moved_px: drawn.moved_px,
+            raster_px: drawn.rects.iter().map(|r| r[2] as u64 * r[3] as u64).sum(),
+            rects: drawn.rects.clone(),
+            gpu_wait,
+        };
+        if let Some(sink) = &mut self.capture {
+            sink.waited(gpu_wait);
+            sink.raster(report);
+        }
+        let devices = self.dev();
+        let render_target = self
+            .res()
+            .render_target
+            .as_ref()
+            .context("render target missing")?;
+        let ctx = &devices.device_context;
+        let copy_started = std::time::Instant::now();
+        unsafe { ctx.CopyResource(&staging, render_target) };
+        let mut mapped = D3D11_MAPPED_SUBRESOURCE::default();
+        unsafe { ctx.Map(&staging, 0, D3D11_MAP_READ, 0, Some(&mut mapped))? };
+        let row = (w * 4) as usize;
+        let mut bgra = vec![0u8; row * h as usize];
+        for y in 0..h as usize {
+            // KaminIDE patch: SAFETY: the mapped staging texture is w x h
+            // BGRA8, so each of its h rows has RowPitch >= w * 4 readable
+            // bytes until Unmap below.
+            let src = unsafe {
+                std::slice::from_raw_parts(
+                    (mapped.pData as *const u8).add(y * mapped.RowPitch as usize),
+                    row,
+                )
+            };
+            bgra[y * row..(y + 1) * row].copy_from_slice(src);
+        }
+        unsafe { ctx.Unmap(&staging, 0) };
+        // KaminIDE patch: capture retains the device generation used by this target.
+        let mut target_desc = D3D11_TEXTURE2D_DESC::default();
+        unsafe { render_target.GetDesc(&mut target_desc) };
+        let mut shader_executables: Vec<_> = [
+            &self.pipelines.shadow_pipeline.shader_executables,
+            &self.pipelines.quad_pipeline.shader_executables,
+            &self.pipelines.path_rasterization_pipeline.shader_executables,
+            &self.pipelines.path_sprite_pipeline.shader_executables,
+            &self.pipelines.underline_pipeline.shader_executables,
+            &self.pipelines.mono_sprites.shader_executables,
+            &self.pipelines.subpixel_sprites.shader_executables,
+            &self.pipelines.poly_sprites.shader_executables,
+            &self.pipelines.blur_pipeline.shader_executables,
+            &self.pipelines.clear_pipeline.shader_executables,
+        ].into_iter().flatten().cloned().collect();
+        shader_executables.push(self.pipelines.quad_gradient.executable.clone());
+        shader_executables.sort();
+        shader_executables.dedup();
+        let context = Some(gpui::frame_capture::FrameContext {
+            device: devices.context.clone(), shader_executables, target_format: target_desc.Format.0,
+            sample_count: target_desc.SampleDesc.Count, sample_quality: target_desc.SampleDesc.Quality,
+            gamma_ratios: self.font_info.gamma_ratios,
+            grayscale_enhanced_contrast: self.font_info.grayscale_enhanced_contrast,
+        });
+        if let Some(sink) = &mut self.capture {
+            sink.copied(copy_started.elapsed());
+            sink.completed(gpui::frame_capture::CapturedFrame { width: w, height: h, bgra, context }, started.elapsed());
+        }
+        Ok(())
+    }
+
+    /// The capture staging texture for the current size, created once per size.
+    pub(super) fn capture_staging(&mut self) -> Result<ID3D11Texture2D> {
+        let (w, h) = (self.width, self.height);
+        if let Some((sw, sh, texture)) = &self.retained.staging
+            && (*sw, *sh) == (w, h)
+        {
+            return Ok(texture.clone());
+        }
+        let mut desc = offscreen_target_desc(w, h);
+        desc.Usage = D3D11_USAGE_STAGING;
+        desc.BindFlags = 0;
+        desc.CPUAccessFlags = D3D11_CPU_ACCESS_READ.0 as u32;
+        let mut staging: Option<ID3D11Texture2D> = None;
+        unsafe { self.dev().device.CreateTexture2D(&desc, None, Some(&mut staging))? };
+        let staging = staging.context("staging texture")?;
+        self.retained.staging = Some((w, h, staging.clone()));
+        Ok(staging)
+    }
+}
diff --git a/vendor/gpui-windows/src/directx_renderer/gaussian.rs b/vendor/gpui-windows/src/directx_renderer/gaussian.rs
new file mode 100644
index 0000000000000000000000000000000000000000..304cc6147ed39210910c32d7f6b8a9c894262113
--- /dev/null
+++ b/vendor/gpui-windows/src/directx_renderer/gaussian.rs
@@ -0,0 +1,246 @@
+//! KaminIDE patch: separable Gaussian for a group's `filter: blur(σ)` with a small σ.
+//!
+//! Filter Effects 1 §blur(): the standard deviation of the Gaussian is the given length.
+//! The downsampling cascade below clamps its step to 1/5 of a pixel, so every σ under
+//! ~2.8 px rendered as the same σ ≈ 1.6 px blur and paid for a 2.5× supersampled
+//! first level (6.25× the group's pixels, nine taps each). Like WebRender
+//! (`MAX_BLUR_STD_DEVIATION`: downscale only while σ > 4) and Skia (direct kernels for
+//! small σ), a σ ≤ 4 device px is convolved exactly at full resolution, straight into the
+//! retained group texture: radius ≤ `MAX_SINGLE_PASS_RADIUS` as one 2D pass, larger radii
+//! as a horizontal pass into a half-float intermediate plus a vertical pass. Taps are
+//! integer texel loads; texels outside the source are transparent black (the filter
+//! input outside the group).
+
+use super::*;
+
+/// Largest σ (device px) convolved directly; above it the cascade downsamples.
+pub(super) const MAX_DIRECT_SIGMA: f32 = 4.0;
+/// Taps per side carried in `BlurQuad::poly` (16 floats).
+const MAX_TAPS: usize = 16;
+/// Largest kernel radius convolved in one 2D pass ((2r+1)² ≤ 81 loads per pixel). A second
+/// pass costs a render-target switch and a read-after-write barrier per group, which on the
+/// measured GPU outweighs the extra taps for these radii.
+pub(super) const MAX_SINGLE_PASS_RADIUS: usize = 4;
+
+/// Kernel half-width for a direct blur of `sigma`, or `None` when the cascade applies.
+pub(super) fn direct_radius(sigma: f32) -> Option<usize> {
+    (sigma.is_finite() && sigma > 0.0 && sigma <= MAX_DIRECT_SIGMA)
+        .then(|| ((3.0 * sigma).ceil() as usize).clamp(1, MAX_TAPS - 1))
+}
+
+/// Margin (device px) the blurred image spreads beyond the group bounds.
+pub(super) fn margin(sigma: f32) -> f32 {
+    match direct_radius(sigma) {
+        Some(r) => r as f32,
+        None => (24.0 * (sigma / 14.0).clamp(0.2, 6.0)).min(96.0),
+    }
+}
+
+/// Normalized one-sided weights w[0..=r] of the sampled Gaussian (w[k] for ±k).
+pub(super) fn weights(sigma: f32, r: usize) -> [f32; MAX_TAPS] {
+    let mut raw = [0f64; MAX_TAPS];
+    let two_var = 2.0 * f64::from(sigma) * f64::from(sigma);
+    let mut sum = 0.0;
+    for (k, w) in raw.iter_mut().enumerate().take(r + 1) {
+        *w = (-((k * k) as f64) / two_var).exp();
+        sum += if k == 0 { *w } else { 2.0 * *w };
+    }
+    let mut out = [0f32; MAX_TAPS];
+    for (o, w) in out.iter_mut().zip(raw) {
+        *o = (w / sum) as f32;
+    }
+    out
+}
+
+fn create_half_float_target(device: &ID3D11Device, width: u32, height: u32) -> Result<BlurTexture> {
+    let desc = D3D11_TEXTURE2D_DESC {
+        Width: width,
+        Height: height,
+        MipLevels: 1,
+        ArraySize: 1,
+        Format: DXGI_FORMAT_R16G16B16A16_FLOAT,
+        SampleDesc: DXGI_SAMPLE_DESC {
+            Count: 1,
+            Quality: 0,
+        },
+        Usage: D3D11_USAGE_DEFAULT,
+        BindFlags: (D3D11_BIND_SHADER_RESOURCE.0 | D3D11_BIND_RENDER_TARGET.0) as u32,
+        CPUAccessFlags: 0,
+        MiscFlags: 0,
+    };
+    let mut texture: Option<ID3D11Texture2D> = None;
+    unsafe { device.CreateTexture2D(&desc, None, Some(&mut texture))? };
+    let texture = texture.context("half-float blur target missing")?;
+    let (mut srv, mut rtv) = (None, None);
+    unsafe {
+        device.CreateShaderResourceView(&texture, None, Some(&mut srv))?;
+        device.CreateRenderTargetView(&texture, None, Some(&mut rtv))?;
+    }
+    Ok(BlurTexture {
+        width,
+        height,
+        texture,
+        rtv: [rtv],
+        srv: [srv],
+    })
+}
+
+/// One-sided kernel weights packed into `BlurQuad::poly` (16 floats).
+pub(super) fn kernel_poly(sigma: f32, r: usize) -> [[f32; 4]; 4] {
+    let t = weights(sigma, r);
+    [
+        [t[0], t[1], t[2], t[3]],
+        [t[4], t[5], t[6], t[7]],
+        [t[8], t[9], t[10], t[11]],
+        [t[12], t[13], t[14], t[15]],
+    ]
+}
+
+/// Instance writing the atlas rectangle `dst` (x, y, w, h) from the texels at
+/// `dst + shift` of the source; taps outside `valid` read transparent black.
+/// `pass` 6 is the whole 2D kernel, 5 one separable direction (`direction`).
+pub(super) fn kernel_quad(
+    dst: [f32; 4],
+    shift: [f32; 2],
+    valid: [f32; 4],
+    pass: f32,
+    direction: [f32; 2],
+    r: usize,
+    poly: [[f32; 4]; 4],
+) -> BlurQuad {
+    BlurQuad {
+        bounds: dst,
+        content_mask: dst,
+        src_origin: shift,
+        blur_pass: pass,
+        pad: r as f32,
+        pad2: direction,
+        poly,
+        source_rect: valid,
+        ..Default::default()
+    }
+}
+
+impl DirectXRenderer {
+    /// Blur group `index` (raw image in the stage within `raw`) into its atlas rectangle.
+    ///
+    /// KaminIDE patch: taps outside the group's own raw region read transparent
+    /// black, as in a layer (`group_batch`): a kept image (`group_cache`) never
+    /// depends on what other passes left in the stage.
+    pub(super) fn gaussian_group(&mut self, index: usize, sigma: f32, r: usize, raw: Region) -> Result<()> {
+        let region = self.blur.group_regions[index];
+        let place = self.blur.group_place[index];
+        let (w, h) = (region.width, region.height);
+        let poly = kernel_poly(sigma, r);
+        let stage = self
+            .blur
+            .stage
+            .as_ref()
+            .context("group stage missing")?
+            .srv
+            .clone();
+        let frame = raw.floats();
+        let dst = [place.x as f32, place.y as f32, w as f32, h as f32];
+        let to_stage = [
+            region.x as f32 - place.x as f32,
+            region.y as f32 - place.y as f32,
+        ];
+        let page = self.blur.groups[place.page].rtv.clone();
+        let page_size = (
+            self.blur.groups[place.page].width,
+            self.blur.groups[place.page].height,
+        );
+        if r <= MAX_SINGLE_PASS_RADIUS {
+            // Whole kernel: frame-domain stage → atlas rectangle.
+            let quad = kernel_quad(dst, to_stage, frame, 6.0, [0.0; 2], r, poly);
+            return self.kernel_instances(&stage, &page, page_size, &[quad]);
+        }
+        if self
+            .blur
+            .gauss
+            .as_ref()
+            .is_none_or(|t| t.width < w || t.height < h)
+        {
+            // Grow-only, rounded up: group sizes vary by a few pixels between groups.
+            let old = self
+                .blur
+                .gauss
+                .as_ref()
+                .map_or((0, 0), |t| (t.width, t.height));
+            let (gw, gh) = (
+                w.max(old.0).next_multiple_of(64),
+                h.max(old.1).next_multiple_of(64),
+            );
+            self.blur.gauss = Some(create_half_float_target(
+                &self.dev().device.clone(),
+                gw,
+                gh,
+            )?);
+        }
+        let gauss = self.blur.gauss.as_ref().unwrap();
+        let (gauss_srv, gauss_rtv) = (gauss.srv.clone(), gauss.rtv.clone());
+        let gauss_size = (gauss.width, gauss.height);
+        let local = [0.0, 0.0, w as f32, h as f32];
+        // Horizontal: frame-domain stage → intermediate (local coordinates).
+        let horizontal = kernel_quad(
+            local,
+            [region.x as f32, region.y as f32],
+            frame,
+            5.0,
+            [1.0, 0.0],
+            r,
+            poly,
+        );
+        self.kernel_instances(&stage, &gauss_rtv, gauss_size, &[horizontal])?;
+        // Vertical: intermediate → atlas rectangle.
+        let vertical = kernel_quad(dst, [-dst[0], -dst[1]], local, 5.0, [0.0, 1.0], r, poly);
+        self.kernel_instances(&gauss_srv, &page, page_size, &[vertical])
+    }
+
+    /// Draw kernel instances from `src` into the whole target `dst` of `size`.
+    pub(super) fn kernel_instances(
+        &mut self,
+        src: &[Option<ID3D11ShaderResourceView>; 1],
+        dst: &[Option<ID3D11RenderTargetView>; 1],
+        (w, h): (u32, u32),
+        quads: &[BlurQuad],
+    ) -> Result<()> {
+        let device = self.dev().device.clone();
+        let dc = self.dev().device_context.clone();
+        self.ensure_blur_globals(&device)?;
+        let (fw, fh) = (w as f32, h as f32);
+        update_buffer(
+            &dc,
+            self.blur.globals[0].as_ref().unwrap(),
+            &[global_params(self.font_info, [fw, fh])],
+        )?;
+        self.pipelines
+            .blur_pipeline
+            .update_buffer(&device, &dc, quads)?;
+        let viewport = [D3D11_VIEWPORT {
+            TopLeftX: 0.0,
+            TopLeftY: 0.0,
+            Width: fw,
+            Height: fh,
+            MinDepth: 0.0,
+            MaxDepth: 1.0,
+        }];
+        let blend = self.replace_blend()?;
+        unsafe { dc.OMSetRenderTargets(Some(dst), None) };
+        let pipeline = &self.pipelines.blur_pipeline;
+        let (globals, sampler) = (&self.blur.globals, &self.globals.sampler);
+        group_stage::downsample_clip(&dc, w, h, || {
+            pipeline.draw_with_texture_blended(
+                &dc,
+                src,
+                &viewport,
+                globals,
+                slice::from_ref(sampler),
+                quads.len() as u32,
+                Some(&blend),
+            )
+        })
+    }
+}
+#[cfg(test)]
+mod tests;
diff --git a/vendor/gpui-windows/src/directx_renderer/gaussian/tests.rs b/vendor/gpui-windows/src/directx_renderer/gaussian/tests.rs
