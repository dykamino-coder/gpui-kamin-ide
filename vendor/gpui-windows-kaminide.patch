+impl DirectXRendererDevices {
+    pub(crate) fn new(
+        directx_devices: &DirectXDevices,
+        disable_direct_composition: bool,
+    ) -> Result<Self> {
+        let DirectXDevices {
+            adapter,
+            dxgi_factory,
+            device,
+            device_context,
+            ..
+        } = directx_devices;
+        let dxgi_device = if disable_direct_composition {
+            None
+        } else {
+            Some(device.cast().context("Creating DXGI device")?)
+        };
+        let annotation = device_context.cast().ok();
+
+        Ok(Self {
+            context: directx_devices.context.clone(),
+            adapter: adapter.clone(),
+            dxgi_factory: dxgi_factory.clone(),
+            device: device.clone(),
+            device_context: device_context.clone(),
+            dxgi_device,
+            annotation,
+        })
+    }
+}
+
+impl DirectXRenderer {
+    pub(crate) fn set_frame_capture(&mut self, sink: Option<Box<dyn gpui::frame_capture::FrameCaptureSink>>) {
+        self.capture = sink;
+    }
+
+    pub(crate) fn new(
+        hwnd: HWND,
+        directx_devices: &DirectXDevices,
+        disable_direct_composition: bool,
+    ) -> Result<Self> {
+        Self::build(hwnd, directx_devices, disable_direct_composition, false)
+    }
+
+    /// KaminIDE patch: on WARP, the CPU time a frame comparison may take
+    /// (microseconds). A comparison of a few hundred cells of text costs
+    /// 0.4–1 ms; one of thousands of boxes that ends in a whole redraw costs
+    /// 4 ms and more, more than the strips it could leave unrastered.
+    const SOFTWARE_SHIFT_BUDGET_US: u32 = 2000;
+
+    /// KaminIDE patch: the same device, pipelines and render target format
+    /// as a window renderer, drawing into a texture instead of a swap chain
+    /// back buffer; `present` does nothing.
+    pub(crate) fn new_offscreen(hwnd: HWND, directx_devices: &DirectXDevices) -> Result<Self> {
+        Self::build(hwnd, directx_devices, true, true)
+    }
+
+    fn build(
+        hwnd: HWND,
+        directx_devices: &DirectXDevices,
+        disable_direct_composition: bool,
+        offscreen: bool,
+    ) -> Result<Self> {
+        if disable_direct_composition && !offscreen {
+            log::info!("Direct Composition is disabled.");
+        }
+
+        let devices = DirectXRendererDevices::new(directx_devices, disable_direct_composition)
+            .context("Creating DirectX devices")?;
+        // KaminIDE patch: a frame comparison pays only when it costs less
+        // than the raster it saves. A hardware adapter rasters the window in
+        // less CPU than reading its primitives, so frames keep the damage of
+        // the layer bookkeeping there; WARP rasters on the CPU, so a frame is
+        // compared within a budget and drawn whole past it.
+        let software = unsafe { devices.adapter.GetDesc1() }
+            .is_ok_and(|desc| (desc.Flags & DXGI_ADAPTER_FLAG_SOFTWARE.0 as u32) != 0);
+        gpui::set_shift_budget_us(if software { Self::SOFTWARE_SHIFT_BUDGET_US } else { 0 });
+        let atlas = Arc::new(DirectXAtlas::new(&devices.device, &devices.device_context));
+
+        let resources = if offscreen {
+            DirectXResources::new_offscreen(&devices, 1, 1)
+        } else {
+            DirectXResources::new(&devices, 1, 1, hwnd, disable_direct_composition)
+        }
+        .context("Creating DirectX resources")?;
+        let globals = DirectXGlobalElements::new(&devices.device)
+            .context("Creating DirectX global elements")?;
+        let pipelines = DirectXRenderPipelines::new(&devices.device)
+            .context("Creating DirectX render pipelines")?;
+
+        let direct_composition = if disable_direct_composition {
+            None
+        } else {
+            let composition = DirectComposition::new(devices.dxgi_device.as_ref().unwrap(), hwnd)
+                .context("Creating DirectComposition")?;
+            composition
+                .set_swap_chain(resources.swap_chain()?)
+                .context("Setting swap chain for DirectComposition")?;
+            Some(composition)
+        };
+
+        Ok(DirectXRenderer {
+            hwnd,
+            atlas,
+            devices: Some(devices),
+            resources: Some(resources),
+            globals,
+            pipelines,
+            direct_composition,
+            disable_direct_composition,
+            offscreen,
+            font_info: Self::get_font_info(),
+            blur: BlurScratch::default(),
+            gpu_timer: batch_cost::GpuTimer::new(directx_devices.instrumentation.clone()),
+            capture: None,
+            timing_main: false,
+            layer_cache: Default::default(),
+            backdrop_pending: false,
+            group_target: None,
+            group_target_tex: None,
+            blend_premultiplied: None,
+            blend_replace: None,
+            group_tiles: group_tiles::enabled(),
+            width: 1,
+            height: 1,
+            backdrop: None,
+            skip_draws: false,
+            unpresented: false,
+            retained: Default::default(),
+        })
+    }
+
+    /// KaminIDE patch: raw ID3D11Device окна (AddRef) — по нему открывается
+    /// общий handle текстуры от CEF.
+    pub fn d3d_device_raw(&self) -> Option<*mut std::ffi::c_void> {
+        use windows::core::Interface;
+        Some(self.devices.as_ref()?.device.clone().into_raw())
+    }
+
+    /// KaminIDE patch: raw ID3D11DeviceContext окна (AddRef). Нужен, чтобы
+    /// скопировать кадр CEF в свою текстуру на ТОМ ЖЕ потоке, где идёт
+    /// отрисовка: контекст D3D11 не потокобезопасен.
+    pub fn d3d_context_raw(&self) -> Option<*mut std::ffi::c_void> {
+        use windows::core::Interface;
+        Some(self.devices.as_ref()?.device_context.clone().into_raw())
+    }
+
+    /// KaminIDE patch: положить чужую текстуру D3D11 в атлас (кадр CEF).
+    pub fn register_external_texture(
+        &self,
+        texture: ID3D11Texture2D,
+        size: Size<DevicePixels>,
+    ) -> Option<AtlasTile> {
+        self.atlas.register_external(texture, size)
+    }
+
+    /// KaminIDE patch: заменить содержимое записи атласа новой текстурой.
+    pub fn update_external_texture(&self, id: AtlasTextureId, texture: ID3D11Texture2D) -> bool {
+        self.atlas.update_external(id, texture)
+    }
+
+    /// KaminIDE patch: забыть чужую текстуру.
+    /// KaminIDE patch: see `DirectXAtlas::damage_external`.
+    pub fn damage_external_texture(&self, id: AtlasTextureId, rect: Bounds<DevicePixels>) {
+        self.atlas.damage_external(id, rect);
+    }
+
+    pub fn unregister_external_texture(&self, id: AtlasTextureId) {
