+        let quad = BlurQuad {
+            bounds: [bx, by, rw, rh],
+            content_mask: [bx, by, rw, rh],
+            corner_radii: [0.0; 4],
+            src_origin: [0.0, 0.0],
+            src_scale: [1.0, 1.0],
+            texel: [1.0 / lw, 1.0 / lh],
+            blur_pass: 2.0,
+            pad: 0.0,
+            blend_mode: 0,
+            poly_count: 0,
+            pad2: [0.0; 2],
+            poly: [[0.0; 4]; 4],
+            mask_rect: [0.0; 4],
+            mask_clip: [0.0; 4],
