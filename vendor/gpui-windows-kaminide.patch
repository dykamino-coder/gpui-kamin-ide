index 0000000000000000000000000000000000000000..b404c1145b082f63f9851d9bbe6fa74829ab0351
--- /dev/null
+++ b/vendor/gpui-windows/src/directx_renderer/group_cache.rs
@@ -0,0 +1,105 @@
+//! KaminIDE patch: group images kept in the group atlas between frames.
+//!
+//! A group of a frame compared with the last one (`Scene::group_base`) that
+//! paints what a group of the last frame painted takes that group's atlas
+//! rectangle and its finished image, whatever its index: an inserted, removed
+//! or reordered node shifts the indices of later groups but not their images.
+//! The other groups get free space on the shelves of the last full layout
+//! (`group_atlas::Shelves`); when they do not fit, the atlas is packed again
+//! and nothing is kept for that frame. Chromium caches an unchanged render
+//! surface per node (`RenderSurfaceImpl::ShouldCacheRenderSurface`) and
+//! WebRender keeps render-task results by key; here the key is the group's
+//! whole content, compared exactly. The cache costs no memory: it is the
+//! atlas the frame needs anyway, and a dead group's rectangle is free space.
+
+use super::*;
+
+#[derive(Default)]
+pub(super) struct GroupCache {
+    /// Scene number whose groups `valid` describes.
+    pub(super) id: u64,
+    /// The device and atlas pages the images were drawn on: a kept image is
+    /// valid only on the same objects (font gamma and contrast are fixed per
+    /// process, `get_font_info`; atlas tiles change only with the epoch in
+    /// `retained::Target`, which `chain` requires).
+    pub(super) objects: Vec<usize>,
+    pub(super) places: Vec<group_atlas::Place>,
+    pub(super) regions: Vec<Region>,
+    /// The atlas rectangle of group `i` holds its finished image.
+    pub(super) valid: Vec<bool>,
+    /// The empty shelves of the last full layout and its number of pages.
+    pub(super) layout: Option<(group_atlas::Shelves, usize)>,
+    /// Groups of the last frame drawn and kept (diagnostics and tests).
+    pub(super) counts: GroupCounts,
+    /// One kept image per frame drawn again and compared (`group_scrub`).
+    pub(super) scrub: super::group_scrub::Scrub,
+}
+
+/// How the groups of the last frame got their images.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub(super) struct GroupCounts {
+    pub(super) kept: usize,
+    pub(super) drawn: usize,
+}
+
+impl DirectXRenderer {
+    /// Atlas places for `scene`'s groups (regions in `blur.group_regions`)
+    /// that keep the images of the last frame: per group its place and
+    /// whether its image is already there. None: pack the atlas again.
+    pub(super) fn keep_group_places(&self, scene: &Scene) -> Option<(Vec<group_atlas::Place>, Vec<bool>)> {
+        let c = &self.retained.groups;
+        let (same, base) = self.retained.chain?;
+        let (shelves, pages) = c.layout.as_ref()?;
+        if c.id != base || *pages != self.blur.groups.len() || c.objects != self.group_objects() {
+            return None;
+        }
+        let regions = &self.blur.group_regions;
+        let mut shelves = shelves.clone();
+        let mut places = vec![None; regions.len()];
+        let mut keep = vec![false; regions.len()];
+        for (g, region) in regions.iter().enumerate() {
+            let old = if same { Some(g) } else { scene.group_base(g) };
+            let Some(o) = old.filter(|&o| {
+                c.valid.get(o).copied().unwrap_or(false) && c.regions.get(o) == Some(region)
+            }) else {
+                continue;
+            };
+            if shelves.occupy(c.places[o], (region.width, region.height)) {
+                places[g] = Some(c.places[o]);
+                keep[g] = true;
+            }
+        }
+        if !keep.contains(&true) {
+            return None;
+        }
+        let places = places
+            .into_iter()
+            .zip(regions)
+            .map(|(p, r)| p.or_else(|| shelves.alloc((r.width, r.height))))
+            .collect::<Option<Vec<_>>>()?;
+        Some((places, keep))
+    }
+
+    /// The atlas now holds the images of `scene`'s groups marked in `valid`.
+    pub(super) fn groups_kept(&mut self, scene: &Scene, valid: Vec<bool>, kept: usize) {
+        let objects = self.group_objects();
+        let c = &mut self.retained.groups;
+        c.id = scene.frame_damage().2;
+        c.objects = objects;
+        c.places.clone_from(&self.blur.group_place);
+        c.regions.clone_from(&self.blur.group_regions);
+        c.counts = GroupCounts {
+            kept,
+            drawn: valid.iter().filter(|&&v| v).count() - kept,
+        };
+        c.valid = valid;
+    }
+
+    /// Identity of the device and of every atlas page.
+    fn group_objects(&self) -> Vec<usize> {
+        use windows::core::Interface;
+        std::iter::once(self.dev().device.as_raw() as usize)
+            .chain(self.blur.groups.iter().map(|p| p.texture.as_raw() as usize))
+            .collect()
+    }
+}
diff --git a/vendor/gpui-windows/src/directx_renderer/group_region.rs b/vendor/gpui-windows/src/directx_renderer/group_region.rs
new file mode 100644
index 0000000000000000000000000000000000000000..4c8bb22564e56f10749141a0beb1559d606bd592
--- /dev/null
+++ b/vendor/gpui-windows/src/directx_renderer/group_region.rs
@@ -0,0 +1,229 @@
+//! KaminIDE patch: целочисленные области групп и ограниченный пул совместимых текстур.
+
+use super::*;
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(super) struct Region {
+    pub x: u32,
+    pub y: u32,
+    pub width: u32,
+    pub height: u32,
+}
+
+impl Region {
+    pub(super) fn full(width: u32, height: u32) -> Self {
+        Self {
+            x: 0,
+            y: 0,
+            width,
+            height,
+        }
+    }
+
+    pub(super) fn clipped(b: Bounds<ScaledPixels>, margin: f32, width: u32, height: u32) -> Self {
+        let v = [
+            b.origin.x.0,
+            b.origin.y.0,
+            b.size.width.0,
+            b.size.height.0,
+            margin,
+        ];
+        if !v.into_iter().all(f32::is_finite) {
+            return Self::full(width, height);
+        }
+        let x = (b.origin.x.0 - margin).floor().clamp(0.0, width as f32) as u32;
+        let y = (b.origin.y.0 - margin).floor().clamp(0.0, height as f32) as u32;
+        let right = (b.origin.x.0 + b.size.width.0 + margin)
+            .ceil()
+            .clamp(x as f32, width as f32) as u32;
+        let bottom = (b.origin.y.0 + b.size.height.0 + margin)
+            .ceil()
+            .clamp(y as f32, height as f32) as u32;
+        Self {
+            x: x.min(width.saturating_sub(1)),
+            y: y.min(height.saturating_sub(1)),
+            width: (right - x).max(1),
+            height: (bottom - y).max(1),
+        }
+    }
+
+    pub(super) fn floats(self) -> [f32; 4] {
+        [
+            self.x as f32,
+            self.y as f32,
+            self.width as f32,
+            self.height as f32,
+        ]
+    }
+
+    pub(super) fn for_group(group: &gpui::PaintGroup, width: u32, height: u32) -> [Self; 2] {
+        let margin = if group.blur_radius > 0.0 {
+            gaussian::margin(group.blur_radius)
+        } else {
+            0.0
+        };
+        // Проекция читает исходные пиксели через H^-1, включая область вне рамки.
+        let raw = if group.projection.is_some() {
+            Self::full(width, height)
+        } else {
+            Self::clipped(group.bounds, margin + 2.0, width, height)
+        };
+        [raw, Self::clipped(group.bounds, margin, width, height)]
+    }
+}
+
+impl DirectXRenderer {
+    /// Frame rectangle a group composite can write (and whose backdrop it reads).
+    pub(super) fn composite_region(&self, s: &PaintSurface) -> Region {
+        let target = Region::full(self.width, self.height);
+        let clipped = s.bounds.intersect(&s.content_mask.bounds);
+        let region = Region::clipped(clipped, 0.0, self.width, self.height);
+        let x = region.x.max(target.x).min(target.x + target.width - 1);
+        let y = region.y.max(target.y).min(target.y + target.height - 1);
+        let right = (region.x + region.width)
+            .min(target.x + target.width)
+            .max(x + 1);
+        let bottom = (region.y + region.height)
+            .min(target.y + target.height)
+            .max(y + 1);
+        Region {
+            x,
+            y,
+            width: right - x,
+            height: bottom - y,
+        }
+    }
+
+    pub(super) fn copy_group_backdrop(&mut self, s: &PaintSurface) -> Result<[f32; 4]> {
+        let target = Region::full(self.width, self.height);
+        let region = self.composite_region(s);
+        let (x, y, right, bottom) = (
+            region.x,
+            region.y,
+            region.x + region.width,
+            region.y + region.height,
+        );
+        let device = self.dev().device.clone();
+        let dc = self.dev().device_context.clone();
+        if self
+            .blur
+            .blend_copy
+            .as_ref()
+            .is_none_or(|t| t.width != region.width || t.height != region.height)
+        {
+            let texture = self.blur.pool.take(&device, region.width, region.height)?;
+            if let Some(old) = self.blur.blend_copy.replace(texture) {
+                self.blur.pool.put(old);
+            }
+        }
+        let copy = self.blur.blend_copy.as_ref().unwrap();
+        let source = self
+            .group_target_tex
+            .as_ref()
+            .or(self.res().render_target.as_ref())
+            .context("render target missing")?;
+        let area = D3D11_BOX {
+            left: x - target.x,
+            top: y - target.y,
+            front: 0,
+            right: right - target.x,
+            bottom: bottom - target.y,
+            back: 1,
+        };
+        unsafe {
+            dc.CopySubresourceRegion(&copy.texture, 0, 0, 0, 0, source, 0, Some(&area));
+            dc.PSSetShaderResources(2, Some(&copy.srv));
+        }
+        Ok(region.floats())
+    }
+
+    /// Lay out the group atlas for `scene`; returns which groups already have
+    /// their image in it (`group_cache`).
+    pub(super) fn prepare_group_targets(&mut self, scene: &Scene) -> Result<Vec<bool>> {
+        let device = self.dev().device.clone();
+        self.blur.group_regions.clear();
+        for group in &scene.groups {
+            let regions = Region::for_group(group, self.width, self.height);
+            self.blur
+                .group_regions
+                .push(regions[usize::from(group.blur_radius > 0.0)]);
+        }
+        if let Some((places, keep)) = self.keep_group_places(scene) {
+            self.blur.group_place = places;
+            return Ok(keep);
+        }
+        // KaminIDE patch: the retained images share atlas pages (`groups`).
+        let sizes: Vec<(u32, u32)> = self
+            .blur
+            .group_regions
+            .iter()
+            .map(|r| (r.width, r.height))
+            .collect();
+        let (places, pages) = group_atlas::pack(&sizes);
+        self.blur.group_place = places;
+        for (k, &need) in pages.iter().enumerate() {
+            if self
+                .blur
+                .groups
+                .get(k)
+                .is_some_and(|t| group_atlas::page_fits((t.width, t.height), need))
+            {
+                continue;
+            }
+            let (w, h) = group_atlas::page_size(need);
+            let page = create_blur_texture(&device, w, h, true)?;
+            if k < self.blur.groups.len() {
+                self.blur.groups[k] = page;
+            } else {
+                self.blur.groups.push(page);
+            }
+        }
+        self.blur.groups.truncate(pages.len());
+        let textures: Vec<(u32, u32)> = self.blur.groups.iter().map(|t| (t.width, t.height)).collect();
+        self.retained.groups.layout = Some((
+            group_atlas::Shelves::of_layout(&self.blur.group_place, &textures),
+            textures.len(),
+        ));
+        Ok(vec![false; scene.groups.len()])
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::Region;
+    use gpui::{ScaledPixels, bounds, point, size};
+
+    #[test]
+    fn fractional_bounds_round_outward_and_margin_stays_inside_frame() {
+        let b = bounds(
+            point(ScaledPixels(31.25), ScaledPixels(-2.5)),
+            size(ScaledPixels(180.5), ScaledPixels(140.25)),
+        );
+        assert_eq!(
+            Region::clipped(b, 4.8, 800, 600),
+            Region {
+                x: 26,
+                y: 0,
+                width: 191,
+                height: 143
+            }
+        );
+        let outside = bounds(
+            point(ScaledPixels(900.0), ScaledPixels(700.0)),
+            size(ScaledPixels(20.0), ScaledPixels(10.0)),
+        );
+        assert_eq!(
+            Region::clipped(outside, 4.8, 800, 600),
+            Region {
+                x: 799,
+                y: 599,
+                width: 1,
+                height: 1
+            }
+        );
+        assert_eq!(
+            Region::clipped(b, f32::NAN, 800, 600),
+            Region::full(800, 600)
+        );
+    }
+}
diff --git a/vendor/gpui-windows/src/directx_renderer/group_scrub.rs b/vendor/gpui-windows/src/directx_renderer/group_scrub.rs
new file mode 100644
index 0000000000000000000000000000000000000000..555eb84f7c7fe94641489aafcee817952d6bf41e
--- /dev/null
+++ b/vendor/gpui-windows/src/directx_renderer/group_scrub.rs
@@ -0,0 +1,203 @@
+//! KaminIDE patch: протирка удержанных картинок групп (`group_cache`).
+//!
+//! Удержанная картинка верна, пока верна та отрисовка, которой её получили.
+//! Сбой одной отрисовки (GPU, драйвер, пропущенная зависимость) без кэша
+//! исчезал со следующим кадром, а с кэшем он остаётся. Поэтому каждый кадр,
+//! в котором удержана хотя бы одна группа, одна удержанная группа по кругу
+//! рисуется заново на своё место в атласе. Так ошибка живёт не дольше круга.
+//! Старая и новая картинки копируются в staging-текстуры. Сравниваются они
+//! позже, когда GPU их отдаст без ожидания (`D3D11_MAP_FLAG_DO_NOT_WAIT`).
+//! Расхождение пишется в лог и в счётчик [`group_scrub_mismatches`]: в бою
+//! это детектор, в аудите гейта он обязан дать 0.
+
+use super::*;
+use std::sync::atomic::{AtomicU64, Ordering};
+
+static MISMATCHES: AtomicU64 = AtomicU64::new(0);
+
+/// Удержанные картинки групп, что не совпали со свежей отрисовкой, с начала процесса.
+pub fn group_scrub_mismatches() -> u64 {
+    MISMATCHES.load(Ordering::Relaxed)
+}
+
+#[derive(Default)]
+pub(super) struct Scrub {
+    /// Следующая группа круга.
+    cursor: usize,
+    /// Сравнение, ждущее GPU: размер, группа, кадр.
+    pending: Option<(u32, u32, usize, u64)>,
+    /// Staging старой и новой картинки, растут по мере надобности.
+    staging: Option<(u32, u32, ID3D11Texture2D, ID3D11Texture2D)>,
+    /// Расхождения этого рендерера (тесты).
+    pub(super) mismatches: u64,
+}
+
+impl DirectXRenderer {
+    /// Draw group `i` alone into the stage, then into its atlas rectangle.
+    pub(super) fn draw_group_alone(&mut self, i: usize, group: &gpui::PaintGroup) -> Result<()> {
+        let raw = Region::for_group(group, self.width, self.height)[0];
+        self.draw_group_content(group, raw, None)?;
+        match gaussian::direct_radius(group.blur_radius) {
+            Some(r) => self.gaussian_group(i, group.blur_radius, r, raw)?,
+            None => {
+                if group.blur_radius > 0.0 {
+                    self.blur_group(i, group)?;
+                }
+                self.save_group_stage(i);
+            }
+        }
+        self.clear_group_stage()
+    }
+
+    /// Redraw the next kept group of `scene` (`reuse`) in place, comparing later.
+    pub(super) fn scrub_kept_group(&mut self, scene: &Scene, reuse: &[bool]) -> Result<()> {
+        self.finish_scrub(false)?;
+        let n = reuse.len();
+        if self.retained.groups.scrub.pending.is_some() || !reuse.contains(&true) {
+            return Ok(());
+        }
+        let start = self.retained.groups.scrub.cursor % n;
+        let Some(i) = (0..n).map(|k| (start + k) % n).find(|&k| reuse[k]) else {
+            return Ok(());
+        };
+        self.retained.groups.scrub.cursor = i + 1;
+        let (region, place) = (self.blur.group_regions[i], self.blur.group_place[i]);
+        let (old, new) = self.scrub_staging(region.width, region.height)?;
+        self.copy_place(&old, place, region);
+        self.draw_group_alone(i, &scene.groups[i])?;
+        self.copy_place(&new, place, region);
+        let frame = scene.frame_damage().2;
+        self.retained.groups.scrub.pending = Some((region.width, region.height, i, frame));
+        Ok(())
+    }
+
+    /// Compare the pending pair; with `wait`, block until the GPU has it.
+    pub(super) fn finish_scrub(&mut self, wait: bool) -> Result<()> {
+        let Some((w, h, group, frame)) = self.retained.groups.scrub.pending else {
+            return Ok(());
+        };
+        let Some((_, _, old, new)) = self.retained.groups.scrub.staging.clone() else {
+            self.retained.groups.scrub.pending = None;
+            return Ok(());
+        };
+        let ctx = self.dev().device_context.clone();
+        let flags = if wait {
+            0
+        } else {
+            D3D11_MAP_FLAG_DO_NOT_WAIT.0 as u32
+        };
+        let (mut a, mut b) = (
+            D3D11_MAPPED_SUBRESOURCE::default(),
+            D3D11_MAPPED_SUBRESOURCE::default(),
+        );
+        if unsafe { ctx.Map(&old, 0, D3D11_MAP_READ, flags, Some(&mut a)) }.is_err() {
+            return Ok(());
+        }
+        if unsafe { ctx.Map(&new, 0, D3D11_MAP_READ, flags, Some(&mut b)) }.is_err() {
+            unsafe { ctx.Unmap(&old, 0) };
+            return Ok(());
+        }
+        let row = (w * 4) as usize;
+        let mut differ = 0usize;
+        for y in 0..h as usize {
+            // KaminIDE patch: SAFETY: both staging textures are at least w x h
+            // BGRA8 and stay mapped until the Unmap calls below; each row has
+            // RowPitch >= w * 4 readable bytes.
+            let (x, z) = unsafe {
+                (
+                    std::slice::from_raw_parts(
+                        (a.pData as *const u8).add(y * a.RowPitch as usize),
+                        row,
+                    ),
+                    std::slice::from_raw_parts(
+                        (b.pData as *const u8).add(y * b.RowPitch as usize),
+                        row,
+                    ),
+                )
+            };
+            differ += x
+                .chunks_exact(4)
+                .zip(z.chunks_exact(4))
+                .filter(|(p, q)| p != q)
+                .count();
+        }
+        unsafe {
+            ctx.Unmap(&new, 0);
+            ctx.Unmap(&old, 0);
+        }
+        self.retained.groups.scrub.pending = None;
+        if differ > 0 {
+            MISMATCHES.fetch_add(1, Ordering::Relaxed);
+            self.retained.groups.scrub.mismatches += 1;
+            log::error!(
+                "GROUP_SCRUB_MISMATCH: kept image of group {group} (frame {frame}, {w}x{h}) differs from its redraw in {differ} px; replaced"
+            );
+        }
+        Ok(())
+    }
+
+    /// Copy the atlas rectangle of `place` (size of `region`) to (0, 0) of `dst`.
+    fn copy_place(&self, dst: &ID3D11Texture2D, place: group_atlas::Place, region: Region) {
+        let area = D3D11_BOX {
+            left: place.x,
+            top: place.y,
+            front: 0,
+            right: place.x + region.width,
+            bottom: place.y + region.height,
+            back: 1,
+        };
+        let page = &self.blur.groups[place.page].texture;
+        unsafe {
+            self.dev()
+                .device_context
+                .CopySubresourceRegion(dst, 0, 0, 0, 0, page, 0, Some(&area))
+        };
+    }
+
+    /// The staging pair, at least `w` x `h`, in the format of the atlas pages.
+    fn scrub_staging(&mut self, w: u32, h: u32) -> Result<(ID3D11Texture2D, ID3D11Texture2D)> {
+        if let Some((sw, sh, a, b)) = &self.retained.groups.scrub.staging
+            && *sw >= w
+            && *sh >= h
+        {
+            return Ok((a.clone(), b.clone()));
+        }
+        let old = self
+            .retained
+            .groups
+            .scrub
+            .staging
+            .as_ref()
+            .map_or((0, 0), |s| (s.0, s.1));
+        let (sw, sh) = (
+            w.max(old.0).next_multiple_of(64),
+            h.max(old.1).next_multiple_of(64),
+        );
+        let mut page = D3D11_TEXTURE2D_DESC::default();
+        unsafe { self.blur.groups[0].texture.GetDesc(&mut page) };
+        let desc = D3D11_TEXTURE2D_DESC {
+            Width: sw,
+            Height: sh,
+            MipLevels: 1,
+            ArraySize: 1,
+            Format: page.Format,
+            SampleDesc: DXGI_SAMPLE_DESC {
+                Count: 1,
+                Quality: 0,
+            },
+            Usage: D3D11_USAGE_STAGING,
+            BindFlags: 0,
+            CPUAccessFlags: D3D11_CPU_ACCESS_READ.0 as u32,
+            MiscFlags: 0,
+        };
+        let device = self.dev().device.clone();
+        let make = || -> Result<ID3D11Texture2D> {
+            let mut t = None;
+            unsafe { device.CreateTexture2D(&desc, None, Some(&mut t))? };
+            t.context("scrub staging texture")
+        };
+        let (a, b) = (make()?, make()?);
+        self.retained.groups.scrub.staging = Some((sw, sh, a.clone(), b.clone()));
+        Ok((a, b))
+    }
+}
diff --git a/vendor/gpui-windows/src/directx_renderer/group_stage.rs b/vendor/gpui-windows/src/directx_renderer/group_stage.rs
new file mode 100644
index 0000000000000000000000000000000000000000..cc7317a71e56ae16682701821419c3da4f1f7b97
--- /dev/null
+++ b/vendor/gpui-windows/src/directx_renderer/group_stage.rs
@@ -0,0 +1,210 @@
+//! KaminIDE patch: кадровый staging сохраняет точность GPU-интерполяции.
+
+use super::*;
+use windows::Win32::Foundation::RECT;
+
+impl Region {
+    fn rect(self) -> RECT {
+        RECT {
+            left: self.x as i32,
+            top: self.y as i32,
+            right: (self.x + self.width) as i32,
+            bottom: (self.y + self.height) as i32,
+        }
+    }
+
+    fn area(self) -> D3D11_BOX {
+        D3D11_BOX {
+            left: self.x,
+            top: self.y,
+            front: 0,
+            right: self.x + self.width,
+            bottom: self.y + self.height,
+            back: 1,
+        }
+    }
+}
+
+impl DirectXRenderer {
+    /// Clear every stage rectangle written since the last clear, in one call.
+    pub(super) fn clear_group_stage(&mut self) -> Result<()> {
+        if !self.blur.stage_dirty.is_empty() {
+            let dc: ID3D11DeviceContext1 = self.dev().device_context.cast()?;
+            let view = self.blur.stage.as_ref().unwrap().rtv[0].as_ref().unwrap();
+            let rects: Vec<RECT> = self.blur.stage_dirty.drain(..).map(Region::rect).collect();
+            unsafe { dc.ClearView(view, &[0.0; 4], Some(&rects)) };
+        }
+        Ok(())
+    }
+
+    pub(super) fn begin_group_stage(&mut self, region: Region) -> Result<ID3D11RasterizerState> {
+        let device = self.dev().device.clone();
+        let dc = self.dev().device_context.clone();
+        if self
+            .blur
+            .stage
+            .as_ref()
+            .is_none_or(|t| t.width != self.width || t.height != self.height)
+        {
+            let stage = create_blur_texture(&device, self.width, self.height, true)?;
+            // Новый ресурс очищается один раз; следующие группы очищают только
+            // предыдущую грязную область. Scissor ограничивает все записи в неё.
+            unsafe { dc.ClearRenderTargetView(stage.rtv[0].as_ref().unwrap(), &[0.0; 4]) };
+            self.blur.stage = Some(stage);
+            self.blur.stage_dirty.clear();
+        }
+        // KaminIDE patch: the stage keeps the pending layer's groups; their
+        // regions are disjoint from `region` (see `render_groups`).
+        let original = unsafe { dc.RSGetState()? };
+        if self.blur.stage_rasterizer.is_none() {
+            let mut desc = D3D11_RASTERIZER_DESC::default();
+            unsafe { original.GetDesc(&mut desc) };
+            desc.ScissorEnable = true.into();
+            unsafe { device.CreateRasterizerState(&desc, Some(&mut self.blur.stage_rasterizer))? };
+        }
+        unsafe {
+            dc.RSSetState(self.blur.stage_rasterizer.as_ref());
+            dc.RSSetScissorRects(Some(&[region.rect()]));
+        }
+        self.blur.stage_dirty.push(region);
+        Ok(original)
+    }
+
+    /// Copy group `slot`'s region of the stage into its atlas rectangle.
+    pub(super) fn save_group_stage(&self, slot: usize) {
+        let stage = self.blur.stage.as_ref().unwrap();
+        let region = self.blur.group_regions[slot];
+        let place = self.blur.group_place[slot];
+        unsafe {
+            self.dev().device_context.CopySubresourceRegion(
+                &self.blur.groups[place.page].texture,
+                0,
+                place.x,
+                place.y,
+                0,
+                &stage.texture,
+                0,
+                Some(&region.area()),
+            );
+        }
+    }
+}
+
+/// KaminIDE patch: временный target каскада имеет собственный домен scissor.
+/// Состояние растеризатора остаётся прежним; после прохода возвращается клип группы.
+pub(super) fn downsample_clip(
+    dc: &ID3D11DeviceContext,
+    width: u32,
+    height: u32,
+    draw: impl FnOnce() -> Result<()>,
+) -> Result<()> {
+    scissor_clip(dc, Region::full(width, height), draw)
+}
+
+/// KaminIDE patch: draw with the scissor set to `region`, then restore the old rectangles.
+pub(super) fn scissor_clip(
+    dc: &ID3D11DeviceContext,
+    region: Region,
+    draw: impl FnOnce() -> Result<()>,
+) -> Result<()> {
+    let mut old = [RECT::default(); 16];
+    let mut count = old.len() as u32;
+    unsafe {
+        dc.RSGetScissorRects(&mut count, Some(old.as_mut_ptr()));
+        dc.RSSetScissorRects(Some(&[region.rect()]));
+    }
+    let result = draw();
+    unsafe { dc.RSSetScissorRects(Some(&old[..count as usize])) };
+    result
+}
+
+#[cfg(test)]
+mod tests {
+    use super::{Region, downsample_clip};
+    use anyhow::Result;
+    use windows::Win32::Foundation::RECT;
+
+    #[test]
+    fn copy_and_clear_use_the_same_half_open_frame_rectangle() {
+        let r = Region {
+            x: 403,
+            y: 161,
+            width: 71,
+            height: 39,
+        };
+        let (clear, copy) = (r.rect(), r.area());
+        assert_eq!(
+            [clear.left, clear.top, clear.right, clear.bottom],
+            [403, 161, 474, 200]
+        );
+        assert_eq!(
+            [
+                copy.left,
+                copy.top,
+                copy.right,
+                copy.bottom,
+                copy.front,
+                copy.back
+            ],
+            [403, 161, 474, 200, 0, 1]
+        );
+    }
+    #[test]
+    fn cascade_clip_restores_all_rectangles_even_when_draw_fails() -> Result<()> {
+        use windows::Win32::{
+            Foundation::HMODULE,
+            Graphics::{
+                Direct3D::D3D_DRIVER_TYPE_WARP,
+                Direct3D11::{
+                    D3D11_CREATE_DEVICE_BGRA_SUPPORT, D3D11_SDK_VERSION, D3D11CreateDevice,
+                },
+            },
+        };
+        let (mut device, mut context) = (None, None);
+        unsafe {
+            D3D11CreateDevice(
+                None,
+                D3D_DRIVER_TYPE_WARP,
+                HMODULE::default(),
+                D3D11_CREATE_DEVICE_BGRA_SUPPORT,
+                None,
+                D3D11_SDK_VERSION,
+                Some(&mut device),
+                None,
+                Some(&mut context),
+            )?;
+        }
+        let dc = context.unwrap();
+        let original = [
+            Region {
+                x: 403,
+                y: 161,
+                width: 71,
+                height: 39,
+            }
+            .rect(),
+            Region {
+                x: 12,
+                y: 20,
+                width: 8,
+                height: 10,
+            }
+            .rect(),
+        ];
+        unsafe { dc.RSSetScissorRects(Some(&original)) };
+        let result = downsample_clip(&dc, 35, 19, || {
+            let mut count = 1;
+            let mut rect = RECT::default();
+            unsafe { dc.RSGetScissorRects(&mut count, Some(&mut rect)) };
+            assert_eq!(count, 1);
+            assert_eq!(rect, Region::full(35, 19).rect());
+            anyhow::bail!("draw failed")
+        });
+        assert!(result.is_err());
+        let mut restored = [RECT::default(); 16];
+        let mut count = restored.len() as u32;
+        unsafe { dc.RSGetScissorRects(&mut count, Some(restored.as_mut_ptr())) };
+        assert_eq!(&restored[..count as usize], &original);
+        Ok(())
+    }
+}
