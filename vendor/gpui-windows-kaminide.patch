--- /dev/null
+++ b/vendor/gpui-windows/src/directx_devices.rs
@@ -0,0 +1,259 @@
+//! KaminIDE patch: D3D устройства и их generation для recovery и readback.
+
+mod adapter;
+use adapter::get_adapter;
+use anyhow::{Context, Result};
+use gpui_util::ResultExt;
+use itertools::Itertools;
+use windows::Win32::{
+    Foundation::HMODULE,
+    Graphics::{
+        Direct3D::{
+            D3D_DRIVER_TYPE_UNKNOWN, D3D_FEATURE_LEVEL, D3D_FEATURE_LEVEL_10_1,
+            D3D_FEATURE_LEVEL_11_0, D3D_FEATURE_LEVEL_11_1,
+        },
+        Direct3D11::{
+            D3D11_CREATE_DEVICE_BGRA_SUPPORT, D3D11_CREATE_DEVICE_DEBUG,
+            D3D11_FEATURE_D3D10_X_HARDWARE_OPTIONS, D3D11_FEATURE_DATA_D3D10_X_HARDWARE_OPTIONS,
+            D3D11_SDK_VERSION, D3D11CreateDevice, ID3D11Device, ID3D11DeviceContext,
+        },
+        Dxgi::{
+            CreateDXGIFactory2, DXGI_CREATE_FACTORY_DEBUG, DXGI_CREATE_FACTORY_FLAGS,
+            IDXGIAdapter1, IDXGIFactory6,
+        },
+    },
+};
+use windows::core::Interface;
+
+pub(crate) fn try_to_recover_from_device_lost<T>(mut f: impl FnMut() -> Result<T>) -> Result<T> {
+    (0..5)
+        .map(|i| {
+            if i > 0 {
+                // Add a small delay before retrying
+                std::thread::sleep(std::time::Duration::from_millis(100 + i * 10));
+            }
+            f()
+        })
+        .find_or_last(Result::is_ok)
+        .unwrap()
+        .context("DirectXRenderer failed to recover from lost device after multiple attempts")
+}
+
+#[derive(Clone)]
+pub(crate) struct DirectXDevices {
+    // KaminIDE patch: owned generation snapshot survives in previously captured frames.
+    pub(crate) context: gpui::frame_capture::GpuDeviceContext,
+    pub(crate) adapter_preference: crate::GpuAdapterPreference,
+    pub(crate) adapter: IDXGIAdapter1,
+    pub(crate) dxgi_factory: IDXGIFactory6,
+    pub(crate) device: ID3D11Device,
+    pub(crate) device_context: ID3D11DeviceContext,
+    pub(crate) instrumentation: gpui::Instrumentation,
+}
+
+impl DirectXDevices {
+    #[cfg(test)]
+    pub(crate) fn new() -> Result<Self> {
+        Self::with_instrumentation(crate::GpuAdapterPreference::Default, gpui::Instrumentation::default())
+    }
+
+    pub(crate) fn with_instrumentation(adapter_preference: crate::GpuAdapterPreference, instrumentation: gpui::Instrumentation) -> Result<Self> {
+        let debug_layer_available = check_debug_layer_available();
+        crate::gpu_context::validate_mode(&adapter_preference, instrumentation.config().debug_device)?;
+        let dxgi_factory =
+            get_dxgi_factory(debug_layer_available).context("Creating DXGI factory")?;
+        let (adapter, device, device_context, feature_level) =
+            get_adapter(&dxgi_factory, debug_layer_available, &adapter_preference, instrumentation.config().debug_device).context("Getting DXGI adapter")?;
+        match feature_level {
+            D3D_FEATURE_LEVEL_11_1 => {
+                log::info!("Created device with Direct3D 11.1 feature level.")
+            }
+            D3D_FEATURE_LEVEL_11_0 => {
+                log::info!("Created device with Direct3D 11.0 feature level.")
+            }
+            D3D_FEATURE_LEVEL_10_1 => {
+                log::info!("Created device with Direct3D 10.1 feature level.")
+            }
+            _ => unreachable!(),
+        }
+
+        let mode = if cfg!(debug_assertions) { instrumentation.config().debug_device } else { gpui::DebugDevice::Default };
+        let context = crate::gpu_context::read(&device, 1, debug_layer_available, mode)?;
+        let adapter_preference = crate::gpu_context::pin(&adapter_preference, &context)?;
+        Ok(Self {
+            context,
+            adapter_preference,
+            adapter,
+            dxgi_factory,
+            device,
+            device_context,
+            instrumentation,
+        })
+    }
+}
+
+#[inline]
+fn check_debug_layer_available() -> bool {
+    #[cfg(debug_assertions)]
+    {
+        use windows::Win32::Graphics::Dxgi::{DXGIGetDebugInterface1, IDXGIInfoQueue};
+
+        unsafe { DXGIGetDebugInterface1::<IDXGIInfoQueue>(0) }
+            .log_err()
+            .is_some()
+    }
+    #[cfg(not(debug_assertions))]
+    {
+        false
+    }
+}
+
+#[inline]
+fn get_dxgi_factory(debug_layer_available: bool) -> Result<IDXGIFactory6> {
+    let factory_flag = if debug_layer_available {
+        DXGI_CREATE_FACTORY_DEBUG
+    } else {
+        #[cfg(debug_assertions)]
+        log::warn!(
+            "Failed to get DXGI debug interface. DirectX debugging features will be disabled."
+        );
+        DXGI_CREATE_FACTORY_FLAGS::default()
+    };
+    unsafe { Ok(CreateDXGIFactory2(factory_flag)?) }
+}
+
+/// Debug acceptance only (`InstrumentationConfig`): an application-owned D3D11On12
+/// device, so the shell can call `ID3D12Device5::RemoveDevice` on it and GPUI
+/// takes its real device-lost path without any system-wide D3D setting.
+fn get_d3d11on12_device(
+    adapter: &IDXGIAdapter1,
+    debug_layer_available: bool,
+) -> Result<(ID3D11Device, ID3D11DeviceContext, D3D_FEATURE_LEVEL)> {
+    use windows::Win32::Graphics::{
+        Direct3D11on12::D3D11On12CreateDevice,
+        Direct3D12::{
+            CLSID_D3D12DeviceFactory, D3D12_COMMAND_LIST_TYPE_DIRECT, D3D12_COMMAND_QUEUE_DESC,
+            D3D12_DEVICE_FACTORY_FLAG_DISALLOW_STORING_NEW_DEVICE_AS_SINGLETON, D3D12CreateDevice,
+            D3D12GetInterface, ID3D12CommandQueue, ID3D12Device, ID3D12DeviceFactory,
+        },
+    };
+    // D3D12 devices are per-adapter singletons: after RemoveDevice the old
+    // generation still holds the removed singleton, so a plain
+    // D3D12CreateDevice during recovery would hand it back. A device factory
+    // that never stores its device as the singleton yields a fresh device for
+    // every generation; fall back to the singleton API where unavailable.
+    let independent = || -> Result<ID3D12Device> {
+        let mut factory: Option<ID3D12DeviceFactory> = None;
+        unsafe { D3D12GetInterface(&CLSID_D3D12DeviceFactory, &mut factory)? };
+        let factory = factory.context("D3D12GetInterface returned no device factory")?;
+        unsafe {
+            factory.SetFlags(D3D12_DEVICE_FACTORY_FLAG_DISALLOW_STORING_NEW_DEVICE_AS_SINGLETON)?
+        };
+        let mut device: Option<ID3D12Device> = None;
+        unsafe { factory.CreateDevice(adapter, D3D_FEATURE_LEVEL_11_0, &mut device)? };
+        device.context("ID3D12DeviceFactory::CreateDevice returned no device")
+    };
+    let d3d12 = match independent().log_err() {
+        Some(device) => device,
+        None => {
+            let mut device: Option<ID3D12Device> = None;
+            unsafe { D3D12CreateDevice(adapter, D3D_FEATURE_LEVEL_11_0, &mut device)? };
+            device.context("D3D12CreateDevice returned no device")?
+        }
+    };
+    let queue: ID3D12CommandQueue = unsafe {
+        d3d12.CreateCommandQueue(&D3D12_COMMAND_QUEUE_DESC {
+            Type: D3D12_COMMAND_LIST_TYPE_DIRECT,
+            ..Default::default()
+        })?
+    };
+    let queues = [Some(queue.cast()?)];
+    let levels = [
+        D3D_FEATURE_LEVEL_11_1,
+        D3D_FEATURE_LEVEL_11_0,
+        D3D_FEATURE_LEVEL_10_1,
+    ];
+    let create = |flags: u32| -> Result<(ID3D11Device, ID3D11DeviceContext, D3D_FEATURE_LEVEL)> {
+        let mut device: Option<ID3D11Device> = None;
+        let mut context: Option<ID3D11DeviceContext> = None;
+        let mut feature_level = D3D_FEATURE_LEVEL::default();
+        unsafe {
+            D3D11On12CreateDevice(
+                &d3d12,
+                flags,
+                Some(&levels),
+                Some(&queues),
+                0,
+                Some(&mut device),
+                Some(&mut context),
+                Some(&mut feature_level),
+            )?
+        };
+        Ok((
+            device.context("D3D11On12CreateDevice returned no device")?,
+            context.context("D3D11On12CreateDevice returned no context")?,
+            feature_level,
+        ))
+    };
+    let bgra = D3D11_CREATE_DEVICE_BGRA_SUPPORT.0 as u32;
+    if debug_layer_available
+        && let Some(created) = create(bgra | D3D11_CREATE_DEVICE_DEBUG.0 as u32).log_err()
+    {
+        return Ok(created);
+    }
+    create(bgra)
+}
+
+#[inline]
+fn get_device(
+    adapter: &IDXGIAdapter1,
+    context: Option<*mut Option<ID3D11DeviceContext>>,
+    feature_level: Option<*mut D3D_FEATURE_LEVEL>,
+    debug_layer_available: bool,
+) -> Result<ID3D11Device> {
+    let mut device: Option<ID3D11Device> = None;
+    let device_flags = if debug_layer_available {
+        D3D11_CREATE_DEVICE_BGRA_SUPPORT | D3D11_CREATE_DEVICE_DEBUG
+    } else {
+        D3D11_CREATE_DEVICE_BGRA_SUPPORT
+    };
+    unsafe {
+        D3D11CreateDevice(
+            adapter,
+            D3D_DRIVER_TYPE_UNKNOWN,
+            HMODULE::default(),
+            device_flags,
+            // 4x MSAA is required for Direct3D Feature Level 10.1 or better
+            Some(&[
+                D3D_FEATURE_LEVEL_11_1,
+                D3D_FEATURE_LEVEL_11_0,
+                D3D_FEATURE_LEVEL_10_1,
+            ]),
+            D3D11_SDK_VERSION,
+            Some(&mut device),
+            feature_level,
+            context,
+        )?;
+    }
+    let device = device.unwrap();
+    let mut data = D3D11_FEATURE_DATA_D3D10_X_HARDWARE_OPTIONS::default();
+    unsafe {
+        device
+            .CheckFeatureSupport(
+                D3D11_FEATURE_D3D10_X_HARDWARE_OPTIONS,
+                &mut data as *mut _ as _,
+                std::mem::size_of::<D3D11_FEATURE_DATA_D3D10_X_HARDWARE_OPTIONS>() as u32,
+            )
+            .context("Checking GPU device feature support")?;
+    }
+    if data
+        .ComputeShaders_Plus_RawAndStructuredBuffers_Via_Shader_4_x
+        .as_bool()
+    {
+        Ok(device)
+    } else {
+        Err(anyhow::anyhow!(
+            "Required feature StructuredBuffer is not supported by GPU/driver"
+        ))
+    }
+}
diff --git a/vendor/gpui-windows/src/directx_devices/adapter.rs b/vendor/gpui-windows/src/directx_devices/adapter.rs
new file mode 100644
index 0000000000000000000000000000000000000000..281808cffc0174eba95396a06b74e2f1e68ad9b7
--- /dev/null
+++ b/vendor/gpui-windows/src/directx_devices/adapter.rs
@@ -0,0 +1,80 @@
+//! KaminIDE patch: создание device на выбранном адаптере без скрытого fallback.
+
+use super::*;
+
+#[inline]
+pub(super) fn get_adapter(
+    dxgi_factory: &IDXGIFactory6,
+    debug_layer_available: bool,
+    preference: &crate::GpuAdapterPreference,
+    debug_device: gpui::DebugDevice,
+) -> Result<(
+    IDXGIAdapter1,
+    ID3D11Device,
+    ID3D11DeviceContext,
+    D3D_FEATURE_LEVEL,
+)> {
+    // KaminIDE patch: leave the entire default creation path unchanged.
+    if *preference != crate::GpuAdapterPreference::Default {
+        let adapter = crate::gpu_adapter::selected_adapter(dxgi_factory, preference)?;
+        let mut context = None;
+        let mut feature_level = D3D_FEATURE_LEVEL::default();
+        let device = get_device(&adapter, Some(&mut context), Some(&mut feature_level),
+            debug_layer_available).context("Creating device on the requested GPU")?;
+        return Ok((adapter, device, context.context("Missing D3D device context")?, feature_level));
+    }
+    // В release сохраняется обычный выбор адаптера.
+    let debug_device = if cfg!(debug_assertions) {
+        debug_device
+    } else {
+        gpui::DebugDevice::Default
+    };
+    match debug_device {
+        gpui::DebugDevice::Default => {}
+        gpui::DebugDevice::Warp => {
+            let adapter: IDXGIAdapter1 = unsafe { dxgi_factory.EnumWarpAdapter()? };
+            log::info!("Debug acceptance override: Direct3D device on the WARP adapter");
+            let mut context: Option<ID3D11DeviceContext> = None;
+            let mut feature_level = D3D_FEATURE_LEVEL::default();
+            let device = get_device(
+                &adapter,
+                Some(&mut context),
+                Some(&mut feature_level),
+                debug_layer_available,
+            )?;
+            return Ok((adapter, device, context.unwrap(), feature_level));
+        }
+        gpui::DebugDevice::D3D11On12 => {
+            let adapter: IDXGIAdapter1 = unsafe { dxgi_factory.EnumAdapters(0)?.cast()? };
+            log::info!("Debug acceptance override: D3D11On12 device on adapter 0");
+            let (device, context, feature_level) =
+                get_d3d11on12_device(&adapter, debug_layer_available)?;
+            return Ok((adapter, device, context, feature_level));
+        }
+    }
+    for adapter_index in 0.. {
+        let adapter: IDXGIAdapter1 = unsafe { dxgi_factory.EnumAdapters(adapter_index)?.cast()? };
+        if let Ok(desc) = unsafe { adapter.GetDesc1() } {
+            let gpu_name = String::from_utf16_lossy(&desc.Description)
+                .trim_matches(char::from(0))
+                .to_string();
+            log::info!("Using GPU: {}", gpu_name);
+        }
+        // Check to see whether the adapter supports Direct3D 11 and create
+        // the device if it does.
+        let mut context: Option<ID3D11DeviceContext> = None;
+        let mut feature_level = D3D_FEATURE_LEVEL::default();
+        if let Some(device) = get_device(
+            &adapter,
+            Some(&mut context),
+            Some(&mut feature_level),
+            debug_layer_available,
+        )
+        .log_err()
+        {
+            return Ok((adapter, device, context.unwrap(), feature_level));
+        }
+    }
+
+    unreachable!()
+}
