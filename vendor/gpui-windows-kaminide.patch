diff --git a/vendor/gpui-windows/src/directx_renderer/analytic_gradient.rs b/vendor/gpui-windows/src/directx_renderer/analytic_gradient.rs
new file mode 100644
index 0000000000000000000000000000000000000000..edab36c3742ea464516540010862cb9466b3b9aa
--- /dev/null
+++ b/vendor/gpui-windows/src/directx_renderer/analytic_gradient.rs
@@ -0,0 +1,166 @@
+//! Arbitrary stop buffers follow quad instances, including retained layer instances.
+//! WARP executes the same analytic shader directly in the destination surface.
+//! Analytic quads have a pixel program of their own (as WebRender separates
+//! `brush_solid` from `brush_linear_gradient`): the plain quad program carries
+//! neither the stop loop nor the t5/t6 buffers, so pages without gradients pay
+//! nothing for them, not even its creation: the driver compiles the program
+//! when the first analytic quad is drawn. Both programs read the same quad
+//! instance buffer.
+
+use super::*;
+
+/// The analytic-gradient pixel program over the quad instance buffer. Its
+/// identity is known up front; the device object is created on first use and
+/// dropped with the pipelines when the device is lost.
+pub(super) struct GradientProgram {
+    fragment: std::cell::OnceCell<ID3D11PixelShader>,
+    pub(super) executable: String,
+}
+
+impl GradientProgram {
+    pub(super) fn new() -> Result<Self> {
+        let raw = RawShaderBytes::new(ShaderModule::QuadGradient, ShaderTarget::Fragment)?;
+        Ok(Self {
+            executable: super::shader_identity::executable(raw.as_bytes())?,
+            fragment: std::cell::OnceCell::new(),
+        })
+    }
+
+    pub(super) fn fragment(&self, device: &ID3D11Device) -> Result<&ID3D11PixelShader> {
+        if self.fragment.get().is_none() {
+            let raw = RawShaderBytes::new(ShaderModule::QuadGradient, ShaderTarget::Fragment)?;
+            let _ = self.fragment.set(create_fragment_shader(device, raw.as_bytes())?);
+        }
+        Ok(self.fragment.get().expect("set above"))
+    }
+
+    pub(super) fn is_created(&self) -> bool {
+        self.fragment.get().is_some()
+    }
+}
+
+/// Splits `quads` (instances `first..`) into maximal runs of one program and
+/// yields `(analytic, first_instance, count)` in paint order. Runs keep the
+/// primitive order exactly, so splitting never reorders overlapping quads.
+pub(super) fn program_runs(quads: &[Quad], first: usize) -> impl Iterator<Item = (bool, usize, usize)> + '_ {
+    let mut at = 0;
+    std::iter::from_fn(move || {
+        let analytic = quads.get(at)?.is_analytic_gradient();
+        let len = quads[at..].iter().take_while(|q| q.is_analytic_gradient() == analytic).count();
+        let run = (analytic, first + at, len);
+        at += len;
+        Some(run)
+    })
+}
+
+pub(super) struct GradientBuffers {
+    descriptors: Buffer,
+    stops: Buffer,
+}
+
+struct Buffer {
+    buffer: ID3D11Buffer,
+    view: Option<ID3D11ShaderResourceView>,
+    capacity: usize,
+    used: usize,
+    stride: usize,
+}
+
+impl Buffer {
+    fn new<T>(device: &ID3D11Device) -> Result<Self> {
+        let buffer = create_buffer(device, std::mem::size_of::<T>(), 1)?;
+        let view = create_buffer_view(device, &buffer)?;
+        Ok(Self {
+            buffer,
+            view,
+            capacity: 1,
+            used: 0,
+            stride: std::mem::size_of::<T>(),
+        })
+    }
+
+    fn upload<T>(
+        &mut self,
+        device: &ID3D11Device,
+        dc: &ID3D11DeviceContext,
+        data: &[T],
+    ) -> Result<()> {
+        if data.is_empty() {
+            return Ok(());
+        }
+        anyhow::ensure!(
+            std::mem::size_of_val(data) <= MAX_INSTANCE_BUFFER_SIZE,
+            "Analytic gradient buffer exceeds instance limit"
+        );
+        if data.len() > self.capacity {
+            let capacity = data
+                .len()
+                .next_power_of_two()
+                .min(MAX_INSTANCE_BUFFER_SIZE / std::mem::size_of::<T>());
+            let buffer = create_buffer(device, std::mem::size_of::<T>(), capacity)?;
+            let view = create_buffer_view(device, &buffer)?;
+            *self = Self {
+                buffer,
+                view,
+                capacity,
+                used: 0,
+                stride: std::mem::size_of::<T>(),
+            };
+        }
+        self.used = data.len();
+        update_buffer(dc, &self.buffer, data)
+    }
+}
+
+impl GradientBuffers {
+    pub(super) fn gpu_memory(&self, sink: &mut dyn FnMut(&'static str, u64, u64)) {
+        for (path, b) in [
+            ("gpu/gradient/descriptors", &self.descriptors),
+            ("gpu/gradient/stops", &self.stops),
+        ] {
+            sink(
+                path,
+                (b.capacity * b.stride) as u64,
+                (b.used * b.stride) as u64,
+            );
+        }
+    }
+}
+
+impl<T> PipelineState<T> {
+    pub(super) fn upload_gradients(
+        &mut self,
+        device: &ID3D11Device,
+        dc: &ID3D11DeviceContext,
+        data: &gpui::GradientData,
+    ) -> Result<()> {
+        if data.descriptors.is_empty() {
+            self.gradients = None;
+            return Ok(());
+        }
+        if self.gradients.is_none() {
+            self.gradients = Some(GradientBuffers {
+                descriptors: Buffer::new::<gpui::GradientDescriptor>(device)?,
+                stops: Buffer::new::<gpui::GradientStop>(device)?,
+            });
+        }
+        let buffers = self.gradients.as_mut().unwrap();
+        buffers.descriptors.upload(device, dc, &data.descriptors)?;
+        buffers.stops.upload(device, dc, &data.stops)
+    }
+
+    pub(super) fn bind_gradients(&self, dc: &ID3D11DeviceContext) {
+        if let Some(buffers) = &self.gradients {
+            unsafe {
+                dc.PSSetShaderResources(
+                    5,
+                    Some(&[buffers.descriptors.view.clone(), buffers.stops.view.clone()]),
+                );
+            }
+        } else {
+            unsafe {
+                dc.PSSetShaderResources(5, Some(&[None, None]));
+            }
+        }
+    }
+}
diff --git a/vendor/gpui-windows/src/directx_renderer/backdrop.rs b/vendor/gpui-windows/src/directx_renderer/backdrop.rs
new file mode 100644
index 0000000000000000000000000000000000000000..48ada74c4c937b14089fa45c661a6b0487a6472d
--- /dev/null
+++ b/vendor/gpui-windows/src/directx_renderer/backdrop.rs
@@ -0,0 +1,202 @@
+//! KaminIDE patch (INC-2026-0001): фон окна — очисткой кадра, а не квадом.
+//!
+//! Корень интерфейса первым рисует сплошной непрозрачный квад на всё окно.
+//! Кадр перед этим всё равно очищается, а очистка цели на видеокарте почти
+//! бесплатна, тогда как квад проходит пиксельный шейдер и смешивание на каждом
+//! пикселе окна. Замер на Intel UHD (окно 1750×1093): квады стоили 4,57 мс GPU
+//! на кадр при 4,13 Мпикс площади, из них 1,9 Мпикс — этот фон; без него
+//! 3,05 мс и 2,22 Мпикс, кадр целиком 5,40 → 3,89 мс, скриншоты совпадают
+//! бит в бит. На WARP цена кадра пропорциональна площади, поэтому выигрыш
+//! там того же порядка.
+//!
+//! Если первый примитив кадра — такой квад, кадр очищается его цветом, а сам
+//! квад не рисуется. Цвет переводится тем же `Hsla → Rgba`, что и
+//! `hsla_to_rgba` в шейдере, а цель кадра — UNORM без sRGB-преобразования,
+//! так что пиксели те же.
+
+use gpui::{PrimitiveBatch, Rgba, Scene};
+
+/// Цвет очистки вместо первого квада сцены, если тот закрывает всё окно
+/// `width × height` (физические px) и ничего под собой не прячет.
+pub(super) fn opaque_backdrop(scene: &Scene, width: u32, height: u32) -> Option<[f32; 4]> {
+    // Квад обязан быть самым первым примитивом: иначе под ним уже что-то
+    // нарисовано, и очистка это стёрла бы.
+    match scene.batches().next() {
+        Some(PrimitiveBatch::Quads(range)) if range.start == 0 && !range.is_empty() => {}
+        // KaminIDE patch: a frame that starts with a retained layer starts
+        // with the layer's first batch (the renderer skips that quad there).
+        Some(PrimitiveBatch::Layer(index)) if scene.groups.is_empty() => {
+            return opaque_backdrop(scene.layer(index)?.scene(), width, height);
+        }
+        _ => return None,
+    }
+    // Буферы групп рисуются ДО кадра, и backdrop-проход внутри группы
+    // (`backdrop-filter` под `clip-path`/`mask`) пишет в сам кадр, а не в
+    // буфер группы. Раньше фоновый квад перекрывал этот след целиком; как
+    // очистка он уже ничего не перекрывает, и след остаётся на экране
+    // (`clip-path-svg-text-backdrop-filter`: инвертированная коробка поверх
+    // страницы вместо пустой маски). Под очисткой такой кадр не живёт.
+    if scene
+        .groups
+        .iter()
+        .any(|g| g.scene.surfaces.iter().any(|s| s.group == 0))
+    {
+        return None;
+    }
+    let quad = scene.quads.first()?;
+    let color = quad.background.as_solid()?;
+    if color.a < 1.0 {
+        return None;
+    }
+    let r = &quad.corner_radii;
+    let b = &quad.border_widths;
+    let t = &quad.transformation;
+    let flat = [r.top_left, r.top_right, r.bottom_left, r.bottom_right]
+        .iter()
+        .chain([b.top, b.right, b.bottom, b.left].iter())
+        .all(|v| v.0 == 0.0);
+    let unit = t.rotation_scale == [[1.0, 0.0], [0.0, 1.0]] && t.translation == [0.0, 0.0];
+    let (w, h) = (width as f32, height as f32);
+    let covers = |b: &gpui::Bounds<gpui::ScaledPixels>| {
+        b.origin.x.0 <= 0.0
+            && b.origin.y.0 <= 0.0
+            && b.origin.x.0 + b.size.width.0 >= w
+            && b.origin.y.0 + b.size.height.0 >= h
+    };
+    if !(flat && unit && covers(&quad.bounds) && covers(&quad.content_mask.bounds)) {
+        return None;
+    }
+    let rgba = Rgba::from(color);
+    Some([rgba.r, rgba.g, rgba.b, 1.0])
+}
+
+#[cfg(test)]
+mod tests {
