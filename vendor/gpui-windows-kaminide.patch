@@ -0,0 +1,29 @@
+use super::{MAX_DIRECT_SIGMA, direct_radius, margin, weights};
+
+#[test]
+fn small_sigmas_convolve_directly_with_three_sigma_support() {
+    assert_eq!(direct_radius(0.6), Some(2));
+    assert_eq!(direct_radius(1.0), Some(3));
+    assert_eq!(direct_radius(MAX_DIRECT_SIGMA), Some(12));
+    assert_eq!(direct_radius(4.01), None);
+    assert_eq!(direct_radius(0.0), None);
+    assert_eq!(direct_radius(f32::NAN), None);
+    assert_eq!(margin(0.6), 2.0);
+    // The cascade keeps its own spread for large radii.
+    assert_eq!(margin(28.0), 48.0);
+}
+
+#[test]
+fn weights_are_a_normalized_symmetric_gaussian() {
+    for sigma in [0.3f32, 0.6, 1.0, 2.5, 4.0] {
+        let r = direct_radius(sigma).unwrap();
+        let w = weights(sigma, r);
+        let sum: f32 = w[0] + 2.0 * w[1..=r].iter().sum::<f32>();
+        assert!((sum - 1.0).abs() < 1e-6, "σ {sigma}: {sum}");
+        assert!(w[1..=r].windows(2).all(|p| p[0] > p[1]));
+        assert!(w[r + 1..].iter().all(|v| *v == 0.0));
+        // Ratio of neighbours is the Gaussian's exp(-(2k+1)/(2σ²)).
+        let expect = (-1.0 / (2.0 * sigma * sigma)).exp();
+        assert!((w[1] / w[0] - expect).abs() < 1e-5);
+    }
+}
diff --git a/vendor/gpui-windows/src/directx_renderer/gpu_memory.rs b/vendor/gpui-windows/src/directx_renderer/gpu_memory.rs
new file mode 100644
index 0000000000000000000000000000000000000000..9985732d57fea0ddc4830e31d9e3b8eba845d848
--- /dev/null
+++ b/vendor/gpui-windows/src/directx_renderer/gpu_memory.rs
@@ -0,0 +1,104 @@
+//! KaminIDE patch: GPU memory the renderer holds, by owner, for the engine bench's memory
+//! report (`Window::gpu_memory`). Sizes come from the texture descriptions: what the pixels
+//! take, not what the driver reserved around them. Not walked: the swap chain's other
+//! buffers, DirectWrite's glyph rasterization targets (they live for one glyph), buffers and
+//! shaders.
+
+use super::*;
+
+/// Pixel storage of a texture: every mip level, array slice and MSAA sample.
+pub(crate) fn texture_bytes(texture: &ID3D11Texture2D) -> u64 {
+    let mut desc = D3D11_TEXTURE2D_DESC::default();
+    unsafe { texture.GetDesc(&mut desc) };
+    described_bytes(&desc)
+}
+
+fn described_bytes(desc: &D3D11_TEXTURE2D_DESC) -> u64 {
+    let texel = match desc.Format {
+        DXGI_FORMAT_R8_UNORM | DXGI_FORMAT_A8_UNORM => 1,
+        DXGI_FORMAT_R16G16B16A16_FLOAT => 8,
+        _ => 4,
+    };
+    let (mut width, mut height) = (u64::from(desc.Width), u64::from(desc.Height));
+    let mut texels = 0;
+    // MipLevels 0 asks for the full chain.
+    let levels = if desc.MipLevels == 0 { u32::MAX } else { desc.MipLevels };
+    for _ in 0..levels {
+        texels += width * height;
+        if width <= 1 && height <= 1 {
+            break;
+        }
+        (width, height) = ((width / 2).max(1), (height / 2).max(1));
+    }
+    texels * texel * u64::from(desc.ArraySize.max(1)) * u64::from(desc.SampleDesc.Count.max(1))
+}
+
+impl DirectXRenderer {
+    /// One call per texture the renderer holds: owner path, bytes, bytes in use.
+    pub(crate) fn gpu_memory(&self, sink: &mut dyn FnMut(&'static str, u64, u64)) {
+        self.atlas.gpu_memory(sink);
+        let mut whole = |path: &'static str, texture: &ID3D11Texture2D| {
+            let bytes = texture_bytes(texture);
+            sink(path, bytes, bytes);
+        };
+        if let Some(resources) = &self.resources {
+            if let Some(target) = &resources.render_target {
+                whole("gpu/target/frame", target);
+            }
+            whole("gpu/target/path", &resources.path_intermediate_texture);
+            whole("gpu/target/path-msaa", &resources.path_intermediate_msaa_texture);
+        }
+        let blur = &self.blur;
+        let single = [
+            ("gpu/group/stage", &blur.stage),
+            ("gpu/group/level-backdrop", &blur.level_backdrop),
+            ("gpu/blur/copy", &blur.copy),
+            ("gpu/blur/blend-copy", &blur.blend_copy),
+            ("gpu/blur/gauss", &blur.gauss),
+        ];
+        for (path, texture) in single {
+            if let Some(texture) = texture {
+                whole(path, &texture.texture);
+            }
+        }
+        let lists = [
+            ("gpu/blur/down", blur.down.as_slice()),
+            ("gpu/group/atlas", blur.groups.as_slice()),
+            ("gpu/group/pool", blur.pool.idle()),
+        ];
+        for (path, textures) in lists {
+            for texture in textures {
+                whole(path, &texture.texture);
+            }
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    // Not a glob: the parent's glob brings gpui's own `test` attribute into scope.
+    use super::{
+        D3D11_TEXTURE2D_DESC, DXGI_FORMAT, DXGI_FORMAT_B8G8R8A8_UNORM, DXGI_FORMAT_R8_UNORM,
+        DXGI_FORMAT_R16G16B16A16_FLOAT, DXGI_SAMPLE_DESC, described_bytes,
+    };
+
+    fn desc(width: u32, height: u32, format: DXGI_FORMAT, mips: u32, samples: u32) -> D3D11_TEXTURE2D_DESC {
+        D3D11_TEXTURE2D_DESC {
+            Width: width,
+            Height: height,
+            MipLevels: mips,
+            ArraySize: 1,
+            Format: format,
+            SampleDesc: DXGI_SAMPLE_DESC { Count: samples, Quality: 0 },
+            ..Default::default()
+        }
+    }
+
+    #[test]
+    fn bytes_follow_format_mips_and_samples() {
+        assert_eq!(described_bytes(&desc(1024, 1024, DXGI_FORMAT_R8_UNORM, 1, 1)), 1 << 20);
+        assert_eq!(described_bytes(&desc(800, 600, DXGI_FORMAT_B8G8R8A8_UNORM, 1, 4)), 800 * 600 * 16);
+        assert_eq!(described_bytes(&desc(16, 16, DXGI_FORMAT_R16G16B16A16_FLOAT, 1, 1)), 16 * 16 * 8);
+        assert_eq!(described_bytes(&desc(4, 2, DXGI_FORMAT_B8G8R8A8_UNORM, 0, 1)), (8 + 2 + 1) * 4);
+    }
+}
diff --git a/vendor/gpui-windows/src/directx_renderer/group_atlas.rs b/vendor/gpui-windows/src/directx_renderer/group_atlas.rs
new file mode 100644
index 0000000000000000000000000000000000000000..2e9b453cacbdfaaefea43d6e73270965c917ac1f
--- /dev/null
+++ b/vendor/gpui-windows/src/directx_renderer/group_atlas.rs
@@ -0,0 +1,137 @@
+//! KaminIDE patch: one shared atlas for the retained images of a frame's paint groups.
+//!
+//! Every group used to own a texture of its exact region size, so a page with
+//! hundreds of filtered or blended groups created hundreds of textures on its
+//! first frame and switched render targets between all of them. Like
+//! WebRender's texture cache and render-task atlases, the retained images of
+//! one frame are shelf-packed into a few large pages instead: writes and
+//! composites then address an integer rectangle of a shared surface, and
+//! independent groups can be drawn as instances of one draw call.
+
+mod shelves;
+pub(super) use shelves::Shelves;
+
+/// Largest page side the packer opens on its own (a single larger region
+/// still gets a page of its own size).
+pub(super) const PAGE_LIMIT: u32 = 4096;
+
+/// Where a group's retained image lives: page index and integer top-left corner.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub(super) struct Place {
+    pub page: usize,
+    pub x: u32,
+    pub y: u32,
+}
+
+/// Shelf-pack `sizes` (width, height). Returns the place of every size, in
+/// input order, and the used size of every page. Taller rectangles go first,
+/// so each shelf is as tall as its first rectangle; equal heights keep their
+/// input order, which keeps the layout stable from frame to frame.
+pub(super) fn pack(sizes: &[(u32, u32)]) -> (Vec<Place>, Vec<(u32, u32)>) {
+    if sizes.is_empty() {
+        return (Vec::new(), Vec::new());
+    }
+    let max_w = sizes.iter().map(|s| s.0).max().unwrap_or(1).max(1);
+    let area: u64 = sizes.iter().map(|&(w, h)| u64::from(w) * u64::from(h)).sum();
+    // Square-ish pages; the width is rounded so small changes of the content
+    // do not change the layout of every shelf.
+    let side = ((area as f64).sqrt().ceil() as u32).next_multiple_of(256);
+    let width = side.clamp(256, PAGE_LIMIT).max(max_w);
+    let mut order: Vec<usize> = (0..sizes.len()).collect();
+    order.sort_by_key(|&i| (std::cmp::Reverse(sizes[i].1), i));
+    let mut places = vec![Place::default(); sizes.len()];
+    let mut pages = vec![(width, 0u32)];
+    let (mut x, mut y, mut shelf) = (0u32, 0u32, 0u32);
+    for i in order {
+        let (w, h) = (sizes[i].0.max(1), sizes[i].1.max(1));
+        if x + w > width {
+            y += shelf;
+            (x, shelf) = (0, 0);
+        }
+        if y > 0 && y + h > PAGE_LIMIT.max(h) {
+            pages.push((width, 0));
+            (x, y, shelf) = (0, 0, 0);
+        }
+        places[i] = Place {
+            page: pages.len() - 1,
+            x,
+            y,
+        };
+        x += w;
+        shelf = shelf.max(h);
+        let page = pages.last_mut().unwrap();
+        page.1 = page.1.max(y + shelf);
+    }
+    (places, pages)
+}
+
+/// Whether an existing page of `have` size can hold `need` without wasting
+/// more than three quarters of its memory.
+pub(super) fn page_fits(have: (u32, u32), need: (u32, u32)) -> bool {
+    have.0 >= need.0
+        && have.1 >= need.1
+        && u64::from(have.0) * u64::from(have.1) <= 4 * u64::from(need.0) * u64::from(need.1.max(64))
+}
+
+/// Size of a new page for `need`: the height is rounded up so that a slowly
+/// growing set of groups does not recreate the page every frame.
+pub(super) fn page_size(need: (u32, u32)) -> (u32, u32) {
+    (need.0, need.1.next_multiple_of(256).min(PAGE_LIMIT.max(need.1)))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::{PAGE_LIMIT, Place, pack, page_fits, page_size};
+
+    fn overlaps(a: (Place, (u32, u32)), b: (Place, (u32, u32))) -> bool {
+        a.0.page == b.0.page
+            && a.0.x < b.0.x + b.1.0
+            && b.0.x < a.0.x + a.1.0
+            && a.0.y < b.0.y + b.1.1
+            && b.0.y < a.0.y + a.1.1
+    }
+
+    #[test]
+    fn rectangles_are_disjoint_and_inside_their_pages() {
+        let sizes: Vec<(u32, u32)> = (0..480)
+            .map(|i| (200 + (i % 7) * 3, 160 + (i % 5) * 2))
+            .chain([(1, 1), (800, 600), (37, 4000)])
+            .collect();
+        let (places, pages) = pack(&sizes);
+        assert_eq!(places.len(), sizes.len());
+        for (i, (&p, &s)) in places.iter().zip(&sizes).enumerate() {
+            let page = pages[p.page];
+            assert!(p.x + s.0 <= page.0 && p.y + s.1 <= page.1, "{i}: {p:?} {s:?} {page:?}");
+            for (&q, &t) in places.iter().zip(&sizes).skip(i + 1) {
+                assert!(!overlaps((p, s), (q, t)), "{p:?}{s:?} / {q:?}{t:?}");
+            }
+        }
+        assert!(pages.iter().all(|p| p.0 <= PAGE_LIMIT && p.1 <= PAGE_LIMIT));
+        // Near-uniform rectangles pack densely: the pages hold little more than
+        // the rectangles themselves.
+        let (_, pages) = pack(&sizes[..480]);
+        let used: u64 = pages.iter().map(|p| u64::from(p.0) * u64::from(p.1)).sum();
+        let need: u64 = sizes[..480].iter().map(|s| u64::from(s.0) * u64::from(s.1)).sum();
+        assert!(used < need * 12 / 10, "{used} vs {need}");
+    }
+
+    #[test]
+    fn oversized_rectangles_get_their_own_page_and_layout_is_stable() {
+        let (places, pages) = pack(&[(5000, 10), (10, 5000), (3, 3)]);
+        assert_eq!(pages.len(), 2);
+        assert_eq!(places[0], Place { page: 1, x: 0, y: 0 });
+        assert_eq!(places[1], Place { page: 0, x: 0, y: 0 });
+        assert_eq!(pack(&[(5000, 10), (10, 5000), (3, 3)]).0, places);
+        assert_eq!(pack(&[]), (Vec::new(), Vec::new()));
+    }
+
+    #[test]
+    fn pages_are_reused_only_without_gross_waste() {
+        assert!(page_fits((1024, 1024), (1000, 700)));
+        assert!(!page_fits((1024, 512), (1000, 700)));
+        assert!(!page_fits((4096, 4096), (512, 256)));
+        assert_eq!(page_size((768, 700)), (768, 768));
+        assert_eq!(page_size((768, 4090)), (768, 4096));
+        assert_eq!(page_size((768, 5000)), (768, 5000));
+    }
+}
diff --git a/vendor/gpui-windows/src/directx_renderer/group_atlas/shelves.rs b/vendor/gpui-windows/src/directx_renderer/group_atlas/shelves.rs
new file mode 100644
index 0000000000000000000000000000000000000000..9a1c7d06f30b96d6e5eb6b7c573ff297dc4e4eab
--- /dev/null
+++ b/vendor/gpui-windows/src/directx_renderer/group_atlas/shelves.rs
@@ -0,0 +1,157 @@
+//! KaminIDE patch: the shelves of a packed group atlas, reused between frames.
+//!
+//! `pack` lays every group out again from the list of sizes, so one inserted
+//! or removed group moves the rectangles of the groups after it, and their
+//! kept images (`group_cache`) are lost. The shelves of the last full layout
+//! stay instead: kept images keep their rectangles, and the groups without an
+//! image take free space on a shelf at least as tall as they are (best fit
+//! by shelf height, first fit along the shelf), the way WebRender's texture
+//! cache (etagere bucketed shelves) and Skia's glyph atlas plots allocate
+//! into a persistent page. Pages are never grown here: when nothing fits, the
+//! caller packs the whole atlas again, which also undoes fragmentation.
+
+use super::Place;
+
+#[derive(Clone, Debug)]
+struct Shelf {
+    page: usize,
+    y: u32,
+    height: u32,
+    /// Occupied spans `(x, width)`, sorted by `x`.
+    used: Vec<(u32, u32)>,
+}
+
+/// The empty shelves of one atlas layout, or those shelves with the
+/// rectangles of one frame placed on them.
+#[derive(Clone, Debug, Default)]
+pub(crate) struct Shelves {
+    widths: Vec<u32>,
+    shelves: Vec<Shelf>,
+}
+
+impl Shelves {
+    /// The shelves of a `pack` layout (`places` of `sizes`) on pages whose
+    /// textures are `pages` (width, height) — every shelf empty. A shelf
+    /// reaches the next shelf of its page; the last one reaches the page end.
+    pub(crate) fn of_layout(places: &[Place], pages: &[(u32, u32)]) -> Self {
+        let mut tops: Vec<(usize, u32)> = places.iter().map(|p| (p.page, p.y)).collect();
+        tops.sort_unstable();
+        tops.dedup();
+        let shelves = tops
+            .iter()
+            .enumerate()
+            .filter_map(|(k, &(page, y))| {
+                let end = match tops.get(k + 1) {
+                    Some(&(next, ny)) if next == page => ny,
+                    _ => pages.get(page)?.1,
+                };
+                Some(Shelf {
+                    page,
+                    y,
+                    height: end.checked_sub(y)?,
+                    used: Vec::new(),
+                })
+            })
+            .collect();
+        Self {
+            widths: pages.iter().map(|p| p.0).collect(),
+            shelves,
+        }
+    }
+
+    /// Mark the rectangle `size` at `place` as taken. False when it is not on
+    /// a shelf of this layout or overlaps a taken one.
+    pub(crate) fn occupy(&mut self, place: Place, size: (u32, u32)) -> bool {
+        let Some(shelf) = self.shelves.iter_mut().find(|s| {
+            s.page == place.page && s.y == place.y && size.1 <= s.height
+        }) else {
+            return false;
+        };
+        let at = shelf.used.partition_point(|&(x, _)| x < place.x);
+        let left_free = at == 0 || {
+            let (x, w) = shelf.used[at - 1];
+            x + w <= place.x
+        };
+        let right_free = shelf.used.get(at).is_none_or(|&(x, _)| place.x + size.0 <= x);
+        let inside = self
+            .widths
+            .get(place.page)
+            .is_some_and(|&w| place.x + size.0 <= w);
+        if !(left_free && right_free && inside) {
+            return false;
+        }
+        shelf.used.insert(at, (place.x, size.0));
+        true
+    }
+
+    /// A free rectangle of `size`: on the lowest shelf that is tall enough and
+    /// has a gap that wide, at the leftmost such gap.
+    pub(crate) fn alloc(&mut self, size: (u32, u32)) -> Option<Place> {
+        let (w, h) = (size.0.max(1), size.1.max(1));
+        let mut best: Option<(u32, usize, u32)> = None;
+        for (k, s) in self.shelves.iter().enumerate() {
+            if s.height < h || best.is_some_and(|b| b.0 <= s.height) {
+                continue;
+            }
+            let width = self.widths.get(s.page).copied().unwrap_or(0);
+            let mut cursor = 0;
+            let mut gap = None;
+            for &(x, uw) in s.used.iter().chain([(width, 0)].iter()) {
+                if x >= cursor && x - cursor >= w {
+                    gap = Some(cursor);
+                    break;
+                }
+                cursor = cursor.max(x + uw);
+            }
+            if let Some(x) = gap {
+                best = Some((s.height, k, x));
+            }
+        }
+        let (_, k, x) = best?;
+        let shelf = &mut self.shelves[k];
+        let at = shelf.used.partition_point(|&(ux, _)| ux < x);
+        shelf.used.insert(at, (x, w));
+        Some(Place {
+            page: shelf.page,
+            x,
+            y: shelf.y,
+        })
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::super::pack;
+    use super::Shelves;
+
+    #[test]
+    fn a_freed_rectangle_is_given_to_a_group_of_its_size() {
+        let sizes: Vec<(u32, u32)> = (0..40).map(|i| (100 + i % 3, 80)).collect();
+        let (places, pages) = pack(&sizes);
+        let mut s = Shelves::of_layout(&places, &pages);
+        for (i, (&p, &z)) in places.iter().zip(&sizes).enumerate() {
+            if i != 17 {
+                assert!(s.occupy(p, z), "{i}");
+            }
+        }
+        // Taken rectangles cannot be taken twice.
+        assert!(!s.occupy(places[3], sizes[3]));
+        assert_eq!(s.alloc(sizes[17]), Some(places[17]));
+    }
+
+    #[test]
+    fn allocation_prefers_the_lowest_tall_enough_shelf_and_fails_when_full() {
+        let (places, pages) = pack(&[(300, 200), (100, 50)]);
+        let mut s = Shelves::of_layout(&places, &pages);
+        assert!(s.occupy(places[0], (300, 200)));
+        assert!(s.occupy(places[1], (100, 50)));
+        let p = s.alloc((10, 40)).unwrap();
+        assert_eq!(p.y, places[1].y, "the short shelf fits a short rectangle");
+        assert!(s.alloc((pages[0].0, pages[0].1 + 1)).is_none());
+        assert_eq!(
+            s.alloc((1, 1)).map(|p| p.page),
+            Some(0),
+            "space is left on the page"
+        );
+    }
+}
