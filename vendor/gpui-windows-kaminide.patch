+            inner.insert_primitive(surface(group));
+            inner.finish();
+            scene.groups.push(PaintGroup {
+                scene: inner,
+                ..Default::default()
+            });
+            scene
+        };
+        // A backdrop pass (group 0) draws into the frame before quad 0 would.
+        assert_eq!(opaque_backdrop(&with_group(0), W, H), None);
+        // A nested group mark only composes a buffer: the clear stays valid.
+        assert!(opaque_backdrop(&with_group(1), W, H).is_some());
+    }
+
+    #[test]
+    fn anything_drawn_before_the_quad_keeps_it_a_quad() {
+        let mut scene = Scene::default();
+        scene.insert_primitive(Shadow {
+            order: 0,
+            blur_radius: ScaledPixels(4.0),
+            bounds: rect(10.0, 10.0, 50.0, 50.0),
+            corner_radii: Corners::default(),
+            content_mask: ContentMask {
+                bounds: rect(0.0, 0.0, W as f32, H as f32),
+            },
+            color: dark(),
+            element_bounds: rect(10.0, 10.0, 50.0, 50.0),
+            element_corner_radii: Corners::default(),
+            inset: 0,
+            pad: 0,
+        });
+        let mut q = quad(dark());
+        q.order = 1;
+        scene.insert_primitive(q);
+        scene.finish();
+        assert_eq!(opaque_backdrop(&scene, W, H), None);
+    }
+}
diff --git a/vendor/gpui-windows/src/directx_renderer/batch_cost.rs b/vendor/gpui-windows/src/directx_renderer/batch_cost.rs
new file mode 100644
index 0000000000000000000000000000000000000000..6d21abaab80a8f220bd3bba5c283da0d42a26d40
--- /dev/null
+++ b/vendor/gpui-windows/src/directx_renderer/batch_cost.rs
@@ -0,0 +1,196 @@
+//! KaminIDE patch (INC-2026-0001, диагностика): цена кадра по видам пачек.
+//!
+//! На машине без видеокарты каждый кадр окна растеризует WARP на CPU, и его
+//! цена в секундные счётчики gpui не попадает: `Present` только ставит
+//! команды в очередь. Здесь копятся число примитивов, их площадь в пикселях
+//! (для программного растеризатора это прямая мера работы) и GPU-время каждой
+//! пачки по timestamp-запросам D3D11. Результаты забираются с отставанием в
+//! несколько кадров без ожидания — замер не тормозит кадр.
+//!
+//! Число и площадь копятся всегда: это несколько сложений на пачку, а для
+//! программного растеризатора площадь и есть цена. Timestamp-запросы — только
+//! при явном gpu_timing: это лишние объекты устройства и вызовы на
+//! каждую пачку, нужные лишь при разборе.
+
+use windows::Win32::Graphics::Direct3D11::*;
+
+/// Сколько кадров ждут ответа видеокарты одновременно.
+const RING: usize = 4;
+
+struct Slot {
+    disjoint: ID3D11Query,
+    stamps: Vec<ID3D11Query>,
+    kinds: Vec<usize>,
+    used: usize,
+    pending: bool,
+}
+
+/// Timestamp-запросы кадра: стартовая отметка, отметка после каждой пачки.
+#[derive(Default)]
+pub(crate) struct GpuTimer {
+    pub(crate) instrumentation: gpui::Instrumentation,
+    slots: Vec<Slot>,
+    next: usize,
+    current: Option<usize>,
+    failed: bool,
+    /// Устройство, на котором созданы запросы: после device lost рендерер
+    /// создаёт новое, и запросы старого с ним использовать нельзя.
+    device: usize,
+}
+
+impl GpuTimer {
+    pub(crate) fn new(instrumentation: gpui::Instrumentation) -> Self {
+        Self { instrumentation, ..Self::default() }
+    }
+
+    /// Начать кадр. Если слот ещё ждёт видеокарту, кадр идёт без GPU-времени.
+    pub(crate) fn begin(&mut self, device: &ID3D11Device, ctx: &ID3D11DeviceContext) {
+        self.instrumentation.batches.frame();
+        self.current = None;
+        if !self.instrumentation.config().gpu_timing {
+            return;
+        }
+        let raw = windows::core::Interface::as_raw(device) as usize;
+        if raw != self.device {
+            *self = Self {
+                device: raw,
+                instrumentation: self.instrumentation.clone(),
+                ..Self::default()
+            };
+        }
+        if self.failed {
+            return;
+        }
+        if self.slots.is_empty() {
+            for _ in 0..RING {
+                match create_slot(device) {
+                    Some(slot) => self.slots.push(slot),
+                    None => {
+                        self.failed = true;
+                        return;
+                    }
+                }
+            }
+        }
+        for i in 0..RING {
+            collect(&mut self.slots[i], ctx, &self.instrumentation);
+        }
+        let index = self.next;
+        let slot = &mut self.slots[index];
+        if slot.pending {
+            return;
+        }
+        self.next = (index + 1) % RING;
+        slot.used = 0;
+        slot.kinds.clear();
+        unsafe {
+            ctx.Begin(&slot.disjoint);
+            ctx.End(&slot.stamps[0]);
+        }
+        slot.used = 1;
+        self.current = Some(index);
+    }
+
+    /// Отметка после пачки вида `kind`.
+    pub(crate) fn mark(&mut self, device: &ID3D11Device, ctx: &ID3D11DeviceContext, kind: usize) {
+        let Some(index) = self.current else { return };
+        let slot = &mut self.slots[index];
+        if slot.used == slot.stamps.len() {
+            match create_timestamp(device) {
+                Some(q) => slot.stamps.push(q),
+                None => return,
+            }
+        }
+        unsafe { ctx.End(&slot.stamps[slot.used]) };
+        slot.used += 1;
+        slot.kinds.push(kind);
+    }
+
+    /// Закончить кадр; ответ заберёт один из следующих `begin`.
+    pub(crate) fn end(&mut self, ctx: &ID3D11DeviceContext) {
+        let Some(index) = self.current.take() else { return };
+        let slot = &mut self.slots[index];
+        unsafe { ctx.End(&slot.disjoint) };
+        slot.pending = true;
+    }
+}
+
+fn create_query(device: &ID3D11Device, kind: D3D11_QUERY) -> Option<ID3D11Query> {
+    let desc = D3D11_QUERY_DESC {
+        Query: kind,
+        MiscFlags: 0,
+    };
+    let mut query = None;
+    unsafe { device.CreateQuery(&desc, Some(&mut query)) }.ok()?;
+    query
+}
+
+fn create_timestamp(device: &ID3D11Device) -> Option<ID3D11Query> {
+    create_query(device, D3D11_QUERY_TIMESTAMP)
+}
+
+fn create_slot(device: &ID3D11Device) -> Option<Slot> {
+    let disjoint = create_query(device, D3D11_QUERY_TIMESTAMP_DISJOINT)?;
+    let mut stamps = Vec::with_capacity(32);
+    for _ in 0..32 {
+        stamps.push(create_timestamp(device)?);
+    }
+    Some(Slot {
+        disjoint,
+        stamps,
+        kinds: Vec::new(),
+        used: 0,
+        pending: false,
+    })
+}
+
+/// Забрать готовый ответ слота без ожидания.
+fn collect(slot: &mut Slot, ctx: &ID3D11DeviceContext, instrumentation: &gpui::Instrumentation) {
+    if !slot.pending {
+        return;
+    }
+    let mut disjoint = D3D11_QUERY_DATA_TIMESTAMP_DISJOINT::default();
+    if !ready(ctx, &slot.disjoint, &mut disjoint) {
+        return;
+    }
+    slot.pending = false;
+    if disjoint.Disjoint.as_bool() || disjoint.Frequency == 0 {
+        return;
+    }
+    let mut stamps = Vec::with_capacity(slot.used);
+    for q in &slot.stamps[..slot.used] {
+        let mut value = 0u64;
+        if !ready(ctx, q, &mut value) {
+            return;
+        }
+        stamps.push(value);
+    }
+    let ns = |a: u64, b: u64| b.saturating_sub(a) as f64 * 1e9 / disjoint.Frequency as f64;
+    let frame = match (stamps.first(), stamps.last()) {
+        (Some(first), Some(last)) => ns(*first, *last),
+        _ => 0.0,
+    };
+    let kinds: Vec<(usize, f64)> = slot
+        .kinds
+        .iter()
+        .enumerate()
+        .map(|(i, kind)| (*kind, ns(stamps[i], stamps[i + 1])))
+        .collect();
+    instrumentation.batches.timed(frame, &kinds);
+}
+
+fn ready<T>(ctx: &ID3D11DeviceContext, query: &ID3D11Query, out: &mut T) -> bool {
+    use windows::core::Interface;
+    // Обёртка `GetData` сводит S_FALSE («ещё не готово») к Ok — различаем
+    // готовность по сырому HRESULT из vtable.
+    let hr = unsafe {
+        (Interface::vtable(ctx).GetData)(
+            Interface::as_raw(ctx),
+            Interface::as_raw(query),
+            out as *mut T as *mut _,
+            std::mem::size_of::<T>() as u32,
+            D3D11_ASYNC_GETDATA_DONOTFLUSH.0 as u32,
+        )
+    };
+    hr == windows::Win32::Foundation::S_OK
+}
diff --git a/vendor/gpui-windows/src/directx_renderer/damage_audit.rs b/vendor/gpui-windows/src/directx_renderer/damage_audit.rs
new file mode 100644
index 0000000000000000000000000000000000000000..c49be4fa651ee122c07e5e3ba446dc1133dce7c0
--- /dev/null
+++ b/vendor/gpui-windows/src/directx_renderer/damage_audit.rs
@@ -0,0 +1,104 @@
+//! KaminIDE patch: сверка кадра, нарисованного по плану (повреждение, кэш
+//! групп), с тем же кадром, нарисованным целиком без кэша групп.
+//!
+//! Только для стенда ([`set_damage_audit`]): каждый нарисованный кадр
+//! читается из цели, затем та же сцена рисуется заново целиком без картинок
+//! прошлого кадра и читается ещё раз. Несовпадение пишется в лог ошибкой с
+//! номером кадра, планом и рамкой различий. Цель после сверки держит целый
+//! кадр: следующий кадр сравнивается с верной базой, и ошибка видна там,
+//! где возникла, а не там, где накопилась.
+
+use super::*;
+use std::sync::atomic::{AtomicBool, AtomicU64, Ordering};
+
+static AUDIT: AtomicBool = AtomicBool::new(false);
+static MISMATCHES: AtomicU64 = AtomicU64::new(0);
+
+/// Включить сверку для всех окон процесса (стенд, сверка RGB).
+pub fn set_damage_audit(on: bool) {
+    AUDIT.store(on, Ordering::Relaxed);
+}
+
+/// Число кадров, не совпавших с целой перерисовкой, с начала процесса.
+pub fn damage_audit_mismatches() -> u64 {
+    MISMATCHES.load(Ordering::Relaxed)
+}
+
+pub(super) fn enabled() -> bool {
+    AUDIT.load(Ordering::Relaxed)
+}
+
+impl DirectXRenderer {
+    /// Сверить только что нарисованный по `within` кадр с целой перерисовкой.
+    pub(super) fn audit_frame(
+        &mut self,
+        scene: &Scene,
+        background: WindowBackgroundAppearance,
+        within: Option<Region>,
+    ) -> Result<()> {
+        let planned = self.read_target()?;
+        let (kept, drawn) = (
+            self.retained.groups.counts.kept,
+            self.retained.groups.counts.drawn,
+        );
+        // Целый кадр без картинок групп прошлого кадра.
+        self.retained.chain = None;
+        self.retained.groups.valid.clear();
+        self.render(scene, background, None)?;
+        let whole = self.read_target()?;
+        let w = self.width as usize;
+        let mut count = 0usize;
+        let (mut x0, mut y0, mut x1, mut y1) = (usize::MAX, usize::MAX, 0, 0);
+        for (i, (a, b)) in planned
+            .chunks_exact(4)
+            .zip(whole.chunks_exact(4))
+            .enumerate()
+        {
+            if a[..3] != b[..3] {
+                count += 1;
+                let (x, y) = (i % w, i / w);
+                (x0, y0, x1, y1) = (x0.min(x), y0.min(y), x1.max(x), y1.max(y));
+            }
+        }
+        if count > 0 {
+            MISMATCHES.fetch_add(1, Ordering::Relaxed);
+            let (_, base, id, _) = scene.frame_damage();
+            log::error!(
+                "damage audit: frame {id} (base {base}) plan {within:?}, groups kept {kept} drawn {drawn}: \
+                 {count} px differ from the whole frame in x {x0}..={x1} y {y0}..={y1}"
+            );
+        }
+        Ok(())
+    }
+
+    /// The render target as tightly packed BGRA rows.
+    fn read_target(&mut self) -> Result<Vec<u8>> {
+        let (w, h) = (self.width, self.height);
+        let staging = self.capture_staging()?;
+        let ctx = self.dev().device_context.clone();
+        let target = self
+            .res()
+            .render_target
+            .as_ref()
+            .context("render target missing")?;
+        unsafe { ctx.CopyResource(&staging, target) };
+        let mut mapped = D3D11_MAPPED_SUBRESOURCE::default();
+        unsafe { ctx.Map(&staging, 0, D3D11_MAP_READ, 0, Some(&mut mapped))? };
+        let row = (w * 4) as usize;
+        let mut out = vec![0u8; row * h as usize];
+        for y in 0..h as usize {
+            // KaminIDE patch: SAFETY: the mapped staging texture is w x h
+            // BGRA8; each of its rows has RowPitch >= w * 4 readable bytes
+            // until Unmap below.
+            let src = unsafe {
+                std::slice::from_raw_parts(
+                    (mapped.pData as *const u8).add(y * mapped.RowPitch as usize),
+                    row,
+                )
+            };
+            out[y * row..(y + 1) * row].copy_from_slice(src);
+        }
+        unsafe { ctx.Unmap(&staging, 0) };
+        Ok(out)
+    }
+}
diff --git a/vendor/gpui-windows/src/directx_renderer/frame_capture.rs b/vendor/gpui-windows/src/directx_renderer/frame_capture.rs
new file mode 100644
index 0000000000000000000000000000000000000000..e973627a34b99871115f7f107e26ade950f2f512
--- /dev/null
+++ b/vendor/gpui-windows/src/directx_renderer/frame_capture.rs
@@ -0,0 +1,66 @@
+//! KaminIDE patch: readback владеет неизменяемым контекстом своего устройства.
+
+use super::*;
+
+impl DirectXRenderer {
+    /// KaminIDE patch: copy the drawn back buffer to memory (`frame_capture`).
+    pub(super) fn capture_frame(&mut self) -> Result<()> {
+        let started = std::time::Instant::now();
+        let (w, h) = (self.width, self.height);
+        // KaminIDE patch: one staging texture per size (`retained.rs`).
+        let staging = self.capture_staging()?;
+        let devices = self.dev();
+        let render_target = self
+            .res()
+            .render_target
+            .as_ref()
+            .context("render target missing")?;
+        let ctx = &devices.device_context;
+        unsafe { ctx.CopyResource(&staging, render_target) };
+        let mut mapped = D3D11_MAPPED_SUBRESOURCE::default();
+        unsafe { ctx.Map(&staging, 0, D3D11_MAP_READ, 0, Some(&mut mapped))? };
+        let row = (w * 4) as usize;
+        let mut bgra = vec![0u8; row * h as usize];
+        for y in 0..h as usize {
+            // KaminIDE patch: SAFETY: the mapped staging texture is w x h
+            // BGRA8, so each of its h rows has RowPitch >= w * 4 readable
+            // bytes until Unmap below.
+            let src = unsafe {
+                std::slice::from_raw_parts(
+                    (mapped.pData as *const u8).add(y * mapped.RowPitch as usize),
+                    row,
+                )
+            };
+            bgra[y * row..(y + 1) * row].copy_from_slice(src);
+        }
+        unsafe { ctx.Unmap(&staging, 0) };
+        // KaminIDE patch: capture retains the device generation used by this target.
+        let mut target_desc = D3D11_TEXTURE2D_DESC::default();
+        unsafe { render_target.GetDesc(&mut target_desc) };
+        let mut shader_executables: Vec<_> = [
+            &self.pipelines.shadow_pipeline.shader_executables,
+            &self.pipelines.quad_pipeline.shader_executables,
+            &self.pipelines.path_rasterization_pipeline.shader_executables,
+            &self.pipelines.path_sprite_pipeline.shader_executables,
+            &self.pipelines.underline_pipeline.shader_executables,
+            &self.pipelines.mono_sprites.shader_executables,
+            &self.pipelines.subpixel_sprites.shader_executables,
+            &self.pipelines.poly_sprites.shader_executables,
+            &self.pipelines.blur_pipeline.shader_executables,
+            &self.pipelines.clear_pipeline.shader_executables,
+        ].into_iter().flatten().cloned().collect();
+        shader_executables.sort();
+        shader_executables.dedup();
+        let context = Some(gpui::frame_capture::FrameContext {
+            device: devices.context.clone(), shader_executables, target_format: target_desc.Format.0,
+            sample_count: target_desc.SampleDesc.Count, sample_quality: target_desc.SampleDesc.Quality,
+            gamma_ratios: self.font_info.gamma_ratios,
+            grayscale_enhanced_contrast: self.font_info.grayscale_enhanced_contrast,
+        });
+        if let Some(sink) = &mut self.capture {
+            sink.completed(gpui::frame_capture::CapturedFrame { width: w, height: h, bgra, context }, started.elapsed());
+        }
+        Ok(())
+    }
+
+}
diff --git a/vendor/gpui-windows/src/directx_renderer/gaussian.rs b/vendor/gpui-windows/src/directx_renderer/gaussian.rs
new file mode 100644
index 0000000000000000000000000000000000000000..304cc6147ed39210910c32d7f6b8a9c894262113
--- /dev/null
+++ b/vendor/gpui-windows/src/directx_renderer/gaussian.rs
@@ -0,0 +1,246 @@
+//! KaminIDE patch: separable Gaussian for a group's `filter: blur(σ)` with a small σ.
+//!
+//! Filter Effects 1 §blur(): the standard deviation of the Gaussian is the given length.
+//! The downsampling cascade below clamps its step to 1/5 of a pixel, so every σ under
+//! ~2.8 px rendered as the same σ ≈ 1.6 px blur and paid for a 2.5× supersampled
+//! first level (6.25× the group's pixels, nine taps each). Like WebRender
+//! (`MAX_BLUR_STD_DEVIATION`: downscale only while σ > 4) and Skia (direct kernels for
+//! small σ), a σ ≤ 4 device px is convolved exactly at full resolution, straight into the
+//! retained group texture: radius ≤ `MAX_SINGLE_PASS_RADIUS` as one 2D pass, larger radii
+//! as a horizontal pass into a half-float intermediate plus a vertical pass. Taps are
+//! integer texel loads; texels outside the source are transparent black (the filter
+//! input outside the group).
+
+use super::*;
+
+/// Largest σ (device px) convolved directly; above it the cascade downsamples.
+pub(super) const MAX_DIRECT_SIGMA: f32 = 4.0;
+/// Taps per side carried in `BlurQuad::poly` (16 floats).
+const MAX_TAPS: usize = 16;
+/// Largest kernel radius convolved in one 2D pass ((2r+1)² ≤ 81 loads per pixel). A second
+/// pass costs a render-target switch and a read-after-write barrier per group, which on the
+/// measured GPU outweighs the extra taps for these radii.
+pub(super) const MAX_SINGLE_PASS_RADIUS: usize = 4;
+
+/// Kernel half-width for a direct blur of `sigma`, or `None` when the cascade applies.
+pub(super) fn direct_radius(sigma: f32) -> Option<usize> {
+    (sigma.is_finite() && sigma > 0.0 && sigma <= MAX_DIRECT_SIGMA)
+        .then(|| ((3.0 * sigma).ceil() as usize).clamp(1, MAX_TAPS - 1))
+}
+
+/// Margin (device px) the blurred image spreads beyond the group bounds.
+pub(super) fn margin(sigma: f32) -> f32 {
+    match direct_radius(sigma) {
+        Some(r) => r as f32,
+        None => (24.0 * (sigma / 14.0).clamp(0.2, 6.0)).min(96.0),
+    }
+}
+
+/// Normalized one-sided weights w[0..=r] of the sampled Gaussian (w[k] for ±k).
+pub(super) fn weights(sigma: f32, r: usize) -> [f32; MAX_TAPS] {
+    let mut raw = [0f64; MAX_TAPS];
+    let two_var = 2.0 * f64::from(sigma) * f64::from(sigma);
+    let mut sum = 0.0;
+    for (k, w) in raw.iter_mut().enumerate().take(r + 1) {
+        *w = (-((k * k) as f64) / two_var).exp();
+        sum += if k == 0 { *w } else { 2.0 * *w };
+    }
+    let mut out = [0f32; MAX_TAPS];
+    for (o, w) in out.iter_mut().zip(raw) {
+        *o = (w / sum) as f32;
+    }
+    out
+}
+
+fn create_half_float_target(device: &ID3D11Device, width: u32, height: u32) -> Result<BlurTexture> {
+    let desc = D3D11_TEXTURE2D_DESC {
+        Width: width,
+        Height: height,
+        MipLevels: 1,
+        ArraySize: 1,
+        Format: DXGI_FORMAT_R16G16B16A16_FLOAT,
+        SampleDesc: DXGI_SAMPLE_DESC {
+            Count: 1,
+            Quality: 0,
+        },
+        Usage: D3D11_USAGE_DEFAULT,
+        BindFlags: (D3D11_BIND_SHADER_RESOURCE.0 | D3D11_BIND_RENDER_TARGET.0) as u32,
+        CPUAccessFlags: 0,
+        MiscFlags: 0,
+    };
+    let mut texture: Option<ID3D11Texture2D> = None;
+    unsafe { device.CreateTexture2D(&desc, None, Some(&mut texture))? };
+    let texture = texture.context("half-float blur target missing")?;
+    let (mut srv, mut rtv) = (None, None);
+    unsafe {
+        device.CreateShaderResourceView(&texture, None, Some(&mut srv))?;
+        device.CreateRenderTargetView(&texture, None, Some(&mut rtv))?;
+    }
+    Ok(BlurTexture {
+        width,
+        height,
+        texture,
+        rtv: [rtv],
+        srv: [srv],
+    })
+}
+
+/// One-sided kernel weights packed into `BlurQuad::poly` (16 floats).
+pub(super) fn kernel_poly(sigma: f32, r: usize) -> [[f32; 4]; 4] {
+    let t = weights(sigma, r);
+    [
+        [t[0], t[1], t[2], t[3]],
+        [t[4], t[5], t[6], t[7]],
+        [t[8], t[9], t[10], t[11]],
+        [t[12], t[13], t[14], t[15]],
+    ]
+}
+
+/// Instance writing the atlas rectangle `dst` (x, y, w, h) from the texels at
+/// `dst + shift` of the source; taps outside `valid` read transparent black.
+/// `pass` 6 is the whole 2D kernel, 5 one separable direction (`direction`).
+pub(super) fn kernel_quad(
+    dst: [f32; 4],
+    shift: [f32; 2],
+    valid: [f32; 4],
+    pass: f32,
+    direction: [f32; 2],
+    r: usize,
+    poly: [[f32; 4]; 4],
+) -> BlurQuad {
+    BlurQuad {
+        bounds: dst,
+        content_mask: dst,
+        src_origin: shift,
+        blur_pass: pass,
+        pad: r as f32,
+        pad2: direction,
+        poly,
+        source_rect: valid,
+        ..Default::default()
+    }
+}
+
+impl DirectXRenderer {
+    /// Blur group `index` (raw image in the stage within `raw`) into its atlas rectangle.
+    ///
+    /// KaminIDE patch: taps outside the group's own raw region read transparent
+    /// black, as in a layer (`group_batch`): a kept image (`group_cache`) never
+    /// depends on what other passes left in the stage.
+    pub(super) fn gaussian_group(&mut self, index: usize, sigma: f32, r: usize, raw: Region) -> Result<()> {
+        let region = self.blur.group_regions[index];
+        let place = self.blur.group_place[index];
+        let (w, h) = (region.width, region.height);
+        let poly = kernel_poly(sigma, r);
+        let stage = self
+            .blur
+            .stage
+            .as_ref()
+            .context("group stage missing")?
+            .srv
+            .clone();
+        let frame = raw.floats();
+        let dst = [place.x as f32, place.y as f32, w as f32, h as f32];
+        let to_stage = [
+            region.x as f32 - place.x as f32,
+            region.y as f32 - place.y as f32,
+        ];
+        let page = self.blur.groups[place.page].rtv.clone();
+        let page_size = (
+            self.blur.groups[place.page].width,
+            self.blur.groups[place.page].height,
+        );
+        if r <= MAX_SINGLE_PASS_RADIUS {
+            // Whole kernel: frame-domain stage → atlas rectangle.
+            let quad = kernel_quad(dst, to_stage, frame, 6.0, [0.0; 2], r, poly);
+            return self.kernel_instances(&stage, &page, page_size, &[quad]);
+        }
+        if self
+            .blur
+            .gauss
+            .as_ref()
+            .is_none_or(|t| t.width < w || t.height < h)
+        {
+            // Grow-only, rounded up: group sizes vary by a few pixels between groups.
+            let old = self
+                .blur
+                .gauss
+                .as_ref()
+                .map_or((0, 0), |t| (t.width, t.height));
+            let (gw, gh) = (
+                w.max(old.0).next_multiple_of(64),
+                h.max(old.1).next_multiple_of(64),
+            );
+            self.blur.gauss = Some(create_half_float_target(
+                &self.dev().device.clone(),
+                gw,
+                gh,
+            )?);
+        }
+        let gauss = self.blur.gauss.as_ref().unwrap();
+        let (gauss_srv, gauss_rtv) = (gauss.srv.clone(), gauss.rtv.clone());
+        let gauss_size = (gauss.width, gauss.height);
+        let local = [0.0, 0.0, w as f32, h as f32];
+        // Horizontal: frame-domain stage → intermediate (local coordinates).
+        let horizontal = kernel_quad(
+            local,
+            [region.x as f32, region.y as f32],
+            frame,
+            5.0,
+            [1.0, 0.0],
+            r,
+            poly,
+        );
+        self.kernel_instances(&stage, &gauss_rtv, gauss_size, &[horizontal])?;
+        // Vertical: intermediate → atlas rectangle.
+        let vertical = kernel_quad(dst, [-dst[0], -dst[1]], local, 5.0, [0.0, 1.0], r, poly);
+        self.kernel_instances(&gauss_srv, &page, page_size, &[vertical])
+    }
+
+    /// Draw kernel instances from `src` into the whole target `dst` of `size`.
+    pub(super) fn kernel_instances(
+        &mut self,
+        src: &[Option<ID3D11ShaderResourceView>; 1],
+        dst: &[Option<ID3D11RenderTargetView>; 1],
+        (w, h): (u32, u32),
+        quads: &[BlurQuad],
+    ) -> Result<()> {
+        let device = self.dev().device.clone();
+        let dc = self.dev().device_context.clone();
+        self.ensure_blur_globals(&device)?;
+        let (fw, fh) = (w as f32, h as f32);
+        update_buffer(
+            &dc,
+            self.blur.globals[0].as_ref().unwrap(),
+            &[global_params(self.font_info, [fw, fh])],
+        )?;
+        self.pipelines
+            .blur_pipeline
+            .update_buffer(&device, &dc, quads)?;
+        let viewport = [D3D11_VIEWPORT {
+            TopLeftX: 0.0,
+            TopLeftY: 0.0,
+            Width: fw,
+            Height: fh,
+            MinDepth: 0.0,
+            MaxDepth: 1.0,
+        }];
+        let blend = self.replace_blend()?;
+        unsafe { dc.OMSetRenderTargets(Some(dst), None) };
+        let pipeline = &self.pipelines.blur_pipeline;
+        let (globals, sampler) = (&self.blur.globals, &self.globals.sampler);
+        group_stage::downsample_clip(&dc, w, h, || {
+            pipeline.draw_with_texture_blended(
+                &dc,
+                src,
+                &viewport,
+                globals,
+                slice::from_ref(sampler),
+                quads.len() as u32,
+                Some(&blend),
+            )
+        })
+    }
+}
+#[cfg(test)]
+mod tests;
