index 0000000000000000000000000000000000000000..9c6d6912db30686f6411de1815f8167ac29b4cb2
--- /dev/null
+++ b/vendor/gpui-windows/src/directx_renderer/gaussian/tests.rs
@@ -0,0 +1,29 @@
+use super::{MAX_DIRECT_SIGMA, direct_radius, margin, weights};
+
+#[test]
+fn small_sigmas_convolve_directly_with_three_sigma_support() {
+    assert_eq!(direct_radius(0.6), Some(2));
+    assert_eq!(direct_radius(1.0), Some(3));
+    assert_eq!(direct_radius(MAX_DIRECT_SIGMA), Some(12));
+    assert_eq!(direct_radius(4.01), None);
+    assert_eq!(direct_radius(0.0), None);
+    assert_eq!(direct_radius(f32::NAN), None);
+    assert_eq!(margin(0.6), 2.0);
+    // The cascade keeps its own spread for large radii.
+    assert_eq!(margin(28.0), 48.0);
+}
+
+#[test]
+fn weights_are_a_normalized_symmetric_gaussian() {
+    for sigma in [0.3f32, 0.6, 1.0, 2.5, 4.0] {
+        let r = direct_radius(sigma).unwrap();
+        let w = weights(sigma, r);
+        let sum: f32 = w[0] + 2.0 * w[1..=r].iter().sum::<f32>();
+        assert!((sum - 1.0).abs() < 1e-6, "σ {sigma}: {sum}");
+        assert!(w[1..=r].windows(2).all(|p| p[0] > p[1]));
+        assert!(w[r + 1..].iter().all(|v| *v == 0.0));
+        // Ratio of neighbours is the Gaussian's exp(-(2k+1)/(2σ²)).
+        let expect = (-1.0 / (2.0 * sigma * sigma)).exp();
+        assert!((w[1] / w[0] - expect).abs() < 1e-5);
+    }
+}
diff --git a/vendor/gpui-windows/src/directx_renderer/gpu_memory.rs b/vendor/gpui-windows/src/directx_renderer/gpu_memory.rs
new file mode 100644
index 0000000000000000000000000000000000000000..b858362a82fe2dbbf86e227c1def864b5980e2b6
--- /dev/null
+++ b/vendor/gpui-windows/src/directx_renderer/gpu_memory.rs
@@ -0,0 +1,116 @@
+//! KaminIDE patch: GPU memory the renderer holds, by owner, for the engine bench's memory
+//! report (`Window::gpu_memory`). Sizes come from the texture descriptions: what the pixels
+//! take, not what the driver reserved around them. Not walked: the swap chain's other
+//! buffers, DirectWrite's glyph rasterization targets (they live for one glyph), buffers except analytic gradient descriptors/stops, and shaders.
+
+use super::*;
+
+/// Pixel storage of a texture: every mip level, array slice and MSAA sample.
+pub(crate) fn texture_bytes(texture: &ID3D11Texture2D) -> u64 {
+    let mut desc = D3D11_TEXTURE2D_DESC::default();
+    unsafe { texture.GetDesc(&mut desc) };
+    described_bytes(&desc)
+}
+
+fn described_bytes(desc: &D3D11_TEXTURE2D_DESC) -> u64 {
+    let texel = match desc.Format {
+        DXGI_FORMAT_R8_UNORM | DXGI_FORMAT_A8_UNORM => 1,
+        DXGI_FORMAT_R16G16B16A16_FLOAT => 8,
+        _ => 4,
+    };
+    let (mut width, mut height) = (u64::from(desc.Width), u64::from(desc.Height));
+    let mut texels = 0;
+    // MipLevels 0 asks for the full chain.
+    let levels = if desc.MipLevels == 0 { u32::MAX } else { desc.MipLevels };
+    for _ in 0..levels {
+        texels += width * height;
+        if width <= 1 && height <= 1 {
+            break;
+        }
+        (width, height) = ((width / 2).max(1), (height / 2).max(1));
+    }
+    texels * texel * u64::from(desc.ArraySize.max(1)) * u64::from(desc.SampleDesc.Count.max(1))
+}
+
+impl DirectXRenderer {
+    /// One call per texture the renderer holds: owner path, bytes, bytes in use.
+    pub(crate) fn gpu_memory(&self, sink: &mut dyn FnMut(&'static str, u64, u64)) {
+        self.atlas.gpu_memory(sink);
+        if let Some(gradients) = &self.pipelines.quad_pipeline.gradients { gradients.gpu_memory(sink); }
+        self.layer_cache.gradient_memory(sink);
+        let mut whole = |path: &'static str, texture: &ID3D11Texture2D| {
+            let bytes = texture_bytes(texture);
+            sink(path, bytes, bytes);
+        };
+        if let Some(resources) = &self.resources {
+            // The frame's canvas (`canvas`), and the back buffer it is copied to.
+            if let Some(target) = &resources.render_target {
+                whole("gpu/target/frame", target);
+            }
+            if let Some(back) = &resources.back_buffer {
+                whole("gpu/target/back-buffer", back);
+            }
+            if let Some(texture) = &resources.path_intermediate_msaa_texture {
+                whole("gpu/target/path-msaa", texture);
+            }
+        }
+        if let Some((_, _, scratch)) = &self.retained.scratch {
+            whole("gpu/target/shift-scratch", scratch);
+        }
+        let blur = &self.blur;
+        for texture in blur.mask_cache.textures() {
+            whole("gpu/group/mask", texture);
+        }
+        let single = [
+            ("gpu/group/stage", &blur.stage),
+            ("gpu/group/level-backdrop", &blur.level_backdrop),
+            ("gpu/blur/copy", &blur.copy),
+            ("gpu/blur/blend-copy", &blur.blend_copy),
+            ("gpu/blur/gauss", &blur.gauss),
+        ];
+        for (path, texture) in single {
+            if let Some(texture) = texture {
+                whole(path, &texture.texture);
+            }
+        }
+        let lists = [
+            ("gpu/blur/down", blur.down.as_slice()),
+            ("gpu/group/atlas", blur.groups.as_slice()),
+            ("gpu/group/pool", blur.pool.idle()),
+        ];
+        for (path, textures) in lists {
+            for texture in textures {
+                whole(path, &texture.texture);
+            }
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    // Not a glob: the parent's glob brings gpui's own `test` attribute into scope.
+    use super::{
+        D3D11_TEXTURE2D_DESC, DXGI_FORMAT, DXGI_FORMAT_B8G8R8A8_UNORM, DXGI_FORMAT_R8_UNORM,
+        DXGI_FORMAT_R16G16B16A16_FLOAT, DXGI_SAMPLE_DESC, described_bytes,
+    };
+
+    fn desc(width: u32, height: u32, format: DXGI_FORMAT, mips: u32, samples: u32) -> D3D11_TEXTURE2D_DESC {
+        D3D11_TEXTURE2D_DESC {
+            Width: width,
+            Height: height,
+            MipLevels: mips,
+            ArraySize: 1,
+            Format: format,
+            SampleDesc: DXGI_SAMPLE_DESC { Count: samples, Quality: 0 },
+            ..Default::default()
+        }
+    }
+
+    #[test]
+    fn bytes_follow_format_mips_and_samples() {
+        assert_eq!(described_bytes(&desc(1024, 1024, DXGI_FORMAT_R8_UNORM, 1, 1)), 1 << 20);
+        assert_eq!(described_bytes(&desc(800, 600, DXGI_FORMAT_B8G8R8A8_UNORM, 1, 4)), 800 * 600 * 16);
+        assert_eq!(described_bytes(&desc(16, 16, DXGI_FORMAT_R16G16B16A16_FLOAT, 1, 1)), 16 * 16 * 8);
+        assert_eq!(described_bytes(&desc(4, 2, DXGI_FORMAT_B8G8R8A8_UNORM, 0, 1)), (8 + 2 + 1) * 4);
+    }
+}
diff --git a/vendor/gpui-windows/src/directx_renderer/gpu_wait.rs b/vendor/gpui-windows/src/directx_renderer/gpu_wait.rs
new file mode 100644
index 0000000000000000000000000000000000000000..596dd0d953431d215b2094ce1b5b4b72909ab38b
--- /dev/null
+++ b/vendor/gpui-windows/src/directx_renderer/gpu_wait.rs
@@ -0,0 +1,114 @@
+//! KaminIDE patch: wait until the GPU has executed every command submitted so
+//! far, for as long as that work takes and no longer.
+//!
+//! A device fence (D3D11.3, `ID3D11Fence`) is signalled on the context after
+//! the frame's commands; the kernel sets an event when the GPU passes it, and
+//! the thread sleeps on that event. Polling an event query instead spins a
+//! core while the driver or the WARP rasterizer threads need it, and a poll
+//! that does not flush (`D3D11_ASYNC_GETDATA_DONOTFLUSH`) sees the query
+//! complete only once something else submits the queue: on two cores that
+//! cost a scheduler quantum (~15.6 ms) per captured frame. Chromium waits for
+//! the GPU the same way (`gl::GLFenceWin`, `D3DSharedFence`: a D3D11 fence and
+//! `SetEventOnCompletion`). A device without fences polls the query and flushes
+//! on every poll, as ANGLE's `Renderer11::finish` does.
+
+use super::*;
+use windows::Win32::Foundation::{CloseHandle, HANDLE, S_OK, WAIT_OBJECT_0};
+use windows::Win32::System::Threading::{CreateEventW, WaitForSingleObject};
+use windows::core::Interface;
+
+/// The longest wait for the GPU before the capture fails (a removed device).
+const WAIT_MS: u32 = 10_000;
+
+/// How the device waits for the GPU, found on the first capture.
+#[derive(Default)]
+pub(super) enum GpuWait {
+    #[default]
+    Unknown,
+    /// A fence with the last value signalled, and the event it sets.
+    Fence(ID3D11Fence, u64, OwnedEvent),
+    /// No fence on this device: an event query.
+    Query,
+}
+
+/// An event handle closed on drop.
+pub(super) struct OwnedEvent(HANDLE);
+
+impl Drop for OwnedEvent {
+    fn drop(&mut self) {
+        // SAFETY: the handle came from `CreateEventW` and is closed once.
+        let _ = unsafe { CloseHandle(self.0) };
+    }
+}
+
+/// The device's fence and an auto-reset event, or `None` without fences.
+fn fence_of(device: &ID3D11Device) -> Option<GpuWait> {
+    let device5: ID3D11Device5 = device.cast().ok()?;
+    let mut fence: Option<ID3D11Fence> = None;
+    // SAFETY: plain COM calls on a live device.
+    unsafe { device5.CreateFence(0, D3D11_FENCE_FLAG_NONE, &mut fence) }.ok()?;
+    let event = unsafe { CreateEventW(None, false, false, None) }.ok()?;
+    Some(GpuWait::Fence(fence?, 0, OwnedEvent(event)))
+}
+
+impl DirectXRenderer {
+    /// Block until the GPU has executed every command submitted so far,
+    /// without touching the frame's pixels.
+    pub(super) fn wait_gpu_idle(&mut self) -> Result<()> {
+        let device = self.dev().device.clone();
+        let ctx = self.dev().device_context.clone();
+        let wait = &mut self.retained.gpu_wait;
+        if matches!(wait, GpuWait::Unknown) {
+            *wait = fence_of(&device).unwrap_or(GpuWait::Query);
+        }
+        match wait {
+            GpuWait::Fence(fence, value, event) => {
+                let ctx4: ID3D11DeviceContext4 = ctx.cast()?;
+                *value += 1;
+                // SAFETY: COM calls on the live context and fence; the event
+                // outlives the wait.
+                unsafe {
+                    ctx4.Signal(&*fence, *value)?;
+                    ctx.Flush();
+                    fence.SetEventOnCompletion(*value, event.0)?;
+                    if WaitForSingleObject(event.0, WAIT_MS) != WAIT_OBJECT_0 {
+                        anyhow::bail!("GPU fence wait timed out");
+                    }
+                }
+                Ok(())
+            }
+            _ => wait_query(&device, &ctx),
+        }
+    }
+}
+
+/// Poll an event query, flushing the queue on every poll.
+fn wait_query(device: &ID3D11Device, ctx: &ID3D11DeviceContext) -> Result<()> {
+    let desc = D3D11_QUERY_DESC { Query: D3D11_QUERY_EVENT, MiscFlags: 0 };
+    let mut query = None;
+    unsafe { device.CreateQuery(&desc, Some(&mut query))? };
+    let query: ID3D11Query = query.context("event query missing")?;
+    unsafe { ctx.End(&query) };
+    let started = std::time::Instant::now();
+    loop {
+        let mut done = 0i32;
+        // The `GetData` wrapper maps S_FALSE ("not yet") to Ok; read the raw HRESULT.
+        let hr = unsafe {
+            (Interface::vtable(ctx).GetData)(
+                Interface::as_raw(ctx),
+                Interface::as_raw(&query),
+                &mut done as *mut i32 as *mut _,
+                std::mem::size_of::<i32>() as u32,
+                0,
+            )
+        };
+        hr.ok()?;
+        if hr == S_OK && done != 0 {
+            return Ok(());
+        }
+        if started.elapsed().as_millis() > u128::from(WAIT_MS) {
+            anyhow::bail!("GPU event query wait timed out");
+        }
+        std::thread::yield_now();
+    }
+}
diff --git a/vendor/gpui-windows/src/directx_renderer/group_atlas.rs b/vendor/gpui-windows/src/directx_renderer/group_atlas.rs
new file mode 100644
index 0000000000000000000000000000000000000000..2e9b453cacbdfaaefea43d6e73270965c917ac1f
--- /dev/null
+++ b/vendor/gpui-windows/src/directx_renderer/group_atlas.rs
@@ -0,0 +1,137 @@
+//! KaminIDE patch: one shared atlas for the retained images of a frame's paint groups.
+//!
+//! Every group used to own a texture of its exact region size, so a page with
+//! hundreds of filtered or blended groups created hundreds of textures on its
+//! first frame and switched render targets between all of them. Like
+//! WebRender's texture cache and render-task atlases, the retained images of
+//! one frame are shelf-packed into a few large pages instead: writes and
+//! composites then address an integer rectangle of a shared surface, and
+//! independent groups can be drawn as instances of one draw call.
+
+mod shelves;
+pub(super) use shelves::Shelves;
+
+/// Largest page side the packer opens on its own (a single larger region
+/// still gets a page of its own size).
+pub(super) const PAGE_LIMIT: u32 = 4096;
+
+/// Where a group's retained image lives: page index and integer top-left corner.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub(super) struct Place {
+    pub page: usize,
+    pub x: u32,
+    pub y: u32,
+}
+
+/// Shelf-pack `sizes` (width, height). Returns the place of every size, in
+/// input order, and the used size of every page. Taller rectangles go first,
+/// so each shelf is as tall as its first rectangle; equal heights keep their
+/// input order, which keeps the layout stable from frame to frame.
+pub(super) fn pack(sizes: &[(u32, u32)]) -> (Vec<Place>, Vec<(u32, u32)>) {
+    if sizes.is_empty() {
+        return (Vec::new(), Vec::new());
+    }
+    let max_w = sizes.iter().map(|s| s.0).max().unwrap_or(1).max(1);
+    let area: u64 = sizes.iter().map(|&(w, h)| u64::from(w) * u64::from(h)).sum();
+    // Square-ish pages; the width is rounded so small changes of the content
+    // do not change the layout of every shelf.
+    let side = ((area as f64).sqrt().ceil() as u32).next_multiple_of(256);
+    let width = side.clamp(256, PAGE_LIMIT).max(max_w);
+    let mut order: Vec<usize> = (0..sizes.len()).collect();
+    order.sort_by_key(|&i| (std::cmp::Reverse(sizes[i].1), i));
+    let mut places = vec![Place::default(); sizes.len()];
+    let mut pages = vec![(width, 0u32)];
+    let (mut x, mut y, mut shelf) = (0u32, 0u32, 0u32);
+    for i in order {
+        let (w, h) = (sizes[i].0.max(1), sizes[i].1.max(1));
+        if x + w > width {
+            y += shelf;
+            (x, shelf) = (0, 0);
+        }
+        if y > 0 && y + h > PAGE_LIMIT.max(h) {
+            pages.push((width, 0));
+            (x, y, shelf) = (0, 0, 0);
+        }
+        places[i] = Place {
+            page: pages.len() - 1,
+            x,
+            y,
+        };
+        x += w;
+        shelf = shelf.max(h);
+        let page = pages.last_mut().unwrap();
+        page.1 = page.1.max(y + shelf);
+    }
+    (places, pages)
+}
+
+/// Whether an existing page of `have` size can hold `need` without wasting
+/// more than three quarters of its memory.
+pub(super) fn page_fits(have: (u32, u32), need: (u32, u32)) -> bool {
+    have.0 >= need.0
+        && have.1 >= need.1
+        && u64::from(have.0) * u64::from(have.1) <= 4 * u64::from(need.0) * u64::from(need.1.max(64))
+}
+
+/// Size of a new page for `need`: the height is rounded up so that a slowly
+/// growing set of groups does not recreate the page every frame.
+pub(super) fn page_size(need: (u32, u32)) -> (u32, u32) {
+    (need.0, need.1.next_multiple_of(256).min(PAGE_LIMIT.max(need.1)))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::{PAGE_LIMIT, Place, pack, page_fits, page_size};
+
+    fn overlaps(a: (Place, (u32, u32)), b: (Place, (u32, u32))) -> bool {
+        a.0.page == b.0.page
+            && a.0.x < b.0.x + b.1.0
+            && b.0.x < a.0.x + a.1.0
+            && a.0.y < b.0.y + b.1.1
+            && b.0.y < a.0.y + a.1.1
+    }
+
+    #[test]
+    fn rectangles_are_disjoint_and_inside_their_pages() {
+        let sizes: Vec<(u32, u32)> = (0..480)
+            .map(|i| (200 + (i % 7) * 3, 160 + (i % 5) * 2))
+            .chain([(1, 1), (800, 600), (37, 4000)])
+            .collect();
+        let (places, pages) = pack(&sizes);
+        assert_eq!(places.len(), sizes.len());
+        for (i, (&p, &s)) in places.iter().zip(&sizes).enumerate() {
+            let page = pages[p.page];
+            assert!(p.x + s.0 <= page.0 && p.y + s.1 <= page.1, "{i}: {p:?} {s:?} {page:?}");
+            for (&q, &t) in places.iter().zip(&sizes).skip(i + 1) {
+                assert!(!overlaps((p, s), (q, t)), "{p:?}{s:?} / {q:?}{t:?}");
+            }
+        }
+        assert!(pages.iter().all(|p| p.0 <= PAGE_LIMIT && p.1 <= PAGE_LIMIT));
+        // Near-uniform rectangles pack densely: the pages hold little more than
+        // the rectangles themselves.
+        let (_, pages) = pack(&sizes[..480]);
+        let used: u64 = pages.iter().map(|p| u64::from(p.0) * u64::from(p.1)).sum();
+        let need: u64 = sizes[..480].iter().map(|s| u64::from(s.0) * u64::from(s.1)).sum();
+        assert!(used < need * 12 / 10, "{used} vs {need}");
+    }
+
+    #[test]
+    fn oversized_rectangles_get_their_own_page_and_layout_is_stable() {
+        let (places, pages) = pack(&[(5000, 10), (10, 5000), (3, 3)]);
+        assert_eq!(pages.len(), 2);
+        assert_eq!(places[0], Place { page: 1, x: 0, y: 0 });
+        assert_eq!(places[1], Place { page: 0, x: 0, y: 0 });
+        assert_eq!(pack(&[(5000, 10), (10, 5000), (3, 3)]).0, places);
+        assert_eq!(pack(&[]), (Vec::new(), Vec::new()));
+    }
+
+    #[test]
+    fn pages_are_reused_only_without_gross_waste() {
+        assert!(page_fits((1024, 1024), (1000, 700)));
+        assert!(!page_fits((1024, 512), (1000, 700)));
+        assert!(!page_fits((4096, 4096), (512, 256)));
+        assert_eq!(page_size((768, 700)), (768, 768));
+        assert_eq!(page_size((768, 4090)), (768, 4096));
+        assert_eq!(page_size((768, 5000)), (768, 5000));
+    }
+}
diff --git a/vendor/gpui-windows/src/directx_renderer/group_atlas/shelves.rs b/vendor/gpui-windows/src/directx_renderer/group_atlas/shelves.rs
new file mode 100644
index 0000000000000000000000000000000000000000..9a1c7d06f30b96d6e5eb6b7c573ff297dc4e4eab
--- /dev/null
+++ b/vendor/gpui-windows/src/directx_renderer/group_atlas/shelves.rs
@@ -0,0 +1,157 @@
+//! KaminIDE patch: the shelves of a packed group atlas, reused between frames.
+//!
+//! `pack` lays every group out again from the list of sizes, so one inserted
+//! or removed group moves the rectangles of the groups after it, and their
+//! kept images (`group_cache`) are lost. The shelves of the last full layout
+//! stay instead: kept images keep their rectangles, and the groups without an
+//! image take free space on a shelf at least as tall as they are (best fit
+//! by shelf height, first fit along the shelf), the way WebRender's texture
+//! cache (etagere bucketed shelves) and Skia's glyph atlas plots allocate
+//! into a persistent page. Pages are never grown here: when nothing fits, the
+//! caller packs the whole atlas again, which also undoes fragmentation.
+
+use super::Place;
+
+#[derive(Clone, Debug)]
+struct Shelf {
+    page: usize,
+    y: u32,
+    height: u32,
+    /// Occupied spans `(x, width)`, sorted by `x`.
+    used: Vec<(u32, u32)>,
+}
+
+/// The empty shelves of one atlas layout, or those shelves with the
+/// rectangles of one frame placed on them.
+#[derive(Clone, Debug, Default)]
+pub(crate) struct Shelves {
+    widths: Vec<u32>,
+    shelves: Vec<Shelf>,
+}
+
+impl Shelves {
+    /// The shelves of a `pack` layout (`places` of `sizes`) on pages whose
+    /// textures are `pages` (width, height) — every shelf empty. A shelf
+    /// reaches the next shelf of its page; the last one reaches the page end.
+    pub(crate) fn of_layout(places: &[Place], pages: &[(u32, u32)]) -> Self {
+        let mut tops: Vec<(usize, u32)> = places.iter().map(|p| (p.page, p.y)).collect();
+        tops.sort_unstable();
+        tops.dedup();
+        let shelves = tops
+            .iter()
+            .enumerate()
+            .filter_map(|(k, &(page, y))| {
+                let end = match tops.get(k + 1) {
+                    Some(&(next, ny)) if next == page => ny,
+                    _ => pages.get(page)?.1,
+                };
+                Some(Shelf {
+                    page,
+                    y,
+                    height: end.checked_sub(y)?,
+                    used: Vec::new(),
+                })
+            })
+            .collect();
+        Self {
+            widths: pages.iter().map(|p| p.0).collect(),
+            shelves,
+        }
+    }
+
+    /// Mark the rectangle `size` at `place` as taken. False when it is not on
+    /// a shelf of this layout or overlaps a taken one.
+    pub(crate) fn occupy(&mut self, place: Place, size: (u32, u32)) -> bool {
+        let Some(shelf) = self.shelves.iter_mut().find(|s| {
+            s.page == place.page && s.y == place.y && size.1 <= s.height
+        }) else {
+            return false;
+        };
+        let at = shelf.used.partition_point(|&(x, _)| x < place.x);
+        let left_free = at == 0 || {
+            let (x, w) = shelf.used[at - 1];
+            x + w <= place.x
+        };
+        let right_free = shelf.used.get(at).is_none_or(|&(x, _)| place.x + size.0 <= x);
+        let inside = self
+            .widths
+            .get(place.page)
+            .is_some_and(|&w| place.x + size.0 <= w);
+        if !(left_free && right_free && inside) {
+            return false;
+        }
+        shelf.used.insert(at, (place.x, size.0));
+        true
+    }
+
+    /// A free rectangle of `size`: on the lowest shelf that is tall enough and
+    /// has a gap that wide, at the leftmost such gap.
+    pub(crate) fn alloc(&mut self, size: (u32, u32)) -> Option<Place> {
+        let (w, h) = (size.0.max(1), size.1.max(1));
+        let mut best: Option<(u32, usize, u32)> = None;
+        for (k, s) in self.shelves.iter().enumerate() {
+            if s.height < h || best.is_some_and(|b| b.0 <= s.height) {
+                continue;
+            }
+            let width = self.widths.get(s.page).copied().unwrap_or(0);
+            let mut cursor = 0;
+            let mut gap = None;
+            for &(x, uw) in s.used.iter().chain([(width, 0)].iter()) {
+                if x >= cursor && x - cursor >= w {
+                    gap = Some(cursor);
+                    break;
+                }
+                cursor = cursor.max(x + uw);
+            }
+            if let Some(x) = gap {
+                best = Some((s.height, k, x));
+            }
+        }
+        let (_, k, x) = best?;
+        let shelf = &mut self.shelves[k];
+        let at = shelf.used.partition_point(|&(ux, _)| ux < x);
+        shelf.used.insert(at, (x, w));
+        Some(Place {
+            page: shelf.page,
+            x,
+            y: shelf.y,
+        })
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::super::pack;
+    use super::Shelves;
+
+    #[test]
+    fn a_freed_rectangle_is_given_to_a_group_of_its_size() {
+        let sizes: Vec<(u32, u32)> = (0..40).map(|i| (100 + i % 3, 80)).collect();
+        let (places, pages) = pack(&sizes);
+        let mut s = Shelves::of_layout(&places, &pages);
+        for (i, (&p, &z)) in places.iter().zip(&sizes).enumerate() {
+            if i != 17 {
+                assert!(s.occupy(p, z), "{i}");
+            }
+        }
+        // Taken rectangles cannot be taken twice.
+        assert!(!s.occupy(places[3], sizes[3]));
+        assert_eq!(s.alloc(sizes[17]), Some(places[17]));
+    }
+
+    #[test]
+    fn allocation_prefers_the_lowest_tall_enough_shelf_and_fails_when_full() {
+        let (places, pages) = pack(&[(300, 200), (100, 50)]);
+        let mut s = Shelves::of_layout(&places, &pages);
+        assert!(s.occupy(places[0], (300, 200)));
+        assert!(s.occupy(places[1], (100, 50)));
+        let p = s.alloc((10, 40)).unwrap();
+        assert_eq!(p.y, places[1].y, "the short shelf fits a short rectangle");
+        assert!(s.alloc((pages[0].0, pages[0].1 + 1)).is_none());
+        assert_eq!(
+            s.alloc((1, 1)).map(|p| p.page),
+            Some(0),
+            "space is left on the page"
+        );
+    }
+}
diff --git a/vendor/gpui-windows/src/directx_renderer/group_batch.rs b/vendor/gpui-windows/src/directx_renderer/group_batch.rs
new file mode 100644
index 0000000000000000000000000000000000000000..cf28000ea13602f8b36cf2041ae3dff75c0c8f0a
--- /dev/null
+++ b/vendor/gpui-windows/src/directx_renderer/group_batch.rs
@@ -0,0 +1,446 @@
+//! KaminIDE patch: batched group passes — layers of disjoint groups and composite levels.
+//!
+//! A frame with N filtered or blended groups used to run a chain of dependent
+//! passes per group (draw → blur → composite with its own backdrop copy), so
+//! render-target switches and read-after-write barriers grew with N. As in
+//! WebRender's render-task graph (independent tasks of one pass share a target
+//! and one batch) and Skia Graphite's draw passes, independent work is grouped:
+//!
+//! - **Layers.** Groups whose stage regions are pairwise disjoint are drawn into
+//!   the frame-domain stage together; one instanced kernel draw moves all of them
+//!   into their atlas rectangles. Each group still rasterizes in frame
+//!   coordinates with the frame viewport, and its kernel reads only its own
+//!   region, exactly the pixels it read alone.
+//! - **Composite levels.** A composite depends only on earlier composites that
+//!   overlap it. Within one run of consecutive group composites, composite j gets
+//!   level 1 + the highest level of an earlier overlapping composite; composites
+//!   of one level are pairwise disjoint, so one backdrop copy and one instanced
+//!   draw serve the whole level, and every pixel sees the same backdrop as in
+//!   document order (Compositing 1 §5: each group is blended with everything
+//!   painted before it). Masked composites join the draw of their mask image.
+
+use super::*;
+
+/// Largest number of groups or composites batched together; bounds the
+/// quadratic overlap tests.
+const MAX_BATCH: usize = 1024;
+
+pub(super) fn intersects(a: Region, b: Region) -> bool {
+    a.x < b.x + b.width && b.x < a.x + a.width && a.y < b.y + b.height && b.y < a.y + a.height
+}
+
+/// Composite level of every rectangle: 0 without an earlier overlapping one,
+/// otherwise one above the highest earlier overlapping level.
+pub(super) fn levels(rects: &[Region]) -> Vec<u32> {
+    let mut level: Vec<u32> = Vec::with_capacity(rects.len());
+    for (j, &rect) in rects.iter().enumerate() {
+        let l = rects[..j]
+            .iter()
+            .zip(&level)
+            .filter(|(r, _)| intersects(**r, rect))
+            .map(|(_, l)| l + 1)
+            .max()
+            .unwrap_or(0);
+        level.push(l);
+    }
+    level
+}
+
+/// Scratch instance vectors of a stage layer (kept between frames for their capacity).
+#[derive(Default)]
+pub(super) struct LayerInstances {
+    pub(super) shadows: Vec<Shadow>,
+    pub(super) quads: Vec<Quad>,
+    pub(super) gradients: gpui::GradientData,
+    pub(super) underlines: Vec<Underline>,
+    pub(super) mono: Vec<MonochromeSprite>,
+    pub(super) subpixel: Vec<SubpixelSprite>,
+    pub(super) poly: Vec<PolychromeSprite>,
+}
+
+impl LayerInstances {
+    pub(super) fn clear(&mut self) {
+        self.shadows.clear();
+        self.quads.clear();
+        self.gradients.descriptors.clear();
+        self.gradients.stops.clear();
+        self.underlines.clear();
+        self.mono.clear();
+        self.subpixel.clear();
+        self.poly.clear();
+    }
+}
+
+/// First-fit layers of pairwise disjoint rectangles; each layer lists indices
+/// in increasing order and holds at most `MAX_BATCH` of them.
+pub(super) fn pack_layers(rects: &[Region]) -> Vec<Vec<usize>> {
+    let mut layers: Vec<Vec<usize>> = Vec::new();
+    for (k, &r) in rects.iter().enumerate() {
+        let free = layers
+            .iter()
+            .position(|l| l.len() < MAX_BATCH && l.iter().all(|&j| !intersects(rects[j], r)));
+        match free {
+            Some(l) => layers[l].push(k),
+            None => layers.push(vec![k]),
+        }
+    }
+    layers
+}
+
+/// Whether group `g` can join a stage layer: its image is final once drawn
+/// (no nested composites or backdrops reading the stage) and its filter is
+/// none or a single-pass kernel.
+pub(super) fn joins_layer(g: &gpui::PaintGroup) -> bool {
+    g.scene.surfaces.is_empty()
+        && (g.blur_radius <= 0.0
+            || gaussian::direct_radius(g.blur_radius)
+                .is_some_and(|r| r <= gaussian::MAX_SINGLE_PASS_RADIUS))
+}
+
+impl DirectXRenderer {
+    /// Draw the joinable groups `segment` (indices into `groups`) layer by layer
+    /// and empty it. Groups are independent images, so their drawing order is
+    /// free: first-fit puts each group into the first layer whose stage regions
+    /// it does not overlap (graph colouring of the overlap graph), which needs
+    /// about as many layers as the deepest overlap instead of one per
+    /// overlapping neighbour in document order.
+    pub(super) fn draw_group_layers(
+        &mut self,
+        groups: &[gpui::PaintGroup],
+        segment: &mut Vec<usize>,
+    ) -> Result<()> {
+        let raws: Vec<Region> = segment
+            .iter()
+            .map(|&i| Region::for_group(&groups[i], self.width, self.height)[0])
+            .collect();
+        for layer in pack_layers(&raws) {
+            let members: Vec<usize> = layer.iter().map(|&k| segment[k]).collect();
+            // One upload per instance kind for the whole layer; on failure (an
+            // oversized layer) every group uploads its own scene as before.
+            let bases = self.upload_layer(groups, &members).ok();
+            for (n, &k) in layer.iter().enumerate() {
+                let i = segment[k];
+                let base = bases.as_ref().map(|b| b[n]);
+                self.draw_group_content(&groups[i], raws[k], base)?;
+                self.blur.layer.push(i);
+            }
+            self.flush_group_layer(groups)?;
+        }
+        segment.clear();
+        Ok(())
+    }
+    /// Upload the instances of every group of a layer, kind by kind, into one
+    /// buffer each (WebRender and Graphite fill per-frame GPU buffers in bulk
+    /// instead of mapping per draw). Returns each group's first index per kind.
+    pub(super) fn upload_layer(
+        &mut self,
+        groups: &[gpui::PaintGroup],
+        members: &[usize],
+    ) -> Result<Vec<[usize; 6]>> {
+        let mut all = std::mem::take(&mut self.blur.layer_instances);
+        all.clear();
+        let mut bases = Vec::with_capacity(members.len());
+        for &i in members {
+            let s = &groups[i].scene;
+            bases.push([
+                all.shadows.len(),
+                all.quads.len(),
+                all.underlines.len(),
+                all.mono.len(),
+                all.subpixel.len(),
+                all.poly.len(),
+            ]);
+            all.shadows.extend_from_slice(&s.shadows);
+            let first_quad = all.quads.len();
+            all.quads.extend_from_slice(&s.quads);
+            all.gradients.append(s, &mut all.quads[first_quad..]);
+            all.underlines.extend_from_slice(&s.underlines);
+            all.mono.extend_from_slice(&s.monochrome_sprites);
+            all.subpixel.extend_from_slice(&s.subpixel_sprites);
+            all.poly.extend_from_slice(&s.polychrome_sprites);
+        }
+        let result = self.upload_instances(&all);
+        all.clear();
+        self.blur.layer_instances = all;
+        result.map(|()| bases)
+    }
+
+    pub(super) fn upload_instances(&mut self, all: &LayerInstances) -> Result<()> {
+        let device = self.dev().device.clone();
+        let dc = self.dev().device_context.clone();
+        let p = &mut self.pipelines;
+        if !all.shadows.is_empty() {
+            p.shadow_pipeline.update_buffer(&device, &dc, &all.shadows)?;
+        }
+        if !all.quads.is_empty() {
+            p.quad_pipeline.upload_gradients(&device, &dc, &all.gradients)?;
+            p.quad_pipeline.update_buffer(&device, &dc, &all.quads)?;
+        }
+        if !all.underlines.is_empty() {
+            p.underline_pipeline.update_buffer(&device, &dc, &all.underlines)?;
+        }
+        if !all.mono.is_empty() {
+            p.mono_sprites.update_buffer(&device, &dc, &all.mono)?;
+        }
+        if !all.subpixel.is_empty() {
+            p.subpixel_sprites.update_buffer(&device, &dc, &all.subpixel)?;
+        }
+        if !all.poly.is_empty() {
+            p.poly_sprites.update_buffer(&device, &dc, &all.poly)?;
+        }
+        Ok(())
+    }
+
+    /// Move every group of the pending layer from the stage into the atlas:
+    /// unfiltered ones by copy, filtered ones with one kernel draw per atlas page.
+    pub(super) fn flush_group_layer(&mut self, groups: &[gpui::PaintGroup]) -> Result<()> {
+        if self.blur.layer.is_empty() {
+            return Ok(());
+        }
+        let layer = std::mem::take(&mut self.blur.layer);
+        let mut pages: Vec<(usize, Vec<BlurQuad>)> = Vec::new();
+        for &i in &layer {
+            let g = &groups[i];
+            let Some(r) = gaussian::direct_radius(g.blur_radius) else {
+                self.save_group_stage(i);
+                continue;
+            };
+            let (region, place) = (self.blur.group_regions[i], self.blur.group_place[i]);
+            // The kernel reads only the group's own stage region: outside it the
+            // stage held transparent black when the group was drawn alone.
+            let raw = Region::for_group(g, self.width, self.height)[0];
+            let quad = gaussian::kernel_quad(
+                [place.x as f32, place.y as f32, region.width as f32, region.height as f32],
+                [
+                    region.x as f32 - place.x as f32,
+                    region.y as f32 - place.y as f32,
+                ],
+                raw.floats(),
+                6.0,
+                [0.0; 2],
+                r,
+                gaussian::kernel_poly(g.blur_radius, r),
+            );
+            match pages.iter_mut().find(|(p, _)| *p == place.page) {
+                Some((_, quads)) => quads.push(quad),
+                None => pages.push((place.page, vec![quad])),
+            }
+        }
+        self.blur.layer = layer;
+        self.blur.layer.clear();
+        let stage = self
+            .blur
+            .stage
+            .as_ref()
+            .context("group stage missing")?
+            .srv
+            .clone();
+        for (page, quads) in pages {
+            let target = &self.blur.groups[page];
+            let (rtv, size) = (target.rtv.clone(), (target.width, target.height));
+            self.kernel_instances(&stage, &rtv, size, &quads)?;
+        }
+        self.clear_group_stage()
+    }
+
+    /// Whether a surface can be drawn as an instance of a composite level.
+    pub(super) fn composite_batches(&self, s: &PaintSurface) -> bool {
+        s.group > 0
+            && self
+                .blur
+                .group_slots
+                .get(s.group as usize - 1)
+                .is_some_and(|&slot| slot < self.blur.group_place.len())
+    }
+
+    /// Draw a run of consecutive group composites level by level.
+    pub(super) fn draw_composite_run(&mut self, run: &[&PaintSurface]) -> Result<()> {
+        // KaminIDE patch: composites the tile pass takes are drawn in passes of
+        // one copy and one draw (`group_tiles`); the rest keep the levels.
+        // Segments are drawn in document order, each before the next.
+        let mut k = 0;
+        while k < run.len() {
+            if self.tiles_take(run[k]) {
+                let n = self.draw_composite_tiles(&run[k..])?;
+                if n > 0 {
+                    k += n;
+                    continue;
+                }
+                self.draw_composite_levels_run(&run[k..k + 1])?;
+                k += 1;
+                continue;
+            }
+            let end = k + 1 + run[k + 1..].iter().take_while(|s| !self.tiles_take(s)).count();
+            self.draw_composite_levels_run(&run[k..end])?;
+            k = end;
+        }
+        Ok(())
+    }
+
+    fn draw_composite_levels_run(&mut self, run: &[&PaintSurface]) -> Result<()> {
+        for chunk in run.chunks(MAX_BATCH) {
+            if let [s] = chunk {
+                self.draw_group_composite(s)?;
+                continue;
+            }
+            self.draw_composite_levels(chunk)?;
+        }
+        Ok(())
+    }
+
+    fn draw_composite_levels(&mut self, run: &[&PaintSurface]) -> Result<()> {
+        let device = self.dev().device.clone();
+        let dc = self.dev().device_context.clone();
+        // (instance, atlas page, composite region, mask image key); masked
+        // composites carry their mask rectangle per instance and share a draw
+        // with the composites of the same mask image (the mask cache hands
+        // equal images one view).
+        let mut items = Vec::with_capacity(run.len());
+        let mut masks: Vec<Option<ID3D11ShaderResourceView>> = Vec::new();
+        for s in run {
+            if let Some((mut quad, page)) = self.group_composite_quad(s) {
+                let mask = self
+                    .blur
+                    .group_mask
+                    .get(s.group as usize - 1)
+                    .cloned()
+                    .flatten();
+                let key = match &mask {
+                    Some(([srv], rect, once)) => {
+                        quad.pad2 = [1.0, *once];
+                        quad.mask_rect = *rect;
+                        match masks.iter().position(|m| m == srv) {
+                            Some(k) => k + 1,
+                            None => {
+                                masks.push(srv.clone());
+                                masks.len()
+                            }
+                        }
+                    }
+                    None => 0,
+                };
+                items.push((quad, page, self.composite_region(s), key));
+            }
+        }
+        let rects: Vec<Region> = items.iter().map(|i| i.2).collect();
+        let level = levels(&rects);
+        let top = level.iter().copied().max().unwrap_or(0);
+        self.ensure_blur_globals(&device)?;
+        update_buffer(
+            &dc,
+            self.blur.globals[0].as_ref().unwrap(),
+            &[global_params(self.font_info, [self.width as f32, self.height as f32])],
+        )?;
+        let (premultiplied, replace) = (self.premultiplied_blend()?, self.replace_blend()?);
+        let target = self.current_target().to_vec();
+        let mut quads = Vec::new();
+        for l in 0..=top {
+            let members: Vec<usize> = (0..items.len()).filter(|&i| level[i] == l).collect();
+            let blended: Vec<Region> = members
+                .iter()
+                .filter(|&&i| items[i].0.blend_mode != 0)
+                .map(|&i| items[i].2)
+                .collect();
+            if !blended.is_empty() {
+                self.copy_level_backdrop(&blended)?;
+            }
+            // One draw per (atlas page, blend state, mask image); members are disjoint.
+            let mut keys: Vec<(usize, bool, usize)> = members
+                .iter()
+                .map(|&i| (items[i].1, items[i].0.blend_mode == 0, items[i].3))
+                .collect();
+            keys.sort_unstable();
+            keys.dedup();
+            for (page, normal, mask) in keys {
+                quads.clear();
+                quads.extend(
+                    members
+                        .iter()
+                        .filter(|&&i| {
+                            items[i].1 == page
+                                && (items[i].0.blend_mode == 0) == normal
+                                && items[i].3 == mask
+                        })
+                        .map(|&i| items[i].0),
+                );
+                self.pipelines
+                    .blur_pipeline
+                    .update_buffer(&device, &dc, &quads)?;
+                if mask > 0 {
+                    unsafe { dc.PSSetShaderResources(3, Some(slice::from_ref(&masks[mask - 1]))) };
+                }
+                unsafe { dc.OMSetRenderTargets(Some(&target), None) };
+                self.pipelines.blur_pipeline.draw_with_texture_blended(
+                    &dc,
+                    &self.blur.groups[page].srv,
+                    slice::from_ref(&self.res().viewport),
+                    &self.blur.globals,
+                    slice::from_ref(&self.globals.sampler),
+                    quads.len() as u32,
+                    Some(if normal { &premultiplied } else { &replace }),
+                )?;
+            }
+            if !blended.is_empty() {
+                unsafe { dc.PSSetShaderResources(2, Some(&[None])) };
+            }
+        }
+        Ok(())
+    }
+
+    /// Copy the backdrop under the blended composites of one level into the
+    /// frame-sized level backdrop at the same coordinates: one copy of their
+    /// bounding box when it is compact, otherwise one copy per composite.
+    pub(super) fn copy_level_backdrop(&mut self, rects: &[Region]) -> Result<()> {
+        let device = self.dev().device.clone();
+        let dc = self.dev().device_context.clone();
+        let (w, h) = (self.width, self.height);
+        if self
+            .blur
+            .level_backdrop
+            .as_ref()
+            .is_none_or(|t| t.width != w || t.height != h)
+        {
+            self.blur.level_backdrop = Some(create_blur_texture(&device, w, h, false)?);
+        }
+        let x0 = rects.iter().map(|r| r.x).min().unwrap_or(0);
+        let y0 = rects.iter().map(|r| r.y).min().unwrap_or(0);
+        let x1 = rects.iter().map(|r| r.x + r.width).max().unwrap_or(0);
+        let y1 = rects.iter().map(|r| r.y + r.height).max().unwrap_or(0);
+        let area = |r: &Region| u64::from(r.width) * u64::from(r.height);
+        let union = Region {
+            x: x0,
+            y: y0,
+            width: x1 - x0,
+            height: y1 - y0,
+        };
+        let copies = if 4 * area(&union) <= 5 * rects.iter().map(area).sum::<u64>() {
+            vec![union]
+        } else {
+            rects.to_vec()
+        };
+        let source = self
+            .group_target_tex
+            .as_ref()
+            .or(self.res().render_target.as_ref())
+            .context("render target missing")?;
+        let copy = self.blur.level_backdrop.as_ref().unwrap();
+        unsafe {
+            for r in copies {
+                let area = D3D11_BOX {
+                    left: r.x,
+                    top: r.y,
+                    front: 0,
+                    right: r.x + r.width,
+                    bottom: r.y + r.height,
+                    back: 1,
+                };
+                dc.CopySubresourceRegion(&copy.texture, 0, r.x, r.y, 0, source, 0, Some(&area));
+            }
+            dc.PSSetShaderResources(2, Some(&copy.srv));
+        }
+        Ok(())
+    }
+}
+
+#[cfg(test)]
+mod tests;
diff --git a/vendor/gpui-windows/src/directx_renderer/group_batch/tests.rs b/vendor/gpui-windows/src/directx_renderer/group_batch/tests.rs
