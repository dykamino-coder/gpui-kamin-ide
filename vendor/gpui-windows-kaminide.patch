diff --git a/vendor/gpui-windows/src/frame_request.rs b/vendor/gpui-windows/src/frame_request.rs
new file mode 100644
index 0000000000000000000000000000000000000000..0d21c5086c5c0e40a36c632249cf4d537739ccda
--- /dev/null
+++ b/vendor/gpui-windows/src/frame_request.rs
@@ -0,0 +1,141 @@
+//! Спрос на кадр Windows и защита общего UI-потока от вложенной отрисовки.
+
+use std::{cell::Cell, rc::Rc, sync::atomic::{AtomicBool, Ordering}};
+use gpui_util::ResultExt;
+use windows::Win32::Foundation::{HWND, LPARAM, WPARAM};
+use windows::Win32::Graphics::Gdi::{RedrawWindow, RDW_INVALIDATE};
+use windows::Win32::UI::WindowsAndMessaging::PostMessageW;
+use crate::WindowsWindowInner;
+
+/// Coordinates window draws on the UI thread. Owned by the platform and
+/// shared with every window (like `WindowsPlatformState::cursor_visible`),
+/// because the coordination is inherently cross-window: while window A is
+/// drawing, a re-entrant paint request for window B must be deferred.
+pub(crate) struct DrawCoordinator {
+    /// Whether some window is currently inside `draw_window`. Win32 can
+    /// re-enter the window procedure while a draw is in progress (e.g.
+    /// cross-thread `SendMessage` dispatch during message pumping, or modal
+    /// message loops entered by COM calls), and drawing re-entrantly would
+    /// nest GPUI draws. Nested draws are wasted work whose output is
+    /// immediately redrawn, so we defer them instead.
+    drawing: Cell<bool>,
+}
+
+impl DrawCoordinator {
+    pub(crate) fn new() -> Self {
+        Self {
+            drawing: Cell::new(false),
+        }
+    }
+
+    pub(crate) fn try_begin_draw(&self) -> Option<DrawWindowGuard<'_>> {
+        // This only covers the `draw_window` span (which extends past the GPUI
+        // draw, through presentation and IME updates). Requests that arrive
+        // re-entrantly during GPUI-initiated draws (e.g. key dispatch or
+        // opening a window draws synchronously) are deferred by GPUI's
+        // `on_request_frame` callback itself, which no-ops in that case.
+        if self.drawing.get() {
+            None
+        } else {
+            self.drawing.set(true);
+            Some(DrawWindowGuard { coordinator: self })
+        }
+    }
+}
+
+pub(crate) struct DrawWindowGuard<'a> {
+    coordinator: &'a DrawCoordinator,
+}
+
+impl Drop for DrawWindowGuard<'_> {
+    fn drop(&mut self) {
+        self.coordinator.drawing.set(false);
+    }
+}
+
+impl DrawCoordinator {
+    // Запрос из отрисовки обслуживает vsync: немедленный повтор обходил бы
+    // ограничение частоты анимаций и создавал цикл при throttling.
+    fn wake_if_idle(&self, wake: impl FnOnce()) {
+        if !self.drawing.get() {
+            wake();
+        }
+    }
+}
+
+impl WindowsWindowInner {
+    pub(crate) fn frame_waker(self: &Rc<Self>) -> Rc<dyn Fn()> {
+        let window = Rc::downgrade(self);
+        Rc::new(move || {
+            if let Some(window) = window.upgrade() {
+                window.state.draw_coordinator.wake_if_idle(|| {
+                    // KaminIDE patch: message-only окно не получает WM_PAINT.
+                    if let Some(pending) = &window.state.offscreen_paint {
+                        post_offscreen_paint(window.hwnd, pending);
+                        return;
+                    }
+                    // Без UPDATENOW: WM_PAINT объединяет запросы и не входит в App
+                    // синхронно из invalidate_view/set_dirty.
+                    unsafe { RedrawWindow(Some(window.hwnd), None, None, RDW_INVALIDATE) }
+                        .ok().log_err();
+                });
+            }
+        })
+    }
+}
+
+/// KaminIDE patch: the offscreen counterpart of an invalidated update region.
+/// At most one paint message is queued per window, like a pending WM_PAINT;
+/// the window clears `pending` when it handles the message.
+pub(crate) fn post_offscreen_paint(hwnd: HWND, pending: &AtomicBool) {
+    if take_offscreen_slot(pending) {
+        let posted = unsafe {
+            PostMessageW(Some(hwnd), crate::events::WM_GPUI_OFFSCREEN_PAINT, WPARAM(0), LPARAM(0))
+        };
+        if posted.log_err().is_none() {
+            pending.store(false, Ordering::Release);
+        }
+    }
+}
+
+fn take_offscreen_slot(pending: &AtomicBool) -> bool {
+    !pending.swap(true, Ordering::AcqRel)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn offscreen_paint_requests_coalesce_until_handled() {
+        let pending = AtomicBool::new(false);
+        assert!(take_offscreen_slot(&pending));
+        assert!(!take_offscreen_slot(&pending));
+        assert!(!take_offscreen_slot(&pending));
+        pending.store(false, Ordering::Release);
+        assert!(take_offscreen_slot(&pending));
+    }
+
+    #[test]
+    fn idle_demand_wakes_without_entering_a_draw() {
+        let coordinator = DrawCoordinator::new();
+        let wakes = Cell::new(0);
+        coordinator.wake_if_idle(|| wakes.set(wakes.get() + 1));
+        assert_eq!(wakes.get(), 1);
+        assert!(coordinator.try_begin_draw().is_some());
+    }
+
+    #[test]
+    fn nested_demand_waits_for_vsync_and_guard_restores_idle_waking() {
+        let coordinator = DrawCoordinator::new();
+        let wakes = Cell::new(0);
+        let guard = coordinator.try_begin_draw().unwrap();
+        assert!(coordinator.try_begin_draw().is_none());
+        coordinator.wake_if_idle(|| wakes.set(wakes.get() + 1));
+        assert_eq!(wakes.get(), 0);
+        drop(guard);
+        coordinator.wake_if_idle(|| wakes.set(wakes.get() + 1));
+        assert_eq!(wakes.get(), 1);
+        assert!(coordinator.try_begin_draw().is_some());
+    }
+}
diff --git a/vendor/gpui-windows/src/gpu_adapter.rs b/vendor/gpui-windows/src/gpu_adapter.rs
new file mode 100644
index 0000000000000000000000000000000000000000..bc487d83d104f0ed3fb337bec6341bd4e3a6fb2d
--- /dev/null
+++ b/vendor/gpui-windows/src/gpu_adapter.rs
@@ -0,0 +1,193 @@
+//! KaminIDE patch: явный выбор DXGI-адаптера и сведения о реальном устройстве.
+
+use anyhow::{Context, Result, bail};
+use windows::{
+    Win32::Graphics::Dxgi::{
+        CreateDXGIFactory2, DXGI_ADAPTER_FLAG_SOFTWARE, DXGI_CREATE_FACTORY_FLAGS, DXGI_ERROR_NOT_FOUND,
+        DXGI_GPU_PREFERENCE_HIGH_PERFORMANCE, DXGI_GPU_PREFERENCE_MINIMUM_POWER,
+        IDXGIAdapter1, IDXGIDevice, IDXGIFactory6,
+    },
+    core::Interface,
+};
+
+/// Device creation policy. `Default` retains the original EnumAdapters order.
+#[derive(Clone, Debug, Default, PartialEq, Eq)]
+pub enum GpuAdapterPreference {
+    #[default]
+    Default,
+    HighPerformance,
+    MinimumPower,
+    ByName(String),
+    ByLuid { high_part: i32, low_part: u32 },
+    /// KaminIDE patch: the software rasterizer (WARP), for measuring software rendering in
+    /// optimized builds. No selector string parses to it: a host constructs it on purpose.
+    Software,
+}
+
+impl GpuAdapterPreference {
+    /// Reserved power policies or a case-insensitive device-name substring.
+    pub fn parse(value: &str) -> Result<Self> {
+        Ok(match value {
+            "default" => Self::Default,
+            "high-performance" => Self::HighPerformance,
+            "minimum-power" => Self::MinimumPower,
+            value if value.starts_with("luid:") => {
+                let (high, low) = value[5..].split_once(':').context("Expected luid:HHHHHHHH:LLLLLLLL")?;
+                Self::ByLuid {
+                    high_part: u32::from_str_radix(high, 16).context("Invalid LUID high part")? as i32,
+                    low_part: u32::from_str_radix(low, 16).context("Invalid LUID low part")?,
+                }
+            }
+            value if !value.trim().is_empty() => Self::ByName(value.to_lowercase()),
+            _ => bail!("GPU name substring must not be empty"),
+        })
+    }
+}
+
+/// Identity queried from an actual DXGI adapter, rather than the requested policy.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct GpuAdapterInfo {
+    pub device_name: String,
+    pub luid_high_part: i32,
+    pub luid_low_part: u32,
+    pub driver_version: String,
+    pub vendor_id: u32,
+    pub device_id: u32,
+}
+
+impl GpuAdapterInfo {
+    pub(crate) fn read(adapter: &IDXGIAdapter1) -> Result<Self> {
+        // The COM adapter is alive; both calls return owned values.
+        let desc = unsafe { adapter.GetDesc1()? };
+        Ok(Self {
+            device_name: String::from_utf16_lossy(&desc.Description)
+                .trim_end_matches('\0').to_owned(),
+            luid_high_part: desc.AdapterLuid.HighPart,
+            luid_low_part: desc.AdapterLuid.LowPart,
+            driver_version: driver_version(adapter)?,
+            vendor_id: desc.VendorId,
+            device_id: desc.DeviceId,
+        })
+    }
+}
+
+/// Enumerates hardware identities without creating an application or D3D device.
+pub fn gpu_adapters(preference: &GpuAdapterPreference) -> Result<Vec<GpuAdapterInfo>> {
+    let factory: IDXGIFactory6 = unsafe { CreateDXGIFactory2(DXGI_CREATE_FACTORY_FLAGS::default())? };
+    adapters(&factory, preference)?.iter().map(GpuAdapterInfo::read).collect()
+}
+
+pub(crate) fn adapters(
+    factory: &IDXGIFactory6,
+    preference: &GpuAdapterPreference,
+) -> Result<Vec<IDXGIAdapter1>> {
+    if *preference == GpuAdapterPreference::Software {
+        return Ok(vec![unsafe { factory.EnumWarpAdapter()? }]);
+    }
+    let power = match preference {
+        GpuAdapterPreference::HighPerformance => Some(DXGI_GPU_PREFERENCE_HIGH_PERFORMANCE),
+        GpuAdapterPreference::MinimumPower => Some(DXGI_GPU_PREFERENCE_MINIMUM_POWER),
+        _ => None,
+    };
+    let enumerated = enumerate(|index| {
+        if let Some(power) = power {
+            unsafe { factory.EnumAdapterByGpuPreference::<IDXGIAdapter1>(index, power) }
+        } else {
+            unsafe { factory.EnumAdapters(index).and_then(|adapter| adapter.cast()) }
+        }
+    })?;
+    let mut found = Vec::new();
+    for adapter in enumerated {
+        let desc = unsafe { adapter.GetDesc1()? };
+        if desc.Flags & DXGI_ADAPTER_FLAG_SOFTWARE.0 as u32 == 0 { found.push(adapter); }
+    }
+    if matches!(preference, GpuAdapterPreference::ByName(_) | GpuAdapterPreference::ByLuid { .. }) {
+        let mut matching = Vec::new();
+        for adapter in found {
+            let matches = matches_identity(preference, &GpuAdapterInfo::read(&adapter)?);
+            if matches { matching.push(adapter); }
+        }
+        require_unique(preference, matching.len())?;
+        return Ok(matching);
+    }
+    Ok(found)
+}
+
+// KaminIDE patch: только NOT_FOUND завершает список; ошибка power enumeration не включает fallback.
+fn enumerate<T>(mut next: impl FnMut(u32) -> windows::core::Result<T>) -> Result<Vec<T>> {
+    let mut found = Vec::new();
+    for index in 0.. {
+        match next(index) {
+            Ok(adapter) => found.push(adapter),
+            Err(error) if error.code() == DXGI_ERROR_NOT_FOUND => return Ok(found),
+            Err(error) => return Err(error.into()),
+        }
+    }
+    unreachable!("DXGI adapter index exhausted")
+}
+
+pub(crate) fn selected_adapter(
+    factory: &IDXGIFactory6,
+    preference: &GpuAdapterPreference,
+) -> Result<IDXGIAdapter1> {
+    adapters(factory, preference)?.into_iter().next().context("No matching DXGI adapter")
+}
+
+
+// KaminIDE patch: shared DXGI driver identity, moved unchanged from the renderer.
+pub(crate) fn driver_version(adapter: &IDXGIAdapter1) -> anyhow::Result<String> {
+    let number = unsafe { adapter.CheckInterfaceSupport(&IDXGIDevice::IID as _) }?;
+    Ok(format!(
+        "{}.{}.{}.{}",
+        number >> 48,
+        (number >> 32) & 0xFFFF,
+        (number >> 16) & 0xFFFF,
+        number & 0xFFFF
+    ))
+}
+
+fn matches_identity(preference: &GpuAdapterPreference, info: &GpuAdapterInfo) -> bool {
+    match preference {
+        GpuAdapterPreference::ByName(name) => info.device_name.to_lowercase().contains(&name.to_lowercase()),
+        GpuAdapterPreference::ByLuid { high_part, low_part } => info.luid_high_part == *high_part && info.luid_low_part == *low_part,
+        _ => false,
+    }
+}
+
+fn require_unique(preference: &GpuAdapterPreference, count: usize) -> Result<()> {
+    if count != 1 { bail!("GPU selector {preference:?} matched {count} adapters; expected exactly one"); }
+    Ok(())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn enumeration_errors_do_not_become_partial_success_or_fallback() {
+        let mut calls = 0;
+        let result = enumerate(|index| {
+            calls += 1;
+            if index == 0 { Ok(42) } else { Err(windows::core::Error::from_hresult(windows::Win32::Foundation::E_FAIL)) }
+        });
+        assert!(result.is_err());
+        assert_eq!(calls, 2);
+        let result = enumerate::<u32>(|_| Err(windows::core::Error::from_hresult(DXGI_ERROR_NOT_FOUND)));
+        assert!(result.unwrap().is_empty());
+    }
+    #[test]
+    fn selectors_are_exact_and_ambiguous_names_fail() {
+        let info = GpuAdapterInfo { device_name: "Intel GPU".into(), luid_high_part: -1,
+            luid_low_part: 42, driver_version: "1".into(), vendor_id: 1, device_id: 2 };
+        assert!(matches_identity(&GpuAdapterPreference::ByName("INTEL".into()), &info));
+        assert!(matches_identity(&GpuAdapterPreference::ByLuid { high_part: -1, low_part: 42 }, &info));
+        assert!(!matches_identity(&GpuAdapterPreference::ByLuid { high_part: 0, low_part: 42 }, &info));
+        for count in [0, 2] { assert!(require_unique(&GpuAdapterPreference::ByName("GPU".into()), count).is_err()); }
+        assert!(require_unique(&GpuAdapterPreference::MinimumPower, 1).is_ok());
+    }
+    #[test]
+    fn no_selector_string_selects_the_software_rasterizer() {
+        for name in ["software", "warp", "Software", "WARP"] {
+            assert_eq!(GpuAdapterPreference::parse(name).unwrap(), GpuAdapterPreference::ByName(name.to_lowercase()));
+        }
+    }
+}
diff --git a/vendor/gpui-windows/src/gpu_context.rs b/vendor/gpui-windows/src/gpu_context.rs
new file mode 100644
index 0000000000000000000000000000000000000000..3789429d36b5dff0da48cbfe38aab6a50469397e
--- /dev/null
+++ b/vendor/gpui-windows/src/gpu_context.rs
@@ -0,0 +1,91 @@
+//! KaminIDE patch: фактический D3D device context и проверка строгого выбора.
+
+use anyhow::{Result, bail};
+use gpui::frame_capture::GpuDeviceContext;
+use windows::{Win32::Graphics::{Direct3D11::ID3D11Device, Dxgi::{IDXGIAdapter1, IDXGIDevice}}, core::Interface};
+use crate::{GpuAdapterInfo, GpuAdapterPreference};
+
+pub(crate) fn validate_mode(preference: &GpuAdapterPreference, mode: gpui::DebugDevice) -> Result<()> {
+    if *preference != GpuAdapterPreference::Default && mode != gpui::DebugDevice::Default {
+        bail!("Explicit hardware GPU selection conflicts with {mode:?}; select default for this backend");
+    }
+    Ok(())
+}
+
+pub(crate) fn read(device: &ID3D11Device, generation: u64, factory_debug: bool, mode: gpui::DebugDevice) -> Result<GpuDeviceContext> {
+    let dxgi: IDXGIDevice = device.cast()?;
+    let adapter: IDXGIAdapter1 = unsafe { dxgi.GetAdapter()?.cast()? };
+    let info = GpuAdapterInfo::read(&adapter)?;
+    let desc = unsafe { adapter.GetDesc1()? };
+    Ok(GpuDeviceContext {
+        luid_high_part: info.luid_high_part, luid_low_part: info.luid_low_part,
+        device_name: info.device_name, vendor_id: info.vendor_id, device_id: info.device_id,
+        subsystem_id: desc.SubSysId, revision: desc.Revision, adapter_flags: desc.Flags,
+        driver_version: info.driver_version, feature_level: unsafe { device.GetFeatureLevel().0 as u32 },
+        creation_flags: unsafe { device.GetCreationFlags() }, factory_debug,
+        backend: match mode { gpui::DebugDevice::Default => "d3d11", gpui::DebugDevice::Warp => "warp", gpui::DebugDevice::D3D11On12 => "d3d11on12" }.into(),
+        generation, queried_from_device: true,
+    })
+}
+
+pub(crate) fn pin(preference: &GpuAdapterPreference, context: &GpuDeviceContext) -> Result<GpuAdapterPreference> {
+    if *preference == GpuAdapterPreference::Default { return Ok(preference.clone()); }
+    if *preference == GpuAdapterPreference::Software {
+        if context.adapter_flags & 2 == 0 { bail!("Software GPU selection produced a hardware device"); }
+        return Ok(preference.clone());
+    }
+    if context.adapter_flags & 2 != 0 { bail!("Explicit GPU selection produced a software device"); }
+    let actual = GpuAdapterPreference::ByLuid { high_part: context.luid_high_part, low_part: context.luid_low_part };
+    if matches!(preference, GpuAdapterPreference::ByLuid { .. }) && *preference != actual {
+        bail!("Requested GPU {preference:?} differs from actual device {actual:?}");
+    }
+    Ok(actual)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn rejects_conflicting_backend_before_device_creation() {
+        for mode in [gpui::DebugDevice::Warp, gpui::DebugDevice::D3D11On12] {
+            assert!(validate_mode(&GpuAdapterPreference::MinimumPower, mode).is_err());
+            assert!(validate_mode(&GpuAdapterPreference::Default, mode).is_ok());
+        }
+    }
+    #[test]
+    fn parses_luid_without_losing_signed_high_part() {
+        assert_eq!(GpuAdapterPreference::parse("luid:FFFFFFFF:000150BD").unwrap(), GpuAdapterPreference::ByLuid { high_part: -1, low_part: 86205 });
+        for bad in ["luid:", "luid:x:0", "luid:0:100000000", ""] { assert!(GpuAdapterPreference::parse(bad).is_err()); }
+    }
+    fn hardware() -> GpuDeviceContext {
+        GpuDeviceContext { luid_high_part: 0, luid_low_part: 17, device_name: "GPU".into(),
+            vendor_id: 0x8086, device_id: 1, subsystem_id: 0, revision: 0, adapter_flags: 0,
+            driver_version: "1.2.3.4".into(), feature_level: 0xb100, creation_flags: 0x22,
+            factory_debug: true, backend: "d3d11".into(), generation: 1, queried_from_device: true }
+    }
+    #[test]
+    fn power_selection_pins_actual_hardware_for_recovery() {
+        let mut context = hardware();
+        let luid = GpuAdapterPreference::ByLuid { high_part: 0, low_part: 17 };
+        assert_eq!(pin(&GpuAdapterPreference::MinimumPower, &context).unwrap(), luid);
+        assert!(pin(&luid, &context).is_ok());
+        let captured = context.clone();
+        context.generation += 1;
+        context.luid_low_part += 1;
+        assert!(pin(&luid, &context).is_err());
+        assert_eq!(captured.generation, 1);
+        assert_eq!(captured.luid_low_part, 17);
+        context.adapter_flags = 2;
+        assert!(pin(&GpuAdapterPreference::MinimumPower, &context).is_err());
+        assert_eq!(pin(&GpuAdapterPreference::Default, &context).unwrap(), GpuAdapterPreference::Default);
+    }
+    #[test]
+    fn software_selection_accepts_only_a_software_device() {
+        let mut context = hardware();
+        assert!(pin(&GpuAdapterPreference::Software, &context).is_err());
+        context.adapter_flags = 2;
+        assert_eq!(pin(&GpuAdapterPreference::Software, &context).unwrap(), GpuAdapterPreference::Software);
+        assert!(validate_mode(&GpuAdapterPreference::Software, gpui::DebugDevice::Warp).is_err());
+    }
+
+}
