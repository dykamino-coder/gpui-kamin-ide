+/// KaminIDE patch: PostScript-имя грани — ключ физической грани (у
+/// синтетических bold/oblique оно то же) и признак тестового шрифта Ahem.
+/// upstream убрал эту функцию вместе с `FontIdentifier`.
+fn get_postscript_name(font_face: &IDWriteFontFace3, locale: &HSTRING) -> Result<String> {
+    let mut info = None;
+    let mut exists = BOOL(0);
+    unsafe {
+        font_face.GetInformationalStrings(
+            DWRITE_INFORMATIONAL_STRING_POSTSCRIPT_NAME,
+            &mut info,
+            &mut exists,
+        )?
+    };
+    let Some(info) = info.filter(|_| exists.as_bool()) else {
+        anyhow::bail!("No postscript name found for font face");
+    };
+    get_name(info, locale)
+}
