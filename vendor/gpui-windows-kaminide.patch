+        blur_down_pass(
+            &device,
+            &dc,
+            &mut self.pipelines.blur_pipeline,
+            &self.blur.globals,
+            slice::from_ref(&self.globals.sampler),
+            self.font_info,
+            &self.blur.down[0],
+            src,
+            src_size,
+            [bx / src_size.0, by / src_size.1],
+            [rw / src_size.0, rh / src_size.1],
+            keep_alpha,
+            blend.as_ref(),
+        )?;
