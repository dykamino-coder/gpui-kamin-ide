index 0000000000000000000000000000000000000000..adabf8ae96b464b5b0368228853b444bf93668f3
--- /dev/null
+++ b/vendor/gpui-windows/src/directx_renderer/recovery_tests/damage/paths.rs
@@ -0,0 +1,125 @@
+//! KaminIDE patch: path batches redrawn within a rectangle (`path_pass`): a
+//! batch that misses the rectangle leaves its intermediate untouched, and the
+//! frame holds byte for byte what a whole redraw of it draws.
+
+use super::*;
+use gpui::{Path, Pixels, px};
+
+/// A closed shape with a curved edge, `side` pixels wide, at (`x`, `y`).
+fn shape(x: f32, y: f32, side: f32, order: u32, color: Hsla) -> Path<ScaledPixels> {
+    let at = |dx: f32, dy: f32| point(px(x + dx), px(y + dy));
+    let mut p = Path::<Pixels>::new(at(0., 0.));
+    p.line_to(at(side, 0.));
+    p.curve_to(at(side, side), at(side * 1.3, side * 0.5));
+    p.line_to(at(0., side));
+    p.line_to(at(0., 0.));
+    p.color = Background::from(color);
+    p.content_mask = ContentMask {
+        bounds: Bounds {
+            origin: point(px(0.), px(0.)),
+            size: size(px(W as f32), px(H as f32)),
+        },
+    };
+    let mut p = p.scale(1.);
+    p.order = order;
+    p
+}
+
+/// What a frame paints: quads under and between two path batches. Edits
+/// change `color`, the quad at the top right, or move the second path.
+#[derive(Clone, Copy)]
+struct Spec {
+    color: Hsla,
+    second_x: f32,
+}
+
+impl Spec {
+    fn scene(self) -> Scene {
+        let mut s = Scene::default();
+        for (r, c, order) in [
+            ([0., 0., W as f32, H as f32], hsla(0., 0., 1., 1.), 1),
+            ([60., 30., 40., 40.], hsla(0.3, 0.8, 0.5, 0.7), 3),
+            ([200., 20., 30., 30.], self.color, 5),
+        ] {
+            let mut q = quad(r, c);
+            q.order = order;
+            s.quads.push(q);
+        }
+        s.paths
+            .push(shape(10., 10., 50., 2, hsla(0.6, 0.8, 0.4, 0.8)));
+        s.paths
+            .push(shape(self.second_x, 100., 40., 4, hsla(0.0, 0.8, 0.5, 1.)));
+        s
+    }
+}
+
+/// Draw `frames` in sequence; the target after the last one and the
+/// `[gpu]` line of the last one.
+fn chain(device: &DirectXDevices, frames: &[Spec]) -> (Vec<u8>, String) {
+    let mut r = offscreen(device, W, H);
+    let mut previous = Scene::default();
+    let mut line = String::new();
+    for (i, f) in frames.iter().enumerate() {
+        let mut s = f.scene();
+        s.note_frame_damage(&previous, i as u64 + 1, (W, H));
+        let _ = r.gpu_timer.instrumentation.batches.take_line();
+        r.draw(&s, WindowBackgroundAppearance::Opaque).unwrap();
+        line = r
+            .gpu_timer
+            .instrumentation
+            .batches
+            .take_line()
+            .unwrap_or_default();
+        previous = s;
+    }
+    (target_bytes(&mut r), line)
+}
+
+const BASE: Spec = Spec {
+    color: Hsla {
+        h: 0.1,
+        s: 0.8,
+        l: 0.5,
+        a: 1.,
+    },
+    second_x: 120.,
+};
+
+#[test]
+fn a_rectangle_away_from_the_paths_skips_their_batches_and_equals_the_whole_frame() {
+    let device = DirectXDevices::new().unwrap();
+    let edit = Spec {
+        color: hsla(0.6, 0.9, 0.5, 1.),
+        ..BASE
+    };
+    let (got, line) = chain(&device, &[BASE, edit]);
+    let (want, whole) = chain(&device, &[edit]);
+    assert!(line.contains("within=1"), "{line}");
+    assert!(
+        line.contains("b=2 mid_kpx=0"),
+        "both path batches skipped: {line}"
+    );
+    assert!(
+        !whole.contains("mid_kpx=0"),
+        "the whole frame draws the paths: {whole}"
+    );
+    assert!(got == want, "{} pixels differ", differing(&got, &want));
+}
+
+#[test]
+fn a_rectangle_across_a_path_redraws_its_part_and_equals_the_whole_frame() {
+    let device = DirectXDevices::new().unwrap();
+    // The edit moves the second path; its old and new places are the damage.
+    let moved = Spec {
+        second_x: 127.,
+        ..BASE
+    };
+    let (got, line) = chain(&device, &[BASE, moved]);
+    let (want, _) = chain(&device, &[moved]);
+    assert!(line.contains("within=1"), "{line}");
+    assert!(
+        !line.contains("mid_kpx=0"),
+        "the moved path is drawn: {line}"
+    );
+    assert!(got == want, "{} pixels differ", differing(&got, &want));
+}
diff --git a/vendor/gpui-windows/src/directx_renderer/recovery_tests/damage/sprites.rs b/vendor/gpui-windows/src/directx_renderer/recovery_tests/damage/sprites.rs
new file mode 100644
index 0000000000000000000000000000000000000000..471a92f6e3f150724901d92d2e6e1b322c26195b
--- /dev/null
+++ b/vendor/gpui-windows/src/directx_renderer/recovery_tests/damage/sprites.rs
@@ -0,0 +1,144 @@
+//! KaminIDE patch: a colour sprite draws the same pixels wherever the atlas
+//! holds its tile. A frame after an edit lays the atlas out anew, so a
+//! sampler that resolved normalized atlas coordinates gave a rotated or scaled
+//! image other filter weights there and the frame differed from a fresh one.
+
+use super::*;
+use gpui::{
+    AtlasKey, AtlasTile, Bounds, ContentMask, PlatformAtlas, Point,
+    PolychromeSprite, Radians, RenderImageParams, ScaledPixels, TransformationMatrix,
+};
+use std::borrow::Cow;
+
+const W: i32 = 23;
+const H: i32 = 17;
+
+/// A premultiplied BGRA image whose every texel differs from its neighbours.
+fn texels() -> Vec<u8> {
+    let mut out = Vec::with_capacity((W * H * 4) as usize);
+    for y in 0..H {
+        for x in 0..W {
+            let a = (128 + (x * 5 + y * 3) % 128) as u8;
+            let c = |k: i32| ((x * k + y * (k + 7)) % i32::from(a)) as u8;
+            out.extend_from_slice(&[c(11), c(29), c(53), a]);
+        }
+    }
+    out
+}
+
+fn insert(r: &DirectXRenderer, id: usize, w: i32, h: i32, bytes: Vec<u8>) -> AtlasTile {
+    let size = Size { width: DevicePixels(w), height: DevicePixels(h) };
+    let key = AtlasKey::Image(RenderImageParams { image_id: ImageId(id), frame_index: 0 });
+    let mut bytes = Some(bytes);
+    r.atlas
+        .get_or_insert_with(key, &mut || Ok(Some((size, Cow::Owned(bytes.take().unwrap())))))
+        .unwrap()
+        .unwrap()
+}
+
+fn scaled(x: f32, y: f32, w: f32, h: f32) -> Bounds<ScaledPixels> {
+    Bounds {
+        origin: Point { x: ScaledPixels(x), y: ScaledPixels(y) },
+        size: Size { width: ScaledPixels(w), height: ScaledPixels(h) },
+    }
+}
+
+/// The image drawn rotated and scaled, and once 1:1 on the device grid.
+fn frame(r: &mut DirectXRenderer, tile: AtlasTile) -> Vec<u8> {
+    let mut scene = Scene::default();
+    let turn = TransformationMatrix::unit()
+        .translate(Point { x: ScaledPixels(30.0), y: ScaledPixels(22.0) })
+        .rotate(Radians(0.37))
+        .translate(Point { x: ScaledPixels(-30.0), y: ScaledPixels(-22.0) });
+    for (bounds, transformation) in [
+        (scaled(12.3, 9.6, 41.5, 29.0), turn),
+        (scaled(4.0, 40.0, W as f32, H as f32), TransformationMatrix::unit()),
+    ] {
+        scene.insert_primitive(PolychromeSprite {
+            pattern: gpui::Size::default(),
+            order: 0,
+            pad: 0,
+            grayscale: false.into(),
+            opacity: 1.0,
+            bounds,
+            content_mask: ContentMask { bounds: scaled(0.0, 0.0, 64.0, 64.0) },
+            corner_radii: Default::default(),
+            tile,
+            transformation,
+        });
+    }
+    scene.finish();
+    r.render_to_image(&scene, WindowBackgroundAppearance::Opaque).unwrap().into_raw()
+}
+
+/// A grid of `cells` (columns, rows) of `cell`-sized copies of the image
+/// from (3, 2): one repeated sprite or one sprite per cell.
+fn grid(r: &mut DirectXRenderer, tile: AtlasTile, cell: (f32, f32), pad: u32, one: bool) -> Vec<u8> {
+    let (cells, at) = ((3u8, 2u8), (3.0, 2.0));
+    let sprite = |bounds, pattern| PolychromeSprite {
+        pattern,
+        order: 0,
+        pad,
+        grayscale: false.into(),
+        opacity: 1.0,
+        bounds,
+        content_mask: ContentMask { bounds: scaled(0.0, 0.0, 64.0, 64.0) },
+        corner_radii: Default::default(),
+        tile,
+        transformation: TransformationMatrix::unit(),
+    };
+    let mut scene = Scene::default();
+    if one {
+        let (w, h) = (cell.0 * f32::from(cells.0), cell.1 * f32::from(cells.1));
+        let step = Size { width: ScaledPixels(cell.0), height: ScaledPixels(cell.1) };
+        scene.insert_primitive(sprite(scaled(at.0, at.1, w, h), step));
+    } else {
+        for j in 0..cells.1 {
+            for i in 0..cells.0 {
+                let (x, y) = (at.0 + cell.0 * f32::from(i), at.1 + cell.1 * f32::from(j));
+                scene.insert_primitive(sprite(scaled(x, y, cell.0, cell.1), Size::default()));
+            }
+        }
+    }
+    scene.finish();
+    r.render_to_image(&scene, WindowBackgroundAppearance::Opaque).unwrap().into_raw()
+}
+
+/// A repeated sprite draws each cell exactly as that cell's own sprite:
+/// 1:1, scaled with bilinear weights, and nearest.
+#[test]
+fn a_repeated_sprite_draws_every_cell_as_its_own_sprite() {
+    use crate::GpuAdapterPreference as P;
+    for (p, name) in [(P::Default, "default"), (P::Software, "software")] {
+        let Ok(device) = DirectXDevices::with_instrumentation(p, gpui::Instrumentation::default()) else {
+            continue;
+        };
+        let mut r = offscreen(&device, 64, 64);
+        let tile = insert(&r, 1, W, H, texels());
+        for (cell, pad) in [((W as f32, H as f32), 0), ((19.0, 13.0), 0), ((19.0, 13.0), 1)] {
+            let (a, b) = (grid(&mut r, tile, cell, pad, true), grid(&mut r, tile, cell, pad, false));
+            let differ = a.chunks(4).zip(b.chunks(4)).filter(|(x, y)| x != y).count();
+            assert_eq!(differ, 0, "{name} {cell:?} pad {pad}: {differ} pixels differ");
+        }
+    }
+}
+
+#[test]
+fn a_colour_sprite_draws_the_same_pixels_at_any_atlas_place() {
+    use crate::GpuAdapterPreference as P;
+    for (p, name) in [(P::Default, "default"), (P::Software, "software")] {
+        let Ok(device) = DirectXDevices::with_instrumentation(p, gpui::Instrumentation::default()) else {
+            continue;
+        };
+        let mut first = offscreen(&device, 64, 64);
+        let a = insert(&first, 1, W, H, texels());
+        let mut second = offscreen(&device, 64, 64);
+        // Another image first: the same image lands elsewhere in the atlas.
+        insert(&second, 2, 37, 29, vec![255; 37 * 29 * 4]);
+        let b = insert(&second, 1, W, H, texels());
+        assert_ne!(a.bounds.origin, b.bounds.origin, "{name}: the layouts must differ");
+        let (fa, fb) = (frame(&mut first, a), frame(&mut second, b));
+        let differ = fa.chunks(4).zip(fb.chunks(4)).filter(|(x, y)| x != y).count();
+        assert_eq!(differ, 0, "{name}: {differ} pixels depend on the atlas place");
+    }
+}
diff --git a/vendor/gpui-windows/src/directx_renderer/recovery_tests/damage/tiles.rs b/vendor/gpui-windows/src/directx_renderer/recovery_tests/damage/tiles.rs
