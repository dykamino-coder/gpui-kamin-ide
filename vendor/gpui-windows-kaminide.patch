+            &device,
+            &dc,
+            &mut self.pipelines.blur_pipeline,
+            &self.blur.globals,
+            slice::from_ref(&self.globals.sampler),
+            self.font_info,
+            &b[0],
+            &a[0].srv,
+            (a[0].width as f32, a[0].height as f32),
+            [0.0, 0.0],
+            [1.0, 1.0],
+            keep_alpha,
+            blend.as_ref(),
+        )?;
+        blur_down_pass(
+            &device,
+            &dc,
+            &mut self.pipelines.blur_pipeline,
+            &self.blur.globals,
+            slice::from_ref(&self.globals.sampler),
+            self.font_info,
+            &b[1],
+            &b[0].srv,
+            (b[0].width as f32, b[0].height as f32),
+            [0.0, 0.0],
+            [1.0, 1.0],
+            keep_alpha,
+            blend.as_ref(),
+        )
+    }
