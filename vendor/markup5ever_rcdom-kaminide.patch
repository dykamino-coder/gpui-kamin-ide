+//! Selectedcontent cloning is iterative and propagates every storage refusal.
+
+use super::{reserve, Admission, Work};
+use crate::{append, Handle, Node, NodeData, RcDom};
+use std::{cell::RefCell, mem, rc::Rc};
+use xml5ever::{interface::ElemName, local_name};
+
+impl Node {
+    pub(crate) fn try_nearest_select<A: Admission>(
+        &self,
+        policy: &A,
+    ) -> Result<Option<Handle>, A::Error> {
+        let mut in_group = false;
+        let mut current = self.parent().and_then(|parent| parent.upgrade());
+        while let Some(node) = current {
+            policy.visit()?;
+            if let NodeData::Element { name, .. } = &node.data {
+                if matches!(
+                    name.local_name(),
+                    &local_name!("datalist") | &local_name!("hr") | &local_name!("option")
+                ) {
+                    return Ok(None);
+                }
+                if name.local_name() == &local_name!("optgroup") {
+                    if in_group {
+                        return Ok(None);
+                    }
+                    in_group = true;
+                }
+                if name.local_name() == &local_name!("select") {
+                    return Ok(Some(node));
+                }
+            }
+            current = node.parent().and_then(|parent| parent.upgrade());
+        }
+        Ok(None)
+    }
+
+    pub(crate) fn try_selectedcontent<A: Admission>(
+        &self,
+        policy: &A,
+    ) -> Result<Option<Handle>, A::Error> {
+        let NodeData::Element { attrs, .. } = &self.data else {
+            panic!("not an element");
+        };
+        for attr in attrs.borrow().iter() {
+            policy.visit()?;
+            if attr.name.local == local_name!("multiple") {
+                return Ok(None);
+            }
+        }
+        let mut remaining = Work::new();
+        for child in self.children.borrow().iter().rev() {
+            policy.visit()?;
+            remaining.push(child.clone(), policy)?;
+        }
+        while let Some(node) = remaining.pop() {
+            policy.visit()?;
+            if let NodeData::Element { name, .. } = &node.data {
+                if name.local_name() == &local_name!("selectedcontent") {
+                    return Ok(Some(node));
+                }
+            }
+            for child in node.children.borrow().iter().rev() {
+                policy.visit()?;
+                remaining.push(child.clone(), policy)?;
+            }
+        }
+        Ok(None)
+    }
+
+    fn try_clone_shallow<A: Admission>(&self, policy: &A) -> Result<Handle, A::Error> {
+        let mut attrs_lease = None;
+        let data = match &self.data {
+            NodeData::Element {
+                name,
+                attrs,
+                mathml_annotation_xml_integration_point,
+                ..
+            } => {
+                let mut copied = Vec::new();
+                reserve(&mut copied, &mut attrs_lease, attrs.borrow().len(), policy)?;
+                policy.work(attrs.borrow().len())?;
+                copied.extend_from_slice(&attrs.borrow());
+                NodeData::Element {
+                    name: name.clone(),
+                    attrs: RefCell::new(copied),
+                    template_contents: RefCell::new(None),
+                    mathml_annotation_xml_integration_point:
+                        *mathml_annotation_xml_integration_point,
+                }
+            }
+            // Tendril clones retain their physical storage owner's lease.
+            other => other.clone(),
+        };
+        Node::try_new(data, attrs_lease, policy)
+    }
+
+    fn try_clone_subtree<A: Admission>(self: &Rc<Self>, policy: &A) -> Result<Handle, A::Error> {
+        let root = self.try_clone_shallow(policy)?;
+        let mut remaining = Work::new();
+        remaining.push((self.clone(), root.clone()), policy)?;
+        while let Some((source, target)) = remaining.pop() {
+            policy.visit()?;
+            for child in source.children.borrow().iter() {
+                policy.visit()?;
+                let copied = child.try_clone_shallow(policy)?;
+                target.reserve_children(1, policy)?;
+                append(&target, copied.clone());
+                remaining.push((child.clone(), copied), policy)?;
+            }
+            if let (
+                NodeData::Element {
+                    template_contents: source,
+                    ..
+                },
+                NodeData::Element {
+                    template_contents: target,
+                    ..
+                },
+            ) = (&source.data, &target.data)
+            {
+                if let Some(fragment) = source.borrow().as_ref() {
+                    let copied = fragment.try_clone_shallow(policy)?;
+                    *target.borrow_mut() = Some(copied.clone());
+                    remaining.push((fragment.clone(), copied), policy)?;
+                }
+            }
+        }
+        Ok(root)
+    }
+
+    fn try_clone_into<A: Admission>(&self, target: &Handle, policy: &A) -> Result<(), A::Error> {
+        let fragment = Node::try_new(NodeData::Document, None, policy)?;
+        for child in self.children.borrow().iter() {
+            policy.visit()?;
+            let copied = child.try_clone_subtree(policy)?;
+            fragment.reserve_children(1, policy)?;
+            append(&fragment, copied);
+        }
+        let children = mem::take(&mut *fragment.children.borrow_mut());
+        policy.work(children.len())?;
+        policy.work(target.children.borrow().len())?;
+        for child in &children {
+            child.parent.set(Some(crate::WeakHandle::new(target)));
+        }
+        let previous = mem::replace(&mut *target.children.borrow_mut(), children);
+        for child in &previous {
+            child.parent.set(None);
+        }
+        drop(previous);
+        *target.children_lease.borrow_mut() = fragment.children_lease.borrow_mut().take();
+        Ok(())
+    }
+}
+
+impl RcDom {
+    pub fn try_selectedcontent<A: Admission>(
+        &self,
+        option: &Handle,
+        policy: &A,
+    ) -> Result<(), A::Error> {
+        let Some(select) = option.try_nearest_select(policy)? else {
+            return Ok(());
+        };
+        if let Some(target) = select.try_selectedcontent(policy)? {
+            if option.try_is_selected_option(policy)? {
+                option.try_clone_into(&target, policy)?;
+            }
+        }
+        Ok(())
+    }
+
+    pub fn try_pop<A: Admission>(&self, node: &Handle, policy: &A) -> Result<(), A::Error> {
+        if let NodeData::Element { name, .. } = &node.data {
+            if name.local_name() == &local_name!("option") {
+                self.try_selectedcontent(node, policy)?;
+            }
+        }
+        Ok(())
+    }
+
+    pub fn try_finish<A: Admission>(self, policy: &A) -> Result<Self, A::Error> {
+        let mut stack = Work::new();
+        stack.push(self.document.clone(), policy)?;
+        while let Some(node) = stack.pop() {
+            policy.visit()?;
+            if let NodeData::Element { name, .. } = &node.data {
+                if name.local_name() == &local_name!("select") {
+                    if let Some(target) = node.try_selectedcontent(policy)? {
+                        if let Some(option) = node.try_selected_option(policy)? {
+                            option.try_clone_into(&target, policy)?;
+                        } else {
+                            let previous = mem::take(&mut *target.children.borrow_mut());
+                            policy.work(previous.len())?;
+                            for child in &previous {
+                                child.parent.set(None);
+                            }
+                            drop(previous);
+                            target.children_lease.borrow_mut().take();
+                        }
+                    }
+                }
+            }
+            for child in node.children.borrow().iter() {
+                policy.visit()?;
+                stack.push(child.clone(), policy)?;
+            }
+        }
+        Ok(self)
+    }
+}
diff --git a/vendor/markup5ever_rcdom/admission/tests.rs b/vendor/markup5ever_rcdom/admission/tests.rs
new file mode 100644
index 0000000000000000000000000000000000000000..667d02f5a7d59d475e6205cbbf68cf83122605ce
--- /dev/null
+++ b/vendor/markup5ever_rcdom/admission/tests.rs
@@ -0,0 +1,225 @@
+//! Refusal at every internal operation frees partial trees and temporary work.
+
+use super::*;
+use crate::{Attribute, QualName};
+use markup5ever::{
+    interface::tree_builder::{ElementFlags, NodeOrText},
+    local_name, ns,
+};
+use std::sync::atomic::{AtomicUsize, Ordering::Relaxed};
+
+#[derive(Clone, Copy, Debug, PartialEq)]
+enum Error {
+    Refused,
+    Allocation,
+    Overflow,
+}
+
+struct Ticket {
+    live: Arc<AtomicUsize>,
+    bytes: usize,
+}
+impl Drop for Ticket {
+    fn drop(&mut self) {
+        self.live.fetch_sub(self.bytes, Relaxed);
+    }
+}
+
+struct Policy {
+    live: Arc<AtomicUsize>,
+    steps: Cell<usize>,
+    fail: usize,
+}
+impl Policy {
+    fn new(fail: usize) -> Self {
+        Self {
+            live: Arc::new(AtomicUsize::new(0)),
+            steps: Cell::new(0),
+            fail,
+        }
+    }
+    fn step(&self) -> Result<(), Error> {
+        let step = self.steps.get() + 1;
+        self.steps.set(step);
+        if step == self.fail {
+            Err(Error::Refused)
+        } else {
+            Ok(())
+        }
+    }
+    fn ticket(&self, bytes: usize) -> Result<Arc<dyn Any + Send + Sync>, Error> {
+        self.step()?;
+        self.live.fetch_add(bytes, Relaxed);
+        Ok(Arc::new(Ticket {
+            live: self.live.clone(),
+            bytes,
+        }))
+    }
+    fn element(&self, dom: &RcDom, name: &str, attrs: &[(&str, &str)]) -> Result<Handle, Error> {
+        let mut flags = ElementFlags::default();
+        flags.template = name == "template";
+        dom.try_create_element(
+            QualName::new(None, ns!(html), name.into()),
+            attrs
+                .iter()
+                .map(|(key, value)| Attribute {
+                    name: QualName::new(None, ns!(), (*key).into()),
+                    value: (*value).into(),
+                })
+                .collect(),
+            flags,
+            self,
+        )
+    }
+}
+impl Admission for Policy {
+    type Error = Error;
+    fn storage(&self, bytes: usize) -> Result<Lease, Error> {
+        self.ticket(bytes).map(Some)
+    }
+    fn node(&self, bytes: usize) -> Result<Lease, Error> {
+        self.ticket(bytes).map(Some)
+    }
+    fn payload(&self, text: usize, attrs: usize) -> Result<Lease, Error> {
+        self.ticket(text + attrs).map(Some)
+    }
+    fn buffer(&self, text: &mut StrTendril, additional: usize) -> Result<(), Error> {
+        self.step()?;
+        text.try_reserve_with(
+            additional.try_into().map_err(|_| Error::Overflow)?,
+            |bytes| self.ticket(bytes),
+        )
+        .map_err(|error| match error {
+            tendril::ReserveError::Admission(error) => error,
+            tendril::ReserveError::Allocation(_) => Error::Allocation,
+            tendril::ReserveError::CapacityOverflow => Error::Overflow,
+        })
+    }
+    fn visit(&self) -> Result<(), Error> {
+        self.step()
+    }
+    fn allocation(&self, _: TryReserveError) -> Error {
+        Error::Allocation
+    }
+    fn overflow(&self) -> Error {
+        Error::Overflow
+    }
+}
+
+fn document(policy: &Policy) -> Result<RcDom, Error> {
+    let dom = RcDom::try_new(policy)?;
+    let select = policy.element(&dom, "select", &[])?;
+    let target = policy.element(&dom, "selectedcontent", &[])?;
+    dom.try_append(&select, NodeOrText::AppendNode(target), policy)?;
+    for value in ["KEEP", "LOST"] {
+        let option = policy.element(&dom, "option", &[("selected", "")])?;
+        let template = policy.element(&dom, "template", &[("data-test", "value")])?;
+        let NodeData::Element {
+            template_contents, ..
+        } = &template.data
+        else {
+            unreachable!()
+        };
+        dom.try_append(
+            template_contents.borrow().as_ref().unwrap(),
+            NodeOrText::AppendText(value.into()),
+            policy,
+        )?;
+        dom.try_append(&option, NodeOrText::AppendNode(template.clone()), policy)?;
+        dom.try_append(&option, NodeOrText::AppendText(value.into()), policy)?;
+        dom.try_append(
+            &option,
+            NodeOrText::AppendText("-long-enough-for-storage".into()),
+            policy,
+        )?;
+        dom.try_append(&select, NodeOrText::AppendNode(option.clone()), policy)?;
+        dom.try_pop(&option, policy)?;
+    }
+    dom.try_append(&dom.document, NodeOrText::AppendNode(select), policy)?;
+    dom.try_parse_error("recovery".into(), policy)?;
+    dom.try_parse_error_fmt(format_args!("recovery {}", "KEEP/LOST"), policy)?;
+    dom.try_finish(policy)
+}
+
+#[test]
+fn every_internal_refusal_releases_partial_state() {
+    let full = Policy::new(usize::MAX);
+    let dom = document(&full).unwrap();
+    let steps = full.steps.get();
+    assert!(steps > 100);
+    drop(dom);
+    assert_eq!(full.live.load(Relaxed), 0);
+    for fail in 1..=steps {
+        let policy = Policy::new(fail);
+        assert!(
+            matches!(document(&policy), Err(Error::Refused)),
+            "step {fail}"
+        );
+        assert_eq!(policy.steps.get(), fail, "work after refusal {fail}");
+        assert_eq!(policy.live.load(Relaxed), 0, "leaked reservation at {fail}");
+    }
+}
+
+#[test]
+fn retained_subtree_and_weak_allocation_keep_their_tickets() {
+    let policy = Policy::new(usize::MAX);
+    let dom = RcDom::try_new(&policy).unwrap();
+    let child = policy.element(&dom, "div", &[]).unwrap();
+    let weak = crate::WeakHandle::new(&dom.document);
+    dom.try_append(
+        &child,
+        NodeOrText::AppendText("KEEP and LOST".into()),
+        &policy,
+    )
+    .unwrap();
+    dom.try_append(
+        &dom.document,
+        NodeOrText::AppendNode(child.clone()),
+        &policy,
+    )
+    .unwrap();
+    drop(dom);
+    assert!(weak.upgrade().is_none());
+    assert_eq!(child.children.borrow().len(), 1);
+    assert!(policy.live.load(Relaxed) > 0);
+    drop(child);
+    assert!(
+        policy.live.load(Relaxed) > 0,
+        "weak Rc still owns physical allocation"
+    );
+    drop(weak);
+    assert_eq!(policy.live.load(Relaxed), 0);
+}
+
+#[test]
+fn selectedcontent_clones_template_storage_and_repairs_parent_edges() {
+    let policy = Policy::new(usize::MAX);
+    let dom = document(&policy).unwrap();
+    let select = dom.document.children.borrow()[0].clone();
+    let target = select.children.borrow()[0].clone();
+    let selected = select.children.borrow().last().unwrap().clone();
+    let copied = target.children.borrow()[0].clone();
+    assert!(!Rc::ptr_eq(&copied, &selected.children.borrow()[0]));
+    assert!(Rc::ptr_eq(
+        &copied.parent().unwrap().upgrade().unwrap(),
+        &target
+    ));
+    let NodeData::Element {
+        template_contents, ..
+    } = &copied.data
+    else {
+        unreachable!()
+    };
+    let fragment = template_contents.borrow().as_ref().unwrap().clone();
+    let NodeData::Text { contents } = &fragment.children.borrow()[0].data else {
+        unreachable!()
+    };
+    assert_eq!(&**contents.borrow(), "LOST");
+    assert_eq!(
+        local_name!("template"),
+        match &copied.data {
+            NodeData::Element { name, .. } => name.local.clone(),
+            _ => unreachable!(),
+        }
+    );
+}
