# Правка resvg для KaminIDE: feDisplacementMap
#
# Зачем. Два дефекта примитива `feDisplacementMap`, из-за которых он всегда
# давал пустой выход (вся семья `tainting-*` в WPT):
#
# 1. Карта смещения приходит ПРЕМУЛЬТИПЛИЦИРОВАННОЙ, а `displacement_map::apply`
#    по своему контракту ждёт unpremultiplied — как и соседние примитивы,
#    которые демультиплексируют вход сами.
# 2. `scale_coordinates(fe.scale(), fe.scale(), ts)` домножает на масштаб
#    дважды: `displacement_map::apply` умножает на `fe.scale()` сам. Смещение
#    улетало за пределы региона, и примитив возвращал пустой холст.
#
# Как накатывать при обновлении вендора:
#   cd vendor/resvg && patch -p1 -l < ../resvg-kaminide.patch
# Проверено на 0.45.1 и 0.48.1 — место правки в обеих версиях одинаковое.

--- a/src/filter/mod.rs
+++ b/src/filter/mod.rs
@@ -957,11 +957,18 @@
     input2: Image,
 ) -> Result<Image, Error> {
     let pixmap1 = input1.into_color_space(cs)?.take()?;
-    let pixmap2 = input2.into_color_space(cs)?.take()?;
+    // KaminIDE patch: карта смещения обязана быть unpremultiplied
+    // (контракт displacement_map::apply) — как у соседних примитивов.
+    let mut pixmap2 = input2.into_color_space(cs)?.take()?;
+    demultiply_alpha(pixmap2.data_mut().as_rgba_mut());
 
     let mut pixmap = tiny_skia::Pixmap::try_create(region.width(), region.height())?;
 
-    let (sx, sy) = match scale_coordinates(fe.scale(), fe.scale(), ts) {
+    // KaminIDE patch: scale_coordinates уже умножает на масштаб холста, а
+    // displacement_map::apply домножает на fe.scale() сам — передача
+    // fe.scale() сюда удваивала множитель, смещение всегда улетало за
+    // регион, и выход примитива был пустым (все tainting-* WPT).
+    let (sx, sy) = match scale_coordinates(1.0, 1.0, ts) {
         Some(v) => v,
         None => return Ok(Image::from_image(pixmap1, cs)),
     };

# Правка 2: узор (`<pattern>`) при отображении плитки на устройство 1:1
# сэмплируется Nearest вместо Bicubic — без размытия границ ячеек
# (WPT css-transforms `svg-matrix-*`; см. `pattern_quality` в src/path.rs).

--- a/src/path.rs
+++ b/src/path.rs
@@ -61,7 +61,7 @@ pub fn fill_path(
             paint.shader = tiny_skia::Pattern::new(
                 pattern_pixmap.as_ref(),
                 tiny_skia::SpreadMode::Repeat,
-                tiny_skia::FilterQuality::Bicubic,
+                pattern_quality(transform, patt_ts),
                 fill.opacity().get(),
                 patt_ts,
             );
@@ -101,7 +101,7 @@ fn stroke_path(
             paint.shader = tiny_skia::Pattern::new(
                 pattern_pixmap.as_ref(),
                 tiny_skia::SpreadMode::Repeat,
-                tiny_skia::FilterQuality::Bicubic,
+                pattern_quality(transform, patt_ts),
                 stroke.opacity().get(),
                 patt_ts,
             );
@@ -176,6 +176,27 @@ fn convert_base_gradient(
     Some((mode, points))
 }
 
+/// KaminIDE patch: the tile is rasterized at the device scale of the
+/// pattern (`render_pattern_pixmap`), so when tile space maps to device
+/// space 1:1 (axis-aligned, scale ±1 — flips included) every device pixel
+/// is a tile texel. Bicubic (Mitchell) sampling still blurs such a texel
+/// with its neighbours and with the wrapped opposite edge, bleeding colours
+/// across the pattern's own cell boundaries; browsers paint it crisp
+/// (WPT css-transforms `svg-matrix-*`). Nearest is exact there; any other
+/// mapping keeps the bicubic filter.
+fn pattern_quality(
+    transform: tiny_skia::Transform,
+    patt_ts: tiny_skia::Transform,
+) -> tiny_skia::FilterQuality {
+    let full = transform.pre_concat(patt_ts);
+    let unit = |v: f32| (v.abs() - 1.0).abs() < 1e-4;
+    if full.kx.abs() < 1e-6 && full.ky.abs() < 1e-6 && unit(full.sx) && unit(full.sy) {
+        tiny_skia::FilterQuality::Nearest
+    } else {
+        tiny_skia::FilterQuality::Bicubic
+    }
+}
