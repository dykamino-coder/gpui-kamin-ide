@@ -106,5 +108,8 @@ fn to_normalized_components(pixel: RGBA8) -> (f32, f32, f32, f32) {
 
 #[inline]
 fn from_normalized(c: f32) -> u8 {
-    (f32_bound(0.0, c, 1.0) * 255.0) as u8
+    // CSS Color 4 section 5.1: reducing calculated RGB precision rounds to
