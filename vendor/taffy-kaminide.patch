+            220.0
+        );
+    }
+
+    #[test]
+    fn minimum_wins_over_conflicting_maximum() {
+        let minimum = Size {
+            width: None,
+            height: Some(200.0),
+        };
+        let maximum = Size {
+            width: None,
+            height: Some(100.0),
+        };
+        assert_eq!(
+            size(
+                Size {
+                    width: 50.0,
+                    height: 0.0
+                },
+                None,
+                Some(1.0),
+                Size::ZERO,
+                minimum,
+                maximum
+            )
+            .height,
+            200.0
+        );
+    }
+}
