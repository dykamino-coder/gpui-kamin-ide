+#[cfg(test)]
+mod last_baseline_tests {
+    use super::*;
+    #[test]
+    fn last_baseline_has_a_distinct_item_keyword() {
+        assert_eq!(
+            AlignItems::LAST_BASELINE.keyword(),
+            AlignItemsKeyword::LastBaseline
+        );
+        assert_ne!(AlignItems::LAST_BASELINE, AlignItems::BASELINE);
+    }
+    #[cfg(feature = "parse")]
+    #[test]
+    fn baseline_position_grammar_keeps_first_and_last_distinct() {
+        assert_eq!(
+            "last baseline".parse::<AlignItems>().unwrap(),
+            AlignItems::LAST_BASELINE
+        );
+        assert_eq!(
+            "first baseline".parse::<AlignItems>().unwrap(),
+            AlignItems::BASELINE
+        );
+        assert!("last center".parse::<AlignItems>().is_err());
+        assert!("last".parse::<AlignItems>().is_err());
+        assert!("safe last baseline".parse::<AlignItems>().is_err());
+    }
+    #[cfg(feature = "serde")]
+    #[test]
+    fn last_baseline_preserves_the_previous_persisted_tag() {
+        let json = serde_json::to_string(&AlignItems::LAST_BASELINE).unwrap();
+        assert_eq!(
+            serde_json::from_str::<AlignItems>(&json).unwrap(),
+            AlignItems::LAST_BASELINE
+        );
+        assert_eq!(json, "\"LastBaseline\"");
+    }
+}
