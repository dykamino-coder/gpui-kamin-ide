+//! Fit cross sizing honors inline contributions, grid children, and box edges.
+use super::flex_intrinsic_cross_tests::column;
+use crate::style_helpers::TaffyMaxContent;
+use crate::{
+    AvailableSpace, BoxSizing, Dimension, Display, FlexWrap, LengthPercentage, Rect, Size, Style,
+    TaffyTree,
+};
+
+#[test]
+fn fit_cross_limit_below_min_content_keeps_inline_item_floor() {
+    for keyword in [
+        Dimension::fit_content_px(50.0),
+        Dimension::fit_content_percent(0.1),
+    ] {
+        let mut tree: TaffyTree<()> = TaffyTree::new();
+        tree.disable_rounding();
+        let item = Style {
+            size: Size::from_lengths(100.0, 0.0),
+            flex_shrink: 0.0,
+            ..Style::DEFAULT
+        };
+        let first = tree.new_leaf(item.clone()).unwrap();
+        let second = tree.new_leaf(item).unwrap();
+        let row = tree
+            .new_with_children(
+                Style {
+                    display: Display::Flex,
+                    flex_wrap: FlexWrap::Wrap,
+                    percent_basis_from_parent: true,
+                    ..Style::DEFAULT
+                },
+                &[first, second],
+            )
+            .unwrap();
+        let green = tree
+            .new_with_children(
+                Style {
+                    size: Size {
+                        width: keyword,
+                        height: Dimension::length(100.0),
+                    },
+                    ..column(keyword)
+                },
+                &[row],
+            )
+            .unwrap();
+        let outer = tree
+            .new_with_children(column(Dimension::length(200.0)), &[green])
+            .unwrap();
+        tree.compute_layout(outer, Size::MAX_CONTENT).unwrap();
+        assert_eq!(
+            tree.layout(green).unwrap().size,
+            Size {
+                width: 100.0,
+                height: 100.0
+            }
+        );
+    }
+}
+
+#[cfg(feature = "grid")]
+#[test]
+fn intrinsic_grid_cross_size_is_not_replaced_by_parent_stretch() {
+    for outer_width in [300.0, 784.0, 900.0] {
+        let mut tree: TaffyTree<()> = TaffyTree::new();
+        let leaf = tree
+            .new_leaf(Style {
+                size: Size::from_lengths(100.0, 100.0),
+                ..Style::DEFAULT
+            })
+            .unwrap();
+        let grid = tree
+            .new_with_children(
+                Style {
+                    display: Display::Grid,
+                    size: Size {
+                        width: Dimension::fit_content(),
+                        height: Dimension::auto(),
+                    },
+                    ..Style::DEFAULT
+                },
+                &[leaf],
+            )
+            .unwrap();
+        let outer = tree
+            .new_with_children(column(Dimension::length(outer_width)), &[grid])
+            .unwrap();
+        tree.compute_layout(outer, Size::MAX_CONTENT).unwrap();
+        assert_eq!(
+            tree.layout(grid).unwrap().size,
+            Size {
+                width: 100.0,
+                height: 100.0
+            }
+        );
+    }
+}
+
+#[test]
+fn flex_fit_cross_clamps_custom_inline_contributions_and_counts_edges_once() {
+    for box_sizing in [BoxSizing::ContentBox, BoxSizing::BorderBox] {
+        for (keyword, argument) in [
+            (Dimension::fit_content_px(50.0), 50.0),
+            (Dimension::fit_content_px(150.0), 150.0),
+            (Dimension::fit_content_px(250.0), 250.0),
+            (Dimension::fit_content_percent(0.5), 150.0),
+        ] {
+            let mut tree: TaffyTree<()> = TaffyTree::new();
+            tree.disable_rounding();
+            let inline = tree.new_leaf(Style::DEFAULT).unwrap();
+            let green = tree
+                .new_with_children(
+                    Style {
+                        box_sizing,
+                        padding: Rect {
+                            left: LengthPercentage::length(5.0),
+                            right: LengthPercentage::length(5.0),
+                            ..Rect::zero()
+                        },
+                        border: Rect {
+                            left: LengthPercentage::length(2.0),
+                            right: LengthPercentage::length(2.0),
+                            ..Rect::zero()
+                        },
+                        ..column(keyword)
+                    },
+                    &[inline],
+                )
+                .unwrap();
+            let outer = tree
+                .new_with_children(column(Dimension::length(300.0)), &[green])
+                .unwrap();
+            tree.compute_layout_with_measure(outer, Size::MAX_CONTENT, |inputs, _, _, style| {
+                crate::compute_leaf_layout(
+                    inputs,
+                    style,
+                    |_, _| 0.0,
+                    |known, available| Size {
+                        width: known.width.unwrap_or(match available.width {
+                            AvailableSpace::MinContent => 100.0,
+                            AvailableSpace::MaxContent => 200.0,
+                            AvailableSpace::Definite(value) => value,
+                        }),
+                        height: 20.0,
+                    },
+                )
+            })
+            .unwrap();
+            let target: f32 = argument
+                + if box_sizing == BoxSizing::ContentBox {
+                    14.0
+                } else {
+                    0.0
+                };
+            assert_eq!(
+                tree.layout(green).unwrap().size.width,
+                target.clamp(114.0, 214.0)
+            );
+        }
+    }
+}
diff --git a/vendor/taffy/src/tree/flex_fragmentation_axis_tests.rs b/vendor/taffy/src/tree/flex_fragmentation_axis_tests.rs
new file mode 100644
index 0000000000000000000000000000000000000000..00d8db2cb0a661b51e31190e9cdb9a66681ef7cb
--- /dev/null
+++ b/vendor/taffy/src/tree/flex_fragmentation_axis_tests.rs
@@ -0,0 +1,185 @@
+//! KaminIDE patch: fragmentation consumes the physical block axis, independently of flex axes.
+use crate::geometry::{AbsoluteAxis, Size};
+use crate::style_helpers::TaffyMaxContent;
+use crate::{AlignContent, Dimension, Direction, FlexDirection, FlexWrap, Style, TaffyTree};
+
+#[test]
+fn main_axis_offsets_preserve_native_sizes_in_both_block_directions() {
+    for direction in [FlexDirection::Row, FlexDirection::RowReverse] {
+        for layout_direction in [Direction::Ltr, Direction::Rtl] {
+            for reversed in [false, true] {
+                for auto in [false, true] {
+                    let mut tree: TaffyTree<()> = TaffyTree::new();
+                    tree.disable_rounding();
+                    let child = Style {
+                        size: Size::from_lengths(30.0, 40.0),
+                        flex_shrink: 0.0,
+                        ..Style::DEFAULT
+                    };
+                    let a = tree.new_leaf(child.clone()).unwrap();
+                    let b = tree.new_leaf(child).unwrap();
+                    let root = tree
+                        .new_with_children(
+                            Style {
+                                flex_direction: direction,
+                                direction: layout_direction,
+                                size: Size {
+                                    width: if auto {
+                                        Dimension::auto()
+                                    } else {
+                                        Dimension::length(60.0)
+                                    },
+                                    height: Dimension::length(40.0),
+                                },
+                                ..Style::DEFAULT
+                            },
+                            &[a, b],
+                        )
+                        .unwrap();
+                    tree.compute_layout(root, Size::MAX_CONTENT).unwrap();
+                    let before = [*tree.layout(a).unwrap(), *tree.layout(b).unwrap()];
+                    tree.set_flex_fragmentation_axis(root, AbsoluteAxis::Horizontal, reversed)
+                        .unwrap();
+                    tree.compute_layout(root, Size::MAX_CONTENT).unwrap();
+                    assert_eq!(*tree.layout(a).unwrap(), before[0]);
+                    assert_eq!(*tree.layout(b).unwrap(), before[1]);
+                    let target = if (before[0].location.x < before[1].location.x) == reversed {
+                        a
+                    } else {
+                        b
+                    };
+                    let target_x = tree.layout(target).unwrap().location.x;
+                    tree.set_flex_item_fragmentation_offset(target, 50.0)
+                        .unwrap();
+                    tree.compute_layout(root, Size::MAX_CONTENT).unwrap();
+                    for (node, old) in [a, b].into_iter().zip(before) {
+                        let consumed = if reversed {
+                            old.location.x <= target_x
+                        } else {
+                            old.location.x >= target_x
+                        };
+                        let expected = old.location.x
+                            + if reversed {
+                                (if auto { 50.0 } else { 0.0 }) - if consumed { 50.0 } else { 0.0 }
+                            } else if consumed {
+                                50.0
+                            } else {
+                                0.0
+                            };
+                        let now = tree.layout(node).unwrap();
+                        assert_eq!(
+                            now.location.x, expected,
+                            "{direction:?} {layout_direction:?} reversed={reversed} auto={auto}"
+                        );
+                        assert_eq!(now.location.y, old.location.y);
+                        assert_eq!(now.size, old.size);
+                    }
+                    assert_eq!(
+                        tree.layout(root).unwrap().size.width,
+                        if auto { 110.0 } else { 60.0 }
+                    );
+                    tree.set_flex_item_fragmentation_offset(target, 0.0)
+                        .unwrap();
+                    tree.compute_layout(root, Size::MAX_CONTENT).unwrap();
+                    assert_eq!(*tree.layout(a).unwrap(), before[0]);
+                    assert_eq!(*tree.layout(b).unwrap(), before[1]);
+                }
+            }
+        }
+    }
+}
+
+#[test]
+fn cross_axis_growth_preserves_items_and_native_line_membership() {
+    for direction in [FlexDirection::Column, FlexDirection::ColumnReverse] {
+        for layout_direction in [Direction::Ltr, Direction::Rtl] {
+            for wrap in [FlexWrap::Wrap, FlexWrap::WrapReverse] {
+                for reversed in [false, true] {
+                    for (auto, align) in [(true, AlignContent::START), (false, AlignContent::START), (false, AlignContent::END), (false, AlignContent::CENTER), (false, AlignContent::SPACE_BETWEEN)] {
+                        let mut tree: TaffyTree<()> = TaffyTree::new();
+                        tree.disable_rounding();
+                        let item = Style {
+                            size: Size::from_lengths(30.0, 40.0),
+                            flex_shrink: 0.0,
+                            ..Style::DEFAULT
+                        };
+                        let a = tree.new_leaf(item.clone()).unwrap();
+                        let b = tree.new_leaf(item).unwrap();
+                        let root = tree
+                            .new_with_children(
+                                Style {
+                                    flex_direction: direction,
+                                    direction: layout_direction,
+                                    flex_wrap: wrap,
+                                    align_content: align,
+                                    size: Size {
+                                        width: if auto {
+                                            Dimension::auto()
+                                        } else {
+                                            Dimension::length(100.0)
+                                        },
+                                        height: Dimension::length(40.0),
+                                    },
+                                    ..Style::DEFAULT
+                                },
+                                &[a, b],
+                            )
+                            .unwrap();
+                        tree.set_flex_fragmentation_axis(root, AbsoluteAxis::Horizontal, reversed)
+                            .unwrap();
+                        tree.compute_layout(root, Size::MAX_CONTENT).unwrap();
+                        let before = [*tree.layout(a).unwrap(), *tree.layout(b).unwrap()];
+                        let crate::DetailedLayoutInfo::Flex(info) = tree.detailed_layout_info(root)
+                        else {
+                            panic!("no lines")
+                        };
+                        let members: Vec<_> = info.lines.iter().map(|l| l.items[0].node).collect();
+                        let first = if (info.lines[0].cross_offset < info.lines[1].cross_offset)
+                            == reversed
+                        {
+                            1
+                        } else {
+                            0
+                        };
+                        let first_node = members[first];
+                        let mut growth = vec![0.0; 2];
+                        growth[first] = 50.0;
+                        tree.set_flex_line_fragmentation_growth(root, growth)
+                            .unwrap();
+                        tree.compute_layout(root, Size::MAX_CONTENT).unwrap();
+                        for (node, old) in [a, b].into_iter().zip(before) {
+                            let shift = if node == first_node {
+                                0.0
+                            } else if reversed {
+                                -50.0
+                            } else {
+                                50.0
+                            };
+                            let expected =
+                                old.location.x + shift + if reversed && auto { 50.0 } else { 0.0 };
+                            let now = tree.layout(node).unwrap();
+                            assert_eq!(now.location.x, expected, "{direction:?} {layout_direction:?} {wrap:?} {align:?} reversed={reversed} auto={auto}");
+                            assert_eq!(now.location.y, old.location.y);
+                            assert_eq!(now.size, old.size);
+                        }
+                        assert_eq!(
+                            tree.layout(root).unwrap().size.width,
+                            if auto { 110.0 } else { 100.0 }
+                        );
+                        let crate::DetailedLayoutInfo::Flex(info) = tree.detailed_layout_info(root)
+                        else {
+                            panic!("no lines")
+                        };
+                        assert_eq!(
+                            info.lines
+                                .iter()
+                                .map(|l| l.items[0].node)
+                                .collect::<Vec<_>>(),
+                            members
+                        );
+                    }
+                }
+            }
+        }
+    }
+}
diff --git a/vendor/taffy/src/tree/flex_fragmentation_continuation_tests.rs b/vendor/taffy/src/tree/flex_fragmentation_continuation_tests.rs
new file mode 100644
index 0000000000000000000000000000000000000000..f4ac02f5738ae25ba0ba38e0088251f7c14635a4
--- /dev/null
+++ b/vendor/taffy/src/tree/flex_fragmentation_continuation_tests.rs
@@ -0,0 +1,170 @@
+//! KaminIDE patch: consumed space follows block-start without changing flexible lengths.
+use crate::geometry::{AbsoluteAxis, Size};
+use crate::style_helpers::TaffyMaxContent;
+use crate::{DetailedLayoutInfo, Dimension, Direction, FlexDirection, Position, Style, TaffyTree};
+
+#[test]
+fn horizontal_cross_axis_continuations_keep_original_item_sizes() {
+    for direction in [Direction::Ltr, Direction::Rtl] {
+        for reversed in [false, true] {
+            let mut tree: TaffyTree<()> = TaffyTree::new();
+            tree.disable_rounding();
+            let item = Style {
+                size: Size::from_lengths(30.0, 40.0),
+                ..Style::DEFAULT
+            };
+            let a = tree.new_leaf(item.clone()).unwrap();
+            let b = tree.new_leaf(item).unwrap();
+            let root = tree
+                .new_with_children(
+                    Style {
+                        flex_direction: FlexDirection::Column,
+                        direction,
+                        size: Size {
+                            width: Dimension::auto(),
+                            height: Dimension::length(80.0),
+                        },
+                        ..Style::DEFAULT
+                    },
+                    &[a, b],
+                )
+                .unwrap();
+            tree.set_flex_fragmentation_axis(root, AbsoluteAxis::Horizontal, reversed)
+                .unwrap();
+            tree.set_flex_item_fragmentation_consumed(a, 20.0).unwrap();
+            tree.set_flex_item_fragmentation_consumed(b, 10.0).unwrap();
+            tree.compute_layout(root, Size::MAX_CONTENT).unwrap();
+            assert_eq!(tree.layout(root).unwrap().size.width, 20.0);
+            for (node, consumed) in [(a, 20.0), (b, 10.0)] {
+                let actual = tree.layout(node).unwrap();
+                assert_eq!(
+                    actual.size,
+                    Size {
+                        width: 30.0,
+                        height: 40.0
+                    }
+                );
+                assert_eq!(
+                    actual.location.x,
+                    if reversed { consumed - 10.0 } else { -consumed },
+                    "{direction:?} reversed={reversed}"
+                );
+            }
+            let DetailedLayoutInfo::Flex(info) = tree.detailed_layout_info(root) else {
+                panic!("no lines")
+            };
+            assert_eq!(info.lines[0].cross_offset, 0.0);
+            assert_eq!(info.lines[0].cross_size, 20.0);
+            tree.set_flex_item_fragmentation_consumed(a, 0.0).unwrap();
+            tree.set_flex_item_fragmentation_consumed(b, 0.0).unwrap();
+            tree.compute_layout(root, Size::MAX_CONTENT).unwrap();
+            assert_eq!(tree.layout(root).unwrap().size.width, 30.0);
+        }
+    }
+}
+
+#[test]
+fn horizontal_main_axis_offset_keeps_flex_grow_and_absolute_static_position() {
+    for reversed in [false, true] {
+        let mut tree: TaffyTree<()> = TaffyTree::new();
+        tree.disable_rounding();
+        let child = Style {
+            size: Size::from_lengths(30.0, 40.0),
+            flex_grow: 1.0,
+            ..Style::DEFAULT
+        };
+        let a = tree.new_leaf(child.clone()).unwrap();
+        let b = tree.new_leaf(child).unwrap();
+        let abs = tree
+            .new_leaf(Style {
+                position: Position::Absolute,
+                size: Size::from_lengths(10.0, 10.0),
+                ..Style::DEFAULT
+            })
+            .unwrap();
+        let root = tree
+            .new_with_children(
+                Style {
+                    size: Size::from_lengths(100.0, 40.0),
+                    ..Style::DEFAULT
+                },
+                &[a, b, abs],
+            )
+            .unwrap();
+        tree.set_flex_fragmentation_axis(root, AbsoluteAxis::Horizontal, reversed)
+            .unwrap();
+        tree.compute_layout(root, Size::MAX_CONTENT).unwrap();
+        let before = [*tree.layout(a).unwrap(), *tree.layout(b).unwrap()];
+        let static_position = *tree.layout(abs).unwrap();
+        tree.set_flex_item_fragmentation_offset(if reversed { a } else { b }, 50.0)
+            .unwrap();
+        tree.compute_layout(root, Size::MAX_CONTENT).unwrap();
+        assert_eq!(*tree.layout(abs).unwrap(), static_position);
+        for (node, old) in [a, b].into_iter().zip(before) {
+            assert_eq!(tree.layout(node).unwrap().size, old.size);
+        }
+        assert_eq!(
+            tree.layout(a).unwrap().location.x,
+            if reversed { -50.0 } else { 0.0 }
+        );
+        assert_eq!(
+            tree.layout(b).unwrap().location.x,
+            if reversed { 50.0 } else { 100.0 }
+        );
+        assert_eq!(tree.layout(root).unwrap().size.width, 100.0);
+    }
+}
+
+#[test]
+fn main_only_size_probes_include_consumed_space_without_publishing_layout() {
+    reblessive::Stack::new()
+        .enter(|stack| async move {
+            use crate::{LayoutInput, LayoutPartialTree, RequestedAxis, RunMode};
+            for (direction, axis) in [
+                (FlexDirection::Row, AbsoluteAxis::Horizontal),
+                (FlexDirection::Column, AbsoluteAxis::Vertical),
+            ] {
+                let mut tree: TaffyTree<()> = TaffyTree::new();
+                tree.disable_rounding();
+                let child = Style {
+                    size: Size::from_lengths(30.0, 30.0),
+                    flex_shrink: 0.0,
+                    ..Style::DEFAULT
+                };
+                let a = tree.new_leaf(child.clone()).unwrap();
+                let b = tree.new_leaf(child).unwrap();
+                let root = tree
+                    .new_with_children(
+                        Style {
+                            flex_direction: direction,
+                            ..Style::DEFAULT
+                        },
+                        &[a, b],
+                    )
+                    .unwrap();
+                tree.set_flex_fragmentation_axis(root, axis, false).unwrap();
+                tree.set_flex_item_fragmentation_offset(b, 50.0).unwrap();
+                let input = LayoutInput {
+                    run_mode: RunMode::ComputeSize,
+                    axis: RequestedAxis::from(axis),
+                    ..LayoutInput::HIDDEN
+                };
+                let probe = tree
+                    .as_layout_tree()
+                    .compute_child_layout_async(root, input, stack)
+                    .await;
+                assert_eq!(probe.size.main(direction), 110.0);
+                assert!(matches!(
+                    tree.detailed_layout_info(root),
+                    DetailedLayoutInfo::None
+                ));
+                tree.compute_layout(root, Size::MAX_CONTENT).unwrap();
+                assert_eq!(
+                    tree.layout(root).unwrap().size.main(direction),
+                    probe.size.main(direction)
+                );
+                assert_eq!(tree.layout(b).unwrap().location.main(direction), 80.0);
+            }
+        })
+        .finish()
+}
diff --git a/vendor/taffy/src/tree/flex_fragmentation_gap_tests.rs b/vendor/taffy/src/tree/flex_fragmentation_gap_tests.rs
