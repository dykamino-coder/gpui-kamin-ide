--- /dev/null
+++ b/vendor/taffy/src/compute/grid/fixed_standalone_tracks.rs
@@ -0,0 +1,181 @@
+//! Fixed standalone tracks constrain flattened subgrid items even when container size is auto.
+use super::*;
+
+#[cfg(test)]
+pub(super) fn standalone_tracks<Tree: crate::LayoutPartialTree>(
+    tree: &Tree,
+    style: &impl crate::GridContainerStyle,
+    columns: bool,
+    basis: Size<Option<f32>>,
+) -> Option<(Vec<f32>, f32)> {
+    standalone_tracks_with_known(tree, style, columns, basis, Size::NONE)
+}
+
+/// KaminIDE patch: Size non-subgridded tracks using the known container dimensions.
+pub(super) fn standalone_tracks_with_known<Tree: crate::LayoutPartialTree>(
+    tree: &Tree,
+    style: &impl crate::GridContainerStyle,
+    columns: bool,
+    basis: Size<Option<f32>>,
+    known_content: Size<Option<f32>>,
+) -> Option<(Vec<f32>, f32)> {
+    let size = style
+        .size()
+        .maybe_resolve(basis, |val, b| tree.calc(val, b));
+    let mut size = if columns { size.width } else { size.height };
+    if style.box_sizing() == crate::BoxSizing::BorderBox {
+        let padding = style
+            .padding()
+            .map(|p| p.resolve_or_zero(basis.width, |val, b| tree.calc(val, b)));
+        let border = style
+            .border()
+            .map(|p| p.resolve_or_zero(basis.width, |val, b| tree.calc(val, b)));
+        let edges = if columns {
+            padding.left + padding.right + border.left + border.right
+        } else {
+            padding.top + padding.bottom + border.top + border.bottom
+        };
+        size = size.map(|value| value - edges);
+    }
+    let known = if columns {
+        known_content.width
+    } else {
+        known_content.height
+    };
+    let size = known.or(size).map(|value| value.max(0.0));
+    let gap = if columns {
+        style.gap().width
+    } else {
+        style.gap().height
+    };
+    let gap = gap.resolve_or_zero(size, |val, b| tree.calc(val, b));
+    let template = if columns {
+        style.grid_template_columns()
+    } else {
+        style.grid_template_rows()
+    }?;
+    // (С‚РѕС‡РєРё, РґРѕР»СЏ)
+    let mut tracks: Vec<(Option<f32>, f32)> = Vec::new();
+    let mut push = |t: crate::TrackSizingFunction| -> Option<()> {
+        let max = t.max_sizing_function();
+        let min = t.min_sizing_function();
+        if max.is_fr() {
+            // Flexible tracks require a definite standalone-axis size.
+            size?;
+            tracks.push((None, max.into_raw().value()));
+            return Some(());
+        }
+        let hi = max.definite_value(size, |val, b| tree.calc(val, b))?;
+        let lo = min.definite_value(size, |val, b| tree.calc(val, b))?;
+        ((hi - lo).abs() < 0.001).then(|| tracks.push((Some(hi), 0.0)))
+    };
+    for component in template {
+        match component {
+            crate::GenericGridTemplateComponent::Single(t) => push(t)?,
+            crate::GenericGridTemplateComponent::Repeat(repeat) => match repeat.count() {
+                crate::RepetitionCount::Count(n) => {
+                    for _ in 0..n {
+                        for t in repeat.tracks() {
+                            push(t)?;
+                        }
+                    }
+                }
+                _ => return None,
+            },
+        }
+    }
+    if tracks.is_empty() {
+        return None;
+    }
+    let fixed: f32 = tracks.iter().filter_map(|t| t.0).sum();
+    let flex: f32 = tracks.iter().map(|t| t.1).sum();
+    let leftover = size
+        .map(|value| (value - fixed - gap * (tracks.len() as f32 - 1.0)).max(0.0))
+        .unwrap_or(0.0);
+    let per = leftover / flex.max(1.0);
+    Some((
+        tracks.iter().map(|t| t.0.unwrap_or(t.1 * per)).collect(),
+        gap,
+    ))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::style_helpers::*;
+    use crate::{BoxSizing, Display, Rect, Style, TaffyTree};
+
+    fn resolve(style: Style, columns: bool) -> Option<(Vec<f32>, f32)> {
+        let mut tree: TaffyTree<()> = TaffyTree::new();
+        let view = tree.as_layout_tree();
+        standalone_tracks(&view, &style, columns, Size::NONE)
+    }
+
+    #[test]
+    fn fixed_standalone_tracks_do_not_require_container_size() {
+        for columns in [false, true] {
+            let mut style = Style {
+                display: Display::Grid,
+                ..Style::DEFAULT
+            };
+            if columns {
+                style.grid_template_columns = vec![length(25.0), length(35.0)];
+            } else {
+                style.grid_template_rows = vec![length(25.0), length(35.0)];
+            }
+            style.gap = Size {
+                width: length(10.0),
+                height: length(10.0),
+            };
+            assert_eq!(resolve(style, columns), Some((vec![25.0, 35.0], 10.0)));
+        }
+    }
+
+    #[test]
+    fn fractional_and_percentage_tracks_still_require_their_basis() {
+        let mut fractions = Style {
+            display: Display::Grid,
+            grid_template_rows: vec![fr(1.0), fr(3.0)],
+            ..Style::DEFAULT
+        };
+        assert_eq!(resolve(fractions.clone(), false), None);
+        fractions.size.height = length(100.0);
+        assert_eq!(resolve(fractions, false), Some((vec![25.0, 75.0], 0.0)));
+        let mut percentage = Style {
+            display: Display::Grid,
+            grid_template_rows: vec![percent(0.5)],
+            ..Style::DEFAULT
+        };
+        assert_eq!(resolve(percentage.clone(), false), None);
+        percentage.size.height = length(100.0);
+        assert_eq!(resolve(percentage, false), Some((vec![50.0], 0.0)));
+    }
+
+    #[test]
+    fn definite_fractional_tracks_deduct_border_padding_and_gap() {
+        let style = Style {
+            display: Display::Grid,
+            box_sizing: BoxSizing::BorderBox,
+            size: Size::from_lengths(100.0, 100.0),
+            padding: Rect {
+                left: length(5.0),
+                right: length(5.0),
+                top: length(5.0),
+                bottom: length(5.0),
+            },
+            border: Rect {
+                left: length(2.0),
+                right: length(2.0),
+                top: length(2.0),
+                bottom: length(2.0),
+            },
+            gap: Size {
+                width: length(6.0),
+                height: length(6.0),
+            },
+            grid_template_rows: vec![fr(1.0), fr(1.0)],
+            ..Style::DEFAULT
+        };
+        assert_eq!(resolve(style, false), Some((vec![40.0, 40.0], 6.0)));
+    }
+}
diff --git a/vendor/taffy/src/compute/grid/fragmentation_growth.rs b/vendor/taffy/src/compute/grid/fragmentation_growth.rs
new file mode 100644
index 0000000000000000000000000000000000000000..81077d41415dde30e22fcf761934b32e5ec15d02
--- /dev/null
+++ b/vendor/taffy/src/compute/grid/fragmentation_growth.rs
@@ -0,0 +1,253 @@
+//! KaminIDE patch: block space that a fragmenting caller inserts after grid tracks
+//! (css-grid-2 §12 Fragmenting Grid Layout: a row pushed into the next fragmentainer moves with
+//! every following row; Blink `ShiftBreakpointIntoNextFragmentainer`, Gecko continuation row
+//! offsets). Track sizing and content alignment keep the unfragmented layout; the growth only
+//! moves the tracks after it towards the axis end, so an item spanning it grows with its grid
+//! area and a container sized by its content grows within its min/max sizes. A subgridded axis
+//! has no own tracks (css-grid-2 §9): it takes the parent's growth inside its span, so its
+//! lines stay on the parent's lines, and ignores the caller's own request.
+use super::types::{GridItem, GridTrack, GridTrackKind};
+use crate::geometry::{AbsoluteAxis, Line, Size};
+use crate::style::AvailableSpace;
+use crate::tree::NodeId;
+use crate::util::sys::{f32_max, Vec};
+use crate::util::MaybeMath;
+use crate::LayoutGridContainer;
+
+/// Size constraints of the container that decide whether growth may enlarge it.
+pub(super) struct Limits {
+    /// Known or preferred border-box size: such an axis keeps its size.
+    pub(super) resolved: Size<Option<f32>>,
+    /// Authored preferred border-box size: its content alignment uses the full content box.
+    pub(super) preferred: Size<Option<f32>>,
+    /// Padding, border and scrollbar gutter in each axis.
+    pub(super) inset: Size<f32>,
+    /// Border-box min size.
+    pub(super) min: Size<Option<f32>>,
+    /// Border-box max size.
+    pub(super) max: Size<Option<f32>>,
+    /// Padding and border: the smallest border box.
+    pub(super) padding_border: Size<f32>,
+}
+
+/// Growth after each track of both physical axes, in exported track order.
+pub(super) struct Growth {
+    /// Growth after each track; empty when nothing is inserted.
+    after: Size<Vec<f32>>,
+    /// Sum of the growth in each axis.
+    total: Size<f32>,
+}
+
+impl Growth {
+    /// Read the growth for the tracks of this grid: the caller's, or in a subgridded axis
+    /// (`inherited` is `Some`) the parent's growth inside the span.
+    pub(super) fn read(
+        tree: &impl LayoutGridContainer,
+        node: NodeId,
+        columns: &[GridTrack],
+        rows: &[GridTrack],
+        inherited: Size<Option<&[f32]>>,
+    ) -> Self {
+        let axis = |abs: AbsoluteAxis, tracks: &[GridTrack], inherited: Option<&[f32]>| -> Vec<f32> {
+            let count = tracks.iter().filter(|track| track.kind == GridTrackKind::Track).count();
+            nonzero(
+                (0..count)
+                    .map(|index| match inherited {
+                        Some(growth) => growth.get(index).copied().unwrap_or(0.0),
+                        None => tree.grid_track_fragmentation_growth(node, abs, index),
+                    })
+                    .map(|value| if value.is_finite() && value > 0.0 { value } else { 0.0 })
+                    .collect(),
+            )
+        };
+        let after = Size {
+            width: axis(AbsoluteAxis::Horizontal, columns, inherited.width),
+            height: axis(AbsoluteAxis::Vertical, rows, inherited.height),
+        };
+        let total = Size { width: after.width.iter().sum(), height: after.height.iter().sum() };
+        Self { after, total }
+    }
+
+    /// Content-box size for the unfragmented track sizing: a size a parent `given` this
+    /// container without an authored size was measured with the growth and excludes it here.
+    pub(super) fn unfragmented_size(&self, size: Size<Option<f32>>, given: Size<bool>) -> Size<Option<f32>> {
+        let less = |size: Option<f32>, given: bool, total: f32| match size {
+            Some(size) if given && total > 0.0 => Some(f32_max(size - total, 0.0)),
+            size => size,
+        };
+        Size {
+            width: less(size.width, given.width, self.total.width),
+            height: less(size.height, given.height, self.total.height),
+        }
+    }
+
+    /// Available grid space for the unfragmented track sizing (see `unfragmented_size`).
+    pub(super) fn unfragmented_space(&self, space: Size<AvailableSpace>, given: Size<bool>) -> Size<AvailableSpace> {
+        let less = |space: AvailableSpace, given: bool, total: f32| match space {
+            AvailableSpace::Definite(size) if given && total > 0.0 => AvailableSpace::Definite(f32_max(size - total, 0.0)),
+            space => space,
+        };
+        Size {
+            width: less(space.width, given.width, self.total.width),
+            height: less(space.height, given.height, self.total.height),
+        }
+    }
+
+    /// No growth: the layout is exactly the unfragmented one.
+    pub(super) fn is_empty(&self) -> bool {
+        self.after.width.is_empty() && self.after.height.is_empty()
+    }
+
+    /// Border-box size of the container: an axis sized by its tracks grows by the total growth.
+    pub(super) fn container(&self, size: Size<f32>, track_sums: Size<f32>, limits: &Limits) -> Size<f32> {
+        let grow = |size: f32, total: f32, resolved: Option<f32>, sum: f32, inset: f32, min, max, floor: f32| {
+            if total <= 0.0 || resolved.is_some() {
+                return size;
+            }
+            (sum + total + inset).maybe_clamp(min, max).max(floor).max(size)
+        };
+        Size {
+            width: grow(
+                size.width,
+                self.total.width,
+                limits.resolved.width,
+                track_sums.width,
+                limits.inset.width,
+                limits.min.width,
+                limits.max.width,
+                limits.padding_border.width,
+            ),
+            height: grow(
+                size.height,
+                self.total.height,
+                limits.resolved.height,
+                track_sums.height,
+                limits.inset.height,
+                limits.min.height,
+                limits.max.height,
+                limits.padding_border.height,
+            ),
+        }
+    }
+
+    /// Content size that content alignment distributes: that of the unfragmented layout.
+    /// An authored size keeps its free space; a size taken from the content (auto, or given by
+    /// a parent that measured this grid with its growth) excludes the growth.
+    pub(super) fn alignment_basis(&self, content: Size<f32>, track_sums: Size<f32>, limits: &Limits) -> Size<f32> {
+        let basis = |content: f32, total: f32, preferred: Option<f32>, sum: f32, inset: f32, min, max, floor: f32| {
+            if total <= 0.0 || preferred.is_some() {
+                return content;
+            }
+            let unfragmented = (sum + inset).maybe_clamp(min, max).max(floor) - inset;
+            unfragmented.max(content - total).min(content).max(0.0)
+        };
+        Size {
+            width: basis(
+                content.width,
+                self.total.width,
+                limits.preferred.width,
+                track_sums.width,
+                limits.inset.width,
+                limits.min.width,
+                limits.max.width,
+                limits.padding_border.width,
+            ),
+            height: basis(
+                content.height,
+                self.total.height,
+                limits.preferred.height,
+                track_sums.height,
+                limits.inset.height,
+                limits.min.height,
+                limits.max.height,
+                limits.padding_border.height,
+            ),
+        }
+    }
+
+    /// Move the aligned tracks. `extra` is how much larger the content box is than the
+    /// alignment basis: on a reversed axis the axis start is the high physical edge, so the
+    /// tracks before every growth move with it.
+    pub(super) fn shift(&self, columns: &mut [GridTrack], rows: &mut [GridTrack], reversed: Size<bool>, extra: Size<f32>) {
+        shift_axis(columns, &self.after.width, reversed.width, extra.width);
+        shift_axis(rows, &self.after.height, reversed.height, extra.height);
+    }
+
+    /// Hand each subgrid the growth between the tracks it spans, in its own track order. The
+    /// tracks published to it before carry the unfragmented sizes.
+    pub(super) fn publish_to_subgrids(&self, tree: &mut impl LayoutGridContainer, items: &[GridItem], parent: Size<bool>) {
+        if self.is_empty() {
+            return;
+        }
+        for item in items.iter().filter(|item| !item.flattened) {
+            let Some(mut tracks) = tree.get_subgrid_tracks(item.node) else {
+                continue;
+            };
+            let child = super::subgrid_flow::axes(&tree.get_grid_container_style(item.node));
+            let mut changed = false;
+            if let Some(axis) = tracks.columns.as_mut() {
+                changed |= span_growth(&mut axis.growth, &self.after.width, item.column_indexes, parent.width != child.width);
+            }
+            if let Some(axis) = tracks.rows.as_mut() {
+                changed |= span_growth(&mut axis.growth, &self.after.height, item.row_indexes, parent.height != child.height);
+            }
+            if changed {
+                tree.set_subgrid_tracks(item.node, Some(tracks));
+            }
+        }
+    }
+}
+
+/// Growth between the tracks of a span `lines` (indices of the track vector, lines at even
+/// indices); reversed when the subgrid orders the axis the other way.
+fn span_growth(out: &mut Vec<f32>, after: &[f32], lines: Line<u16>, reversed: bool) -> bool {
+    let first = usize::from(lines.start / 2);
+    let count = usize::from(lines.end.saturating_sub(lines.start) / 2);
+    let mut growth: Vec<f32> =
+        (first..first + count.saturating_sub(1)).map(|track| after.get(track).copied().unwrap_or(0.0)).collect();
+    if reversed {
+        growth.reverse();
+    }
+    let growth = nonzero(growth);
+    let changed = *out != growth;
+    *out = growth;
+    changed
+}
+
+/// Growth that inserts nothing is no growth at all.
+fn nonzero(growth: Vec<f32>) -> Vec<f32> {
+    if growth.iter().any(|&value| value > 0.0) {
+        growth
+    } else {
+        Vec::new()
+    }
+}
+
+/// Move the tracks after each growth towards the axis end (see `Growth::shift`). The gutter after
+/// a grown track stays with the area that ends at that track (`lanes_geometry::track_area`): on a
+/// forward axis its offset is that area's end line, on a reversed axis it is the physical end of
+/// the next track's area, so completed items keep their size either way.
+fn shift_axis(tracks: &mut [GridTrack], after: &[f32], reversed: bool, extra: f32) {
+    if after.is_empty() {
+        return;
+    }
+    let mut before = 0.0;
+    let mut pending = 0.0;
+    let mut index = 0;
+    for track in tracks.iter_mut() {
+        if track.kind == GridTrackKind::Track {
+            before += pending;
+            pending = 0.0;
+        }
+        track.offset += if reversed { extra - before } else { before };
+        if track.kind == GridTrackKind::Track {
+            let growth = after.get(index).copied().unwrap_or(0.0);
+            index += 1;
+            if reversed {
+                before += growth;
+            } else {
+                pending = growth;
+            }
+        }
+    }
+}
diff --git a/vendor/taffy/src/compute/grid/grid_info_geometry.rs b/vendor/taffy/src/compute/grid/grid_info_geometry.rs
new file mode 100644
index 0000000000000000000000000000000000000000..a8194968b193a91178d9c0c47ba8d23212759868
--- /dev/null
+++ b/vendor/taffy/src/compute/grid/grid_info_geometry.rs
@@ -0,0 +1,68 @@
+//! Physical areas exported by detailed grid information support both reversed axes.
+use super::{f32_max, f32_min, DetailedGridInfo};
+use crate::{CheapCloneStr, Direction, GridAreaAxis, GridPlacement, Line, Point, Rect, Size};
+
+impl<S: CheapCloneStr> DetailedGridInfo<S> {
+    /// Resolve the physical grid area for an absolutely positioned box from its grid placement.
+    /// The padding box and returned area use coordinates relative to the grid container's border box.
+    pub fn resolve_absolute_grid_area(
+        &self,
+        grid_row: Line<GridPlacement<S>>,
+        grid_column: Line<GridPlacement<S>>,
+        direction: Direction,
+        padding_box: Rect<f32>,
+    ) -> Rect<f32> {
+        // Upstream #1264: area edges are looked up in the separately stored area map.
+        let columns = self.columns.resolve_absolute_grid_axis(
+            grid_column,
+            &self.areas,
+            GridAreaAxis::Column,
+            padding_box.left,
+            padding_box.right,
+            // KaminIDE patch: the HTML adapter projects RTL/writing modes into `grid_axis_reversed`
+            // (folded into `axis_reversed`), so the caller's `direction` may stay Ltr.
+            direction.is_rtl() || self.axis_reversed.width,
+        );
+        let rows = self.rows.resolve_absolute_grid_axis(
+            grid_row,
+            &self.areas,
+            GridAreaAxis::Row,
+            padding_box.top,
+            padding_box.bottom,
+            self.axis_reversed.height,
+        );
+        Rect {
+            left: columns.start,
+            right: columns.end,
+            top: rows.start,
+            bottom: rows.end,
+        }
+    }
+
+    /// Compute the location and size of the grid area occupied by the item at `item_index` (an
+    /// index into [`DetailedGridInfo::items`]), relative to the grid container's border box.
+    ///
+    /// The edges resolve to the edges of the tracks bounding the item's grid area (a start line
+    /// resolves to the start of the track that follows it and an end line to the end of the track
+    /// that precedes it), so the area excludes any gutter or content-alignment spacing around it.
+    ///
+    /// Returns `None` if `item_index` is out of bounds.
+    pub fn item_grid_area(&self, item_index: usize) -> Option<(Point<f32>, Size<f32>)> {
+        let item = self.items.get(item_index)?;
+        let start_col = self.columns.positions[item.column_start as usize - 1];
+        let end_col = self.columns.positions[item.column_end as usize - 2];
+        let left = f32_min(start_col.start, end_col.start);
+        let right = f32_max(start_col.end, end_col.end);
+        let start_row = self.rows.positions[item.row_start as usize - 1];
+        let end_row = self.rows.positions[item.row_end as usize - 2];
+        let top = f32_min(start_row.start, end_row.start);
+        let bottom = f32_max(start_row.end, end_row.end);
+        Some((
+            Point { x: left, y: top },
+            Size {
+                width: right - left,
+                height: bottom - top,
+            },
+        ))
+    }
+}
diff --git a/vendor/taffy/src/compute/grid/lanes.rs b/vendor/taffy/src/compute/grid/lanes.rs
