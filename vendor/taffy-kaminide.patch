index 0000000000000000000000000000000000000000..18bca4d851b1e947d96049f89c8393c2dbf96911
--- /dev/null
+++ b/vendor/taffy/src/compute/grid/lanes_final_placement.rs
@@ -0,0 +1,78 @@
+//! Project completed lane stacks onto physical axes and publish child geometry/overflow.
+use super::*;
+
+#[allow(clippy::too_many_arguments)]
+/// KaminIDE patch: Commit lane item positions and final child layouts.
+pub(super) fn position(
+    tree: &mut impl LayoutGridContainer,
+    placed: &mut [Placed],
+    rows: bool,
+    flow: Size<bool>,
+    stack_content: f32,
+    stack_start_inset: f32,
+    border: Rect<f32>,
+    #[cfg(feature = "content_size")] is_scroll_container: bool,
+) -> Rect<f32> {
+    if if rows { flow.width } else { flow.height } {
+        for item in placed.iter_mut() {
+            // Stretch may have changed size after packing; relative insets remain physical.
+            let outer_size = if rows {
+                item.size.width + item.margin.horizontal_axis_sum()
+            } else {
+                item.size.height + item.margin.vertical_axis_sum()
+            };
+            item.stack_pos = stack_content - item.stack_pos - outer_size;
+        }
+    }
+    #[cfg_attr(not(feature = "content_size"), allow(unused_mut))]
+    let mut item_content_size_contribution = Rect::ZERO;
+    for (order, p) in placed.iter().enumerate() {
+        let (m_start, _) = if rows {
+            (p.margin.left, p.margin.right)
+        } else {
+            (p.margin.top, p.margin.bottom)
+        };
+        let stack = stack_start_inset + p.stack_pos + m_start + p.stack_relative;
+        let location = if rows {
+            Point {
+                x: stack,
+                y: p.grid_pos + p.grid_relative,
+            }
+        } else {
+            Point {
+                x: p.grid_pos + p.grid_relative,
+                y: stack,
+            }
+        };
+        tree.set_unrounded_layout(
+            p.node,
+            &Layout {
+                order: order as u32,
+                location,
+                size: p.size,
+                #[cfg(feature = "content_size")]
+                scrollable_overflow_rect: p.scrollable_overflow_rect,
+                scrollbar_size: p.scrollbar_size,
+                padding: p.padding,
+                border: p.border,
+                margin: p.margin,
+            },
+        );
+        #[cfg(feature = "content_size")]
+        {
+            item_content_size_contribution =
+                item_content_size_contribution.union(compute_scrollable_overflow_contribution(
+                    Point {
+                        x: location.x - border.left,
+                        y: location.y - border.top,
+                    },
+                    p.size,
+                    p.scrollable_overflow_rect,
+                    p.overflow,
+                    p.contain,
+                    is_scroll_container,
+                ));
+        }
+    }
+    item_content_size_contribution
+}
diff --git a/vendor/taffy/src/compute/grid/lanes_geometry.rs b/vendor/taffy/src/compute/grid/lanes_geometry.rs
new file mode 100644
index 0000000000000000000000000000000000000000..cd9405028d468a68865e73151e01affde150d088
--- /dev/null
+++ b/vendor/taffy/src/compute/grid/lanes_geometry.rs
@@ -0,0 +1,100 @@
+//! Grid-lanes alignment uses real track edges and clamps safe overflow before reversal.
+use super::types::GridTrack;
+use crate::{AlignContent, AlignContentKeyword, AlignmentSafety, Line};
+
+/// Gutters represent grid lines, but their offsets include the preceding gap.
+/// Absolute areas begin at the next real track and end at the previous real track.
+pub(super) fn absolute_area(
+    tracks: &[GridTrack],
+    placement: Line<Option<usize>>,
+    padding_start: f32,
+    padding_end: f32,
+    reversed: bool,
+) -> Line<f32> {
+    if reversed {
+        let start = placement
+            .end
+            .and_then(|index| index.checked_sub(1))
+            .and_then(|index| tracks.get(index))
+            .map(|track| track.offset)
+            .unwrap_or(padding_start);
+        let end = placement
+            .start
+            .and_then(|index| tracks.get(index))
+            .map(|track| track.offset)
+            .unwrap_or(padding_end);
+        return Line {
+            start: start.min(end),
+            end: start.max(end),
+        };
+    }
+    let start = placement
+        .start
+        .and_then(|index| {
+            tracks.get(index + 1).map(|track| track.offset).or_else(|| {
+                index
+                    .checked_sub(1)
+                    .and_then(|i| tracks.get(i))
+                    .map(|track| track.offset + track.base_size)
+            })
+        })
+        .unwrap_or(padding_start);
+    let end = placement
+        .end
+        .and_then(|index| {
+            index
+                .checked_sub(1)
+                .and_then(|i| tracks.get(i))
+                .map(|track| track.offset + track.base_size)
+                .or_else(|| tracks.get(1).map(|track| track.offset))
+        })
+        .unwrap_or(padding_end);
+    Line {
+        start: start.min(end),
+        end: start.max(end),
+    }
+}
+
+/// KaminIDE patch: Compute the physical area covered by a lane range.
+pub(super) fn track_area(
+    tracks: &[GridTrack],
+    start: usize,
+    end: usize,
+    reversed: bool,
+) -> Line<f32> {
+    if reversed {
+        Line {
+            start: tracks[2 * end - 1].offset,
+            end: tracks[2 * start].offset,
+        }
+    } else {
+        Line {
+            start: tracks[2 * start + 1].offset,
+            end: tracks[2 * end].offset,
+        }
+    }
+}
+
+/// Overflow safety clamps the distance, including the distance used to reverse placement.
+pub(super) fn stacking_alignment_offset(
+    free: f32,
+    alignment: AlignContent,
+    fill_reverse: bool,
+) -> f32 {
+    let free = if alignment.safety == AlignmentSafety::Safe {
+        free.max(0.0)
+    } else {
+        free
+    };
+    let keyword = crate::compute::common::alignment::apply_alignment_fallback(free, 1, alignment);
+    let offset = match keyword {
+        AlignContentKeyword::Center => free / 2.0,
+        AlignContentKeyword::End | AlignContentKeyword::FlexEnd => free,
+        _ => 0.0,
+    };
+    if fill_reverse {
+        offset - free
+    } else {
+        offset
+    }
+}
diff --git a/vendor/taffy/src/compute/grid/lanes_row_baselines.rs b/vendor/taffy/src/compute/grid/lanes_row_baselines.rs
new file mode 100644
index 0000000000000000000000000000000000000000..8642611ed119b3dc427206466ed6a23bb40d61b9
--- /dev/null
+++ b/vendor/taffy/src/compute/grid/lanes_row_baselines.rs
@@ -0,0 +1,212 @@
+//! Row grid-lanes export grid-axis baselines using CSS Grid's occupied-edge rule.
+//! Sharing groups precede available child baselines and border-box synthesis.
+use crate::compute::common::alignment::baseline_coordinate;
+
+use crate::Baselines;
+
+/// KaminIDE patch: Export first and last baselines from row-oriented lanes.
+pub(super) fn compute(placed: &[super::super::Placed]) -> Baselines {
+    let items: crate::util::sys::Vec<_> = placed
+        .iter()
+        .map(|item| Candidate {
+            start: item.start,
+            end: item.end,
+            placement: item.placement_stack_pos,
+            offset: item.grid_pos,
+            height: item.size.height,
+            first: item.baseline.map(|v| {
+                    baseline_coordinate(Some(v), item.size.height, item.overflow.y.is_scroll_container())
+                }),
+            last: item.last_baseline.map(|v| {
+                    baseline_coordinate(Some(v), item.size.height, item.overflow.y.is_scroll_container())
+                }),
+            first_shared: item.grid_baseline,
+            last_shared: item.grid_last_baseline,
+        })
+        .collect();
+    baselines(&items)
+}
+
+/// KaminIDE patch: Placed item data needed for container baseline selection.
+struct Candidate {
+    /// KaminIDE patch: First occupied lane.
+    start: usize,
+    /// KaminIDE patch: Exclusive end of the occupied lane range.
+    end: usize,
+    /// KaminIDE patch: Item origin in the container.
+    placement: f32,
+    /// KaminIDE patch: Baseline-axis alignment offset.
+    offset: f32,
+    /// KaminIDE patch: Item extent along the baseline axis.
+    height: f32,
+    /// KaminIDE patch: Measured first baseline.
+    first: Option<f32>,
+    /// KaminIDE patch: Measured last baseline.
+    last: Option<f32>,
+    /// KaminIDE patch: Whether the first baseline participates in a shared group.
+    first_shared: bool,
+    /// KaminIDE patch: Whether the last baseline participates in a shared group.
+    last_shared: bool,
+}
+
+impl Candidate {
+    /// KaminIDE patch: Return the requested measured baseline.
+    fn measured(&self, last: bool) -> Option<f32> {
+        if last {
+            self.last.or(self.first)
+        } else {
+            self.first.or(self.last)
+        }
+    }
+
+    /// KaminIDE patch: Convert the requested baseline into container coordinates.
+    fn coordinate(&self, last: bool) -> f32 {
+        self.offset + self.measured(last).unwrap_or(self.height)
+    }
+
+    /// KaminIDE patch: Whether the requested baseline is shared with its group.
+    fn shared(&self, last: bool) -> bool {
+        if last {
+            self.last_shared
+        } else {
+            self.first_shared
+        }
+    }
+}
+
+/// KaminIDE patch: Select candidates at the requested outer lane edge.
+fn select(
+    items: &[Candidate],
+    accepts: impl Fn(&Candidate) -> bool,
+    last: bool,
+) -> Option<&Candidate> {
+    let mut selected: Option<&Candidate> = None;
+    for item in items.iter().filter(|item| accepts(item)) {
+        if selected.map_or(true, |old| {
+            if last {
+                item.start > old.start
+                    || (item.start == old.start && item.placement >= old.placement)
+            } else {
+                item.start < old.start
+                    || (item.start == old.start && item.placement < old.placement)
+            }
+        }) {
+            selected = Some(item);
+        }
+    }
+    selected
+}
+
+/// KaminIDE patch: Select a shared or synthesized baseline from the candidates.
+fn baseline(items: &[Candidate], last: bool) -> Option<f32> {
+    let edge = if last {
+        items.iter().map(|item| item.end).max()?
+    } else {
+        items.iter().map(|item| item.start).min()?
+    };
+    let at_edge = |item: &Candidate| {
+        if last {
+            item.end == edge
+        } else {
+            item.start == edge
+        }
+    };
+    if let Some(item) = select(items, |item| at_edge(item) && item.shared(last), last) {
+        return Some(item.coordinate(last));
+    }
+    let opposite_edge = |item: &Candidate| {
+        if last {
+            item.start + 1 == edge
+        } else {
+            item.end == edge + 1
+        }
+    };
+    if let Some(item) = select(
+        items,
+        |item| opposite_edge(item) && item.shared(!last),
+        last,
+    ) {
+        return Some(item.coordinate(!last));
+    }
+    if let Some(item) = select(
+        items,
+        |item| at_edge(item) && item.measured(last).is_some(),
+        last,
+    ) {
+        return Some(item.coordinate(last));
+    }
+    select(items, |_| true, last).map(|item| item.offset + item.height)
+}
+
+/// KaminIDE patch: Compute both exported baselines from the candidates.
+fn baselines(items: &[Candidate]) -> Baselines {
+    Baselines {
+        first: baseline(items, false),
+        last: baseline(items, true),
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn item(start: usize, end: usize, placement: f32) -> Candidate {
+        Candidate {
+            start,
+            end,
+            placement,
+            offset: 10.0 * start as f32,
+            height: 40.0,
+            first: Some(12.0),
+            last: Some(30.0),
+            first_shared: false,
+            last_shared: false,
+        }
+    }
+
+    #[test]
+    fn spanning_subgrid_exports_both_content_edges() {
+        assert_eq!(
+            baselines(&[item(0, 2, 0.0)]),
+            Baselines {
+                first: Some(12.0),
+                last: Some(30.0)
+            }
+        );
+    }
+
+    #[test]
+    fn last_occupied_row_uses_grid_order_before_relative_offsets() {
+        let mut later = item(1, 2, 20.0);
+        later.offset = -100.0;
+        assert_eq!(
+            baselines(&[later, item(1, 2, 0.0), item(0, 1, 0.0)]),
+            Baselines {
+                first: Some(12.0),
+                last: Some(-70.0)
+            }
+        );
+    }
+
+    #[test]
+    fn sharing_group_precedes_other_available_baselines() {
+        let mut shared = item(0, 1, 0.0);
+        shared.first_shared = true;
+        assert_eq!(baselines(&[shared, item(0, 1, 20.0)]).last, Some(12.0));
+    }
+
+    #[test]
+    fn empty_box_synthesis_uses_last_item_in_grid_order() {
+        let mut empty = item(1, 2, 0.0);
+        empty.first = None;
+        empty.last = None;
+        assert_eq!(
+            baselines(&[item(0, 1, 0.0), empty]),
+            Baselines {
+                first: Some(12.0),
+                last: Some(50.0)
+            }
+        );
+        assert_eq!(baselines(&[]), Baselines::NONE);
+    }
+}
