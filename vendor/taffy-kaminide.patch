@@ -0,0 +1,23 @@
+//! Project first and last x-baseline fallback edges from the item's writing mode.
+use crate::{AlignItems, AlignItemsKeyword, Direction};
+
+/// KaminIDE patch: Resolve physical x-baseline alignment from the item's writing mode.
+pub(super) fn projected_x_alignment(
+    alignment: AlignItems,
+    first_from_end: bool,
+    direction: Direction,
+) -> AlignItems {
+    let from_end = match alignment.keyword {
+        AlignItemsKeyword::Baseline => first_from_end,
+        AlignItemsKeyword::LastBaseline => !first_from_end,
+        _ => return alignment,
+    };
+    AlignItems {
+        keyword: if from_end != direction.is_rtl() {
+            AlignItemsKeyword::End
+        } else {
+            AlignItemsKeyword::Start
+        },
+        ..alignment
+    }
+}
diff --git a/vendor/taffy/src/compute/grid/baseline_x.rs b/vendor/taffy/src/compute/grid/baseline_x.rs
new file mode 100644
index 0000000000000000000000000000000000000000..de7f2a9d59e361addc2d7a59d22cad3b602dfbb2
--- /dev/null
