+        .max_by(|a, b| a.total_cmp(b))
+        .unwrap_or(0.0)
+}
+pub(super) fn item_minimum(lines: &[FlexLine<'_>], constants: &AlgoConstants) -> f32 {
+    lines
+        .iter()
+        .flat_map(|line| line.items.iter())
+        .map(|child| contribution(child, constants))
+        .fold(0.0_f32, f32::max)
