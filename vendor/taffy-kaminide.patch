# Правка taffy для KaminIDE: базовая линия текста от ЗАМЕРА листа
#
# Зачем. Замер листа в taffy отдаёт только размер, поэтому `first_baselines`
# у него всегда пуст, а гибкая раскладка берёт `unwrap_or(height)` — то есть
# `align-items: baseline` выравнивает коробки по НИЖНИМ краям. Абзац движка —
# это замеряемый лист, и без правки выравнивание текста по базовой линии
# невозможно в принципе.
#
# Что внутри (85 изменённых строк в пяти файлах):
#   * tree/layout.rs      — тип `MeasureOutput { size, baseline }`;
#   * tree/mod.rs         — его экспорт;
#   * compute/leaf.rs     — замер отдаёт `MeasureOutput`, линия кладётся в
#                           `first_baselines.y` со сдвигом на верхний отступ;
#   * tree/taffy_tree.rs  — 10 бондов `MeasureFunction` и два пустых замыкания;
#   * compute/block.rs    — блочный контейнер пропускает вверх базовую линию
#                           ПЕРВОГО потокового ребёнка (абзац почти всегда
#                           завёрнут в обычный `div`, без этого линия теряется).
#
# Как накатить на новую версию taffy:
#   1. распаковать новую версию в vendor/taffy (заменив старую);
#   2. `git apply --3way vendor/taffy-kaminide.patch`;
#   3. разобрать отказы — вся правка локальна, конфликтов ждать только в
#      сигнатурах `MeasureFunction`, если апстрим их менял;
#   4. ВЕРСИЮ в vendor/taffy/Cargo.toml оставить ту, которую пинит
#      vendor/gpui/Cargo.toml (`taffy = "=0.9.0"`), иначе cargo откажет;
#   5. пересобрать и прогнать стенд по разделам с базовой линией.
#
# Проверять апстрим: `curl https://index.crates.io/ta/ff/taffy`.
# На 2026-08-10 последняя версия 0.13.0, у нас 0.9.0 — версию держит пин gpui.

--- a/src/tree/layout.rs
+++ b/src/tree/layout.rs
@@ -177,6 +177,24 @@
     pub margins_can_collapse_through: bool,
 }
 
+/// KaminIDE patch: результат замера ЛИСТА — размер и, если он есть, первая
+/// базовая линия. Без неё выравнивание `align-items: baseline` вырождается в
+/// выравнивание по нижним краям коробок: `compute_leaf_layout` ставил
+/// `Point::NONE`, а гибкая раскладка берёт `unwrap_or(height)`.
+#[derive(Debug, Copy, Clone, PartialEq)]
+pub struct MeasureOutput {
+    /// Размер листа.
+    pub size: Size<f32>,
+    /// Первая базовая линия по вертикали, от ВЕРХА коробки содержимого.
+    pub baseline: Option<f32>,
+}
+
+impl From<Size<f32>> for MeasureOutput {
+    fn from(size: Size<f32>) -> Self {
+        Self { size, baseline: None }
+    }
+}
+
