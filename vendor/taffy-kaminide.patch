+                TrackCounts::from_raw(0, 4, 0),
+                &style,
+                AbsoluteAxis::Horizontal,
+                4,
+                |index| live.contains(&index),
+            );
+            let gutters: Vec<_> = tracks
+                .iter()
+                .enumerate()
+                .filter(|(_, track)| track.kind == GridTrackKind::Gutter && !track.is_collapsed)
+                .map(|(index, _)| index)
+                .collect();
+            assert_eq!(gutters.len(), live.len().saturating_sub(1));
+            for &index in &gutters {
+                assert!(tracks[..index]
+                    .iter()
+                    .any(|track| track.kind == GridTrackKind::Track && !track.is_collapsed));
+                assert!(tracks[index + 1..]
+                    .iter()
+                    .any(|track| track.kind == GridTrackKind::Track && !track.is_collapsed));
+                assert_eq!(
+                    tracks[index].min_track_sizing_function,
+                    MinTrackSizingFunction::from_length(10.0)
+                );
+            }
+        }
+    }
diff --git a/vendor/taffy/src/compute/grid/fixed_standalone_tracks.rs b/vendor/taffy/src/compute/grid/fixed_standalone_tracks.rs
