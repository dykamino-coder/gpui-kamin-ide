+//! Intrinsic block items must preserve physical x baselines in vertical alignment.
+use crate::prelude::{length, TaffyAuto, TaffyMaxContent};
+use crate::{AlignItems, Baselines, Dimension, Display, Size, Style, TaffyTree};
+
+#[test]
+fn first_and_last_vertical_baselines_align_after_intrinsic_block_measurement() {
+    for flags in [4, 5] {
+        for width in [Dimension::min_content(), Dimension::max_content()] {
+            for last in [false, true] {
+                let mut tree: TaffyTree<(f32, f32, f32)> = TaffyTree::new();
+                tree.disable_rounding();
+                let contexts = [(20.0, 6.0, 14.0), (30.0, 9.0, 24.0)];
+                let mut items = vec![];
+                for context in contexts {
+                    let text = tree.new_leaf_with_context(Style::DEFAULT, context).unwrap();
+                    items.push(
+                        tree.new_with_children(
+                            Style {
+                                display: Display::Block,
+                                baseline_x_flags: flags,
+                                size: Size {
+                                    width,
+                                    height: Dimension::AUTO,
+                                },
+                                ..Style::DEFAULT
+                            },
+                            &[text],
+                        )
+                        .unwrap(),
+                    );
+                }
+                let root = tree
+                    .new_with_children(
+                        Style {
+                            display: Display::Grid,
+                            grid_template_columns: vec![length(80.0)],
+                            grid_template_rows: vec![length(50.0), length(50.0)],
+                            justify_items: if last {
+                                AlignItems::LAST_BASELINE
+                            } else {
+                                AlignItems::BASELINE
+                            },
+                            ..Style::DEFAULT
+                        },
+                        &items,
+                    )
+                    .unwrap();
+                tree.compute_layout_with_measure(
+                    root,
+                    Size::MAX_CONTENT,
+                    |inputs, _, context, style| {
+                        let (width, first, last) = *context.unwrap();
+                        let mut output = crate::compute_leaf_layout(
+                            inputs,
+                            style,
+                            |_, _| 0.0,
+                            |known, _| Size {
+                                width: known.width.unwrap_or(width),
+                                height: known.height.unwrap_or(30.0),
+                            },
+                        );
+                        output.baselines_x = Baselines {
+                            first: Some(first),
+                            last: Some(last),
+                        };
+                        output
+                    },
+                )
+                .unwrap();
+                let mut baselines = vec![];
+                for (&item, &(width, first, final_line)) in items.iter().zip(&contexts) {
+                    let layout = tree.layout(item).unwrap();
+                    assert_eq!(layout.size.width, width);
+                    assert!(layout.location.x >= 0.0 && layout.location.x + width <= 80.0);
+                    baselines.push(layout.location.x + if last { final_line } else { first });
+                }
+                assert_eq!(baselines[0], baselines[1], "flags={flags} last={last}");
+            }
+        }
+    }
+}
diff --git a/vendor/taffy/src/tree/kamin_calc.rs b/vendor/taffy/src/tree/kamin_calc.rs
new file mode 100644
index 0000000000000000000000000000000000000000..bbf3bd729fe7a3b1daeb63a223f0fc2f2d9a294a
--- /dev/null
+++ b/vendor/taffy/src/tree/kamin_calc.rs
@@ -0,0 +1,217 @@
+//! KaminIDE patch: registered opaque calc handles owned by a `TaffyTree`; no
+//! supplied pointer is dereferenced.
+//!
+//! A handle is the 1-based index of a `(px, fraction)` pair times 8 (the low
+//! three bits of a `CompactLength` calc pointer are tag bits). Upstream taffy
+//! leaves the calc value to the tree (`LayoutPartialTree::resolve_calc_value`),
+//! so the registry belongs to the tree: `TaffyTree::clear` drops it with the
+//! nodes whose styles carry the handles. The host registers pairs inside
+//! `TaffyTree::calc_scope` (while converting styles) and the tree resolves
+//! them inside `compute_layout_with_measure`; leaf measure functions, which
+//! cannot see the tree, read the same scope through `calc_value`.
+
+#[cfg(feature = "std")]
+use std::sync::{Arc, Mutex};
+
+/// The `(px, fraction)` pairs of one tree, deduplicated by bit pattern.
+#[cfg(feature = "std")]
+#[derive(Debug, Default)]
+pub(crate) struct CalcRegistry {
+    /// KaminIDE patch: Registered pixel and percentage coefficient pairs.
+    pairs: std::vec::Vec<(f32, f32)>,
+    /// KaminIDE patch: Deduplicated handles indexed by coefficient bit patterns.
+    index: std::collections::HashMap<(u32, u32), usize>,
+}
+
+#[cfg(feature = "std")]
+impl CalcRegistry {
+    /// KaminIDE patch: Intern a coefficient pair and return its opaque handle.
+    fn handle(&mut self, px: f32, fraction: f32) -> *const () {
+        let pairs = &mut self.pairs;
+        let at = *self
+            .index
+            .entry((px.to_bits(), fraction.to_bits()))
+            .or_insert_with(|| {
+                pairs.push((px, fraction));
+                pairs.len()
+            });
+        at.checked_mul(8).expect("calc handle registry overflow") as *const ()
+    }
+
+    /// KaminIDE patch: Read coefficients associated with an opaque calc handle.
+    fn pair(&self, handle: *const ()) -> Option<(f32, f32)> {
+        let address = handle as usize;
+        if address == 0 || address & 7 != 0 {
+            return None;
+        }
+        self.pairs.get((address >> 3) - 1).copied()
+    }
+
+    /// KaminIDE patch: Remove all registered coefficients and handles.
+    pub(crate) fn clear(&mut self) {
+        self.pairs.clear();
+        self.index.clear();
+    }
+}
+
+/// Shared handle to a tree's registry (the tree stays `Send`).
+#[cfg(feature = "std")]
+pub(crate) type SharedRegistry = Arc<Mutex<CalcRegistry>>;
+
+#[cfg(feature = "std")]
+std::thread_local! {
+    static CURRENT: std::cell::RefCell<std::vec::Vec<SharedRegistry>> =
+        const { std::cell::RefCell::new(std::vec::Vec::new()) };
+}
+
+/// Guard of `TaffyTree::calc_scope`: the tree's registry is current until drop.
+#[cfg(feature = "std")]
+pub struct CalcScope {
+    /// KaminIDE patch: Registry stack depth after entering this scope.
+    depth: usize,
+    /// KaminIDE patch: Keep registry scopes on the thread that entered them.
+    _not_send: core::marker::PhantomData<*const ()>,
+}
+
+#[cfg(feature = "std")]
+/// KaminIDE patch: Make a registry current until the returned scope is dropped.
+pub(crate) fn enter(registry: &SharedRegistry) -> CalcScope {
+    let depth = CURRENT.with(|c| {
+        let mut c = c.borrow_mut();
+        c.push(registry.clone());
+        c.len()
+    });
+    CalcScope {
+        depth,
+        _not_send: core::marker::PhantomData,
+    }
+}
+
+#[cfg(feature = "std")]
+impl Drop for CalcScope {
+    fn drop(&mut self) {
+        let _ = CURRENT.try_with(|c| c.borrow_mut().truncate(self.depth - 1));
+    }
+}
+
+#[cfg(feature = "std")]
+/// KaminIDE patch: Access the current registry when a scope is active.
+fn with_current<R>(f: impl FnOnce(&mut CalcRegistry) -> R) -> Option<R> {
+    let registry = CURRENT.with(|c| c.borrow().last().cloned())?;
+    let mut guard = registry.lock().unwrap_or_else(|error| error.into_inner());
+    Some(f(&mut guard))
+}
+
+/// Register a pixel term and a fraction of the available percentage basis in
+/// the current tree's registry (`TaffyTree::calc_scope`). Outside a scope
+/// there is no owner: a debug build stops, a release build gets the null
+/// handle, which resolves to 0.
+#[cfg(feature = "std")]
+pub fn calc_handle(px: f32, fraction: f32) -> *const () {
+    let handle = with_current(|r| r.handle(px, fraction));
+    debug_assert!(
+        handle.is_some(),
+        "calc handle registered outside TaffyTree::calc_scope"
+    );
+    handle.unwrap_or(core::ptr::null())
+}
+
+#[cfg(feature = "std")]
+/// KaminIDE patch: Read coefficients associated with an opaque calc handle.
+fn pair(handle: *const ()) -> (f32, f32) {
+    let found = with_current(|r| r.pair(handle)).flatten();
+    debug_assert!(
+        found.is_some() || handle.is_null(),
+        "calc handle unknown to the current tree: {handle:?}"
+    );
+    found.unwrap_or((0.0, 0.0))
+}
+
+#[cfg(not(feature = "std"))]
+fn pair(_handle: *const ()) -> (f32, f32) {
+    (0.0, 0.0)
+}
+
+/// Resolve an opaque registered handle without dereferencing it. An unknown
+/// handle is a broken link (debug assertion); it resolves to 0 explicitly.
+pub fn calc_value(handle: *const (), basis: f32) -> f32 {
+    let (px, fraction) = pair(handle);
+    if fraction == 0.0 {
+        px
+    } else {
+        px + fraction * basis
+    }
+}
+
+#[cfg(all(test, feature = "std"))]
+mod tests {
+    use super::*;
+
+    fn registry() -> SharedRegistry {
+        SharedRegistry::default()
+    }
+
+    #[test]
+    fn equal_bit_patterns_reuse_handles_and_preserve_both_terms() {
+        let tree = registry();
+        let _scope = enter(&tree);
+        let handle = calc_handle(12.5, 0.25);
+        assert_eq!(handle, calc_handle(12.5, 0.25));
+        assert_ne!(handle as usize, 0);
+        assert_eq!(handle as usize & 7, 0);
+        assert_eq!(calc_value(handle, 200.0), 62.5);
+    }
+
+    #[test]
+    fn null_handle_resolves_to_zero() {
+        let tree = registry();
+        let _scope = enter(&tree);
+        assert_eq!(calc_value(core::ptr::null(), 100.0), 0.0);
+        assert_eq!(calc_value(core::ptr::null(), f32::NAN), 0.0);
+    }
+
+    #[test]
+    #[cfg_attr(
+        debug_assertions,
+        should_panic(expected = "unknown to the current tree")
+    )]
+    fn handles_of_another_tree_are_not_resolved() {
+        let (a, b) = (registry(), registry());
+        let handle = {
+            let _scope = enter(&a);
+            calc_handle(12.5, 0.25)
+        };
+        let _scope = enter(&b);
+        assert_eq!(calc_value(handle, 100.0), 0.0);
+    }
+
+    #[test]
+    fn pixel_only_calculation_does_not_depend_on_an_unknown_basis() {
+        let tree = registry();
+        let _scope = enter(&tree);
+        let handle = calc_handle(12.5, 0.0);
+        assert_eq!(calc_value(handle, f32::NAN), 12.5);
+        assert_eq!(calc_value(handle, f32::INFINITY), 12.5);
+    }
+
+    #[test]
+    fn clearing_the_tree_frees_its_pairs() {
+        let tree = registry();
+        let _scope = enter(&tree);
+        calc_handle(1.0, 0.5);
+        tree.lock().unwrap().clear();
+        assert!(tree.lock().unwrap().pairs.is_empty());
+    }
+
+    #[test]
+    #[cfg(feature = "calc")]
+    fn compact_length_tagging_roundtrips_the_opaque_handle() {
+        let tree = registry();
+        let _scope = enter(&tree);
+        let value = crate::style::Dimension::calc(calc_handle(12.5, 0.25));
+        assert_eq!(
+            crate::util::MaybeResolve::maybe_resolve(value, Some(100.0), calc_value),
+            Some(37.5)
+        );
+    }
+}
diff --git a/vendor/taffy/src/tree/kamin_output.rs b/vendor/taffy/src/tree/kamin_output.rs
new file mode 100644
index 0000000000000000000000000000000000000000..49e969a71d51de9d2d92ffb498c1ecf1204990b6
--- /dev/null
+++ b/vendor/taffy/src/tree/kamin_output.rs
@@ -0,0 +1,161 @@
+//! Local baseline contracts expressed on native y and independent x baselines.
+
+use crate::style::Style;
+use crate::tree::{Baselines, LayoutOutput};
+
+/// KaminIDE patch: Adapt physical layout output to the authored root writing mode.
+pub(super) fn adapt(mut output: LayoutOutput, style: &Style) -> LayoutOutput {
+    if let (None, Some((offset, from_right))) = (output.baselines_x.first, style.baseline_x_hint) {
+        output.baselines_x.first = Some(if from_right {
+            output.size.width - offset
+        } else {
+            offset
+        });
+    }
+    // A table (or its wrapper box) contributes no baseline to an enclosing
+    // inline-block, whatever block wrappers sit in between.
+    if style.no_inline_block_baseline {
+        output.inline_block_last_y = Some(None);
+    }
+    if style.baseline_from_last {
+        output.baselines.first = output.inline_block_last_y();
+        output.baselines_x.first = output.last_or_first_x();
+    }
+    // A vertical box has no native horizontal baseline (Writing Modes 4,
+    // section 4.3). Let the y-axis alignment context synthesize its baseline;
+    // retain the independent x baseline for a parallel vertical context.
+    if style.baseline_x_flags & 4 != 0 {
+        output.baselines = Baselines::NONE;
+        output.inline_block_last_y = None;
+    }
+    // General scroll-container baselines use native synthesis/clamping. The
+    // inline-block boundary instead exports its margin-box bottom when its
+    // overflow is non-visible (CSS 2.1 10.8.1); callers synthesize that fallback.
+    // Paint containment uses Clip and does not suppress the text baseline.
+    if style.contain.suppresses_baseline()
+        || style.baseline_unavailable
+        || (style.baseline_from_last && style.overflow.y.is_scroll_container())
+    {
+        output.baselines = Baselines::NONE;
+        output.baselines_x = Baselines::NONE;
+        output.inline_block_last_y = None;
+    }
+    output
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::geometry::Size;
+    use crate::style::Contain;
+
+    fn measured() -> LayoutOutput {
+        let mut result = LayoutOutput::from_outer_size(Size {
+            width: 40.0,
+            height: 50.0,
+        });
+        result.baselines = Baselines {
+            first: Some(10.0),
+            last: Some(30.0),
+        };
+        result
+    }
+
+    #[test]
+    fn right_edge_hint_does_not_overwrite_measured_x_or_y() {
+        let style = Style {
+            baseline_x_hint: Some((4.0, true)),
+            ..Style::DEFAULT
+        };
+        let result = adapt(measured(), &style);
+        assert_eq!(result.baselines_x.first, Some(36.0));
+        assert_eq!(result.baselines, measured().baselines);
+        let mut existing = measured();
+        existing.baselines_x = Baselines {
+            first: Some(5.0),
+            last: Some(8.0),
+        };
+        let expected = existing.baselines_x;
+        assert_eq!(adapt(existing, &style).baselines_x, expected);
+    }
+
+    #[test]
+    fn inline_block_last_baseline_policy_preserves_last() {
+        let style = Style {
+            baseline_from_last: true,
+            ..Style::DEFAULT
+        };
+        let mut content = measured();
+        // Content-order last is the leftmost line in a vertical-rl inline block.
+        content.baselines_x = Baselines {
+            first: Some(32.0),
+            last: Some(8.0),
+        };
+        let result = adapt(content, &style);
+        assert_eq!(
+            result.baselines,
+            Baselines {
+                first: Some(30.0),
+                last: Some(30.0)
+            }
+        );
+        assert_eq!(
+            result.baselines_x,
+            Baselines {
+                first: Some(8.0),
+                last: Some(8.0)
+            }
+        );
+    }
+
+    #[test]
+    fn layout_containment_suppresses_custom_output_and_x_hints() {
+        let style = Style {
+            contain: Contain::LAYOUT,
+            baseline_x_hint: Some((4.0, true)),
+            ..Style::DEFAULT
+        };
+        let result = adapt(measured(), &style);
+        assert_eq!(result.baselines, Baselines::NONE);
+        assert_eq!(result.baselines_x, Baselines::NONE);
+    }
+
+    #[test]
+    fn unavailable_baseline_keeps_sizing_and_containment_independent() {
+        let style = Style {
+            baseline_unavailable: true,
+            ..Style::DEFAULT
+        };
+        let result = adapt(measured(), &style);
+        assert_eq!(result.size, measured().size);
+        assert_eq!(style.contain, Contain::NONE);
+        assert_eq!(result.baselines, Baselines::NONE);
+        assert_eq!(result.baselines_x, Baselines::NONE);
+    }
+
+    #[test]
+    fn paint_containment_keeps_baselines() {
+        let style = Style {
+            contain: Contain::PAINT,
+            ..Style::DEFAULT
+        };
+        assert_eq!(adapt(measured(), &style).baselines, measured().baselines);
+    }
+
+    #[test]
+    fn inline_block_scroll_overflow_does_not_export_content_baselines() {
+        let mut style = Style::DEFAULT;
+        style.baseline_from_last = true;
+        style.overflow.y = crate::style::Overflow::Hidden;
+        let result = adapt(measured(), &style);
+        assert_eq!(result.baselines, Baselines::NONE);
+        assert_eq!(result.baselines_x, Baselines::NONE);
+    }
+
+    #[test]
+    fn ordinary_scroll_container_retains_native_content_baselines() {
+        let mut style = Style::DEFAULT;
+        style.overflow.y = crate::style::Overflow::Hidden;
+        assert_eq!(adapt(measured(), &style).baselines, measured().baselines);
+    }
+}
