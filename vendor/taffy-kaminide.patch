+#[test]
+fn wrapped_intrinsic_content_floor_can_exceed_flex_basis() {
+    for direction in [FlexDirection::Row, FlexDirection::RowReverse] {
+        let mut tree: TaffyTree<()> = TaffyTree::new();
+        let content = tree
+            .new_leaf_with_context(
+                Style {
+                    flex_basis: length(0.0),
+                    flex_grow: 1.0,
+                    min_size: Size::zero(),
+                    ..Style::DEFAULT
+                },
+                (),
+            )
+            .unwrap();
+        let sibling = tree
+            .new_leaf(Style {
+                size: Size::zero(),
+                margin: Rect {
+                    left: length(-10.0),
+                    ..Rect::zero()
+                },
+                ..Style::DEFAULT
+            })
+            .unwrap();
+        let root = tree
+            .new_with_children(
+                Style {
+                    flex_direction: direction,
+                    flex_wrap: FlexWrap::Wrap,
+                    size: Size {
+                        width: Dimension::max_content(),
+                        height: length(20.0),
+                    },
+                    ..Style::DEFAULT
+                },
+                &[content, sibling],
+            )
+            .unwrap();
+        tree.compute_layout_with_measure(root, Size::MAX_CONTENT, |input, _, _, style| {
+            crate::compute_leaf_layout(
+                input,
+                style,
+                |_, _| 0.0,
+                |_, _| Size {
+                    width: 100.0,
+                    height: 10.0,
+                },
+            )
+        })
+        .unwrap();
+        assert_eq!(
+            tree.layout(root).unwrap().size.width,
+            100.0,
+            "{direction:?}"
