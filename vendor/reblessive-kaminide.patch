diff --git a/vendor/reblessive/src/stack/stk.rs b/vendor/reblessive/src/stack/stk.rs
index d761afefe8ee82a8e871d69ddd8dc04e0dbd4090..f2ff13218a4d91495129a616acff527d768941f3
--- a/vendor/reblessive/src/stack/stk.rs
+++ b/vendor/reblessive/src/stack/stk.rs
@@ -0,0 +1 @@
+use super::erased::ErasedStkFuture;
@@ -34,0 +36,12 @@
+    /// [`Stk::run`] whose future names only its output (KaminIDE), so that a
+    /// function pointer can return it without boxing it. The closure, with the
+    /// result slot, is kept inline in [`ErasedStkFuture`]: it must fit
+    /// [`ERASED_INLINE`](super::ERASED_INLINE) bytes (checked at compile time).
+    pub fn run_erased<'a, F, Fut, R>(&'a mut self, f: F) -> ErasedStkFuture<'a, R>
+    where
+        F: FnOnce(&'a mut Stk) -> Fut,
+        Fut: Future<Output = R> + 'a,
+    {
+        ErasedStkFuture::new(f)
+    }
+
