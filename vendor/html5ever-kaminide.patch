+        Err(ReserveError::Overflow)
+    ));
+    assert_eq!(values.iter().copied().collect::<Vec<_>>(), [4, 5]);
+    assert_eq!(live.load(SeqCst), before);
+    drop(values);
+    assert_eq!(live.load(SeqCst), 0);
