{
  "name": "claude-bridge-workspace",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./runtime": "./dist/runtime.cjs"
  },
  "engines": {
    "node": "^22.19.0 || ^24.0.0 || ^26.0.0"
  },
  "description": "Browser workspace client host for the shared Kamin bridge runtime.",
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.runtime.json",
    "test": "npm run build && node --import tsx --test --test-timeout=30000 --test-concurrency=1 test/*.test.ts",
    "test:browser": "node --test test/browser.smoke.mjs"
  },
  "dependencies": {
    "@homebridge/node-pty-prebuilt-multiarch": "^0.14.1",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/headless": "^6.0.0",
    "fast-glob": "^3.3.3",
    "semver": "^7.8.5",
    "turndown": "^7.2.4",
    "ws": "^8.22.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/vscode": "^1.140.0",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "playwright": "^1.65.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  }
}
