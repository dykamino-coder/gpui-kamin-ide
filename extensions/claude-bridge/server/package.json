{
  "name": "open-claude-bridge",
  "version": "6.3.171",
  "description": "Bridge server for the KaminIDE client and Claude CLI PTY sessions",
  "type": "module",
  "main": "./src/index.ts",
  "bin": {
    "open-claude-bridge": "./bin/claude-bridge.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./core": "./src/core/index.ts"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "start": "npx tsx ./src/index.ts",
    "dev": "npx tsx --watch ./src/index.ts",
    "dev:dashboard": "cd src/ui && npx vite",
    "build:dashboard": "cd src/ui && npm install && npx vite build",
    "build": "npm run build:dashboard",
    "jsonl-inspect": "npx tsx packages/jsonl-viewer-cli/src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@duckdb/node-api": "^1.5.6-r.2",
    "@hono/node-server": "^2.1.8",
    "@peculiar/asn1-schema": "^2.11.1",
    "@peculiar/asn1-x509": "^2.11.1",
    "@peculiar/x509": "^2.2.0",
    "@types/better-sqlite3": "^9.6.0",
    "@xterm/headless": "^6.0.0",
    "better-sqlite3": "^13.1.1",
    "hono": "^4.13.18",
    "node-pty": "^1.1.0",
    "reflect-metadata": "^0.2.2",
    "undici": "^8.12.4",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "@vitest/coverage-v8": "^5.1.0",
    "@xterm/addon-serialize": "^0.14.0",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "puppeteer-core": "^25.17.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  },
  "files": [
    "bin/",
    "src/",
    "README.md"
  ],
  "keywords": [
    "claude",
    "claude-max",
    "claude-code",
    "anthropic",
    "bridge",
    "kaminide",
    "pty",
    "llm",
    "ai-assistant"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rynfar/open-claude-bridge.git"
  },
  "homepage": "https://github.com/rynfar/open-claude-bridge#readme",
  "bugs": {
    "url": "https://github.com/rynfar/open-claude-bridge/issues"
  },
  "author": "rynfar",
  "license": "MIT",
  "private": false
}
