{
  "name": "open-claude-bridge",
  "version": "6.3.92",
  "description": "Electron desktop app + Node.js server for Claude CLI via PTY",
  "type": "module",
  "main": "./src/index.ts",
  "bin": {
    "open-claude-bridge": "./bin/claude-bridge.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./core": "./src/core/index.ts"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "start": "npx tsx ./src/index.ts",
    "dev": "npx tsx --watch ./src/index.ts",
    "dev:dashboard": "cd src/ui && npx vite",
    "build:dashboard": "cd src/ui && npm install && npx vite build",
    "build": "npm run build:dashboard",
    "jsonl-inspect": "npx tsx packages/jsonl-viewer-cli/src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@duckdb/node-api": "^1.5.2-r.1",
    "@hono/node-server": "^1.19.9",
    "@peculiar/asn1-schema": "^2.7.0",
    "@peculiar/asn1-x509": "^2.7.0",
    "@peculiar/x509": "^2.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "better-sqlite3": "^12.6.2",
    "hono": "^4.11.4",
    "node-pty": "^1.1.0",
    "reflect-metadata": "^0.2.2",
    "undici": "^8.2.0",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^3.2.4",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/headless": "^6.0.0",
    "eslint": "^9.39.4",
    "globals": "^15.15.0",
    "prettier": "^3.8.3",
    "puppeteer-core": "^24.38.0",
    "tsx": "^4.21.0",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.59.1",
    "vitest": "^3.0.0"
  },
  "files": [
    "bin/",
    "src/",
    "README.md"
  ],
  "keywords": [
    "claude",
    "claude-max",
    "claude-code",
    "anthropic",
    "bridge",
    "electron",
    "pty",
    "llm",
    "ai-assistant"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rynfar/open-claude-bridge.git"
  },
  "homepage": "https://github.com/rynfar/open-claude-bridge#readme",
  "bugs": {
    "url": "https://github.com/rynfar/open-claude-bridge/issues"
  },
  "author": "rynfar",
  "license": "MIT",
  "private": false
}
