{
  "name": "claude-bridge-webview",
  "private": true,
  "type": "module",
  "description": "Claude Bridge webview UI (Preact), ported from the legacy standalone client to the KaminIDE bridge API. Builds inlined HTML into builtin-extensions/claude-bridge/; node_modules/dist never enter the runtime payload.",
  "scripts": {
    "build": "node build.mjs",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "preact": "^11.0.0",
    "@preact/signals": "^2.11.3",
    "@xterm/xterm": "^6.0.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@fortawesome/fontawesome-free": "^7.3.1",
    "highlight.js": "^11.12.0",
    "turndown": "^7.2.4",
    "yaml": "^2.9.1",
    "codemirror": "^6.0.2",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13"
  },
  "devDependencies": {
    "vite": "^8.3.2",
    "@preact/preset-vite": "^2.10.6",
    "vite-plugin-singlefile": "^2.3.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
