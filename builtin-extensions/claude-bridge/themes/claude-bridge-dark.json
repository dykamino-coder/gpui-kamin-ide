{
  "name": "Claude Bridge Dark",
  "type": "dark",
  "colors": {
    "editor.background": "#0d1117",
    "editor.foreground": "#e6edf3",
    "editor.lineHighlightBackground": "#161b22",
    "editor.selectionBackground": "#30363d",
    "editorLineNumber.foreground": "#484f58",
    "editorLineNumber.activeForeground": "#8b949e",
    "editorCursor.foreground": "#db6d28",
    "editorWhitespace.foreground": "#21262d",
    "editorIndentGuide.background1": "#21262d",
    "editorIndentGuide.activeBackground1": "#30363d",
    "editorWidget.background": "#21262d",
    "editorWidget.border": "#30363d",
    "editorHoverWidget.background": "#161b22",
    "editorHoverWidget.border": "#30363d",
    "editorSuggestWidget.background": "#161b22",
    "editorSuggestWidget.selectedBackground": "#21262d",

    "foreground": "#e6edf3",
    "descriptionForeground": "#8b949e",
    "disabledForeground": "#484f58",
    "focusBorder": "#db6d28",
    "errorForeground": "#f85149",
    "widget.border": "#30363d",

    "sideBar.background": "#010409",
    "sideBar.foreground": "#e6edf3",
    "sideBarSectionHeader.background": "#010409",
    "sideBarTitle.foreground": "#8b949e",
    "activityBar.background": "#010409",
    "activityBar.foreground": "#e6edf3",
    "activityBar.inactiveForeground": "#6e7681",
    "activityBarBadge.background": "#db6d28",
    "activityBarBadge.foreground": "#0d1117",
    "statusBar.background": "#010409",
    "statusBar.foreground": "#8b949e",
    "statusBar.noFolderBackground": "#010409",
    "titleBar.activeBackground": "#161b22",
    "titleBar.activeForeground": "#e6edf3",
    "titleBar.inactiveBackground": "#161b22",

    "panel.background": "#161b22",
    "panel.border": "#30363d",
    "panelTitle.activeForeground": "#e6edf3",
    "panelTitle.inactiveForeground": "#8b949e",

    "tab.activeBackground": "#0d1117",
    "tab.inactiveBackground": "#161b22",
    "tab.activeForeground": "#e6edf3",
    "tab.inactiveForeground": "#8b949e",
    "tab.border": "#010409",
    "tab.activeBorderTop": "#db6d28",
    "editorGroupHeader.tabsBackground": "#010409",

    "input.background": "#161b22",
    "input.foreground": "#e6edf3",
    "input.border": "#30363d",
    "input.placeholderForeground": "#6e7681",
    "dropdown.background": "#30363d",
    "dropdown.foreground": "#e6edf3",
    "dropdown.border": "#30363d",

    "button.background": "#db6d28",
    "button.foreground": "#0d1117",
    "button.hoverBackground": "#e07d3e",
    "button.secondaryBackground": "#21262d",
    "button.secondaryForeground": "#e6edf3",

    "badge.background": "#db6d28",
    "badge.foreground": "#0d1117",
    "progressBar.background": "#db6d28",

    "list.activeSelectionBackground": "#21262d",
    "list.activeSelectionForeground": "#e6edf3",
    "list.inactiveSelectionBackground": "#161b22",
    "list.hoverBackground": "#161b22",
    "list.highlightForeground": "#db6d28",

    "textLink.foreground": "#db6d28",
    "textLink.activeForeground": "#e07d3e",

    "scrollbarSlider.background": "#30363d66",
    "scrollbarSlider.hoverBackground": "#484f5899",
    "scrollbarSlider.activeBackground": "#484f58cc",

    "editorError.foreground": "#f85149",
    "editorWarning.foreground": "#d29922",
    "editorInfo.foreground": "#58a6ff",
    "gitDecoration.addedResourceForeground": "#3fb950",
    "gitDecoration.modifiedResourceForeground": "#d29922",
    "gitDecoration.deletedResourceForeground": "#f85149",
    "gitDecoration.untrackedResourceForeground": "#3fb950",

    "terminal.background": "#0a0c0f",
    "terminal.foreground": "#e6edf3",
    "terminal.ansiBlack": "#010409",
    "terminal.ansiRed": "#f85149",
    "terminal.ansiGreen": "#3fb950",
    "terminal.ansiYellow": "#d29922",
    "terminal.ansiBlue": "#58a6ff",
    "terminal.ansiMagenta": "#bc8cff",
    "terminal.ansiCyan": "#39d2c0",
    "terminal.ansiWhite": "#e6edf3",
    "terminal.ansiBrightBlack": "#6e7681",
    "terminal.ansiBrightRed": "#ff7b72",
    "terminal.ansiBrightGreen": "#56d364",
    "terminal.ansiBrightYellow": "#e3b341",
    "terminal.ansiBrightBlue": "#79c0ff",
    "terminal.ansiBrightMagenta": "#d2a8ff",
    "terminal.ansiBrightCyan": "#56d4dd",
    "terminal.ansiBrightWhite": "#ffffff"
  },
  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#6e7681", "fontStyle": "italic" } },
    { "scope": ["string", "string.quoted", "constant.other.symbol"], "settings": { "foreground": "#a5d6ff" } },
    { "scope": ["constant.numeric", "constant.language", "constant.character"], "settings": { "foreground": "#79c0ff" } },
    { "scope": ["keyword", "storage.type", "storage.modifier", "keyword.control"], "settings": { "foreground": "#ff7b72" } },
    { "scope": ["keyword.operator"], "settings": { "foreground": "#ff7b72" } },
    { "scope": ["entity.name.function", "support.function", "meta.function-call.generic"], "settings": { "foreground": "#d2a8ff" } },
    { "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class"], "settings": { "foreground": "#ffa657" } },
    { "scope": ["variable", "variable.other", "meta.definition.variable"], "settings": { "foreground": "#e6edf3" } },
    { "scope": ["variable.parameter", "variable.language.this"], "settings": { "foreground": "#ffa657" } },
    { "scope": ["entity.name.tag", "punctuation.definition.tag"], "settings": { "foreground": "#7ee787" } },
    { "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#79c0ff" } },
    { "scope": ["support.type.property-name", "meta.object-literal.key"], "settings": { "foreground": "#79c0ff" } },
    { "scope": ["markup.heading", "entity.name.section"], "settings": { "foreground": "#58a6ff", "fontStyle": "bold" } },
    { "scope": ["markup.bold"], "settings": { "foreground": "#ffa657", "fontStyle": "bold" } },
    { "scope": ["markup.italic"], "settings": { "foreground": "#d2a8ff", "fontStyle": "italic" } },
    { "scope": ["markup.inline.raw", "markup.fenced_code"], "settings": { "foreground": "#a5d6ff" } },
    { "scope": ["invalid", "invalid.illegal"], "settings": { "foreground": "#f85149" } }
  ]
}
